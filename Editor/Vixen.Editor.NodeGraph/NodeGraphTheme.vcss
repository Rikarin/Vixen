/* SPDX-FileCopyrightText: Copyright (c) Rikarin
   SPDX-License-Identifier: Apache-2.0

   The graph view's search popup, sticky notes and preview layer, as a stylesheet on disk.

   ⚠ **Only the four elements this assembly adds.** Everything `NodeCanvas` draws is already styled
   by `AdvancedTheme`, so this sheet is deliberately small; both it and `ControlTheme` have to be
   loaded first, because every colour below is a `var(--…)` against a token one of them declares and
   a custom property nothing declared substitutes to nothing — which is a popup with no background
   over a canvas. */

/* ⚠ **The ladder, restated.** `ControlTheme.vcss` explains it; the statement has to be here too
   because `CascadeLayers.Declare` fixes a layer's position the first time anything names it, so the
   order belongs to whichever sheet a document loaded first rather than to any one file. Everything
   below is `components` — a look, peer to every other look, engine or editor — which is what lets a
   `@layer utilities` class beat it and what keeps its own arguments settled by specificity and
   source order exactly as they were. */

@layer base, components, utilities;

@layer components {

/* ── The view ───────────────────────────────────────────────────────── */
node-graph { flex-direction: column; flex-grow: 1; overflow: hidden; position: relative; }
node-graph > node-canvas { flex-grow: 1; }

/* The preview layer covers the canvas and takes no clicks: it is a picture of what the
   nodes under it are worth, and a full-canvas element that swallowed presses would make
   every node unreachable. Same bargain as node-wires. */
node-previews {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    pointer-events: none;
}

/* ── Sticky notes ───────────────────────────────────────────────────── */
graph-note {
    position: absolute;
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.5em;
    overflow: hidden;
}

graph-note.parked { display: none; }
graph-note-body { color: var(--foreground-muted); white-space: pre-wrap; }
graph-note-body.hidden { display: none; }

/* The field takes the label's place and its whole box, so a note does not change size or shape when
   a caret goes into it — a note that grew as it was clicked would move the wires drawn under it.
   Transparent and borderless for the same reason: the note is already a raised surface with a border
   round it, and a second one inside it reads as two notes. */
textarea.graph-note-editor {
    flex-grow: 1;
    align-self: stretch;
    padding: 0px;
    border-width: 0px;
    background-color: transparent;
    color: var(--foreground);
}

textarea.graph-note-editor.hidden { display: none; }

/* ── Search to create ───────────────────────────────────────────────── */
node-search {
    flex-direction: column;
    width: 320px;
    max-height: 380px;
    background-color: var(--surface-overlay);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px;
    gap: 4px;
}

node-search-list { flex-direction: column; overflow: hidden; }
node-search-empty { padding: 8px; color: var(--foreground-muted); }
node-search-empty.hidden { display: none; }

node-search-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    border-radius: 4px;
    background-color: transparent;
}

node-search-row.hidden { display: none; }
node-search-row:hover { background-color: var(--surface-hover); }

/* Checked is the highlight the popup owns, not a focus ring: the field keeps the focus so
   that the next letter typed goes into it. See NodeSearchPopup. */
node-search-row:checked { background-color: var(--accent); color: var(--accent-foreground); }

node-search-category { flex-grow: 1; text-align: right; color: var(--foreground-muted); }
node-search-port { color: var(--accent); }
node-search-port:empty { display: none; }

}
