/* SPDX-FileCopyrightText: Copyright (c) Rikarin
   SPDX-License-Identifier: Apache-2.0

   The world and scene panels' own elements, as a stylesheet on disk.

   ⚠ **A sixth user-agent sheet, after the five `EditorApplication` already loads**, and written
   against the tokens they declare — the same arrangement `BrowserTheme` has, and for the same
   reason: these elements are this assembly's panels and nobody else's business.

   ⚠ **The one extracted sheet whose class is `internal` and nested**, inside `EditorApplication`
   in `EditorWorlds.cs`. That changes nothing about the file: the logical name is the root namespace
   plus this file's name, so it is `Vixen.Editor.App.WorldTheme.vcss` however deeply the class that
   reads it is nested. ⚠ It is also why this sheet nearly escaped the layering: an internal sheet is
   still a user-agent sheet, and an unlayered one would still have beaten every utility. There was no
   "doc 61" to defer that to — the plan section is
   [doc 43 Part 3](../../docs/plan/43-web-styling-parity.md), and the scope is every sheet a document
   loads rather than every sheet with a public accessor. */

/* ⚠ **The ladder, restated.** `ControlTheme.vcss` explains it; the statement has to be here too
   because `CascadeLayers.Declare` fixes a layer's position the first time anything names it, so the
   order belongs to whichever sheet a document loaded first rather than to any one file. Everything
   below is `components` — a look, peer to every other look, engine or editor — which is what lets a
   `@layer utilities` class beat it and what keeps its own arguments settled by specificity and
   source order exactly as they were. */

@layer base, components, utilities;

@layer components {

world-title { font-weight: 600; margin-top: 6px; }
world-facts { flex-direction: column; gap: 2px; }

scene-list { flex-direction: column; gap: 2px; }

scene-row {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    min-height: 24px;
    padding: 0px 4px;
    border-radius: var(--radius-row, 6px);
}

scene-row.selected { background-color: var(--accent-deep, var(--accent)); color: #ffffff; }
scene-name { flex-grow: 1; min-width: 0; }

/* ── The mesh-map bake panel (doc 48 § D12) ─────────────────────────────
   Deliberately the same shape as `build-settings` one sheet over — a form
   of rows, a block of choices, an action strip and two sentences — because
   it is the same kind of surface and reading it as a second kind of panel
   would be the cost of styling it as one. ⚠ The rules are repeated rather
   than shared: `EditorTheme.vcss`'s `build-*` names are the build panel's,
   and a selector list naming both is how restyling one silently restyles
   the other, which that sheet's own choice-list comment says in as many
   words. */
mesh-map-bake {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0px;
    min-height: 0px;
    gap: 0px;
}

meshbake-form {
    flex-direction: column;
    flex-shrink: 0;
    gap: 4px;
    padding: 8px 9px;
}

meshbake-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

meshbake-row text { width: 110px; flex-shrink: 0; color: var(--text-muted); }
meshbake-row select, meshbake-row textbox { flex-grow: 1; min-width: 120px; }
meshbake-subject { flex-grow: 1; min-width: 0; }

meshbake-heading {
    flex-shrink: 0;
    padding: 4px 9px 2px 9px;
    font-weight: 600;
}

/* ⚠ Wrapped rather than a column of seven, and it is what keeps the Bake
   button above the fold in a docked panel: seven checkboxes stacked is
   roughly two hundred pixels of a surface that is often three hundred
   tall. */
meshbake-maps {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    gap: 4px 14px;
    padding: 2px 9px 6px 9px;
}

meshbake-note, meshbake-status {
    flex-shrink: 0;
    padding: 4px 9px;
    color: var(--text-muted);
    font-size: 0.85em;
}

meshbake-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 6px;
    padding: 6px 9px;
    border-top-width: 1px;
    border-color: var(--border);
    background-color: var(--surface-sunken);
}

meshbake-spacer { flex-grow: 1; }

mesh-map-bake data-grid { flex-grow: 1; flex-basis: 0px; min-height: 60px; }

}
