<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.App</RootNamespace>
        <IsPackable>false</IsPackable>

        <!--
            ⚠ A library, and `Vixen.Editor.Host` is the executable. Doc 36 § P3: a feature cannot be
            dereferenced by the assembly that has to instantiate it, so the composition root — the
            thing that names the modules — had to move somewhere this could not.
        -->
        <PublishAot>false</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <!-- The shell: docking, commands, menus, palette, theming, notifications, tasks. -->
        <ProjectReference Include="..\Vixen.Editor.Ui\Vixen.Editor.Ui.csproj" />

        <!--
            Plugin loading, which is what PublishAot="false" above is for. This assembly is also the
            one that decides *which* extension points a plugin can reach: the contract itself
            references only the shell, and everything else is published into PluginServices from
            here — the same joining job this project does for the inspector and the scene view.
        -->
        <ProjectReference Include="..\Vixen.Editor.Plugin\Vixen.Editor.Plugin.csproj" />

        <!-- The project model the shell is chrome over: the asset database, the command stack. -->
        <ProjectReference Include="..\Vixen.Editor.Core\Vixen.Editor.Core.csproj" />

        <!--
            The importers and the content build, which the editor runs on a background task and the
            CLI runs from a terminal. Shared rather than reimplemented: two orchestrations over these
            components drift, and the way that drift shows up is the editor and `vixen content build`
            producing different output for one project.
        -->
        <ProjectReference Include="..\Vixen.Editor.Assets\Vixen.Editor.Assets.csproj" />

        <!--
            The two panels that are more than chrome. Neither references the other and neither
            references the shell — joining them is this assembly's job, which is also why the
            [Inspector]-annotated bridge from an entity to a row of editors lives here rather than in
            either of them. An inspector that knew what an ECS entity was, or a viewport that knew
            what a property drawer was, would be a coupling the editor's own layering does not need.
        -->
        <ProjectReference Include="..\Vixen.Editor.Inspector\Vixen.Editor.Inspector.csproj" />
        <ProjectReference Include="..\Vixen.Editor.SceneView\Vixen.Editor.SceneView.csproj" />


        <!--
            The Raven compiler, as an EffectSystem tier.

            ⚠ The editor is the consumer `RavenEffectCompiler` documents itself for — "the editor
            stacks a disk cache over one of these and gets compile-once-then-read" — and this is what
            lets a viewport be driven by a compositor without a bake step between a material edit and
            seeing it. A shipping build does the opposite and asserts its miss list is empty; an
            editor cannot, because the next thing somebody does is add a shading model nothing has
            ever asked for.
        -->
        <ProjectReference Include="..\..\Tools\Vixen.ShaderCompiler\Vixen.ShaderCompiler.csproj" />

        <!--
            The nine per-asset editors from doc 11's table. This is the assembly that turns a
            double-click in the project browser into a document and a panel; which editor claims a
            file and what its view is made of are AssetEditors' business, and where the panel lands
            is this one's.

            ⚠ Doc 36 § P3 used to say this line was waiting on `AssetEditorRegistry` moving somewhere
            both ends could see. Measured twice, by deleting the line and compiling: ten names across
            seven files — the registry, `AssetEditorsModule`, `StandardFrameDocument`,
            `ShaderGraphDocument`, `ShaderGraphPreviewRenderer`, `IPreviewImages`,
            `Prefab`/`PrefabSource`, the `.Content` namespace, and `VfxGraphView`/`SequenceView` at
            `EditorWorlds.cs:1082,1086`, which produce *no diagnostic at all* under cascading-error
            suppression. The registry is one tenth of it, and the arbitration the other names carry is
            what § P3 itself says belongs here. The doc is corrected; the line stays.
        -->
        <ProjectReference Include="..\Vixen.Editor.AssetEditors\Vixen.Editor.AssetEditors.csproj" />

        <!--
            The six diagnostics panels of doc 20's B4. Two assemblies rather than one because they
            depend on different halves of the engine — the profiler on the sample rings and the RHI's
            query pools, the debugger on a command stream and a network transport — and because doc
            11's tree names `Vixen.Editor.Profiler` and `Vixen.Editor.Debugger` as two projects.
            Which world the statistics count and which device the GPU timeline reads are this
            assembly's arbitration, in the way every other panel's subject is.
        -->
        <ProjectReference Include="..\Vixen.Editor.Profiler\Vixen.Editor.Profiler.csproj" />
        <ProjectReference Include="..\Vixen.Editor.Debugger\Vixen.Editor.Debugger.csproj" />

        <!--
            ⚠ And the module that joins them to a project, a scene and a device — doc 36 § P3.
            `Vixen.Editor.Diagnostics` is a third assembly rather than a move into either of the two
            above, because both deliberately have never heard of a project: that is what lets them be
            tested against a bare `UiDocument`, and putting the joining code inside one would have
            spent it.
        -->
        <ProjectReference Include="..\Vixen.Editor.Diagnostics\Vixen.Editor.Diagnostics.csproj" />

        <!--
            ⚠ The transport the remote inspector runs over, chosen *here* rather than in
            Vixen.Editor.Debugger. Which transport reaches a target is an application's decision —
            loopback for a standalone play-mode process, UDP for a machine on the LAN, a forwarded
            port for a phone — and a debugger assembly that picked one would be a debugger that
            could only attach to that one. It takes an ITransport and this hands it whichever.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Net.Transport.Local\Vixen.Net.Transport.Local.csproj" />

        <!--
            ⚠ Contracts, not implementations, and that is the line the executable split drew. The
            platform's dialog and window interfaces, the scene presenter's renderer and render graph,
            and the terrain-drawing contract are all things this library names; Vulkan, SDL and the
            window itself are `Vixen.Editor.Host`'s, because only a head opens one.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Platform\Vixen.Platform.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Ui.Renderer\Vixen.Ui.Renderer.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Graphics.RenderGraph\Vixen.Graphics.RenderGraph.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Rendering.Terrain\Vixen.Rendering.Terrain.csproj" />

        <!--
            ⚠ The standard renderer, so that the editor's viewport can be the *same* frame a game
            draws rather than a second one shaped like it. `WorldRenderer` is where the arrangement of
            features, descriptor allocators, vertex schemas and the four seats a compositor document
            cannot fill was settled — every one of them a decision whose absence draws nothing and
            reports success — and an editor that assembled its own would be a second place for all of
            them to be got wrong differently.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Engine.Renderer\Vixen.Engine.Renderer.csproj" />

        <!--
            ⚠ And the post chain, for the two nodes without which a compositor-driven pane is not a
            picture. `ForwardPlus` shades in cd/m² — an overcast sky is thousands of them — so a frame
            with no `!Tonemap` in it is every surface clipped to white, which reads as broken lighting
            rather than as a missing grade; and a frame with no `!Sky` draws the level against the
            clear colour, which is the same picture as an environment that never reached set 0. Both
            node kinds live here because this assembly is downstream of `Vixen.Rendering` and a
            builder that named its types would be a cycle.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering.PostFx\Vixen.Rendering.PostFx.csproj" />

        <!--
            And water's, for the terrain reference's reason one subsystem over: `WaterPresenter` runs
            `WaterZoneSystem.Fold` over the scene document's world, which is the *same* fold a game
            runs — docs/plan/35 § D2. A second implementation of it in the editor would be a second
            opinion about where the water is, and the frame the two stopped agreeing on would be the
            bug somebody opened the editor to find.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering.Water\Vixen.Rendering.Water.csproj" />

        <!--
            ⚠ And buoyancy, which is the one reference here that is *not* about drawing. docs/plan/35
            § D1 keeps `Vixen.Water.Physics` — and therefore Jolt — out of every host that does not
            float something, so a game opts in and `Vixen.App.Hosting` deliberately does not link it.
            An editor is the exception, and for a reason that has nothing to do with running physics:
            `BuoyancyBody` is a scene component, and a component whose assembly is not loaded is
            missing from Add ▸ and takes a scene naming it down on load. See `BuiltInSubsystems`.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Water.Physics\Vixen.Water.Physics.csproj" />

        <!--
            ⚠ And physics itself, which is the reference docs/plan/31 § D10 spent two years saying
            nothing under Editor/ had. It is here for the opposite reason to the one above: not a
            component type the Add ▸ menu needs to know exists, but the four fixed-step passes an
            in-editor *play session* runs — `PlayPhysics` builds a `PhysicsScene` over the world being
            edited when Play is pressed and disposes it when Stop is. Nothing simulates while the
            editor is editing, which is the whole shape of that class.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Physics\Vixen.Physics.csproj" />

        <!--
            Analyzers do not flow transitively through a ProjectReference, so an assembly declaring
            [Inspector] members of its own — which SceneEntity does — has to name the generator.
        -->
        <ProjectReference Include="..\Vixen.Editor.Inspector.Generator\Vixen.Editor.Inspector.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
            And the reflection generator, for the same reason and about the other attribute. The
            settings assets this application ships — what a project is called, what it builds for —
            are ordinary [DataContract] types, because that is what makes "adding a project setting
            is declaring a type" true: the same YAML binder reads them that reads a .meta file, and
            ProjectSettingsStore names their file after the contract's alias rather than after the
            C# type so that renaming the type does not orphan every project's settings.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

    </ItemGroup>


    <ItemGroup>
        <!--
            The application, the panels and the two view objects it joins the model to are all
            internal — this assembly is a head and has no public surface to speak of — so the tests
            that drive it the way a person does have to be a friend.
        -->
        <InternalsVisibleTo Include="Vixen.Editor.App.Tests" />

        <!--
            And the automation harness, which drives the same internals on behalf of every suite
            that is not this one's. Doc 20's E6 asks for it and its ordering note says to build it
            during E1 rather than after E5 — a harness written last is a harness written against a
            frozen target.
        -->
        <InternalsVisibleTo Include="Vixen.Editor.Testing" />

        <!-- And the executable, which is a head over this library rather than the head itself. -->
        <InternalsVisibleTo Include="VixenEditor" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The VXML compiler. Analyzers do not flow transitively through a ProjectReference, so an
            assembly with `.vxml` in it names the generator the same way it names the others above.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Markup.Generators\Vixen.Ui.Markup.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
            ⚠ **And the other one, which the sentence above is equally true of and which this project
            went without.** `Vixen.Ui.Generators` is what turns a `[UiProperty]` into a property the
            cascade can see and what runs VXS0320; the package carries both side by side, so the
            omission is only reachable from inside this repository. VX4003 says so now.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Generators\Vixen.Ui.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The interface's face, embedded for the reason `Fonts` gives: a font beside the binary is
            a font a publish step can drop, and the failure is a window whose every label measures
            zero. Open Sans under the SIL Open Font License 1.1 — Fonts/OFL.txt is the licence as it
            ships, and NOTICE names it.

            ⚠ **In this assembly and not in the executable, because `Fonts` is in this assembly.**
            `Fonts.Embedded` reads `typeof(Fonts).Assembly`, so the resource name it computes is
            `Vixen.Editor.App.Fonts.OpenSans-Regular.ttf` no matter who calls `Install`. Embedding
            the file in `Vixen.Editor.Host` — which is where it sat from the library split until this
            was found — leaves that lookup answering null, and the fallback below it is a *silent*
            one: the editor comes up in Arial, Segoe UI or DejaVu Sans depending on the machine, and
            the only symptom is that the three platforms measure, wrap and photograph differently.
        -->
        <EmbeddedResource Include="Fonts\*.ttf" />
    </ItemGroup>

    <!--
        What a PackageReference to Vixen.Ui would have imported: the **/*.vxml glob and the two
        properties the generator asks MSBuild for. At the bottom of the file, because the glob has
        to run after DefaultItemExcludes is final.
    -->
    <Import Project="..\..\Core\Vixen.Ui\build\Vixen.Ui.targets" />

    <!--
        ⚠ **The editor's tokens, not a copy of them.** This assembly's panels are the editor's
        chrome, so they are styled by the editor's design; before this line the utility half of that
        design stopped at `Vixen.Editor.Ui`'s assembly boundary and every class name here had to be
        said again as a tag rule. Exit criterion 6 of doc 43 is that a utility class written in any
        editor assembly resolves. See docs/plan/43 Part 3.
    -->
    <Import Project="..\Vixen.Editor.Ui\build\Vixen.Editor.Ui.Styling.targets" />

</Project>
