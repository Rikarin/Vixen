<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="CsCheck" />

        <!--
            For the one test that matters most about a code generator: that what it wrote compiles.
            Structural assertions over a string catch a missing brace and nothing else — a duplicate
            member, an identifier that is not one, a keyword — and every one of those reaches a game's
            build rather than this one. Vixen.Templates.Tests takes the same dependency for the same
            reason.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Editor.Assets\Vixen.Editor.Assets.csproj" />

        <!-- The device the loader registers a mesh against. What is being tested is the join between an
             import and the runtime, and the runtime half needs somewhere to put its buffers. -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Null\Vixen.Graphics.Null.csproj" />

        <!-- CompositorWriter's round-trip tests explode a !StandardFrame first, because the
             expansion is the one producer of a document that uses every node kind at once. -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering.PostFx\Vixen.Rendering.PostFx.csproj" />

        <!--
          The four assemblies whose components a scene with water names. Referenced by the *tests* and
          not by Vixen.Editor.Assets, which reads the water kernel only — a scene compiler binds a
          component through SceneComponentRegistry and never names its type, so the assembly that
          declares one has to be loaded by whoever is asking. That is the caveat SceneWaterComponentTests'
          constructor makes explicit, and referencing them here is what lets it.

          ⚠ Vixen.Rendering.Water and Vixen.Water.Physics also happen to be the two that were missing
          Vixen.Engine.Generators, which is what made a scene carrying water fail to load at all. This
          reference is what turns that from an unobservable omission into a test.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering.Water\Vixen.Rendering.Water.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Water.Physics\Vixen.Water.Physics.csproj" />

        <!--
          Analyzers do not flow transitively through a ProjectReference. The fixture importer settings
          here are [DataContract] types the binder has to describe, and the end-to-end test writes a
          real chunk and loads it back, which needs a real serializer — so both generators are named.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
