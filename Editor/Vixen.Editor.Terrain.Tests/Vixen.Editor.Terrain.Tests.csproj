<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Ui.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Editor.Terrain\Vixen.Editor.Terrain.csproj" />

        <!--
            `UiTest`, for `FactBlockTests` — the shared part's port is asserted by dumping the whole
            document's rectangles for the hand-written loop and for the part and comparing the two
            strings, which is what the wave-3 and wave-4 ports were accepted on.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Testing\Vixen.Ui.Testing.csproj" />
    </ItemGroup>
    <!--
        #1119's ratchet: the TEST profile in `Directory.Build.props` turns documentation generation
        off for every `*.Tests` project, so no `<see cref>` in any test assembly was ever checked —
        and a test's remarks are read at the worst possible moment, when the test has just gone red.
        CS1591 and CS1573 stay suppressed: "this public member has no comment" is a question about a
        packaged API surface, and a test assembly is not one. Measured before flipping, and the
        diagnostics it reported are fixed in the same commit.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
