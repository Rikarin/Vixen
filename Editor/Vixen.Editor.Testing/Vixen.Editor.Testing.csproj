<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.Testing</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--
            The editor itself, as an Exe project reference. What is under test is the head: which
            panel a click landed in, what the inspector was handed, which of the several selections
            won. A harness that stood up its own shell and its own panels would be a harness for a
            copy of the thing that breaks.

            ⚠ The head's types are internal — it is an application and has no public surface — so
            this assembly is named in its InternalsVisibleTo. Nothing internal leaves here: what this
            project publishes is the shell, the project, the scene and the controls, all of which are
            public types belonging to the assemblies that own them.
        -->
        <ProjectReference Include="..\Vixen.Editor.App\Vixen.Editor.App.csproj" />

        <!--
            ⚠ And the executable, for its module list. `EditorApplication` is constructed directly
            here — the harness has no window and no device — but an editor without its features is
            not the thing under test, and doc 36 § P3 put the list of features in the executable
            precisely so that the library cannot name them. One list, not two that drift.
        -->
        <ProjectReference Include="..\Vixen.Editor.Host\Vixen.Editor.Host.csproj" />

        <!--
            The document harness this is built on. Frames rather than a wall clock, selectors that
            are the cascade's own, and a software rasteriser for the pictures — none of which is
            worth a second implementation just because the document belongs to an editor.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Testing\Vixen.Ui.Testing.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The head's own suite reaches `Application` for the few assertions that are about the head
            rather than about the interface — installing a thumbnail uploader, for one. Everything
            else this assembly publishes is public.
        -->
        <InternalsVisibleTo Include="Vixen.Editor.App.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <!--
            #821's ratchet. The TOOLING profile in `Directory.Build.props` sets this false for all of
            `Editor/**`, `Tools/**` and `Raven/**`, so no `<see cref>` under any of them was ever
            checked — ask what that gate printed on the day it did not run: `0 Warning(s)`. CS1591
            and CS1573 stay suppressed: "this public member has no comment" is a question about a
            packaged API surface and is not what this is for; the rules that catch a *lie* are.
            Measured before flipping, and every diagnostic it reported is fixed in the same commit.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
