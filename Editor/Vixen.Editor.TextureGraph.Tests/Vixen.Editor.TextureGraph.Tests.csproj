<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.TextureGraph.Tests</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Editor.TextureGraph\Vixen.Editor.TextureGraph.csproj" />

        <!-- The Raven front end, so a test can put the source a node generated through the same
             compiler the compiler used and read the diagnostics back as objects. -->
        <ProjectReference Include="..\..\Raven\Vixen.Raven\Vixen.Raven.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Syntax\Vixen.Core.Syntax.csproj" />

        <!-- The evaluator dispatches, so the tests that say what came out need a real backend. They
             skip loudly without one, they name the adapter they ran on, and VIXEN_REQUIRE_VULKAN=1
             turns the skip into a failure. ⚠ Half of this suite needs no device at all — the plan,
             the pool and the kernel compilations are asserted with nothing open. -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Vulkan\Vixen.Graphics.Vulkan.csproj" />

        <!-- ⚠ And the Null backend, for exactly one question a real adapter cannot answer: which
             queue a bake submits to. `NullDevice` builds three distinct submitters — "unlike every
             real device the tree runs on", as it says itself — while MoltenVK, and every unified
             adapter, collapses compute onto the graphics family, so #617's cross-queue access was
             invisible on the machine it was written on. Nothing in `TextureQueueTests` looks at a
             pixel; a Null-device test that did would be proving that a black image equals a black
             image. -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Null\Vixen.Graphics.Null.csproj" />

        <!--
            ⚠ **`MapBaker.IdColour`, and only so that a fixture stops being three numbers somebody
            chose.** Doc 48 § M8's colour selection exists for the `id` bake, and that map's whole
            character is its palette: a golden-angle hue sweep in which index distance and colour
            distance are *unrelated*. `TextureSelectionDeviceTests` turns on exactly that property —
            ids 0 and 1 are a third of the circle apart and ids 0 and 89 five thousandths of it — so
            transcribing the formula into the test would be asserting against a second copy of the
            thing under test, which is the shape this repository refuses everywhere else.

            Measured rather than assumed: `Vixen.Geometry.Remeshing` names `Vixen.Geometry`,
            `Vixen.Geometry.Uv`, `Vixen.Core.Mathematics` and `Vixen.Core.Threading`, all four of
            which are already in this assembly's closure through `Vixen.Editor.TextureGraph`. So it
            adds one file to the output directory. ⚠ It is a *test* reference and must stay one: the
            evaluator itself may not reference a mesh baker, which is what keeps a graph from being
            able to name the mesh it is for.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Geometry.Remeshing\Vixen.Geometry.Remeshing.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            ⚠ **A face, because doc 48 § 4.1's `Text` cannot be asserted without one and the machine
            must not be asked for it.** `TextShaper` deliberately reads no `CultureInfo` and takes no
            default from the process; a test that loaded "the system's sans-serif" would be shaping a
            different outline on every developer's laptop and on CI, which is the failure
            `Vixen.Ui.Text`'s own suite committed twenty-two fonts to avoid.

            The editor's own UI font, linked rather than copied: a second checked-in binary of the
            same face is a thing that can drift, and this one is already in the tree with its licence
            beside it.
        -->
        <EmbeddedResource Include="..\Vixen.Editor.App\Fonts\OpenSans-Regular.ttf"
                          Link="Fonts\OpenSans-Regular.ttf"
                          LogicalName="Fonts.OpenSans-Regular.ttf" />
    </ItemGroup>
    <!--
        #1119's ratchet: the TEST profile in `Directory.Build.props` turns documentation generation
        off for every `*.Tests` project, so no `<see cref>` in any test assembly was ever checked —
        and a test's remarks are read at the worst possible moment, when the test has just gone red.
        CS1591 and CS1573 stay suppressed: "this public member has no comment" is a question about a
        packaged API surface, and a test assembly is not one. Measured before flipping, and the
        diagnostics it reported are fixed in the same commit.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
