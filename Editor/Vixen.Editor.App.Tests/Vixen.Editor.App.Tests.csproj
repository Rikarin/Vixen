<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Editor.Ui.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <!--
            Doc 36 § P2's acceptance criterion is a plugin *built outside the solution*, so the one
            here is compiled from C# at run time against whatever this test process has loaded. That
            is stronger than a fixture project: the plugin genuinely cannot see anything the editor
            has not published, and a contribution point that only worked because the two were built
            together would fail here rather than pass quietly.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />

        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!--
            Linked rather than copied or moved. The plugin suite's fixture is the same fixture — a
            manifest and an assembly compiled from source the test wrote — and a second copy would
            drift. Moving it into Vixen.Editor.Testing instead would make the plugin suite depend on
            the whole editor application, which is exactly the isolation those tests exist to keep.
        -->
        <Compile Include="..\Vixen.Editor.Plugin.Tests\PluginFolder.cs" Link="PluginFolder.cs" />

        <!--
            And the throwaway file system the headless platform is pointed at, linked for the reason
            above: `EditorHostTests` runs a real `EditorHost`, which writes a layout, a keymap and a
            window placement on the way down — into the developer's home directory unless something
            says otherwise. A third copy of thirty lines that already exist twice would be the
            drift this project already refuses.
        -->
        <Compile Include="..\..\Platform\Vixen.Platform.Headless.Tests\TemporaryFileSystemHost.cs"
                 Link="TemporaryFileSystemHost.cs" />

        <!--
            The editor's own tool modules, which the head embeds and this project cannot reach. The
            capture builds a real `FramePresenter`, whose line and mesh pipelines a device refuses
            without valid SPIR-V — and a `UiRenderer`, because `Resize` registers the pane's texture
            through one. Linked from the head's folder rather than copied, so a shader rebuilt by
            `CheckShaders` reaches both.
        -->
        <None Include="..\Vixen.Editor.Host\Shaders\*.spv"
              Link="ToolShaders\%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" />

        <!--
            The committed screenshots. Beside the binary, because `VisualBaseline` reads the reference
            from the output directory and writes an accepted one back into the source tree — see its
            remarks for why those are two different places.
        -->
        <None Include="__screenshots__\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The head itself, which is the thing under test: what is in the panels and what the panels
            are looking at lives there and nowhere else, and a test of the join has to be a test of
            the assembly that makes it.
        -->
        <ProjectReference Include="..\Vixen.Editor.App\Vixen.Editor.App.csproj" />

        <!--
            The recording device, so ScenePresenter's draws can be asserted without a GPU. The
            editor itself never references a backend — EditorHost is handed one — so this is the
            test project's dependency rather than the application's.
        -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Null\Vixen.Graphics.Null.csproj" />

        <!--
            And a real backend, for `ComposedPaneCaptureTests` alone. Everything the recording device
            can answer about a four-pane frame is a counter, an index or a name, and this tree's
            commonest defect is a frame in which all three are healthy and no fragment survives — so
            the composed panes need a picture somebody can look at. The editor's own host cannot take
            one, because it opens a window.

            ⚠ The capture is off unless `VIXEN_PANE_CAPTURE` names a directory, so a machine with no
            driver and a CI leg that asked for nothing both run exactly as they did.
        -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Vulkan\Vixen.Graphics.Vulkan.csproj" />

        <!--
            The automation harness, which is how these tests drive the head. It came out of the
            fixture that used to live in this project: a harness only one suite can reach is one the
            scenario tests, the golden suite and anybody's plugin have to each rewrite.
        -->
        <ProjectReference Include="..\Vixen.Editor.Testing\Vixen.Editor.Testing.csproj" />

        <!--
            The platform with nothing attached, which is what `EditorHostTests` builds the host over.
            One reference and one fixture is the whole cost of running the editor's own frame loop:
            `EditorHost` takes an `IPlatform` and an `IWindow`, and a headless window's surface
            cannot present, so the loop runs its nine CPU steps and returns before Vulkan.
        -->
        <ProjectReference Include="..\..\Platform\Vixen.Platform.Headless\Vixen.Platform.Headless.csproj" />

        <!--
            The picker fixture below declares [Inspector] members of its own, so this assembly needs
            the generator: a descriptor is a build artefact, and a hand-written stand-in would be a
            test of the stand-in.
        -->
        <ProjectReference Include="..\Vixen.Editor.Inspector.Generator\Vixen.Editor.Inspector.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
            And the serializer, for the same reason and about a different fixture: `LateComponent`
            stands in for a component whose assembly loads after the editor is up, and
            `SceneComponentRegistry.Register` refuses a type with no serializer — correctly, since a
            compiled scene could not carry one. A hand-written stand-in would be a test of the
            stand-in.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
            And the descriptor, which is what the inspector draws a row from. `PatrolBehavior` below
            is a fixture whose whole point is being drawn, and a type with no descriptor is one the
            component panel shows as "No description, so there is nothing to draw".
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
