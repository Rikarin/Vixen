<!--
    SPDX-FileCopyrightText: Copyright (c) Rikarin
    SPDX-License-Identifier: Apache-2.0

    Doc 36 § F7 wave 8. The code editor pane: a `CodeEditor`, and a document behind it.

    ⚠ **The chrome is one bar with one toggle, and the toggle is the whole reason the bar exists.**
    `CodeEditor.WordWrap` shipped with no caller anywhere in the editor, so a long line in a `.rvn`,
    a `.vcss` or a `.vxml` scrolled sideways and nothing could ask it not to. It is a *view* setting
    — it lives on this control instance and not on the document — so two panes over the same file
    wrap independently, which is what every editor that has the setting does.

    ⚠ **The editor is inside `code-column` rather than being a direct child of the pane.** The pane
    is a `row` (the preview sits beside it), so a bar above the editor needs a column of its own.
    `PreviewCodeEditorView` still appends its pane after this whole column, which keeps the order
    `ChromeDumpTests` asserts: the editor before the preview.

    ⚠ **The other four settings do not need a caller.** `TabSize` (4), `AutoIndent` and `AutoFold`
    default to what a code editor wants, so "nothing sets them" is not a defect — and `ReadOnly`
    *does* have a production caller, `ShaderGraphView.vxml`'s generated-Raven pane. A sweep that read
    only `.cs` could not see it.

    ⚠ **`CodeEditor` is fed by properties with hand-written setters rather than by `[UiProperty]`,
    and they are assigned in an order that matters** — the tokenizer before the buffer, because
    assigning a buffer resets every cached highlighting state. So `Show` stays a method rather than
    becoming two parameters: two bindings have no order anybody can read, and the one here is the
    difference between tokenizing the file once and twice.

    ⚠ **`SetDiagnostics` is a method taking a span**, which is `use`'s case — and it is deliberately
    *not* used. `Restate` is `protected virtual` and the subclass overrides it; an effect would run
    on the frame after the analysis rather than inside the call the subclass is extending, and
    `Analyse()` returns the count on the line after. Shape 3, on a caller that really does read back.
-->
@component CodeEditorView
@namespace Vixen.Editor.AssetEditors.Code
@inherits Vixen.Ui.Controls.Control
@tag code-editor-pane
@using Vixen.Ui
@using Vixen.Ui.Controls
@using Vixen.Ui.Controls.Advanced

<code-column>
    <code-chrome ref="@Chrome">
        <!-- ⚠ No `IsChecked` literal here, and it is not an oversight: a literal would run the
             change handler while the scaffold is still building this bar, which is before the
             `CodeEditor` below it exists and before `Editor` is assigned. Off is also what the
             control starts as, so the two agree without anybody stating it twice. -->
        <ToggleButton ref="@Wrap" Label="Wrap" change:IsChecked="@(on => Editor.WordWrap = on)" />
    </code-chrome>

    <CodeEditor ref="@Editor" />
</code-column>

@code {
    CodeDocument? document;

    /// <inheritdoc />
    protected override bool AcceptsFocus => false;

    /// <summary>The editor.</summary>
    public CodeEditor Editor { get; private set; } = null!;

    /// <summary>The bar above the editor.</summary>
    public UiElement Chrome { get; private set; } = null!;

    /// <summary>The word-wrap toggle.</summary>
    /// <remarks>
    ///     ⚠ <b>The toggle is the setting.</b> Nothing mirrors it into a field, so
    ///     <c>Wrap.IsChecked</c> and <see cref="CodeEditor.WordWrap" /> cannot drift — flipping the
    ///     property from code without the button would leave a bar that lies, which is why
    ///     <see cref="Wrapped" /> exists and writes both.
    /// </remarks>
    public ToggleButton Wrap { get; private set; } = null!;

    /// <summary>Whether long lines are broken across rows.</summary>
    /// <remarks>
    ///     The view's own setting rather than the document's: two panes over one file wrap
    ///     independently, which is what <see cref="CodeEditor.WordWrap" /> being on the control
    ///     already means.
    /// </remarks>
    public bool Wrapped {
        get => Editor.WordWrap;
        set {
            // The button first: assigning `IsChecked` runs the `change:` handler, which is what puts
            // the value on the editor. Doing it the other way round would work too and would leave
            // the second write to set a property to what it already holds.
            Wrap.IsChecked = value;
            Editor.WordWrap = value;
        }
    }

    /// <summary>The document being edited, or <see langword="null" />.</summary>
    public CodeDocument? Edited => document;

    /// <summary>Shows a document.</summary>
    /// <param name="code">The document.</param>
    /// <exception cref="ArgumentNullException"><paramref name="code" /> is null.</exception>
    public virtual void Show(CodeDocument code) {
        ArgumentNullException.ThrowIfNull(code);

        if (document is { } previous) {
            previous.Analysed -= Restate;
        }

        document = code;

        // The tokenizer before the buffer: assigning a buffer resets every cached highlighting
        // state, so setting it second would tokenize the whole file twice on open.
        Editor.Tokenizer = code.Tokenizer;
        Editor.Buffer = code.Buffer;

        code.Analysed += Restate;
        Analyse();
    }

    /// <summary>Runs the document's analysis and puts the result in the gutter.</summary>
    /// <returns>How many errors it found.</returns>
    public int Analyse() {
        if (document is not { } code) {
            return 0;
        }

        code.Reanalyse();

        return Errors;
    }

    /// <summary>How many errors the last analysis found.</summary>
    public int Errors {
        get {
            var count = 0;

            foreach (var diagnostic in document?.Diagnostics ?? []) {
                if (diagnostic.Severity == CodeSeverity.Error) {
                    count++;
                }
            }

            return count;
        }
    }

    /// <summary>Called after the document has been analysed.</summary>
    /// <param name="code">The document.</param>
    /// <exception cref="ArgumentNullException"><paramref name="code" /> is null.</exception>
    protected virtual void Restate(CodeDocument code) {
        ArgumentNullException.ThrowIfNull(code);

        // A span, so the control does not have to be handed a list it might keep. The document's
        // own list is the one thing that outlives a repaint.
        Editor.SetDiagnostics([.. code.Diagnostics]);
    }
}
