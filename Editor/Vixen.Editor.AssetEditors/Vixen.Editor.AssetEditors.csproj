<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.AssetEditors</RootNamespace>
        <Description>
            The editors doc 11 lists per asset kind: import settings with a per-target override
            matrix and a channel/mip viewer for textures, a part list for models, a material
            document with a preview, scene and prefab documents with override indication, the
            Raven and VXML/VCSS code editors with live diagnostics and a preview pane, the
            addressable group list with its build analysis, and the graphics compositor as a graph.
        </Description>
        <PackageTags>editor;asset-editor;import-settings;material;prefab;compositor;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- Every editor here is a document with an undo stack, which is this assembly's whole shape. -->
        <ProjectReference Include="..\Vixen.Editor.Core\Vixen.Editor.Core.csproj" />

        <!--
            The rows an import-settings editor is made of. An asset editor that drew its own fields
            would be a second inspector with its own mixed-value, undo and reset behaviour — and the
            override matrix is exactly the case where that would have gone wrong quietly.
        -->
        <ProjectReference Include="..\Vixen.Editor.Inspector\Vixen.Editor.Inspector.csproj" />

        <!--
            The settings types being edited, the addressable group policy, and the pipeline the
            analysis view runs. This is the assembly that decides what a .meta means; an editor for
            one that redeclared the schema would be the second copy that drifts.
        -->
        <ProjectReference Include="..\Vixen.Editor.Assets\Vixen.Editor.Assets.csproj" />

        <!--
            SceneDocument, and with it the world a prefab is edited in. A prefab is a scene with one
            root, so the isolated mode is a second document over the same machinery rather than a
            second scene editor.
        -->
        <ProjectReference Include="..\Vixen.Editor.SceneView\Vixen.Editor.SceneView.csproj" />

        <!--
            The plugin contract, because this assembly registers its own last mile rather than being
            wired in. Doc 36 § P3: binding a freshly-opened document to the rig, the sets and the
            scene it names used to be a line in the editor's application.
        -->
        <ProjectReference Include="..\Vixen.Editor.Plugin\Vixen.Editor.Plugin.csproj" />

        <!--
            The compositor is a node graph, and doc 11's argument for building one framework rather
            than three is the reason it is this one.
        -->
        <ProjectReference Include="..\Vixen.Editor.NodeGraph\Vixen.Editor.NodeGraph.csproj" />

        <!--
            The VFX node library and its compiler. That assembly deliberately knows nothing about a
            project, a document or a panel — which is what lets it be tested by compiling a graph
            with no editor in the way — so the document, the view and the factory over it are here,
            where every other row of doc 11's asset-editor table already is.
        -->
        <ProjectReference Include="..\Vixen.Editor.VfxGraph\Vixen.Editor.VfxGraph.csproj" />

        <!-- And the third graph, for the same split: states and transitions there, document here. -->
        <ProjectReference Include="..\Vixen.Editor.AnimationGraph\Vixen.Editor.AnimationGraph.csproj" />
        <ProjectReference Include="..\Vixen.Editor.Ai\Vixen.Editor.Ai.csproj" />

        <!--
            The shader node library and its Raven emission, on the same split again: the nodes and the
            compiler stay there, where they are checked by putting the emitted source through the real
            Raven front end, and the document, the panel and the factory are here.
        -->
        <ProjectReference Include="..\Vixen.Editor.ShaderGraph\Vixen.Editor.ShaderGraph.csproj" />

        <!-- GraphicsCompositorAsset: the document the compositor graph compiles to. -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering\Vixen.Rendering.csproj" />

        <!--
            StandardFrameAsset, the quality waterfall and the expansion behind doc 39's frame panel.
            The node kinds the expansion emits live here, so this is also the only door to it —
            `PostEffectFactory` is the transformer seam `CompositorBuilder.Build` applies, and a
            panel that expanded a document any other way would be showing a frame the builder would
            not have built.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering.PostFx\Vixen.Rendering.PostFx.csproj" />

        <!--
            AnimationClipData and the state machine the animation graph compiles to, the mixer the
            audio editor is a view over, and the action model the input editor reads and writes. Each
            is the runtime's own type: an editor-side copy of any of them would be the second
            declaration that drifts, which is the argument the compositor's row already makes.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Animation\Vixen.Animation.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Audio\Vixen.Audio.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Input\Vixen.Input.csproj" />

        <!-- The font atlas and its metrics, which is what a font editor shows. -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Text\Vixen.Ui.Text.csproj" />

        <!-- CodeEditor, Viewport and the tree — the three controls the advanced set exists for. -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Controls.Advanced\Vixen.Ui.Controls.Advanced.csproj" />

        <!--
            A .meta, a .vxmat and a .vxgroup are all YAML, and a settings editor works on the node
            tree rather than on a bound object — see ImportSettingsDocument for why.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Yaml\Vixen.Core.Yaml.csproj" />

        <!--
            The VXML front end, for the markup editor's diagnostics and for the structure the preview
            pane builds. Vixen.Ui.Styling arrives with Vixen.Ui, which is what makes a .vcss preview
            a stylesheet reload rather than a rebuild.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Markup\Vixen.Ui.Markup.csproj" />

        <!--
            Raven's lexer, parser and binder, for the shader editor's live diagnostics. Nothing here
            emits SPIR-V: the editor wants to know where the squiggle goes, and a backend run per
            keystroke is what the compiler service is for.
        -->
        <ProjectReference Include="..\..\Raven\Vixen.Raven\Vixen.Raven.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            Analyzers do not flow transitively through a ProjectReference, so an assembly declaring
            types of its own has to name every generator it depends on: [Inspector] members for the
            settings mirrors and the material, [Node] classes for the compositor's node library, and
            [DataContract] for the material asset's own schema.
        -->
        <ProjectReference Include="..\Vixen.Editor.Inspector.Generator\Vixen.Editor.Inspector.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Vixen.Editor.NodeGraph.Generator\Vixen.Editor.NodeGraph.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
            The VXML compiler, by the same route and for the same reason `Vixen.Editor.Terrain` names
            it: a PackageReference to Vixen.Ui would bring it and a ProjectReference does not. Doc 36
            § P4 made markup the authoring path for an inspector, and the frame panel's two forms are
            written in it rather than by hand.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Markup.Generators\Vixen.Ui.Markup.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
            ⚠ **And the other one, which the sentence above is equally true of and which this project
            went without.** `Vixen.Ui.Generators` is what turns a `[UiProperty]` into a property the
            cascade can see and what runs VXS0320; the package carries both side by side, so the
            omission is only reachable from inside this repository. VX4003 says so now.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Generators\Vixen.Ui.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Editor.AssetEditors.Tests" />

        <!--
            ⚠ And the head's suite, because `AnimationBinder` is asserted against a whole editor
            session. It moved here from `Vixen.Editor.App` with doc 36 § P3 and its tests did not:
            what they drive is a project on disk, a scan and four documents opening, which is
            `EditorSession`'s vocabulary and not this assembly's. Internal rather than public because
            nothing outside an editor has any use for it.
        -->
        <InternalsVisibleTo Include="Vixen.Editor.App.Tests" />
    </ItemGroup>

    <!--
        What a PackageReference to Vixen.Ui would have imported: the **/*.vxml glob and the two
        properties the generator asks MSBuild for. At the bottom of the file, because the glob has to
        run after DefaultItemExcludes is final.
    -->
    <Import Project="..\..\Core\Vixen.Ui\build\Vixen.Ui.targets" />

    <!--
        ⚠ **The editor's tokens, not a copy of them.** Four `.vxml` inspectors here and the views
        behind them are the editor's chrome and are styled by the editor's design; before this line
        the utility half of it stopped at `Vixen.Editor.Ui`'s assembly boundary. The evidence is
        still in `AssetEditorTheme`'s own remark about `.hidden` belonging to `AdvancedTheme` — a
        utility class name that had to be hand-written into a component sheet because the utility
        system could not reach this assembly. See docs/plan/43 Part 3.
    -->
    <Import Project="..\Vixen.Editor.Ui\build\Vixen.Editor.Ui.Styling.targets" />

</Project>
