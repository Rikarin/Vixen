<!--
    SPDX-FileCopyrightText: Copyright (c) Rikarin
    SPDX-License-Identifier: Apache-2.0

    Doc 36 § F7 wave 6. doc 37 § Part 5's environment-query editor: two ordered lists, a curve, a
    preview and the compiler's complaints. The ledger sized it S/M with "port; leave
    `CurveEditor`/`NodeCanvas` behind a `ref`", and that instruction is the whole of the curve's
    story — `CurveEditor.Apply(AnimationCurve)` is a method over a control's own model, which is the
    ledger's shape 1, so the control is a `ref` and `RefreshCurve` is unchanged C#.

    ⚠ **Four of the five element *tags* here are chosen by the data, and that is what decided the
    keys.** A test row is `<query-row>` or `<query-row-selected>`; a preview point is one of three
    tags. A tag is not a class and cannot be bound — `BuildContext.Attribute` would make it a
    selector attribute — so the choice is an `@if` inside the loop body, and an `@if` inside a
    surviving region is exactly wave 4's trap. The escape is that **the selected flag is in the
    key**: `QueryTestRow` carries `Selected`, so moving the selection gives both the old row and the
    new one a different key, both regions are rebuilt, and the arm is re-chosen as it is built. A
    key that left `Selected` out would show the first selection for ever, silently.

    ⚠ **Every row key is the whole record**, which is the immutable-data half of the `@for` rule.
    Nothing behind this panel is signal-backed below the four lists, so a changed number has to *be*
    a changed identity. Each record carries its slot as well as its text, because two rows can
    legitimately read the same — eighty-one generated points at the same score is the ordinary case
    here, not the hypothetical one — and `BuildContext.For` cannot reconcile two equal keys in one
    loop.

    ⚠ **`query-detail` is a container in one place and a caption in five.** The right-hand pane is
    `query-detail` with children; a generator's, a test's and a point summary's detail is a
    `query-detail` with its own text. One `UiElement` subclass serves both — `<query-detail>` for the
    pane, `<QueryDetail Text="…" />` for the cell — because the tag is the same either way and the
    hand-written panel made no distinction either.

    ⚠ **`Compile()` returns synchronously and the diagnostics list is right on the next flush**, and
    that split is deliberate rather than a compromise. The ledger's shape 3 asks who reads what back
    with no frame between: the return value is the `EnvironmentQuery` and it is produced before any
    signal is written, and `QueryEditorFactory.CreateView` — the one production caller — reads
    nothing at all.
-->
@component QueryView
@namespace Vixen.Editor.AssetEditors.Ai
@inherits Vixen.Ui.Controls.Control
@tag query-editor
@using System.Collections.Immutable
@using System.Globalization
@using Vixen.Ai
@using Vixen.Core.Curves
@using Vixen.Editor.Core
@using Vixen.Ui
@using Vixen.Ui.Controls
@using Vixen.Ui.Controls.Advanced
@using Vixen.Ui.Reactive

<query-body>
    <query-lists>
        <query-toolbar>
            <Button ref="@Build" Label="Compile" />
        </query-toolbar>

        <PanelTitle Text="Generators" />

        <query-generators ref="@Generators">
            @for (var row in GeneratorRows) {
                <query-row key="@row">
                    <QueryKind Text="@row.Kind" />
                    <QueryDetail Text="@row.Detail" />
                </query-row>
            }
        </query-generators>

        <PanelTitle Text="Tests" />

        <query-tests ref="@Tests">
            @for (var row in TestRows) {
                @if (row.Selected) {
                    <query-row-selected key="@row">
                        <QueryOrder Text="@row.Order" />
                        <QueryKind Text="@row.Kind" />
                        <QueryPurpose Text="@row.Purpose" />
                        <QueryDetail Text="@row.Detail" />
                    </query-row-selected>
                } else {
                    <query-row key="@row">
                        <QueryOrder Text="@row.Order" />
                        <QueryKind Text="@row.Kind" />
                        <QueryPurpose Text="@row.Purpose" />
                        <QueryDetail Text="@row.Detail" />
                    </query-row>
                }
            }
        </query-tests>
    </query-lists>

    <query-detail>
        <PanelTitle Text="Response" />

        <CurveEditor ref="@Curve" />

        <PanelTitle Text="Points" />

        <query-points ref="@Preview">
            @if (Summary.Length > 0) {
                <query-summary>
                    <QueryDetail Text="@Summary" />
                </query-summary>
            }

            @for (var point in PointRows) {
                @if (point.Filtered) {
                    <query-point-filtered key="@point">
                        <QueryPosition Text="@point.Position" />
                        <QueryScore Text="@point.Score" />

                        @if (point.Factors.Length > 0) {
                            <QueryFactors Text="@point.Factors" />
                        }
                    </query-point-filtered>
                } else if (point.Best) {
                    <query-point-best key="@point">
                        <QueryPosition Text="@point.Position" />
                        <QueryScore Text="@point.Score" />

                        @if (point.Factors.Length > 0) {
                            <QueryFactors Text="@point.Factors" />
                        }
                    </query-point-best>
                } else {
                    <query-point key="@point">
                        <QueryPosition Text="@point.Position" />
                        <QueryScore Text="@point.Score" />

                        @if (point.Factors.Length > 0) {
                            <QueryFactors Text="@point.Factors" />
                        }
                    </query-point>
                }
            }
        </query-points>
    </query-detail>
</query-body>

<PanelTitle Text="Diagnostics" />

<query-diagnostics ref="@Diagnostics">
    @for (var note in DiagnosticRows) {
        <AnalysisRow key="@note" Stage="@note.Stage" Message="@note.Message" />
    }
</query-diagnostics>

@code {
    /// <summary>What makes the candidates, as the loop keys them.</summary>
    readonly Signal<ImmutableArray<QueryGeneratorRow>> generators = new([]);

    /// <summary>What filters and scores them, in the order they run.</summary>
    readonly Signal<ImmutableArray<QueryTestRow>> tests = new([]);

    /// <summary>The points the last preview produced, and the line above them.</summary>
    readonly Signal<ImmutableArray<QueryPointRow>> points = new([]);

    /// <inheritdoc cref="points" />
    readonly Signal<string> summary = new(string.Empty);

    /// <summary>What the last compile said, in the order it said it.</summary>
    readonly Signal<ImmutableArray<AnalysisNote>> notes = new([]);

    QueryDocument? document;
    QueryTestContent? test;
    bool listening;

    /// <inheritdoc />
    protected override bool AcceptsFocus => false;

    /// <summary>What makes the candidates.</summary>
    public UiElement Generators { get; private set; } = null!;

    /// <summary>What filters and scores them, in the order they run.</summary>
    public UiElement Tests { get; private set; } = null!;

    /// <summary>The selected test's response curve.</summary>
    /// <remarks>
    ///     ⚠ <b>A <c>ref</c>, and the ledger said so before this port started.</b> A curve reaches
    ///     the screen through <c>Apply(AnimationCurve)</c> — the control's own model, drawn by its
    ///     own paint — which is shape 1: no markup attribute binds it, and signal-backing what feeds
    ///     it would move no pixel. <see cref="RefreshCurve" /> is the hand-written panel's method,
    ///     unchanged.
    /// </remarks>
    public CurveEditor Curve { get; private set; } = null!;

    /// <summary>The points a preview run produced, best first.</summary>
    public UiElement Preview { get; private set; } = null!;

    /// <summary>What the last compile and the last run said.</summary>
    public UiElement Diagnostics { get; private set; } = null!;

    /// <summary>The button that compiles the query.</summary>
    public Button Build { get; private set; } = null!;

    /// <summary>The test that is selected, or null.</summary>
    public QueryTestContent? Selected => test;

    /// <summary>Shows a document.</summary>
    /// <param name="value">The query.</param>
    /// <exception cref="ArgumentNullException"><paramref name="value" /> is null.</exception>
    public void Show(QueryDocument value) {
        ArgumentNullException.ThrowIfNull(value);

        document = value;

        if (!listening) {
            document.Changed += _ => Refresh();
            listening = true;
        }

        test = document.Content.Tests.Count > 0 ? document.Content.Tests[0] : null;

        Refresh();
        Compile();
    }

    /// <summary>Selects a test.</summary>
    /// <param name="value">The test, or null.</param>
    public void Select(QueryTestContent? value) {
        test = value;

        Refresh();
    }

    /// <summary>Compiles the query and lists what it said.</summary>
    /// <returns>The query, or null.</returns>
    /// <remarks>
    ///     ⚠ <b>The return value is right on this line and the list is right on the next flush.</b>
    ///     That is <c>EffectScheduler</c>'s contract rather than this panel's choice (ADR-007), and
    ///     it is why the diagnostics are gathered into a builder and published once at the end.
    /// </remarks>
    public EnvironmentQuery? Compile() {
        if (document is null) {
            return null;
        }

        var query = document.Compile();
        var found = ImmutableArray.CreateBuilder<AnalysisNote>();
        var slot = 0;

        foreach (var diagnostic in document.Diagnostics) {
            found.Add(new(slot++, diagnostic.Node.IsSome ? diagnostic.Node.ToString() : "query", diagnostic.Message));
        }

        // Said on success too: a list that empties itself when everything is fine cannot be told apart
        // from one that never ran.
        if (query is not null && document.Diagnostics.Count == 0) {
            found.Add(
                new(
                    slot,
                    "query",
                    string.Create(
                        CultureInfo.InvariantCulture,
                        $"{query.Name} compiles: {query.Generators.Length} generator(s) making about "
                        + $"{query.Estimate} point(s), {query.Tests.Length} test(s)."
                    )
                )
            );
        }

        notes.Value = found.ToImmutable();

        return query;
    }

    /// <summary>Rebuilds every list from the document.</summary>
    public void Refresh() {
        if (document is null) {
            return;
        }

        RefreshGenerators();
        RefreshTests();
        RefreshCurve();
        RefreshPreview();
    }

    void RefreshGenerators() =>
        generators.Value = [
            .. document!.Content.Generators.Select(
                (generator, slot) => new QueryGeneratorRow(slot, generator.Kind.ToString(), Describe(generator))
            )
        ];

    void RefreshTests() =>
        tests.Value = [
            .. document!.Content.Tests.Select(
                (authored, slot) => new QueryTestRow(
                    slot,
                    ReferenceEquals(authored, test),

                    // The running order is a number on every row, because "why is this query
                    // expensive" is answered by which test is above which — and an author cannot see
                    // that from a list that does not say where each one sits.
                    slot.ToString(CultureInfo.InvariantCulture),
                    authored.Kind == QueryTestKind.Registered ? authored.Source : authored.Kind.ToString(),
                    authored.Purpose.ToString(),
                    Describe(authored)
                )
            )
        ];

    void RefreshCurve() {
        if (test is null) {
            return;
        }

        var shape = test.BuildCurve();
        var curve = new AnimationCurve();

        // Sampled at a fixed rate rather than shown as its own keys, for the reason UtilitySetView's
        // does it: five of the six shapes have no keys at all.
        for (var step = 0; step <= 32; step++) {
            var time = step / 32f;

            curve.Add(time, shape.Evaluate(time));
        }

        Curve.Apply(curve);
    }

    void RefreshPreview() {
        var results = document!.Results;

        if (results.Count == 0) {
            summary.Value = string.Empty;
            points.Value = [];

            return;
        }

        summary.Value = string.Create(
            CultureInfo.InvariantCulture,
            $"{results.Generated} generated, {results.Surviving} survived."
        );

        var rows = ImmutableArray.CreateBuilder<QueryPointRow>(results.Count);
        var index = 0;

        foreach (var point in results.Points) {
            var detail = results.DetailOf(index);
            var factors = string.Empty;

            if (!detail.IsEmpty) {
                var parts = new string[detail.Length];

                for (var factor = 0; factor < detail.Length; factor++) {
                    parts[factor] = detail[factor].ToString("0.##", CultureInfo.InvariantCulture);
                }

                factors = string.Join(" · ", parts);
            }

            // ⚠ Filtered points are listed and struck through rather than dropped. "Why is my query
            // returning nothing" is answered by seeing which test rejected everything, and a preview
            // that only showed survivors would answer it with an empty list.
            rows.Add(
                new(
                    index,
                    point.Filtered,
                    !point.Filtered && index == results.Best,
                    point.Position.ToString(),
                    point.Filtered ? "filtered" : point.Score.ToString("0.###", CultureInfo.InvariantCulture),
                    factors
                )
            );

            index++;
        }

        points.Value = rows.MoveToImmutable();
    }

    /// <summary>One generator, as a person reads it.</summary>
    /// <param name="generator">The generator.</param>
    /// <returns>Its text.</returns>
    /// <exception cref="ArgumentNullException"><paramref name="generator" /> is null.</exception>
    public static string Describe(QueryGeneratorContent generator) {
        ArgumentNullException.ThrowIfNull(generator);

        return generator.Kind switch {
            QueryGeneratorKind.Grid => string.Create(
                CultureInfo.InvariantCulture,
                $"{generator.Extent:0.#} m out, every {generator.Inner:0.##} m"
            ),
            QueryGeneratorKind.Circle => string.Create(
                CultureInfo.InvariantCulture,
                $"{generator.Points} points at {generator.Extent:0.#} m"
            ),
            QueryGeneratorKind.Donut => string.Create(
                CultureInfo.InvariantCulture,
                $"{generator.Rings} × {generator.Points} between {generator.Inner:0.#} and {generator.Extent:0.#} m"
            ),
            QueryGeneratorKind.Cone => string.Create(
                CultureInfo.InvariantCulture,
                $"{generator.Degrees:0}° wide, {generator.Extent:0.#} m deep"
            ),
            QueryGeneratorKind.CurrentLocation => "where the agent is standing",
            _ => generator.Source
        };
    }

    /// <summary>One test, as a person reads it.</summary>
    /// <param name="test">The test.</param>
    /// <returns>Its text.</returns>
    /// <exception cref="ArgumentNullException"><paramref name="test" /> is null.</exception>
    public static string Describe(QueryTestContent test) {
        ArgumentNullException.ThrowIfNull(test);

        var range = string.Create(CultureInfo.InvariantCulture, $"{test.Minimum:0.##}…{test.Maximum:0.##}");

        if (test.Purpose == QueryTestPurpose.Score) {
            return string.Create(CultureInfo.InvariantCulture, $"{range} through {test.Curve}");
        }

        var floor = float.IsNegativeInfinity(test.Floor)
            ? "−∞"
            : test.Floor.ToString("0.##", CultureInfo.InvariantCulture);

        var ceiling = float.IsPositiveInfinity(test.Ceiling)
            ? "∞"
            : test.Ceiling.ToString("0.##", CultureInfo.InvariantCulture);

        return test.Purpose == QueryTestPurpose.Filter
            ? $"keep {floor}…{ceiling}"
            : string.Create(CultureInfo.InvariantCulture, $"keep {floor}…{ceiling}, then {range} through {test.Curve}");
    }

    // ================================================================== What the markup reads

    ImmutableArray<QueryGeneratorRow> GeneratorRows => generators.Value;

    ImmutableArray<QueryTestRow> TestRows => tests.Value;

    ImmutableArray<QueryPointRow> PointRows => points.Value;

    ImmutableArray<AnalysisNote> DiagnosticRows => notes.Value;

    string Summary => summary.Value;
}
