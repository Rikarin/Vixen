<!--
    SPDX-FileCopyrightText: Copyright (c) Rikarin
    SPDX-License-Identifier: Apache-2.0

    Doc 36 § F7 wave 7. A material's panel: a preview request, a shape picker, the header the
    inspector draws, the link to the graph it came from, and the parameters it sets. The ledger
    sized it M in the seven-panel block with "port the readouts, keep the field rows"; the readouts
    are ported and the parameter list is not, for a reason the ledger already has a name for.

    ⚠ **The parameter list is the sixth shape and it is not this wave's to unblock.** Every entry in
    it is `expander.Content.Add<InspectorView>()` followed by `rows.Inspect(parameter)` — a control
    fed by a **method**, inside a `@for`. Shape 1's escape is "keep the control behind a `ref`",
    which works when the control is fed by properties and does not work here; the sanctioned escape
    for a method-fed control is the mixer's four-line wrapper subclass, and `InspectorView` is
    `sealed`. That is exactly what stopped `NodeInspector` and `AddComponentMenu` in wave 6, and
    another agent is on it. So `material-parameters` is a `ref`'d host element and `Rebuild()` fills
    it, which is the pattern `SettingsView`'s pane established: an element owned by no region, so a
    clear-and-refill is safe.

    ⚠ **`HeaderView` is the same control and needs no subclass, because it is not in a loop.** One
    `InspectorView`, one `Inspect(material.Header)` call from `Show`, one `ref`. The distinction
    worth keeping is that `sealed` blocks the *wrapper*, not the `ref` — a single control fed by a
    method is ordinary shape 1 and always was.

    ⚠ **`Restate` is gone rather than moved, and the three things it wrote are one snapshot record.**
    A material naming a graph offers "Open shader graph"; one naming a graph the project no longer
    has says so instead of offering a button that opens nothing. That was a class, a `Disabled` flag
    and a label, written together from one method that six paths had to remember to call. All three
    read `material.Header.Graph` and the asset database — a plain mutable object and a service, and
    no signal watches either — so they are one `MaterialGraphLink` in one signal for
    `TextureImportView`'s reason: written as three signals they would each depend on the document
    and none of them on the edit that moved the graph.

    ⚠ **The alert keeps its last words when it is hidden**, which is why the message is a signal and
    not a projection. On a material that reads, `Show` adds `hidden` and writes no message at all, so
    a whole-tree dump shows `.hidden` over whatever reason was last given. Two signals, written by
    exactly the paths that used to write the two properties.

    ⚠ **`Shapes` keeps a `ref`, its options and its subscription in `OnComposed`, and the ordering is
    the reason — this is a markup limitation and not a preference.** The C# runs
    `AddOption`ements, then `Value = "Sphere"`, and *then* `SelectionChanged += …`, so the initial
    value is set while nothing is listening. `change:Value` is `bind:`'s write-back leg over
    `PropertyChanged`, which is wired when the region is built — there is no way to say "assign
    without notifying" and no way to order a `change:` handler after an `OnComposed` assignment. So
    a `change:Value` here would fire once at compose time and raise a `PreviewChanged` the
    hand-written panel does not raise, which is a real extra render for whoever has subscribed by
    then. Written up in the wave notes; the shape of the fix is either an `on:`-style modifier
    meaning "not for the first value" or an `AddOption` markup can name, which is build-list item 4.

    ⚠ **The click walk-up stays whole, and splitting it would have been worse.** `Chosen` walks up
    from the event's source and recognises three things: the Add button, the Open-graph button and
    whichever Remove button belongs to a parameter. The first two could be `on:click.stop`; the
    third cannot, because those buttons are built by `Rebuild()` in C# and keyed by a dictionary. One
    gesture served by two mechanisms is harder to reason about than one walk-up, and the walk-up is
    what the `removals` dictionary is for either way. When the parameter list can be markup, all
    three go at once.
-->
@component MaterialView
@namespace Vixen.Editor.AssetEditors.Materials
@inherits Vixen.Ui.Controls.Control
@tag material-editor
@using Vixen.Core
@using Vixen.Core.Mathematics
@using Vixen.Editor.Inspector
@using Vixen.Editor.ShaderGraph
@using Vixen.Rendering.Materials
@using Vixen.Ui
@using Vixen.Ui.Controls
@using Vixen.Ui.Reactive

<Alert ref="@Broken" class="@BrokenClass" Title="This material did not read" Message="@BrokenMessage" />

<Image ref="@Preview" Description="The material on a preview shape" />

<Select ref="@Shapes" />

<InspectorView ref="@HeaderView" />

<Button ref="@OpenGraph" class="@Link.Class" Label="@Link.Label" Disabled="@Link.Missing" />

<Alert ref="@GraphBroken" class="@GraphTroubleClass" Title="This material's shader graph"
       Message="@GraphTroubleMessage" />

<material-graph-properties ref="@GraphProperties" />

<material-parameters ref="@Parameters" />

<material-bar>
    <Select ref="@NewKind" />
    <TextBox ref="@NewName" Placeholder="Parameter name" />
    <Button ref="@AddParameter" Label="Add" />
</material-bar>

@code {
    readonly Dictionary<UiElement, IMaterialParameter> removals = [];

    /// <summary>Whether the alert is shown, as the class the sheet reads.</summary>
    readonly Signal<string> brokenClass = new("hidden");

    /// <summary>And what it says, which outlives being hidden.</summary>
    readonly Signal<string> brokenMessage = new(string.Empty);

    /// <summary>What the graph button is, all three facts at once.</summary>
    readonly Signal<MaterialGraphLink> link = new(new("hidden", false, "Open shader graph"));

    /// <summary>Whether the graph alert is shown, as the class the sheet reads.</summary>
    readonly Signal<string> graphTroubleClass = new("hidden");

    /// <summary>And what it says, which outlives being hidden — `Broken`'s reason, one alert over.</summary>
    readonly Signal<string> graphTroubleMessage = new(string.Empty);

    /// <summary>Every graph-property field, with what it shows, so a reload can re-read them.</summary>
    /// <remarks>
    ///     ⚠ <b>A field that answered from itself would write an undone value back on the next
    ///     nudge.</b> An undo replaces the whole <c>GraphSurfaceFeature</c> — the panel is not told
    ///     which lanes moved — so the rows have to be re-read from the document rather than trusted,
    ///     which is <c>LayerStackView</c>'s <c>bindings</c> list in the smallest form that works here.
    /// </remarks>
    readonly List<(NumericInput Field, ShaderGraphProperty Property, int Lane)> graphFields = [];

    MaterialDocument? document;

    /// <summary>Which graph the property rows were last built for.</summary>
    /// <remarks>
    ///     ⚠ <b>So that adding a parameter does not recompile the shader graph.</b>
    ///     <see cref="Restate" /> runs from <see cref="Rebuild" />, which runs on every parameter add
    ///     and remove; re-reading the linked graph off disk and compiling it there would put a file
    ///     read and a whole graph compilation behind a button that changes a different list.
    /// </remarks>
    /// <remarks>
    ///     ⚠ <b>Nullable, and the null is not tidiness.</b> <see cref="Show" /> has to say "nothing
    ///     is built" so the next <see cref="Restate" /> reads the graph for the document it was just
    ///     handed — and it said it by writing <c>default</c>, which is
    ///     <see cref="AssetId.Empty" />, which is also what a material with <em>no</em> graph carries.
    ///     So showing an unlinked material compared empty with empty, took the equal branch, and left
    ///     whatever rows the previous document had put there.
    /// </remarks>
    AssetId? built;

    /// <inheritdoc />
    protected override bool AcceptsFocus => false;

    /// <summary>Where the preview is drawn once something has rendered it.</summary>
    public Image Preview { get; private set; } = null!;

    /// <summary>Which shape the preview asks for.</summary>
    public MaterialPreviewShape Shape { get; private set; } = MaterialPreviewShape.Sphere;

    /// <summary>The shape picker.</summary>
    public Select Shapes { get; private set; } = null!;

    /// <summary>The shader, the shading model and the graph link.</summary>
    /// <remarks>
    ///     ⚠ <b>A <c>ref</c>, which is ordinary shape 1 and not the <c>sealed</c> blocker.</b> One
    ///     control fed by one <c>Inspect</c> call from <see cref="Show" /> needs no wrapper type at
    ///     all; what <c>sealed</c> stops is the wrapper the <i>parameter list</i> would need, because
    ///     there the same call has to happen once per row inside a <c>@for</c>.
    /// </remarks>
    public InspectorView HeaderView { get; private set; } = null!;

    /// <summary>The button that opens the graph this material came from.</summary>
    public Button OpenGraph { get; private set; } = null!;

    /// <summary>What the material sets, one expander a parameter.</summary>
    /// <remarks>
    ///     ⚠ <b>A host element that <see cref="Rebuild" /> fills, and the ledger's sixth shape is
    ///     why.</b> Each row is an <c>InspectorView</c> fed by <c>Inspect(parameter)</c> — a method,
    ///     inside a loop — and <c>InspectorView</c> is <c>sealed</c>, so there is no four-line
    ///     wrapper to give the call a property to hang off. An element owned by no region is safe to
    ///     clear and refill, which is what <c>SettingsView</c>'s pane established.
    /// </remarks>
    public UiElement Parameters { get; private set; } = null!;

    /// <summary>Says why the linked graph offers no properties, when it offers none.</summary>
    public Alert GraphBroken { get; private set; } = null!;

    /// <summary>One row per property the linked graph asks a material to fill in.</summary>
    /// <remarks>
    ///     <para>
    ///         ⚠ <b>A host element rather than a <c>@for</c>, and for the parameter list's reason
    ///         rather than a new one</b> — a row is built by a method, in a loop, and it is cleared
    ///         and refilled by <see cref="RebuildGraph" />. It is owned by no region, so that is safe.
    ///     </para>
    ///     <para>
    ///         ⚠ <b>Only the properties a person fills in.</b> <c>ShaderGraphMaterial.Values</c> is
    ///         narrower than the graph's declared list on purpose: a texture's <c>uint</c> slot index
    ///         is written from the bindless table every frame, so a field for it would be a number an
    ///         author types and the next frame overwrites.
    ///     </para>
    /// </remarks>
    public UiElement GraphProperties { get; private set; } = null!;

    /// <summary>Which kind of parameter the add button will add.</summary>
    public Select NewKind { get; private set; } = null!;

    /// <summary>What the new parameter will be called.</summary>
    public TextBox NewName { get; private set; } = null!;

    /// <summary>The button that adds it.</summary>
    public Button AddParameter { get; private set; } = null!;

    /// <summary>Shown when the file did not read.</summary>
    public Alert Broken { get; private set; } = null!;

    /// <summary>Raised when the preview's subject changes — a different shape, or an edited value.</summary>
    /// <remarks>
    ///     <para>
    ///         ⚠ <b>Nothing subscribes it, so the preview image is blank for the whole session
    ///         however the material is edited</b>
    ///         (<a href="https://github.com/Rikarin/Vixen/issues/1204">#1204</a>). The only
    ///         <c>+=</c> anywhere in the tree is <c>MaterialGraphPropertyTests</c>'. Every repaint
    ///         decision in this panel — the shape picker, the parameter rows, <see cref="Rebuild" />,
    ///         the header — is correct bookkeeping for a consumer that does not exist yet: drawing a
    ///         lit sphere needs a device, a compositor and a compiled effect, and the assembly that
    ///         has all three has no arm for this event. <c>EditorApplication.Joined</c> is where it
    ///         will go, beside <c>TexturePreviewImages.Follow</c> and the
    ///         <see cref="OpenGraphRequested" /> subscription that is already there. ⚠ Whoever
    ///         writes it should know the oracle question is a pixel: a preview that is merely blank
    ///         is what a material with nothing on it looks like, so "the image has a number" is
    ///         satisfied by any placeholder.
    ///     </para>
    ///     <para>
    ///         ⚠ <b>An edited <em>header</em> is one of them, and it was not</b> —
    ///         <a href="https://github.com/Rikarin/Vixen/issues/1180">#1180</a>. What a material is
    ///         drawn with is the whole of the header, so editing <c>Shader</c>, <c>Shading</c> or
    ///         <c>Graph</c> changes the picture — silently in the direction that looks fine, because
    ///         a preview that is merely stale is indistinguishable from one that is right.
    ///     </para>
    /// </remarks>
    public event Action<MaterialView>? PreviewChanged;

    /// <summary>Raised when the author asks for the shader graph this material was authored in.</summary>
    public event Action<MaterialView, AssetId>? OpenGraphRequested;

    partial void OnComposed() {
        Shapes.AddOption(nameof(MaterialPreviewShape.Sphere), "Sphere");
        Shapes.AddOption(nameof(MaterialPreviewShape.Plane), "Plane");
        Shapes.AddOption(nameof(MaterialPreviewShape.Cube), "Cube");
        Shapes.Value = nameof(MaterialPreviewShape.Sphere);

        // ⚠ Subscribed *after* the value is set, which is the hand-written order and is the whole
        // reason this is not `change:Value`. See the header.
        Shapes.SelectionChanged += (_, value) => {
            Shape = Enum.TryParse<MaterialPreviewShape>(value, out var shape) ? shape : MaterialPreviewShape.Sphere;
            PreviewChanged?.Invoke(this);
        };

        HeaderView.Search.SetStyle("display", "none");

        // ⚠ **The raise is here rather than in `Restate`**, which is the ordering hazard #1180 names.
        // `Restate` is also reached from `Rebuild`, and `Rebuild` raises `PreviewChanged` itself two
        // lines later — so a raise inside `Restate` would render twice for every parameter add and
        // once more when the panel opens. `HeaderView.ValueChanged` is the one path that changes what
        // the preview draws and had nothing telling anyone: `Shader`, `Shading` and `Graph` are all
        // three of what a material is drawn *with*, and since #1133 the graph row composes the
        // surface on the same edit, so the picture beside the panel was the old one until an
        // unrelated gesture happened to call `Rebuild`.
        HeaderView.ValueChanged += (_, _) => {
            Restate();
            PreviewChanged?.Invoke(this);
        };

        NewKind.AddOption("Scalar");
        NewKind.AddOption("Colour");
        NewKind.AddOption("Vector");
        NewKind.AddOption("Texture");
        NewKind.AddOption("Flag");
        NewKind.Value = "Scalar";

        AddHandler<ClickEvent>(static (element, args) => ((MaterialView) element).Chosen(args));
    }

    /// <summary>Shows a material.</summary>
    /// <param name="material">The document.</param>
    public void Show(MaterialDocument material) {
        ArgumentNullException.ThrowIfNull(material);

        if (document is { } previous) {
            previous.ParametersChanged -= Reload;
        }

        document = material;
        material.ParametersChanged += Reload;

        if (material.LoadError is { } error) {
            brokenClass.Value = string.Empty;
            brokenMessage.Value = error;
        } else {
            brokenClass.Value = "hidden";
        }

        HeaderView.EditedDocument = material;
        HeaderView.Inspect(material.Header);

        built = null;

        Rebuild();
    }

    /// <summary>Rebuilds the parameter list from the material as it stands.</summary>
    public void Rebuild() {
        while (Parameters.Children.Count > 0) {
            Parameters.Children[^1].Remove();
        }

        removals.Clear();

        if (document is not { } material) {
            return;
        }

        foreach (var parameter in material.Material.Parameters) {
            var expander = Parameters.Add<Expander>();

            // Labelled by the kind and the name, because the name alone does not say whether
            // `tint` is a colour or four numbers — which is the question an author asks when a
            // shader is not getting what they think they set.
            expander.Label = $"{Alias(parameter)}  {parameter.Name}";
            expander.IsExpanded = true;

            var rows = expander.Content.Add<InspectorView>();
            rows.Search.SetStyle("display", "none");
            rows.EditedDocument = material;
            rows.Inspect(parameter);
            rows.ValueChanged += (_, _) => PreviewChanged?.Invoke(this);

            var remove = expander.Content.Add<Button>();
            remove.Label = "Remove";
            remove.Variant = ControlVariant.Subtle;

            removals[remove] = parameter;
        }

        Restate();
        PreviewChanged?.Invoke(this);
    }

    /// <summary>Reads every editor back from the material, without rebuilding anything.</summary>
    public void Reload() {
        HeaderView.Reload();

        if (document is { } material) {
            foreach (var (field, property, lane) in graphFields) {
                field.Number = Lane(material, property, lane);
            }
        }

        // ⚠ Through the expander's *content*, not its children. An `Expander` is a header and a
        // content element, and the rows are inside the second — a walk over its immediate children
        // finds the header and reloads nothing.
        foreach (var expander in Parameters.Children) {
            if (expander is not Expander section) {
                continue;
            }

            foreach (var child in section.Content.Children) {
                if (child is InspectorView rows) {
                    rows.Reload();
                }
            }
        }
    }

    void Reload(MaterialDocument changed) => Rebuild();

    /// <summary>Works out what the graph button is, which is one fact in three parts.</summary>
    void Restate() {
        if (document is not { } material) {
            return;
        }

        var graph = material.Header.Graph;

        // ⚠ Before the early return and not after it, which is where this call first went. Clearing
        // the Graph row is one click on the asset field, and it reaches here with an empty guid — so
        // a rebuild that ran only on the *linked* branch left the previous graph's rows on screen,
        // still bound, still writing a `GraphSurfaceFeature` naming a shader the material no longer
        // links. The link and the rows are one fact and both branches have to say it.
        RebuildGraph(material);

        if (graph.IsEmpty) {
            link.Value = new("hidden", false, "Open shader graph");
            return;
        }

        // ⚠ Resolved against the database rather than assumed to exist. A material outlives the
        // graph it was generated from often enough — a graph deleted, a branch without it — and a
        // button that opened nothing is worse than one that says why it cannot.
        var known = material.Project.Assets.TryGetByGuid(graph, out _);

        link.Value = new(
            string.Empty,
            !known,
            known ? "Open shader graph" : "Shader graph is missing from this project"
        );
    }

    /// <summary>Rebuilds the graph-property rows, and only when the link has actually moved.</summary>
    /// <param name="material">The document.</param>
    /// <remarks>
    ///     <para>
    ///         ⚠ <b>This is the surface <a href="https://github.com/Rikarin/Vixen/issues/494">#494</a>
    ///         says nothing consumed.</b> A <c>.vxmat</c> could name a graph as its surface and the
    ///         graph could report what it needs from outside, and the only way to give a graph
    ///         material its values was to hand-edit the YAML —
    ///         <c>ShaderGraphMaterial.Values</c> had no production caller at all, in <c>.cs</c> or in
    ///         <c>.vxml</c>. This is that caller.
    ///     </para>
    ///     <para>
    ///         ⚠ <b>The width rule is <c>LayerStackView</c>'s, and its refusal and its splat are
    ///         deliberately absent — because they are unreachable here rather than because they were
    ///         not considered.</b> That panel takes a width from <c>PortKinds.Fields</c> and must then
    ///         refuse a port whose declared default lists some other number of lanes, and splat a
    ///         one-number default across the rest. Here <c>Values</c> has already narrowed the list to
    ///         <c>float</c> and <c>float4</c>, so a width is one or four and nothing else can arrive;
    ///         and a stored value is a <c>Vector4</c>, which is four lanes by its type. There is no
    ///         third width to refuse and no short default to splat.
    ///     </para>
    ///     <para>
    ///         ⚠ <b>What does carry over is that panel's other decision: an untouched property is not
    ///         written.</b> A <c>ShaderGraphProperty</c> has a name and a type and <em>no default</em>
    ///         — the graph's own default lives in the generated shader — so a row for a property the
    ///         material has never set shows nought because that is what a shader parameter reads as
    ///         when nothing sets it, and <c>MaterialDocument.SetGraphValue</c> writes an entry only
    ///         for the property that moved. Writing every row out on open would replace each graph
    ///         default with black, which is this renderer's standing zero-means-off trap.
    ///     </para>
    /// </remarks>
    void RebuildGraph(MaterialDocument material) {
        if (material.Header.Graph == built) {
            return;
        }

        // ⚠ **`built is not null` is what tells an author's edit from a panel opening**, and that
        // distinction is the whole of #1133. A link that has *moved* composes the graph as the
        // material's surface — before this, linking a graph wrote the link and no feature, so the
        // graph did nothing to the picture until a value was nudged. A link that was merely *read*
        // when this panel opened composes nothing, because writing a feature there would dirty every
        // material an author clicked through the browser.
        var moved = built is not null;

        built = material.Header.Graph;

        material.ReadGraph();

        if (moved) {
            material.LinkGraph();
        }

        while (GraphProperties.Children.Count > 0) {
            GraphProperties.Children[^1].Remove();
        }

        graphFields.Clear();

        if (material.GraphProblem is { } problem) {
            graphTroubleClass.Value = string.Empty;
            graphTroubleMessage.Value = problem;
        } else {
            graphTroubleClass.Value = "hidden";
        }

        if (material.GraphSource is not { } source) {
            return;
        }

        foreach (var property in ShaderGraphMaterial.Values(source)) {
            GraphRow(material, property);
        }
    }

    /// <summary>One property's row: its name, and as many number fields as its type has lanes.</summary>
    /// <param name="material">The document the edit lands on.</param>
    /// <param name="property">The property, as the compiled graph declares it.</param>
    /// <remarks>
    ///     ⚠ <b>Every field reads the material back rather than trusting what it holds.</b> An undo
    ///     replaces the whole feature, and a lane that answered from its own control would then write
    ///     the value the undo removed back into the file on the next nudge.
    /// </remarks>
    void GraphRow(MaterialDocument material, ShaderGraphProperty property) {
        var name = property.Name;
        var lanes = string.Equals(property.Type, "float4", StringComparison.Ordinal) ? 4 : 1;
        var row = GraphProperties.Add("material-graph-row");

        row.Add("material-graph-label").Text = name;

        for (var index = 0; index < lanes; index++) {
            var lane = index;
            var field = row.Add<NumericInput>(null, null, "material-graph-value");

            // `LayerStackView`'s three and a hundredth, for its reasons: a `Decimals = 0` field
            // writes "0" for 0.25 and reads it back on the next submit, and `Step` is also the floor
            // of the scrub rate.
            field.Decimals = 3;
            field.Step = 0.01d;

            // Assigned before the subscription below, which is `Shapes`' ordering one control over.
            //
            // ⚠ **And it is *not* what stops the panel writing every property out at nought when it
            // opens — the equality guard below is, measured.** Reversing these two lines leaves every
            // case in `MaterialGraphPropertyTests` green, because a `[UiProperty]` raises `Changed`
            // only on an actual change and an unset property's opening value is already the field's
            // own default. What the ordering does buy is the case that is not nought: a row opening
            // at a value the material already holds would raise one edit per field on compose. The
            // guard catches that too. Both are kept, and this comment says which is load-bearing
            // rather than crediting the one that reads as though it must be.
            field.Number = Lane(material, property, lane);

            field.NumberChanged += (typed, value) => {
                // Gated on the field's own verdict: this control holds and reports a number rather
                // than clamping it, so an unfinished "-" is not an edit.
                if (!typed.IsValid) {
                    return;
                }

                var held = Held(material, property);

                // ⚠ **A lane already at that number writes nothing, and this is the guard that
                // actually holds** — `ReloadingAfterAnEditPushesNothing` is red without it.
                // `Reload` assigns `Number` with this handler attached, so an unguarded write pushes
                // an undo entry every time the panel re-reads the document, and one of those
                // re-reads is the one an undo itself causes.
                if (held[lane] == (float) value) {
                    return;
                }

                held[lane] = (float) value;
                material.SetGraphValue(name, new(held[0], held[1], held[2], held[3]));
            };

            field.AddHandler<PointerEvent>(
                (_, args) => {
                    if (args.Action == PointerAction.Released) {
                        material.Stack.Seal();
                    }
                },
                RoutingStrategy.Bubble,
                handledEventsToo: true
            );

            field.Submitted += _ => material.Stack.Seal();
            graphFields.Add((field, property, lane));
        }
    }

    /// <summary>What the material sets this property to today, as four lanes.</summary>
    /// <param name="material">The document.</param>
    /// <param name="property">The property.</param>
    /// <returns>Four numbers, of which a <c>float</c> property uses the first.</returns>
    /// <remarks>
    ///     ⚠ <b>Zero for a property nothing sets, and that is the honest answer rather than a
    ///     guess.</b> A <c>ShaderGraphProperty</c> carries no default — the graph's own lives in the
    ///     generated shader, which this panel does not read — so a row cannot show the number the
    ///     frame would use. What it must not do is write that nought back, which is why nothing here
    ///     touches the file until a field is moved.
    /// </remarks>
    static float[] Held(MaterialDocument material, ShaderGraphProperty property) {
        float[] held = [0f, 0f, 0f, 0f];

        if (material.Surface is not { } surface) {
            return held;
        }

        if (string.Equals(property.Type, "float", StringComparison.Ordinal)) {
            foreach (var number in surface.Numbers) {
                if (string.Equals(number.Name, property.Name, StringComparison.Ordinal)) {
                    held[0] = number.Value;
                }
            }

            return held;
        }

        foreach (var vector in surface.Vectors) {
            if (string.Equals(vector.Name, property.Name, StringComparison.Ordinal)) {
                held = [vector.Value.X, vector.Value.Y, vector.Value.Z, vector.Value.W];
            }
        }

        return held;
    }

    /// <summary>One lane of what the material sets this property to.</summary>
    /// <param name="material">The document.</param>
    /// <param name="property">The property.</param>
    /// <param name="lane">Which lane.</param>
    /// <returns>The number the field opens at.</returns>
    static double Lane(MaterialDocument material, ShaderGraphProperty property, int lane) =>
        Held(material, property)[lane];

    void Chosen(ClickEvent args) {
        if (document is not { } material) {
            return;
        }

        for (var element = args.Source; element is not null; element = element.Parent) {
            if (ReferenceEquals(element, AddParameter)) {
                Add(material);
                args.Handled = true;

                return;
            }

            if (ReferenceEquals(element, OpenGraph)) {
                OpenGraphRequested?.Invoke(this, material.Header.Graph);
                args.Handled = true;

                return;
            }

            if (removals.TryGetValue(element, out var parameter)) {
                material.Remove(parameter);
                args.Handled = true;

                return;
            }
        }
    }

    void Add(MaterialDocument material) {
        var name = (NewName.Value ?? string.Empty).Trim();

        if (name.Length == 0 || material.Material.Find(name) is not null) {
            return;
        }

        material.Add(Create(NewKind.Value, name));
        NewName.Value = string.Empty;
    }

    /// <summary>A fresh parameter of a named kind.</summary>
    /// <param name="kind">The kind, as the picker spells it.</param>
    /// <param name="name">What to call it.</param>
    /// <returns>The parameter.</returns>
    internal static IMaterialParameter Create(string? kind, string name) => kind switch {
        "Colour" => new ColourParameter { Name = name },
        "Vector" => new VectorParameter { Name = name },
        "Texture" => new TextureParameter { Name = name },
        "Flag" => new FlagParameter { Name = name },
        _ => new ScalarParameter { Name = name }
    };

    /// <summary>What a parameter's kind is called, which is its contract name and its YAML tag.</summary>
    /// <param name="parameter">The parameter.</param>
    /// <returns>The name.</returns>
    internal static string Alias(IMaterialParameter parameter) => parameter switch {
        ColourParameter => "Colour",
        VectorParameter => "Vector",
        TextureParameter => "Texture",
        FlagParameter => "Flag",
        _ => "Scalar"
    };

    // ================================================================== What the markup reads

    string BrokenClass => brokenClass.Value;

    string BrokenMessage => brokenMessage.Value;

    string GraphTroubleClass => graphTroubleClass.Value;

    string GraphTroubleMessage => graphTroubleMessage.Value;

    MaterialGraphLink Link => link.Value;
}
