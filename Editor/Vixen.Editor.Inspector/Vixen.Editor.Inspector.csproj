<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.Inspector</RootNamespace>
        <Description>
            The editor's property drawers: attribute-driven descriptors emitted by a generator,
            drawers registered per type or per attribute, multi-object editing with mixed-value
            indication, and every edit recorded as an undoable command on the document's stack.
        </Description>
        <PackageTags>editor;inspector;property-drawer;undo;multi-object;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The document model an edit is recorded against. Unlike Vixen.Editor.Ui, which is chrome
            and deliberately knows nothing about projects, an inspector's entire job is to produce
            IEditorCommands — "every edit produces a command" is only true by construction if the
            thing building the editors is the thing that knows about the stack.
        -->
        <ProjectReference Include="..\Vixen.Editor.Core\Vixen.Editor.Core.csproj" />

        <!--
            The other generator's descriptors, which is how a component gets rows without the runtime
            referencing an editor assembly. Every [DataContract] type already carries a full member
            description with boxed accessors, categories and ranges — generated for serialization,
            and the same information the inspector needs under a different name. See
            ReflectedDescriptor for why an [Inspector] descriptor still wins where there is one.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection\Vixen.Core.Reflection.csproj" />

        <!--
            ColorPicker and CurveEditor are two of the three controls doc 09 built the advanced set
            for, and this is the consumer they were built for. Vixen.Ui.Controls arrives with it.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Controls.Advanced\Vixen.Ui.Controls.Advanced.csproj" />

        <!--
            ⚠ The reload host, for the markup inspectors. Doc 36 § P4: a declarative layout you have
            to restart the editor to see is a slower way to write C#, so `MarkupInspector` mounts
            through the host and re-binds what a reload rebuilt. It is a leaf assembly over
            `Vixen.Ui` and brings nothing else with it.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.HotReload\Vixen.Ui.HotReload.csproj" />

        <!--
            The descriptors are generated, not reflected: doc 11 § Vixen.Editor.Inspector. Analyzers
            do not flow transitively through a ProjectReference, so an assembly declaring
            [Inspector] members of its own has to name this itself — the same wiring
            Vixen.Core.Reflection.Generator needs.
        -->
        <ProjectReference Include="..\Vixen.Editor.Inspector.Generator\Vixen.Editor.Inspector.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Editor.Inspector.Tests" />
    </ItemGroup>

    <!--
        ⚠ **Imported for the `**/*.vcss` glob, which is what embeds the *two* sheets this project
        declares** — `InspectorTheme.vcss` and `BrowserTheme.vcss`. Both accessors read their file
        back by logical name, so without this line they throw at the first `Install` rather than
        failing to compile; the error message names this import for that reason.

        At the bottom of the file, because the glob has to run after DefaultItemExcludes is final.
        There is no `.vxml` in this project, so the other half of the .targets is inert here.
    -->
    <Import Project="..\..\Core\Vixen.Ui\build\Vixen.Ui.targets" />

    <!--
        ⚠ **The editor's tokens, not a copy of them.** This assembly's panels are the editor's
        chrome, so they are styled by the editor's design; before this line the utility half of that
        design stopped at `Vixen.Editor.Ui`'s assembly boundary and every class name here had to be
        said again as a tag rule. Exit criterion 6 of doc 43 is that a utility class written in any
        editor assembly resolves. See docs/plan/43 Part 3.
    -->
    <Import Project="..\Vixen.Editor.Ui\build\Vixen.Editor.Ui.Styling.targets" />

</Project>
