@component TaskCenter
@namespace Vixen.Editor.Ui
@tag task-center
@using Vixen.Ui
@using Vixen.Ui.Controls
@using Vixen.Ui.Reactive

<task-heading>@EditorStrings.TasksTitle.Text</task-heading>

@for (var task in Running) {
    <task-row key="@task">
        <task-line>
            <!--
                ⚠ The two utilities that make a long title stop pushing the cancel button off the
                row, and the pair is the classic one: a flex item's `min-width` is `auto`, so
                `overflow: hidden` on its own cannot shrink it below its content and `truncate`
                does nothing. `EditorTheme` sets neither property on `task-title`, which is why
                these take effect at all — a utility is in `@layer utilities` and loses to any
                unlayered rule that names the same property.
            -->
            <task-title class="truncate min-w-0">@task.Title</task-title>

            <IconButton LeadingIcon.Geometry="@ControlIcons.Close"
                        Variant="Subtle"
                        Size="Small"
                        Label="@EditorStrings.TasksCancel.Text"
                        Disabled="@task.IsCancellationRequested"
                        on:click.stop="@(() => Cancel(task))" />
        </task-line>

        <ProgressBar Value="@task.Progress" IsIndeterminate="@task.IsIndeterminate" />
        <task-status>@(task.Status ?? string.Empty)</task-status>
    </task-row>
}

@if (Running.Count == 0) {
    @EditorStrings.TasksIdle.Text
}

@code {
    /// <summary>Which manager it is showing, or null before it has been given one.</summary>
    /// <remarks>
    ///     ⚠ <b>A signal for the *manager*, and nothing else here needs one.</b>
    ///     <c>BackgroundTaskManager.Tasks</c> is a <c>CollectionSignal</c> and every property of a
    ///     <c>BackgroundTask</c> is signal-backed, so the list below and every number in it follow
    ///     the model on their own. What no signal covers is being pointed at a different manager,
    ///     which is one assignment and this is it.
    /// </remarks>
    readonly Signal<BackgroundTaskManager?> manager = new(null);

    /// <summary>What is running, oldest first.</summary>
    IReadOnlyList<BackgroundTask> Running => manager.Value?.Tasks ?? [];

    /// <summary>Shows a manager's tasks.</summary>
    /// <param name="tasks">The manager.</param>
    /// <remarks>
    ///     ⚠ <b>No subscription, and nothing to unsubscribe.</b> This used to hang a handler on
    ///     <c>BackgroundTaskManager.Changed</c> and bump a revision signal that every binding read
    ///     through a <c>Live(…)</c> helper — the adaptation a view needs when its model is a plain
    ///     object that raises events. The model holds signals now, so the adaptation is gone and so
    ///     is the handler that would have outlived the panel.
    /// </remarks>
    public void Show(BackgroundTaskManager tasks) {
        ArgumentNullException.ThrowIfNull(tasks);
        manager.Value = tasks;
    }

    /// <remarks>
    ///     Cancelling raises no event and does not need to: <c>IsCancellationRequested</c> is a
    ///     signal, so the button goes quiet on the next flush — which is what tells the user the
    ///     request landed on work that has not noticed yet.
    /// </remarks>
    static void Cancel(BackgroundTask task) => task.Cancel();
}
