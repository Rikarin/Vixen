@component TaskCenter
@namespace Vixen.Editor.Ui
@using Vixen.Ui.Controls
@using Vixen.Ui.Reactive

<task-heading>@EditorStrings.TasksTitle.Text</task-heading>

@for (var task in Running) {
    <task-row key="@task">
        <task-line>
            <task-title>@task.Title</task-title>

            <IconButton LeadingIcon.Geometry="@ControlIcons.Close"
                        Variant="@ControlVariant.Subtle"
                        Size="@ControlSize.Small"
                        Label="@EditorStrings.TasksCancel.Text"
                        Disabled="@Live(task.IsCancellationRequested)"
                        on:click.stop="@(() => Cancel(task))" />
        </task-line>

        <ProgressBar Value="@Live(task.Progress)" IsIndeterminate="@Live(task.IsIndeterminate)" />
        <task-status>@Live(task.Status ?? string.Empty)</task-status>
    </task-row>
}

@if (Running.Count == 0) {
    @EditorStrings.TasksIdle.Text
}

@code {
    /// <summary>What the numbers were last read at, bumped when they may have moved.</summary>
    /// <remarks>
    ///     ⚠ <b>A pulse, because <c>BackgroundTask</c> is not reactive.</b> Its progress is a plain
    ///     property that a worker thread writes through <c>Pump</c>, so no effect in this file would
    ///     ever be invalidated by it. One signal that every row binding reads — through
    ///     <see cref="Live{T}" /> — turns "the manager applied something" into "these bindings are
    ///     stale", which is the whole of the adaptation. Making the model itself hold signals is the
    ///     better answer and is a change to the model rather than to its view.
    /// </remarks>
    readonly Signal<int> revision = new(0);

    BackgroundTaskManager? manager;

    /// <inheritdoc />
    /// <remarks>
    ///     Written out because the default would be <c>taskcenter</c>, and the stylesheet — like
    ///     every compound tag in the editor — says <c>task-center</c>.
    /// </remarks>
    protected override string TagName => "task-center";

    /// <summary>What is running, oldest first.</summary>
    /// <remarks>Reads the pulse, so the list is rebuilt when a task starts or stops.</remarks>
    IReadOnlyList<BackgroundTask> Running {
        get {
            _ = revision.Value;
            return manager?.Tasks ?? [];
        }
    }

    /// <summary>Shows a manager's tasks.</summary>
    /// <param name="tasks">The manager.</param>
    /// <remarks>
    ///     ⚠ <b>No <c>Refresh</c> for the frame loop to call.</b> The old view was rebound every
    ///     tick whether or not anything had changed; this subscribes to the one event that means
    ///     something did, which is what <c>Pump</c> raises after it applies a batch.
    /// </remarks>
    public void Show(BackgroundTaskManager tasks) {
        ArgumentNullException.ThrowIfNull(tasks);

        if (manager is not null) {
            manager.Changed -= Moved;
        }

        manager = tasks;
        manager.Changed += Moved;

        revision.Value++;
    }

    /// <summary>Ties a binding to the pulse, so it re-runs when the numbers may have moved.</summary>
    /// <typeparam name="T">The value's type.</typeparam>
    /// <param name="value">Whatever was read off the task.</param>
    /// <returns>It, unchanged.</returns>
    T Live<T>(T value) {
        _ = revision.Value;
        return value;
    }

    void Moved(BackgroundTaskManager _) => revision.Value++;

    /// <remarks>
    ///     Bumps the pulse itself rather than waiting for the manager to: cancelling raises no
    ///     event, and the button going quiet is what tells the user the request landed on work that
    ///     has not noticed yet.
    /// </remarks>
    void Cancel(BackgroundTask task) {
        task.Cancel();
        revision.Value++;
    }
}
