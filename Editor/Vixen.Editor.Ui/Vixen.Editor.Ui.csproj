<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.Ui</RootNamespace>
        <Description>
            The editor's shell: a docking workspace with named layout presets, a command registry
            that menus, toolbars and the palette are all views over, remappable keybindings with
            conflict detection, light and dark theming from design tokens, notifications, a
            background-task manager with cancellation, and a string catalog everything user-visible
            goes through.
        </Description>
        <PackageTags>editor;shell;docking;commands;palette;theming;localisation;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The three controls that prove the framework, and the docking host is the one this
            assembly is mostly about: doc 11 calls docking "the single most-used feature in the
            application". What is here is the half above it — panels registered by id, named
            presets, and persistence — because DockingHost deliberately knows nothing about either.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Controls.Advanced\Vixen.Ui.Controls.Advanced.csproj" />

        <!--
            The Tailwind-shaped utilities, which is the other half of how a panel is styled: the
            hand-written half is `EditorTheme`, and everything a class name can say is this. The
            editor is the application doc 14 § 4b names as the reason the system exists — two hundred
            visual components in one repository, where "the accent is teal now" should be one line of
            one file rather than a sweep.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Styling.Utilities\Vixen.Ui.Styling.Utilities.csproj" />

        <!--
            Keybindings are (InputKey, ModifierKeys) pairs, which is Vixen.Input's vocabulary. It
            arrives transitively through Vixen.Ui as well; naming it says that a chord is an input
            concept rather than a UI one, and it is what a rebinding UI would capture through.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Input\Vixen.Input.csproj" />

        <!--
            Layouts, keymaps and string catalogs are YAML for the reason DockLayout gives: they are
            files a person diffs, checks in and occasionally repairs by hand.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Yaml\Vixen.Core.Yaml.csproj" />

        <!--
            The console is a view over `RingBufferSink`, which is on in every build and already holds
            the records. Doc 20 is explicit that the panel is "a virtualised view over a buffer that
            exists" — the alternative is a second log the editor keeps for itself, which is a second
            thing to keep in step with the one the crash reporter dumps.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Diagnostics\Vixen.Core.Diagnostics.csproj" />

        <!--
            Analyzers do not flow transitively through a ProjectReference, so an assembly declaring
            [UiProperty] controls of its own has to name the generator itself.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Generators\Vixen.Ui.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
            The VXML compiler, for the same reason and by the same route: a PackageReference to
            Vixen.Ui would bring it, and a ProjectReference does not. This is the first assembly in
            the repository whose interface is written in the markup language the UI framework is for.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Markup.Generators\Vixen.Ui.Markup.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
            ⚠ Deliberately *not* Vixen.Editor.Core. The shell is chrome: a command is an id and a
            delegate, a panel is an id and a factory, and nothing here knows what a project, a
            document or an undo stack is. That is what lets the whole assembly be tested against a
            bare UiDocument with no project on disk — the same bargain Vixen.Ui makes with
            Vixen.Platform — and it is Vixen.Editor.App's job to join the two.
        -->
    </ItemGroup>

    <ItemGroup>
        <!--
            ⚠ **The markup is embedded as well as compiled, and that is the utility system's build
            step standing in for itself.** `Vixen.Ui.Styling.Utilities`' README lists build-step
            integration as waiting on the asset pipeline: until it lands, something has to scan the
            source for class names so the generator knows which rules to emit. `EditorStyles` does it
            at startup, over these copies, with the same scanner a build step would use.

            The scan is deliberately over-inclusive — see `CandidateScanner` — so embedding the
            markup verbatim is exactly the input it wants.
        -->
        <EmbeddedResource Include="**/*.vxml" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
        <EmbeddedResource Include="Theming\*.yaml" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Editor.Ui.Tests" />
    </ItemGroup>

    <!--
        What a PackageReference to Vixen.Ui would have imported on its own: the **/*.vxml glob and
        the two properties the generator asks MSBuild for. At the bottom of the file rather than the
        top for the reason the .targets itself gives — the glob has to run after DefaultItemExcludes
        is final, or a .vxml copied into bin/ by a previous build is compiled a second time.
    -->
    <Import Project="..\..\Core\Vixen.Ui\build\Vixen.Ui.targets" />

</Project>
