<!--
    SPDX-FileCopyrightText: Copyright (c) Rikarin
    SPDX-License-Identifier: Apache-2.0

    Doc 36 § F7 wave 1b, and doc 20's A5.

    ⚠ **`@inherits`, and here it is not a preference.** `EditorShell` writes
    `panel.Add<KeyBindingsView>()`, keeps the result in `Shell.Keyboard`, and
    `EditorSettingsPanels.WireKeymapFiles` sets `view.Import.Disabled` on it. The panel also puts a
    handler on *itself*, which a `Component` has no element to do.

    ⚠ **That self-handler is `<self on:keydown.capture.handled>` since 2026-08-24, and this is one
    of the two panels in the tree that wants `.handled`.** The modifier is not a free upgrade — it
    makes a handler run on events something downstream has already dealt with — and the reason this
    panel needs it is the reason it is on the capture leg at all: `CommandDispatcher` is attached to
    the document, so recording Ctrl+S has to be seen *whether or not* the chord is already bound to
    "save scene". A picker that took `.handled` would fire on keystrokes another panel had claimed;
    `CommandPalette`, `NodeSearchPopup` and `AddComponentMenu` therefore did not get it.
    `InputActionsView` is the other one that did.

    ⚠ **And the `keyed` guard went with it, which is a fact about `<self />` rather than about this
    panel.** The guard existed because `AddHandler` has no removal paired to it and the doc said a
    hot reload re-enters `OnComposed`. `ctx.On` now registers the `RemoveHandler` against the region
    being built, so a second composition replaces the subscription instead of adding to it — see
    `EmitterTests.Self_does_not_subscribe_the_host_again_when_a_component_is_rebuilt`, which failed
    (three presses counted for two) before that was arranged. An `@inherits` class could not have
    reached the bug anyway: it composes in `OnCreated` and `UiElement.Remove` is terminal, so its
    body runs once per instance. The guard was defending against the `Component` flavour's case.

    ⚠ **`KeyMap` and `CommandRegistry` are left alone, and that is a finding rather than a
    shortcut.** The brief for this wave said each wave-1b model needed signal-backing; for these two
    it does not, and the reason is where their values are read. Every chord and every source on
    screen is read by a `DataGrid` column projection — `Func<object, object?>`, evaluated by
    `Grid.Refresh()` — and no markup attribute can bind a column. Nothing in this file's bindings
    reads the map at all: the strip and the status line are functions of *this panel's* state, which
    is the selection, the capture mode, the refused chord and the complaint about a preset. Those
    are the five signals below. Making `KeyMap.bindings` a signal would have changed no pixel and
    would have put `ReactiveGraph.AssertOwningThread` in front of every keymap load.

    ⚠ **And emphatically not a revision counter.** `KeyMap.Changed` already means "read the cells
    again", and `Grid.Refresh()` is what does that — a counter bumped so the markup re-evaluated
    would be a second, worse spelling of an event that already exists.

    ⚠ **The Record button's `Checked` bit stays imperative, deliberately.** `UiElement.State` is a
    flag set holding Hovered, Focused and Pressed as well, so a binding assigning it whole would
    clobber whatever the pointer had just put there. `Capture` is the one place the mode changes, so
    it is where the bit is set — one line, next to the signal it belongs with.

    ⚠ **`SearchBox` and `Select` are wired through `ref` rather than `on:`.** `input` and `change`
    are names the *binder* accepts and the *runtime* does not: `BuildContext.Subscriptions` holds the
    pointer gestures plus the `click`/`dblclick` that `Vixen.Ui.Controls` registers, so `on:change`
    binds and then throws when the element is built. `Select` also has to be filled with
    `AddOption`, which no attribute carries.
-->
@component KeyBindingsView
@namespace Vixen.Editor.Ui
@inherits Vixen.Ui.Controls.Control
@tag keybindings-view
@using System.Globalization
@using Vixen.Input
@using Vixen.Ui
@using Vixen.Ui.Controls
@using Vixen.Ui.Controls.Advanced
@using Vixen.Ui.Reactive
@using Vixen.Ui.Styling

<self on:keydown.capture.handled="@((KeyEvent e) => Keyed(e))" />

<keybindings-toolbar ref="@Toolbar">
    <SearchBox ref="@Search" Placeholder="@EditorStrings.KeysFilter.Text" />

    <!--
        ⚠ First on the strip on purpose. Doc 20's own note is that "presets matter more than they
        look" — a Unity user and an Unreal user disagree about most of the bar and both are certain
        — so the one control that turns a week of friction into a choice is in front of the grid it
        makes unnecessary.
    -->
    <Select ref="@Presets" Size="Small" />

    <Button ref="@Record"
            Size="Small"
            Variant="Subtle"
            Label="@(IsCapturing ? EditorStrings.KeysRecording.Text : EditorStrings.KeysRecord.Text)"
            Disabled="@(Selected is null)"
            on:click="@Toggle" />

    <Button Size="Small" Variant="Subtle" Label="@EditorStrings.KeysClear.Text" on:click="@Unbind" />
    <Button Size="Small" Variant="Subtle" Label="@EditorStrings.KeysResetRow.Text" on:click="@ResetRow" />
    <Button Size="Small" Variant="Subtle" Label="@EditorStrings.KeysResetAll.Text" on:click="@ResetAll" />

    <Button ref="@Import"
            Size="Small"
            Variant="Subtle"
            Label="@EditorStrings.KeysImport.Text"
            on:click="@AskToImport" />

    <Button ref="@Export"
            Size="Small"
            Variant="Subtle"
            Label="@EditorStrings.KeysExport.Text"
            on:click="@AskToExport" />
</keybindings-toolbar>

<DataGrid ref="@Grid" MultiSelect="false" />

<keybindings-status ref="@Status" class='@(Conflict is null ? "" : "conflict")'>@Sentence()</keybindings-status>

@code {
    readonly List<KeyBindingRow> rows = [];

    /// <summary>
    ///     The five things on this panel that change without anything else being told, and therefore
    ///     the five signals.
    /// </summary>
    /// <remarks>
    ///     ⚠ <b>Granular rather than one snapshot, which is the opposite of what
    ///     <c>PluginManagerView</c> wanted and for a reason worth keeping.</b> There the fields all
    ///     came out of one reading of a host; here they are five independent facts written from five
    ///     different places — a click on a row, a press of Record, a refused chord, the chord that
    ///     was refused, and a preset that does not exist. A record holding all five would have to be
    ///     rebuilt from the other four every time one of them moved.
    /// </remarks>
    readonly Signal<string?> selected = new(null);

    readonly Signal<bool> capturing = new(false);
    readonly Signal<string?> conflict = new(null);
    readonly Signal<KeyChord> pending = new(KeyChord.None);

    /// <summary>A preset that is not one, which is the one thing the strip can complain about.</summary>
    /// <remarks>
    ///     The C# wrote this straight into <c>Status.Text</c> and let the next <c>Restate</c> paint
    ///     over it. With the line bound, a write like that would be undone on the next flush — so the
    ///     complaint has to be part of the state the line is a function of, and every path that used
    ///     to run <c>Restate</c> clears it.
    /// </remarks>
    readonly Signal<string?> complaint = new(null);

    CommandRegistry? commands;
    KeyMap? keys;

    string? filter;

    /// <inheritdoc />
    protected override bool AcceptsFocus => true;

    /// <summary>The strip along the top.</summary>
    public UiElement Toolbar { get; private set; } = null!;

    /// <summary>The filter box.</summary>
    public SearchBox Search { get; private set; } = null!;

    /// <summary>Which keymap preset is in force.</summary>
    public Select Presets { get; private set; } = null!;

    /// <summary>The button that puts the panel into capture mode.</summary>
    public Button Record { get; private set; } = null!;

    /// <summary>The button that asks for a keymap file to be read in.</summary>
    /// <remarks>
    ///     Exposed so that a host with no file picker can disable it rather than leaving a button
    ///     that does nothing — which is doc 20's second bar, and the one a panel breaks the second
    ///     time it is used.
    /// </remarks>
    public Button Import { get; private set; } = null!;

    /// <inheritdoc cref="Import" />
    public Button Export { get; private set; } = null!;

    /// <summary>The grid.</summary>
    public DataGrid Grid { get; private set; } = null!;

    /// <summary>The line under it that reports a conflict, or says what capture is waiting for.</summary>
    public UiElement Status { get; private set; } = null!;

    /// <summary>Whether the next chord pressed is a binding rather than a shortcut.</summary>
    public bool IsCapturing => capturing.Value;

    /// <summary>Which command the grid has selected, or <see langword="null" />.</summary>
    public string? Selected => selected.Value;

    /// <summary>Which command holds the chord the user just tried to take, if the bind was refused.</summary>
    public string? Conflict => conflict.Value;

    /// <summary>The chord that was refused, so pressing it again can mean "take it".</summary>
    public KeyChord Pending => pending.Value;

    /// <summary>Raised when the user asks to read a keymap in from a file.</summary>
    public event Action<KeyBindingsView>? ImportRequested;

    /// <summary>Raised when they ask to write one out.</summary>
    public event Action<KeyBindingsView>? ExportRequested;

    /// <summary>Points the panel at a registry and the map that binds it.</summary>
    /// <param name="registry">Every command the editor knows.</param>
    /// <param name="map">What binds them.</param>
    public void Show(CommandRegistry registry, KeyMap map) {
        ArgumentNullException.ThrowIfNull(registry);
        ArgumentNullException.ThrowIfNull(map);

        Detach();

        commands = registry;
        keys = map;

        // ⚠ Both, because either can change what a row says. A plugin loading adds commands; a
        // preset chosen from this very panel changes two hundred chords at once, and a grid that
        // only listened to one of the two would be right about half of that.
        map.Changed += KeysChanged;
        registry.Changed += CommandsChanged;

        Presets.Value = map.PresetName;
        Rebuild();
    }

    /// <summary>Rebuilds the row list from the registry, honouring the filter.</summary>
    public void Rebuild() {
        rows.Clear();

        if (commands is { } registry) {
            foreach (var command in registry.Commands) {
                var category = command.Category.Id is null ? string.Empty : command.Category.Text;

                if (!Matches(command.Id, command.Title.Text, category)) {
                    continue;
                }

                rows.Add(new KeyBindingRow(command.Id, command.Title.Text, category));
            }
        }

        rows.Sort(static (left, right) => string.CompareOrdinal(left.Id, right.Id));

        var chosen = Selected;

        Grid.SetItems(rows);

        // `SetItems` clears the selection, and a rebuild triggered by the very rebind the user just
        // made would otherwise take the row out from under them.
        if (chosen is not null) {
            var index = rows.FindIndex(row => string.Equals(row.Id, chosen, StringComparison.Ordinal));

            if (index >= 0) {
                Grid.Select(index);
            }
        }

        // ⚠ Explicitly, because `SetItems` empties `DataGrid.selection` without raising
        // `SelectionChanged` — so a rebuild that found no row for the old id would leave this signal
        // holding an id the grid no longer has selected.
        Sync();
    }

    /// <summary>Reads every cell again without rebuilding the list.</summary>
    public void Refresh() {
        Presets.Value = keys?.PresetName ?? KeyMapPresets.Vixen;

        Grid.Refresh();
        Sync();
    }

    /// <summary>Turns capture mode on or off.</summary>
    /// <param name="on">Which.</param>
    public void Capture(bool on) {
        var wanted = on && Selected is not null;

        if (IsCapturing == wanted) {
            return;
        }

        capturing.Value = wanted;
        complaint.Value = null;

        // ⚠ The one appearance on this panel that is not a binding, and the type is why: `State` is
        // a flag set that also holds Hovered, Focused and Pressed, so an effect assigning it whole
        // would undo whatever the pointer had just put there.
        if (wanted) {
            Record.State |= ElementState.Checked;
            Document.Focus(this);
        } else {
            Record.State &= ~ElementState.Checked;
        }
    }

    /// <summary>Gives the selected command a chord.</summary>
    /// <param name="chord">The chord, or <see cref="KeyChord.None" /> to unbind it.</param>
    /// <param name="replace">Whether to take it off whatever has it.</param>
    /// <returns>What happened, or <see cref="BindResult.Unchanged" /> when no row is selected.</returns>
    /// <remarks>
    ///     ⚠ <b>A conflict is reported and <i>not</i> applied, and the second press is what replaces
    ///     it.</b> Silently taking a chord off another command is how somebody loses Ctrl+S without
    ///     ever being told; refusing outright would make the panel unable to express a swap at all.
    ///     Saying who has it and letting the same key be pressed again is what every editor that got
    ///     this right does.
    /// </remarks>
    public BindResult Rebind(KeyChord chord, bool replace = false) {
        if (keys is not { } map || Selected is not { } id) {
            return BindResult.Unchanged;
        }

        var result = map.Bind(id, chord, replace);

        conflict.Value = result == BindResult.Conflict ? map.CommandFor(chord, ContextOf(id)) : null;
        pending.Value = result == BindResult.Conflict ? chord : KeyChord.None;
        complaint.Value = null;

        return result;
    }

    void Toggle() => Capture(!IsCapturing);

    void Unbind() => Rebind(KeyChord.None, replace: true);

    void ResetRow() {
        if (keys is { } map && Selected is { } id) {
            map.ResetBinding(id);
        }
    }

    void ResetAll() => keys?.Reset();

    void AskToImport() => ImportRequested?.Invoke(this);

    void AskToExport() => ExportRequested?.Invoke(this);

    void Choose(Select _, string? name) {
        if (keys is not { } map || string.Equals(name, map.PresetName, StringComparison.Ordinal)) {
            return;
        }

        if (!map.UsePreset(name)) {
            complaint.Value = string.Format(
                CultureInfo.CurrentCulture,
                EditorStrings.KeysUnknownPreset.Text,
                name
            );
        }
    }

    void Keyed(KeyEvent args) {
        if (!IsCapturing || args.Action != KeyAction.Pressed) {
            return;
        }

        // ⚠ Escape leaves capture rather than being bound to anything. A panel that let Escape be
        // recorded would be one whose capture mode has no way out for whoever just bound it.
        if (args.Key == InputKey.Escape) {
            Capture(false);
            args.Handled = true;

            return;
        }

        var chord = KeyChord.Of(args);

        if (!chord.IsBound) {
            // A modifier held on its own. Swallowed anyway, so that holding Ctrl while reaching for
            // the letter does not run whatever Ctrl alone would have.
            args.Handled = true;
            return;
        }

        // ⚠ Back into the portable vocabulary before it is stored. `KeyChord.ForPlatform` is an
        // involution — see its own remarks — so a ⌘S pressed on a Mac becomes the Ctrl+S every
        // keymap file, menu model and preset in this editor is written in.
        chord = chord.ForPlatform();

        var replace = chord == Pending;

        if (Rebind(chord, replace) != BindResult.Conflict) {
            Capture(false);
        }

        args.Handled = true;
    }

    string Describe(string id) => keys?.ChordFor(id).Describe() is { Length: > 0 } text ? text : "—";

    string SourceOf(string id) =>
        keys?.SourceOf(id) switch {
            BindingSource.User => EditorStrings.KeysSourceUser.Text,
            BindingSource.Preset => keys.PresetName,
            _ => EditorStrings.KeysSourceDefault.Text
        };

    string? ContextOf(string id) => commands is { } registry && registry.TryGet(id, out var command)
        ? command.Context
        : null;

    bool Matches(string id, string title, string category) =>
        filter is null
        || id.Contains(filter, StringComparison.OrdinalIgnoreCase)
        || title.Contains(filter, StringComparison.OrdinalIgnoreCase)
        || category.Contains(filter, StringComparison.OrdinalIgnoreCase);

    /// <summary>What the line under the grid says, as a function of the five signals.</summary>
    /// <remarks>
    ///     The complaint outranks the conflict because it is written last: in the C# it was a direct
    ///     assignment to <c>Status.Text</c> after a <c>Restate</c> had run, and this is the same
    ///     precedence expressed as an order of reads rather than as an order of writes.
    /// </remarks>
    string Sentence() {
        if (complaint.Value is { } said) {
            return said;
        }

        if (Conflict is { } holder) {
            return string.Format(
                CultureInfo.CurrentCulture,
                EditorStrings.KeysConflict.Text,
                Pending.Describe(),
                commands is { } registry && registry.TryGet(holder, out var command) ? command.Title.Text : holder
            );
        }

        return IsCapturing
            ? EditorStrings.KeysWaiting.Text
            : Selected is null
                ? EditorStrings.KeysPickRow.Text
                : EditorStrings.KeysReady.Text;
    }

    /// <summary>The grid's columns and the two boxes' subscriptions, once the <c>ref</c>s exist.</summary>
    /// <remarks>
    ///     ⚠ ~~<b><c>keyed</c> guards the one line here that is not idempotent, and it has to.</b>~~
    ///     <b>The line it guarded has left this method</b> — the capture-leg key handler is
    ///     <c>&lt;self on:keydown.capture.handled&gt;</c> in the markup above — <b>and the guard has
    ///     gone with it.</b> Everything left is idempotent by construction: re-running it re-adds
    ///     columns to and re-subscribes to whatever the <c>ref</c>s now point at, which is right.
    ///     What made the handler different was that it was on <i>this</i> element, which a rebuild
    ///     does not replace, with no <c>RemoveHandler</c> paired to it. A markup <c>on:</c> binding
    ///     now registers that removal against the region being built, so the framework owns the
    ///     pairing rather than each panel remembering a flag.
    /// </remarks>
    partial void OnComposed() {
        Search.ValueChanged += Filtered;

        Presets.ClearOptions();

        foreach (var name in KeyMapPresets.Names) {
            Presets.AddOption(name, name);
        }

        Presets.SelectionChanged += Choose;

        Column(EditorStrings.KeysColumnCommand.Text, 240f, row => row.Title);
        Column(EditorStrings.KeysColumnCategory.Text, 120f, row => row.Category);
        Column(EditorStrings.KeysColumnBinding.Text, 150f, row => Describe(row.Id));
        Column(EditorStrings.KeysColumnSource.Text, 90f, row => SourceOf(row.Id));

        Grid.SelectionChanged += Chose;

        // Double-clicking a row is how every keybinding editor starts a capture, and it is the one
        // gesture somebody tries before reading the strip.
        Grid.Activated += Activated;

        if (commands is not null) {
            Presets.Value = keys?.PresetName ?? KeyMapPresets.Vixen;
            Rebuild();
        }
    }

    partial void OnUnmounted() {
        Detach();
    }

    void Filtered(TextField _, string? value) {
        filter = string.IsNullOrWhiteSpace(value) ? null : value;
        Rebuild();
    }

    void Chose(DataGrid _) {
        // A selection change while waiting for a key is the user changing their mind about which
        // row they are binding, and silently binding the next keystroke to the new row is how a
        // capture mode surprises somebody.
        Capture(false);

        complaint.Value = null;
        Sync();
    }

    void Activated(DataGrid _, object __) => Capture(true);

    /// <summary>Puts the grid's selection on the signal the strip and the status line read.</summary>
    void Sync() =>
        selected.Value =
            Grid.Selection.Count == 1 && Grid.Items.ElementAtOrDefault(Grid.Selection.First()) is KeyBindingRow row
                ? row.Id
                : null;

    void Column(string header, float width, Func<KeyBindingRow, string> value) {
        var column = Grid.AddColumn(header, item => item is KeyBindingRow row ? value(row) : string.Empty);

        column.Width = width;
    }

    /// <inheritdoc cref="MessageLogView.Detach" />
    void Detach() {
        if (keys is not null) {
            keys.Changed -= KeysChanged;
        }

        if (commands is not null) {
            commands.Changed -= CommandsChanged;
        }
    }

    void KeysChanged(KeyMap _) => Refresh();

    void CommandsChanged(CommandRegistry _) => Rebuild();
}
