<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Ui.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Editor.Profiler\Vixen.Editor.Profiler.csproj" />

        <!--
            A view is only testable against a document that has laid itself out, and this is the
            assembly that owns running frames and reading a resolved box back. The flame chart needs
            it more than most: every bar's position is a fraction of a width that does not exist
            until a layout pass has run.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Testing\Vixen.Ui.Testing.csproj" />

        <!--
            The GPU timeline is asserted against a device, and the Null one is the device a test can
            have: it reports timestamp queries, records the writes, and resolves them to synthetic
            readings whose only promise is that a pair subtracts to something positive.
        -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Null\Vixen.Graphics.Null.csproj" />
    </ItemGroup>
    <!--
        #1119's ratchet. The TEST profile in `Directory.Build.props` turns documentation generation
        off for every `*.Tests` project, so no `<see cref>` in any test assembly was ever checked —
        and a test's remarks are read at the worst possible moment, when the test has just gone red.
        CS1591 and CS1573 stay suppressed: "this public member has no comment" is a question about a
        packaged API surface, and a test assembly is not one.

        This project reported nothing when the whole tree was measured with the flag forced on, so
        here it is a latch rather than a repair — which is the point. An overload landing beside a
        cref written earlier is not historical rot; #821's own measurement watched it happen inside
        one working session.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
