<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.Terrain.Physics</RootNamespace>
        <Description>
            Feeds the sculpt tools' collision seam. `ITerrainColliders` is what Vixen.Editor.Terrain
            calls after every stroke and `TerrainColliderSystem` is what rebuilds a tile's Jolt height
            field; neither may reference the other — docs/plan/31 § D1 keeps a runtime assembly out of
            Editor/, and the editor toolset out of physics — so this is the assembly between them.
        </Description>
        <PackageTags>editor;terrain;sculpt;collision;physics;jolt;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The two halves this assembly exists to join, and nothing else — Vixen.Terrain.Physics'
            own arrangement, one layer up. The toolset declares the seam and knows nothing about a
            body; the collider system owns the bodies and knows nothing about a stroke.

            ⚠ Note what this reference direction buys: it is Editor → Core, which the layer rules
            allow, and it is the only direction available. `Vixen.Terrain.Physics` may not reference
            `Editor/Vixen.Editor.Terrain` to implement the interface itself — build/Build.ArchitectureRules.cs
            fails a Core project that references an Editor one — which is why the adapter has to be a
            third assembly rather than a member of either.
        -->
        <ProjectReference Include="..\Vixen.Editor.Terrain\Vixen.Editor.Terrain.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Terrain.Physics\Vixen.Terrain.Physics.csproj" />

        <!--
            ⚠ And the three the *module* needs, which is the half that turns the adapter above into
            something the shipped editor runs. `Vixen.Editor.Plugin` is the door — this registers in
            `EditorModules.Standard` beside Terrain — `Vixen.Editor.SceneView` is where `IPlaySystems`
            and `PlaySession` live, and `Vixen.Rendering.Terrain` is where `ITerrainScene` does: the
            editor's answer to "what ground is placed and where", which is what an `ITerrainPlacements`
            is over.

            All three arrive transitively through Vixen.Editor.Terrain already; they are named because
            this assembly compiles against them, and a reference nobody wrote down is one the next
            person removes.
        -->
        <ProjectReference Include="..\Vixen.Editor.Plugin\Vixen.Editor.Plugin.csproj" />
        <ProjectReference Include="..\Vixen.Editor.SceneView\Vixen.Editor.SceneView.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Rendering.Terrain\Vixen.Rendering.Terrain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Editor.Terrain.Physics.Tests" />

        <!--
            ⚠ And the application's suite, which is where the end-to-end claim is made: a stroke in a
            *live editor* reaching a real Jolt height field. `PlayColliders` is the switch that claim
            is read off — its two counters are the only symptom the wiring has — and publishing it
            just so a test can see it would be a public type nobody outside this assembly constructs.
        -->
        <InternalsVisibleTo Include="Vixen.Editor.App.Tests" />
    </ItemGroup>

</Project>
