<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.App</RootNamespace>
        <AssemblyName>VixenEditor</AssemblyName>
        <IsPackable>false</IsPackable>

        <!--
            ⚠ Not NativeAOT, and doc 11 says why: plugin assemblies load into an
            AssemblyLoadContext for unloadability, which is the one place in the codebase where
            runtime reflection is required rather than merely allowed.
        -->
        <PublishAot>false</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <!--
            ⚠ **This project exists so that the editor can stop referencing its own features.** Doc
            36 § P3: a feature cannot be dereferenced by the assembly that has to instantiate it, and
            `Vixen.Editor.App` was the executable. The composition root is what names the modules, so
            the composition root has to be somewhere else — here, whose whole job is a window, a
            device, four steps of a frame, and the list below.

            `RootNamespace` is deliberately the same as the library's: nothing a consumer writes
            changes, and `EditorHost` and `EditorApplication` read as the two halves they always were.
        -->
        <ProjectReference Include="..\Vixen.Editor.App\Vixen.Editor.App.csproj" />

        <!-- The modules this editor ships, which is the only reason these references are here. -->
        <ProjectReference Include="..\Vixen.Editor.Blockout\Vixen.Editor.Blockout.csproj" />
        <ProjectReference Include="..\Vixen.Editor.Terrain\Vixen.Editor.Terrain.csproj" />

        <!--
            ⚠ And its collision half, which is a separate module for the reason it is a separate
            assembly: `Vixen.Editor.Terrain` links no physics and `Core/Vixen.Terrain.Physics` may not
            link the editor, so the thing that joins them is a third project — and until it was named
            here it was referenced by nothing but its own tests. docs/plan/31 § D10.
        -->
        <ProjectReference Include="..\Vixen.Editor.Terrain.Physics\Vixen.Editor.Terrain.Physics.csproj" />

        <!-- Doc 35 § W9's toolset, on exactly the terrain module's terms. -->
        <ProjectReference Include="..\Vixen.Editor.Water\Vixen.Editor.Water.csproj" />
        <ProjectReference Include="..\Vixen.Editor.Diagnostics\Vixen.Editor.Diagnostics.csproj" />
        <ProjectReference Include="..\Vixen.Editor.AssetEditors\Vixen.Editor.AssetEditors.csproj" />
        <ProjectReference Include="..\Vixen.Editor.Scripts\Vixen.Editor.Scripts.csproj" />

        <!--
            The window, the device and the four steps of a frame. Deliberately assembled here rather
            than taken from Tools/Vixen.App: that host owns a frame loop built around an ECS world
            and a fixed-step accumulator, and the editor's loop is an interface that redraws when
            something changes. Doc 17's "the app is the executable" is the same argument.
        -->
        <!--
            ⚠ **`UiWindowSurface`, which used to be this project's own `EditorPane.cs`.** The
            repository carried three frame loops and this was the best of them; it moved out rather
            than being copied out, so the sample and the template inherit multi-window presenting,
            per-surface gamut publishing and the tessellation cache instead of the editor inheriting
            anything.

            ⚠ **And `UiShaderLibrary`, which this comment used to say the editor could not use.** The
            claim was that the editor's UI stages put their vertex attributes at different locations
            from the desktop assembly's — and they did not: the two `Ui.rvn` declared the same three
            streams, and `UiVertex.reflect.json` was byte-identical in both directories. What the
            editor's copy actually lacked was `UiBlur`, `UiColour` and `UiMask`, so the editor
            composited groups and never blurred, filtered or masked one. The copy is deleted and
            `EditorHost` calls `UiShaderLibrary.Load`.

            What this host still does *not* take from that assembly is `UiApplication`: the loop in
            `EditorHost` drives a compositor, a scene presenter per pane and a GPU profiler.
        -->
        <ProjectReference Include="..\..\Platform\Vixen.Ui.Desktop\Vixen.Ui.Desktop.csproj" />

        <ProjectReference Include="..\..\Core\Vixen.Ui.Renderer\Vixen.Ui.Renderer.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Graphics.RenderGraph\Vixen.Graphics.RenderGraph.csproj" />
        <ProjectReference Include="..\..\Platform\Vixen.Platform.Desktop\Vixen.Platform.Desktop.csproj" />
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Vulkan\Vixen.Graphics.Vulkan.csproj" />

        <!--
            Platform events turned into document events, and a docking host's request for a floating
            window turned into a real one.
        -->
        <ProjectReference Include="..\..\Platform\Vixen.Platform.Ui\Vixen.Platform.Ui.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            SPIR-V, committed, for the reason Samples/01 and Samples/02 give: `UiRenderer`'s modules
            are supplied rather than compiled, because turning shader source into modules belongs to
            Raven. The source beside them is Raven's now — Shaders/*.rvn — so what is committed is
            the output of a compiler in this repository rather than of `glslc` on someone's machine.

            Regenerating is one `raven compile` per .rvn — the command is in Shaders/README.md,
            because MSBuild will not have the double dash a command line needs anywhere in an XML
            comment. Its `emit-reflection` flag is not optional: the .reflect.json is what the
            generator below reads, and a module regenerated without it is a module whose attribute
            locations the host is still being told the old values for.
        -->
        <EmbeddedResource Include="Shaders\*.spv" />

        <!--
            The engine's shader library, beside the editor rather than embedded in it.

            ⚠ Files rather than resources, because `RavenEffectCompiler` takes paths: it parses the
            trees once and redoes the compilation per variant, which is what makes forty variants of
            one shader cost forty lowerings rather than forty parses. A resource would have to be
            written to a temp directory first, and then the source hash the disk cache keys on would
            depend on where that temp directory was.

            ⚠ And the whole library, not a subset. A package's declarations are visible to a sibling
            file only within one compilation — see `CheckShaders` — so a project shader importing
            `Vixen.Shaders.Core` needs Core's files present, and every other package is one import
            away from something.
        -->
        <None Include="..\..\Raven\Library\**\*.rvn"
              Link="Shaders\Library\%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              Visible="false" />

        <!--
            ⚠ The interface's face is NOT here, and putting it here is the mistake this comment
            exists to stop somebody repeating. `Fonts.Embedded` asks
            `typeof(Fonts).Assembly.GetManifestResourceStream(...)`, and `Fonts` lives in
            `Vixen.Editor.App` — so a face embedded in this assembly is one that class can never
            find. It was embedded here for four weeks and the lookup silently answered null the whole
            time, which drops the editor onto whatever face the machine happens to have. The
            resource belongs to the assembly whose code reads it: see `Vixen.Editor.App.csproj`.
        -->

        <!--
            The bindings generator turns each .reflect.json into the constants this host binds
            against: where each descriptor goes, and — the reason it is wired up here — which vertex
            attribute location each stage reads. That number is Raven's decision, not this
            application's: `StreamPlan` locates a stage's own parameters after the shader's streams,
            so Line.rvn's attributes are not at 0..1, and adding a stream to a vertex shader moves
            them again.

            ⚠ The interface's own stages are no longer among these — `UiShaderLibrary` reads their
            locations out of its own assembly's reflection. What is left here is the three tool
            shaders: Line, Mesh and MeshInstanced.

            ⚠ A wrong location is not a validation error. The pipeline binds nothing to that
            attribute and the stage reads whatever the driver left there — an interface drawn from
            uninitialized memory, on one driver, silently. Reading the number back out of the
            compiler's own output is what makes that unable to happen.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Shaders.Generators\Vixen.Shaders.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <AdditionalFiles Include="Shaders\*.reflect.json" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The harness drives `EditorApplication` directly — it has no window and no device — but it
            needs this project's module list, because an editor without its features is not the thing
            under test. See `EditorModules`.
        -->
        <InternalsVisibleTo Include="Vixen.Editor.Testing" />
        <InternalsVisibleTo Include="Vixen.Editor.App.Tests" />
    </ItemGroup>

</Project>
