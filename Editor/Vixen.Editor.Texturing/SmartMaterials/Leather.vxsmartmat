version: 1
name: Leather
baseWidth: 1024
baseHeight: 1024
sets:
  - name: Material
    channels:
      - usage: baseColor
        default: [0.5, 0.5, 0.5, 1]
      - usage: roughness
        default: [0.5, 0.5, 0.5, 1]
      - usage: metalness
        default: [0, 0, 0, 1]
    layers:
      - id: hide
        name: Hide
        kind: Fill
        values:
          baseColor: [0.16, 0.08, 0.05, 1]
          roughness: [0.62, 0.62, 0.62, 1]
          metalness: [0, 0, 0, 1]
      - id: grain
        name: Pebble Grain
        kind: Fill
        blend: Copy
        opacity: 0.7
        values:
          baseColor: [0.26, 0.14, 0.09, 1]
          roughness: [0.5, 0.5, 0.5, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Patterns/Cells
      - id: creases
        name: Creases
        kind: Fill
        blend: Multiply
        opacity: 0.55
        values:
          baseColor: [0.62, 0.6, 0.58, 1]
          roughness: [1.15, 1.15, 1.15, 1]
          metalness: [1, 1, 1, 1]
        mask:
          source: Generator
          generator: Grunges/Grunge Damage
      - id: sheen
        name: Rubbed Sheen
        kind: Fill
        blend: Copy
        opacity: 0.6
        values:
          baseColor: [0.34, 0.2, 0.13, 1]
          roughness: [0.28, 0.28, 0.28, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Curvature Edge Wear
      - id: dust
        name: Settled Dust
        kind: Fill
        blend: Multiply
        opacity: 0.3
        values:
          baseColor: [0.82, 0.8, 0.76, 1]
          roughness: [1.2, 1.2, 1.2, 1]
          metalness: [1, 1, 1, 1]
        mask:
          source: Generator
          generator: Generators/Dust
