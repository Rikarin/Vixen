version: 1
name: Plastic
baseWidth: 1024
baseHeight: 1024
sets:
  - name: Material
    channels:
      - usage: baseColor
        default: [0.5, 0.5, 0.5, 1]
      - usage: roughness
        default: [0.5, 0.5, 0.5, 1]
      - usage: metalness
        default: [0, 0, 0, 1]
    layers:
      - id: moulding
        name: Moulding
        kind: Fill
        values:
          baseColor: [0.62, 0.14, 0.11, 1]
          roughness: [0.24, 0.24, 0.24, 1]
          metalness: [0, 0, 0, 1]
      - id: scuffs
        name: Scuffs
        kind: Fill
        blend: Copy
        opacity: 0.8
        values:
          baseColor: [0.71, 0.31, 0.28, 1]
          roughness: [0.52, 0.52, 0.52, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Grunges/Grunge Scratches
      - id: polish
        name: Handled Sheen
        kind: Fill
        blend: Copy
        opacity: 0.6
        values:
          baseColor: [0.66, 0.18, 0.14, 1]
          roughness: [0.13, 0.13, 0.13, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Curvature Edge Wear
      - id: dust
        name: Settled Dust
        kind: Fill
        blend: Copy
        opacity: 0.35
        values:
          baseColor: [0.58, 0.56, 0.52, 1]
          roughness: [0.66, 0.66, 0.66, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Dust
