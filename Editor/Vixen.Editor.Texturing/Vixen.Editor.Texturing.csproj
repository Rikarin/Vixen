<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.Texturing</RootNamespace>
        <Description>
            The texture-graph plugin: the .vxtexgraph document, the panel that edits one, the Create ▸
            entry that makes one, and the module that registers all three through the plugin contract.
            The evaluator and the kernels are Vixen.Editor.TextureGraph and are not this.
        </Description>
        <PackageTags>editor;plugin;texture-graph;material-authoring;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!--
            ⚠ **`Vixen.Editor.App` is deliberately absent, and that absence is the claim doc 48 § D14
            makes.** Everything this assembly needs from the host it asks for through
            `PluginServices.Require` — which is the only way a third party could have written it, and
            therefore the only way this feature proves the door is wide enough. `ModuleReferenceTests`
            asserts the absence rather than trusting this comment.

            The contract, and the shell vocabulary a command and a panel are expressed in. The second
            is what the first already references, named here because this assembly builds controls of
            its own rather than only registering with the shell.
        -->
        <ProjectReference Include="..\Vixen.Editor.Plugin\Vixen.Editor.Plugin.csproj" />
        <ProjectReference Include="..\Vixen.Editor.Ui\Vixen.Editor.Ui.csproj" />

        <!--
            The project, the document base and the contribution registry: `EditorDocument`,
            `EditorProject`, `NewAssetKind` and `IEditorRegistry`. A `.vxtexgraph` is an asset in a
            project before it is anything else.
        -->
        <ProjectReference Include="..\Vixen.Editor.Core\Vixen.Editor.Core.csproj" />

        <!--
            The canvas and the model a texture graph is stored as. `NodeGraphAsset` is the file's
            shape, exactly as a `.vxshadergraph`'s is, and `NodeGraphView` is what edits one.
        -->
        <ProjectReference Include="..\Vixen.Editor.NodeGraph\Vixen.Editor.NodeGraph.csproj" />

        <!--
            And the node library, which is the only thing this assembly takes from the evaluator.

            ⚠ **It is the only thing it *can* take.** `TextureGraphCompiler`, `TextureNode` and all
            eight `[Node]` classes are `internal` and that assembly's `InternalsVisibleTo` names its
            own test project alone — so the generated `NodeTypes.Register` is the whole of the
            reachable surface and a plugin cannot compile a graph into a `TexturePlan` at all. See
            this project's README; it is a finding rather than a decision.
        -->
        <ProjectReference Include="..\Vixen.Editor.TextureGraph\Vixen.Editor.TextureGraph.csproj" />

        <!--
            ⚠ And the asset editors, because this plugin claims a file extension — which is what
            `PluginServices` says a plugin that wants an extension point outside the shell does: it
            references the assembly that owns the registry and hands the typed thing to `Require` or
            `TryGet`. It is the heaviest reference here, and it is the price of a double-click.
        -->
        <ProjectReference Include="..\Vixen.Editor.AssetEditors\Vixen.Editor.AssetEditors.csproj" />

        <!--
            ⚠ And the image decoders, named here rather than taken through the reference above.
            `LayerStackPreview` resolves a texture-fill layer's imported picture — #818 — which means
            reading a file the asset database points at and decoding it to Rgba8, and the decoder set
            an importer already uses is `ImageDecoders.BuiltIn`. It arrives transitively through
            `Vixen.Editor.AssetEditors` either way; a reference this assembly *uses* is written down,
            because the day somebody narrows that one is the day this file stops compiling for a
            reason nothing states.
        -->
        <ProjectReference Include="..\Vixen.Editor.Assets\Vixen.Editor.Assets.csproj" />

        <!--
            ⚠ And `MeshData`, for `LayerStackMesh` — #920. A stack names the model it is painted on
            and the host half reads that model's UV triangles out of `ModelReader`, whose meshes are
            `Vixen.Rendering`'s type. It arrives transitively through `Vixen.Editor.Assets`, and it is
            named for the same reason that one is: a reference this assembly *uses* is written down.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering\Vixen.Rendering.csproj" />

        <!--
            ⚠ Named for one type and one question: `IGraphicsDevice`, so that
            `TexturePreview.Blocking` can ask the host for one and say precisely what is missing when
            there is none. Doc 48 § D14 predicted a plugin would need a device and that the contract
            publishes none; this reference is what turns that prediction into a value a test can
            assert rather than a sentence in a report.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Graphics\Vixen.Graphics.csproj" />

        <!-- The image view the preview pane is, and the canvas the graph view is built on. -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Controls.Advanced\Vixen.Ui.Controls.Advanced.csproj" />

        <!--
            ⚠ The slider and the segmented control the brush inspector is, named rather than taken
            transitively through the line above. It arrives either way — `Vixen.Ui.Controls.Advanced`
            references it — and a reference this assembly *uses* is written down, for the same reason
            `Vixen.Editor.Assets` is: the day somebody narrows that one is the day this file stops
            compiling for a reason nothing states.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Controls\Vixen.Ui.Controls.csproj" />

        <!--
            ⚠ **The brush, and it is a terrain assembly only by its name.** Doc 48 § D13 says
            painting is doc 31's brush aimed at an atlas instead of a heightfield, and that turned out
            to be literally true rather than an analogy: `TerrainBrush.WeightAt`, `BrushFalloff` and
            `BrushStroke` read a `Vector2`, a radius and a spacing fraction, and not one of them reads
            a metre. `TerrainBrush`'s own remarks say "one service, three consumers … it does not know
            what the answer will be multiplied into"; `Painting/PaintBrush.cs` is the fourth consumer
            and passes it texels.

            The alternative was a paint-side falloff, which is a second implementation of one curve —
            the shape five exact-equality roll calls in this workstream have gone red on, and here it
            would be worse: the two would be compared by eye, because a soft edge sculpted at 0.3 and
            a soft edge painted at 0.3 being different shapes is exactly what `TerrainBrush` exists to
            prevent and exactly what nobody would notice.

            It is a `Core/` assembly with two references of its own, it declares no type this plugin
            registers, and `PluginLoadContext` sends every `Vixen.*` dependency to the default context
            — so its `[DataContract]`s register once, in the host, and the collectible-context
            landmine this file warns about below does not apply to it.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Terrain\Vixen.Terrain.csproj" />

        <!--
            ⚠ And the reactive graph, for one type: `Effect`. `LayerStackView` follows the open
            document's `CommandStack.Depth` so that an undo taken anywhere else reaches its rows —
            #933 — and a signal has no other subscription mechanism. It arrives transitively through
            `Vixen.Ui.Controls`, and is written down for the reason every other transitive reference
            here is: the day somebody narrows that one is the day this file stops compiling for a
            reason nothing states.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Reactive\Vixen.Ui.Reactive.csproj" />

        <!-- A graph is YAML on disk, the same as every other node document in the tree. -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Yaml\Vixen.Core.Yaml.csproj" />

        <!--
            ⚠ **And no `Vixen.Core.Reflection` here, deliberately: a plugin's own entry assembly must
            not declare a `[DataContract]`.** `PluginLoadContext` sends every `Vixen.*` dependency to
            the default context and loads *this* assembly into the collectible one — that is exactly
            what makes `PluginHost.WaitForCollection` mean anything — so this assembly is loaded
            twice, its generated descriptor module initializer runs twice, and the process-wide
            `TypeRegistry` refuses the second with *"Both 'X' and 'X' claim the name"*, out of a
            `TypeInitializationException` that takes the whole plugin load down. `.vxlayers` is
            therefore mapped key by key in `LayerStackYaml`. See #798; `Vixen.Editor.Terrain` has the
            same landmine and nothing loads it from a folder yet.
        -->
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Editor.Texturing.Tests" />
    </ItemGroup>

</Project>
