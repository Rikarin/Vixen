/* SPDX-FileCopyrightText: Copyright (c) Rikarin
   SPDX-License-Identifier: Apache-2.0

   The layer stack panel's layout, as a stylesheet on disk rather than as fifty-two `SetStyle` calls
   in the middle of the code that builds the tree — the first half of
   https://github.com/Rikarin/Vixen/issues/881, which is doc 36 § P4's markup debt.

   ⚠ **Layout only, and every colour is somebody else's.** `ControlTheme`, `AdvancedTheme` and
   `EditorTheme` are already in the editor's document and already style every control this panel is
   made of; what was inline was the *flex box* — which direction a container stacks in, which one
   grows, and how wide the preview column is. Those are exactly the declarations a reader of
   `LayerStackView` had to reconstruct from three lines at each of nine call sites.

   ⚠ **What is deliberately NOT here: anything the panel changes while it is running.** A `display`
   that is toggled from `Show` — the empty state, the message block, a fill row that only exists for
   a `Constant` source — stays an inline write in C#, because an inline style is a cascade origin
   above this sheet and the two would be arguing rather than layering. What this file gives such an
   element is its *initial* value, which is what the constructor used to write. The `padding-left`
   that indents a nested row stays too: it is `depth × 12px`, and a rule per depth is not a rule.

   ⚠ **And a stack, so the two mean the same thing.** `rows.Add("layer-stack-row")` builds an
   element whose *tag* is `layer-stack-row`, so these are type selectors and not class selectors —
   the same shape `NodeGraphTheme.vcss` uses for `graph-note`. */

/* ⚠ **The ladder, restated.** `ControlTheme.vcss` explains it; the statement has to be here too
   because `CascadeLayers.Declare` fixes a layer's position the first time anything names it, so the
   order belongs to whichever sheet a document loaded first rather than to any one file. */

@layer base, components, utilities;

@layer components {

/* ── The panel's two columns ────────────────────────────────────────── */

/* The whole view is a row: rows on the left, the baked picture on the right, and — when the host
   paints — the brush inspector as a third column `PaintBrushInspector` builds into the same root. */
layer-stack { display: flex; flex-direction: row; flex-grow: 1; }

/* The left column takes the room the fixed-width preview leaves. */
layer-stack-rows { display: flex; flex-direction: column; flex-grow: 1; }

/* ⚠ `flex-grow` on the list and on nothing else in the column. The binding row, the actions row,
   the legend and the message block are each as tall as their content; the list is what absorbs a
   resize, which is the one of the five an artist scrolls. */
layer-stack-list { display: flex; flex-direction: column; flex-grow: 1; }

/* Which set, which model, which of its meshes — one decision read left to right. */
layer-stack-binding { display: flex; flex-direction: row; }

/* Add a layer, and what kind. */
layer-stack-actions { display: flex; flex-direction: row; }

/* ⚠ Hidden to begin with and shown by `Show` when there is something to say — a heading with
   nothing under it reads as "nothing was checked", and the ordinary case is a stack with nothing
   wrong. ⚠ No `flex-grow`, deliberately: the list of rows keeps the space and this grows only as
   far as it has messages. */
layer-stack-messages { display: none; flex-direction: column; }

/* ⚠ A fixed width rather than a fraction. The picture is the thing being judged, so it keeps its
   size when the rows grow — and the brush column beside it keeps the picture's width when it
   appears, which is why it is added last. */
layer-stack-preview { display: flex; flex-direction: column; width: 280px; }

/* ⚠ A sibling of the layout rather than a child of it, because the empty state is shown by hiding
   that layout — a message inside the thing being hidden is a message nobody sees. Shown by `Show`. */
layer-stack-empty { display: none; }

/* ── The rows ───────────────────────────────────────────────────────── */

/* Every row of the list is a horizontal strip, whatever it is a row of: a layer, a layer whose id is
   ambiguous, a fill source, one channel of a fill, or an entry of a mask. The indent that says which
   is nested under which is `padding-left`, written in C# because it is `depth × 12px`. */
layer-stack-row,
layer-stack-fill-row,
layer-stack-fill-channel,
layer-stack-mask-row { display: flex; flex-direction: row; }

/* One tick per channel of the set, inside the layer's own row. */
layer-stack-channels { display: flex; flex-direction: row; }

}
