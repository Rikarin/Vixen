<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.NodeGraph.Tests</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>

        <!-- The fixture nodes are node types, and a node's ports are its fields. See the framework's
             own csproj for why that is the design rather than an oversight. -->
        <NoWarn>$(NoWarn);CA1051</NoWarn>

        <!-- SealedControlHost.vxml, for the same reason the node generator is referenced below: the
             test that a compiler works is a test that it compiles something it has never seen. Here
             what is being compiled is a `.vxml` naming two `sealed` controls, which the panel ledger
             recorded as unwritable. One line, because Directory.Build.targets is the stand-in for
             what a PackageReference brings. -->
        <VixenUi>true</VixenUi>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- The view is drawn with real text, so the tests that lay one out need a real font. The
             same one the rest of the interface tests use. -->
        <EmbeddedResource Include="..\..\Core\Vixen.Ui.Text.Tests\Fonts\TestShapeLana.ttf"
                          LogicalName="Vixen.Editor.NodeGraph.Tests.Fonts.TestShapeLana.ttf" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Editor.NodeGraph\Vixen.Editor.NodeGraph.csproj" />

        <!-- The generator, over this assembly's own fixture nodes: the test that the generator works
             is a test that a class with marked fields becomes a usable node type, and that needs the
             generator to have run over a class it has never seen. -->
        <ProjectReference Include="..\Vixen.Editor.NodeGraph.Generator\Vixen.Editor.NodeGraph.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!-- A graph file is YAML in practice, and the round-trip doc 11 asks for is only a real test
             if it goes through a serializer rather than through the shape conversion alone. -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Yaml\Vixen.Core.Yaml.csproj" />
    </ItemGroup>
</Project>
