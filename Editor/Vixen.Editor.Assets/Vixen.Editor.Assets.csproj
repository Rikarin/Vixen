<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.Assets</RootNamespace>
        <Description>
            The importer framework: what an importer is, what it is handed, what it must declare it
            read, and the cache key that decides whether it runs at all.
        </Description>
        <PackageTags>editor;importer;asset-pipeline;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Assimp's binding is a C API of raw pointers. Confined to Models/, and the only place in
             the repository outside the graphics backends that needs it. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.IO.Hashing" />

        <!--
          Import-time image decoding. Public domain, and editor-only regardless: the runtime reads
          KTX2 with Vixen's own code and never decodes an authoring format. See Directory.Packages.props
          for why this is not the ImageSharp doc 01 specified.
        -->
        <PackageReference Include="StbImageSharp" />

        <!--
          Import-time model reading: FBX, glTF, OBJ, COLLADA. Bindings plus natives, so nothing has
          to be installed. Editor-only for the same reason as the image codec and more so — a
          runtime that linked Assimp would carry an FBX parser into every shipped game for a job the
          runtime does not do. CheckArchitecture enforces that.
        -->
        <PackageReference Include="Silk.NET.Assimp" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core.IO\Vixen.Core.IO.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection\Vixen.Core.Reflection.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Yaml\Vixen.Core.Yaml.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Serialization\Vixen.Core.Serialization.csproj" />

        <!-- The texture importer is decode, filter, compress, write — and everything but the decode
             is Vixen.Core.Imaging, which is where those decisions can be tested against a spec. -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Imaging\Vixen.Core.Imaging.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Graphics\Vixen.Graphics.csproj" />

        <!-- The audio importer produces an AudioClip, which is a runtime type for the same reason
             Ktx2 is: the thing that writes it and the thing that loads it have to be talking about
             one type, and the type's name is in the chunk. -->
        <ProjectReference Include="..\..\Core\Vixen.Audio\Vixen.Audio.csproj" />

        <!-- The header reader. The importer copies the container and writes down what is in it;
             nothing here decodes, because there is no runtime format to decode into. -->
        <ProjectReference Include="..\..\Core\Vixen.Video\Vixen.Video.csproj" />

        <!-- And the model importer produces a ModelData, its meshes, its skeleton and its clips. -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering\Vixen.Rendering.csproj" />

        <!-- It also bakes a distance field per mesh (docs/plan/19 § L1). Same reason as the navmesh
             below: the bake is a runtime assembly's, because the artefact it writes is what a player
             deserialises and both halves have to agree on the type. -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering.DistanceFields\Vixen.Rendering.DistanceFields.csproj" />

        <!-- And ModelCompiler builds each mesh's cluster hierarchy (docs/virtualized-geometry.md
             phase 1). Same arrangement again: the MeshletMesh this writes is what a player
             deserialises, so the build and the runtime have to be talking about one type. -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering.VirtualGeometry\Vixen.Rendering.VirtualGeometry.csproj" />

        <!--
            The terrain toolset's four authored assets — docs/plan/31 § T4, T5, T6 and T8 each shipped
            the content and deferred the file to here, deliberately, so that it would be one job. What
            the importer needs from these two is each type's own Validate(): the sentence that turns
            "the grass never grew" into a message beside the file that caused it.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Terrain\Vixen.Terrain.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Foliage\Vixen.Foliage.csproj" />

        <!-- The navmesh importer runs the bake, which is a runtime assembly's: the artefact it writes
             is what a player deserialises, so both halves have to be the same NavMeshAsset. -->
        <ProjectReference Include="..\..\Core\Vixen.Navigation\Vixen.Navigation.csproj" />

        <!-- And the scene importer runs the compile, for exactly the same reason: SceneAsset is the
             type the build writes and the type SceneManager loads, and the component registry that
             says what a scene may carry has to be the one the game reads it with. -->
        <ProjectReference Include="..\..\Core\Vixen.Engine\Vixen.Engine.csproj" />

        <!-- The content build emits a catalog, which is a runtime type: the builder and the loader
             have to be talking about the same one. -->
        <ProjectReference Include="..\..\Core\Vixen.Assets\Vixen.Assets.csproj" />
        <ProjectReference Include="..\Vixen.Editor.Core\Vixen.Editor.Core.csproj" />

        <!--
            For VfxImporter. A `.vxvfx` is a node graph, so compiling one needs the node library and
            the graph compiler — both editor-side, which is exactly where an importer runs. This is
            the same shape as the model importer reaching for Assimp: the heavy authoring-format
            knowledge lives above the runtime, and a player loads what the build produced.
        -->
        <ProjectReference Include="..\Vixen.Editor.VfxGraph\Vixen.Editor.VfxGraph.csproj" />

        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Editor.Assets.Tests" />
    </ItemGroup>

</Project>
