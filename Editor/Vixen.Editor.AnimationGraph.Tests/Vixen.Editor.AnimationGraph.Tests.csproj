<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <RootNamespace>Vixen.Editor.AnimationGraph.Tests</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Editor.AnimationGraph\Vixen.Editor.AnimationGraph.csproj" />

        <!--
            The YAML round trip is half of what a text asset promises, so the tests read and write
            one. Nothing in the compiled assembly links a parser — which file format a document is
            written in belongs to whoever writes it, the same arrangement NodeGraphAsset has.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Yaml\Vixen.Core.Yaml.csproj" />
    </ItemGroup>
</Project>
