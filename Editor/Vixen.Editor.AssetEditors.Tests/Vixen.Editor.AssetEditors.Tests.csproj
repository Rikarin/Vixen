<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Ui.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Editor.AssetEditors\Vixen.Editor.AssetEditors.csproj" />

        <!--
            A view is only testable against a document that has laid itself out, and this is the
            assembly that owns running frames and reading a resolved box back.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Testing\Vixen.Ui.Testing.csproj" />

        <!--
            ⚠ A device, so that a shader-graph preview's *refusal* is testable without Vulkan. The
            refusal is recorded from the effect's reflected bindings before a single target or
            pipeline is made, so the Null device is enough to reach it — which is what keeps the one
            assertion about a panel saying why a node has no picture off the golden-image leg.
        -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Null\Vixen.Graphics.Null.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The PNG writer, linked rather than copied or referenced. It exists so that the importer's
            input does not come from the library that decodes it, and the sprite editor's tests want a
            real image for exactly the same reason: the panel decodes the file it is pointed at. A
            project reference between two test assemblies would be worse than either — it makes one
            test project's fixtures part of another's public surface — and a second copy of forty
            lines of container format is a second place for a CRC to be wrong.
        -->
        <Compile Include="..\Vixen.Editor.Assets.Tests\MinimalPng.cs" Link="MinimalPng.cs" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The compiled-scene pane is tested against components this assembly declares itself,
            because what it has to show is a *game's* types laid out the way a build lays them out —
            and a test using only the engine's own would not be asking that question. Analyzers do
            not flow through a ProjectReference, so the three generators that describe, serialise and
            register such a component are named here, exactly as Vixen.Engine.Tests names them for
            the same reason.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\Core\Vixen.Engine.Generators\Vixen.Engine.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>
    <!--
        #1119's ratchet. The TEST profile in `Directory.Build.props` turns documentation generation
        off for every `*.Tests` project, so no `<see cref>` in any test assembly was ever checked —
        and a test's remarks are read at the worst possible moment, when the test has just gone red.
        CS1591 and CS1573 stay suppressed: "this public member has no comment" is a question about a
        packaged API surface, and a test assembly is not one.

        This project reported nothing when the whole tree was measured with the flag forced on, so
        here it is a latch rather than a repair — which is the point. An overload landing beside a
        cref written earlier is not historical rot; #821's own measurement watched it happen inside
        one working session.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
