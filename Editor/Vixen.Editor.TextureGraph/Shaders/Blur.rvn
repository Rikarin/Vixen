package Vixen.Editor.TextureGraph.Shaders

// One axis of a box blur. Two ops make a square one.
//
// **Separable, and the plan is what separates it.** A radius-r box over a w×h image is 2r+1 taps per
// texel per axis rather than (2r+1)² in one pass, which at r = 32 is 65 taps against 4 225. So the
// kernel does one axis and a plan that wants a blur lists two ops with `stepX`/`stepY` swapped —
// which also means an artist gets a directional blur out of the same kernel for free.
//
// ⚠ **`radius` arrives in the texels of the image being written, not in texels at the base
// resolution.** Doc 48 § D8's rule lives on the plan and the evaluator is what applies it: a radius
// authored as 8 texels-at-base is written here as 8 on a full-resolution image and 4 on a half-
// resolution one. A kernel that scaled it itself would need to know the base, and then two places
// would have to agree about what a half-resolution image is.

shader Blur {
    var source: Texture2D

    /// The half-width, in texels of the image being written. Fractional radii are honoured.
    var radius: float = 1f

    /// Which way the taps run: (1, 0) horizontal, (0, 1) vertical, (1, 1) diagonal.
    var stepX: int = 1

    var stepY: int = 0

    [Format("rgba16f")] var target: RWTexture2D<float4>

    /// The most taps this kernel takes on each side of a texel, whatever the radius says.
    ///
    /// ⚠ **A budget in *taps*, not a ceiling on the width, and the difference is doc 48 § D8.** A
    /// constant loop bound is a correctness property rather than a performance one: a radius that
    /// arrives as a NaN, or as a number an artist typed four zeros into, would otherwise be a loop no
    /// invocation leaves — which on a GPU is a device loss and a desktop that stops repainting, not a
    /// slow bake. But the radius arrives *already scaled into this image's texels*, so clamping the
    /// width to this number is a second place a bake's resolution gets decided: an authored 20
    /// resolves to 80 at a 4× bake and was silently clipped to 64, making the 4× bake a narrower
    /// filter than the 1× one — [#678](https://github.com/Rikarin/Vixen/issues/678), the fuse #619
    /// removed, relit one layer down. So past the budget the taps spread out instead, and the width
    /// is always the width the plan resolved.
    const val MaxTaps: int = 64

    /// One texel, clamped to the edge.
    ///
    /// Clamping rather than wrapping: a blur that wrapped would pull the opposite edge of the image
    /// into this one, which is exactly the artefact a tileable graph is trying to avoid — and
    /// tileability is a property of what the *generators* draw, not something a filter can bolt on.
    func Tap(x: int, y: int): float4 {
        val size = source.GetDimensions(0)

        return source.Load(int3(clamp(x, 0, size.x - 1), clamp(y, 0, size.y - 1), 0))
    }

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        // ⚠ The width is what the plan resolved; only the sampling inside it is budgeted. Under
        // `MaxTaps` the spacing is exactly one and every line below is the box this kernel always
        // was, texel for texel; past it the same width is covered by `MaxTaps` taps spaced further
        // apart, which thins the box rather than narrowing it.
        val wide = max(radius, 0f)
        val spacing = max(1f, wide / float(MaxTaps))
        val reach = wide / spacing
        val whole = int(floor(reach))
        val partial = reach - float(whole)

        var sum = Tap(coord.x, coord.y)
        var weight = 1f

        // ⚠ The outermost pair is weighted by the fractional part rather than dropped, and that is
        // what makes the filter continuous in the radius. Without it a radius sweeping from 3.0 to
        // 4.0 does nothing at all and then jumps, which reads as a slider with steps in it — and it
        // is also what would make doc 48 § D8's bake-at-1K-against-4K comparison fail for a reason
        // that has nothing to do with resolution.
        for (i in 1 .. MaxTaps) {
            if (i > whole + 1) {
                break
            }

            var w = 1f

            if (i > whole) {
                w = partial
            }

            if (w <= 0f) {
                break
            }

            // At a spacing of one this is `i`, exactly, which is what keeps an ordinary radius the
            // same picture it was.
            val offset = int(round(float(i) * spacing))

            sum = sum + w * Tap(coord.x + stepX * offset, coord.y + stepY * offset)
            sum = sum + w * Tap(coord.x - stepX * offset, coord.y - stepY * offset)
            weight = weight + 2f * w
        }

        target.Store(coord, sum / weight)
    }
}
