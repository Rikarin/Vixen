package Vixen.Editor.TextureGraph.Shaders

// The mapping half of doc 48 § 4.2's `Auto Levels`: the image stretched onto the full range by the
// extremes `MinMaxReduce.rvn` found.
//
// **Two dispatches at least, and the plan is what sequences them** — the reduction chain writes a
// 1×1 image and this reads it. § 4.2 says "two dispatches"; the honest number is *one per reduction
// level plus this one*, because a 4K image does not reduce to a single texel in one dispatch
// without a loop no invocation leaves. The shape is `NearestReduce`/`HiZReduce`'s and so is the
// count.
//
// ⚠ **No parameters, which is what § 4.2 says and is also a claim about the evaluator.** A kernel
// declaring no uniform block is a descriptor set of textures alone, and nothing before this one
// exercised that path — `AutoLevelsTests` is where it is written down, because a `Bind` that fell
// over on it would fail with a message about a descriptor rather than about a node.
//
// **A flat image passes through unchanged rather than becoming black or a NaN.** `max - min` of a
// constant image is zero; dividing by it is the one arithmetic failure this node has, and the
// answer that reads correctly is "there was nothing to stretch".

shader AutoLevels {
    var source: Texture2D

    /// The 1×1 result of the reduction: `(min, max, 0, 1)` of the whole image's red channel.
    var stats: Texture2D

    [Format("rgba16f")] var target: RWTexture2D<float4>

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        val extent = source.GetDimensions(0)
        val texel = source.Load(int3(clamp(coord.x, 0, extent.x - 1), clamp(coord.y, 0, extent.y - 1), 0))
        val range = stats.Load(int3(0, 0, 0))
        val span = range.y - range.x

        if (span < 0.000001f) {
            target.Store(coord, texel)

            return
        }

        val stretched = float3(
            saturate((texel.x - range.x) / span),
            saturate((texel.y - range.x) / span),
            saturate((texel.z - range.x) / span)
        )

        target.Store(coord, float4(stretched.x, stretched.y, stretched.z, texel.w))
    }
}
