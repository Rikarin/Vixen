package Vixen.Editor.TextureGraph.Shaders

// Doc 48 § 4.3's `Resample`: the same picture at the resolution the plan asked for.
//
// **The target's size is the scale**, so the node has no scale parameter — an op writes an image and
// the image's `LevelOffset` is what says how big it is. A "target scale" on the op as well would be
// a second place for a resolution to be wrong, which is the reason `TextureOp` carries no resolution
// either.
//
// ⚠ **`Box` is the default and the only correct choice going down.** Halving with `Point` keeps one
// texel in four and drops the rest — the classic aliasing that a blur chain's cheap half is blamed
// for, because a downsample is where a blur chain starts. The closed form is exact and worth
// stating: **a column checkerboard downsampled by any integer factor with `Box` is 0.5 everywhere**,
// and with `Point` it is 0 or 1 everywhere. Those two are as far apart as a picture gets, which is
// what makes this the node whose golden cannot be satisfied by accident.
//
// **Going up, `Box` degenerates to one sample and `Bilinear` is the one to reach for.**
//
// The identity closed form: a resample to the same size with `Point` is a copy, texel for texel.

shader Resample {
    var source: Texture2D

    /// 0 point · 1 bilinear · 2 box.
    var filter: int = 2

    [Format("rgba16f")] var target: RWTexture2D<float4>

    /// The most sub-samples per axis a box may take, whatever the ratio is.
    ///
    /// ⚠ A ceiling rather than a runtime bound, for `Blur.rvn`'s reason: a ratio computed from two
    /// image sizes is unbounded from the shader's point of view, and a 4096 → 1 box in one dispatch
    /// is a loop no invocation leaves.
    const val MaxSamples: int = 16

    func Fetch(x: int, y: int): float4 {
        val extent = source.GetDimensions(0)

        return source.Load(int3(clamp(x, 0, extent.x - 1), clamp(y, 0, extent.y - 1), 0))
    }

    func Bilinear(px: float, py: float): float4 {
        val x0 = int(floor(px))
        val y0 = int(floor(py))
        val tx = px - float(x0)
        val ty = py - float(y0)

        val top = lerp(Fetch(x0, y0), Fetch(x0 + 1, y0), float4(tx, tx, tx, tx))
        val bottom = lerp(Fetch(x0, y0 + 1), Fetch(x0 + 1, y0 + 1), float4(tx, tx, tx, tx))

        return lerp(top, bottom, float4(ty, ty, ty, ty))
    }

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        val extent = source.GetDimensions(0)
        val u = (float(coord.x) + 0.5f) / float(size.x)
        val v = (float(coord.y) + 0.5f) / float(size.y)

        if (filter == 0) {
            target.Store(coord, Fetch(int(floor(u * float(extent.x))), int(floor(v * float(extent.y)))))

            return
        }

        if (filter == 1) {
            target.Store(coord, Bilinear(u * float(extent.x) - 0.5f, v * float(extent.y) - 0.5f))

            return
        }

        // The box: how many source texels one output texel covers, per axis, at least one.
        val ratioX = clamp(int(ceil(float(extent.x) / float(size.x))), 1, MaxSamples)
        val ratioY = clamp(int(ceil(float(extent.y) / float(size.y))), 1, MaxSamples)

        var sum = float4(0f, 0f, 0f, 0f)

        for (sy in 0 .. MaxSamples) {
            if (sy >= ratioY) {
                break
            }

            for (sx in 0 .. MaxSamples) {
                if (sx >= ratioX) {
                    break
                }

                val fx = (float(coord.x) + (float(sx) + 0.5f) / float(ratioX)) / float(size.x)
                val fy = (float(coord.y) + (float(sy) + 0.5f) / float(ratioY)) / float(size.y)

                sum = sum + Fetch(int(floor(fx * float(extent.x))), int(floor(fy * float(extent.y))))
            }
        }

        target.Store(coord, sum / float(ratioX * ratioY))
    }
}
