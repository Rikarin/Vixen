package Vixen.Editor.TextureGraph.Shaders

// A constant. Doc 48 § 4.1's first source, and "the float4 every 'which node is at fault' bisection
// starts from".
//
// **Grey and colour are one port kind and grey promotes** (doc 48 § Part 4's first rule), so there is
// no second kernel for a constant grey: an author who wants one writes the same number into `red`,
// `green` and `blue`. The *format* — one channel or four — is a property of the image the plan
// declares, not of this kernel, which is why there is no `format` uniform here despite § 4.1's table
// naming one. `TexturePlan.Images[op.Output].Format` is the one place it is said.
//
// ⚠ **Four scalars rather than one `float4`, and that is a constraint of the evaluator rather than a
// preference.** `TexturePlanEvaluator.Uniforms` writes one `float` per block member, so a `float4`
// member would receive its x and three zeros — which is a valid-looking colour. Every kernel in this
// folder therefore declares scalars, and a plan carries one `TextureParameter` per scalar.

shader Uniform {
    /// The red channel, in the image's own units — linear, like everything inside a graph.
    var red: float = 0f

    var green: float = 0f

    var blue: float = 0f

    /// Opacity. One is what a source almost always wants; a graph that wanted a transparent constant
    /// asked for it deliberately.
    var alpha: float = 1f

    [Format("rgba16f")] var target: RWTexture2D<float4>

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        target.Store(coord, float4(red, green, blue, alpha))
    }
}
