package Vixen.Editor.TextureGraph.Shaders

// Hue, saturation and lightness — doc 48 § 4.2's `HSL`.
//
// ⚠ **The hue rotation is `Raven/Library/Material/ComputeColor.rvn:78`'s, transcribed rather than
// imported, and the duplication is forced by the compiler this assembly uses.** The evaluator calls
// `RavenEffectCompiler.FromSources([(name, source)])` with no `referencePaths`, so a kernel here
// binds against nothing but itself — `import Vixen.Shaders.Material` does not resolve. The
// alternative is passing the compiled `.rvnlib` into every variant, which is a build-order
// dependency from an editor assembly onto the shader library. See this folder's README.
//
// **It rotates the chroma plane in YIQ rather than converting to HSL and back.** Three dot products
// against a conversion, a rotation and a conversion back; it preserves luminance exactly and
// distorts very saturated colours slightly. That is the same trade the shader graph makes, and the
// two agreeing matters more than either being the textbook answer — an artist who matches a hue in
// one and sees it shift in the other has found a bug in this comment.
//
// **Saturation is around the colour's own Rec. 709 luminance and lightness is a lerp to black or
// white**, both clamped at zero afterwards, because a rotation of a saturated colour can leave a
// channel slightly negative and a negative written into a half-float survives every later op.

shader Hsl {
    var source: Texture2D

    /// How far to rotate the hue, in **turns**: 0.5 is opposite, 1 is a no-op.
    ///
    /// ⚠ Turns rather than degrees or radians, so that an exposed parameter sweeping 0…1 covers the
    /// wheel once — and so that a graph's "hue" slider needs no unit written beside it.
    var hue: float = 0f

    /// 0 is grey, 1 is unchanged, above 1 pushes.
    var saturation: float = 1f

    /// −1 is black, 0 is unchanged, 1 is white.
    var lightness: float = 0f

    [Format("rgba16f")] var target: RWTexture2D<float4>

    const val Tau: float = 6.28318530718f

    /// `ComputeColor.rvn:78`'s rotation, to the digit.
    func HueRotate(color: float3, radians: float): float3 {
        val c = cos(radians)
        val s = sin(radians)

        val luma = dot(color, float3(0.299f, 0.587f, 0.114f))
        val i = dot(color, float3(0.596f, -0.274f, -0.322f))
        val q = dot(color, float3(0.211f, -0.523f, 0.312f))

        val ri = i * c - q * s
        val rq = i * s + q * c

        return max(
            float3(
                luma + ri * 0.956f + rq * 0.621f,
                luma - ri * 0.272f - rq * 0.647f,
                luma - ri * 1.106f + rq * 1.703f
            ),
            float3(0f, 0f, 0f)
        )
    }

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        val extent = source.GetDimensions(0)
        val texel = source.Load(int3(clamp(coord.x, 0, extent.x - 1), clamp(coord.y, 0, extent.y - 1), 0))

        val rotated = HueRotate(float3(texel.x, texel.y, texel.z), hue * Tau)
        val luma = dot(rotated, float3(0.2126f, 0.7152f, 0.0722f))
        val saturated = lerp(float3(luma, luma, luma), rotated, float3(max(saturation, 0f), max(saturation, 0f), max(saturation, 0f)))

        // Toward white above zero and toward black below it, so that 0 is exactly the input and the
        // two directions are one parameter rather than two nodes.
        val amount = clamp(lightness, -1f, 1f)
        val toward = max(sign(amount), 0f)
        val mixed = lerp(saturated, float3(toward, toward, toward), float3(abs(amount), abs(amount), abs(amount)))
        val final = max(mixed, float3(0f, 0f, 0f))

        target.Store(coord, float4(final.x, final.y, final.z, texel.w))
    }
}
