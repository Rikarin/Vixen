package Vixen.Editor.TextureGraph.Shaders

// Doc 48 § 4.3's `Crop`: a rectangle of the source, onto the whole of the target.
//
// ⚠ **This is the one node whose output resolution is not its input's, and § D8's relative rule has
// to be answered here rather than inherited.** The answer this kernel takes is that **the rect is
// expressed in the source's own normalised space and the target's size is the plan's** — so the plan
// decides the resolution and the node decides what is in it. Cropping the top-left quarter onto an
// image with `LevelOffset` 1 is a 1:1 crop; cropping it onto a level-0 image is a crop and a 2×
// magnification, and both are things an artist asks for.
//
// ⚠ **What that arrangement cannot express, which is a finding about `TexturePlan` and not about
// this kernel:** `TextureImage` sizes an image only by a `LevelOffset`, a power of two away from the
// base. A crop to 37% of the width has no image to write into. Until the resolution model gains a
// way to say a size — [#619](https://github.com/Rikarin/Vixen/issues/619) is reworking exactly that
// model — a 1:1 crop is available at the power-of-two rects and nowhere else, and the alternative
// (a rect in absolute texels, ignoring the target's size) would silently leave the rest of the
// target unwritten, which is whatever the allocator left.
//
// **The closed forms.** A rect of (0, 0, 1, 1) onto a same-sized target is a copy, texel for texel.
// A rect of (0, 0, 0.5, 0.5) onto a half-sized target is exactly the source's top-left quadrant,
// texel for texel — which is the assertion that says the mapping is a crop and not a crop plus a
// half-texel drift, the error this node's arithmetic is actually prone to.

shader Crop {
    var source: Texture2D

    /// The rect's left edge, from 0 to 1 across the source.
    var rectX: float = 0f

    var rectY: float = 0f

    /// The rect's width, from 0 to 1.
    var rectW: float = 1f

    var rectH: float = 1f

    /// 0 point-samples, 1 interpolates. Point is exact where the rect lands on texel boundaries.
    var filter: int = 0

    [Format("rgba16f")] var target: RWTexture2D<float4>

    func Fetch(x: int, y: int): float4 {
        val extent = source.GetDimensions(0)

        return source.Load(int3(clamp(x, 0, extent.x - 1), clamp(y, 0, extent.y - 1), 0))
    }

    /// The source at a normalised position, under the chosen filter.
    func At(u: float, v: float): float4 {
        val extent = source.GetDimensions(0)
        val px = u * float(extent.x) - 0.5f
        val py = v * float(extent.y) - 0.5f

        if (filter == 0) {
            return Fetch(int(floor(px + 0.5f)), int(floor(py + 0.5f)))
        }

        val x0 = int(floor(px))
        val y0 = int(floor(py))
        val tx = px - float(x0)
        val ty = py - float(y0)

        val top = lerp(Fetch(x0, y0), Fetch(x0 + 1, y0), float4(tx, tx, tx, tx))
        val bottom = lerp(Fetch(x0, y0 + 1), Fetch(x0 + 1, y0 + 1), float4(tx, tx, tx, tx))

        return lerp(top, bottom, float4(ty, ty, ty, ty))
    }

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        // The output texel's centre, in the rect, in the source's normalised space.
        val u = rectX + (float(coord.x) + 0.5f) / float(size.x) * rectW
        val v = rectY + (float(coord.y) + 0.5f) / float(size.y) * rectH

        target.Store(coord, At(u, v))
    }
}
