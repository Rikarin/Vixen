<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <RootNamespace>Vixen.Editor.TextureGraph</RootNamespace>
        <Description>
            What the texture graph needs from the editor: resolving external images through a project
            and rasterising text through the interface's font stack. Everything else is in
            Vixen.TextureGraph, which references neither.
        </Description>
        <PackageTags>editor;texture;vixen</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Tools\Vixen.TextureGraph\Vixen.TextureGraph.csproj" />
        <ProjectReference Include="..\Vixen.Editor.Core\Vixen.Editor.Core.csproj" />
        <ProjectReference Include="..\Vixen.Editor.NodeGraph\Vixen.Editor.NodeGraph.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Editor.TextureGraph.Tests" />
    </ItemGroup>

</Project>
