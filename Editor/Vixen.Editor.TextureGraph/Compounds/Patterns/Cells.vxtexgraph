version: 1
name: Cells
nodes:
  - id: 1
    type: Source/Noise
    x: -1280
    y: 0
    values:
      Tiling: [1]
    texts: { Basis: Worley }
  - id: 2
    type: Colour/Grayscale
    x: -960
    y: -200
    values:
      Weight R: [0]
      Weight G: [1]
      Weight B: [0]
    texts: {}
  - id: 3
    type: Colour/Grayscale
    x: -960
    y: 0
    values:
      Weight R: [1]
      Weight G: [0]
      Weight B: [0]
    texts: {}
  - id: 4
    type: Colour/Blend
    x: -640
    y: -100
    values: {}
    texts:
      Mode: Subtract
      Coverage: Over
  - id: 5
    type: Colour/Levels
    x: -320
    y: -100
    values: {}
    texts:
      '=Input White': 0.02f + edge * 0.4f
  - id: 6
    type: Colour/Grayscale
    x: -960
    y: 240
    values:
      Weight R: [0]
      Weight G: [0]
      Weight B: [1]
    texts: {}
  - id: 7
    type: Colour/Blend
    x: 0
    y: 0
    values: {}
    texts:
      Mode: Multiply
      Coverage: Over
      '=Opacity': variation
  - id: 8
    type: Sub-graph/Output
    x: 320
    y: 0
    values: {}
    texts: {}
  - id: 9
    type: Sub-graph/Input
    x: -1600
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 9, fromPort: Cells, toNode: 1, toPort: Scale }
  - { fromNode: 1, fromPort: Out, toNode: 2, toPort: Input }
  - { fromNode: 1, fromPort: Out, toNode: 3, toPort: Input }
  - { fromNode: 2, fromPort: Out, toNode: 4, toPort: Background }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Foreground }
  - { fromNode: 4, fromPort: Out, toNode: 5, toPort: Input }
  - { fromNode: 1, fromPort: Out, toNode: 6, toPort: Input }
  - { fromNode: 5, fromPort: Out, toNode: 7, toPort: Background }
  - { fromNode: 6, fromPort: Out, toNode: 7, toPort: Foreground }
  - { fromNode: 7, fromPort: Out, toNode: 8, toPort: Out }
groups: []
comments: []
interface:
  - name: Cells
    direction: Input
    kind: Float
    default: [8]
    summary: How many cells across the image.
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: The cells, as a height — bright inside, dark along every border, one tone per cell.
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1' }
parameters:
  - name: edge
    default: '0.35'
    summary: How wide the joint between two cells is.
    kind: Float
    minimum: 0
    maximum: 1
    group: Cells
  - name: variation
    default: '0.6'
    summary: How much one cell's tone differs from its neighbour's.
    kind: Float
    minimum: 0
    maximum: 1
    group: Cells
