<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.VfxGraph</RootNamespace>
        <Description>
            The VFX graph: spawner, initializer, updater and output blocks over the reusable
            node-graph framework, compiling to a VfxCompiledGraph the CPU simulation runs and — from
            the same array of operations, by construction — the Raven compute shader a device runs.
        </Description>
        <PackageTags>editor;vfx;node-graph;particles;raven;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- A node's ports are its fields. See Vixen.Editor.ShaderGraph's csproj for the argument. -->
        <NoWarn>$(NoWarn);CA1051</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Editor.NodeGraph\Vixen.Editor.NodeGraph.csproj" />

        <!--
          The runtime, because the artefact *is* a VfxCompiledGraph. There is no editor-side model of
          an effect to keep in step with the runtime's one: the graph compiles straight to the thing
          that runs, which is also what makes the GPU half one method call.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Vfx\Vixen.Vfx.csproj" />

        <ProjectReference Include="..\Vixen.Editor.NodeGraph.Generator\Vixen.Editor.NodeGraph.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Editor.VfxGraph.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <!--
            #821's ratchet. The TOOLING profile in `Directory.Build.props` sets this false for all of
            `Editor/**`, `Tools/**` and `Raven/**`, so no `<see cref>` under any of them was ever
            checked — ask what that gate printed on the day it did not run: `0 Warning(s)`. CS1591
            and CS1573 stay suppressed: "this public member has no comment" is a question about a
            packaged API surface and is not what this is for; the rules that catch a *lie* are.
            Measured before flipping, and every diagnostic it reported is fixed in the same commit.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
