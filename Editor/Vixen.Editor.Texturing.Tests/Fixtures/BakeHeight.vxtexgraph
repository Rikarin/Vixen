# A graph whose outputs include a height field, which `BakeRoute.vxtexgraph` deliberately does not
# have — its file list is asserted exactly, so adding a fourth Output there would move a neighbouring
# test's expectation rather than add a case.
#
# ⚠ The height source is a checker rather than a constant. A parallax march over a flat field
# displaces nothing, so a fixture that wrote 0.5 everywhere would bake a material carrying a feature
# with a map that cannot be told from an absent one.
version: 1
name: Bake Height
nodes:
  - id: 1
    type: Source/Checker
    x: 0
    y: 0
    values: { Scale X: [4], Scale Y: [4] }
    texts: {}
  - id: 2
    type: Output/Output
    x: 320
    y: 0
    values: {}
    texts: { Usage: baseColor }
  - id: 3
    type: Source/Checker
    x: 0
    y: 160
    values: { Scale X: [8], Scale Y: [8] }
    texts: {}
  - id: 4
    type: Output/Output
    x: 320
    y: 160
    values: {}
    texts: { Usage: height }
edges:
  - { fromNode: 1, fromPort: Out, toNode: 2, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Input }
groups: []
comments: []
settings: {}
parameters: []
