<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.Texturing.Tests</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Editor.Ui.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <!-- The doc-comment rule parses C#; nothing here loads a workspace or a compilation. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />

        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!--
            ⚠ The `CheckArchitecture` rule that asserts doc 48's exit criterion 10, compiled into this
            assembly so that its answer can be read without running a Nuke target. It is the same file
            the gate compiles — a second caller, not a second transcription — and `PluginReferenceRuleTests`
            runs it over this repository tree and over synthetic fixtures that make it fire.
        -->
        <Compile Include="..\..\build\PluginReferenceRule.cs" Link="PluginReferenceRule.cs" />

        <!--
            ⚠ And the doc-comment rule, for the same reason one level along. #866's two stapled
            comments survived a green build, a green suite and both `dotnet format` passes, so the
            rule that catches them is new code with no history of ever having produced an answer —
            which is the state `PluginReferenceRule` was in when it shipped. Linked here, it is
            measured against this repository's own 5 000 files and against the two stapleings
            themselves, without running a Nuke target.
        -->
        <Compile Include="..\..\build\DocCommentRule.cs" Link="DocCommentRule.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Editor.Texturing\Vixen.Editor.Texturing.csproj" />

        <!--
            ⚠ The Null backend, and only so that `TexturePreview.Blocking`'s other branch is reachable
            from a test. Nothing here dispatches anything: the whole point of these tests is what a
            plugin can and cannot get hold of, and a device published into `PluginServices` by the
            test is the evidence that the branch which needs one is not dead code waiting on a host
            change nobody has made.
        -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Null\Vixen.Graphics.Null.csproj" />

        <!--
            ⚠ And the real backend, because the preview suite dispatches a kernel and reads the
            texels back. The Null device would make every one of those assertions a claim that a
            black image equals a black image — `TextureKernelHarness` says the same thing one
            assembly along. The device tests skip loudly without an adapter, and
            VIXEN_REQUIRE_VULKAN=1 turns the skip into a failure.
        -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Vulkan\Vixen.Graphics.Vulkan.csproj" />
    </ItemGroup>
</Project>
