<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Ui.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="__screenshots__\**" CopyToOutputDirectory="PreserveNewest" />

        <!--
            ⚠ **Fixtures for the tests, and deliberately not resources of the product.** The editor
            used to embed its tokens and its markup so that a startup bootstrap could scan them; the
            build step does that at build time now and the assembly ships neither. What the tests
            still need is the *inputs*, so they can ask the narrower question the generated sheet
            cannot answer on its own — is every class name somebody wrote in a `class` attribute a
            utility, or is one of them a typo that silently does nothing?

            Copied rather than embedded, because a fixture that has to be fetched through a manifest
            is the shape this change was getting rid of.
        -->
        <None Include="..\Vixen.Editor.Ui\Theming\vixen.ui.yaml"
              Link="__fixtures__\vixen.ui.yaml"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\Vixen.Editor.Ui\**\*.vxml"
              LinkBase="__fixtures__\markup"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Editor.Ui\Vixen.Editor.Ui.csproj" />

        <!--
            What `EditorChromeVisualTests` renders through. A theme is a claim about pictures, and
            the only way to hold one to it is to take one.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Testing\Vixen.Ui.Testing.csproj" />
    </ItemGroup>

</Project>
