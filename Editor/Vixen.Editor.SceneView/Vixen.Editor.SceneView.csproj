<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.SceneView</RootNamespace>
        <Description>
            The editor's viewport: an orbit/fly camera with bookmarks and axis views, transform gizmos
            with local/world/parent/screen spaces and snapping, a picking stage that reads object ids
            back off the GPU, an adaptive grid, debug view modes as compositor swaps, and play-in-editor
            in both the in-process and out-of-process topologies.
        </Description>
        <PackageTags>editor;viewport;gizmo;picking;camera;play-mode;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- A gizmo drag is an IEditorCommand and the selection is the project's. -->
        <ProjectReference Include="..\Vixen.Editor.Core\Vixen.Editor.Core.csproj" />

        <!--
            The Viewport control, which says where and how big in render pixels and reports the input
            inside it in the coordinates a camera controller wants — and deliberately knows nothing
            about what is drawn in it. This assembly is the other half of that bargain.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Controls.Advanced\Vixen.Ui.Controls.Advanced.csproj" />

        <!--
            RenderView, RenderStage and the compositor. A debug view mode is a different compositor
            tree rather than a different build of the renderer, which is the payoff doc 06 predicted
            for making the compositor data.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering\Vixen.Rendering.csproj" />

        <!--
            The mesh kernel of docs/plan/24 § D1. Under Core/ and referencing nothing but the maths,
            so what this assembly adds is the two copies the kernel deliberately does not make: into
            `MeshData` for the renderer, and into the scene file's flat lists for the format.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Geometry\Vixen.Geometry.csproj" />

        <!--
            The scene is an ECS world and a transform hierarchy, and play-in-editor's in-process
            topology is a snapshot of one. Vixen.Ecs arrives with it.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Engine\Vixen.Engine.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The scene's authoring format is YAML, read and written by the same binder a material and
            a settings asset go through — see SceneFile for why the authoring form is the readable
            one and the runtime's is not this.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Yaml\Vixen.Core.Yaml.csproj" />

        <!--
            Analyzers do not flow transitively through a ProjectReference, so an assembly declaring
            [DataContract] types of its own has to name both generators: the descriptors come from
            Vixen.Core.Reflection.Generator and the serializers they point at from
            Vixen.Core.Serialization.Generator.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Editor.SceneView.Tests" />
    </ItemGroup>

</Project>
