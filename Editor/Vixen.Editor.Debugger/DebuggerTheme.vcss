/* SPDX-FileCopyrightText: Copyright (c) Rikarin
   SPDX-License-Identifier: Apache-2.0

   The debugger's call stack, breakpoint list and state pane, as a stylesheet on disk.

   ⚠ **The smallest sheet in the editor, and most of what it used to say now belongs to a
   control.** The state pane is a `KeyValueList`, so the two columns, the heading class and the
   pooling loop that were once styled here are the control's job — the note in this file about a
   class rather than a tag is what is left of that move.

   `DebuggerTheme.Utilities` is the generated utility sheet and stays a build-step constant. */

/* ⚠ **The ladder, restated.** `ControlTheme.vcss` explains it; the statement has to be here too
   because `CascadeLayers.Declare` fixes a layer's position the first time anything names it, so the
   order belongs to whichever sheet a document loaded first rather than to any one file. Everything
   below is `components` — a look, peer to every other look, engine or editor — which is what lets a
   `@layer utilities` class beat it and what keeps its own arguments settled by specificity and
   source order exactly as they were. */

@layer base, components, utilities;

@layer components {

debugger-status, remote-status, network-status {
    padding: 3px 8px;
    color: var(--text-muted);
    font-size: 0.85em;
    flex-shrink: 0;
}

/* ── The frame debugger ─────────────────────────────────────────────────
   Tree on the left, state on the right. A state pane under the tree would
   put the two things somebody is comparing a scroll apart. */
debugger-body, remote-body {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0px;
    min-height: 0px;
    gap: 0px;
}

debugger-body > tree-view, remote-body > tree-view {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
}

/* ⚠ A class rather than a tag, because the state pane is a `KeyValueList` now and its tag is
   the control's. What is left here is the pane's place in the debugger's layout — how wide
   it is and which edge it is against — and the six rules that used to draw a row are gone:
   two columns, a heading class and a pooling loop were the control's job and never this
   file's. Its own `min-width: 180px` is what keeps the halves readable in a narrow dock;
   below that the key column clips, which is the control's answer and not a new one. */
.debugger-state, remote-counters {
    width: 44%;
    min-width: 180px;
    flex-shrink: 0;
    flex-direction: column;
    overflow: hidden;
    border-left-width: 1px;
    border-color: var(--border);
}

/* The one thing the shared row does not say: a group heading in a capture has air above it,
   because the groups are what somebody scans the pane for. */
.debugger-state key-value-row.heading { margin-top: 6px; }

/* ── The remote inspector ───────────────────────────────────────────── */
remote-counter {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 2px 8px;
    min-height: 20px;
}

counter-label { flex-grow: 1; color: var(--text-muted); overflow: hidden; }
counter-value { width: 90px; flex-shrink: 0; text-align: right; }

remote-write {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    flex-shrink: 0;
    border-top-width: 1px;
    border-color: var(--border);
}

/* ⚠ `textbox`, not `text-box` — `TextField.TagName` is one word. The two boxes the remote
   inspector writes with are `TextBox`es, so the hyphen meant the member and value fields never
   took the width the row had for them. */
remote-write > textbox { flex-grow: 1; min-width: 60px; }

/* ── The device manager ─────────────────────────────────────────────── */
device-manager > data-grid { flex-grow: 1; flex-basis: 0px; min-height: 0px; }

/* ── The network panel ──────────────────────────────────────────────────
   Five columns of the same shape, and a packet pane under them. Every row
   is a name, a cost, a bar and a mean — four fixed columns rather than a
   `KeyValueList`, which is deliberately two and whose own remarks argue
   that a generic third slot is a slot with no meaning. The summary above
   them *is* two columns and is a `KeyValueList`. */
network-heading {
    padding: 8px 8px 2px 8px;
    color: var(--text-muted);
    font-size: 0.85em;
    letter-spacing: 0.04em;
}

network-table, network-packet { flex-direction: column; gap: 0px; }

network-row, network-record {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 2px 8px;
    min-height: 20px;
}

/* The name grows and clips; every column beside it is fixed, because a
   column of magnitudes is read by comparing digit positions and a ragged
   one cannot be. `NetworkTable.Prefix` is what keeps the shared namespace
   out of the width this leaves. */
network-name { flex-grow: 1; min-width: 60px; overflow: hidden; }
network-cost { width: 130px; flex-shrink: 0; text-align: right; }
network-mean { width: 110px; flex-shrink: 0; text-align: right; color: var(--text-muted); font-size: 0.85em; }

/* `min-width` is overridden because the control library floors a progress
   bar at 80px for a dialog, and this is a column. The same three lines the
   statistics panel needed, for the same reason. */
network-row progress-bar {
    width: 90px;
    min-width: 0px;
    flex-shrink: 0;
    --track-color: var(--surface-sunken);
    --fill-color: var(--accent);
}

key-value-row progress-bar { --track-color: var(--surface-sunken); --fill-color: var(--accent); }

/* ── The link graph ──────────────────────────────────────────────────────
   Three lanes of the same shape, each a head and a strip. The head reuses
   the row's own three columns — name, cost, mean — so a lane's numbers line
   up with the tables above it rather than starting a fourth alignment. */
network-graph { flex-direction: column; gap: 0px; border-top-width: 1px; border-color: var(--border); margin-top: 6px; }

network-lane { flex-direction: column; gap: 0px; padding: 0px 8px 6px 8px; }
network-lane-head { flex-direction: row; align-items: center; gap: 8px; min-height: 20px; }

/* Two things this rule deliberately does not say.

   Its **height** is an inline style instead: it is `NetworkTrend.PlotHeight`,
   and a bar's height is a fraction of that same constant. Two places saying
   32px is one of them being wrong later.

   And there is **no gap**, which at this density is the readable choice
   rather than the lazy one — a hundred and nineteen one-pixel gaps in a
   docked panel is most of the width. Touching bars read as a silhouette,
   which is what a strip of a hundred and twenty samples is for, and the
   sweep is still a coloured sliver in it. */
network-plot {
    flex-direction: row;
    align-items: flex-end;
    gap: 0px;
    overflow: hidden;
    background-color: var(--surface-sunken);
}

/* Every bar the same width, whatever the dock is: the strip is a hundred
   and twenty slots and the reader is comparing heights, so a fixed width
   would either clip the past or leave the lane half empty. */
network-sample { flex-grow: 1; flex-basis: 0px; min-width: 0px; background-color: var(--accent); }

/* The sweep. The ring does not scroll, so without this there is nothing on
   the strip that says which bar is now — and a monitor trace with no write
   head is a chart whose left edge means nothing. */
network-sample.newest { background-color: var(--warning); }

/* ── The packet pane ─────────────────────────────────────────────────── */
network-packet { border-top-width: 1px; border-color: var(--border); margin-top: 6px; }

network-slot { width: 28px; flex-shrink: 0; text-align: right; color: var(--text-muted); font-size: 0.85em; }
network-object { width: 90px; flex-shrink: 0; color: var(--text-muted); }
network-baseline { width: 90px; flex-shrink: 0; font-size: 0.85em; }

/* A difference is the ordinary case and a whole record is the one worth
   noticing: a snapshot full of whole records is a snapshot whose baselines
   are being lost, which is the bandwidth bug this pane exists to show. */
network-baseline.whole { color: var(--warning); }

/* Truncated is not a detail. What was decoded before the reader stopped is
   still shown, so the line saying the rest was unread is the only thing
   between that and a pane that under-reports the packet. */
network-status.truncated { color: var(--danger); }

}
