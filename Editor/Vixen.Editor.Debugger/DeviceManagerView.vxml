<!--
    SPDX-FileCopyrightText: Copyright (c) Rikarin
    SPDX-License-Identifier: Apache-2.0

    Doc 36 § F7 wave 1b.

    ⚠ **`@inherits`, because `DiagnosticsModule` writes `panel.Add<DeviceManagerView>()` and both
    `DiagnosticsPanelTests` and `BuildSettingsTests` read `view.Devices.Items` off what
    `Descendants(...).OfType<T>()` found.** A `Component` is not in the element tree at all.

    ⚠ **The grid stays imperative and it should.** `DataGrid.SetItems` is a method rather than a
    property, its columns are `Func<object, object?>` projections, and there is no tag for a column
    — so no attribute can bind any of it. What markup takes over is the part that *is* expressible:
    the strip, the status line, and the two greyed buttons, which between them were the whole of
    `Restate`.

    ⚠ **`Restate` did three unrelated things and one of them was a bug.** It refilled the grid, set
    the two `Disabled` flags and wrote the status line — and it ran on every selection change, so
    clicking a device called `SetItems`, which clears `DataGrid.selection`, and the row somebody had
    just clicked lost its highlight while the buttons lit up for it. Measured before the port:
    `Select(0)` left `Devices.Selection.Count == 0` with `manager.Selected` set. Splitting the three
    apart is what fixes it: the grid follows `DeviceManager.Changed`, which a selection has never
    raised, and the buttons follow the selection signal.

    ⚠ **`CanDeploy` is signal-backed and its `if (DeployButton is not null)` guard is gone.** That
    guard existed because the property's setter had to re-run `Restate` by hand, and it had to check
    for a panel that had not built its buttons yet. A binding needs neither: the host assigns the
    delegate after `Add<DeviceManagerView>()` returns and the effect re-runs itself.
-->
@component DeviceManagerView
@namespace Vixen.Editor.Debugger
@inherits Vixen.Ui.Controls.Control
@tag device-manager
@using System.Globalization
@using Vixen.Ui
@using Vixen.Ui.Controls
@using Vixen.Ui.Controls.Advanced
@using Vixen.Ui.Reactive

<debugger-toolbar ref="@Toolbar">
    <Button ref="@Discover" Size="Small" Label="Discover" on:click="@Rediscover" />

    <Button ref="@DeployButton"
            Size="Small"
            Variant="Primary"
            Label="Deploy"
            Disabled="@(Chosen is null || Refusal(Chosen) is not null)"
            on:click="@AskToDeploy" />

    <!--
        Only a device that says where to attach, because "Attach" against a device with no endpoint
        is a button whose failure would be a silent no-op.
    -->
    <Button ref="@AttachButton"
            Size="Small"
            Variant="Subtle"
            Label="Attach"
            Disabled="@(Chosen is not { Endpoint: not null })"
            on:click="@AskToAttach" />
</debugger-toolbar>

<debugger-status ref="@Status">@Sentence()</debugger-status>

<DataGrid ref="@Devices" />

@code {
    /// <summary>The manager, as a signal so that <see cref="Show" /> re-reads the whole panel.</summary>
    /// <remarks>
    ///     ⚠ <b>A signal over the manager <i>as well as</i> signals inside it, and both are load
    ///     bearing.</b> This one says a different manager arrived; the ones on
    ///     <see cref="DeviceManager" /> say the same manager found something. A panel holding a plain
    ///     field would draw "No device providers." for ever, and a panel that only held this one
    ///     would never notice a discovery.
    /// </remarks>
    readonly Signal<DeviceManager?> manager = new(null);

    /// <summary>Why a device cannot be deployed to, as the buttons and the status line read it.</summary>
    readonly Signal<Func<DeviceEntry, string?>?> canDeploy = new(null);

    Action<DeviceManager>? onChanged;

    /// <inheritdoc />
    protected override bool AcceptsFocus => false;

    /// <summary>The strip along the top.</summary>
    public UiElement Toolbar { get; private set; } = null!;

    /// <summary>Asks every provider what it can see.</summary>
    public Button Discover { get; private set; } = null!;

    /// <summary>Builds and installs onto the selected device.</summary>
    public Button DeployButton { get; private set; } = null!;

    /// <summary>Points the remote inspector at the selected device.</summary>
    public Button AttachButton { get; private set; } = null!;

    /// <summary>What went wrong, or what was found.</summary>
    public UiElement Status { get; private set; } = null!;

    /// <summary>The devices.</summary>
    public DataGrid Devices { get; private set; } = null!;

    /// <summary>Raised when somebody asks to attach to a device that is listening.</summary>
    /// <remarks>
    ///     An event rather than a call into <see cref="RemoteInspectorClient" />, because which
    ///     transport reaches an endpoint is the application's choice — a phone over USB is a
    ///     forwarded port and a machine on the LAN is a UDP socket, and this panel must not be the
    ///     place that decides.
    /// </remarks>
    public event Action<DeviceManagerView, DeviceEntry>? AttachRequested;

    /// <summary>Raised when somebody asks for a build to be put on a device.</summary>
    /// <inheritdoc cref="AttachRequested" select="remarks" />
    public event Action<DeviceManagerView, DeviceEntry>? DeployRequested;

    /// <summary>Why a device cannot be deployed to, or <see langword="null" /> when it can.</summary>
    /// <remarks>
    ///     <para>
    ///         A sentence rather than a predicate, and unset means "nothing can be deployed to" rather
    ///         than "everything can". A panel opened by a test or by a host with no build settings
    ///         behind it must not offer a button that would silently do nothing, and the reason is
    ///         what the status line shows so that the greying is never a mystery.
    ///     </para>
    ///     <para>
    ///         Pulled rather than pushed, like every other source this assembly's panels read: the
    ///         factory that sets it runs again on every reopen, and an answer captured once would be
    ///         one from a build target the user has since changed.
    ///     </para>
    ///     <para>
    ///         ⚠ <b>Signal-backed, which is what let the setter's <c>if (DeployButton is not null)</c>
    ///         guard go.</b> That guard was there because the setter had to re-run <c>Restate</c> by
    ///         hand and had to cope with a panel whose buttons did not exist yet; the binding re-runs
    ///         itself and does not care when the assignment lands.
    ///     </para>
    /// </remarks>
    public Func<DeviceEntry, string?>? CanDeploy {
        get => canDeploy.Value;
        set => canDeploy.Value = value;
    }

    /// <summary>Points the panel at a manager.</summary>
    /// <param name="devices">The manager.</param>
    /// <exception cref="ArgumentNullException"><paramref name="devices" /> is null.</exception>
    public void Show(DeviceManager devices) {
        ArgumentNullException.ThrowIfNull(devices);

        Release();

        manager.Value = devices;
        onChanged ??= _ => Fill();

        devices.Changed += onChanged;
        Fill();
    }

    /// <summary>Which device the manager has selected, as the markup reads it.</summary>
    DeviceEntry? Chosen => manager.Value?.Selected;

    /// <summary>
    ///     Puts the manager's devices in the grid.
    /// </summary>
    /// <remarks>
    ///     ⚠ <b>Off <see cref="DeviceManager.Changed" /> and off nothing else, which is the fix.</b>
    ///     The C# refilled the grid from a <c>Restate</c> that also ran on every selection change, and
    ///     <see cref="DataGrid.SetItems" /> clears the selection — so the row somebody clicked lost its
    ///     highlight in the same frame it gained it. A selection has never raised <c>Changed</c>, so
    ///     hanging the refill on the event is both simpler and correct.
    /// </remarks>
    void Fill() {
        if (manager.Value is { } devices) {
            Devices.SetItems(devices.Devices.Cast<object>());
        }
    }

    void Rediscover() => manager.Value?.Discover();

    void AskToDeploy() {
        if (Chosen is { } device && Refusal(device) is null) {
            DeployRequested?.Invoke(this, device);
        }
    }

    void AskToAttach() {
        if (Chosen is { Endpoint: not null } device) {
            AttachRequested?.Invoke(this, device);
        }
    }

    /// <summary>What the panel has to say about what it is showing.</summary>
    /// <remarks>
    ///     ⚠ The refusal outranks the count, because it is the sentence about the thing somebody is
    ///     looking at. "One device from one provider" beside a greyed Deploy button is a panel that
    ///     answers a question nobody asked and withholds the one they did — and with nothing chosen
    ///     there is no such question, so the count is what a freshly-opened panel says.
    /// </remarks>
    string Sentence() {
        if (manager.Value is not { } devices) {
            return "No device providers.";
        }

        if (devices.Problems.Count > 0) {
            return string.Join(" · ", devices.Problems);
        }

        if (devices.Selected is { } chosen && Refusal(chosen) is { } refusal) {
            return refusal;
        }

        return string.Create(
            CultureInfo.InvariantCulture,
            $"{devices.Devices.Count:N0} device(s) from {devices.Providers.Count:N0} provider(s)."
        );
    }

    /// <summary>Why the selected device cannot be deployed to, or <see langword="null" />.</summary>
    string? Refusal(DeviceEntry device) =>
        device.Status is DeviceStatus.Deploying
            ? "A build is already on its way to this device."
            : CanDeploy is { } ask
                ? ask(device)
                : "Nothing here knows how to build for a device yet.";

    /// <summary>
    ///     The grid's columns and its selection handler, once <c>Devices</c> exists.
    /// </summary>
    /// <remarks>
    ///     ⚠ <b>Idempotent, because <c>OnComposed</c> is emitted inside the build and a hot reload
    ///     re-enters it.</b> After a rebuild every <c>ref</c> points at a new element, so the grid is
    ///     a fresh one with no columns and adding them is right; what is <i>not</i> right is leaving
    ///     the previous manager subscription behind, which is what <c>Release</c> is for.
    /// </remarks>
    partial void OnComposed() {
        Devices.AddColumn("Device", item => ((DeviceEntry) item).Name).Width = 180f;
        Devices.AddColumn("Kind", item => ((DeviceEntry) item).Kind.ToString());
        Devices.AddColumn("Platform", item => ((DeviceEntry) item).Platform).Width = 200f;
        Devices.AddColumn("Status", item => ((DeviceEntry) item).Status.ToString());
        Devices.AddColumn("Endpoint", item => ((DeviceEntry) item).Endpoint ?? "—").Width = 160f;

        Devices.SelectionChanged += Chose;

        // A rebuild keeps the manager and has to re-fill the new grid with it.
        Fill();
    }

    partial void OnUnmounted() {
        Release();
    }

    void Chose(DataGrid grid) {
        if (manager.Value is not { } devices) {
            return;
        }

        foreach (var index in grid.Selection) {
            if (index >= 0 && index < grid.Items.Count) {
                devices.Selected = (DeviceEntry) grid.Items[index];
                break;
            }
        }
    }

    void Release() {
        if (manager.Value is { } devices && onChanged is not null) {
            devices.Changed -= onChanged;
        }
    }
}
