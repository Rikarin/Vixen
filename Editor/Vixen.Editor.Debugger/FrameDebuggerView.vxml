<!--
    SPDX-FileCopyrightText: Copyright (c) Rikarin
    SPDX-License-Identifier: Apache-2.0

    Doc 36 § F7 — the last panel of wave 1a, which waited on `ref`.

    ⚠ **`@inherits`, because the panel's public surface *is* its parts.** `DiagnosticsModule` writes
    `panel.Add<FrameDebuggerView>()`, which needs `T : UiElement, new()`, and
    `DiagnosticsPanelTests` reads `view.CaptureButton.Disabled` off what
    `Descendants(...).OfType<T>()` found. A `Component` satisfies neither.

    ⚠ **Two parts stay imperative and they are the two that should.** A `TreeView` is filled by
    adding `TreeNode`s to a root and expanding them — there is no tag for a node, and inventing one
    would be a second tree model — so `Rebuild` is unchanged and `ref` is what reaches it. That is
    exactly the affordance this panel was blocked on.

    ⚠ **The state pane, by contrast, is now a `@for` and the pooling loop is gone.** `KeyValueList`
    still has `Row`/`Trim` for `FlameChartView`'s kind of caller; here a keyed loop over an
    immutable snapshot is the same economy said once, and a row whose value is unchanged keeps its
    element. `Slot` is in the key for `GpuBar`'s reason — two descriptor slots can legitimately
    produce the same three strings, and two equal keys in one loop is not something
    `BuildContext.For` can reconcile.

    ⚠ **`Source` and `Unavailable` are signal-backed, and that fixes a real bug rather than
    translating one.** Both are assigned by `DiagnosticsModule` *after* `panel.Add<T>()` returns, so
    the C#'s `Restate()` in `OnCreated` read them before they existed: `CaptureButton.Disabled` was
    computed once against a null `Source` and nothing recomputed it until the first `Show` — which
    cannot happen, because taking a capture is what the button does. A host that supplied a capture
    source got a permanently greyed Capture button. `GpuTimelineView.Unavailable` is the same
    arrangement and its remarks make the same argument.
-->
@component FrameDebuggerView
@namespace Vixen.Editor.Debugger
@inherits Vixen.Ui.Controls.Control
@tag frame-debugger
@using System.Collections.Immutable
@using System.Globalization
@using Vixen.Ui
@using Vixen.Ui.Controls
@using Vixen.Ui.Controls.Advanced
@using Vixen.Ui.Reactive

<debugger-toolbar ref="@Toolbar">
    <Button ref="@CaptureButton"
            Size="Small"
            Variant="Primary"
            Label="Capture Frame"
            Disabled="@(Source is null)"
            on:click="@Take" />

    <Button ref="@Previous"
            Size="Small"
            Variant="Subtle"
            Label="◀ Draw"
            Disabled="@(Backwards is null)"
            on:click="@StepBack" />

    <Button ref="@Next"
            Size="Small"
            Variant="Subtle"
            Label="Draw ▶"
            Disabled="@(Forwards is null)"
            on:click="@StepOn" />
</debugger-toolbar>

<debugger-status ref="@Status">@Sentence()</debugger-status>

<debugger-body>
    <TreeView ref="@Tree" />

    <KeyValueList ref="@StatePane" class="debugger-state">
        @for (var row in Bound) {
            <KeyValueRow key="@row" Key="@row.Key" Value="@row.Value" IsHeading="@row.IsHeading" />
        }
    </KeyValueList>
</debugger-body>

@code {
    /// <summary>What is on screen, as one value the whole panel is a function of.</summary>
    /// <remarks>
    ///     ⚠ <b>A snapshot signal rather than one signal per thing the markup reads.</b> A
    ///     <see cref="FrameCapture" /> is immutable and is replaced whole by <see cref="Show" />, so
    ///     assigning it <i>is</i> the notification. There is nothing here that mutates in place, which
    ///     is what would have made a counter tempting and is exactly why one is not needed.
    /// </remarks>
    readonly Signal<FrameCapture> capture = new(FrameCapture.Empty);

    /// <summary>Which call the state pane is replayed to.</summary>
    readonly Signal<int> selected = new(0);

    readonly Signal<Func<FrameCapture>?> source = new(null);
    readonly Signal<string?> unavailable = new(null);

    /// <inheritdoc />
    protected override bool AcceptsFocus => false;

    /// <summary>The strip along the top.</summary>
    public UiElement Toolbar { get; private set; } = null!;

    /// <summary>What takes a capture, when the host has given it something to take one with.</summary>
    public Button CaptureButton { get; private set; } = null!;

    /// <summary>Steps back one draw.</summary>
    public Button Previous { get; private set; } = null!;

    /// <summary>Steps forward one draw.</summary>
    public Button Next { get; private set; } = null!;

    /// <summary>What the capture holds, and where in it the selection is.</summary>
    public UiElement Status { get; private set; } = null!;

    /// <summary>The stream, as passes and groups.</summary>
    public TreeView Tree { get; private set; } = null!;

    /// <summary>What is bound at the selected call.</summary>
    /// <remarks>
    ///     ⚠ <b>A <see cref="KeyValueList" /> rather than the hand-rolled pair of elements this used
    ///     to build.</b> The pooling loop, the two columns and the heading-versus-row class swap were
    ///     all here in miniature and are all the control's now; what is left is the part that is
    ///     about a graphics capture. The rows are a keyed <c>@for</c> rather than
    ///     <c>Row</c>/<c>Trim</c>, which is the same reuse expressed as data.
    /// </remarks>
    public KeyValueList StatePane { get; private set; } = null!;

    /// <summary>What the capture is taken with, or <see langword="null" /> when nothing can.</summary>
    /// <remarks>
    ///     <para>
    ///         A delegate rather than a device, because what a capture is <i>of</i> is the host's
    ///         arbitration — the editor's own frame, or a running game's — and this assembly deliberately
    ///         does not know which.
    ///     </para>
    ///     <para>
    ///         ⚠ <b>Signal-backed, and the property is the same property it was.</b> A host assigns
    ///         this after <c>panel.Add&lt;FrameDebuggerView&gt;()</c> has returned, so a plain field
    ///         left the Capture button greyed for the life of the panel: its state was computed once,
    ///         in <c>OnCreated</c>, and the only thing that recomputed it was a capture the button is
    ///         what takes. Making the backing store a signal is what keeps every caller unchanged.
    ///     </para>
    /// </remarks>
    public Func<FrameCapture>? Source {
        get => source.Value;
        set => source.Value = value;
    }

    /// <summary>Why a capture cannot be taken, shown when <see cref="Source" /> is null.</summary>
    /// <inheritdoc cref="Source" select="remarks/para[2]" />
    public string? Unavailable {
        get => unavailable.Value;
        set => unavailable.Value = value;
    }

    /// <summary>What it is showing.</summary>
    public FrameCapture Capture => capture.Value;

    /// <summary>Which call the state pane is replayed to.</summary>
    public int Sequence => selected.Value;

    /// <summary>Takes a fresh capture, if there is anything to take one with.</summary>
    public void Take() {
        if (Source?.Invoke() is { } taken) {
            Show(taken);
        }
    }

    /// <summary>Shows a capture somebody else took.</summary>
    /// <param name="frame">The capture.</param>
    /// <exception cref="ArgumentNullException"><paramref name="frame" /> is null.</exception>
    public void Show(FrameCapture frame) {
        ArgumentNullException.ThrowIfNull(frame);

        capture.Value = frame;
        selected.Value = frame.Work.Count > 0 ? frame.Work[0] : 0;

        Rebuild();
    }

    /// <summary>Moves the selection to a call.</summary>
    /// <param name="sequence">Which call. Out-of-range values clamp.</param>
    public void StepTo(int sequence) {
        var frame = capture.Value;
        selected.Value = frame.IsEmpty ? 0 : Math.Clamp(sequence, 0, frame.Commands.Count - 1);
    }

    /// <summary>The state pane's rows, headings included, as immutable data the markup walks.</summary>
    /// <remarks>
    ///     ⚠ <b>Derived on read rather than kept on a signal of its own.</b> Both inputs are already
    ///     signals and the loop reads them here, which is what puts it in the dependency graph; a
    ///     third signal written from a <c>Restate</c> would be a copy of a value that is a pure
    ///     function of two others.
    /// </remarks>
    ImmutableArray<StatePaneRow> Bound {
        get {
            var rows = ImmutableArray.CreateBuilder<StatePaneRow>();
            string? group = null;

            foreach (var row in capture.Value.StateAt(selected.Value).Rows()) {
                if (!string.Equals(group, row.Group, StringComparison.Ordinal)) {
                    group = row.Group;
                    rows.Add(new StatePaneRow(rows.Count, row.Group, null, IsHeading: true));
                }

                rows.Add(new StatePaneRow(rows.Count, row.Label, row.Value, IsHeading: false));
            }

            return rows.ToImmutable();
        }
    }

    /// <summary>The draw before the selection, or <see langword="null" /> when there is none.</summary>
    int? Backwards => capture.Value.WorkCount > 0 ? capture.Value.PreviousWork(selected.Value - 1) : null;

    /// <summary>The draw after it, or <see langword="null" />.</summary>
    int? Forwards => capture.Value.WorkCount > 0 ? capture.Value.NextWork(selected.Value + 1) : null;

    void StepBack() {
        if (Backwards is { } target) {
            StepTo(target);
        }
    }

    void StepOn() {
        if (Forwards is { } target) {
            StepTo(target);
        }
    }

    /// <summary>Rebuilds the tree from the capture.</summary>
    /// <remarks>
    ///     ⚠ <b>Passes and groups are expanded and their contents are not.</b> A frame's structure is
    ///     what somebody is looking for; every bind under every draw expanded on open is a tree with
    ///     two thousand visible rows and no structure at all.
    /// </remarks>
    void Rebuild() {
        while (Tree.Root.Children.Count > 0) {
            Tree.Root.Remove(Tree.Root.Children[^1]);
        }

        foreach (var root in capture.Value.Roots) {
            Add(Tree.Root, root);
        }

        Tree.Refresh();
    }

    void Add(TreeNode into, CaptureNode captured) {
        var node = into.Add(new TreeNode(Label(captured), captured));

        foreach (var child in captured.Children) {
            Add(node, child);
        }

        // ⚠ After the children, because `TreeView.Expand` is what maintains the flattened visible
        // list and a node expanded while it was still empty is one the list has no rows for.
        if (captured.Command.Kind is CaptureCommandKind.BeginPass or CaptureCommandKind.PushGroup) {
            Tree.Expand(node);
        }
    }

    static string Label(CaptureNode node) =>
        node.Command.Kind is CaptureCommandKind.BeginPass or CaptureCommandKind.PushGroup
            ? string.Create(CultureInfo.InvariantCulture, $"{node.Label} — {node.WorkCount} draw(s)")
            : node.Label;

    string Sentence() {
        var frame = capture.Value;

        if (frame.IsEmpty) {
            return Unavailable ?? (Source is null
                ? "Nothing here can take a capture."
                : "Press Capture Frame.");
        }

        var at = selected.Value;
        var index = 0;

        for (var work = 0; work < frame.Work.Count; work++) {
            if (frame.Work[work] <= at) {
                index = work + 1;
            }
        }

        return string.Create(
            CultureInfo.InvariantCulture,
            $"{frame.Name} — {frame.Commands.Count:N0} call(s), {frame.WorkCount:N0} draw(s). "
            + $"At command {at:N0}, draw {index:N0}."
        );
    }

    /// <summary>
    ///     Wires the tree's selection once the parts exist, which for an element-flavoured file is
    ///     what <c>OnComposed</c> is: the generated <c>OnCreated</c> composes the body and then calls
    ///     it, so <c>Tree</c> is assigned.
    /// </summary>
    partial void OnComposed() {
        Tree.SelectionChanged += Chose;
    }

    partial void OnUnmounted() {
        Tree.SelectionChanged -= Chose;
    }

    void Chose(TreeView tree) {
        foreach (var node in tree.Selection) {
            if (node.Tag is CaptureNode captured) {
                StepTo(captured.Command.Sequence);
                return;
            }
        }
    }
}
