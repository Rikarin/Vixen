<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.ShaderGraph.Tests</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Editor.ShaderGraph\Vixen.Editor.ShaderGraph.csproj" />

        <!-- The graph emits Raven, so the only test worth writing is one that compiles it. The same
             arrangement Vixen.Vfx.Tests has, for the same reason: a golden string is exactly the
             kind of assertion that cannot tell whether the source is well typed. -->
        <ProjectReference Include="..\..\Raven\Vixen.Raven\Vixen.Raven.csproj" />

        <!-- The preview renderer draws, so the tests that say what came out need a real backend.
             They skip without one, and VIXEN_REQUIRE_VULKAN=1 turns the skip into a failure. -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Vulkan\Vixen.Graphics.Vulkan.csproj" />

        <!-- ⚠ And the device that draws nothing, for the question a real one cannot answer: how many
             RHI objects are alive. `NullDevice.LiveResourceCount` is the only instrument in the tree
             that counts what was created and not destroyed, which is what a leak test needs and what
             no Vulkan device exposes. See `ShaderGraphPreviewLeakTests` — nothing there reads a
             texel. -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Null\Vixen.Graphics.Null.csproj" />
    </ItemGroup>
    <!--
        #1119's ratchet. The TEST profile in `Directory.Build.props` turns documentation generation
        off for every `*.Tests` project, so no `<see cref>` in any test assembly was ever checked —
        and a test's remarks are read at the worst possible moment, when the test has just gone red.
        CS1591 and CS1573 stay suppressed: "this public member has no comment" is a question about a
        packaged API surface, and a test assembly is not one.

        This project reported nothing when the whole tree was measured with the flag forced on, so
        here it is a latch rather than a repair — which is the point. An overload landing beside a
        cref written earlier is not historical rot; #821's own measurement watched it happen inside
        one working session.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
