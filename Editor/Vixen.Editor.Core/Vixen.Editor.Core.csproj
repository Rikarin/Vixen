<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.Core</RootNamespace>
        <Description>
            The editor's model of a project: the command stack that everything it edits goes through,
            the signal-backed document model over it, project settings assets, and the asset database
            with the reverse-reference index that answers "what would break if I deleted this".
        </Description>
        <PackageTags>editor;undo;document-model;asset-database;asset-pipeline;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The `dotnet new` templates, embedded so that both heads write the same files
            `dotnet new vixen-game` does: `vixen new` from a terminal and the editor's New Project.
            There is no ProjectReference to go with this — Vixen.Templates is a content-only package
            with no assembly, so there is nothing to reference. What is shared is the tree of files,
            and TemplateCatalog is what reads it back out.

            ⚠ Embedded beside the reader rather than in each head, which is a hundred and thirty
            kilobytes in a library rather than in two applications. The reader looks in its *own*
            assembly, deliberately: an Assembly parameter would make "which templates" a question
            with two answers that could differ.

            ⚠ LogicalName is spelled out, with the separators normalised. The default naming folds
            directory separators into dots, which makes `Shaders/ui.vert.spv` and
            `Shaders.ui.vert.spv` the same resource name; and %(RecursiveDir) uses the host's
            separator, which would otherwise put a different set of resource names in a Windows build
            than in a Linux one — in an assembly the repository requires to be deterministic.
        -->
        <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\Tools\Vixen.Templates\templates\**\*"
                          LogicalName="Vixen.Templates/$([MSBuild]::ValueOrDefault('%(RecursiveDir)', '').Replace('\', '/'))%(Filename)%(Extension)"
                          Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.IO.Hashing" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Yaml\Vixen.Core.Yaml.csproj" />

        <!--
            `IFileWatcher` and the `FileChange` it drains. `ExternalEdits` is the two-way seam between
            a watcher and the open documents — the editor's own saves out, somebody else's edits in —
            and it belongs beside the project and the database it resolves paths through rather than
            in the head, where it would only be testable by launching an editor.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.IO\Vixen.Core.IO.csproj" />

        <!-- Settings assets are [DataContract] types read through the generated descriptors, and the
             file a settings type lives in is named after its contract alias rather than its C# name. -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection\Vixen.Core.Reflection.csproj" />

        <!--
            A scene file is positions and rotations, so the authoring format needs the vector types —
            and only those. Scenes/SceneFormat.cs is what a .vxscene binds to, and it lives here
            rather than beside the viewport because two things read it: the panel that edits a scene
            and the importer that compiles one, and neither should have to reference the other.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Mathematics\Vixen.Core.Mathematics.csproj" />

        <!--
          The document model is signal-backed: an EditorProperty is a Signal, so the inspector binds
          to it and a gizmo writing it updates the inspector with nothing wired between them. This is
          the reactive graph used outside the UI framework, which is the point of having built it as
          a layer of its own rather than inside Vixen.Ui.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Reactive\Vixen.Ui.Reactive.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            Analyzers do not flow transitively through a ProjectReference, so the assembly declaring
            the scene file's [DataContract] types has to name the generator that describes them. The
            descriptors are how the YAML binder finds a member without reflecting over one.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Editor.Core.Tests" />
    </ItemGroup>

</Project>
