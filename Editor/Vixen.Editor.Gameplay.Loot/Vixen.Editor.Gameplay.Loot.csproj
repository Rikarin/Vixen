<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Editor.Gameplay.Loot</RootNamespace>
        <Description>
            The authoring half of a loot table: an editable model over the definition with every
            gesture as an operation, the flattened outline a tree view draws, and a drop simulator
            that runs the shipped evaluator rather than an approximation of it.
        </Description>
        <PackageTags>editor;loot;drops;simulation;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The runtime library, because the document *is* a LootTableDefinition and the simulator
            *is* LootEvaluator. Vixen.Editor.Ai makes the same bargain and says so: there is no
            editor-side model of a table to keep in step with the runtime's, and a simulator that
            approximated the evaluator would be a second set of odds for a designer to be misled by.
        -->
        <ProjectReference Include="..\..\Gameplay\Vixen.Gameplay.Loot\Vixen.Gameplay.Loot.csproj" />
        <ProjectReference Include="..\..\Gameplay\Vixen.Gameplay.Items\Vixen.Gameplay.Items.csproj" />
        <ProjectReference Include="..\..\Gameplay\Vixen.Gameplay\Vixen.Gameplay.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core\Vixen.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Editor.Gameplay.Loot.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <!--
            #821's ratchet. The TOOLING profile in `Directory.Build.props` sets this false for all of
            `Editor/**`, `Tools/**` and `Raven/**`, so no `<see cref>` under any of them was ever
            checked — ask what that gate printed on the day it did not run: `0 Warning(s)`. CS1591
            and CS1573 stay suppressed: "this public member has no comment" is a question about a
            packaged API surface and is not what this is for; the rules that catch a *lie* are.
            Measured before flipping, and every diagnostic it reported is fixed in the same commit.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
