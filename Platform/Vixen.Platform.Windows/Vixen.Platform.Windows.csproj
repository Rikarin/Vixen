<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Platform.Windows</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Description>
            What Windows can do that a portable desktop implementation cannot: the shell's file
            pickers, clipboard images and application-defined formats, processor efficiency classes
            and thread affinity, and the battery-saver flag.
        </Description>
        <PackageTags>windows;win32;clipboard;dialogs;affinity;platform;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!--
            net10.0, not net10.0-windows. A Windows-versioned target framework is only needed for
            WinRT and WPF/WinForms projections, and this assembly uses neither: it is Win32 and COM
            through [LibraryImport]. Taking the versioned framework would spread it to every
            consumer that references this project and take the assembly out of `nuke CheckApi`,
            which covers net10.0. See WindowsDialogs and the README.
        -->
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Platform\Vixen.Platform.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Platform.Windows.Tests" />
    </ItemGroup>

</Project>
