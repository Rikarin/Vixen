<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Graphics.Golden.Tests</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="CsCheck" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Graphics.Vulkan\Vixen.Graphics.Vulkan.csproj" />
        <!--
          The effect set, for the fixtures that render one. A bloom pyramid against a reference image
          is the only thing that answers whether the filter is the filter it says it is.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering.PostFx\Vixen.Rendering.PostFx.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Graphics.RenderGraph\Vixen.Graphics.RenderGraph.csproj" />

        <!--
          The renderer, so a fixture can drive a compositor rather than only a command list. Every
          claim above this line is about the backend; the ones that need this are about the layer
          engine code actually uses — and those had been asserted entirely against a recording
          backend that agrees with whatever it is told.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering\Vixen.Rendering.csproj" />

        <!--
            The user interface's GPU half. Its geometry is already checked without a device, and what
            a picture adds is the only thing that check cannot reach: whether the shaders agree with
            it. A distance field evaluated with the wrong sign, a projection that flips y, an atlas
            sampled as sRGB — every one of those passes every unit test in `Vixen.Ui`.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Renderer\Vixen.Ui.Renderer.csproj" />

        <!--
            The debug geometry's GPU half, for the same reason as the line above it. `DebugGeometry`
            is checked without a device and cannot reach the two things a picture can: whether the
            screen projection maps a pixel to the pixel it names, and whether the stroke font comes
            out as letters. Both of those are silently wrong in every unit test that passes.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Engine.Renderer\Vixen.Engine.Renderer.csproj" />

        <!-- A compositor is a document, and the virtualized frame is described by one. -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Yaml\Vixen.Core.Yaml.csproj" />

        <!--
            `Bitmap` and `PngCodec`, which used to live here. This suite wrote them first and
            `Vixen.Ui.Testing` needed the same two for its screenshots, so there were two hand-rolled
            PNG encoders in the tree.

            ⚠ The direction is this way round and not the other. A shipping library can be referenced
            by a test project; a test project cannot be referenced by anything. Moving them into the
            library that ships is what makes one copy possible at all — and it is the copy under a
            documentation and API-compatibility obligation, which is the one that should be load
            bearing.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Testing\Vixen.Ui.Testing.csproj" />

        <!--
            Raven, through the compiler the content build uses. One fixture dispatches
            `ClusterCulling.rvn` itself rather than a hand-written stand-in: a compute shader nobody
            has ever run is a compute shader nobody has ever run, and a mirror of it written for the
            test would agree with the test.

            ⚠ Allowed because this is a test project — Platform may not reference Tools otherwise, and
            the architecture check says so by name.
        -->
        <ProjectReference Include="..\..\Tools\Vixen.ShaderCompiler\Vixen.ShaderCompiler.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            One of the Consortium's test fonts, linked rather than copied — the same file
            `Vixen.Ui.Tests` uses, for the same reason: text in a picture has to be shaped and
            rasterised by a real font, and a stub with invented metrics would agree with whatever this
            assembly did to it. Fonts/README.md in `Vixen.Ui.Text.Tests` says whose it is.
        -->
        <EmbeddedResource Include="..\..\Core\Vixen.Ui.Text.Tests\Fonts\TestShapeLana.ttf"
                          LogicalName="Vixen.Graphics.Golden.Tests.TestShapeLana.ttf" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The reference images travel with the binary so the suite can run from anywhere, and the
            fixtures' SPIR-V with them. Copied rather than embedded: a golden image a human cannot
            open in a file browser is one nobody will look at, and looking at it is the entire
            workflow when one fails.
        -->
        <None Include="References\**" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Shaders\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
