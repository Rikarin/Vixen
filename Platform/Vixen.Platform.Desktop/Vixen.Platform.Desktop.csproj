<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Platform.Desktop</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Description>
            The desktop platform: windowing, input, gamepads, clipboard, display enumeration and IME
            on Windows, Linux and macOS through one SDL implementation, plus the native handles a
            Vulkan surface is created from.
        </Description>
        <PackageTags>sdl;windowing;input;desktop;platform;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Platform\Vixen.Platform.csproj" />

        <!-- The loader search: the application's own runtimes/<rid>/native/ layout before the
             system's. See SdlLibrary and R11. -->
        <ProjectReference Include="..\Vixen.Platform.Native\Vixen.Platform.Native.csproj" />

        <!-- All three, and one of them is chosen at runtime. The dependency points this way round
             because .NET loads an assembly when something calls into it, so an assembly that
             registered itself would only do so once something else had already used it. See
             DesktopSupplements. -->
        <ProjectReference Include="..\Vixen.Platform.Windows\Vixen.Platform.Windows.csproj" />
        <ProjectReference Include="..\Vixen.Platform.Linux\Vixen.Platform.Linux.csproj" />
        <ProjectReference Include="..\Vixen.Platform.MacOS\Vixen.Platform.MacOS.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.SDL" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Platform.Desktop.Tests" />
    </ItemGroup>

</Project>
