<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Graphics.WebGPU\Vixen.Graphics.WebGPU.csproj" />
    </ItemGroup>

    <!--
      Imported here as well as in the backend, because an Import does not flow across a
      ProjectReference and this project's own output is where the tests look. Absence is ordinary:
      WebGpuRequirement skips rather than fails, unless VIXEN_REQUIRE_WEBGPU says otherwise.
    -->
    <Import Project="..\Vixen.Platform.Native\build\WgpuNative.targets" />
</Project>
