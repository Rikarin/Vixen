<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Graphics.Vulkan</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Description>
            The Vulkan backend — the RHI's reference implementation. Instance and device bring-up,
            adapter selection, validation layers routed into the engine's log, and the portability
            handling MoltenVK needs on Apple platforms.
        </Description>
        <PackageTags>vulkan;graphics;rhi;moltenvk;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Collections\Vixen.Core.Collections.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Mathematics\Vixen.Core.Mathematics.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Graphics\Vixen.Graphics.csproj" />

        <!-- The loader search: the application's own runtimes/<rid>/native/ layout, the RID chain
             and the versioned soname. See VulkanLoader and R11. -->
        <ProjectReference Include="..\Vixen.Platform.Native\Vixen.Platform.Native.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Silk.NET.Vulkan" />
        <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
        <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Graphics.Vulkan.Tests" />
    </ItemGroup>

</Project>
