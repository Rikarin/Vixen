<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Raven.Gpu.Tests</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!--
            The compiler and a driver, in one process. Vixen.Raven.Tests can say the shipped library
            compiles and that spirv-val accepts what came out; neither is a claim about what the
            numbers are. Answering that needs the module to actually run, which needs a backend —
            and no shipping assembly links both, because the compiler is a tool and the driver is a
            runtime. This project is where the two meet, which is the arrangement
            Vixen.Vfx.Gpu.Tests already makes for the same reason.
        -->
        <ProjectReference Include="..\Vixen.Graphics.Vulkan\Vixen.Graphics.Vulkan.csproj" />
        <ProjectReference Include="..\..\Raven\Vixen.Raven\Vixen.Raven.csproj" />
    </ItemGroup>
</Project>
