<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Platform</RootNamespace>
        <Description>
            The platform contracts: windows, surfaces, displays, clipboard, native dialogs,
            lifecycle, input devices, text input and power state. Implemented once per platform and
            referenced by everything above, so that nothing else in the engine has a #if ANDROID.
        </Description>
        <PackageTags>platform;windowing;input;lifecycle;abstraction;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core.IO\Vixen.Core.IO.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Mathematics\Vixen.Core.Mathematics.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Platform.Tests" />
    </ItemGroup>

</Project>
