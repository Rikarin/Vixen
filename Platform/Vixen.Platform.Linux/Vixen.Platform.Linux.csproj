<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Platform.Linux</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Description>
            What Linux can do that a portable desktop implementation cannot: the desktop's own file
            pickers, clipboard images and MIME formats through the display server's tools,
            sched_setaffinity and the sysfs processor topology, and thermal pressure read from the
            kernel's own trip points.
        </Description>
        <PackageTags>linux;wayland;x11;clipboard;dialogs;affinity;thermal;platform;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Vixen.Platform\Vixen.Platform.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- CRC32 for the PNG chunks. See PngImage. -->
        <PackageReference Include="System.IO.Hashing" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Platform.Linux.Tests" />
    </ItemGroup>

</Project>
