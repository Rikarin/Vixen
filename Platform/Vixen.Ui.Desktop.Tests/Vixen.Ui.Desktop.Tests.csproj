<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Desktop\Vixen.Ui.Desktop.csproj" />

        <!--
            The headless platform, which is what makes a frame loop testable with no display server
            and no GPU: windows that have a size, an id and an event stream and show nobody anything.
            That is exactly the run the `--frames N` flag exists to make meaningful.
        -->
        <ProjectReference Include="..\Vixen.Platform.Headless\Vixen.Platform.Headless.csproj" />
    </ItemGroup>
</Project>
