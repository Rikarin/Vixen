<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Desktop\Vixen.Ui.Desktop.csproj" />

        <!--
            The headless platform, which is what makes a frame loop testable with no display server
            and no GPU: windows that have a size, an id and an event stream and show nobody anything.
            That is exactly the run the frame-count option exists to make meaningful.
        -->
        <ProjectReference Include="..\Vixen.Platform.Headless\Vixen.Platform.Headless.csproj" />

        <!--
            ⚠ **The development-only assembly, referenced by the tests and never by the host.**
            `UiApplicationOptions.Mount` exists so that an application can put its content under a
            `HotReloadHost` — and the whole point of the seam is that `Vixen.Ui.Desktop` does not
            know what one is. A test that asserted the seam without ever putting a real host through
            it would be asserting that a delegate is a delegate.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.HotReload\Vixen.Ui.HotReload.csproj" />

        <!--
            The recording device, for the one question the headless platform cannot answer: what a
            window's renderer *writes* on a frame nothing changed. The headless loop stops at the
            RHI, and the geometry upload is the first thing on the other side of it — so
            `IdleFrameUploadTests` drives `UiRenderer` directly, on a device that records rather than
            draws, and asserts on the renderer's own counters rather than on a picture.
        -->
        <ProjectReference Include="..\Vixen.Graphics.Null\Vixen.Graphics.Null.csproj" />
    </ItemGroup>
</Project>
