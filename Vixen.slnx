  <!--
    Platform — one folder per deployment concern (docs/plan/02 § "Platform/").
    Contracts first, then the implementations. Headless is here from the start rather
    than as a Phase 9 retrofit: it is what the dedicated server runs on *and* what every
    test that needs a platform uses, so the no-display path cannot quietly rot.
  -->
  <Folder Name="/Platform/">
    <!-- The contracts these implement are in Core/Vixen.Platform; see the note beside it. -->
    <Project Path="Platform/Vixen.Platform.Headless/Vixen.Platform.Headless.csproj" />
    <Project Path="Platform/Vixen.Platform.Headless.Tests/Vixen.Platform.Headless.Tests.csproj" />
    <Project Path="Platform/Vixen.Platform.Desktop/Vixen.Platform.Desktop.csproj" />
    <Project Path="Platform/Vixen.Platform.Desktop.Tests/Vixen.Platform.Desktop.Tests.csproj" />
    <!--
      The three per-OS assemblies. All of them are here and all of them build everywhere, because
      each is net10.0 and its platform-specific half is [LibraryImport] behind
      [SupportedOSPlatform] rather than a Windows-versioned target framework — which is what keeps
      them out of the workload problem that Vixen.Platform.Android and .iOS have, and inside
      `nuke CheckApi`.
    -->
    <Project Path="Platform/Vixen.Platform.Windows/Vixen.Platform.Windows.csproj" />
    <Project Path="Platform/Vixen.Platform.Windows.Tests/Vixen.Platform.Windows.Tests.csproj" />
    <Project Path="Platform/Vixen.Platform.Linux/Vixen.Platform.Linux.csproj" />
    <Project Path="Platform/Vixen.Platform.Linux.Tests/Vixen.Platform.Linux.Tests.csproj" />
    <Project Path="Platform/Vixen.Platform.MacOS/Vixen.Platform.MacOS.csproj" />
    <Project Path="Platform/Vixen.Platform.MacOS.Tests/Vixen.Platform.MacOS.Tests.csproj" />
    <Project Path="Platform/Vixen.Platform.Native/Vixen.Platform.Native.csproj" />
    <Project Path="Platform/Vixen.Platform.Native.Tests/Vixen.Platform.Native.Tests.csproj" />
    <!--
      The join between Vixen.Platform and Vixen.Ui. It is in Platform/ rather than Core/ because it
      references a window, and Core may not — which is the whole reason the assembly exists.
    -->
    <Project Path="Platform/Vixen.Platform.Ui/Vixen.Platform.Ui.csproj" />
    <Project Path="Platform/Vixen.Platform.Ui.Tests/Vixen.Platform.Ui.Tests.csproj" />
    <Project Path="Platform/Vixen.Graphics.Null/Vixen.Graphics.Null.csproj" />
    <Project Path="Platform/Vixen.Graphics.Null.Tests/Vixen.Graphics.Null.Tests.csproj" />
    <Project Path="Platform/Vixen.Graphics.Golden.Tests/Vixen.Graphics.Golden.Tests.csproj" />
    <Project Path="Platform/Vixen.Graphics.Vulkan/Vixen.Graphics.Vulkan.csproj" />
    <Project Path="Platform/Vixen.Graphics.Vulkan.Tests/Vixen.Graphics.Vulkan.Tests.csproj" />
    <!--
      The WebGPU backend's shared half and its native Dawn/wgpu surface. Its browser
      surface — Vixen.Graphics.WebGPU.Browser — is absent for the reason below.
    -->
    <Project Path="Platform/Vixen.Graphics.WebGPU/Vixen.Graphics.WebGPU.csproj" />
    <Project Path="Platform/Vixen.Graphics.WebGPU.Tests/Vixen.Graphics.WebGPU.Tests.csproj" />
    <!--
      The abstraction validator. ADR-001 postponed D3D12 past 1.0 and passed the job of proving the
      RHI is API-neutral to OpenGL, which is a stricter test — no pipeline objects, no descriptor
      sets, no explicit barriers, no multithreaded recording. Its test assembly drives a recording
      IGlApi rather than a driver, so the translation layer is checked on every build and not only
      on the CI leg that has Mesa.
    -->
    <Project Path="Platform/Vixen.Graphics.OpenGL/Vixen.Graphics.OpenGL.csproj" />
    <Project Path="Platform/Vixen.Graphics.OpenGL.Tests/Vixen.Graphics.OpenGL.Tests.csproj" />
    <Project Path="Platform/Vixen.Raven.Gpu.Tests/Vixen.Raven.Gpu.Tests.csproj" />
    <Project Path="Platform/Vixen.Vfx.Gpu.Tests/Vixen.Vfx.Gpu.Tests.csproj" />
    <!--
      Vixen.Platform.Web, Vixen.Audio.Backend.WebAudio and Vixen.Graphics.WebGPU.Browser
      are deliberately absent, for the same reason Vixen.Platform.Android and
      Vixen.Platform.iOS are: they target net10.0-browser, which needs the wasm-tools
      workload even to evaluate, and a solution that will not restore on a machine
      without it is a solution nobody can open. They are built by the web app head and
      by anyone who has the workload.

      Vixen.Platform.Web.Tests *is* here, and is not a contradiction: it targets
      net10.0 and links the platform-neutral half of that project as source rather than
      referencing it, so the manifest reader — hand-written, and the thing most worth
      testing — is covered on every push without a browser or a workload. See its csproj.
    -->
    <Project Path="Platform/Vixen.Platform.Web.Tests/Vixen.Platform.Web.Tests.csproj" />
    <Project Path="Platform/Vixen.Audio.Backend.OpenAL/Vixen.Audio.Backend.OpenAL.csproj" />
    <Project Path="Platform/Vixen.Audio.Backend.OpenAL.Tests/Vixen.Audio.Backend.OpenAL.Tests.csproj" />
    <!--
      The OpenXR backend ships bindings and no native payload: the loader belongs to whatever
      runtime owns the headset, and a copy inside a game would shadow it. A machine with no
      headset therefore has no loader either, which is why the backend is written to survive
      that and why its tests skip rather than fail.
    -->
    <Project Path="Platform/Vixen.Xr.OpenXR/Vixen.Xr.OpenXR.csproj" />
    <Project Path="Platform/Vixen.Xr.OpenXR.Tests/Vixen.Xr.OpenXR.Tests.csproj" />
  </Folder>

  <!--
    Editor — docs/plan/02 § Editor/. Vixen.Editor.Core is the project model everything
    else in the editor is built on: the asset database and the two indexes over it.
    Vixen.Editor.Ui is the shell over Vixen.Ui — docking, commands, palette, theming —
    and deliberately does not reference Core, so the chrome is testable with no project
    on disk. Vixen.Editor.App is the head that joins them to a window and a device.
    Vixen.Editor.NodeGraph is the framework the shader and VFX graphs are both built on
    and references neither of those two: a graph is a document and a compiler, so the
    whole of it is testable with no shell either. Vixen.Editor.AnimationGraph is beside
    them and ⚠ deliberately *not* on that framework: a state machine's edge carries "may
    become" rather than a value, several leave one state and several arrive at another,
    and a graph with no cycle is a character that can never return to idle. See its README.

    Vixen.Editor.Inspector and Vixen.Editor.SceneView are the two panels that are more
    than chrome, and both reference Vixen.Editor.Core because both produce IEditorCommands
    — "every edit produces a command" is only true by construction if the thing building
    the editors knows about the stack. Neither references Vixen.Editor.Ui: an inspector is
    a control and a viewport is arithmetic over an interface, so both are testable against
    a bare UiDocument with no shell, and joining them to the docking workspace is
    Vixen.Editor.App's job as it is for everything else.

    Vixen.Editor.AssetEditors is the one assembly here that references most of the others,
    and that is what it is for: doc 11's table of per-asset editors is a table of things
    that each need a document, an inspector, and — for four of them — a viewport, a graph
    or a code editor. It is above the panels rather than beside them, and it is still not
    the shell: an asset editor is a document and a control, and which dock group it lands
    in is Vixen.Editor.App's decision as everything else is.

    Vixen.Editor.Profiler and Vixen.Editor.Debugger are doc 11's two diagnostics projects
    and doc 20's B4. Two rather than one because they depend on different halves of the
    engine — the profiler on the sample rings and the RHI's query pools, the debugger on a
    command stream and a network transport — and neither references Vixen.Editor.Core:
    what a diagnostics panel shows is a *reading* rather than something anybody edits, so
    there is no document and no undo stack, and both are testable against a bare
    UiDocument with no project on disk. Which world the statistics count and which device
    the GPU timeline reads are Vixen.Editor.App's arbitration, as every other panel's
    subject is.

    Vixen.Editor.Blockout is doc 24's editor half: the viewport mode the grey-boxing
    tools live in. It references Vixen.Editor.Ui and nothing else — a mode is a shell
    concept, and the viewport is joined to it by Vixen.Editor.App through the pane's own
    IViewportInput rather than by a reference from here. ⚠ The mesh kernel it will edit is
    Core/Vixen.Geometry and is deliberately not under Editor/: it is arithmetic with no
    document, no selection and no device, and doc 24 § D1 says why that belongs under the
    profile that is AOT-compatible, trimmable and API-checked.

    Vixen.Editor.Terrain is doc 31 § T3's editor half, and the same shape one phase on: the
    viewport mode the sculpt tools live in, the settings the terrain panel is made of, the
    stroke and layer commands, and the editing state that turns a drag into one undo entry.
    ⚠ It references Vixen.Editor.SceneView as well as Vixen.Editor.Ui — a brush needs to know
    which pane the pointer is in to turn it into a ray — and Vixen.Editor.Inspector, because
    the panel is [Inspector] members of [DataContract] types rather than dialog code. The
    heightfield kernel it edits is Core/Vixen.Terrain, deliberately not under Editor/, for the
    reason Core/Vixen.Geometry is not: arithmetic with no document, no selection and no device.

    Vixen.Editor.Plugin is the contract a third party writes against, and the only
    project under Editor/ whose public surface is checked against a baseline — doc 11
    asks for a stricter promise there than anywhere else in the editor. It references
    Vixen.Editor.Ui and nothing else here, so that a plugin adding a menu item does not
    build against a model importer.
  -->
  <Folder Name="/Editor/">
    <Project Path="Editor/Vixen.Editor.Core/Vixen.Editor.Core.csproj" />
    <Project Path="Editor/Vixen.Editor.Core.Tests/Vixen.Editor.Core.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.Assets/Vixen.Editor.Assets.csproj" />
    <Project Path="Editor/Vixen.Editor.Assets.Tests/Vixen.Editor.Assets.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.NodeGraph/Vixen.Editor.NodeGraph.csproj" />
    <Project Path="Editor/Vixen.Editor.NodeGraph.Generator/Vixen.Editor.NodeGraph.Generator.csproj" />
    <Project Path="Editor/Vixen.Editor.NodeGraph.Tests/Vixen.Editor.NodeGraph.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.ShaderGraph/Vixen.Editor.ShaderGraph.csproj" />
    <Project Path="Editor/Vixen.Editor.ShaderGraph.Tests/Vixen.Editor.ShaderGraph.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.VfxGraph/Vixen.Editor.VfxGraph.csproj" />
    <Project Path="Editor/Vixen.Editor.VfxGraph.Tests/Vixen.Editor.VfxGraph.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.AnimationGraph/Vixen.Editor.AnimationGraph.csproj" />
    <!--
      The authoring half of doc 37's behaviour trees. Beside AnimationGraph rather than under
      NodeGraph, and for its reason: doc 37 § D19 works through NodeGraphModel's rules and a tree
      fails two — a composite's children are ordered where Edges is an unordered list, and a
      decorator attaches where the model has no notion of an attachment. What is shared is the
      canvas, not the model.
    -->
    <Project Path="Editor/Vixen.Editor.Ai/Vixen.Editor.Ai.csproj" />
    <Project Path="Editor/Vixen.Editor.Ai.Tests/Vixen.Editor.Ai.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.AnimationGraph.Tests/Vixen.Editor.AnimationGraph.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.Inspector/Vixen.Editor.Inspector.csproj" />
    <Project Path="Editor/Vixen.Editor.Inspector.Generator/Vixen.Editor.Inspector.Generator.csproj" />
    <Project Path="Editor/Vixen.Editor.Inspector.Tests/Vixen.Editor.Inspector.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.SceneView/Vixen.Editor.SceneView.csproj" />
    <Project Path="Editor/Vixen.Editor.SceneView.Tests/Vixen.Editor.SceneView.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.Blockout/Vixen.Editor.Blockout.csproj" />
    <Project Path="Editor/Vixen.Editor.Blockout.Tests/Vixen.Editor.Blockout.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.Terrain/Vixen.Editor.Terrain.csproj" />
    <Project Path="Editor/Vixen.Editor.Terrain.Tests/Vixen.Editor.Terrain.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.Ui/Vixen.Editor.Ui.csproj" />
    <Project Path="Editor/Vixen.Editor.Ui.Tests/Vixen.Editor.Ui.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.AssetEditors/Vixen.Editor.AssetEditors.csproj" />
    <Project Path="Editor/Vixen.Editor.AssetEditors.Tests/Vixen.Editor.AssetEditors.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.Profiler/Vixen.Editor.Profiler.csproj" />
    <Project Path="Editor/Vixen.Editor.Profiler.Tests/Vixen.Editor.Profiler.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.Debugger/Vixen.Editor.Debugger.csproj" />
    <Project Path="Editor/Vixen.Editor.Diagnostics/Vixen.Editor.Diagnostics.csproj" />
    <Project Path="Editor/Vixen.Editor.Debugger.Tests/Vixen.Editor.Debugger.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.Plugin/Vixen.Editor.Plugin.csproj" />
    <Project Path="Editor/Vixen.Editor.Plugin.Tests/Vixen.Editor.Plugin.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.Scripts/Vixen.Editor.Scripts.csproj" />
    <Project Path="Editor/Vixen.Editor.Scripts.Tests/Vixen.Editor.Scripts.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.App/Vixen.Editor.App.csproj" />
    <Project Path="Editor/Vixen.Editor.Host/Vixen.Editor.Host.csproj" />
    <Project Path="Editor/Vixen.Editor.Testing/Vixen.Editor.Testing.csproj" />
    <Project Path="Editor/Vixen.Editor.App.Tests/Vixen.Editor.App.Tests.csproj" />
  </Folder>

  <!--
    Tools — docs/plan/02 § Tools/. Vixen.App is both the host an application boots
    through and, later, the meta-package that pulls in the backends valid for a RID.
  -->
  <Folder Name="/Tools/">
    <Project Path="Tools/Vixen.AotProbe/Vixen.AotProbe.csproj" />
    <Project Path="Tools/Vixen.ApiCheck/Vixen.ApiCheck.csproj" />
