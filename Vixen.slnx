    <Project Path="Core/Vixen.Ui.Reactive.Tests/Vixen.Ui.Reactive.Tests.csproj" />
    <Project Path="Core/Vixen.Ui.Layout/Vixen.Ui.Layout.csproj" />
    <Project Path="Core/Vixen.Ui.Layout.Tests/Vixen.Ui.Layout.Tests.csproj" />
    <Project Path="Core/Vixen.Ui.Styling/Vixen.Ui.Styling.csproj" />
    <Project Path="Core/Vixen.Ui.Styling.Tests/Vixen.Ui.Styling.Tests.csproj" />
  </Folder>

  <!--
    Platform — one folder per deployment concern (docs/plan/02 § "Platform/").
    Contracts first, then the implementations. Headless is here from the start rather
    than as a Phase 9 retrofit: it is what the dedicated server runs on *and* what every
    test that needs a platform uses, so the no-display path cannot quietly rot.
  -->
  <Folder Name="/Platform/">
    <Project Path="Platform/Vixen.Platform/Vixen.Platform.csproj" />
    <Project Path="Platform/Vixen.Platform.Tests/Vixen.Platform.Tests.csproj" />
    <Project Path="Platform/Vixen.Platform.Headless/Vixen.Platform.Headless.csproj" />
    <Project Path="Platform/Vixen.Platform.Headless.Tests/Vixen.Platform.Headless.Tests.csproj" />
    <Project Path="Platform/Vixen.Platform.Desktop/Vixen.Platform.Desktop.csproj" />
    <Project Path="Platform/Vixen.Platform.Desktop.Tests/Vixen.Platform.Desktop.Tests.csproj" />
    <Project Path="Platform/Vixen.Graphics.Null/Vixen.Graphics.Null.csproj" />
    <Project Path="Platform/Vixen.Graphics.Null.Tests/Vixen.Graphics.Null.Tests.csproj" />
    <Project Path="Platform/Vixen.Graphics.Golden.Tests/Vixen.Graphics.Golden.Tests.csproj" />
    <Project Path="Platform/Vixen.Graphics.Vulkan/Vixen.Graphics.Vulkan.csproj" />
    <Project Path="Platform/Vixen.Graphics.Vulkan.Tests/Vixen.Graphics.Vulkan.Tests.csproj" />
  </Folder>

  <!--
    Editor — docs/plan/02 § Editor/. Vixen.Editor.Core is the project model everything
    else in the editor is built on: the asset database and the two indexes over it.
  -->
  <Folder Name="/Editor/">
    <Project Path="Editor/Vixen.Editor.Core/Vixen.Editor.Core.csproj" />
    <Project Path="Editor/Vixen.Editor.Core.Tests/Vixen.Editor.Core.Tests.csproj" />
    <Project Path="Editor/Vixen.Editor.Assets/Vixen.Editor.Assets.csproj" />
    <Project Path="Editor/Vixen.Editor.Assets.Tests/Vixen.Editor.Assets.Tests.csproj" />
  </Folder>

  <!--
    Tools — docs/plan/02 § Tools/. Vixen.App is both the host an application boots
    through and, later, the meta-package that pulls in the backends valid for a RID.
  -->
  <Folder Name="/Tools/">
    <Project Path="Tools/Vixen.App/Vixen.App.csproj" />
    <Project Path="Tools/Vixen.App.Tests/Vixen.App.Tests.csproj" />
    <Project Path="Tools/Vixen.YogaTestGen/Vixen.YogaTestGen.csproj" />
  </Folder>

  <!--
    Benchmarks — docs/plan/02 § Benchmarks/. Not built by `Test`; the Nuke `Benchmark`
    target runs them in Release and diffs against a committed baseline.
  -->
  <Folder Name="/Benchmarks/">
    <Project Path="Benchmarks/Vixen.Benchmarks.Math/Vixen.Benchmarks.Math.csproj" />
    <Project Path="Benchmarks/Vixen.Benchmarks.Jobs/Vixen.Benchmarks.Jobs.csproj" />
    <Project Path="Benchmarks/Vixen.Benchmarks.Ecs/Vixen.Benchmarks.Ecs.csproj" />
    <Project Path="Benchmarks/Vixen.Benchmarks.Ui/Vixen.Benchmarks.Ui.csproj" />
  </Folder>

  <!--
    Raven — the shader compiler.
    Layout follows docs/plan/02-repository-layout.md § "Raven/": one folder per
    project, named after the assembly, with tests as a sibling (ADR-014).
  -->
  <Folder Name="/Raven/">
    <File Path="Raven/Directory.Build.props" />
    <File Path="Raven/README.md" />
    <Project Path="Raven/Vixen.Raven/Vixen.Raven.csproj" />
    <Project Path="Raven/Vixen.Raven.Tests/Vixen.Raven.Tests.csproj" />
    <Project Path="Raven/Vixen.Raven.Cli/Vixen.Raven.Cli.csproj" />
  </Folder>
  <Project Path="Samples/01-HelloTriangle/HelloTriangle.csproj" />
  <Project Path="Samples/04-EcsStressTest/EcsStressTest.csproj" />


</Solution>
