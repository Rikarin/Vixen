    <Project Path="Tools/Vixen.DocGen/Vixen.DocGen.csproj" />
    <Project Path="Tools/Vixen.DocGen.Tests/Vixen.DocGen.Tests.csproj" />
    <Project Path="Tools/Vixen.Sdk/Vixen.Sdk.csproj" />
