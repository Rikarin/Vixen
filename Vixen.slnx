<Solution>

  <Folder Name="/_root/">
    <File Path="Directory.Build.props" />
    <File Path="global.json" />
    <File Path=".editorconfig" />
    <File Path=".gitattributes" />
    <File Path="nuget.config" />
    <File Path="LICENSE" />
    <File Path="NOTICE" />
    <File Path="README.md" />
  </Folder>

  <Folder Name="/docs/">
    <File Path="docs/plan/README.md" />
    <File Path="docs/plan/00-vision-and-principles.md" />
    <File Path="docs/plan/01-technology-decisions.md" />
    <File Path="docs/plan/02-repository-layout.md" />
    <File Path="docs/plan/03-core-foundation.md" />
    <File Path="docs/plan/04-ecs-and-scripting.md" />
    <File Path="docs/plan/05-graphics-rhi.md" />
    <File Path="docs/plan/06-rendering-pipeline.md" />
    <File Path="docs/plan/07-raven-shader-pipeline.md" />
    <File Path="docs/plan/08-asset-pipeline-and-addressables.md" />
    <File Path="docs/plan/09-ui-framework.md" />
    <File Path="docs/plan/10-platforms.md" />
    <File Path="docs/plan/11-editor.md" />
    <File Path="docs/plan/12-build-ci-and-testing.md" />
    <File Path="docs/plan/13-diagnostics.md" />
    <File Path="docs/plan/14-roadmap.md" />
    <File Path="docs/plan/15-risks-and-open-questions.md" />
    <File Path="docs/plan/16-networking.md" />
    <File Path="docs/plan/17-app-heads-and-shipping.md" />
  </Folder>

  <!--
    Core — the shared foundation (docs/plan/02-repository-layout.md § "Core/").
    Vixen.Core.Syntax was lifted out of Raven so that Raven, VXML and VCSS are three
    grammars over one tested tree rather than three trees (doc 07 § A).
  -->
  <Folder Name="/Core/">
    <Project Path="Core/Vixen.Core/Vixen.Core.csproj" />
    <Project Path="Core/Vixen.Core.Tests/Vixen.Core.Tests.csproj" />
    <Project Path="Core/Vixen.Core.Mathematics/Vixen.Core.Mathematics.csproj" />
    <Project Path="Core/Vixen.Core.Mathematics.Tests/Vixen.Core.Mathematics.Tests.csproj" />
    <Project Path="Core/Vixen.Core.Collections/Vixen.Core.Collections.csproj" />
    <Project Path="Core/Vixen.Core.Collections.Tests/Vixen.Core.Collections.Tests.csproj" />
    <Project Path="Core/Vixen.Core.Memory/Vixen.Core.Memory.csproj" />
    <Project Path="Core/Vixen.Core.Memory.Tests/Vixen.Core.Memory.Tests.csproj" />
    <Project Path="Core/Vixen.Core.Diagnostics/Vixen.Core.Diagnostics.csproj" />
    <Project Path="Core/Vixen.Core.Diagnostics.Tests/Vixen.Core.Diagnostics.Tests.csproj" />
    <Project Path="Core/Vixen.Core.IO/Vixen.Core.IO.csproj" />
    <Project Path="Core/Vixen.Core.IO.Tests/Vixen.Core.IO.Tests.csproj" />
    <Project Path="Core/Vixen.Core.Serialization/Vixen.Core.Serialization.csproj" />
    <Project Path="Core/Vixen.Core.Serialization.Generator/Vixen.Core.Serialization.Generator.csproj" />
    <Project Path="Core/Vixen.Core.Serialization.Tests/Vixen.Core.Serialization.Tests.csproj" />
    <Project Path="Core/Vixen.Core.Reflection/Vixen.Core.Reflection.csproj" />
    <Project Path="Core/Vixen.Core.Reflection.Generator/Vixen.Core.Reflection.Generator.csproj" />
    <Project Path="Core/Vixen.Core.Reflection.Tests/Vixen.Core.Reflection.Tests.csproj" />
    <Project Path="Core/Vixen.Core.Threading/Vixen.Core.Threading.csproj" />
    <Project Path="Core/Vixen.Core.Threading.Tests/Vixen.Core.Threading.Tests.csproj" />
    <Project Path="Core/Vixen.Core.Syntax/Vixen.Core.Syntax.csproj" />
    <Project Path="Core/Vixen.Core.Syntax.Tests/Vixen.Core.Syntax.Tests.csproj" />
    <Project Path="Core/Vixen.Core.Syntax.Generator/Vixen.Core.Syntax.Generator.csproj" />
  </Folder>

  <!--
    Platform — one folder per deployment concern (docs/plan/02 § "Platform/").
    Contracts first, then the implementations. Headless is here from the start rather
    than as a Phase 9 retrofit: it is what the dedicated server runs on *and* what every
    test that needs a platform uses, so the no-display path cannot quietly rot.
  -->
  <Folder Name="/Platform/">
    <Project Path="Platform/Vixen.Platform/Vixen.Platform.csproj" />
    <Project Path="Platform/Vixen.Platform.Tests/Vixen.Platform.Tests.csproj" />
    <Project Path="Platform/Vixen.Platform.Headless/Vixen.Platform.Headless.csproj" />
    <Project Path="Platform/Vixen.Platform.Headless.Tests/Vixen.Platform.Headless.Tests.csproj" />
    <Project Path="Platform/Vixen.Platform.Desktop/Vixen.Platform.Desktop.csproj" />
    <Project Path="Platform/Vixen.Platform.Desktop.Tests/Vixen.Platform.Desktop.Tests.csproj" />
  </Folder>

  <!--
    Benchmarks — docs/plan/02 § Benchmarks/. Not built by `Test`; the Nuke `Benchmark`
    target runs them in Release and diffs against a committed baseline.
  -->
  <Folder Name="/Benchmarks/">
    <Project Path="Benchmarks/Vixen.Benchmarks.Math/Vixen.Benchmarks.Math.csproj" />
    <Project Path="Benchmarks/Vixen.Benchmarks.Jobs/Vixen.Benchmarks.Jobs.csproj" />
  </Folder>

  <!--
    Raven — the shader compiler.
    Layout follows docs/plan/02-repository-layout.md § "Raven/": one folder per
    project, named after the assembly, with tests as a sibling (ADR-014).
  -->
  <Folder Name="/Raven/">
    <File Path="Raven/Directory.Build.props" />
    <File Path="Raven/README.md" />
    <Project Path="Raven/Vixen.Raven/Vixen.Raven.csproj" />
    <Project Path="Raven/Vixen.Raven.Tests/Vixen.Raven.Tests.csproj" />
    <Project Path="Raven/Vixen.Raven.Cli/Vixen.Raven.Cli.csproj" />
  </Folder>

</Solution>
