<Project>

  <!--
    Vixen — what a PackageReference brings, for the projects that cannot make one.
    Spec: docs/plan/02-repository-layout.md § "Shared MSBuild"

    ==================================================================================================
    ⚠ **Outside this repository a UI project writes nothing at all.** `Vixen.Ui` ships its build
    assets in `buildTransitive/`, so a project whose only line is
    `<PackageReference Include="Vixen.Ui.Controls" />` gets the `.vxml` compiler, the `.vcss` glob and
    the utility stylesheet step with no plumbing — verified by extracting the produced packages and
    building against them, which is a thing that had never been done.

    Inside it there are no packages. MSBuild assets and analyzers do not travel through a
    `ProjectReference`, so every in-repo project with an interface used to write out by hand what the
    package would have imported: two analyzer references, a build-order reference to the style-sheet
    tool, an `EmbeddedResource` glob, and an `Import` — ⚠ which had to sit at the *bottom* of the
    file, because the globs must run after `DefaultItemExcludes` is final, and which silently gave
    the wrong item set anywhere else.

    This file is the stand-in, and the ordering trap goes away with it: MSBuild imports
    `Directory.Build.targets` after everything the project wrote, which is exactly where those globs
    belong, so there is no longer a wrong place to put them.
    ==================================================================================================

    **`VixenUi` is the declaration, and it is the only line.** It says the same thing the
    `PackageReference` says outside — "this project has an interface in it" — and it is spelled
    rather than sniffed on purpose. Wiring every project that merely *references* `Vixen.Ui` would
    reach nine that do not want it: `Vixen.Ui.Markup.Tests` keeps deliberately malformed `.vxml`
    fixtures that must not be compiled as components, and `Vixen.Ui.Styling.Utilities.Tests` keeps
    `.vcss` that is input to a test rather than a stylesheet to embed.
  -->

  <PropertyGroup>
    <VixenUi Condition="'$(VixenUi)' == ''">false</VixenUi>
    <VixenRepositoryRoot>$(MSBuildThisFileDirectory)</VixenRepositoryRoot>

    <!--
      ==============================================================================================
      ⚠ **The two flags, captured here because an item cannot read them where they are set.**

      MSBuild evaluates a project in passes: *every* property and *every* import first, then the
      items. So an `ItemGroup` condition below reads the value a property has at the *end* of the
      property pass, not the value it had at that point in the file — and the imports at the bottom
      of this file set both of these. Conditioned on them directly, the analyzer references below
      were skipped in every project, the `.vxml` reached the compiler as an `AdditionalFiles` item
      with no generator loaded to read it, and the build succeeded with no components in it.

      A property *assignment* is different: those do happen in document order. Reading the flags into
      two names before the imports run is therefore the only way to ask "did the project wire itself
      up, or am I about to?" — and the answer is what keeps this file out of the way of the fourteen
      projects that still name everything by hand.

      ⚠ **The count in this file said fifteen for three revisions; recounting it gave twelve, and by
      the time that reached this file it was fourteen.** That is the whole lesson rather than a
      correction: a number written in a comment is a number nothing measures. It is fourteen on this
      tree — five in `Core/` and nine under `Editor/` — counted by grepping every committed
      `.csproj` for a literal import of `Core/Vixen.Ui/build/Vixen.Ui.targets`. Recount rather than
      trust it.

      ⚠ **The command is described here rather than quoted, and that is not fussiness.** An XML
      comment may not contain two hyphens in a row, so a long-form grep flag written inside one
      makes this file unloadable and every project in the tree fails to evaluate — with an error
      about the XML rather than about the count.
      ==============================================================================================
    -->
    <_VixenUiWiredByProject>$(VixenUiBuildImported)</_VixenUiWiredByProject>
    <_VixenStylesWiredByProject>$(VixenUtilityStylesImported)</_VixenStylesWiredByProject>
  </PropertyGroup>

  <!--
    The item types, from the same file the package imports. Guarded by the flag that file sets, so a
    project that still names it by hand — there are fourteen, and converting them is a separate change
    — keeps its own import and gets no second copy of either glob.
  -->
  <Import Project="$(VixenRepositoryRoot)Core/Vixen.Ui/build/Vixen.Ui.targets"
          Condition="'$(VixenUi)' == 'true' AND '$(_VixenUiWiredByProject)' != 'true'" />

  <!--
    The utility stylesheet step, on the same terms. `Vixen.Editor.Ui.Styling.targets` reaches this
    file too, for the dozen editor assemblies that share one `@theme`; its flag is what keeps this
    import from being a second one.
  -->
  <Import Project="$(VixenRepositoryRoot)Core/Vixen.Ui.Styling.Utilities/build/Vixen.Ui.Styling.Utilities.targets"
          Condition="'$(VixenUi)' == 'true' AND '$(_VixenStylesWiredByProject)' != 'true'" />

  <!--
    ⚠ The two generators, which is the half a `ProjectReference` provably cannot carry:
    `OutputItemType="Analyzer"` contributes one DLL and nothing transitive, so the assembly that
    declares a `[UiProperty]` or owns a `.vxml` is the one that has to name them.
    `Vixen.Ui.Generators` turns a `[UiProperty]` into a property the style system can see;
    `Vixen.Ui.Markup.Generators` is the VXML compiler.
  -->
  <ItemGroup Condition="'$(VixenUi)' == 'true' AND '$(_VixenUiWiredByProject)' != 'true'">
    <ProjectReference Include="$(VixenRepositoryRoot)Core/Vixen.Ui.Generators/Vixen.Ui.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />

    <ProjectReference Include="$(VixenRepositoryRoot)Core/Vixen.Ui.Markup.Generators/Vixen.Ui.Markup.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!--
    ⚠ **A build-order reference and nothing else** — `ReferenceOutputAssembly="false"`, so no assembly
    is referenced and nothing of the tool reaches the output. The step above invokes
    `Tools/Vixen.StyleGen`, and only a `ProjectReference` makes MSBuild build it first; outside this
    repository the tool travels inside `Vixen.Ui.Styling.Utilities`' own `tools/` and there is
    nothing to order.

    ⚠ Conditioned on the project actually having a palette, and the item to test is the one the
    import above has just globbed. A project with no `vixen.ui.vcss` never launches the tool — the
    generation target says so in its own condition — so ordering a build against it would be a
    dependency taken for a step that does not run, and, for a `Core/` project, an edge into `Tools/`
    that `CheckArchitecture` reads project files to forbid.
  -->
  <ItemGroup Condition="'$(VixenUi)' == 'true' AND '@(VixenUiTokens)' != ''">
    <ProjectReference Include="$(VixenRepositoryRoot)Tools/Vixen.StyleGen/Vixen.StyleGen.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!--
    ================================================================================================
    ⚠ **VX4001 — a `.vxml` on disk that nothing compiles, which until now was not a diagnostic and
    was instead thirty C# errors about the wrong file.**

    `Vixen.Editor.Water` had never had a `.vxml`, so it had never had the wiring, so when the first
    three arrived the generator did not run, they were not items at all, and the build failed with
    "`WaterZoneFacts` does not contain a definition for `Show`" once per member the markup declares.
    Every one of those messages names the hand-written half of a partial class that is *correct*.
    The mistake is in the project file, and nothing said so; the standing advice was to
    `grep -c Vixen.Ui.Markup.Generators` the `.csproj` before writing an assembly's first `.vxml`,
    which is a prescription that only exists because the build was silent.

    ⚠ **And "the build fails, loudly, eventually" is the *good* case.** A `.vxml` with no
    hand-written partner has nothing to fail to compile against: the file is simply not read, the
    component does not exist, and the build succeeds. That is the shape `Core/Vixen.Ui`'s own
    `.csproj` records as having happened — "a `.vxml` beside a `Program.cs` was silently not
    compiled". Silence is what this target is for; the noisy case is a bonus.

    **This lives here and not in `Vixen.Ui.targets`, and there is no choice about it.** The whole
    failure is that `Vixen.Ui.targets` was never imported, so a check inside it is a check inside
    the thing that is missing. `Directory.Build.targets` is imported by every project in this tree
    whatever it says about itself, which is the only place a "you did not wire this up" check can
    stand. ⚠ **The consequence is that it is an in-repo check only, and that is a real limitation
    rather than an oversight**: outside this repository a project with a `.vxml` and no reference to
    any `Vixen.Ui` package imports nothing of ours and there is no hook to put this in. What saves
    package consumers is that they cannot reach this state by halves — `Vixen.Ui` ships its build
    assets in `buildTransitive/`, so the reference that brings the types brings the glob and the
    generator together, and the only way to have the one without the other is to say
    `EnableVixenMarkup=false` on purpose. VX4002 in `Vixen.Ui.targets` covers the rest, and that one
    does travel.

    **The glob is at evaluation time and the comparison is in a target, deliberately.** Globbing
    here rather than inside the target puts the enumeration in the same pass — and the same
    per-directory cache — as the `**/*.cs` glob that has already walked this tree, instead of paying
    for a second recursive walk of every project on every build. Comparing inside a target is what
    makes the answer trustworthy: `AdditionalFiles` is final by `CoreCompile` and is not final at
    the end of evaluation, and this file is imported after the fourteen projects that still write
    their own `Import` at the bottom of their body.

    ⚠ `DefaultItemExcludes` and `DefaultExcludesInProjectFolder`, spelled out, for the reason the
    panel ledger names: `Vixen.Editor.Ui.Tests` copies another project's markup into its output as
    fixtures, and a glob that forgets `bin/` finds every one of them and blames a project that never
    authored a `.vxml`.
    ================================================================================================
  -->
  <ItemGroup>
    <_VixenMarkupOnDisk Include="**/*.vxml" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
  </ItemGroup>

  <!--
    `EnableVixenMarkup=false` is already the switch that says "do not compile markup here" — it is
    what turns the glob in `Vixen.Ui.targets` off — so a project that has said it has said this too
    and must not then be told off for the consequence. `VixenUiMarkupCheck` is the narrower escape,
    for a project that holds `.vxml` which is *not its own*: see `Tools/Vixen.Templates`, whose
    markup is a file to copy into somebody else's project rather than a component of this one.
  -->
  <Target Name="VixenCheckMarkupIsCompilerInput"
          BeforeTargets="CoreCompile"
          Condition="'$(VixenUiMarkupCheck)' != 'false' AND '$(EnableVixenMarkup)' != 'false' AND '@(_VixenMarkupOnDisk)' != ''">
    <ItemGroup>
      <!--
        Full paths on both sides. `AdditionalFiles` reaches here spelled however whoever added it
        felt like spelling it — the glob's own entries are relative, a hand-written one may be
        absolute, and on a `Link`ed item the identity is not a path on disk at all — so an `Exclude`
        that compares identities compares two different notations for the same file and reports a
        project that is perfectly wired.
      -->
      <_VixenMarkupIsInput Include="@(AdditionalFiles->'%(FullPath)')" />
      <_VixenMarkupUncompiled Include="@(_VixenMarkupOnDisk->'%(FullPath)')" Exclude="@(_VixenMarkupIsInput)" />
    </ItemGroup>

    <Error Condition="'@(_VixenMarkupUncompiled)' != ''"
           Code="VX4001"
           File="$(MSBuildProjectFullPath)"
           Text="Vixen: @(_VixenMarkupUncompiled->Count()) .vxml file(s) in this project are not compiler input — @(_VixenMarkupUncompiled->'%(Identity)', ', ') — so the VXML compiler never sees them and the classes they declare will not exist. This project globs no markup: it neither imports Vixen.Ui.targets nor sets VixenUi. What happens next is either a wall of C# errors naming the hand-written half of a partial class that is correct, or, for a .vxml with no hand-written half, nothing at all. The one line that fixes it is &lt;VixenUi&gt;true&lt;/VixenUi&gt; in this project's first PropertyGroup — Directory.Build.targets turns that into the .vxml and .vcss item types and the two UI generators. It does not add a reference to Vixen.Ui itself; the generated code calls that, so the project needs one. If the markup here is deliberately not compiled — a template, a fixture — set &lt;VixenUiMarkupCheck&gt;false&lt;/VixenUiMarkupCheck&gt; and write down why." />
  </Target>

</Project>
