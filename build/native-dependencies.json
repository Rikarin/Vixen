// Vixen — the pinned native dependencies, and where they come from.
//
// Spec: docs/plan/10-platforms.md § Native binaries, and R10 in docs/plan/15.
//
// Every native binary the engine ships is listed here and nowhere else. None of them is committed:
// `nuke RestoreNativeDeps` downloads each archive, refuses it unless its SHA-256 matches the value
// below, extracts only the named files, and writes a licence manifest from the licence text inside
// the archive rather than from a URL that can change under us. A dependency update is therefore an
// edit to this file and a review of one diff.
//
// JSON with comments, deliberately: a pinned version is a decision, and a decision that cannot carry
// its reason beside it gets changed by someone who does not know what it was for. The reader is
// configured to skip comments and allow trailing commas.
//
// `sha256` is over the archive exactly as downloaded. To pin a new version: change the URL, run the
// target, and it will fail with the hash it actually got — put that in. Do not copy a hash from a
// release page you have not fetched.
{
  "dependencies": [
    {
      "id": "moltenvk",
      "name": "MoltenVK",
      "version": "1.4.1",
      "homepage": "https://github.com/KhronosGroup/MoltenVK",
      "licence": "Apache-2.0",
      "licenceFile": "MoltenVK/LICENSE",

      // Why 1.4.1 and not 1.4.2, which exists: 1.4.2 was published three days before this was
      // pinned, and the whole value of pinning is that moving is a decision somebody makes rather
      // than a thing that happens. 1.4.1 has been out since 2025-11-30 and postdates Xcode 26.
      "notes": "Vulkan over Metal. Only the static library is used, and only for iOS — see the artifact note.",

      "artifacts": [
        {
          // iOS links everything statically, so Silk.NET's DllImports become direct symbol
          // references that something has to satisfy at link time. This is that something: 431
          // exported vk* symbols, including the twelve the link was failing on. See R11.
          //
          // Device only. The tar ships no simulator slice, and the gate targets ios-arm64, which is
          // the RID doc 10 makes NativeAOT-only and therefore the one the exit criterion is about.
          "rid": "ios-arm64",
          "url": "https://github.com/KhronosGroup/MoltenVK/releases/download/v1.4.1/MoltenVK-ios.tar",
          "sha256": "54336b90212c390ed5935c96460aed3bf651ad7d3c0f0e956586ce18e9c0b701",
          "size": 31771648,
          "files": [
            {
              "from": "MoltenVK/MoltenVK/static/MoltenVK.xcframework/ios-arm64/libMoltenVK.a",
              "to": "libMoltenVK.a"
            }
          ]
        },
        {
          // The simulator, which doc 10's CI matrix wants for a per-PR smoke test and which is the
          // only way to run an iOS build without a provisioning profile and a physical device.
          //
          // `optional`, and that is about size rather than importance: the simulator slice is only
          // published in MoltenVK-all.tar, which is 173 MB against the device tar's 31 MB. Restoring
          // it on every clone to serve a target most builds do not use is the wrong default, so it
          // is fetched by `nuke RestoreNativeDeps --all-native-deps` and by the targets that need it.
          "rid": "iossimulator-arm64",
          "optional": true,
          "url": "https://github.com/KhronosGroup/MoltenVK/releases/download/v1.4.1/MoltenVK-all.tar",
          "sha256": "2c498bf8c98b88ba1e84c1f153403d4c1a8490c122d9e2a3df238b25d4e10557",
          "size": 173033984,
          "files": [
            {
              // Fat: arm64 for an Apple-silicon Mac and x86_64 for an Intel one, in one archive
              // member. The linker takes the slice it needs.
              "from": "MoltenVK/MoltenVK/static/MoltenVK.xcframework/ios-arm64_x86_64-simulator/libMoltenVK.a",
              "to": "libMoltenVK.a"
            }
          ]
        }
      ]
    },
    {
      "id": "wgpu-native",
      "name": "wgpu-native",
      "version": "0.19.4.1",
      "homepage": "https://github.com/gfx-rs/wgpu-native",
      "licence": "MIT OR Apache-2.0",

      // No licence text is extracted, and that is the archive's shape rather than an omission: these
      // releases ship the two headers, the libraries and a commit sha, and nothing else. The
      // obligation is recorded in NOTICE instead. Worth knowing before anything is redistributed.
      "licenceFile": null,

      // WHY 0.19.4.1 AND NOT SOMETHING NEWER, WHICH IS THE ONLY INTERESTING THING ABOUT THIS PIN.
      //
      // `Silk.NET.WebGPU` 2.23.0 binds a particular revision of webgpu.h, and the C API was still
      // moving underneath it. Three entry points the backend calls — wgpuAdapterGetProperties,
      // wgpuDeviceSetUncapturedErrorCallback and wgpuSurfaceGetPreferredFormat — were REMOVED by
      // v22.1.0.1 (August 2024) in favour of wgpuAdapterGetInfo and friends. 0.19.4.1 is the last
      // release that exports all of them, and it is therefore the newest wgpu-native this binding
      // can load at all.
      //
      // That was measured, not guessed: `nm` over the dylib against the set of wgpu* entry points
      // the backend's Native/ folder actually calls. WebGpuSymbolTests re-runs exactly that check
      // against whatever has been restored, so a version bump that drops one is a red build rather
      // than a null function pointer at the first draw.
      //
      // Moving forward means moving Silk.NET.WebGPU forward first, and 2.23.0 is what
      // Directory.Packages.props pins for every other Silk binding.
      "notes": "WebGPU over Vulkan, Metal or D3D12. Nothing ships this: no desktop OS has a WebGPU implementation, and Silk.NET.WebGPU is bindings only.",

      "artifacts": [
        // The dynamic library only. The static archive in the same zip is three to four times the
        // size and nothing links it — WebGpuLoader loads at run time through NativeLibrary, the way
        // VulkanLoader does, which is what keeps the AOT gate at zero diagnostics.
        {
          "rid": "osx-arm64",
          "url": "https://github.com/gfx-rs/wgpu-native/releases/download/v0.19.4.1/wgpu-macos-aarch64-release.zip",
          "sha256": "21cf8e69a4a775ea63f437f170a93e371df0f72c83119c81c25a668611c1771d",
          "size": 10693758,
          "files": [{ "from": "libwgpu_native.dylib", "to": "libwgpu_native.dylib" }]
        },
        {
          "rid": "osx-x64",
          "url": "https://github.com/gfx-rs/wgpu-native/releases/download/v0.19.4.1/wgpu-macos-x86_64-release.zip",
          "sha256": "e41a35bf4f2b1c7dd87092cfcb932b7a96118971129a6213b7be240deb07e614",
          "size": 10724388,
          "files": [{ "from": "libwgpu_native.dylib", "to": "libwgpu_native.dylib" }]
        },
        {
          "rid": "linux-x64",
          "url": "https://github.com/gfx-rs/wgpu-native/releases/download/v0.19.4.1/wgpu-linux-x86_64-release.zip",
          "sha256": "7d73bd7af2be60b632e5ab814996acb381d1b459975d6629f91c468049c8866a",
          "size": 14190033,
          "files": [{ "from": "libwgpu_native.so", "to": "libwgpu_native.so" }]
        },
        {
          "rid": "linux-arm64",
          "url": "https://github.com/gfx-rs/wgpu-native/releases/download/v0.19.4.1/wgpu-linux-aarch64-release.zip",
          "sha256": "6e53aa3f0aec4b2b65cb0d7635000cf39bddd672bcb6138a593bf8cb8134f621",
          "size": 14732180,
          "files": [{ "from": "libwgpu_native.so", "to": "libwgpu_native.so" }]
        },
        {
          "rid": "win-x64",
          "url": "https://github.com/gfx-rs/wgpu-native/releases/download/v0.19.4.1/wgpu-windows-x86_64-release.zip",
          "sha256": "9e1591d60c2d2ee20d6d4a63bc01c7c5eecf7734761673160aa639e550a1ba4d",
          "size": 13630453,
          "files": [{ "from": "wgpu_native.dll", "to": "wgpu_native.dll" }]
        }

        // win-arm64 is absent because 0.19.4.1 does not publish it — the first
        // wgpu-windows-aarch64-msvc asset is v22.1.0.1, which this binding cannot load. A Windows on
        // Arm machine therefore has no WebGPU backend and falls through to Vulkan, which is what
        // backend selection is for.
      ]
    }
  ]
}
