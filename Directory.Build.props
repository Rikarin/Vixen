<Project>

  <!--
    Vixen — shared build properties for every project in the repository.
    Spec: docs/plan/02-repository-layout.md § "Shared MSBuild"
    Policy: docs/plan/00-vision-and-principles.md § "Non-negotiables"
  -->

  <PropertyGroup Label="Identity">
    <Product>Vixen</Product>
    <Company>Rikarin</Company>
    <Authors>Jiu</Authors>
    <Copyright>Copyright (c) Rikarin</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rikarin/Vixen</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="Language">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Label="Analysis">
    <!--
      TreatWarningsAsErrors is a stated non-negotiable (docs/plan/00 § Non-negotiables).
      The tree is warning-free; Raven/Directory.Build.props records what was fixed to
      get there and suppresses nothing.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!--
      Measured, not guessed. Unique findings across the whole solution:
        latest-default       0
        latest-recommended   285  → 16 after two domain exclusions (below)
        latest-all           334  → 65, dominated by API-design rules that are
                                    actively wrong for a compiler
      `latest-recommended` is therefore the enforced level. docs/plan/00 originally
      specified `latest-all`; that was aspirational and is corrected there.
      Rules disabled by name, with reasons, live in .editorconfig — a named
      exclusion is reviewable, a lowered level is not.
    -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Determinism and symbols">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Label="Generated code visibility">
    <!--
      ADR-002 requires generated C# be on disk and steppable. Deliberately NOT
      setting CompilerGeneratedFilesOutputPath: the default lands under obj/,
      which the SDK excludes from the **/*.cs compile glob. Redirecting it
      anywhere inside the project directory makes the compiler pick the emitted
      files up as sources *in addition to* the in-memory generator output, which
      produces thousands of CS0111 duplicate-member errors.
    -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!--
    Not setting ArtifactsPath. The .NET artifacts output layout relocates every
    project's bin/obj and is an opt-in migration in its own right, not something
    to enable in passing while wiring up a solution file.
  -->

  <!--
    ============================================================================
    Profile: RUNTIME  —  Core/**, Gameplay/** and Platform/**, excluding tests.
    AOT- and trim-clean is mandatory here; iOS is NativeAOT-only.

    Gameplay/ is here rather than in a profile of its own because doc 28's
    libraries are engine-side runtime code by every test that matters: they run
    in the frame, a client links them, and a phone runs the client. The folder
    exists (docs/plan/02 § Gameplay/) so that "items, quests, combat" is a layer
    a game can decline rather than something Core/ grew.
    ============================================================================
  -->
  <PropertyGroup Condition="($(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)Core')) OR
                             $(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)Gameplay')) OR
                             $(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)Platform'))) AND
                            !$(MSBuildProjectName.EndsWith('.Tests')) AND
                            !$(MSBuildProjectName.EndsWith('.Generator')) AND
                            !$(MSBuildProjectName.EndsWith('.Generators')) AND
                            !$(MSBuildProjectName.EndsWith('.Analyzers'))">
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    ============================================================================
    Profile: COMPILER PLUGIN  —  *.Generator / *.Generators / *.Analyzers,
    wherever they live.
    Generators and analyzers run inside the compiler, so they target
    netstandard2.0/2.1 and are never published: AOT, trimming and single-file
    analysis do not apply to them, and the Runtime profile above would demand all
    three of a project that cannot satisfy them. Excluded there, handled here.
    ============================================================================
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Generator')) OR
                            $(MSBuildProjectName.EndsWith('.Generators')) OR
                            $(MSBuildProjectName.EndsWith('.Analyzers'))">
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    ============================================================================
    Profile: TOOLING  —  Editor/**, Tools/**, Raven/**.
    Reflection and LINQ permitted; these are compilers and editors, not frame code.
    ============================================================================
  -->
  <PropertyGroup Condition="($(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)Editor')) OR
                             $(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)Tools')) OR
                             $(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)Raven'))) AND
                            !$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    ============================================================================
    Profile: LIVE  —  Live/**, the online service tier (docs/plan/27).
    Shipped and operated rather than run by a developer, which is why it is
    neither of the two profiles above: it packs and it documents like runtime
    code, and it runs JIT on a server we control like tooling does.

    ADR-016 is what makes that combination honest — Orleans and ASP.NET are not
    NativeAOT-clean end to end and do not need to be, because they appear only
    here. The one exception is Vixen.Live.Abstractions, which turns AOT and trim
    analysis back on in its own csproj: a client transitively references it, and
    a client is an iOS NativeAOT binary.
    ============================================================================
  -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)Live')) AND
                            !$(MSBuildProjectName.EndsWith('.Tests')) AND
                            !$(MSBuildProjectName.EndsWith('.Generator')) AND
                            !$(MSBuildProjectName.EndsWith('.Generators')) AND
                            !$(MSBuildProjectName.EndsWith('.Analyzers'))">
    <IsPackable>true</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    ============================================================================
    Profile: TEST  —  any project named *.Tests.
    ============================================================================
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) OR '$(MSBuildProjectName)' == 'Tests'">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      ============================================================================
      Run through Microsoft.Testing.Platform rather than VSTest (#560).

      A xunit.v3 test assembly is an executable that hosts its own runner — the
      `OutputType` in every test csproj says so. VSTest ignored that and started
      two more processes per assembly to talk to it: measured with
      `ps -ax -o pid,args` during a run, `vstest.console.dll` and `testhost.dll`
      alongside the executable itself, ~1 s of protocol per assembly across 180 of
      them. Setting `TestingPlatformDotnetTestSupport` re-points MSBuild's `VSTest`
      target at `InvokeTestingPlatform`, which launches the assembly directly.

      ⚠ **This needed no package and no csproj edit, which is the opposite of what
      four audits of #560 concluded.** They costed the migration at 180
      `PackageReference` additions. `Microsoft.Testing.Platform.MSBuild` 1.9.1 is
      already in every test project's graph — `xunit.v3` 3.2.2 resolves to
      `xunit.v3.mtp-v1` → `xunit.v3.core.mtp-v1`, which depends on it and on
      `Microsoft.Testing.Platform` itself. Only the TRX writer is genuinely new,
      and one item here reaches all 180 projects.

      ⚠ **And it stays revertible on one line**, which is why
      `xunit.runner.visualstudio` and `Microsoft.NET.Test.Sdk` are still
      referenced: setting `TestingPlatformDotnetTestSupport=false` on a single
      invocation puts that invocation back on VSTest. `Coverage` relies on exactly
      that (build/Build.Coverage.cs) — its cobertura collector is a VSTest data
      collector, not something the platform has.
      ============================================================================
    -->
    <!--
      ⚠ **A VSTest-only switch on the command line takes the whole invocation back to VSTest**, and
      this line is the difference between the inner loop working and looking like it worked.
      `dotnet test <project>` with a test-case filter is the command CLAUDE.md hands every reader;
      that switch sets `VSTestTestCaseFilter`, which the platform does not read, and `MTP0001` is a
      *warning* rather than an error — so a filtered run silently became the whole assembly and
      exited green having done far more than it was asked. (Caught here by the warning line on a
      95-test assembly that had been asked for 8.) The settings-file and data-collector switches are
      the same shape; `Coverage` depends on the second and asks for this explicitly rather than
      relying on it. Falling back costs the ~1 s of VSTest protocol on one project, which is exactly
      the run where a second does not matter. The switch names are spelled around rather than
      written: XML forbids a double hyphen inside a comment, which is the trap the results-directory
      note below and `Directory.Build.targets` both record.
    -->
    <TestingPlatformDotnetTestSupport Condition="'$(TestingPlatformDotnetTestSupport)' == '' AND ('$(VSTestTestCaseFilter)' != '' OR '$(VSTestSetting)' != '' OR '$(VSTestCollect)' != '')">false</TestingPlatformDotnetTestSupport>
    <TestingPlatformDotnetTestSupport Condition="'$(TestingPlatformDotnetTestSupport)' == ''">true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner Condition="'$(TestingPlatformDotnetTestSupport)' == 'true'">true</UseMicrosoftTestingPlatformRunner>
    <!--
      Name the TRX after the project that produced it. Left to itself the logger
      names the file after the machine and the second it finished, which for
      eighteen projects finishing inside the same three seconds gives a directory
      of `_Jius-MBP_…_net10.0[4].trx` — every result present, none of them
      attributable without opening the file. The escaped semicolon (%3b) is
      required: an unescaped one ends the property value in MSBuild.

      This lives here rather than in build/Build.cs because the value depends on
      MSBuildProjectName, which only means anything inside the project being built.

      ⚠ Two spellings of the same requirement, because the two runners take it
      differently and `MTP0001` downgrades a VSTest property to a *warning* rather
      than an error when the platform is driving. A `VSTestLogger` left set on the
      platform path would be one warning line inside a 500-second log and eighteen
      unattributable files — so it is set only on the path that reads it.
    -->
    <VSTestLogger Condition="'$(TestingPlatformDotnetTestSupport)' != 'true'">trx%3bLogFileName=$(MSBuildProjectName).trx</VSTestLogger>
    <TestingPlatformCommandLineArguments Condition="'$(TestingPlatformDotnetTestSupport)' == 'true'">--report-trx --report-trx-filename $(MSBuildProjectName).trx</TestingPlatformCommandLineArguments>
    <!--
      ⚠ `VSTestResultsDirectory` is the one VSTest property the platform path still
      reads, and it is re-routed here rather than honoured: `MTP0001` will name it,
      and the run still writes where it was told. Without this line a TRX lands in
      `bin/<config>/<tfm>/TestResults` and `Test`'s own count-the-TRX assertion is
      what notices — which is the instrument working, not a reason to rely on it.
    -->
    <TestingPlatformCommandLineArguments Condition="'$(TestingPlatformDotnetTestSupport)' == 'true' AND '$(VSTestResultsDirectory)' != ''">$(TestingPlatformCommandLineArguments) --results-directory "$(VSTestResultsDirectory)"</TestingPlatformCommandLineArguments>

    <VSTestLogger>trx%3bLogFileName=$(MSBuildProjectName).trx</VSTestLogger>

    <!--
      The root `.runsettings`, for the command CLAUDE.md actually recommends.

      ⚠ Nothing discovers this file. `dotnet test` does not look for a
      `.runsettings` beside the solution, and until this line existed the file
      reached exactly four call sites, all inside `build/` — `Test`,
      `GoldenImages`, `AffectedTests` and `Coverage`. So
      `dotnet test Platform/Vixen.Graphics.Vulkan.Tests`, which the working
      agreement prefers over `./build.sh`, ran the Vulkan suite with the Khronos
      validation layer enumerated and inert, and
      `VulkanInstanceTests.ValidationIsOnWhereTheLayerIsInstalled` — which fails
      rather than skips where a layer is installed and off — went red saying
      nothing was wrong with the code.

      ⚠ And it was invisible from a developer's own terminal, which is the half
      worth writing down. `DYLD_LIBRARY_PATH=/opt/homebrew/lib` exported from a
      shell profile makes that test pass whatever the settings say, so the
      question "are the validation layers on?" answered yes here and no in an
      IDE, in a `launchctl` session and on a runner. Measured both ways on
      2026-09-06: green with the ambient variable, red with `DYLD_LIBRARY_PATH=`
      in front of the same command. That is precisely the drift `.runsettings`
      says it exists to remove, and it had removed it for four callers out of
      five.

      Here rather than in each test project for the reason `VSTestLogger` above
      is: 178 projects cannot be relied on to remember, and the one that forgets
      is invisible.

      The four explicit callers keep working and keep winning:
      `Microsoft.TestPlatform.targets` resolves the task's settings as
      `ValueOrDefault($(VSTestSetting), '$(RunSettingsFilePath)')`, so a
      `-p:VSTestSetting=` or the settings switch on the command line overrides
      this, and this only fills in when neither was given. (⚠ Spelling that
      switch out is not an option: XML forbids a double hyphen inside a comment,
      which is the same trap `.runsettings` and `Directory.Build.targets` both
      record — and it makes every project in the tree fail to evaluate with an
      error about the XML rather than about the build.)

      ⚠ It is a runsettings property, so #560's Microsoft.Testing.Platform
      migration discards it — MTP reads no `.runsettings` at all, and
      `_ValidateVSTestProperties` downgrades this family to warning MTP0001
      rather than erroring. Whatever starts the test host under MTP has to set
      the variable itself, in one place, or this comes back.
    -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory).runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <!--
    The TRX writer, for the platform path. VSTest carried a TRX logger in
    `Microsoft.NET.Test.Sdk`; the platform does not, and every analysis this
    repository has done of its own test cost — #552, #557, #558, #559, #863's
    cost table — was possible only because each run leaves a file named after its
    assembly. `TrxReport.Abstractions` arrives transitively and is not the writer.

    ⚠ Pinned to 1.9.1 and it must stay on 1.x. 2.0.0 is what NuGet resolves by
    default and it dies before running a test against xunit.v3 3.2.2 —
    `TypeLoadException: Could not load type ... IDataConsumer from assembly
    Microsoft.Testing.Platform, Version=2.0.0.0`, because xunit binds the 1.x
    platform. Directory.Packages.props carries the pin.

    Here rather than in 180 csproj files for the reason `VSTestLogger` is: the one
    project that forgets is the one whose results go missing, and nothing says so.
  -->
  <!--
    ⚠ Two test projects turn central package management OFF for their own reasons —
    `Vixen.DocGen.Tests` and `Vixen.Templates.Tests`, each of which needs a Roslyn version the
    central pin forbids — so a version-less `PackageReference` has nothing to inherit there and
    restore fails with `NU1015` for the WHOLE solution rather than saying anything about those two.
    The second line is for them.

    ⚠ The version is written out rather than read from a `$(property)` shared with
    `Directory.Packages.props`, and that is deliberate after trying it the other way:
    `CheckAttributionManifest` reads the pinned version out of `Directory.Packages.props` as TEXT to
    compare it with `docs/manual/third-party.md`, so an indirection there makes the licence manifest
    unable to see what is pinned — a gate defeated by a tidier spelling. The two literals are held
    together by `TrxReporterPinTests`, which is where a bump gets caught.
  -->
  <ItemGroup Condition="($(MSBuildProjectName.EndsWith('.Tests')) OR '$(MSBuildProjectName)' == 'Tests') AND '$(TestingPlatformDotnetTestSupport)' == 'true'">
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Condition="'$(ManagePackageVersionsCentrally)' != 'false'" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" Condition="'$(ManagePackageVersionsCentrally)' == 'false'" />
  </ItemGroup>

  <!--
    ============================================================================
    The second concurrency multiplier, which the build's `workers` parameter
    cannot reach. (⚠ Its switch is spelled with two hyphens and so cannot be
    written here at all: XML forbids them inside a comment. `Directory.Build.targets`
    records the same trap, and it makes every project in the tree fail to
    evaluate with an error about the XML rather than about the build.)

    `workers` bounds how many test *assemblies* run at once (build/Build.cs).
    Inside each one xunit runs its collections on a thread pool sized to the
    processor count unless a config file says otherwise, and until this file
    existed nothing did — so a solution-wide run was 178 hosts multiplied by ten
    threads each, and even a capped run is the cap multiplied by ten.

    ⚠ **The link is the whole point, and an unlinked config file is worse than
    none** — xunit reads `xunit.runner.json` (or `<assembly>.xunit.runner.json`)
    from the directory the test assembly is in, and nowhere else. A file sitting
    at the repository root that is not copied beside each assembly is read by
    nobody, changes nothing, and reports success by looking present. `Link` is
    required because the file is outside every project's own directory: without
    it the item keeps a relative identity that climbs out of the output folder.

    Here rather than in each test project for the same reason `VSTestLogger` is:
    178 projects cannot be relied on to remember, and the one that forgets is
    invisible.

    ⚠ `0.5x` is measured rather than reasoned, from the per-test start and finish
    times in the 178 TRX of the 2026-09-05 sweep. Two readings out of that:

    * No assembly ran more than **five** collections at once, in any of the 178.
      That is the instrument check for the paragraph above — a file that failed
      to be copied beside its assembly reports ten, and reports it silently.
    * Doubling the pool to `1.0x` is worth **36 seconds across six assemblies**
      and nothing to the other 172, because a large assembly's floor is its
      longest *collection* and not its pool. ⚠ `Vixen.Editor.App.Tests` looks
      like the biggest winner and cannot win at all: it disables collection
      parallelism outright over a data race on the process-wide `Strings`
      signal, so it runs one collection at a time whatever this file says.

    So the halved pool costs almost nothing and is what keeps a capped run from
    being the cap multiplied by ten. Re-runnable by anyone holding that results
    directory, which is the point of stating it this way rather than in seconds
    off a stopwatch on a machine whose other load nobody recorded.

    ⚠ **A multiplier truncates, and on a small machine it truncates to one.**
    xunit computes a multiplier-style value as `(int)(m * ProcessorCount)` —
    a decimal-to-int cast, so it rounds toward zero and never up
    (`ConfigReader_Json`, xunit.v3.runner.common 3.2.2). Ten cores give the five
    that was measured; four give two; **three give one**, which is not "half the
    pool" but collection parallelism switched off. And one core gives zero, which
    `MaxParallelThreadsOrDefault` reads as "unset" and answers with the processor
    count — so the cap silently stops capping at exactly the size where it would
    matter most.

    ⚠ That is not hypothetical arithmetic, because `macos-14` is a **three-core**
    M1 runner (`ubuntu-latest` and `windows-latest` are four). A single committed
    file applies on CI exactly as it does locally, so `0.5x` everywhere means the
    macOS leg runs every one of the 178 assemblies with a one-thread collection
    pool. The number bounding a laptop is the wrong number for a runner that has
    the machine to itself, and this is the same split `Workers` already makes
    (four locally, unbounded in CI — build/Build.cs).

    So the file is chosen rather than fixed: `1.0x` in CI, which is what CI ran at
    for its whole history before the cap landed, and the measured `0.5x`
    everywhere else. `GITHUB_ACTIONS` rather than `CI` because the latter is
    exported by enough local tooling that a developer could lose the cap without
    noticing, and losing it is the failure this whole block exists to prevent.
    `Tools/Vixen.ApiCheck.Tests/TestParallelismTests.cs` holds both files to the
    truncation rule so neither can quietly become a one-thread pool again.
    ============================================================================
  -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <VixenXunitRunnerConfig Condition="'$(GITHUB_ACTIONS)' == 'true'">xunit.runner.ci.json</VixenXunitRunnerConfig>
    <VixenXunitRunnerConfig Condition="'$(VixenXunitRunnerConfig)' == ''">xunit.runner.json</VixenXunitRunnerConfig>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <!--
      ⚠ `Always` rather than `PreserveNewest`, and the difference is only visible
      now that there are two candidate sources for one output name. `PreserveNewest`
      compares timestamps, and the file that loses the comparison is the one that
      has been sitting in the checkout unmodified — so switching back from the CI
      configuration leaves the CI configuration in the output directory and nothing
      says so. One hundred bytes per test project per build buys that away.
    -->
    <None Include="$(MSBuildThisFileDirectory)$(VixenXunitRunnerConfig)"
          Link="xunit.runner.json"
          CopyToOutputDirectory="Always"
          Visible="false" />
  </ItemGroup>

  <!--
    ============================================================================
    The virtual-path rule, enforced.
    docs/plan/10-platforms.md § "Cross-platform discipline": only virtual paths in
    engine code; System.IO.Path is for Vixen.Platform.*, the editor and the tools.

    Referenced here rather than per project, because a rule that has to be opted
    into is a rule the next library forgets. Scope is Core/** minus tests,
    generators and the analyzer itself: Platform/**, Editor/**, Tools/** and
    Raven/** are where translating to a host path is the job, so they do not get
    the analyzer at all rather than getting it and switching it off.

    Where it still fires inside Core — PhysicalFileProvider, the watcher, the disk
    caches — .editorconfig turns it off by name with a reason, beside every other
    named exclusion.
    ============================================================================
  -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)Core')) AND
                        !$(MSBuildProjectName.EndsWith('.Tests')) AND
                        !$(MSBuildProjectName.EndsWith('.Generator')) AND
                        !$(MSBuildProjectName.EndsWith('.Generators')) AND
                        !$(MSBuildProjectName.EndsWith('.Analyzers'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Core\Vixen.Core.IO.Analyzers\Vixen.Core.IO.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!--
    Apache-2.0 §4(d) requires the NOTICE to travel with every distribution, so it goes
    into each package (ADR-015). The licence text itself does not need to be packed —
    PackageLicenseExpression above is the machine-readable form NuGet wants.

    This ItemGroup has to sit after the profiles: it reads IsPackable, which they set.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
