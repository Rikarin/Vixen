<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test projects host the runner themselves; see Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Raven.Transpile\Vixen.Raven.Transpile.csproj"/>
        <ProjectReference Include="..\Vixen.Raven\Vixen.Raven.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          ⚠ LINKED rather than copied. Every `compose` slot the library declares has to be bound for
          it to lower at all (RVN2073), and that binding list is thirteen entries long and changes
          whenever a slot is added. A second copy of it here would go stale the first time somebody
          adds a slot, and the failure would be "the library does not bind cleanly" in a suite that
          has nothing to do with composition — so this is the same file, compiled twice, and a
          change to it breaks both suites at once or neither.
        -->
        <Compile Include="..\Vixen.Raven.Tests\LibraryComposition.cs" Link="LibraryComposition.cs"/>
    </ItemGroup>
    <!--
        #1119's ratchet. The TEST profile in `Directory.Build.props` turns documentation generation
        off for every `*.Tests` project, so no `<see cref>` in any test assembly was ever checked —
        and a test's remarks are read at the worst possible moment, when the test has just gone red.
        CS1591 and CS1573 stay suppressed: "this public member has no comment" is a question about a
        packaged API surface, and a test assembly is not one.

        This project reported nothing when the whole tree was measured with the flag forced on, so
        here it is a latch rather than a repair — which is the point. An overload landing beside a
        cref written earlier is not historical rot; #821's own measurement watched it happen inside
        one working session.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
