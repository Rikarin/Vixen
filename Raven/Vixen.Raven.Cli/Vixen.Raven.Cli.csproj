<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>raven</AssemblyName>
        <RootNamespace>Vixen.Raven.Cli</RootNamespace>
    </PropertyGroup>

    <!--
      Shipped as a dotnet tool: `dotnet tool install -g Vixen.Raven.Cli`, then `raven`.
      PackageId is explicit because AssemblyName is `raven`, which would otherwise become
      the package id and squat a very generic name on nuget.org.
    -->
    <PropertyGroup>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>raven</ToolCommandName>
        <PackageId>Vixen.Raven.Cli</PackageId>
        <Description>
            Command-line front end for the Raven shader compiler: compiles .rvn source to GLSL
            and SPIR-V, and reports diagnostics with source spans.
        </Description>
        <PackageTags>shader;compiler;glsl;spirv;vulkan;raven;vixen;dotnet-tool</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Raven\Vixen.Raven.csproj"/>
        <!--
          The SPIRV-Cross targets (ADR-012). This is the ONE reference to that project in the
          repository, and it is deliberately from the tool rather than from the compiler library —
          see Vixen.Raven.Transpile.csproj for why.
        -->
        <ProjectReference Include="..\Vixen.Raven.Transpile\Vixen.Raven.Transpile.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine"/>
    </ItemGroup>

    <PropertyGroup>
        <!--
            #821's ratchet. The TOOLING profile in `Directory.Build.props` sets this false for all of
            `Editor/**`, `Tools/**` and `Raven/**`, so no `<see cref>` under any of them was ever
            checked — ask what that gate printed on the day it did not run: `0 Warning(s)`. CS1591
            and CS1573 stay suppressed: "this public member has no comment" is a question about a
            packaged API surface and is not what this is for; the rules that catch a *lie* are.
            Measured before flipping, and every diagnostic it reported is fixed in the same commit.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
