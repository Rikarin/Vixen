<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!--
            xunit v3 test projects are self-executing: the test assembly is an
            executable that hosts the runner itself, rather than a library loaded
            by an external one. This is the single required project change moving
            from v2, and omitting it produces a confusing "no tests found".
        -->
        <OutputType>Exe</OutputType>

        <!-- The generated ANTLR oracle code stamps [CLSCompliant]; harmless here. -->
        <NoWarn>$(NoWarn);CS3021</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Raven.Cli\Vixen.Raven.Cli.csproj"/>
        <ProjectReference Include="..\Vixen.Raven\Vixen.Raven.csproj"/>
    </ItemGroup>


    <!--
      The retired ANTLR front end lives on here as the differential oracle
      (docs/plan/18 § Keep the grammar): the grammar stays executable
      specification, and any divergence between it and the hand-written parser
      fails a test rather than shipping. Nothing of this reaches the package.
    -->
    <ItemGroup>
        <PackageReference Include="Antlr4.CodeGenerator">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Antlr4.Runtime"/>
    </ItemGroup>

    <ItemGroup>
        <Antlr4 Update="Oracle\RavenLexer.g4">
            <CustomToolNamespace>Vixen.Raven.Grammar</CustomToolNamespace>
        </Antlr4>
        <Antlr4 Update="Oracle\RavenParser.g4">
            <CustomToolNamespace>Vixen.Raven.Grammar</CustomToolNamespace>
        </Antlr4>
        <Antlr4 Update="Oracle\UnicodeClasses.g4">
            <CustomToolNamespace>Vixen.Raven.Grammar</CustomToolNamespace>
        </Antlr4>
    </ItemGroup>

    <!-- docs/plan/12's snapshot helper. Linked rather than referenced; the props file says why, and
         the four Golden*Tests here are what it was taken out of. -->
    <Import Project="..\..\Testing\Vixen.Testing.GoldenFile.props" />
    <!--
        #1119's ratchet. The TEST profile in `Directory.Build.props` turns documentation generation
        off for every `*.Tests` project, so no `<see cref>` in any test assembly was ever checked —
        and a test's remarks are read at the worst possible moment, when the test has just gone red.
        CS1591 and CS1573 stay suppressed: "this public member has no comment" is a question about a
        packaged API surface, and a test assembly is not one.

        This project reported nothing when the whole tree was measured with the flag forced on, so
        here it is a latch rather than a repair — which is the point. An overload landing beside a
        cref written earlier is not historical rot; #821's own measurement watched it happen inside
        one working session.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
