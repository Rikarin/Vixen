<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!--
            xunit v3 test projects are self-executing: the test assembly is an
            executable that hosts the runner itself, rather than a library loaded
            by an external one. This is the single required project change moving
            from v2, and omitting it produces a confusing "no tests found".
        -->
        <OutputType>Exe</OutputType>

        <!-- The generated ANTLR oracle code stamps [CLSCompliant]; harmless here. -->
        <NoWarn>$(NoWarn);CS3021</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Raven.Cli\Vixen.Raven.Cli.csproj"/>
        <ProjectReference Include="..\Vixen.Raven\Vixen.Raven.csproj"/>
    </ItemGroup>

    <!--
      The shipped library files, linked rather than copied, so ShippedLibraryTests compiles the same
      bytes a project consumes. Listed one by one on purpose: a glob would let a renamed file pass the
      test by not being there, which is the failure this gate exists to catch.
    -->
    <ItemGroup>
        <None Include="..\Library\Core\Math.rvn" Link="Library\Math.rvn" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="..\Library\Lighting\DistanceField.rvn" Link="Library\DistanceField.rvn" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!--
      The retired ANTLR front end lives on here as the differential oracle
      (docs/plan/18 § Keep the grammar): the grammar stays executable
      specification, and any divergence between it and the hand-written parser
      fails a test rather than shipping. Nothing of this reaches the package.
    -->
    <ItemGroup>
        <PackageReference Include="Antlr4.CodeGenerator">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Antlr4.Runtime"/>
    </ItemGroup>

    <ItemGroup>
        <Antlr4 Update="Oracle\RavenLexer.g4">
            <CustomToolNamespace>Vixen.Raven.Grammar</CustomToolNamespace>
        </Antlr4>
        <Antlr4 Update="Oracle\RavenParser.g4">
            <CustomToolNamespace>Vixen.Raven.Grammar</CustomToolNamespace>
        </Antlr4>
        <Antlr4 Update="Oracle\UnicodeClasses.g4">
            <CustomToolNamespace>Vixen.Raven.Grammar</CustomToolNamespace>
        </Antlr4>
    </ItemGroup>
</Project>
