package Vixen.Shaders.Reflections

import Vixen.Shaders.Core
import Vixen.Shaders.Geometry
import Vixen.Shaders.DistanceFields
import Vixen.Shaders.IrradianceFields
import Vixen.Shaders.SurfaceCache
import Vixen.Shaders.Shading

// Reflections through the same tracer, on the GPU.
//
// `docs/plan/19` § L5's kernel. `Vixen.Rendering.Reflections.TracedReflections` is the same
// arithmetic on the CPU and it exists first: the mirror formula, the threshold, the blend band and
// the fallback order are each pinned by a closed form there, and the device tests hold this against
// it texel by texel. Where the two disagree, the C# is right and this is wrong.
//
// The section's whole argument is reuse, and it shows in the slots: the mirror ray marches
// `IDistanceFieldSource` (L1), a hit answers through `ISurfaceCacheSource` (L4's seam, the same slot
// the bounce and the probe trace already compose), the rough path samples `IIrradianceSource` (L2)
// about the mirror direction, and a miss asks `IReflectionMissSource` — the slot doc 06's
// reflection probes fill the day their sampler implements it, which is what retires that row's
// "blended against the sky" caveat: the trace answers the near field, and the probe becomes what a
// miss sees.
//
// The inputs are surface planes rather than a G-buffer walk: a world position and a normal with
// roughness beside it, which is fixture-honest and exactly what a deferred pass has anyway. The
// reconstruction from a real frame's depth is the production wiring, not this kernel's concern.

/// What a reflection ray that found nothing should see — the far field, behind a slot.
protocol IReflectionMissSource {
    /// The radiance arriving from a direction nothing in the scene answered for.
    func MissRadiance(position: float3, direction: float3, roughness: float): float3
}

/// No far field at all: black, the honest answer of a project with neither probes nor sky.
shader NoReflectionMiss : IReflectionMissSource {
    func MissRadiance(position: float3, direction: float3, roughness: float): float3 => float3(0f, 0f, 0f)
}

/// One colour of sky — the far field every reflection in doc 06 sees beyond the probes today.
///
/// Bound by whoever owns the sky, under the slot's qualified name; the reflection-probe
/// implementation below replaces this without the kernel changing a line, which is the point of
/// the slot.
shader SkyMissSource : IReflectionMissSource {
    [PerFrame] var missSkyColor: float3 = float3(0f, 0f, 0f)

    func MissRadiance(position: float3, direction: float3, roughness: float): float3 => missSkyColor
}

/// One probe of the miss set: doc 06's volume plus the blend the shader never used to need.
///
/// Not `ReflectionProbeVolume`, deliberately: the forward pass weighs probes per OBJECT on the CPU,
/// so its struct carries no blend distance — here the weight is per query, so the distance rides
/// beside the volume rather than being retrofitted into a struct two other passes bind. The box is
/// flat fields rather than a nested `ProbeBox`, because struct declarations are emitted in file
/// order across the whole library and this package sorts before the one that declares the box —
/// the correction builds one locally, which costs three moves and breaks no emit.
struct ReflectionMissProbe {
    var minimum: float3
    var maximum: float3

    /// Where the cubemap was captured from, which is what the correction re-aims away from.
    var center: float3

    var radius: float
    var mipCount: float

    /// Over what distance the probe fades at its boundary, measured inward, in world units.
    var blendDistance: float
}

/// Doc 06's reflection probes, in the miss seat — the retirement of "blended against the sky".
///
/// `Vixen.Rendering.Lighting.ReflectionProbeMiss` is the CPU half: it answers the reference's
/// misses through the same corrections and the same inward-measured weight, and its `Apply` writes
/// every name declared here. A probe used to be the whole reflection and faded into nothing but
/// sky; behind the trace it answers only what the trace missed — the far field it is actually good
/// at — and the fade is a fade between two kinds of far field rather than a reflection vanishing.
///
/// Probes are consulted in bound order, first non-zero weight wins — the host sorts by priority,
/// the same contract the forward pass's array keeps. Four probes, fixed: the count sizes a binding,
/// and a composed shader's permutations are not host-selectable.
shader ReflectionProbeMissSource : IReflectionMissSource {
    [PerFrame] var missProbes: TextureCube[4]

    [PerFrame] var missProbeSampler: Sampler

    [PerFrame] var missProbeVolumes: ReflectionMissProbe[4]

    [PerFrame] var missProbeCount: int = 0

    /// What lies behind every probe — the sky, one colour.
    [PerFrame] var missFarColor: float3 = float3(0f, 0f, 0f)

    /// How much of a probe a point takes — `ReflectionProbe.WeightAt`, mirrored exactly.
    static func Weight(volume: ReflectionMissProbe, position: float3): float {
        var inside = 0f

        if (volume.radius > 0f) {
            inside = volume.radius - length(position - volume.center)
        } else {
            val low = position - volume.minimum
            val high = volume.maximum - position

            inside = min(min(min(low.x, high.x), min(low.y, high.y)), min(low.z, high.z))
        }

        if (inside <= 0f) {
            return 0f
        }

        if (volume.blendDistance <= 0f) {
            return 1f
        }

        return clamp(inside / volume.blendDistance, 0f, 1f)
    }

    func MissRadiance(position: float3, direction: float3, roughness: float): float3 {
        for (index in 0 .. 3) {
            if (index < missProbeCount) {
                val volume = missProbeVolumes[index]
                val weight = Weight(volume, position)

                if (weight > 0f) {
                    var corrected = direction

                    if (volume.radius > 0f) {
                        corrected = Ibl.ParallaxCorrectSphere(direction, position, volume.center, volume.radius)
                    } else {
                        corrected = Ibl.ParallaxCorrect(direction, position, ProbeBox(volume.minimum, volume.maximum, volume.center))
                    }

                    val sample = missProbes[index].SampleLevel(missProbeSampler, corrected, roughness * (volume.mipCount - 1f))

                    return lerp(missFarColor, sample.rgb, weight)
                }
            }
        }

        return missFarColor
    }
}

shader ReflectionTrace {
    /// What the mirror rays march through.
    compose val distanceField: IDistanceFieldSource = NoDistanceField

    /// What a ray that hits a surface sees — L4's seam, the slot every kernel here composes.
    compose val surfaceCache: ISurfaceCacheSource = NoSurfaceCache

    /// What the rough path reads instead of tracing — L2's field.
    compose val irradiance: IIrradianceSource = NoIrradiance

    /// What a miss sees — the probes' seat.
    compose val miss: IReflectionMissSource = NoReflectionMiss

    /// The reflecting surfaces: world position in `xyz`, validity in `a`.
    var reflectionPositions: Texture2D

    /// Their normals in `xyz`, roughness in `a`.
    var reflectionNormals: Texture2D

    /// The answer, radiance in `rgb` and validity in `a`.
    [Format("rgba32f")] var reflectionAtlas: RWTexture2D<float4>

    /// The frame's own depth, for the screen march the sharp path runs first. Always bound — a set
    /// with a hole in it binds nothing — and read only above zero `screenSteps`.
    var depthBuffer: Texture2D

    /// The frame's own colour, which is what a screen hit reflects — SSR by its plain name.
    var sceneColor: Texture2D

    /// The camera that drew `depthBuffer` and `sceneColor` — the forward matrix.
    var viewProjection: mat4

    /// The viewport those two cover, in pixels.
    var screenViewport: float2 = float2(0f, 0f)

    /// How many equal steps a screen ray takes over `maxDistance`. Zero is no screen trace at all.
    var screenSteps: int = 0

    /// How deep behind a surface a sample still counts as inside it, in device depth.
    var screenThickness: float = 0.02f

    /// The depth's nearest-per-cell chain — `HiZPyramid` wearing `NearestReduce`, so mip N holds
    /// level N + 1 of the march, the depth itself being level zero. Always bound (a set with a hole
    /// in it binds nothing); read only above zero `pyramidLevels`, so a host without a chain hands
    /// any texture in the sampled layout.
    var depthPyramid: Texture2D

    /// How many levels the hierarchical march may use, counting the depth as level zero — the CPU
    /// pyramid's own count. Zero is the fixed-step walk.
    var pyramidLevels: int = 0

    /// How deep the shell is in view units, where a perspective ray can say. Zero keeps the
    /// device-depth shell everywhere — `ScreenSpaceTrace.LinearThickness`, choice for choice.
    var screenLinearThickness: float = 0f

    /// Whether positions come from `depthBuffer` rather than the positions plane.
    ///
    /// The production wiring: a real frame has a depth, not a positions plane, so the compositor
    /// node reconstructs — the same `Transform.UvDepthToWorld` placement and the upsample already
    /// lean on, so a reflection and the probe that stood on its pixel agree about where the surface
    /// is. A sky texel answers invalid before any ray is cast.
    var reconstructFromDepth: int = 0

    /// What turns a pixel's depth back into the world, when reconstructing.
    var inverseViewProjection: mat4

    /// How many texels the planes cover.
    var reflectionViewport: int2 = int2(0, 0)

    /// Where the camera stands — the view direction is toward the surface, the incident convention.
    var cameraPosition: float3 = float3(0f, 0f, 0f)

    /// How far a mirror ray looks before deciding it escaped.
    var maxDistance: float = 100f

    /// How many steps one march may take. The CPU tracer's own default.
    var maxSteps: int = 128

    /// How near counts as arrived. The CPU tracer's own default.
    var surfaceThreshold: float = 0.01f

    /// What fraction of the reported distance each step actually takes.
    var stepScale: float = 0.9f

    /// How far off its surface a mirror ray starts — zero is a mirror that reflects itself.
    var bias: float = 0.01f

    /// The roughness at and above which the field answers instead of the trace.
    var roughnessThreshold: float = 0.5f

    /// How far below the threshold the cross-fade starts. Zero is the hard switch.
    var roughnessBlend: float = 0f

    /// The linear shell's slope — device depth is affine in `1/w`, `z = a + b·(1/w)`, with the same
    /// constants at every point the camera sees, so one ray's two endpoints determine them. Zero
    /// where the conversion does not exist (a `w` that does not vary, a camera bent the wrong way)
    /// and the device-depth shell stands — `ScreenSpaceTrace.ShellOf`, choice for choice.
    func ShellSlope(fromClip: float4, toClip: float4): float {
        if (screenLinearThickness <= 0f || fromClip.w <= Const.Epsilon || toClip.w <= Const.Epsilon) {
            return 0f
        }

        val inverseFrom = 1f / fromClip.w
        val inverseTo = 1f / toClip.w

        if (abs(inverseFrom - inverseTo) <= 0.000001f) {
            return 0f
        }

        val slope = (fromClip.z * inverseFrom - toClip.z * inverseTo) / (inverseFrom - inverseTo)

        if (slope <= 0f) {
            return 0f
        }

        return slope
    }

    /// The hierarchical DDA over the nearest chain — `ScreenSpaceTrace.Hierarchical`, sample for
    /// sample: skip a cell whose whole crossing stays nearer than its nearest surface, descend where
    /// it does not, and hold the shell against the texel crossing continuously — in view units where
    /// `screenLinearThickness` bought the conversion, device units otherwise. Answers the pixel that
    /// stopped the ray, or (-1, -1); the caller decides what a pixel is worth.
    func PyramidMarch(fromClip: float4, toClip: float4): int2 {
        val inverseFrom = 1f / fromClip.w
        val inverseTo = 1f / toClip.w
        val fromX = (fromClip.x * inverseFrom * 0.5f + 0.5f) * screenViewport.x
        val fromY = (fromClip.y * inverseFrom * 0.5f + 0.5f) * screenViewport.y
        val fromZ = fromClip.z * inverseFrom
        val toX = (toClip.x * inverseTo * 0.5f + 0.5f) * screenViewport.x
        val toY = (toClip.y * inverseTo * 0.5f + 0.5f) * screenViewport.y
        val toZ = toClip.z * inverseTo
        val deltaX = toX - fromX
        val deltaY = toY - fromY
        val deltaZ = toZ - fromZ
        val slope = ShellSlope(fromClip, toClip)
        val shellA = fromZ - slope * inverseFrom

        var along = 0f
        var level = pyramidLevels - 1
        var size = 1

        for (i in 0 .. level - 1) {
            size = size * 2
        }

        val width = int(screenViewport.x)
        val height = int(screenViewport.y)

        // A DDA visits O(levels · perimeter) cells; anything past this is a defect, and a budget
        // that ends a march is a miss in the only sense that matters.
        val budget = 16 * (width + height + pyramidLevels) + 64

        for (i in 0 .. budget - 1) {
            if (along >= 1f) {
                return int2(-1, -1)
            }

            val px = int(floor(fromX + deltaX * along))
            val py = int(floor(fromY + deltaY * along))

            // Off the viewport, the rest of the ray is not the screen's to answer.
            if (px < 0 || py < 0 || px >= width || py >= height) {
                return int2(-1, -1)
            }

            val cellX = (px / size) * size
            val cellY = (py / size) * size
            var exit = 1f

            if (deltaX > 0.000001f) {
                exit = min(exit, (float(cellX + size) - fromX) / deltaX)
            } else {
                if (deltaX < -0.000001f) {
                    exit = min(exit, (float(cellX) - fromX) / deltaX)
                }
            }

            if (deltaY > 0.000001f) {
                exit = min(exit, (float(cellY + size) - fromY) / deltaY)
            } else {
                if (deltaY < -0.000001f) {
                    exit = min(exit, (float(cellY) - fromY) / deltaY)
                }
            }

            exit = max(exit, along + 0.00001f)

            var nearest = 0f

            if (level == 0) {
                nearest = depthBuffer.Load(int3(px, py, 0)).r
            } else {
                val dims = depthPyramid.GetDimensions(level - 1)
                val cx = min(px / size, dims.x - 1)
                val cy = min(py / size, dims.y - 1)

                nearest = depthPyramid.Load(int3(cx, cy, level - 1)).r
            }

            val zAt = fromZ + deltaZ * along
            val zExit = fromZ + deltaZ * exit
            val enter = min(zAt, zExit)
            val leave = max(zAt, zExit)

            if (enter > nearest) {
                // The whole crossing stays nearer than the cell's nearest surface — nothing here
                // can stop the ray. Skip it, and try a coarser cell for the next one.
                along = exit

                if (level < pyramidLevels - 1) {
                    level = level + 1
                    size = size * 2
                }
            } else {
                if (level > 0) {
                    level = level - 1
                    size = size / 2
                } else {
                    // Texel level: the shell, held against the segment. A sky texel occludes
                    // nothing.
                    if (nearest > 0f) {
                        if (slope > 0f) {
                            val surfaceInverseW = (nearest - shellA) / slope

                            if (surfaceInverseW > 0.000001f) {
                                val surfaceW = 1f / surfaceInverseW
                                val wAt = 1f / (inverseFrom + (inverseTo - inverseFrom) * along)
                                val wExit = 1f / (inverseFrom + (inverseTo - inverseFrom) * exit)

                                if (max(wAt, wExit) > surfaceW && min(wAt, wExit) < surfaceW + screenLinearThickness) {
                                    return int2(px, py)
                                }
                            }
                        } else {
                            if (enter < nearest && leave > max(nearest - screenThickness, 0f)) {
                                return int2(px, py)
                            }
                        }
                    }

                    along = exit
                }
            }
        }

        return int2(-1, -1)
    }

    /// What the screen answers for a ray, if it answers at all: the frame's colour where a sample
    /// landed inside a surface's shell, `a` one, or `a` zero for a ray the screen could not stop.
    ///
    /// `ScreenSpaceTrace.TryHit`'s march, sample for sample — the fixed-step walk, or the
    /// hierarchical march when the host handed over a chain and both endpoints project. The one
    /// difference from the probes' copy is the answer: they ask WHETHER (a hit is an occlusion, the
    /// cache answers radiance), a reflection asks WHERE, because the colour at that pixel is the
    /// reflection.
    func ScreenColour(origin: float3, direction: float3): float4 {
        val fromClip = viewProjection * float4(origin, 1f)
        val toClip = viewProjection * float4(origin + direction * maxDistance, 1f)

        if (pyramidLevels > 0 && fromClip.w > Const.Epsilon && toClip.w > Const.Epsilon) {
            val landed = PyramidMarch(fromClip, toClip)

            if (landed.x >= 0) {
                return float4(sceneColor.Load(int3(landed.x, landed.y, 0)).rgb, 1f)
            }

            return float4(0f, 0f, 0f, 0f)
        }

        val slope = ShellSlope(fromClip, toClip)
        val inverseFrom = 1f / max(fromClip.w, Const.Epsilon)
        val shellA = fromClip.z * inverseFrom - slope * inverseFrom
        val step = maxDistance / float(screenSteps)

        for (i in 0 .. screenSteps - 1) {
            val world = origin + direction * ((float(i) + 0.5f) * step)
            val clip = viewProjection * float4(world, 1f)

            if (clip.w > Const.Epsilon) {
                val ndc = clip.xyz / clip.w

                if (ndc.z > 0f && ndc.z < 1f) {
                    val px = int(floor((ndc.x * 0.5f + 0.5f) * screenViewport.x))
                    val py = int(floor((ndc.y * 0.5f + 0.5f) * screenViewport.y))

                    // Off the viewport, the rest of the ray is not the screen's to answer.
                    if (px < 0 || py < 0 || px >= int(screenViewport.x) || py >= int(screenViewport.y)) {
                        return float4(0f, 0f, 0f, 0f)
                    }

                    val surfaceDepth = depthBuffer.Load(int3(px, py, 0)).r

                    // A sky texel occludes nothing; behind a surface and within its shell is a hit.
                    if (surfaceDepth > 0f) {
                        if (slope > 0f) {
                            val surfaceInverseW = (surfaceDepth - shellA) / slope

                            if (surfaceInverseW > 0.000001f) {
                                val surfaceW = 1f / surfaceInverseW

                                if (clip.w > surfaceW && clip.w < surfaceW + screenLinearThickness) {
                                    return float4(sceneColor.Load(int3(px, py, 0)).rgb, 1f)
                                }
                            }
                        } else {
                            if (ndc.z < surfaceDepth && ndc.z > surfaceDepth - screenThickness) {
                                return float4(sceneColor.Load(int3(px, py, 0)).rgb, 1f)
                            }
                        }
                    }
                }
            }
        }

        return float4(0f, 0f, 0f, 0f)
    }

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_GroupID")] group: uint3, [Semantic("SV_GroupThreadID")] thread: uint3) {
        val texel = int2(int(group.x) * 8 + int(thread.x), int(group.y) * 8 + int(thread.y))

        if (texel.x >= reflectionViewport.x || texel.y >= reflectionViewport.y) {
            return
        }

        var position = float3(0f, 0f, 0f)

        if (reconstructFromDepth != 0) {
            val deviceDepth = depthBuffer.Load(int3(texel.x, texel.y, 0)).r

            // Zero is the cleared far plane — sky, which reflects nothing of the scene's.
            if (deviceDepth <= 0f) {
                reflectionAtlas.Store(texel, float4(0f, 0f, 0f, 0f))
                return
            }

            val uv = float2((float(texel.x) + 0.5f) / screenViewport.x, (float(texel.y) + 0.5f) / screenViewport.y)

            position = Transform.UvDepthToWorld(inverseViewProjection, uv, deviceDepth)
        } else {
            val surface = reflectionPositions.Load(int3(texel.x, texel.y, 0))

            if (surface.a < 0.5f) {
                reflectionAtlas.Store(texel, float4(0f, 0f, 0f, 0f))
                return
            }

            position = surface.xyz
        }

        val shading = reflectionNormals.Load(int3(texel.x, texel.y, 0))
        val normal = shading.xyz
        val roughness = shading.a
        val view = Math.SafeNormalize(position - cameraPosition)
        val mirror = Math.SafeNormalize(view - normal * (2f * dot(view, normal)))

        // How much of the answer is the field's — the CPU reference's ramp, branch for branch.
        var rough = 1f

        if (roughness < roughnessThreshold) {
            rough = 0f

            if (roughnessBlend > 0f) {
                rough = clamp((roughness - (roughnessThreshold - roughnessBlend)) / roughnessBlend, 0f, 1f)
            }
        }

        var wide = float3(0f, 0f, 0f)

        if (rough > 0f) {
            wide = irradiance.Sample(position, mirror, float3(0f, 0f, 0f)).irradiance
        }

        if (rough >= 1f) {
            reflectionAtlas.Store(texel, float4(wide, 1f))
            return
        }

        // The screen first — geometry the field may not hold — and the frame's own colour at the
        // pixel that stopped the ray is the reflection.
        if (screenSteps > 0) {
            val screen = ScreenColour(position + normal * bias, mirror)

            if (screen.a > 0.5f) {
                reflectionAtlas.Store(texel, float4(lerp(screen.rgb, wide, rough), 1f))
                return
            }
        }

        val hit = distanceField.TraceField(position + normal * bias, mirror, maxDistance, maxSteps, surfaceThreshold, stepScale)
        var sharp = miss.MissRadiance(position, mirror, roughness)

        if (hit.hit) {
            sharp = surfaceCache.SurfaceRadiance(hit.position, distanceField.GradientField(hit.position)).rgb
        }

        reflectionAtlas.Store(texel, float4(lerp(sharp, wide, rough), 1f))
    }
}
