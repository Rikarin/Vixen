package Vixen.Test

import Vixen.Core
import Vixen.BaseShaders

// A syntax sample: everything the language has, in one file.
[FooBar, BarFoo]
shader TestShader : ExampleBase, CustomShader {
    const val Multiplier = 42
    const val Epsilon = 0.0001

    var world: mat4
    var tint: float4 = float4(1, 1, 1, 1)
    var albedo: Texture2D
    var albedoSampler: Sampler

    var lookup: int[]
    var grid: float[][]

    var prop: float {
        get => Epsilon
        set => tint = float4(value, value, value, 1)
    }

    [FooBar(mode: "linear")]
    var observed: float {
        willSet {
            counter++
        }

        didSet => counter--
    }

    var counter: int

    func Fold(): int {
        var total = 0

        for (i in 1 .. 10) {
            total += i * Multiplier
            counter++
            ++counter
        }

        while (total > 0) {
            total -= 1
        }

        if (total > 42) {
            total = 0
        } else {
            total = 1
        }

        return total
    }

    init() {
        counter = 0
    }

    init(seed: int) {
        counter = seed
        counter = lookup[0]
        counter = CoreClass.GetLength<int, Class>(seed)
    }

    func Test<Asd>() { }

    func Classify(x: int): int {
        var kind = 0
        switch (x) {
            case 0:
                kind = 1
                break
            case 1:
            case 2:
                kind = 2
                break
            default:
                kind = 3
        }

        return kind
    }

    func Bounds(): (int, float) {
        val pair = (Multiplier, Epsilon)
        val named = (count: Multiplier, scale: Epsilon)
        return pair
    }

    func Collect(): int[] {
        val direct = [1, 2, 3, 4]
        val spread = [1, ..direct, 5]
        return direct
    }

    [VertexShader]
    [Semantic("SV_Position")]
    func VSMain(position: float3): float4 {
        val scaled = position * Epsilon
        return world * float4(scaled, 1)
    }

    [PixelShader]
    [Semantic("SV_Target")]
    func PSMain(uv: float2): float4 {
        val sampled = albedo.Sample(albedoSampler, uv)
        val lit = saturate(dot(sampled.rgb, tint.rgb))
        return float4(sampled.rgb * lit, sampled.a)
    }

    func TestMethod(count: int = 42, scale: float = 1f): float4 {
        val widened: double = count
        val picked = count > 0 ? tint : float4(0, 0, 0, 1)
        return picked
    }
}

protocol Shaded {
    var Tint: float4 {
        get => float4(0, 0, 0, 1)
    }
}

struct FooBar {
    var value: float

    init(initial: float) {
        value = initial
    }

    func Scaled(by: float): float => value * by

    FooBar operator +(a: FooBar, b: FooBar) => a
}

enum Mode {
    Off,
    On = 5,
    Auto
}

struct Widget<T> where T : Shaded {
    var item: T

    func Item(): T {
        return item
    }
}

struct Messenger {
    val userId: int
    val channel: int
}
