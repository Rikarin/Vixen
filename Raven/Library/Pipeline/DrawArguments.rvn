package Vixen.Shaders.Pipeline

import Vixen.Shaders.Core

// The pass that turns `Culling.rvn`'s bits into draw calls, so the answer never has to come back to
// the host at all.
//
// **It zeroes instance counts; it does not compact.** The usual GPU-driven formulation appends the
// survivors to a list and draws that list. Claiming a slot needs `atomicAdd`, which Raven has — so
// what stops this is not the shader but the *draw*, and it is two things at once. One command can
// only cover a compacted run if the count comes from the device, and the RHI's
// `DrawIndexedIndirect` takes its `drawCount` as a host integer. And one command can only cover
// several objects if they share their bindings, which they do not: `MeshRenderFeature` binds a
// vertex buffer, an index buffer and a material set per object. Bindless materials are what change
// the second, and they are the prerequisite the roadmap records.
//
// So the argument buffer keeps *one record per object slot*, at that slot's own index, and a culled
// object gets `instanceCount = 0`. Every API defines a draw of zero instances as a draw that fetches
// nothing and rasterises nothing; the command is still submitted, which is the price, and it is a few
// bytes of front-end work rather than a vertex fetch.
//
// **A record per object per view.** The bits are per view, so the arguments are too — a shadow cascade
// and the camera disagree about what is visible, and one argument buffer between them would be
// whichever view was dispatched last.
//
// **The template is what the host would have drawn.** Index count, instance count, first index, vertex
// offset, first instance: exactly the five numbers `DrawIndexed` takes, resolved on the host during
// `Prepare` — instancing has already decided its batch size and its `firstInstance` by then. This pass
// copies them and edits one field. Deriving them here instead would mean teaching a shader what a
// mesh, a skeleton and an instancing feature are.

/// One indexed draw, in the layout every API's indirect buffer expects.
///
/// The field order is the argument order of `vkCmdDrawIndexedIndirect` and of D3D12's
/// `DrawIndexedInstanced`, and it is not ours to choose: the GPU's command processor reads these bytes
/// directly. Twenty bytes, which is `ICommandList.DrawIndexedIndirect`'s default stride.
struct DrawCommand {
    var indexCount: uint
    var instanceCount: uint
    var firstIndex: uint
    var vertexOffset: uint
    var firstInstance: uint
}

shader DrawArguments {
    /// Whether survivors are appended to a list, or left at their own slot with a zero instance count.
    ///
    /// **Both, because both are needed.** Appending is what makes one command cover a whole run, and
    /// it is worth nothing without a draw whose count comes from the device —
    /// `GraphicsDeviceFeatures.HasDrawIndirectCount`, which Vulkan has and GL, WebGPU and Metal do
    /// not. On those the padded form is not a fallback anybody is waiting to remove: it is what runs.
    ///
    /// ⚠ A permutation and not a uniform, because the two write *different things* to the same
    /// buffer. A branch inside one variant would be a branch every invocation takes, on a value that
    /// is the same for the whole dispatch and the whole run of the program.
    [Permutation] val Compact: bool = false

    /// What each object would be drawn with if it were visible, indexed by object slot.
    var templates: Buffer<DrawCommand>

    /// `Culling.rvn`'s output, unchanged: `wordCount` words per view, view-major.
    var visibility: Buffer<uint>

    /// One record per object per view, view-major — what the draw calls read.
    ///
    /// Padded, this holds one record per object slot at that slot's own index. Compacted, it holds
    /// each batch's survivors packed from `bases[batch]`, and `counts` says how many there are.
    var commands: RWBuffer<DrawCommand>

    /// Which batch each object belongs to — a run of objects that bind everything alike.
    ///
    /// The host's, because the host is what knows: a batch is objects sharing a pipeline, a vertex
    /// buffer, an index buffer and a material set, and every one of those is a fact about the
    /// renderer rather than about geometry. Teaching a shader to derive it would be teaching it what
    /// an effect and a sort group are.
    var batches: Buffer<uint>

    /// Where each batch's run starts within a view's region, in records.
    ///
    /// A prefix sum the host computed over the batch sizes. Batches partition the objects, so the
    /// runs partition the view's region and the buffer is exactly the size the padded form needed —
    /// compaction costs no memory, only an atomic.
    var bases: Buffer<uint>

    /// How many survivors each batch has, one `uint` per batch per view.
    ///
    /// ⚠ Zeroed by the host before this runs. An `atomicAdd` onto last frame's count appends past
    /// the end of the batch's run and into the next batch's, which draws one batch's geometry with
    /// another's arguments — and does so only in the frames where something became invisible.
    var counts: RWBuffer<uint>

    /// One invocation per object per view: `x` is the object, `y` is the view.
    ///
    /// Per object rather than per word, because the output is a record per object and a record is
    /// twenty bytes — an invocation per word would serialise thirty-two of them behind one thread for
    /// no sharing it could remove.
    ///
    /// **There are no uniforms here, and that is deliberate.** The two numbers this needs — how many
    /// objects there are, and how many visibility words a view occupies — are the same two the host
    /// sized the bindings with, so asking the binding is asking the one source rather than a copy of
    /// it that a frame can forget to update. `Culling.rvn` puts its counts in the view record for the
    /// same reason.
    [ComputeShader(64)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val index = int(id.x)
        val view = int(id.y)
        val objectCount = templates.Length

        if (index >= objectCount) {
            return
        }

        // The same rounding the host packs the bitset with: thirty-two objects to a word, and the
        // tail object still gets one.
        val wordCount = (objectCount + 31) / 32
        val word = visibility[view * wordCount + index / 32]
        val visible = (word & (1u << (index % 32))) != 0u

        var command = templates[index]

        if (Compact) {
            // Nothing at all for a culled object — which is the whole difference. The padded form
            // has to write a record for every object because the draw reads every slot; here the
            // draw reads `counts[…]` slots and a culled object simply never claims one.
            if (!visible) {
                return
            }

            val batch = int(batches[index])
            val slot = atomicAdd(counts[view * bases.Length + batch], 1u)

            // The batch's run, inside this view's region. `bases` partitions the region, so a slot
            // claimed here cannot collide with another batch's however the invocations interleave.
            commands[view * objectCount + int(bases[batch]) + int(slot)] = command
            return
        }

        // Zeroed rather than skipped: the record is read whether or not this pass touched it, so
        // leaving last frame's alone would draw what last frame could see.
        if (!visible) {
            command.instanceCount = 0u
        }

        commands[view * objectCount + index] = command
    }
}
