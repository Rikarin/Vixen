package Vixen.Shaders.Pipeline

import Vixen.Shaders.Core
import Vixen.Shaders.Geometry

// Phase 4 of `docs/plan/22-virtualized-geometry.md`: the hardware-raster visibility buffer.
//
// One instanced draw covers every cluster the traversal accepted. `SV_InstanceID` is the slot in the
// visible list, `SV_VertexID` is a corner of one of the cluster's triangles, and everything else —
// which mesh, which page, which vertex, where in the world — is fetched from buffers. There is no
// vertex buffer, no index buffer with the mesh's indices in it, and no per-object draw call.
//
// **What it writes is an identity, not a colour.** One `uint` per pixel naming the visible-list slot
// and the triangle within its cluster, with ordinary depth test and depth write. Phase 5's resolve
// then fetches the triangle, recovers barycentrics from the pixel and runs the material — which is
// why nothing about a material appears here, and why this shader is the same for every material in
// the project.
//
// **No atomics, no 64-bit anything, no compute.** That is deliberate and is what makes this the
// portable baseline: the depth test is the hardware's, and the identity rides through the rasteriser
// as a flat varying. Phase 6's software raster is the accelerator for sub-pixel triangles and needs
// both of the things this does without.

/// The packing and the decode the raster and the resolve have to agree about.
struct Raster {
    /// How many bits of the identity word name the triangle within its cluster.
    ///
    /// Seven, for the hundred and twenty-eight triangles a cluster is built to hold — see
    /// `MeshletBuildSettings.MaxTriangles`. The other twenty-five name the visible-list slot.
    ///
    /// ⚠ Since phase 6 the slot bounds the *list* rather than the accepted count, because the software
    /// raster's entries are at the far end of it — so a buffer longer than thirty-three million words
    /// would produce slots a pixel cannot name. `GpuClusterVisibility` caps it there rather than
    /// letting it happen, which at four kilobytes an instance is a scene of thirty-two thousand
    /// virtualized objects and a hundred and thirty megabytes of list.
    const val TriangleBits = 7

    const val TriangleMask = 0x7Fu

    /// What a pixel nothing covered holds.
    const val Nothing = 0u

    /// One pixel's identity: which visible cluster, and which of its triangles.
    ///
    /// The slot is an entry of the visible list, minus its header — so `visible[slot + Cull.VisibleBase]`
    /// is the packed instance and cluster, whichever raster wrote the pixel. That is what lets phase 6
    /// route a cluster to a different raster without the resolve learning anything about it.
    ///
    /// **The slot is stored one higher than it is**, so that zero means "nothing covered this pixel".
    /// The obvious alternative is to clear the target to all ones — but a clear colour is four floats in
    /// every API the RHI wraps, and there is no float whose bits are `0xFFFFFFFF` that also survives
    /// being interpreted as one. Biasing by one makes the empty value zero, which every backend can
    /// clear a `uint` target to, and costs an increment in the one place that packs and a decrement in
    /// the one place that unpacks.
    static func Pack(slot: uint, triangle: uint): uint => ((slot + 1u) << TriangleBits) | (triangle & TriangleMask)

    /// Whether anything drew to this pixel at all.
    static func Covered(id: uint): bool => id != Nothing

    /// Which visible-list slot a pixel names. Meaningless unless `Covered`.
    static func Slot(id: uint): uint => (id >> TriangleBits) - 1u

    /// Which triangle of that cluster it names.
    static func Triangle(id: uint): uint => id & TriangleMask
}

/// Where one cluster's bytes are inside its page, and how to decode them.
///
/// `CullCluster`'s other half, and split from it for the reason the whole phase is split that way: a
/// traversal reads bounds and errors for every cluster it tests, and a raster reads this for only the
/// ones it draws. Two buffers means the traversal's reads stay dense.
struct RasterCluster {
    /// The cluster's origin on the mesh's quantization grid, in whole grid steps.
    var origin: int3

    /// Which page holds its bytes.
    var page: uint

    /// Where its vertices start, in bytes from the page's own start.
    var vertexOffset: uint

    /// Where its triangle corners start, in bytes from the page's own start.
    var triangleOffset: uint

    /// How many triangles it has.
    var triangleCount: uint

    /// How many bytes one of its vertices occupies.
    var vertexStride: uint
}

/// One mesh's quantization grid.
///
/// Per mesh and not per cluster, which is the property that keeps a cut crack-free: a vertex on a
/// locked boundary is referenced by a cluster on each side, and only a grid they share decodes it to
/// the same bits from both. See `MeshletPageSet.QuantizationStep`.
struct RasterMesh {
    /// What `influenceOffset` holds for a mesh with no skeleton.
    const val NoInfluences = 0xFFFFFFFFu

    /// What `morphRunBase` holds for a mesh with no blend shapes.
    ///
    /// ⚠ All ones and not zero, unlike `Cull.NoWeights` next door — and the difference is which side of
    /// the pair a zeroed record has to be safe on. An instance is filled per frame and a slot nobody
    /// filled must be at rest, so zero means "none" there. A mesh record is filled once at registration
    /// and zero is a real base: the first morphed mesh registered gets it, so a mesh whose word was
    /// left zero would wear that mesh's deltas.
    const val NoMorphs = 0xFFFFFFFFu

    var quantizationOrigin: float3
    var quantizationStep: float

    /// Where a vertex's four bone indices and four weights sit inside it, in bytes, or `NoInfluences`.
    ///
    /// **Per mesh, and a value rather than a permutation.** A classic pass picks its skinned variant per
    /// draw — see `ShadowCaster.Skinned` — because there is a draw per object to pick it at. Here one
    /// indirect draw covers every cluster of every mesh in the scene, so the question has to be one a
    /// vertex's own mesh record answers. It also keeps a static mesh's page vertex at sixteen bytes
    /// instead of charging every rock in the project eight bytes of zeros.
    var influenceOffset: uint

    /// Where this mesh's per-vertex run table starts in `morphs`, in words, or `NoMorphs`.
    ///
    /// **The three words the padding was**, so the record is still 32 bytes on both sides — which it
    /// had to be declared to be, because a `float3` member aligns it to sixteen and the host was
    /// writing twenty.
    ///
    /// ⚠ `NoMorphs` and not zero. Zero is a real base and the first morphed mesh registered gets it;
    /// a mesh that read zero by default would be a rock with a face's deltas applied to it.
    var morphRunBase: uint

    /// Where its entries start in `morphs`, in words. Four words an entry.
    var morphEntryBase: uint

    /// How many blend shapes it has, which is how wide one instance's run of weights is.
    var morphShapeCount: uint
}

/// Morphing a page vertex: the gather three shaders do, written once.
///
/// **A gather rather than a scatter, and the reason is that a page is per mesh.** Every instance of a
/// head traverses the same DAG and reads the same pool slot — that sharing is what makes streaming a
/// hundred thousand clusters affordable — while weights are per instance. So there is nowhere for a
/// per-instance scatter to write, and the deformation happens where the vertex is decoded, exactly as
/// skinning already does. `MorphIndex` is the host's statement of the same arithmetic and the thing
/// these are checked against.
///
/// ⚠ **Nothing renormalises the normal.** A shape may cancel one exactly, and the consumers
/// `SafeNormalize` at 1e-4 — `MorphKernel` makes the argument at length.
struct Morph {
    /// How many words one entry occupies: the shape's slot, then six quantised components.
    const val EntryWords = 4u

    /// One signed short out of a packed word, low half.
    static func Low(word: uint): float => float(int(word << 16) >> 16)

    /// One signed short out of a packed word, high half.
    ///
    /// ⚠ An arithmetic shift on a *signed* value, because a delta is signed. A logical shift reads
    /// `-1` as `65535`, which is a vertex flung across the mesh rather than a vertex barely moved.
    static func High(word: uint): float => float(int(word) >> 16)
}

/// What one vertex's shapes moved it and its normal by.
///
/// Both at once because both come out of the same three words — six shorts packed across them, the
/// position occupying the first word and a half and the normal the last word and a half. A shader that
/// wanted only the position would still read all three.
struct MorphDelta {
    var position: float3
    var normal: float3
}

/// How a page vertex packs its four bone influences.
///
/// The decode and nothing else, so that the two shaders that do it agree by construction rather than by
/// review. The *fetch* stays in each shader, which is the split `Skinning` already makes and for its
/// reason: indexing a palette is an access chain in the shader that declares it and a sixteen-kilobyte
/// copy anywhere else.
struct Influences {
    /// Which bone one of the four slots names, out of the packed index word.
    static func Bone(packed: uint, slot: int): uint => (packed >> (slot * 8)) & 0xFFu

    /// The four weights out of the packed weight word, as fractions.
    ///
    /// A byte a weight, which is finer than the position it is applied to: a page stores a coordinate as
    /// a 65535th of the mesh's longest extent, so on a two-metre character a 255th of a weight moves a
    /// vertex by less than the quantization already did.
    static func Weights(packed: uint): float4 => float4(
        float(packed & 0xFFu),
        float((packed >> 8) & 0xFFu),
        float((packed >> 16) & 0xFFu),
        float((packed >> 24) & 0xFFu)
    ) / 255f
}

shader ClusterRaster {
    /// The clusters the traversal accepted. The first `Cull.VisibleBase` words are counters, and the
    /// clusters *this* raster draws are the prefix after them — so `SV_InstanceID` plus the header is
    /// the entry, and the entry minus the header is the slot a pixel names.
    var visible: Buffer<uint>

    /// One record per instance, as `Culling.rvn` writes it.
    var instances: Buffer<CullInstance>

    /// Where each cluster's bytes are, indexed as `clusterRecords` is.
    var geometry: Buffer<RasterCluster>

    /// One record per registered mesh.
    var meshes: Buffer<RasterMesh>

    /// Where each page sits in the pool, or `Cull.PageAbsent`. The same table the traversal read.
    var residency: Buffer<uint>

    /// The page pool, as words. A page's bytes are `pageSize` from `residency[page] * pageSize`.
    ///
    /// Words rather than bytes because a storage buffer has no byte element type, so every read here is
    /// a word load and a shift — which is what `Bytes` and `Shorts` below exist to say once.
    var pages: Buffer<uint>

    /// Every skinned instance's matrices this frame, back to back.
    ///
    /// One buffer for the whole scene with a per-instance base index, which is what
    /// `SkinningRenderFeature` already arranges for the classic path — except that there the base rides
    /// in a push constant, and here there is no per-object command to push it through.
    var bones: Buffer<BoneMatrix>

    /// Every morphed mesh's shapes, re-indexed by vertex, and the cluster-vertex table that reaches them.
    ///
    /// Three tables in one buffer, because they are read one after another by the same invocation and a
    /// binding costs more than an offset. The first `clusterCount` words are indexed by *global* cluster
    /// — `instance.firstCluster + clusterIndex`, the same index `geometry` takes — and hold where that
    /// cluster's run of source-vertex indices starts. After them come the runs themselves, then per
    /// mesh a prefix over its vertices and its entries, at `mesh.morphRunBase` and `mesh.morphEntryBase`.
    ///
    /// ⚠ **A page vertex does not know which mesh vertex it is**, which is the whole reason this table
    /// exists. A cluster's vertex list is the DAG's — `MeshletMesh.Vertices` — and the page carries only
    /// the position and attributes it copied out. A vertex on a locked boundary appears in a cluster on
    /// each side and at several levels, and every copy of it must pick up the same delta or the cut
    /// cracks; the source index is what makes them the same vertex again.
    var morphs: Buffer<uint>

    /// Every morphed instance's per-shape weights this frame, back to back.
    ///
    /// One buffer for the scene with a per-instance base, exactly as `bones` is, and for the same reason
    /// — there is no per-object command to push a per-object index through.
    ///
    /// ⚠ **Pre-multiplied by the shape's quantisation step on the host**: `x` is `weight × positionStep`
    /// and `y` is `weight × normalStep`. Uploading the weight and the step separately would be a second
    /// multiplication for the two processors to round differently, and `MorphKernel.Step` already makes
    /// the argument that one division on the host is one float both then agree about.
    var morphWeights: Buffer<float2>

    /// How many bytes one page occupies in the pool.
    var pageSize: uint

    /// Where this frame's instance records start, in records.
    ///
    /// The buffer holds a region per frame in flight and this says which one is ours. A base index
    /// rather than a descriptor offset, so that the resolve — which fills its set through a writer with
    /// nowhere to put an offset — reads the same region this does. Two passes reading different frames'
    /// transforms is the disagreement phase 5 warns about, arriving by the back door.
    var instanceBase: uint

    /// Where this frame's palettes start, in matrices, and its slot table, in entries — the same terms.
    var boneBase: uint

    var residencyBase: uint

    /// Where this frame's blend-shape weights start in `morphWeights`, in entries. `boneBase`'s twin.
    var morphWeightBase: uint

    /// The camera.
    var viewProjection: mat4

    /// Which visible cluster and which of its triangles this fragment belongs to.
    ///
    /// An integer varying, so `flat` by necessity rather than by choice — there is no interpolation an
    /// identity could take, and Raven decorates it for both backends. This is the whole output of the
    /// pass: the fragment stage computes nothing and writes what the vertex stage decided.
    stream var identity: uint

    /// The vertex stage: one corner of one triangle of one visible cluster.
    ///
    /// **The surplus corners are the interesting part.** The draw is a single instanced command, so
    /// every cluster is rasterized with the same index count — the largest a cluster can hold — and a
    /// cluster with fewer triangles has corners left over. Those corners all take the same branch and
    /// all return the same position, so the triangle they form has zero area and covers no pixel. A
    /// variable index count per cluster would need one argument structure per cluster and a
    /// multi-draw, which is what phase 4 exists to not need.
    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex([Semantic("SV_VertexID")] vertexId: int, [Semantic("SV_InstanceID")] slot: int): float4 {
        val packed = visible[slot + Cull.VisibleBase]
        val instanceIndex = int(Cull.VisibleInstance(packed))
        val clusterIndex = Cull.VisibleCluster(packed)

        val instance = instances[int(instanceBase) + instanceIndex]
        val record = geometry[int(instance.firstCluster + clusterIndex)]
        val mesh = meshes[int(instance.mesh)]

        val triangle = uint(vertexId) / 3u
        val corner = uint(vertexId) % 3u
        val page = residency[int(residencyBase + record.page)]

        // A surplus corner, or a page that went away between the traversal and this draw. The second
        // should not happen — a page is evicted only after the frame that drew from it was submitted —
        // and it is checked anyway, because the alternative is reading a slot that holds another page's
        // bytes and drawing geometry from the wrong mesh.
        if (triangle >= record.triangleCount || page == Cull.PageAbsent) {
            identity = Raster.Nothing
            return float4(0f, 0f, 0f, 1f)
        }

        val start = page * pageSize

        // Which of the cluster's own vertices this corner is. One byte, because a cluster holds at most
        // two hundred and fifty-six of them.
        val local = Byte(start + record.triangleOffset + triangle * 3u + corner)
        val at = start + record.vertexOffset + local * record.vertexStride

        // The grid coordinate, exactly: the cluster's origin plus the stored offset, both integers. That
        // this is an integer addition and not a float one is the whole of why a locked boundary decodes
        // to the same bits from both sides of it.
        val x = record.origin.x + int(Short(at))
        val y = record.origin.y + int(Short(at + 2u))
        val z = record.origin.z + int(Short(at + 4u))

        val local3 = float3(float(x), float(y), float(z))
        var position = mesh.quantizationOrigin + local3 * mesh.quantizationStep

        // The pose, in object space and before the instance places it — because a bone matrix is
        // `inverseBindPose * boneWorld` in the *mesh's* space, which is the space the page just decoded
        // into. `VisibilityResolve` does this by the same call on the same bytes; that they are one
        // function is what phase 5's warning about the two transforms asks for.
        // ⚠ Before the skin and after the decode, which is the order the classic path has by
        // construction: `MorphRenderFeature` writes a morphed vertex buffer and `SkinningRenderFeature`
        // skins out of it. A delta is authored in the mesh's own space, so skinning a rest vertex and
        // then adding one would put a jaw's displacement in the head's bind pose rather than in its
        // pose.
        if (mesh.morphRunBase != RasterMesh.NoMorphs && instance.firstWeight != Cull.NoWeights) {
            position = position + Morphed(instance, mesh, clusterIndex, local).position
        }

        if (mesh.influenceOffset != RasterMesh.NoInfluences && instance.firstBone != Cull.NoBones) {
            position = Math.TransformPoint(Skin(at + mesh.influenceOffset, instance), position)
        }

        val world = instance.position + position * instance.scale

        identity = Raster.Pack(uint(slot), triangle)

        return viewProjection * float4(world, 1f)
    }

    /// What one page vertex's blend shapes moved it by, gathered.
    ///
    /// **`MorphIndex.Apply` transliterated**, and held to it the way `Skin` is held to `Skinning`: the
    /// host writes the arithmetic once and `MorphIndexTests` holds *that* to `MorphKernel`, which the
    /// device's own scatter kernel is already held to. Three parties, one definition.
    ///
    /// ⚠ **A vertex no shape moves costs two reads and returns zero**, which is most of a face and all
    /// of a body. That is what the prefix table buys and why the entries are indexed by vertex rather
    /// than searched per shape.
    ///
    /// ⚠ **The normal is not renormalised here or anywhere after.** A shape may cancel one exactly and
    /// there is no direction left to recover; `VisibilityResolve` `SafeNormalize`s at 1e-4, which
    /// answers zero rather than a NaN. `MorphKernel` makes the argument at length.
    func Morphed(instance: CullInstance, mesh: RasterMesh, clusterIndex: uint, local: uint): MorphDelta {
        var delta: MorphDelta
        delta.position = float3(0f, 0f, 0f)
        delta.normal = float3(0f, 0f, 0f)

        // The cluster's own run of source indices, then this corner's entry in it. Two indirections,
        // because a page vertex carries no identity of its own — see `morphs`.
        val run = morphs[int(instance.firstCluster + clusterIndex)]
        val source = morphs[int(run + local)]

        var entry = morphs[int(mesh.morphRunBase + source)]
        val last = morphs[int(mesh.morphRunBase + source + 1u)]

        while (entry < last) {
            val at = mesh.morphEntryBase + entry * Morph.EntryWords
            val shape = morphs[int(at)]
            val weight = morphWeights[int(morphWeightBase + instance.firstWeight + shape)]

            val first = morphs[int(at + 1u)]
            val second = morphs[int(at + 2u)]
            val third = morphs[int(at + 3u)]

            // Six shorts across three words: the position occupies the first and a half, the normal the
            // last and a half. `MorphKernel.Pack` decides that layout and this reads it — a reader that
            // took both triples from the same half would read the position's z as the normal's x.
            delta.position = delta.position
                + float3(Morph.Low(first), Morph.High(first), Morph.Low(second)) * weight.x

            delta.normal = delta.normal
                + float3(Morph.High(second), Morph.Low(third), Morph.High(third)) * weight.y

            entry = entry + 1u
        }

        return delta
    }

    /// The one matrix a vertex's four influences blend to.
    ///
    /// The four reads are access chains into the palette and the blend is `Skinning`'s, which is the
    /// same division `ShadowCaster` makes — and it means a virtualized character and a classic one are
    /// deformed by the same arithmetic rather than by two derivations of it.
    func Skin(at: uint, instance: CullInstance): mat4 {
        val indices = Word(at)
        val start = int(boneBase + instance.firstBone)

        var palette: BonePalette
        palette.bone0 = bones[start + int(Influences.Bone(indices, 0))].matrix
        palette.bone1 = bones[start + int(Influences.Bone(indices, 1))].matrix
        palette.bone2 = bones[start + int(Influences.Bone(indices, 2))].matrix
        palette.bone3 = bones[start + int(Influences.Bone(indices, 3))].matrix

        return Skinning.BlendMatrix(palette, Influences.Weights(Word(at + 4u)))
    }

    /// The fragment stage: what the vertex stage decided, and the depth the hardware wrote.
    [FragmentShader]
    [Semantic("SV_Target")]
    func Fragment(): uint => identity

    /// One byte out of the pool, at a byte offset.
    func Byte(at: uint): uint {
        val word = pages[int(at >> 2)]
        return (word >> int((at & 3u) * 8u)) & 0xFFu
    }

    /// One whole word out of the pool, at a four-byte-aligned byte offset.
    ///
    /// Aligned by construction rather than by hope: `MeshletPageBuilder` aligns every cluster's vertex
    /// run to four bytes, a skinned vertex is twenty-four, and the influences sit sixteen into it.
    func Word(at: uint): uint => pages[int(at >> 2)]

    /// One unsigned short out of the pool, at a byte offset. Two-byte aligned by construction.
    func Short(at: uint): uint {
        val word = pages[int(at >> 2)]
        return (word >> int((at & 2u) * 8u)) & 0xFFFFu
    }
}
