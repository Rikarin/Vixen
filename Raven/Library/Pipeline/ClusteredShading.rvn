package Vixen.Shaders.Pipeline

import Vixen.Shaders.Core
import Vixen.Shaders.Shading
import Vixen.Shaders.Geometry
import Vixen.Shaders.Material
import Vixen.Shaders.IrradianceFields

// The clustered lighting every shading pass shares: the light loops, the cascades and the ambient term.
//
// **Extracted from `ForwardPlus` so a second entry contract can reach it**, which is phase 5 of
// `docs/plan/22-virtualized-geometry.md`. A visibility-buffer resolve shades the same surfaces with the
// same lights as a forward draw, and the only honest way to say so is for both to call the same code —
// two implementations of "every light that reaches this point" is two places for the definition to
// drift, and the way it drifts is one path getting a shadow term the other does not.
//
// **What made the extraction possible is that lighting never needed the interpolators.** These
// functions read three things a rasterizer happened to hand them — the world position, the view-space
// position and the object index — and nothing else about how the pixel was found. Passing those three
// as a `ShadingPoint` costs a forward fragment nothing it was not already paying and lets a compute
// stage, which has no interpolators at all, supply them from a triangle it reconstructed.
//
// ⚠ **The bindings are inherited, so a derived pass declares them whether or not it reads them.** That
// is the same rule `ForwardPlus` states at the top of its own file — a binding is in the plan because
// it was declared, not because a variant reads it — and it means a resolve binds the shadow map and the
// cluster list exactly as a forward pass does.

/// Where a pixel is, for the parts of shading that need to know.
///
/// Three numbers rather than the whole geometric context, and the shortness is the point: everything
/// else lighting needs — the normal, the view vector, the surface — is already a parameter, and these
/// are precisely the three that used to arrive as interpolators. A pass that has no interpolators fills
/// them from wherever it does know.
struct ShadingPoint {
    /// The pixel's world position, which every light's falloff and every parallax correction measures from.
    var positionWS: float3

    /// Its view-space position, which is what finds its cluster in the grid.
    ///
    /// Meaningless when clustering is off, and read by nothing in that variant — the permutation folds
    /// the only reader away.
    var positionVS: float3

    /// Which render object it belongs to, for the per-object reflection probe.
    ///
    /// Negative for a pass with no render object to name — a visibility resolve shades a cluster of a
    /// mesh, not an object slot — which `ProbeIndex` and `ProbeWeight` read as "use the block".
    var objectIndex: int
}

shader ClusteredShading {

    /// What the surface does with one light — the composed shading model, reached through the pass.
    ///
    /// **A hook rather than a `compose` slot, and the difference is where a composed implementation's
    /// parameters land.** A model like `SubsurfaceShading` has uniforms of its own, and they attach to
    /// the shader that *declares the slot* — so a slot here would put `SubsurfaceShading.wrap` in this
    /// shader's binding list and not in the pass's, where `MaterialRenderFeature` looks for it. Each
    /// pass keeps its own slot and overrides this to reach it, which costs one forwarding line and keeps
    /// a material's parameters where a host already knows to find them.
    ///
    /// The default is unlit black rather than something plausible: a pass that forgot to override it
    /// should look wrong immediately, not slightly.
    func Shade(d: MaterialData, a: ShadingAngles, s: ShadingVectors, alpha: float): float3 {
        return float3(0f, 0f, 0f)
    }

    /// The irradiance field's answer at a point, on the same terms and for the same reason.
    ///
    /// Coverage zero, so a pass that does not override it blends in nothing and the sky stands — which
    /// is what `UseIrradianceField` off already does.
    func SampleIrradiance(position: float3, n: float3, v: float3): IrradianceSample {
        var sample: IrradianceSample
        sample.irradiance = float3(0f, 0f, 0f)
        sample.coverage = 0f

        return sample
    }

    /// Whether a spot or a point light can see this pixel, on the same terms and for the same reason.
    ///
    /// Fully lit, so a pass that does not override it is the pass this file has always been: every
    /// punctual light unshadowed, which is what the engine did everywhere until there was an atlas to
    /// read. `PunctualShadows.rvn` is what a pass overrides this to reach.
    func PunctualVisibility(light: PunctualLight, positionWS: float3, n: float3, NdotL: float): float {
        return 1f
    }



    /// Whether to add image-based ambient. Off gives a pure punctual-lit look, and folds the IBL
    /// arithmetic out of the variant — though not its bindings, which are declared rather than
    /// discovered. See the note at the top of the file.
    [Permutation] val UseImageBasedLighting: bool = true


    /// Whether to read indirect diffuse out of an irradiance field.
    ///
    /// Off by default, and the default is the picture this pass already drew: with it off the ambient
    /// diffuse is the sky's spherical harmonics alone, exactly as before.
    ///
    /// ⚠ It does not ADD to the sky's ambient, it REPLACES it where the field has an answer. The field
    /// was filled by rays that hit the sky, so its value already contains what the sky contributes —
    /// adding them counts the sky twice, and the second count is the brighter of the two because it is
    /// unoccluded.
    [Permutation] val UseIrradianceField: bool = false


    /// Whether to sample a shadow map for the directional light.
    [Permutation] val UseShadows: bool = true


    /// Paints each cascade a flat colour instead of shading, so a band can be attributed by eye.
    ///
    /// **For the class of defect that four correct fixes did not move.** Hard-edged regions on a
    /// floor look the same whether they come from cascade selection, from a fragment no cascade
    /// contains, or from something downstream that is not a shadow at all — and reasoning about which
    /// has been wrong repeatedly. This answers it in one screenshot: red, green, blue and yellow are
    /// cascades zero to three, and **magenta is a fragment inside none of them**, which is the case
    /// `Shadow` answers "fully lit" and would draw a hard edge doing it.
    ///
    /// Scaled by the sun's own radiance and darkened where the shadow term says so, so the tint sits
    /// in the same range the frame already exposes for and the shadows stay legible inside it.
    [Permutation] val ShowCascades: bool = false


    /// Whether to read the culled cluster list instead of a host-filled uniform array.
    [Permutation] val UseClusteredLights: bool = false


    /// Whether the per-object scalars come from a buffer the draw's instance index addresses.
    ///
    /// The last thing in the per-object block that a merged, clustered frame could not deliver. The
    /// clustered path binds no per-draw set at all — a fragment finds its own lights in the grid — so
    /// `probeIndex` and `probeWeight` arrived as whatever set 3 last held, and per-object reflection
    /// probes are one of the three features `docs/bindless-materials.md` was written to unblock.
    ///
    /// ⚠ **Requires `UseTransformRecords`, and that is a real precondition rather than tidiness.**
    /// What addresses a record is `SV_InstanceID`, and the API adds `firstInstance` into it — which
    /// holds the object's slot only because the transform record path put it there. With the matrix
    /// still pushed, every draw carries zero and every object would read record zero's probe.
    /// `CompositorBuilder` asks for this only where transforms actually turned on.
    [Permutation] val UseObjectRecords: bool = false


    /// How many entries the uniform light list has room for. Unused when clustering is on.
    ///
    /// A permutation rather than a constant because it is the *host's* budget: it sizes a uniform
    /// array, so it sets the descriptor's size, and a project that ships eight lights per draw should
    /// not pay for sixty-four. It is also why `lightCount` exists separately — the array is sized
    /// once at compile time and filled to a different depth every draw.
    [Permutation] val MaxLights: int = 16


    // The scalars come first and the array last, which is not a style choice: std140 starts an array
    // of structures on a sixteen-byte boundary whatever precedes it, so three scalars and four bytes
    // of padding fill exactly the header `ForwardLightingRenderFeature.HeaderSize` already writes.
    // Declaring the array first would put the count after 1280 bytes of lights, and the feature that
    // fills this block writes it at zero.

    [PerDraw] var lightCount: int = 0


    /// Which of `probes` lights this object.
    ///
    /// Half of what per-object reflection probes cost, and they are numbers rather than bindings
    /// because the cubes are one array bound for the frame. The alternative — a descriptor set per
    /// probe, bound per draw — is a set per object in all but name, which is the cost the four-set
    /// convention exists to refuse.
    [PerDraw] var probeIndex: int = 0


    /// How much of the probe shows through, against the environment behind it.
    ///
    /// What makes probes blend rather than pop: a surface deep inside a probe's volume takes it
    /// whole, and one near the edge fades back to the sky over the probe's falloff distance. Per
    /// object because that is what the falloff is a function of — where the object is.
    [PerDraw] var probeWeight: float = 0f


    /// The host-filled light list. Read `lightCount` entries, not `MaxLights` — the rest is stale
    /// memory. Unused when clustering is on.
    [PerDraw] var lights: PunctualLight[MaxLights]


    /// Where the view is, which every specular term measures against.
    [PerView] var viewPosition: float3


    /// World to view, for placing a fragment in the cluster grid. Unused when clustering is off.
    [PerView] var view: mat4


    /// The per-object scalars, at the object's own slot. Read when `UseObjectRecords` is on.
    ///
    /// Its own buffer rather than more members of `transforms`, because the two have different
    /// owners: the transform feature knows where an object is and the lighting feature knows which
    /// probe reaches it. One buffer would be two features writing one layout at agreed offsets, which
    /// is exactly the cross-feature write `materialIndex` was moved out of.
    [PerFrame] var objects: Buffer<ObjectRecord>


    /// The sun, kept separate from the list: it has no position to cull against, so it is in every
    /// cluster and paying list traversal for it would be paying for nothing.
    [PerFrame] var lightDirection: float3


    [PerFrame] var lightColor: float3


    /// Which record this frame's objects start at, added to the instance index.
    ///
    /// The lighting feature's own ring, and not `transformBase`: two buffers, two rings, two frames
    /// in flight advancing independently. Sharing one base would read this frame's probes out of
    /// whichever region the other buffer happened to be writing.
    ///
    /// In the four bytes std140 left after `lightColor`, for the reason `transformBase` sits after
    /// `lightDirection`: put first it would cost the block sixteen, and put here it costs nothing.
    [PerFrame] var objectBase: int = 0


    /// The scene's whole light list, which the clustered variant indexes into rather than copying.
    ///
    /// The same buffer `ClusterCulling` culled, bound to both passes. A cluster's entry is an *index*
    /// into it, so the light itself exists once however many clusters reach it — which is the reason
    /// the culler writes indices rather than lights.
    [PerFrame] var lightBuffer: Buffer<PunctualLight>


    /// One list per cluster, as `ClusterCulling` wrote it.
    ///
    /// Per *frame* rather than per view, and that is a real constraint rather than a shrug: the grid
    /// is built in one camera's view space, so a second camera drawing the same frame would read the
    /// first one's clusters. Set 1 cannot hold it — a buffer there would make two shaders' set 1
    /// incompatible and the shared view set unbindable — so a split-screen frame needs a cluster
    /// buffer per view and a set 0 per view to go with it. Written down because the shape that would
    /// hide it is the one that binds without complaining.
    [PerFrame] var clusters: Buffer<ClusterLights>


    /// The camera parameters that place a fragment in the grid. The same values the culling pass was
    /// given, because a fragment that computes its cluster differently reads someone else's lights.
    [PerFrame] var tanHalfFov: float2 = float2(1f, 0.5625f)


    [PerFrame] var nearPlane: float = 0.1f

    [PerFrame] var farPlane: float = 1000f


    /// How many cascades the shadow atlas holds.
    ///
    /// A permutation because it sizes an array *in the block*, so the block's size differs per
    /// variant — the same argument as `MaxLights`, and the reason neither is a `const`. A project
    /// shipping one cascade should not carry four matrices it never reads, and
    /// `ShadowMapRenderer.CascadeCount` has to match: the host fills as many slots as it fitted, and
    /// a shader reading past them projects with a matrix nobody wrote.
    [Permutation] val CascadeCount: int = 4


    /// The directional light's cascades, near first, each mapping into its own tile of the atlas.
    ///
    /// This was one matrix and one distance, which meant one cascade: everything past the nearest
    /// slice projected outside its tile and came back unshadowed. Four matrices and the distances
    /// they are valid to is what makes a cascaded atlas actually cascade, and the *selection* is
    /// per fragment because that is what a cascade is — a fragment's own distance deciding which
    /// resolution it is shadowed at.
    [PerFrame] var cascades: ShadowCascade[CascadeCount]


    /// Over what distance shadows fade out at the last cascade's end.
    ///
    /// Without it the shadow term stops at a line across the ground, which reads as a rendering
    /// error rather than as the end of the shadow distance. `Lighting.CascadeFade` is the ramp.
    [PerFrame] var shadowFadeRange: float = 10f


    [PerFrame] var shadowMap: Texture2D

    [PerFrame] var shadowSampler: Sampler

    [PerFrame] var shadowTexelSize: float2 = float2(0.0009765625f, 0.0009765625f)

    [PerFrame] var shadowConstantBias: float = 0.03f

    [PerFrame] var shadowSlopeBias: float = 0.05f


    [PerFrame] var environment: TextureCube

    [PerFrame] var environmentSampler: Sampler

    [PerFrame] var environmentMipCount: float = 7f

    [PerFrame] var ambientIntensity: float = 1f


    /// Whether local reflection probes stand in for the environment where they apply.
    ///
    /// A permutation rather than a weight of zero, because the *work* differs: with it off there is
    /// no parallax correction, no second cube sample and no blend, which is most of the ambient term.
    ///
    /// ⚠ The cubes are still declared, and a host still binds them — see the note at the top of the
    /// file. A scene with no probes carries four cube descriptors it never samples, which is the cost
    /// this comment used to claim the permutation avoided.
    [Permutation] val UseReflectionProbe: bool = false


    /// How many probes a frame may have bound at once.
    ///
    /// A permutation because it sizes a *binding*: the array's length is in the descriptor set
    /// layout, so a project with four probes in view should not carry thirty-two descriptors. The
    /// same argument as `MaxLights`, one set further out.
    [Permutation] val ProbeCount: int = 4


    /// The probes' captures, prefiltered exactly as the environment is.
    ///
    /// One binding with a count rather than one binding per probe, which is what lets an object pick
    /// its own with an index instead of a descriptor set. The index comes from the per-draw block and
    /// is therefore uniform across a draw, so no descriptor-indexing extension is involved.
    [PerFrame] var probes: TextureCube[ProbeCount]


    [PerFrame] var probeSampler: Sampler


    /// Where each probe is and how it is corrected, in the same order as `probes`.
    [PerFrame] var probeVolumes: ReflectionProbeVolume[ProbeCount]


    /// The environment's diffuse irradiance, projected into nine coefficients per channel.
    ///
    /// Nine numbers rather than a texture, because irradiance is so smooth that order-2 spherical
    /// harmonics reproduce it to within a percent — and because the alternative this replaces was
    /// sampling the roughest mip of the reflection cube, which is a different integral: a mip is
    /// prefiltered against a GGX lobe and irradiance is the cosine lobe, so the ambient term was
    /// flatter than it should be everywhere and wrong at every silhouette.
    [PerFrame] var environmentSh: ShCoefficients


    /// The directional light's contribution, shadowed.
    ///
    /// The BRDF is the shading model's and the cosine is inside it, so what is left here is the
    /// light: its radiance, and whether this fragment can see it.
    func Direct(d: MaterialData, p: ShadingPoint, n: float3, v: float3, alpha: float): float3 {
        val light = Lighting.Directional(lightDirection, lightColor)
        val angles = ShadingAngles.Of(n, v, light.l)

        var s: ShadingVectors
        s.n = n
        s.v = v
        s.l = light.l

        // Shadowed only where the surface faces the light. Not an early return any more, because a
        // scattering material's whole contribution lives past the terminator — but the shadow lookup
        // itself is still worth skipping, and a fragment facing away is in shadow by geometry.
        val visibility = (UseShadows && angles.NdotL > 0f) ? Shadow(p, n, angles.NdotL) : 1f

        // The debug view replaces the sun's contribution rather than adding to it, and takes the
        // sun's own radiance as its scale — so the tint lands in the range the frame is already
        // exposing for and is not washed out by nineteen lamps and a sky. The shadow term still
        // darkens it, which is what makes a band readable *inside* a cascade as well as between two.
        if (ShowCascades) {
            val here = Lighting.NormalOffset(p.positionWS, n, angles.NdotL, shadowTexelSize.x * 64f)
            return CascadeColour(CascadeContaining(here)) * light.radiance * (0.3f + 0.7f * visibility)
        }

        return Shade(d, angles, s, alpha) * light.radiance * visibility
    }


    /// Every light this fragment has to consider, unshadowed.
    ///
    /// Which list that is comes from the permutation, and only one of the two loops is emitted. The
    /// *body* is the same either way — `Contribution` — because the difference between clustered and
    /// unclustered shading is entirely about which lights you look at, and nothing about what you do
    /// with one. Duplicating the BRDF calls into both loops is how the two would come to disagree.
    func Punctual(d: MaterialData, p: ShadingPoint, n: float3, v: float3, alpha: float): float3 {
        if (UseClusteredLights) {
            return Clustered(d, p, n, v, alpha)
        }

        var total = float3(0f)

        // Bounded by `MaxLights` and broken out of at `lightCount`, rather than looped to
        // `lightCount` directly: the bound is what lets a driver unroll and what keeps the index
        // provably inside the array. The early exit costs nothing when the list is short.
        for (i in 0 .. MaxLights - 1) {
            if (i >= lightCount) {
                break
            }

            total += Contribution(lights[i], d, p, n, v, alpha)
        }

        return total
    }


    /// The lights the culling pass put in this fragment's cluster.
    ///
    /// Two indirections per light — cluster to index, index to light — and that is the trade the
    /// whole scheme makes: a dependent read per light against iterating lights that are nowhere near
    /// this fragment. It wins as soon as the scene has more lights than a cluster typically holds,
    /// which is the point at which anyone reaches for clustering in the first place.
    func Clustered(d: MaterialData, p: ShadingPoint, n: float3, v: float3, alpha: float): float3 {
        var total = float3(0f)

        val cluster = ClusterGrid.Of(p.positionVS, tanHalfFov, nearPlane, farPlane)

        if (cluster >= clusters.Length) {
            return total
        }

        val list = clusters[cluster]

        for (i in 0 .. ClusterGrid.Capacity - 1) {
            if (uint(i) >= list.count) {
                break
            }

            val index = int(list.indices[i])

            // The culler and this pass see the same buffer, so an index out of range means they were
            // given different ones — a host mistake that would otherwise read whatever follows the
            // buffer, which on a GPU is a wrong colour on one driver and a device loss on another.
            if (index < lightBuffer.Length) {
                total += Contribution(lightBuffer[index], d, p, n, v, alpha)
            }
        }

        return total
    }


    /// One light's contribution to this surface.
    ///
    /// The early-out asks the surface as well as the angle, and that is the price of scattering: a
    /// material with no scatter colour is answered by every model here with zero once the cosine is
    /// zero, so skipping it is free — and one that has one is brightest exactly there.
    func Contribution(
        light: PunctualLight,
        d: MaterialData,
        p: ShadingPoint,
        n: float3,
        v: float3,
        alpha: float
    ): float3 {
        // The mirror direction, which is what a shaped light finds its representative point along. A
        // punctual light ignores it, and it is computed per light rather than once per fragment
        // because the light loop is where a shaded normal is already in registers — one `reflect` is
        // cheaper than the parameter it would otherwise have to be threaded through.
        val reflected = reflect(-v, n)

        val sample = Lighting.Resolve(light, p.positionWS, alpha, reflected)
        val angles = ShadingAngles.Of(n, v, sample.l)

        if (angles.NdotL <= 0f && Math.MaxComponent(d.scatterColor) <= 0f) {
            return float3(0f)
        }

        var s: ShadingVectors
        s.n = n
        s.v = v
        s.l = sample.l

        // ⚠ **Here rather than in the two loops**, which is the whole reason `Contribution` exists as
        // one function: the clustered path and the uniform-array path differ in which lights they
        // look at and in nothing about what they do with one. A shadow term added to one loop and not
        // the other is exactly the drift the note at the top of this file warns about, and it would
        // show up as a scene whose lights stop casting when clustering is switched on.
        //
        // The multiply is on the whole contribution — the BRDF included — rather than on the radiance
        // alone, because occlusion of a *light* occludes everything that light does. This is not
        // `d.occlusion`, which belongs to indirect light and to nothing else.
        val visibility = PunctualVisibility(light, p.positionWS, n, angles.NdotL)

        return Shade(d, angles, s, sample.alphaPrime) * sample.radiance * visibility
    }


    /// Which cascade shades a fragment at this distance.
    ///
    /// The nearest one that still covers it, which is the whole idea: the cascades are fitted to
    /// successive slices of the camera's frustum, so the first whose `split` a fragment is inside is
    /// the highest-resolution map that contains it. Falling through to the last is what a fragment
    /// beyond the shadow distance gets, and `Lighting.CascadeFade` is what stops that being a line.
    ///
    /// Bounded by the permutation and broken out of, the same shape the light loop has: the bound is
    /// what lets a driver unroll it and what keeps the index provably inside the array.
    func CascadeOf(viewDepth: float): int {
        var index = CascadeCount - 1

        for (i in 0 .. CascadeCount - 1) {
            if (viewDepth <= cascades[i].split) {
                index = i
                break
            }
        }

        return index
    }


    /// Where cascade `index` sits in the atlas: its offset in `xy`, its size in `zw`.
    ///
    /// `ShadowCascades.AtlasTile`'s arithmetic, in the shader, because the lookup needs the tile's
    /// *rectangle* and not only the matrix that lands inside it — a projection tells a fragment where
    /// it would sample and nothing about whether that is still its own tile. Recomputed rather than
    /// carried in `ShadowCascade`, since it is a function of the index and `CascadeCount` alone and
    /// both are already here; a field would be a third thing a host has to keep in step with the
    /// other two.
    /// The finest cascade whose tile actually contains a point, or −1 when none does.
    ///
    /// ⚠ **Containment, not depth**, and that distinction is a defect this file carried for its whole
    /// life. A cascade is fitted to a *sphere* around a slice of the frustum, so depth alone does not
    /// decide it: a fragment at the right distance but far off to the side — near the edges of a wide
    /// screen, which is most of the visible ground — is outside that cascade's box while its depth
    /// says otherwise. Being outside used to sample anyway, and with the tile folded into the matrix
    /// that means a *neighbouring cascade's* texels: real depths, from a map fitted to a different
    /// centre at a different scale, bounded by a hard straight line where the box ends.
    ///
    /// −1 rather than a fallback to the last cascade, because the two are different answers. A point
    /// no cascade covers has no shadow information at all, and saying so lets `ShowCascades` paint it
    /// and a reader distinguish "outside every cascade" from "cascade three".
    func CascadeContaining(offset: float3): int {
        var found = -1

        for (i in 0 .. CascadeCount - 1) {
            val clip = cascades[i].viewProjection * float4(offset, 1f)
            val ndc = Math.ClipToNdc(clip)
            val uv = Transform.NdcToUv(ndc)
            val tile = CascadeTile(i)
            val low = tile.xy
            val high = tile.xy + tile.zw

            // Split across three names rather than one chain, because a `&&` sequence has to fit on
            // one line here and seven terms do not.
            val depthInside = clip.w > 0f && ndc.z >= 0f && ndc.z <= 1f
            val horizontal = uv.x >= low.x && uv.x <= high.x
            val vertical = uv.y >= low.y && uv.y <= high.y

            if (found < 0 && depthInside && horizontal && vertical) {
                found = i
            }
        }

        return found
    }


    /// A flat colour per cascade, for `ShowCascades`. Magenta is "inside none of them".
    func CascadeColour(index: int): float3 {
        if (index == 0) {
            return float3(1f, 0.2f, 0.2f)
        }

        if (index == 1) {
            return float3(0.2f, 1f, 0.2f)
        }

        if (index == 2) {
            return float3(0.3f, 0.5f, 1f)
        }

        if (index == 3) {
            return float3(1f, 0.85f, 0.2f)
        }

        return float3(1f, 0f, 1f)
    }


    func CascadeTile(index: int): float4 {
        val columns = CascadeCount <= 1 ? 1 : 2
        val rows = (CascadeCount + columns - 1) / columns
        val scale = float2(1f / float(columns), 1f / float(rows))

        return float4(float(index % columns) * scale.x, float(index / columns) * scale.y, scale.x, scale.y)
    }


    /// The shadow term for this pixel, biased both ways — see `Lighting.ShadowBias`.
    ///
    /// The cascade is chosen from the fragment's own view depth rather than handed to the draw,
    /// which is what makes one atlas cover a whole frustum: a fragment two metres away and one two
    /// hundred metres away read different tiles of the same texture, at the resolution each needs.
    ///
    /// `view` is multiplied here rather than interpolated. A stream would cost every fragment in
    /// every variant a location, where this costs one matrix multiply in the shadowed one — and
    /// `positionVS` already exists for the clustered variant, which is the case that has a second
    /// use for it.
    func Shadow(p: ShadingPoint, n: float3, NdotL: float): float {
        val viewDepth = ClusterGrid.DepthOf(Math.TransformPoint(view, p.positionWS))
        val offset = Lighting.NormalOffset(p.positionWS, n, NdotL, shadowTexelSize.x * 64f)
        val index = CascadeContaining(offset)

        var shadow = 1f

        if (index >= 0) {
            val clip = cascades[index].viewProjection * float4(offset, 1f)
            val ndc = Math.ClipToNdc(clip)
            val uv = Transform.NdcToUv(ndc)
            val tile = CascadeTile(index)
            val low = tile.xy
            val high = tile.xy + tile.zw

            // ⚠ **Times the cascade's own depth scale, because a bias is a distance.** The two
            // constants are metres; a cascade's orthographic range is sixty metres for the nearest
            // and several hundred for the furthest, so without this one number is centimetres in one
            // cascade and metres in the next — a hard line along every boundary, acne where it lands
            // short, and light through a wall where it lands long.
            val bias = Lighting.ShadowBias(NdotL, shadowConstantBias, shadowSlopeBias) * cascades[index].depthScale

            // A texel and a half inside, so the filter cannot step across the seam into the next
            // cascade — the same clamp the punctual atlas takes, and for the same reason.
            val margin = shadowTexelSize * 1.5f
            val tap = clamp(uv, low + margin, high - margin)

            shadow = Lighting.ShadowPcf3x3(shadowMap, shadowSampler, tap, ndc.z - bias, shadowTexelSize)
        }

        val fade = Lighting.CascadeFade(viewDepth, cascades[CascadeCount - 1].split, shadowFadeRange)
        return lerp(1f, shadow, fade)
    }


    /// Image-based ambient: a prefiltered environment for specular, spherical harmonics for diffuse.
    ///
    /// The split-sum approximation, with both halves now coming from where they should. **The mip is
    /// chosen by roughness**, which it was not: this sampled the reflection at level zero whatever the
    /// material said, so every surface mirrored the environment and `environmentMipCount` and
    /// `Ibl.SpecularLod` were both dead. A rough metal reflecting a sharp environment reads as a
    /// material problem rather than as a missing argument, which is why it survived.
    ///
    /// `SampleLevel` rather than `Sample`, and not only to state the level: a fragment shader's implicit
    /// derivatives are undefined under non-uniform flow, and this is called from inside one.
    func Ambient(d: MaterialData, p: ShadingPoint, n: float3, v: float3): float3 {
        var specular = float3(0f, 0f, 0f)
        var incoming = float3(0f, 0f, 0f)

        if (UseImageBasedLighting) {
            val NdotV = saturate(dot(n, v))
            val reflected = reflect(-v, n)

            val dfg = Ibl.EnvironmentDfg(NdotV, d.perceptualRoughness)
            val lod = Ibl.SpecularLod(d.perceptualRoughness, environmentMipCount)

            var prefiltered = environment.SampleLevel(environmentSampler, reflected, lod).rgb

            // `ProbeWeight()` rather than the block's field, which is master's: a clustered frame binds
            // no per-draw set, so the weight comes from the object record where there is one.
            if (UseReflectionProbe) {
                prefiltered = lerp(prefiltered, Probe(p, d.perceptualRoughness, reflected), saturate(ProbeWeight(p)))
            }

            specular = Ibl.Specular(prefiltered, d.f0, dfg, d.occlusion)

            // `incoming` rather than a local named `irradiance`, which is what this was: the compose slot
            // below is called `irradiance` and a local of the same name shadows it.
            incoming = Ibl.IrradianceSh9(n, environmentSh)
        }

        if (UseIrradianceField) {
            // `v` already points at the camera — the convention `IIrradianceSource.Sample` asks for —
            // so the view bias costs this call site nothing but the argument.
            val sample = SampleIrradiance(p.positionWS, n, v)

            // ⚠ Times π, and the round trip is the point rather than a waste. The field stores irradiance
            // DIVIDED by π — the number a shading pass multiplies straight by albedo — and `Ibl.Diffuse`
            // takes plain irradiance and does that division itself. Handing it the field's value unscaled
            // divides by π twice, which is indirect light three and an eighth times too dim: dark enough
            // to look like a tuning problem and bright enough not to look like a bug.
            val lit = sample.irradiance * Const.Pi

            // Blended on coverage, not added. The field's rays already hit the sky, so its answer contains
            // what the sky contributes; where the field has no answer the sky is the fallback, and where
            // it half-believes one the two are mixed in that proportion.
            incoming = lerp(incoming, lit, saturate(sample.coverage))
        }

        val diffuse = Ibl.Diffuse(incoming, d.diffuseColor, d.occlusion)
        return (specular + diffuse) * ambientIntensity
    }


    /// Which probe reaches this object: from the record when there is one, from the block otherwise.
    ///
    /// The two sources exist because the per-draw block is not bound on every path. A clustered frame
    /// binds no per-draw set at all, so reading the block there returns whatever set 3 last held —
    /// which is a plausible picture, not an error: every object reflecting one object's probe.
    func ProbeIndex(p: ShadingPoint): int {
        if (UseObjectRecords) {
            return objects[objectBase + p.objectIndex].probeIndex
        }

        return probeIndex
    }


    /// How much of it shows through, on the same terms.
    func ProbeWeight(p: ShadingPoint): float {
        if (UseObjectRecords) {
            return objects[objectBase + p.objectIndex].probeWeight
        }

        return probeWeight
    }


    /// The local probe's radiance along a reflection, corrected for where it was captured from.
    ///
    /// **Without the correction a probe is worse than no probe.** A cubemap is captured from one
    /// point, so sampling it by direction alone reflects the room as seen from that point — a floor
    /// two metres away reflects the ceiling above the probe rather than what is above the floor, and
    /// the reflection slides as the camera moves. Re-aiming the direction from the probe's centre
    /// toward where the ray actually meets the probe's volume is what makes it sit still.
    func Probe(p: ShadingPoint, perceptualRoughness: float, reflected: float3): float3 {
        // Clamped rather than trusted: the index arrives in a per-object block a host filled, and
        // an out-of-range one reads a descriptor nobody wrote — a wrong reflection on one driver and
        // a device loss on another.
        val index = clamp(ProbeIndex(p), 0, ProbeCount - 1)
        val volume = probeVolumes[index]

        var corrected = Ibl.ParallaxCorrect(reflected, p.positionWS, volume.box)

        if (volume.radius > 0f) {
            corrected = Ibl.ParallaxCorrectSphere(reflected, p.positionWS, volume.box.center, volume.radius)
        }

        val lod = Ibl.SpecularLod(perceptualRoughness, volume.mipCount)
        return probes[index].SampleLevel(probeSampler, corrected, lod).rgb
    }
}
