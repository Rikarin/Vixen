package Vixen.Shaders.Pipeline

import Vixen.Shaders.Core
import Vixen.Shaders.Geometry

// Rendering into a shadow map.
//
// Almost `DepthOnly`, and deliberately not the same shader. Two differences make it its own pass:
//
//   - The matrix is the *light's* view-projection, not the camera's. Sharing a shader would mean one
//     binding meaning different things in different passes, which is exactly the kind of thing that
//     is invisible until shadows are subtly displaced.
//   - It applies a depth bias in the vertex stage along the normal, which a camera pass must not.
//
// The bias belongs here rather than in the rasteriser state because a normal-offset bias needs the
// vertex normal, which only a shader has. See `Lighting.NormalOffset` for the fragment-stage counterpart
// and why both exist.
//
// It is also the pass that has to be skinned, and the reason is a bug rather than a feature: a skinned
// mesh whose *shadow* pass is not skinned casts the shadow of its bind pose, so a running character
// drags a T-posed silhouette behind it. Making the skinning a permutation of the depth-style pass
// rather than a separate shader is what keeps the two from drifting apart.

shader ShadowCaster {
    [Permutation] val AlphaTested: bool = false

    /// Whether to skin the vertex. Off removes the palette binding, its attributes and the blend.
    [Permutation] val Skinned: bool = false

    /// The light's view-projection, not the camera's — and it arrives as the *view's*.
    ///
    /// ⚠ `[PerView]`, spelt exactly as `ForwardPlus` spells it, because a cascade **is** a view: the
    /// shadow node makes one `RenderView` per cascade and the pass binds set 1 per tile, so there is
    /// nothing for a caster to be told that the frame does not already say. It was an unmarked `var`
    /// — set 2, the material's — which no feature in the engine writes: the caster drew every object
    /// through whatever the block happened to hold, and the set it needed was never bound at all.
    ///
    /// The name matters as much as the set. Set 1 is a contract between shaders rather than any one
    /// shader's business, and `ViewConstants` writes `viewProjection` at offset zero.
    [PerView] var viewProjection: mat4

    /// Object to world, pushed rather than bound — `TransformRenderFeature`'s, as `ForwardPlus` has it.
    ///
    /// The other half of the same correction. A push is what the engine already does with this
    /// matrix, and a shader saying anything else is a disagreement nothing reports: the push landed
    /// on a layout with no range for it, which is a validation error per draw, and the block the
    /// vertex stage actually read was never written.
    [PushConstant] var world: mat4

    /// World-space distance to offset along the normal, usually one shadow-map texel.
    var normalBias: float = 0.02f

    var opacityMap: Texture2D
    var opacitySampler: Sampler
    var alphaCutoff: float = 0.5f

    /// The bone palette, as the storage buffer `Skinning.BoneMatrix` was written for.
    ///
    /// ⚠ **A buffer rather than `mat4[Skinning.MaxBones]`, and the reason is a limit rather than a
    /// preference.** Vulkan guarantees only 16384 bytes of uniform buffer range, and 256 matrices is
    /// exactly that — so a uniform palette *plus* this shader's two scalars is a block past the
    /// guaranteed size, on a pass whose whole point is to run everywhere cheaply. A storage buffer has
    /// no such limit, costs the material's block nothing, and is the case `BoneMatrix` says it exists
    /// for. `Skinning.MaxBones` stays what a host sizes the palette by.
    var bones: Buffer<BoneMatrix>

    stream var uv: float2

    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex(position: float3, normal: float3, texcoord: float2, bones0: float4, weights0: float4): float4 {
        uv = texcoord

        var local = position
        var localNormal = normal

        if (Skinned) {
            val skin = Blend(bones0, weights0)
            local = Math.TransformPoint(skin, position)
            localNormal = Math.TransformDirection(skin, normal)
        }

        val worldPosition = Math.TransformPoint(world, local)
        val worldNormal = Math.TransformNormalRigid(world, localNormal)
        val offset = worldPosition + worldNormal * normalBias

        return viewProjection * float4(offset, 1f)
    }

    /// The four matrices this vertex needs, fetched out of the palette and blended.
    ///
    /// This is the whole reason `Skinning` takes matrices rather than the palette: here the four reads
    /// are access chains into the buffer and nothing is copied, whereas handing `bones` to a function
    /// would copy all sixteen kilobytes of it. The indices arrive as floats because a vertex attribute
    /// is what the mesh format gives — glTF stores them as unsigned bytes, which the input assembler
    /// converts — and an index is exact in a float well past 256.
    func Blend(indices: float4, weights: float4): mat4 {
        var palette: BonePalette
        palette.bone0 = bones[int(indices.x)].matrix
        palette.bone1 = bones[int(indices.y)].matrix
        palette.bone2 = bones[int(indices.z)].matrix
        palette.bone3 = bones[int(indices.w)].matrix

        return Skinning.BlendMatrix(palette, weights)
    }

    /// A cut-out texel casts no shadow, which only a `discard` can say: a returned zero still writes
    /// depth into the shadow map, and a shadow map is nothing but depth — so the holes in a leaf
    /// would cast the shadow of a solid quad.
    ///
    /// No `SV_Target`, deliberately: every pass this shader draws into is depth-only, and a colour
    /// output with no attachment behind it is a validation warning per draw — dozens a frame, which
    /// hit the validator's duplicate limit inside the first frame and silence whatever real warning
    /// comes next.
    [FragmentShader]
    func Fragment() {
        if (AlphaTested) {
            val opacity = opacityMap.Sample(opacitySampler, uv).a
            if (opacity < alphaCutoff) {
                discard
            }
        }
    }
}
