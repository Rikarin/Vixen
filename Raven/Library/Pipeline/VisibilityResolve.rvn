package Vixen.Shaders.Pipeline

import Vixen.Shaders.Core
import Vixen.Shaders.Shading
import Vixen.Shaders.Geometry
import Vixen.Shaders.Material
import Vixen.Shaders.IrradianceFields
import Vixen.Shaders.PunctualShadows
import Vixen.Shaders.VirtualShadows

// Shading the visibility buffer: the second half of phase 5.
//
// **A second entry contract, not a second material system.** `ForwardPlus.rvn` receives its surface's
// inputs — the normal, the tangent, the texture coordinate — from the rasterizer's interpolators. This
// receives them from a fetch-and-interpolate prologue over the triangle the pixel landed on, and then
// does the same thing with them: fills a `MaterialData` from the same `IMaterialSurface`, and asks the
// same `IShadingModel` what the surface does with a light. Adding a material feature does not touch
// this file any more than it touches that one.
//
// **One workgroup per tile, dispatched per material.** `VisibilityTiles.rvn` bins the screen and this
// runs over one material's bin, so a material covering one per cent of the screen shades one per cent
// of the pixels. A pixel whose material is not this dispatch's is skipped — a tile belongs to every
// material that appears in it, and the bin is a superset of the pixels.
//
// **The gradients are analytic.** A compute stage has no quad to take derivatives from, so
// `MaterialData.uvDdx` and `uvDdy` are filled from the triangle plane and `MaterialTextures` samples
// with them. That is what `UseAnalyticGradients` selects, and it is the first consumer of the
// `SampleGrad` support built as blocker B3.
//
// **The lighting is `ClusteredShading`'s, which both this and `ForwardPlus` derive from.** The
// directional term, the clustered punctual loop, the shadow cascades and the ambient term are all the
// same code reached from two entry points — so a surface shaded through the resolve gets the same lights
// with the same shadows as one shaded through a draw, by construction rather than by two
// implementations agreeing about what "every light that reaches this point" means. What each pass
// supplies is a `ShadingPoint`: the three things lighting needs to know about where a pixel is, which a
// rasterizer interpolates and this reconstructs.

shader VisibilityResolve : ClusteredShading {

    /// Whether the resolve splits its answer across four planes, on `ForwardPlus.SplitOutputs`'s
    /// exact terms — same key name, same target order, same semantics.
    ///
    /// The resolve shades into the same frame the forward pass does, and the two paths disagreeing
    /// per pixel is the bug class `ClusteredShading` exists to remove: a virtualized mesh whose
    /// ambient stayed baked into its colour while its forward-drawn neighbour's moved to the
    /// combine would split the difference right down a material boundary. So the split lands in
    /// both or in neither. Only diffuse ambient always moves — specular ambient stays in the colour
    /// unless the frame replaces it, see `ClusteredShading.AmbientSpecular` — and the three extra
    /// planes carry what `ForwardTargets`' members carry: albedo with the material's occlusion in
    /// alpha, normal with roughness in alpha, and `f0` with an unused alpha.
    ///
    /// ⚠ A compute pass has no render targets to prune, so the three planes below are *bindings*,
    /// and a binding is in the plan whether or not a variant writes it — the note at the top of
    /// `ForwardPlus.rvn`. A host binds all four storage images in every variant;
    /// `GpuClusterResolve` aliases the colour target into the spare slots when the split is off,
    /// which costs three descriptor writes and no bytes.
    [Permutation] val SplitOutputs: bool = false

    /// What the surface does with a light, chosen per material — the same slot `ForwardPlus` composes.
    ///
    /// Declared here rather than on `ClusteredShading` for the reason that one gives: a composed model's
    /// own uniforms attach to the shader that declares the slot, and a host looks for them on the pass.
    compose val shading: IShadingModel

    /// The composed model, reached from the shared light loops.
    override func Shade(d: MaterialData, a: ShadingAngles, s: ShadingVectors, alpha: float): float3 {
        return shading.Shade(d, a, s, alpha)
    }

    /// Where indirect diffuse comes from, on `ForwardPlus`'s terms and defaulted the same way.
    ///
    /// **The default is what makes this declarable at all.** A slot has to resolve in every compilation
    /// that declares it, reached or not — so before slots could name their own default, declaring this
    /// here would have obliged every compilation of the library to bind it, including the ones compiling
    /// something else entirely. The alternative was to not declare it, and that is what this file did:
    /// the resolve got sky ambient where a forward-drawn pixel got field ambient, which is a divergence
    /// in exactly the place `ClusteredShading` exists to remove.
    compose val irradiance: IIrradianceSource = NoIrradiance

    /// The composed field, reached from the shared ambient term.
    override func SampleIrradiance(position: float3, n: float3, v: float3): IrradianceSample {
        return irradiance.Sample(position, n, v)
    }

    /// Where a spot or a point light's shadow comes from, on `ForwardPlus`'s terms and defaulted the
    /// same way — for the reason the slot above states, one feature along.
    ///
    /// A resolve that shaded its lights unshadowed while a forward draw shadowed them would put a
    /// virtualized mesh and a classic one under different lighting in the same frame, which is
    /// precisely the divergence `ClusteredShading` was extracted to make impossible.
    compose val punctualShadow: IPunctualShadowSource = NoPunctualShadows

    /// Where the sun's shadow comes from, on exactly those terms.
    ///
    /// `NoDirectionalShadows` is the cascades: it answers `found = 0` for every point, and
    /// `ClusteredShading.Shadow` falls through to the atlas it already had. A project that composes
    /// `VirtualShadowLookup` gets phase 7's map where its pages are drawn and the cascades everywhere
    /// else, which is what lets the feature be turned on without a frame changing anywhere it has
    /// nothing to say.
    compose val directionalShadow: IDirectionalShadowSource = NoDirectionalShadows

    /// The composed map, reached from the shared shadow term.
    override func DirectionalShadow(positionWS: float3, n: float3, NdotL: float, viewDepth: float): DirectionalShadowSample {
        return directionalShadow.Sample(positionWS, n, NdotL, viewDepth)
    }

    /// The composed atlas, reached from the shared light loop.
    override func PunctualVisibility(light: PunctualLight, positionWS: float3, n: float3, NdotL: float): float {
        return punctualShadow.Visibility(light, positionWS, n, NdotL)
    }

    /// The material's surface features, chosen per material — the same slot `ForwardPlus` composes.
    compose val surface: IMaterialSurface

    /// The identity buffer the raster wrote. See `ClusterRaster.rvn`.
    ///
    /// Integer-sampled for the reason `VisibilityTiles.rvn` gives: the view is `R32_UINT`, and the
    /// component type is part of the descriptor.
    var identities: Texture2D<uint4>

    /// Where the shaded colour goes.
    ///
    /// Half-float rather than eight-bit, because what a resolve writes is radiance before tonemapping —
    /// the same thing the forward pass writes into the scene colour it shares with every post-effect.
    /// A storage image's texel format is part of its declaration in both targets, which is why it is
    /// spelled here rather than decided by the host.
    [Format("rgba16f")] var target: RWTexture2D<float4>

    /// The clusters the traversal accepted, headed by its counters — see `Cull.VisibleBase`.
    ///
    /// **Which raster drew a pixel does not appear here**, and that is phase 6's whole arrangement: a
    /// hardware-drawn cluster and a software-drawn one are entries of the same list, so a resolve reads
    /// one buffer and asks one question.
    var visible: Buffer<uint>

    /// One record per instance, as `Culling.rvn` writes it.
    var instances: Buffer<CullInstance>

    /// Where each cluster's bytes are — the same records the raster read.
    var geometry: Buffer<RasterCluster>

    /// One quantization grid per registered mesh.
    var meshes: Buffer<RasterMesh>

    /// Where each page sits in the pool, or `Cull.PageAbsent`.
    var residency: Buffer<uint>

    /// The page pool, as words.
    var pages: Buffer<uint>

    /// Every skinned instance's matrices this frame — the same palette the raster read.
    var bones: Buffer<BoneMatrix>

    /// Which material each cluster uses.
    var clusterMaterials: Buffer<uint>

    /// This material's tile list, `tileBase` words into the shared buffer.
    var tiles: Buffer<uint>

    /// How many bytes one page occupies in the pool.
    var pageSize: uint

    /// Where this frame's instance records start, in records, and its palettes, in matrices.
    ///
    /// The raster reads the same two. They are base indices rather than descriptor offsets because this
    /// set is filled by `EffectSetWriter`, which binds a storage buffer whole — so a descriptor offset
    /// would be right in the raster and a frame stale here, which is the two transforms disagreeing by
    /// the one route no shader change can be blamed for.
    var instanceBase: uint

    var boneBase: uint

    var residencyBase: uint

    /// Where this dispatch's tiles start in `tiles`, and which material it is shading.
    var tileBase: uint

    var material: uint

    /// How many tiles cover the screen, in x and y.
    var tileCount: int2

    /// The camera, for projecting the triangle's corners the way the raster did.
    var viewProjection: mat4

    /// The split's second plane: diffuse albedo, the material's occlusion in alpha. Written only
    /// when `SplitOutputs` is on; bound always, because a binding is declared rather than read.
    ///
    /// Declared after everything that existed, deliberately: a binding index comes from
    /// declaration order within a set, so appending keeps every index a host already generated.
    [Format("rgba16f")] var albedoTarget: RWTexture2D<float4>

    /// And its third: the shading normal in world space, perceptual roughness in alpha.
    [Format("rgba16f")] var normalTarget: RWTexture2D<float4>

    /// And its fourth: specular reflectance at normal incidence — `MaterialData.f0`, alpha unused.
    ///
    /// Appended for the reason `albedoTarget` states, one plane along. `ForwardTargets.specular`
    /// carries the audit for why it is `f0` and three channels rather than one metalness channel.
    [Format("rgba16f")] var specularTarget: RWTexture2D<float4>

    /// One workgroup per tile of this material's bin, one invocation per pixel.
    ///
    /// The dispatch is indirect: `VisibilityTiles.rvn` wrote the tile count into the argument triple
    /// this reads, so the host never learns how much of the screen this material covers.
    [ComputeShader(64)]
    func Main([Semantic("SV_GroupID")] group: uint3, [Semantic("SV_GroupIndex")] lane: uint) {
        val index = int(tileBase + group.x)

        if (index >= tiles.Length) {
            return
        }

        val tile = VisibilityTile.Unindex(int(tiles[index]), tileCount)
        val offset = int2(int(lane) % VisibilityTile.Size, int(lane) / VisibilityTile.Size)
        val pixel = tile * VisibilityTile.Size + offset
        val size = identities.GetDimensions(0)

        if (pixel.x >= size.x || pixel.y >= size.y) {
            return
        }

        val identity = identities.Load(int3(pixel.x, pixel.y, 0)).x

        if (!Raster.Covered(identity)) {
            return
        }

        val entry = Raster.Slot(identity) + uint(Cull.VisibleBase)

        if (entry >= uint(visible.Length)) {
            return
        }

        val packed = visible[int(entry)]
        val instance = instances[int(instanceBase + Cull.VisibleInstance(packed))]
        val cluster = int(instance.firstCluster + Cull.VisibleCluster(packed))

        // A tile is in this material's bin because *some* pixel of it is this material. The rest are
        // some other dispatch's, and skipping them is what makes the bin a superset rather than a lie.
        if (clusterMaterials[cluster] != material) {
            return
        }

        val record = geometry[cluster]
        val page = residency[int(residencyBase + record.page)]

        if (page == Cull.PageAbsent) {
            return
        }

        Shade(pixel, size, identity, record, page, instance, meshes[int(instance.mesh)])
    }

    /// Reconstructs one pixel's surface and shades it.
    ///
    /// **The vertex-side transform is the raster's, verbatim.** The corners are decoded from the same
    /// page bytes by the same arithmetic and placed by the same instance transform, because a
    /// disagreement between the two lands attributes on the wrong surface — the plan flags this and it
    /// is why `Corner` exists once rather than being inlined twice.
    func Shade(
        pixel: int2,
        size: int2,
        identity: uint,
        record: RasterCluster,
        page: uint,
        instance: CullInstance,
        mesh: RasterMesh
    ) {
        val triangle = Raster.Triangle(identity)

        if (triangle >= record.triangleCount) {
            return
        }

        val start = page * pageSize
        val at = start + record.triangleOffset + triangle * 3u

        val v0 = Corner(start, record, mesh, instance, Byte(at))
        val v1 = Corner(start, record, mesh, instance, Byte(at + 1u))
        val v2 = Corner(start, record, mesh, instance, Byte(at + 2u))

        val clip0 = viewProjection * float4(v0.position, 1f)
        val clip1 = viewProjection * float4(v1.position, 1f)
        val clip2 = viewProjection * float4(v2.position, 1f)

        // The pixel's centre in NDC, which is where the rasterizer decided coverage.
        val uv = (float2(float(pixel.x), float(pixel.y)) + float2(0.5f, 0.5f)) / float2(float(size.x), float(size.y))
        val ndc = Transform.UvToNdc(uv)
        val pixelSize = float2(2f / float(size.x), 2f / float(size.y))

        val b = Barycentric.Solve(ndc, clip0, clip1, clip2, pixelSize)

        val positionWS = Barycentric.Lerp3(b, v0.position, v1.position, v2.position)
        val normalWS = Math.SafeNormalize(Barycentric.Lerp3(b, v0.normal, v1.normal, v2.normal))
        val texcoord = Barycentric.Lerp2(b, v0.uv, v1.uv, v2.uv)

        // The tangent is derived rather than stored: a page vertex carries a position, a normal and a
        // coordinate, and a tangent is what those three imply. `FrameFromDerivatives` wants the screen
        // derivatives of both, which the analytic gradients are — so this is the one place a resolve is
        // *better* placed than a fragment stage, which would have to interpolate a stored tangent.
        val geometricNormal = Math.SafeNormalize(cross(v1.position - v0.position, v2.position - v0.position))
        val frame = Normals.Frame(normalWS, TangentOf(b, v0, v1, v2, geometricNormal), 1f)

        var d: MaterialData
        MaterialDefaults.Begin(d, frame.normal, float4(frame.tangent, 1f), texcoord)

        d.uvDdx = Barycentric.Ddx2(b, v0.uv, v1.uv, v2.uv)
        d.uvDdy = Barycentric.Ddy2(b, v0.uv, v1.uv, v2.uv)

        surface.Compute(d)

        val v = Math.SafeNormalize(viewPosition - positionWS)
        val n = Normals.FaceForward(Math.SafeNormalize(d.normalWS), v)
        val alpha = Brdf.Alpha(d.perceptualRoughness)

        // The three things lighting needs to know about where this pixel is. `objectIndex` is negative
        // because a resolve shades a cluster of a mesh rather than a render object — which is what makes
        // the per-object reflection probe fall back to the block, exactly as it does on any path that
        // binds no per-draw set.
        var point: ShadingPoint
        point.positionWS = positionWS
        point.positionVS = Math.TransformPoint(view, positionWS)
        point.objectIndex = -1

        var color = Direct(d, point, n, v, alpha)
        color += Punctual(d, point, n, v, alpha)

        if (SplitOutputs) {
            // Diffuse ambient is the combine's job now; the specular half stays unless the frame
            // has a traced plane to put in its place, which `ambientSpecularScale` says —
            // `ForwardPlus` makes the same move under the same key, which is the point.
            if (UseImageBasedLighting) {
                color += AmbientSpecular(d, point, n, v)
            }

            albedoTarget.Store(pixel, float4(d.diffuseColor, d.occlusion))
            normalTarget.Store(pixel, float4(n, d.perceptualRoughness))
            specularTarget.Store(pixel, float4(d.f0, 0f))
        } else {
            if (UseImageBasedLighting || UseIrradianceField) {
                color += Ambient(d, point, n, v)
            }
        }

        target.Store(pixel, float4(color + d.emissive, d.alpha))
    }

    /// A tangent from the triangle's own texture coordinates.
    ///
    /// The gradient of the surface with respect to `u`, orthogonalised against the shading normal.
    /// Derived rather than stored, and derived from the *analytic* gradients rather than from a quad —
    /// so it is exact within the triangle and does not smear across a silhouette.
    func TangentOf(
        b: Barycentrics,
        v0: ResolvedVertex,
        v1: ResolvedVertex,
        v2: ResolvedVertex,
        fallback: float3
    ): float3 {
        val du = Barycentric.Ddx2(b, v0.uv, v1.uv, v2.uv)
        val dv = Barycentric.Ddy2(b, v0.uv, v1.uv, v2.uv)
        val px = Barycentric.Ddx3(b, v0.position, v1.position, v2.position)
        val py = Barycentric.Ddy3(b, v0.position, v1.position, v2.position)

        val determinant = du.x * dv.y - dv.x * du.y

        // A triangle whose coordinates do not vary — an untextured surface, or one whose whole cluster
        // maps to a point — has no tangent to find. Any vector perpendicular to the normal will do, and
        // an arbitrary one beats a zero: a zeroed frame maps every tangent-space normal to nothing.
        if (abs(determinant) < 1e-12f) {
            return Normals.Frame(fallback, float3(1f, 0f, 0f), 1f).tangent
        }

        return Math.SafeNormalize((px * dv.y - py * du.y) / determinant)
    }

    /// One decoded page vertex, in world space.
    func Corner(
        start: uint,
        record: RasterCluster,
        mesh: RasterMesh,
        instance: CullInstance,
        local: uint
    ): ResolvedVertex {
        val at = start + record.vertexOffset + local * record.vertexStride

        val x = record.origin.x + int(Short(at))
        val y = record.origin.y + int(Short(at + 2u))
        val z = record.origin.z + int(Short(at + 4u))

        var object = mesh.quantizationOrigin + float3(float(x), float(y), float(z)) * mesh.quantizationStep

        // The attributes, at their offsets past the six bytes of position: a normal as three halves and
        // a coordinate as two. `ModelCompiler.PageAttributeStride` is the other side of this layout.
        var normal = Math.SafeNormalize(float3(Half(at + 6u), Half(at + 8u), Half(at + 10u)))

        // **The pose, by the same call the raster makes on the same bytes.** A disagreement here does
        // not look like a bug: the picture is a plausible character, and the material is sampled from
        // wherever that vertex was in some other pose. Phase 5 asks for an assertion rather than a
        // comment, and `SkinnedResolveTests` is it.
        if (mesh.influenceOffset != RasterMesh.NoInfluences && instance.firstBone != Cull.NoBones) {
            val skin = Skin(at + mesh.influenceOffset, instance)

            object = Math.TransformPoint(skin, object)

            // A direction and not a point, so the translation is dropped — and renormalised, because a
            // blend of two rotations is not one. `Skinning.Direction` is exactly this pair.
            normal = Math.SafeNormalize(Math.TransformDirection(skin, normal))
        }

        var result: ResolvedVertex
        result.position = instance.position + object * instance.scale
        result.normal = normal
        result.uv = float2(Half(at + 12u), Half(at + 14u))

        return result
    }

    /// The one matrix a vertex's four influences blend to. `ClusterRaster.Skin`, verbatim.
    func Skin(at: uint, instance: CullInstance): mat4 {
        val indices = Word(at)
        val start = int(boneBase + instance.firstBone)

        var palette: BonePalette
        palette.bone0 = bones[start + int(Influences.Bone(indices, 0))].matrix
        palette.bone1 = bones[start + int(Influences.Bone(indices, 1))].matrix
        palette.bone2 = bones[start + int(Influences.Bone(indices, 2))].matrix
        palette.bone3 = bones[start + int(Influences.Bone(indices, 3))].matrix

        return Skinning.BlendMatrix(palette, Influences.Weights(Word(at + 4u)))
    }

    /// One whole word out of the pool, at a four-byte-aligned byte offset.
    func Word(at: uint): uint => pages[int(at >> 2)]

    /// One byte out of the pool, at a byte offset.
    func Byte(at: uint): uint {
        val word = pages[int(at >> 2)]
        return (word >> int((at & 3u) * 8u)) & 0xFFu
    }

    /// One unsigned short out of the pool, at a byte offset.
    func Short(at: uint): uint {
        val word = pages[int(at >> 2)]
        return (word >> int((at & 2u) * 8u)) & 0xFFFFu
    }

    /// One half-precision float out of the pool, at a byte offset.
    ///
    /// **Decoded by arithmetic, because neither target offers a scalar half conversion Raven exposes.**
    /// A half is a sign, five bits of exponent biased by fifteen, and ten of mantissa; a float is the
    /// same shape biased by a hundred and twenty-seven with twenty-three. So the conversion is a
    /// re-bias and a shift, and it is exact for every normal half — which is every value a normal or a
    /// texture coordinate takes.
    ///
    /// A zero exponent returns zero rather than reconstructing the subnormal. Half's smallest normal is
    /// about six hundredths of a thousandth; a normal component or a texture coordinate below that is
    /// zero for every purpose this has, and the branch that handled it properly would cost every vertex
    /// of every pixel a leading-zero count.
    func Half(at: uint): float {
        val bits = Short(at)
        val exponent = (bits >> 10) & 0x1Fu

        if (exponent == 0u) {
            return 0f
        }

        val sign = (bits & 0x8000u) << 16
        val mantissa = (bits & 0x3FFu) << 13

        return asfloat(sign | ((exponent + 112u) << 23) | mantissa)
    }
}

/// One page vertex, decoded.
struct ResolvedVertex {
    var position: float3
    var normal: float3
    var uv: float2
}
