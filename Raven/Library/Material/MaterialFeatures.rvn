package Vixen.Shaders.Material

import Vixen.Shaders.Core
import Vixen.Shaders.Shading
import Vixen.Shaders.Geometry

// The optional surface features, and the chains that let a material have more than one of them.
//
// `MaterialSurface.rvn` holds the features every material needs to choose between — a workflow, a
// normal map, emission, occlusion. These are the ones that switch on a lobe: a material without a
// clear coat should not pay for one, and with composition it does not, because the feature that
// writes `clearCoat` is not in its chain and the shading model that reads it is not bound.
//
// **A feature writes channels; a shading model reads them.** The split is what keeps the two sets
// small: `ClearCoatSurface` says how strong the coat is at this point on the surface, and
// `ClearCoatShading` (ShadingModels.rvn) says what a coat does to light. Parameters that vary over a
// surface belong here; parameters that describe the model itself — a wrap width, a cel ramp's step
// count — belong on the shading model, where there is one of them rather than one per texel.

/// Stretches the specular lobe along the tangent: brushed metal, hair, vinyl, silk.
///
/// The tangent it stretches along is the mesh's, through `MaterialData.tangentFrame` — the same basis
/// a normal map is rotated by. A material whose anisotropy runs at an angle to the UV grain needs a
/// rotation, which is not here: it belongs with the tangent frame rather than with this scalar, and
/// nothing yet authors one.
shader AnisotropySurface : IMaterialSurface {
    var anisotropy: float = 0f

    func Compute(inout d: MaterialData) {
        d.anisotropy = clamp(anisotropy, -1f, 1f)
    }
}

/// Adds a clear coat: car paint, lacquered wood, a wet surface.
shader ClearCoatSurface : IMaterialSurface {
    var clearCoat: float = 1f
    var clearCoatRoughness: float = 0.1f

    func Compute(inout d: MaterialData) {
        d.clearCoat = saturate(clearCoat)
        d.clearCoatRoughness = saturate(clearCoatRoughness)
    }
}

/// Bends the coat's normal without touching the base's — scratches in the lacquer.
///
/// Deliberately a second feature rather than two more parameters on `ClearCoatSurface`: a coat with
/// its own normal map is the uncommon case, and folding it in would put the rotation's arithmetic in
/// every material that has a plain coat.
shader ClearCoatNormalMapSurface : IMaterialSurface {
    var clearCoatNormalTS: float3 = float3(0f, 0f, 1f)
    var clearCoatNormalStrength: float = 1f

    func Compute(inout d: MaterialData) {
        val s = clearCoatNormalStrength
        val scaled = Math.SafeNormalize(float3(clearCoatNormalTS.x * s, clearCoatNormalTS.y * s, clearCoatNormalTS.z))
        d.clearCoatNormalWS = Normals.ToWorld(d.tangentFrame, scaled)
    }
}

/// Adds the retroreflective rim fabric has: velvet, satin, brushed cloth.
shader SheenSurface : IMaterialSurface {
    var sheenColor: float3 = float3(0f)
    var sheenRoughness: float = 0.3f

    func Compute(inout d: MaterialData) {
        d.sheenColor = max(sheenColor, float3(0f))
        d.sheenRoughness = saturate(sheenRoughness)
    }
}

/// Lets light through the surface: skin, wax, leaves, thin cloth.
///
/// `thickness` is in metres and is what makes a leaf's veins read as thicker than its blade. It is a
/// material channel rather than a shading-model parameter for exactly that reason — it varies over
/// the surface, and the wrap width does not.
shader SubsurfaceSurface : IMaterialSurface {
    var scatterColor: float3 = float3(0f)
    var thickness: float = 0f

    func Compute(inout d: MaterialData) {
        d.scatterColor = max(scatterColor, float3(0f))
        d.thickness = max(thickness, 0f)
    }
}

// --- The chain ---------------------------------------------------------------------------------
//
// A pass has one `surface` slot and a material has several features, so something has to turn the
// second into the first. `CompositeSurface` does: it calls the features it composes, in order, each
// reading the surface as the previous one left it.
//
// **One arity with a no-op filler, rather than one chain type per feature count.** Two properties of
// `compose` decide that between them:
//
//   - Every declared slot in a compilation must be bound, whether or not anything reaches it
//     (RVN2073). A library holding chains of two through six would make every material bind
//     twenty slots it does not use, so the arities buy nothing.
//   - A composed shader's parameters belong to its *type*, not to the slot it was bound into. A
//     `CompositeSurface` nested inside a `CompositeSurface` would therefore be one chain and not
//     two: both copies would resolve `first` to the same shader.
//
// So there is one chain, it is as long as a material can plausibly be, and the slots a material does
// not need take `IdentitySurface`. An empty call is what a chain of three costs over a chain of two,
// which is nothing a driver keeps.
//
// The per-type rule is also why a chain must not hold the same feature twice: two `EmissiveSurface`s
// in one chain share `emissiveColor`, so the second is not a second layer of emission.
// `MaterialCompiler` on the C# side rejects that rather than compiling a material whose parameters
// silently alias.

/// A feature that contributes nothing, for the slots a material does not use.
///
/// Not a placeholder for something unfinished: it is what makes one chain able to stand in for every
/// length, and its `Compute` is the only correct implementation of "no feature here".
shader IdentitySurface : IMaterialSurface {
    func Compute(inout d: MaterialData) {
    }
}

// --- Layering ----------------------------------------------------------------------------------
//
// Two shapes, because layering means two different things and one mechanism cannot serve both.
//
// `MaterialLayersSurface` is N layers of one workflow — rock under moss under snow, weighted by a
// splat map. The layers differ in their *values*, not in their features, so they are an array and
// `LayerCount` is a permutation: it sizes the array, so a two-layer material's block holds two layers
// rather than the most anyone might use. This is the case terrain and decals actually want.
//
// ⚠ **It does not unroll the loop, whatever this comment said for as long as it existed.** The emitted
// unit is a `while` with a constant bound — unrolling one is the backend compiler's business, not
// Raven's — and `LibraryTreeTests.The_layered_surfaces_count_is_a_permutation_the_compilation_honours`
// asserts the half that is Raven's. The uniform cost was the claim worth making; the iteration was not
// ours to promise.
//
// `BlendSurface` is two *different* surfaces mixed by a weight — a metal-roughness base under a
// specular-glossiness overlay, say. It composes, so each side can be any feature.
//
// ⚠ **Both sides of a `BlendSurface` must use different features.** A composed shader's parameters
// belong to its type, so two layers that both bind `MetalRoughnessSurface` share one `baseColor` and
// the second layer is not a second layer at all. That is what `MaterialLayersSurface` exists for, and
// what `MaterialCompiler` refuses to compile rather than shipping a material whose two layers are
// silently one.

/// One layer's values.
struct MaterialLayer {
    var baseColor: float3
    var metalness: float
    var roughness: float

    /// How much of this layer shows, before normalisation. A splat map's channel.
    var weight: float
}

/// N metal-roughness layers, blended by weight.
///
/// The weights are normalised rather than assumed to sum to one, because a splat map painted by hand
/// never quite does, and a material that dims where the artist was imprecise is a bug that gets
/// blamed on the lighting.
shader MaterialLayersSurface : IMaterialSurface {
    /// How many layers this material has. A permutation, so it sizes the array below and an unused
    /// layer costs no uniform. ⚠ Not an iteration — see the note at the top of this file: the loop is
    /// emitted as a loop with a constant bound.
    [Permutation] val LayerCount: int = 2

    var layers: MaterialLayer[LayerCount]

    func Compute(inout d: MaterialData) {
        var color = float3(0f)
        var metalness = 0f
        var roughness = 0f
        var total = 0f

        for (i in 0 .. LayerCount - 1) {
            val weight = max(layers[i].weight, 0f)

            color += layers[i].baseColor * weight
            metalness += layers[i].metalness * weight
            roughness += layers[i].roughness * weight
            total += weight
        }

        val scale = 1f / max(total, Const.Epsilon)
        val blended = color * scale
        val metal = saturate(metalness * scale)

        d.diffuseColor = blended * (1f - metal)
        d.f0 = Brdf.F0FromMetalness(blended, metal, MaterialDefaults.DielectricF0)
        d.perceptualRoughness = saturate(roughness * scale)
    }
}

/// N metal-roughness layers whose weights are *painted* rather than authored.
///
/// **What makes a painted layer stack shippable as a live material.** `MaterialLayersSurface` above
/// takes its weights as constants, so a ten-layer stack with painted masks was expressible only as
/// the images it evaluates to — doc 48 § B1 is the statement of that gap and this is the half of it
/// that belongs to the renderer.
///
/// ⚠ **Four layers per map, because a splat map has four channels.** R, G, B and A are layers 0 to 3
/// and a fifth layer's painted weight is zero — the same ceiling `TerrainSplat.LayersPerWeightMap`
/// works to. A stack deeper than four wants a second map, which is a second feature rather than a
/// wider one.
///
/// ⚠ **And the fourth of those channels has to be declared, which is `paintedChannels` below.** A
/// one- or three-channel texture samples alpha as 1 — the hazard `TexturedOpacitySurface` documents
/// at length and reads `.r` to avoid — so a fourth layer weighted by `splat.a` on an RGB splat map is
/// weighted **1 over the whole surface**, and after the `1/total` normalisation the stack is layer 3
/// everywhere. Three is the default for that reason: a stack that reaches the alpha says so, and a
/// material whose fourth layer is silently unpainted is a warning the material compiler raises rather
/// than a surface that turned into one colour.
///
/// ⚠ **`layers[i].weight` survives and is a *scale* on the painted channel, not the weight.** One is
/// the map exactly; zero disables a layer wherever it was painted, which is what an author toggling a
/// layer off wants and is why the constant was not dropped.
///
/// The weights are normalised for `MaterialLayersSurface`'s reason, which a painted map only makes
/// stronger: a splat map painted by hand never sums to one, and a material that dims where the artist
/// was imprecise is a bug that gets blamed on the lighting.
///
/// ⚠ **`HeightBlended` is doc 48 § B1's height map, and it is the *layering* reading of it.** A height
/// map is three different features wearing one name — parallax occlusion, height-blended layering, and
/// true displacement — and only the middle one is a surface feature at all. § B1 names height in the
/// same sentence as the layering gap, so the map biases a splat weight here rather than displacing a
/// coordinate: a second four-channel map whose channel `i` is layer `i`'s height, so gravel shows
/// through sand in the gaps between the stones instead of the two averaging to mud. Parallax needs a
/// tangent-space view vector `MaterialData` does not carry and a rule about a feature that writes
/// `d.uv` before the features that read it; displacement is a vertex stage. Both are separate tasks.
///
/// ⚠ **Off by default, and the permutation is the whole guard.** An unpaired `heightIndex` is slot
/// zero, which is the magenta checker — whose channels are emphatically not zero — so a height sample
/// left in the unblended variant would bias every layered material in the frame by the checker. With
/// the permutation off the sample, the peak and the bias all fold away, and what is left computes the
/// weights this shader computed before the map existed: the floor stays at zero, `Keyed` folds to the
/// painted weight, and `max(w - 0, 0)` is `max(w, 0)` for every float there is.
shader TexturedMaterialLayersSurface : MaterialTextures, IMaterialSurface {
    /// How many layers this material has. A permutation, so it sizes the array below and an unused
    /// layer costs no uniform. ⚠ Not an iteration — see the note above `MaterialLayersSurface`.
    ///
    /// ⚠ Raven resolves a permutation by name across the whole compilation, so this and
    /// `MaterialLayersSurface.LayerCount` are one permutation. That is right — they are the same knob
    /// — and it is why a material carrying both features has to agree with itself about the count.
    [Permutation] val LayerCount: int = 2

    /// Which slot of the frame's table holds this material's splat map.
    var splatIndex: uint = 0u

    /// How many of the splat map's channels actually carry a painted weight.
    ///
    /// ⚠ **Three, not four, and the default is the whole guard.** A one- or three-channel texture
    /// samples alpha as 1, so a material that reaches `splat.a` without having a four-channel map is
    /// not slightly wrong — layer 3 weighs 1 everywhere and, normalised, covers the surface. A value
    /// rather than a permutation because it costs one comparison and no variant, and because the
    /// number is a fact about *this material's* texture rather than about the frame.
    var paintedChannels: int = 3

    /// Whether a second map's per-layer heights decide which layer shows where they compete.
    ///
    /// A permutation rather than a value, because off has to cost nothing *and emit nothing*: see the
    /// note on this shader. A material that sets this without a paired height map reads the table's
    /// fallback, which is the loudest wrong answer this shader has.
    [Permutation] val HeightBlended: bool = false

    /// Which slot of the frame's table holds this material's height map. Channel `i` is layer `i`.
    ///
    /// Read only when `HeightBlended`, and the same `paintedChannels` gates it: a layer the splat map
    /// does not paint has no weight to bias, so its height is not read either.
    var heightIndex: uint = 0u

    /// How far a full-height texel can push a layer, in splat-weight units.
    ///
    /// ⚠ **Bounded on purpose, and this is the parameter that keeps the effect honest.** With the
    /// height added at full scale, a layer painted 0 whose height is 1 ties with a layer painted 1
    /// whose height is 0 — an unpainted layer bleeding over a painted one, which is the classic
    /// failure of the naive form. A quarter means height decides only where the paint is already
    /// close, which is the seam it was wanted for.
    var heightContrast: float = 0.25f

    /// How wide the transition between two competing layers is, in the same units.
    ///
    /// Zero is a hard cut — no blend at all — and is clamped up to an epsilon rather than refused,
    /// because the alternative is a surface whose weights all fall to zero and which reads black.
    var heightTransition: float = 0.1f

    var layers: MaterialLayer[LayerCount]

    /// One layer's channel of a per-layer map. Layers past `paintedChannels` read zero.
    ///
    /// Called for the splat map and, when `HeightBlended`, for the height map: both are four channels
    /// standing for four layers in the same order, so one chain serves both and the two cannot
    /// disagree about which channel a layer is.
    ///
    /// A chain rather than a dynamic index into the vector, because a vector's components are not
    /// addressable by a runtime index in every backend this library targets — and `layer` *is* a
    /// runtime index here, since the loop above is emitted as a loop. Four comparisons a layer, which
    /// a driver that unrolls a constant-bound loop folds to one swizzle.
    func Painted(channels: float4, layer: int): float {
        // ⚠ Zero rather than the channel, for a layer the map does not paint. See `paintedChannels`:
        // the alpha of a map that has none reads 1, which is the widest possible wrong answer.
        if (layer >= paintedChannels) {
            return 0f
        }

        if (layer == 0) {
            return channels.r
        }

        if (layer == 1) {
            return channels.g
        }

        if (layer == 2) {
            return channels.b
        }

        if (layer == 3) {
            return channels.a
        }

        return 0f
    }

    /// One layer's weight before the transition floor is taken off it.
    ///
    /// ⚠ With `HeightBlended` off this is exactly `layers[i].weight * Painted(splat, i)`, which the
    /// loop then clamps at zero — the arithmetic this shader had before the height map, unchanged.
    ///
    /// ⚠ **The height term is scaled by `layers[i].weight` too, and the first version was not.**
    /// This file says, of that constant, that "zero disables a layer wherever it was painted". A
    /// height term outside the product broke exactly that: a layer an author had toggled off still
    /// received `heightContrast * height` and could hold the peak, so switching a layer off could
    /// *raise* it above the ones still on. One multiplication is the difference between a scale on a
    /// layer and a scale on half of one.
    func Keyed(splat: float4, height: float4, layer: int): float {
        val painted = Painted(splat, layer)

        if (HeightBlended) {
            return layers[layer].weight * (painted + heightContrast * Painted(height, layer))
        }

        return layers[layer].weight * painted
    }

    func Compute(inout d: MaterialData) {
        val splat = SampleSurface(splatIndex, d)

        // ⚠ Inside the permutation, so the unblended variant emits no second sample. Slot zero is the
        // checker and its channels are not zero, so a sample hoisted out of here would bias every
        // layered material that has no height map by whatever the fallback view holds.
        var height = float4(0f)

        if (HeightBlended) {
            height = SampleSurface(heightIndex, d)
        }

        // Zero is additive-neutral, which is what makes the loop below one path rather than two: with
        // the permutation off nothing is subtracted and the blend is the plain weighted mean.
        var floor = 0f

        if (HeightBlended) {
            var peak = 0f

            for (i in 0 .. LayerCount - 1) {
                peak = max(peak, Keyed(splat, height, i))
            }

            // Clamped up, because a transition of zero would put the floor *on* the winning layer and
            // leave every weight at zero — a black surface where the author asked for a hard edge.
            floor = peak - max(heightTransition, Const.Epsilon)
        }

        var color = float3(0f)
        var metalness = 0f
        var roughness = 0f
        var total = 0f

        for (i in 0 .. LayerCount - 1) {
            val weight = max(Keyed(splat, height, i) - floor, 0f)

            color += layers[i].baseColor * weight
            metalness += layers[i].metalness * weight
            roughness += layers[i].roughness * weight
            total += weight
        }

        val scale = 1f / max(total, Const.Epsilon)
        val blended = color * scale
        val metal = saturate(metalness * scale)

        d.diffuseColor = blended * (1f - metal)
        d.f0 = Brdf.F0FromMetalness(blended, metal, MaterialDefaults.DielectricF0)
        d.perceptualRoughness = saturate(roughness * scale)
    }
}

/// Parallax occlusion: a height map read as depth, and the coordinate moved to where the eye sees.
///
/// ⚠ **The first feature in the library that writes `d.uv` rather than reading it**, which is the
/// whole reason `MaterialFeatureStage.Coordinate` and `MaterialCompiler.Ordered` exist. Placed behind
/// a feature that samples, it displaces the coordinate that feature already read — half a parallaxed
/// surface, drawn on every device with nothing reported. The compiler refuses that arrangement; see
/// `CompositeSurface` below and `github.com/Rikarin/Vixen/issues/1065`.
///
/// ⚠ **This is the *first* of the three readings of "a height map" and not the one `#615` shipped.**
/// `TexturedMaterialLayersSurface` above blends layers by a *four-channel per-layer* bundle; this
/// samples one material's single channel, which is what a bake's `height` file holds. Same English
/// name, different textures, and pairing them would be a plausible wrong picture rather than an error
/// — so the two features name different maps and `NoTwoSamplingFeaturesShareAMapName` says so.
///
/// **The march.** The height field is a depth field: 1 is the original surface and 0 is the floor,
/// `heightScale` deep. The eye's ray enters at `d.uv` and leaves the volume at `d.uv - sweep`, where
/// `sweep = viewTS.xy / viewTS.z * heightScale`; the coordinate wanted is where that ray first passes
/// under the field. Steep parallax walks the ray in equal depth steps until a sample is above it, and
/// the occlusion refinement then intersects the two straight lines the last two samples define rather
/// than snapping to the step boundary.
///
/// ⚠ **That refinement is what makes a constant field exact at any step count**, which is a property
/// rather than an impression: with the field flat at depth `D`, the crossing solves to `sweep · D`
/// whether the walk took one step or sixty-four. `ParallaxMaterialImageTests` photographs exactly
/// that, because "it drew something different" is what a broken march also does.
///
/// ⚠ **The budget is steps and never milliseconds.** A wall-clock budget is this repository's largest
/// flake source and it would also be a different picture on every machine. `minSteps` and `maxSteps`
/// are the count head-on and the count edge-on; the surface is sampled more finely exactly where the
/// ray travels furthest across it, which is where a coarse walk steps over a ridge.
///
/// **What it does not do is the silhouette.** A displaced coordinate that leaves 0..1 samples the
/// map's wrap rather than showing the surface's edge falling away, and the fix for that is a discard
/// a *feature* cannot issue — `IMaterialSurface.Compute` contributes to a struct and the pass owns
/// coverage. So this is the flat-surface case: a wall, a floor, a road, where the silhouette is a
/// straight line the geometry already draws correctly.
shader ParallaxSurface : MaterialTextures, IMaterialSurface {
    /// Which slot of the frame's table holds this material's single-channel height map.
    ///
    /// Red, and only red. ⚠ A one-channel texture samples green and blue as 0 and alpha as 1 — the
    /// hazard `TexturedOpacitySurface` documents — so a march reading anything else would read a
    /// constant on the very format a height bake writes.
    var heightIndex: uint = 0u

    /// How deep the floor of the height field is, in the surface's own UV units.
    ///
    /// ⚠ **UV units and not metres**, which is what makes it an authored number rather than a derived
    /// one: the depth that looks right depends on how the map is tiled, and the tiling is the
    /// material's. A value of 0 is the feature switched off, and costs the march.
    var heightScale: float = 0.05f

    /// How many steps the march takes when the eye is straight on.
    var minSteps: float = 8f

    /// And when it is edge-on, where the ray crosses the most surface per unit of depth.
    var maxSteps: float = 32f

    /// The shallowest cosine the sweep is still finite at.
    ///
    /// ⚠ A cosine is dimensionless and unit-length bounded, so this absolute threshold does not scale
    /// with the model the way a length epsilon would. `viewTS.z` at or below it is an eye in the
    /// surface's own plane, where `xy / z` is unbounded and the honest answer is to displace nothing.
    /// It is also what excludes a back-facing fragment, whose `z` is negative.
    const val MinCosine = 0.02f

    func Compute(inout d: MaterialData) {
        val view = Math.SafeNormalize(d.viewTS)

        if (view.z <= MinCosine) {
            return
        }

        // ⚠ Read once, before the loop. Inside it the coordinate is different on every lane and the
        // control flow is not uniform, so implicit derivatives are neither this surface's footprint
        // nor defined at all. See `MaterialTextures.SurfaceDdx`.
        val ddxUv = SurfaceDdx(d)
        val ddyUv = SurfaceDdy(d)

        val sweep = (view.xy / view.z) * heightScale

        // More steps as the ray flattens out. Clamped below at one because zero steps is a loop that
        // never runs and a `resolved` nothing wrote, and above at a count whose layer thickness stays
        // far clear of `Const.Epsilon` — the refinement divides by that thickness.
        val count = clamp(int(lerp(maxSteps, minSteps, view.z)), 1, 256)
        val steps = float(count)

        var previousDepth = 0f
        var previousSampled = 1f - SampleMapGrad(heightIndex, d.uv, ddxUv, ddyUv).r

        // No crossing at all is the floor: the ray left the volume without ever passing under the
        // field, which is the field at 0 everywhere. Full sweep is the answer there, not zero.
        var resolved = 1f

        for (i in 0 .. count - 1) {
            // ⚠ Divided rather than accumulated, so the last step is exactly 1. Adding `1 / n` to
            // itself `n` times lands a rounding below it, and a field at depth 1 would then never be
            // crossed — the deepest texel of every height map, taking the fallback above.
            val depth = float(i + 1) / steps
            val sampled = 1f - SampleMapGrad(heightIndex, d.uv - sweep * depth, ddxUv, ddyUv).r

            if (sampled <= depth) {
                // The occlusion refinement. Two straight lines: the ray, whose depth is `depth`, and
                // the field between the two samples. `after` is how far the ray is past the field now
                // and `before` is how far short it was one step ago, so the crossing is `after` of the
                // way back — which for a flat field is the exact answer at any `count`.
                val after = sampled - depth
                val before = previousSampled - previousDepth

                // Negative by construction: `after` is at most zero and `before` is above it, or the
                // step before this one would have been the crossing. The floor is against the one
                // degenerate case, a field that is already at the ray's depth at the very first step.
                val gap = min(after - before, -Const.Epsilon)
                val weight = saturate(after / gap)

                resolved = previousDepth * weight + depth * (1f - weight)
                break
            }

            previousDepth = depth
            previousSampled = sampled
        }

        d.uv = d.uv - sweep * resolved
    }
}

/// Two surfaces, mixed by a weight.
shader BlendSurface : IMaterialSurface {
    compose val under: IMaterialSurface = IdentitySurface
    compose val over: IMaterialSurface = IdentitySurface

    /// How much of `over` shows. Zero is `under` alone.
    var blend: float = 0.5f

    func Compute(inout d: MaterialData) {
        // Both layers start from the surface as it reached the blend, rather than one starting from
        // the other's result: a layer is a whole surface weighed against another whole surface, and
        // running them in sequence would make `over` a contribution to `under` instead.
        var a = d
        var b = d

        under.Compute(a)
        over.Compute(b)

        d = MaterialBlend.Mix(a, b, blend)
    }
}

/// The features of one material, in the order they contribute.
///
/// ⚠ **The order is the material's feature list and nothing else.** `MaterialCompiler` fills these
/// eight slots top to bottom from `MaterialDescriptor.Features`, so slot order is authored rather than
/// canonical — which is right, because a feature reads the surface as the previous one left it and
/// which contribution wins is the author's business.
///
/// ⚠ **One exception, and it is the only one the compiler judges.** A feature that writes `d.uv`
/// rather than reading it has to run before every feature that samples: placed third it displaces the
/// coordinate the two before it already sampled at, which is half a parallaxed surface drawn without
/// an error. `MaterialFeatureStage.Coordinate` is how a feature says so and `MaterialCompiler` refuses
/// the material rather than reordering it — a slot the compiler moved is a material whose file no
/// longer says what runs.
shader CompositeSurface : IMaterialSurface {
    compose val first: IMaterialSurface
    compose val second: IMaterialSurface
    compose val third: IMaterialSurface
    compose val fourth: IMaterialSurface
    compose val fifth: IMaterialSurface
    compose val sixth: IMaterialSurface
    compose val seventh: IMaterialSurface
    compose val eighth: IMaterialSurface

    func Compute(inout d: MaterialData) {
        first.Compute(d)
        second.Compute(d)
        third.Compute(d)
        fourth.Compute(d)
        fifth.Compute(d)
        sixth.Compute(d)
        seventh.Compute(d)
        eighth.Compute(d)
    }
}
