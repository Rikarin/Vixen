package Vixen.Shaders.Material

import Vixen.Shaders.Core
import Vixen.Shaders.Shading
import Vixen.Shaders.Geometry

// The optional surface features, and the chains that let a material have more than one of them.
//
// `MaterialSurface.rvn` holds the features every material needs to choose between — a workflow, a
// normal map, emission, occlusion. These are the ones that switch on a lobe: a material without a
// clear coat should not pay for one, and with composition it does not, because the feature that
// writes `clearCoat` is not in its chain and the shading model that reads it is not bound.
//
// **A feature writes channels; a shading model reads them.** The split is what keeps the two sets
// small: `ClearCoatSurface` says how strong the coat is at this point on the surface, and
// `ClearCoatShading` (ShadingModels.rvn) says what a coat does to light. Parameters that vary over a
// surface belong here; parameters that describe the model itself — a wrap width, a cel ramp's step
// count — belong on the shading model, where there is one of them rather than one per texel.

/// Stretches the specular lobe along the tangent: brushed metal, hair, vinyl, silk.
///
/// The tangent it stretches along is the mesh's, through `MaterialData.tangentFrame` — the same basis
/// a normal map is rotated by. A material whose anisotropy runs at an angle to the UV grain needs a
/// rotation, which is not here: it belongs with the tangent frame rather than with this scalar, and
/// nothing yet authors one.
shader AnisotropySurface : IMaterialSurface {
    var anisotropy: float = 0f

    func Compute(inout d: MaterialData) {
        d.anisotropy = clamp(anisotropy, -1f, 1f)
    }
}

/// Adds a clear coat: car paint, lacquered wood, a wet surface.
shader ClearCoatSurface : IMaterialSurface {
    var clearCoat: float = 1f
    var clearCoatRoughness: float = 0.1f

    func Compute(inout d: MaterialData) {
        d.clearCoat = saturate(clearCoat)
        d.clearCoatRoughness = saturate(clearCoatRoughness)
    }
}

/// Bends the coat's normal without touching the base's — scratches in the lacquer.
///
/// Deliberately a second feature rather than two more parameters on `ClearCoatSurface`: a coat with
/// its own normal map is the uncommon case, and folding it in would put the rotation's arithmetic in
/// every material that has a plain coat.
shader ClearCoatNormalMapSurface : IMaterialSurface {
    var clearCoatNormalTS: float3 = float3(0f, 0f, 1f)
    var clearCoatNormalStrength: float = 1f

    func Compute(inout d: MaterialData) {
        val s = clearCoatNormalStrength
        val scaled = Math.SafeNormalize(float3(clearCoatNormalTS.x * s, clearCoatNormalTS.y * s, clearCoatNormalTS.z))
        d.clearCoatNormalWS = Normals.ToWorld(d.tangentFrame, scaled)
    }
}

/// Adds the retroreflective rim fabric has: velvet, satin, brushed cloth.
shader SheenSurface : IMaterialSurface {
    var sheenColor: float3 = float3(0f)
    var sheenRoughness: float = 0.3f

    func Compute(inout d: MaterialData) {
        d.sheenColor = max(sheenColor, float3(0f))
        d.sheenRoughness = saturate(sheenRoughness)
    }
}

/// Lets light through the surface: skin, wax, leaves, thin cloth.
///
/// `thickness` is in metres and is what makes a leaf's veins read as thicker than its blade. It is a
/// material channel rather than a shading-model parameter for exactly that reason — it varies over
/// the surface, and the wrap width does not.
shader SubsurfaceSurface : IMaterialSurface {
    var scatterColor: float3 = float3(0f)
    var thickness: float = 0f

    func Compute(inout d: MaterialData) {
        d.scatterColor = max(scatterColor, float3(0f))
        d.thickness = max(thickness, 0f)
    }
}

// --- The chain ---------------------------------------------------------------------------------
//
// A pass has one `surface` slot and a material has several features, so something has to turn the
// second into the first. `CompositeSurface` does: it calls the features it composes, in order, each
// reading the surface as the previous one left it.
//
// **One arity with a no-op filler, rather than one chain type per feature count.** Two properties of
// `compose` decide that between them:
//
//   - Every declared slot in a compilation must be bound, whether or not anything reaches it
//     (RVN2073). A library holding chains of two through six would make every material bind
//     twenty slots it does not use, so the arities buy nothing.
//   - A composed shader's parameters belong to its *type*, not to the slot it was bound into. A
//     `CompositeSurface` nested inside a `CompositeSurface` would therefore be one chain and not
//     two: both copies would resolve `first` to the same shader.
//
// So there is one chain, it is as long as a material can plausibly be, and the slots a material does
// not need take `IdentitySurface`. An empty call is what a chain of three costs over a chain of two,
// which is nothing a driver keeps.
//
// The per-type rule is also why a chain must not hold the same feature twice: two `EmissiveSurface`s
// in one chain share `emissiveColor`, so the second is not a second layer of emission.
// `MaterialCompiler` on the C# side rejects that rather than compiling a material whose parameters
// silently alias.

/// A feature that contributes nothing, for the slots a material does not use.
///
/// Not a placeholder for something unfinished: it is what makes one chain able to stand in for every
/// length, and its `Compute` is the only correct implementation of "no feature here".
shader IdentitySurface : IMaterialSurface {
    func Compute(inout d: MaterialData) {
    }
}

// --- Layering ----------------------------------------------------------------------------------
//
// Two shapes, because layering means two different things and one mechanism cannot serve both.
//
// `MaterialLayersSurface` is N layers of one workflow — rock under moss under snow, weighted by a
// splat map. The layers differ in their *values*, not in their features, so they are an array and
// `LayerCount` is a permutation: it sizes the array, so a two-layer material's block holds two layers
// rather than the most anyone might use. This is the case terrain and decals actually want.
//
// ⚠ **It does not unroll the loop, whatever this comment said for as long as it existed.** The emitted
// unit is a `while` with a constant bound — unrolling one is the backend compiler's business, not
// Raven's — and `LibraryTreeTests.The_layered_surfaces_count_is_a_permutation_the_compilation_honours`
// asserts the half that is Raven's. The uniform cost was the claim worth making; the iteration was not
// ours to promise.
//
// `BlendSurface` is two *different* surfaces mixed by a weight — a metal-roughness base under a
// specular-glossiness overlay, say. It composes, so each side can be any feature.
//
// ⚠ **Both sides of a `BlendSurface` must use different features.** A composed shader's parameters
// belong to its type, so two layers that both bind `MetalRoughnessSurface` share one `baseColor` and
// the second layer is not a second layer at all. That is what `MaterialLayersSurface` exists for, and
// what `MaterialCompiler` refuses to compile rather than shipping a material whose two layers are
// silently one.

/// One layer's values.
struct MaterialLayer {
    var baseColor: float3
    var metalness: float
    var roughness: float

    /// How much of this layer shows, before normalisation. A splat map's channel.
    var weight: float
}

/// N metal-roughness layers, blended by weight.
///
/// The weights are normalised rather than assumed to sum to one, because a splat map painted by hand
/// never quite does, and a material that dims where the artist was imprecise is a bug that gets
/// blamed on the lighting.
shader MaterialLayersSurface : IMaterialSurface {
    /// How many layers this material has. A permutation, so it sizes the array below and an unused
    /// layer costs no uniform. ⚠ Not an iteration — see the note at the top of this file: the loop is
    /// emitted as a loop with a constant bound.
    [Permutation] val LayerCount: int = 2

    var layers: MaterialLayer[LayerCount]

    func Compute(inout d: MaterialData) {
        var color = float3(0f)
        var metalness = 0f
        var roughness = 0f
        var total = 0f

        for (i in 0 .. LayerCount - 1) {
            val weight = max(layers[i].weight, 0f)

            color += layers[i].baseColor * weight
            metalness += layers[i].metalness * weight
            roughness += layers[i].roughness * weight
            total += weight
        }

        val scale = 1f / max(total, Const.Epsilon)
        val blended = color * scale
        val metal = saturate(metalness * scale)

        d.diffuseColor = blended * (1f - metal)
        d.f0 = Brdf.F0FromMetalness(blended, metal, MaterialDefaults.DielectricF0)
        d.perceptualRoughness = saturate(roughness * scale)
    }
}

/// N metal-roughness layers whose weights are *painted* rather than authored.
///
/// **What makes a painted layer stack shippable as a live material.** `MaterialLayersSurface` above
/// takes its weights as constants, so a ten-layer stack with painted masks was expressible only as
/// the images it evaluates to — doc 48 § B1 is the statement of that gap and this is the half of it
/// that belongs to the renderer.
///
/// ⚠ **Four layers per map, because a splat map has four channels.** R, G, B and A are layers 0 to 3
/// and a fifth layer's painted weight is zero — the same ceiling `TerrainSplat.LayersPerWeightMap`
/// works to. A stack deeper than four wants a second map, which is a second feature rather than a
/// wider one.
///
/// ⚠ **And the fourth of those channels has to be declared, which is `paintedChannels` below.** A
/// one- or three-channel texture samples alpha as 1 — the hazard `TexturedOpacitySurface` documents
/// at length and reads `.r` to avoid — so a fourth layer weighted by `splat.a` on an RGB splat map is
/// weighted **1 over the whole surface**, and after the `1/total` normalisation the stack is layer 3
/// everywhere. Three is the default for that reason: a stack that reaches the alpha says so, and a
/// material whose fourth layer is silently unpainted is a warning the material compiler raises rather
/// than a surface that turned into one colour.
///
/// ⚠ **`layers[i].weight` survives and is a *scale* on the painted channel, not the weight.** One is
/// the map exactly; zero disables a layer wherever it was painted, which is what an author toggling a
/// layer off wants and is why the constant was not dropped.
///
/// The weights are normalised for `MaterialLayersSurface`'s reason, which a painted map only makes
/// stronger: a splat map painted by hand never sums to one, and a material that dims where the artist
/// was imprecise is a bug that gets blamed on the lighting.
shader TexturedMaterialLayersSurface : MaterialTextures, IMaterialSurface {
    /// How many layers this material has. A permutation, so it sizes the array below and an unused
    /// layer costs no uniform. ⚠ Not an iteration — see the note above `MaterialLayersSurface`.
    ///
    /// ⚠ Raven resolves a permutation by name across the whole compilation, so this and
    /// `MaterialLayersSurface.LayerCount` are one permutation. That is right — they are the same knob
    /// — and it is why a material carrying both features has to agree with itself about the count.
    [Permutation] val LayerCount: int = 2

    /// Which slot of the frame's table holds this material's splat map.
    var splatIndex: uint = 0u

    /// How many of the splat map's channels actually carry a painted weight.
    ///
    /// ⚠ **Three, not four, and the default is the whole guard.** A one- or three-channel texture
    /// samples alpha as 1, so a material that reaches `splat.a` without having a four-channel map is
    /// not slightly wrong — layer 3 weighs 1 everywhere and, normalised, covers the surface. A value
    /// rather than a permutation because it costs one comparison and no variant, and because the
    /// number is a fact about *this material's* texture rather than about the frame.
    var paintedChannels: int = 3

    var layers: MaterialLayer[LayerCount]

    /// One layer's painted weight, by channel. Layers past `paintedChannels` are unpainted.
    ///
    /// A chain rather than a dynamic index into the vector, because a vector's components are not
    /// addressable by a runtime index in every backend this library targets — and `layer` *is* a
    /// runtime index here, since the loop above is emitted as a loop. Four comparisons a layer, which
    /// a driver that unrolls a constant-bound loop folds to one swizzle.
    func Painted(splat: float4, layer: int): float {
        // ⚠ Zero rather than the channel, for a layer the map does not paint. See `paintedChannels`:
        // the alpha of a map that has none reads 1, which is the widest possible wrong answer.
        if (layer >= paintedChannels) {
            return 0f
        }

        if (layer == 0) {
            return splat.r
        }

        if (layer == 1) {
            return splat.g
        }

        if (layer == 2) {
            return splat.b
        }

        if (layer == 3) {
            return splat.a
        }

        return 0f
    }

    func Compute(inout d: MaterialData) {
        val splat = SampleSurface(splatIndex, d)

        var color = float3(0f)
        var metalness = 0f
        var roughness = 0f
        var total = 0f

        for (i in 0 .. LayerCount - 1) {
            val weight = max(layers[i].weight * Painted(splat, i), 0f)

            color += layers[i].baseColor * weight
            metalness += layers[i].metalness * weight
            roughness += layers[i].roughness * weight
            total += weight
        }

        val scale = 1f / max(total, Const.Epsilon)
        val blended = color * scale
        val metal = saturate(metalness * scale)

        d.diffuseColor = blended * (1f - metal)
        d.f0 = Brdf.F0FromMetalness(blended, metal, MaterialDefaults.DielectricF0)
        d.perceptualRoughness = saturate(roughness * scale)
    }
}

/// Two surfaces, mixed by a weight.
shader BlendSurface : IMaterialSurface {
    compose val under: IMaterialSurface = IdentitySurface
    compose val over: IMaterialSurface = IdentitySurface

    /// How much of `over` shows. Zero is `under` alone.
    var blend: float = 0.5f

    func Compute(inout d: MaterialData) {
        // Both layers start from the surface as it reached the blend, rather than one starting from
        // the other's result: a layer is a whole surface weighed against another whole surface, and
        // running them in sequence would make `over` a contribution to `under` instead.
        var a = d
        var b = d

        under.Compute(a)
        over.Compute(b)

        d = MaterialBlend.Mix(a, b, blend)
    }
}

/// The features of one material, in the order they contribute.
shader CompositeSurface : IMaterialSurface {
    compose val first: IMaterialSurface
    compose val second: IMaterialSurface
    compose val third: IMaterialSurface
    compose val fourth: IMaterialSurface
    compose val fifth: IMaterialSurface
    compose val sixth: IMaterialSurface
    compose val seventh: IMaterialSurface
    compose val eighth: IMaterialSurface

    func Compute(inout d: MaterialData) {
        first.Compute(d)
        second.Compute(d)
        third.Compute(d)
        fourth.Compute(d)
        fifth.Compute(d)
        sixth.Compute(d)
        seventh.Compute(d)
        eighth.Compute(d)
    }
}
