package Vixen.Shaders.Material

import Vixen.Shaders.Core
import Vixen.Shaders.Shading
import Vixen.Shaders.Geometry

// The composable material interface: Stride's model, without the mixin resolver.
//
// A material is assembled from features chosen when the material is authored, and the shader has to
// be assembled to match. Stride solves this with shader classes, inheritance and a mixin resolver —
// a shader-level object system, and the least-understood part of Stride. Vixen's answer is three
// mechanisms that already exist in the language:
//
//   - `protocol IMaterialSurface` is the contract a feature satisfies.
//   - `shader MetalRoughnessSurface : IMaterialSurface` is one concrete feature.
//   - `compose val surface: IMaterialSurface` is a slot a material fills, resolved at compile time
//     with no dispatch — only the chosen implementation is emitted and called.
//
// The `inout` is what makes a feature a *contribution* rather than a replacement: each one reads the
// surface as the previous features left it and writes back. That reads as a mutation, which is what
// it is, rather than as a fold through return values — and it means adding a feature to the chain
// does not change any other feature's signature.
//
// Copy-in/copy-out, not aliasing: a feature sees the surface as it was when the call began. Nothing
// here depends on the difference, and it is worth knowing that it is the definition, because GLSL
// and SPIR-V could not have honoured aliasing.

/// Everything a lighting model needs to know about a point on a surface.
///
/// One struct passed by reference rather than a growing parameter list, so a feature that starts
/// caring about a new channel does not change the contract every other feature is written to.
struct MaterialData {
    /// Diffuse albedo, linear. For a metal this is black — a conductor has no diffuse response.
    var diffuseColor: float3

    /// Specular reflectance at normal incidence. Grey for a dielectric, tinted for a metal.
    var f0: float3

    /// Perceptual roughness, as authored. `Brdf.Alpha` converts it, exactly once.
    var perceptualRoughness: float

    /// Shading normal, world space, unit length.
    var normalWS: float3

    /// Ambient occlusion, 0..1, applied to indirect diffuse only.
    var occlusion: float

    /// Emitted radiance, added after lighting and unaffected by it.
    var emissive: float3

    /// Coverage, for alpha blending or a cutout test.
    var alpha: float

    /// How much the specular lobe is stretched along the tangent, -1..1. Zero is isotropic.
    ///
    /// Signed rather than 0..1 because the sign is which axis stretches: brushed metal along the
    /// grain and across it are the same magnitude and opposite directions, and an unsigned parameter
    /// makes one of the two unreachable.
    var anisotropy: float

    /// The clear coat's strength, 0..1. Zero is no coat, and costs nothing beyond a multiply.
    var clearCoat: float

    /// The coat's own perceptual roughness, independent of the base's.
    var clearCoatRoughness: float

    /// The coat's shading normal, world space.
    ///
    /// Separate from <c>normalWS</c> because a scratched coat over smooth metal — or smooth lacquer
    /// over rough wood — is the reason the feature exists at all. Seeded with the geometric normal by
    /// `MaterialDefaults.Begin`, so a coat with no normal map of its own follows the surface rather
    /// than the base's normal map, which is the physically right default: the coat is a separate
    /// interface and does not inherit the base's bumps.
    var clearCoatNormalWS: float3

    /// The sheen lobe's colour. Black is no sheen.
    ///
    /// A colour rather than a scalar because fabric sheen is usually a different hue from the base,
    /// which is what makes shot silk look like shot silk.
    var sheenColor: float3

    /// The sheen lobe's roughness, which controls how wide the rim is.
    var sheenRoughness: float

    /// What colour light takes on when it scatters through the surface. Black is no scattering.
    var scatterColor: float3

    /// How far light has to travel through the surface, in metres, for back-lighting.
    var thickness: float

    /// The interpolated tangent frame at this point, as the pass computed it.
    ///
    /// Geometry rather than material, and here for one reason: a normal map is authored in *tangent*
    /// space, so a feature that samples one has to rotate it into world space — and the basis to
    /// rotate by belongs to the mesh and the pass, not to the material. Without it a feature can only
    /// write the tangent-space vector into `normalWS` and hope, which is not a shading normal at all:
    /// it lights every surface as though it faced +Z in object space.
    ///
    /// Seeded by the pass before the chain runs. `MaterialDefaults.Reset` leaves it the identity, so a
    /// feature that rotates by it on a pass with no tangents gets its input back unchanged rather than
    /// a zero vector.
    var tangentFrame: TangentFrame
}

/// A material feature: it reads the surface and contributes to it.
protocol IMaterialSurface {
    func Compute(inout d: MaterialData)
}

/// Blends two surfaces into one.
///
/// What layering needs and a feature chain cannot give: a chain composes contributions in sequence,
/// where a layer is a whole surface that has to be weighed against another whole surface. Channels
/// are blended rather than shading results, which is what a splat-mapped terrain does — one lobe over
/// blended parameters, not two lobes averaged.
struct MaterialBlend {
    /// `over` mixed into `under` by `t`, per channel.
    static func Mix(under: MaterialData, over: MaterialData, t: float): MaterialData {
        val w = saturate(t)

        var d = under
        d.diffuseColor = lerp(under.diffuseColor, over.diffuseColor, w)
        d.f0 = lerp(under.f0, over.f0, w)
        d.perceptualRoughness = lerp(under.perceptualRoughness, over.perceptualRoughness, w)
        d.occlusion = lerp(under.occlusion, over.occlusion, w)
        d.emissive = lerp(under.emissive, over.emissive, w)
        d.alpha = lerp(under.alpha, over.alpha, w)
        d.anisotropy = lerp(under.anisotropy, over.anisotropy, w)
        d.clearCoat = lerp(under.clearCoat, over.clearCoat, w)
        d.clearCoatRoughness = lerp(under.clearCoatRoughness, over.clearCoatRoughness, w)
        d.sheenColor = lerp(under.sheenColor, over.sheenColor, w)
        d.sheenRoughness = lerp(under.sheenRoughness, over.sheenRoughness, w)
        d.scatterColor = lerp(under.scatterColor, over.scatterColor, w)
        d.thickness = lerp(under.thickness, over.thickness, w)

        // Normals are directions, so the blend has to be renormalised — a linear mix of two unit
        // vectors is shorter than one, and a shading normal that is not unit length is a lobe that
        // is too bright by the length it lost.
        d.normalWS = Math.SafeNormalize(lerp(under.normalWS, over.normalWS, w))
        d.clearCoatNormalWS = Math.SafeNormalize(lerp(under.clearCoatNormalWS, over.clearCoatNormalWS, w))

        // The tangent frame belongs to the mesh and the pass, not to either layer, so it is taken
        // rather than blended — both layers were seeded with the same one.
        d.tangentFrame = under.tangentFrame
        return d
    }
}

/// The values a feature starts from, so every implementation agrees on what "untouched" means.
struct MaterialDefaults {
    /// A dielectric's reflectance at normal incidence — an index of refraction of 1.5.
    const val DielectricF0 = 0.04f

    static func Reset(inout d: MaterialData) {
        d.diffuseColor = float3(1f)
        d.f0 = float3(DielectricF0)
        d.perceptualRoughness = 1f
        d.normalWS = float3(0f, 0f, 1f)
        d.occlusion = 1f
        d.emissive = float3(0f)
        d.alpha = 1f

        // Every optional lobe is off at its zero, so a material that never mentions one pays a
        // multiply by zero at worst — and a shading model that reads a channel no feature wrote
        // produces the unlayered result rather than a NaN.
        d.anisotropy = 0f
        d.clearCoat = 0f
        d.clearCoatRoughness = 0.1f
        d.clearCoatNormalWS = float3(0f, 0f, 1f)
        d.sheenColor = float3(0f)
        d.sheenRoughness = 0.3f
        d.scatterColor = float3(0f)
        d.thickness = 0f

        // The identity frame, so `Normals.ToWorld` is a no-op until a pass supplies a real one. A
        // zeroed frame would be worse than useless — it maps every normal to zero, and `SafeNormalize`
        // would hand back a plausible-looking unit vector pointing nowhere in particular.
        d.tangentFrame.tangent = float3(1f, 0f, 0f)
        d.tangentFrame.bitangent = float3(0f, 1f, 0f)
        d.tangentFrame.normal = float3(0f, 0f, 1f)
    }

    /// Resets the surface and seeds it with the geometry the pass interpolated.
    ///
    /// What every pass with a tangent channel calls instead of `Reset`. The shading normal starts as
    /// the *geometric* one, so a material with no normal-map feature is already correct, and a
    /// feature that replaces it is replacing something meaningful rather than filling in a blank.
    static func Begin(inout d: MaterialData, normalWS: float3, tangentWS: float4) {
        Reset(d)
        d.tangentFrame = Normals.Frame(normalWS, tangentWS.xyz, tangentWS.w)
        d.normalWS = d.tangentFrame.normal

        // The coat starts on the geometric normal rather than following the base's, so a normal-map
        // feature later in the chain bends the base and leaves the coat flat — which is what a
        // lacquered surface does. A coat that wants its own bumps has `ClearCoatNormalMapSurface`.
        d.clearCoatNormalWS = d.tangentFrame.normal
    }
}

/// The metalness/roughness workflow: one base colour, one metalness, one roughness.
///
/// The industry default, and the reason it is: a conductor's diffuse response is zero and its
/// specular response is tinted, while a dielectric is the other way round, so one parameter can
/// select between the two ends and the shader derives both channels from it.
shader MetalRoughnessSurface : IMaterialSurface {
    var baseColor: float3 = float3(1f, 1f, 1f)
    var metalness: float = 0f
    var roughness: float = 0.5f

    func Compute(inout d: MaterialData) {
        d.diffuseColor = baseColor * (1f - metalness)
        d.f0 = Brdf.F0FromMetalness(baseColor, metalness, MaterialDefaults.DielectricF0)
        d.perceptualRoughness = saturate(roughness)
    }
}

/// The specular/glossiness workflow, for content authored before metalness won.
///
/// Kept because converting an asset library is lossy in the other direction: a specular colour can
/// express reflectances a single metalness cannot.
shader SpecularGlossinessSurface : IMaterialSurface {
    var diffuseColor: float3 = float3(1f, 1f, 1f)
    var specularColor: float3 = float3(0.04f, 0.04f, 0.04f)
    var glossiness: float = 0.5f

    func Compute(inout d: MaterialData) {
        d.diffuseColor = diffuseColor
        d.f0 = specularColor
        d.perceptualRoughness = saturate(1f - glossiness)
    }
}

/// Replaces the shading normal from a tangent-space normal map.
///
/// A separate feature rather than part of the base surface, which is the composition paying off: a
/// material either has a normal map or does not, and the shader that has none emits no code for one.
///
/// **The rotation into world space happens here, through `d.tangentFrame`.** The name of the field it
/// writes says `WS`, and for as long as this feature assigned a tangent-space vector to it that name
/// was a lie — the surface came out lit as though it faced +Z, which reads as a broken normal map
/// rather than as a missing basis. The frame belongs to the pass, so the pass supplies it and the
/// feature only says which way to bend.
shader NormalMapSurface : IMaterialSurface {
    var normalTS: float3 = float3(0f, 0f, 1f)
    var strength: float = 1f

    func Compute(inout d: MaterialData) {
        val scaled = Math.SafeNormalize(float3(normalTS.x * strength, normalTS.y * strength, normalTS.z))
        d.normalWS = Normals.ToWorld(d.tangentFrame, scaled)
    }
}

/// Adds emitted radiance.
shader EmissiveSurface : IMaterialSurface {
    var emissiveColor: float3 = float3(0f, 0f, 0f)
    var intensity: float = 1f

    func Compute(inout d: MaterialData) {
        d.emissive = d.emissive + emissiveColor * intensity
    }
}

/// Applies ambient occlusion.
///
/// Multiplies into whatever is already there rather than overwriting, so two occlusion sources —
/// a baked map and a screen-space term — compose without either knowing about the other.
shader OcclusionSurface : IMaterialSurface {
    var occlusionMap: float = 1f
    var strength: float = 1f

    func Compute(inout d: MaterialData) {
        d.occlusion = d.occlusion * lerp(1f, saturate(occlusionMap), saturate(strength))
    }
}
