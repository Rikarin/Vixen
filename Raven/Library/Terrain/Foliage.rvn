package Vixen.Shaders.Terrain

import Vixen.Shaders.Core
import Vixen.Shaders.Geometry
import Vixen.Shaders.Shading

// Drawing what `FoliageCull.rvn` compacted: one instanced mesh per surviving tree or rock.
//
// `docs/plan/31 § T5`'s draw half. The cull's placing phase wrote three things this reads and nothing
// travels through host memory between them: `survivors` holds the indices of the instances that made
// it, `parameters` their per-instance numbers at the same slots, and the indirect command's
// `firstInstance` points `SV_InstanceID` at the batch's own run — so the instance id *is* the
// survivor slot, on the same contract `Grass.rvn`'s blades ride the scatter's counts.
//
// **The survivors are indices, not transforms** — `FoliageCull.rvn` says why — so the vertex stage
// makes one extra buffer read: survivor slot to instance index to the thirty-two-byte record the
// volume uploaded. That indirection is the whole design: the instance buffer never moves after
// upload, and a frame's cull re-aims the draws at a subset of it.
//
// **The fade is the cull's, not remeasured here.** `FoliageCullParameters.fade` was computed from the
// same distance the cull binned the instance by, and a draw that measured its own would disagree with
// the cull at exactly the distance where disagreement is visible — an instance culled while still
// partly opaque. The stipple pattern is the grass's, so a foliage LOD dissolving and a grass blade
// fading composite identically.
//
// **The cutout and the fade are one predicate, `FoliageBase.Cutout`** — `Grass.rvn`'s arrangement
// and its argument, which is stronger here: a leaf card is mostly hole, so a canopy without an alpha
// test is a stack of opaque rectangles rather than a tree.
//
// **Three shaders share one base**, on `Terrain.rvn`'s arrangement: `FoliageBase` owns the bindings,
// the streams and the placement, `Foliage` is the editor's preview lit by a hard-coded direction,
// `FoliageLit` is the frame's — the same sun and the same cascade atlas the terrain under it
// reads, through `FrameLit.rvn`'s transliterations — and `FoliageVelocity` reprojects the same
// static placements for the frame's temporal resolve.

shader FoliageBase {
    /// Whether instances stipple out over the band before their cull distance.
    ///
    /// A permutation because the alternative is a `discard` in every fragment of a forest that never
    /// fades, and a shader with no discard can keep early depth.
    [Permutation] val CrossFade: bool = true

    var viewProjection: mat4

    /// What a `tint` of 0 and 1 mean, as a multiplier on the albedo.
    ///
    /// The cull writes every survivor's tint as 0 for now, so the low end is what a forest wears;
    /// carried anyway so the day the cull rolls per-instance variation the draw already reads it.
    var tintRange: float2

    /// Every instance of every batch, exactly as `FoliageCullPass.Upload` wrote them.
    ///
    /// ⚠ **The cull's own buffer, indexed through `survivors` rather than copied.** A compacted
    /// transform buffer would be sixty-four bytes an instance where the indirection is four — and
    /// the indirection is unavoidable anyway, because `firstInstance` indexes *something*.
    var instances: Buffer<FoliageCullInstance>

    /// The survivors' indices into `instances`, grouped by level within each batch's run.
    ///
    /// ⚠ **Written by the placing dispatch and read here with nothing in between.** The count comes
    /// from the indirect command the same dispatch patched, so a frame in which fewer survived draws
    /// fewer — rather than drawing last frame's tail out of a buffer nobody cleared.
    var survivors: Buffer<uint>

    /// And their per-instance numbers, at the same slots.
    var parameters: Buffer<FoliageCullParameters>

    /// The mesh's albedo, or the pass's white default while no material path exists.
    ///
    /// ⚠ **One map for a whole volume's palette.** A stand mixing bark and leaves needs a texture per
    /// type, which this binding cannot express — `FoliageDrawPass.Albedo`'s remarks carry the shape
    /// that would fix it. Until then a volume is authored around a single map.
    var albedoMap: Texture2D
    var albedoSampler: Sampler

    /// The alpha below which a texel is not there, 0…1. `GrassBlade.alphaCutoff`'s terms exactly.
    var alphaCutoff: float = 0.5f

    stream var uv: float2
    stream var normalWS: float3
    stream var positionWS: float3
    stream var fade: float

    /// The shared vertex arithmetic: find the survivor, place the mesh, fill the streams.
    ///
    /// A function rather than the entry point, for `TerrainBase.PatchVertex`'s reason — the preview
    /// and the lit pass must place identical instances, and identical is a property only shared code
    /// has. `instance` is `SV_InstanceID`, which the indirect command's patched `firstInstance` has
    /// already aimed at this batch's slot of this level's run.
    func PlantVertex(position: float3, normal: float3, texcoord: float2, instance: int): float4 {
        val survivor = int(survivors[instance])
        val plant = instances[survivor]
        val record = parameters[instance]

        val scaled = position * (plant.scale * record.scale)
        val world = plant.position + Instancing.RotateByQuaternion(plant.rotation, scaled)

        uv = texcoord
        normalWS = Math.SafeNormalize(Instancing.RotateByQuaternion(plant.rotation, normal))
        positionWS = world
        fade = record.fade

        return viewProjection * float4(world, 1f)
    }

    /// The stipple threshold at a pixel, 0…1 — the grass's interleaved gradient noise, verbatim.
    ///
    /// The same three constants deliberately: a tree's far LOD dissolving over grass that is fading
    /// must dissolve against the same pattern, or the two dithers interfere as a visible weave.
    func Stipple(pixel: float2): float {
        return frac(52.9829189f * frac(dot(pixel, float2(0.06711056f, 0.00583715f))))
    }

    /// Whether this fragment is not there — cut out of the card, or stippled out by the fade.
    ///
    /// ⚠ Every fragment stage in this file calls exactly this — `GrassBlade.Cutout`'s note, for the
    /// same reason: the colour pass and the velocity pass must reach the same answer for the same
    /// pixel, and one predicate is the only form of "the same" that survives an edit.
    func Cutout(alpha: float, pixel: float2): bool {
        return alpha < alphaCutoff || (CrossFade && Stipple(pixel) >= fade)
    }
}

shader Foliage : FoliageBase {
    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex(
        [Semantic("POSITION")] position: float3,
        [Semantic("NORMAL")] normal: float3,
        [Semantic("TEXCOORD0")] texcoord: float2,
        [Semantic("SV_InstanceID")] instance: int
    ): float4 {
        return PlantVertex(position, normal, texcoord, instance)
    }

    [FragmentShader]
    [Semantic("SV_Target")]
    func Fragment([Semantic("SV_Position")] fragment: float4): float4 {
        val sampled = albedoMap.Sample(albedoSampler, uv)

        // ⚠ Stippled, not blended — the grass fragment's argument, which is worse here: a forest's
        // canopies overlap far deeper than blades do, and translucency would sort all of them.
        if (Cutout(sampled.a, fragment.xy)) {
            discard
        }

        val shade = tintRange.x
        val normal = Math.SafeNormalize(normalWS)
        val light = saturate(dot(normal, Math.SafeNormalize(float3(0.4f, 0.8f, 0.3f))))

        // One, not `sampled.a` — `Grass.Fragment`'s note: an opaque target, and the cutout has
        // already answered coverage.
        return float4(sampled.rgb * shade * (0.25f + 0.75f * light), 1f)
    }
}

shader FoliageVelocity : FoliageBase {
    /// The camera's view-projection *last* frame — the instances are world-space, so no placement
    /// rides either matrix. Unjittered, as `TerrainVelocity`'s note states for both.
    ///
    /// The only extra binding, because a placed tree does not move: unlike the grass there is no
    /// second clock to evaluate — the camera term is the whole motion, and `positionWS` goes
    /// through both matrices unchanged. Trunk sway is owed with the impostors' wind, and the day
    /// the draw gains it this shader gains the grass's second evaluation.
    var previousViewProjection: mat4

    stream var currentClip: float4
    stream var previousClip: float4

    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex(
        [Semantic("POSITION")] position: float3,
        [Semantic("NORMAL")] normal: float3,
        [Semantic("TEXCOORD0")] texcoord: float2,
        [Semantic("SV_InstanceID")] instance: int
    ): float4 {
        val clip = PlantVertex(position, normal, texcoord, instance)

        currentClip = clip
        previousClip = previousViewProjection * float4(positionWS, 1f)

        return clip
    }

    /// `MotionVectors.Fragment`'s convention, behind the same cutout the colour passes take — the
    /// grass velocity fragment's argument: the discard must match the colour pass's exactly, or a
    /// dissolved pixel's velocity overwrites the surface visible through it. Which is why this pass
    /// samples an albedo whose colour it never uses: the alpha decides where the canopy is.
    [FragmentShader]
    [Semantic("SV_Target")]
    func Fragment([Semantic("SV_Position")] fragment: float4): float4 {
        if (Cutout(albedoMap.Sample(albedoSampler, uv).a, fragment.xy)) {
            discard
        }

        val here = currentClip.xy / max(currentClip.w, Const.Epsilon)
        val there = previousClip.xy / max(previousClip.w, Const.Epsilon)
        val motion = (there - here) * float2(0.5f, -0.5f)

        return float4(motion.x, motion.y, 0f, 1f)
    }
}

shader FoliageLit : FoliageBase {
    /// Whether the frame splits its outputs — `TerrainLit.SplitOutputs`, for the trees.
    [Permutation] val SplitOutputs: bool = false

    /// The direction light travels — away from the sun. The scene pass's uniform, verbatim.
    var lightDirection: float3

    /// The frame's shadow bias, in metres — `ShadowMapRenderer.Publish`'s value.
    var shadowConstantBias: float

    /// The sun's radiance, premultiplied by intensity.
    var lightColor: float3

    var shadowSlopeBias: float

    var shadowFadeRange: float

    /// The sky's ambient scale — `EnvironmentLight.Intensity`, the scene pass's own number.
    var ambientIntensity: float

    /// World to view, for the cascade selection's view depth. The frame camera's matrix.
    var view: mat4

    /// The sun's cascades — `TerrainLit.cascades`' terms: always four, tail padded degenerate.
    var cascades: ShadowCascade[4]

    /// The sky's diffuse irradiance, projected into nine coefficients — the frame's own values.
    var environmentSh: ShCoefficients

    var shadowTexelSize: float2

    /// The cascade atlas the frame rendered.
    var shadowMap: Texture2D
    var shadowSampler: Sampler

    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex(
        [Semantic("POSITION")] position: float3,
        [Semantic("NORMAL")] normal: float3,
        [Semantic("TEXCOORD0")] texcoord: float2,
        [Semantic("SV_InstanceID")] instance: int
    ): float4 {
        return PlantVertex(position, normal, texcoord, instance)
    }

    /// ⚠ Lit and reported with the *mesh's* normal, where the grass deliberately uses the ground's.
    ///
    /// A blade is optically the meadow it covers; a trunk is a cylinder the sun goes behind, and a
    /// rock's shading is its facets. The same raw signed vector goes to `SceneNormals` under a split
    /// frame — `TerrainTargets.normal`'s own convention — so AO and GI see the canopy's shape.
    ///
    /// The shadow is looked up per fragment rather than at the instance's root: a tree spans many
    /// cascade texels, and a canopy shadowed by its own trunk's answer would flatten every crown to
    /// one term. The grass samples at the root because a blade spans a fraction of one texel; a tree
    /// is the opposite case.
    [FragmentShader]
    func Fragment([Semantic("SV_Position")] fragment: float4): TerrainTargets {
        val sampled = albedoMap.Sample(albedoSampler, uv)

        // The same cutout the preview takes — neither the card's holes nor the fade may change with
        // the lighting.
        if (Cutout(sampled.a, fragment.xy)) {
            discard
        }

        val albedo = sampled.rgb * tintRange.x
        val n = Math.SafeNormalize(normalWS)

        val world = positionWS
        val viewDepth = FrameClusters.DepthOf(Math.TransformPoint(view, world))

        val sun = Lighting.Directional(lightDirection, lightColor)
        val NdotL = saturate(dot(n, sun.l))

        var visibility = 1f

        if (NdotL > 0f) {
            visibility = FrameShadow.Term(
                shadowMap,
                shadowSampler,
                cascades,
                world,
                n,
                NdotL,
                viewDepth,
                shadowTexelSize,
                shadowConstantBias,
                shadowSlopeBias,
                shadowFadeRange
            )
        }

        // The sun and the sky, and no clustered lamps — the grass's trade, made for a different
        // reason: a lamp against a tree wants the per-object list the forward pass has and this
        // stack deliberately does not, and the sun is what a forest is lit by. Owed with the
        // impostors, which need the same answer.
        var colour = albedo * Const.InvPi * sun.radiance * NdotL * visibility

        var targets: TerrainTargets

        // One rather than `sampled.a` in both branches — `Grass.Fragment`'s note.
        if (SplitOutputs) {
            targets.color = float4(colour, 1f)
            targets.albedo = float4(albedo, 1f)

            // Raw and signed — `SceneNormals`' convention, where an encode misleads every reader.
            targets.normal = float4(n, 1f)
        } else {
            val irradiance = Ibl.IrradianceSh9(n, environmentSh)

            colour += Ibl.Diffuse(irradiance, albedo, 1f) * ambientIntensity

            targets.color = float4(colour, 1f)
        }

        return targets
    }
}
