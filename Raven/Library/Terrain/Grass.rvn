package Vixen.Shaders.Terrain

import Vixen.Shaders.Core
import Vixen.Shaders.Geometry
import Vixen.Shaders.Shading

// Drawing what `GrassScatter.rvn` produced: one instanced mesh per blade, swayed by the wind.
//
// `docs/plan/31 § T6`. The instance buffer this reads is the one the scatter appended to, so nothing
// travels through host memory between the two — a cell entering range is a dispatch and then a draw,
// and the transform never exists on the CPU at all. `GrassRenderer` in `Vixen.Rendering.Terrain` is
// the reference form of the same thing, for a headless test and for a machine with no compute queue.
//
// **The wind is `Displacement.WindPhased` and not a second implementation of it.** Foliage, water and
// a material's own displacement all sway; one of them growing its own copy of two sines is how the
// grass and the trees in one scene come to move at different speeds in the same gust.
//
// **The fade is the dithered discard the LOD cross-fade already uses.** A blade crossing its cull
// distance is not made translucent — two translucent things sort against each other and grass is
// thousands of them — it is stippled out, which composites for free and reaches zero exactly at the
// distance the cull drops it.
//
// **The cutout and the fade are one predicate, `GrassBlade.Cutout`, and all three fragments call
// it.** A blade is drawn as a card and the card's margin is transparent, so an alpha test is what
// turns the margin into a hole rather than into its background colour — and the velocity pass has to
// cut out the *same* fragments as the colour pass, because it depth-tests against the frame's
// finished depth and a fragment surviving where colour discarded would write the blade's motion over
// the ground's. Two shaders holding two copies of that test is one edit away from disagreeing, which
// is why the test is a function on the base rather than a line in each entry point.
//
// **Three shaders share one base**, on `Terrain.rvn`'s arrangement: `GrassBlade` owns the bindings,
// the streams and the sway, `Grass` is the editor's preview lit by a hard-coded direction,
// `GrassLit` is the frame's — the same sun and the same cascade atlas the terrain under it reads —
// and `GrassVelocity` places the same blades at two clocks so the resolve can follow the sway.

shader GrassBlade {
    /// Whether blades fade out over the band before their cull distance.
    ///
    /// A permutation because the alternative is a `discard` in every fragment of a field that never
    /// fades, and a shader with no discard can keep early depth.
    [Permutation] val CrossFade: bool = true

    var viewProjection: mat4

    /// Where the camera is, which the fade distance is measured from.
    var viewPosition: float3

    /// Seconds, for the sway.
    var time: float

    /// How the field moves.
    var wind: WindParameters

    /// The blades this draw covers, indexed by `SV_InstanceID`.
    ///
    /// ⚠ **Written by the compute pass and read here with nothing in between.** The count comes from
    /// the indirect command the same pass filled, so a frame in which the scatter produced fewer
    /// blades draws fewer — rather than drawing last frame's tail out of a buffer nobody cleared.
    var blades: Buffer<GrassInstance>

    /// The blade's albedo, tinted per instance.
    var albedoMap: Texture2D
    var albedoSampler: Sampler

    /// The alpha below which a texel is not there, 0…1.
    ///
    /// ⚠ **A uniform and not a permutation, unlike `DepthOnly.AlphaTested`.** The colour pass and the
    /// velocity pass resolve through different paths — the draw's variant is picked per grass type
    /// and the velocity's once for the whole scene — so a permutation is two places the answer is
    /// chosen and one of them is a frame away from being chosen differently. One number the velocity
    /// pass takes from the colour pass, the way it already takes the albedo view and the sampler,
    /// cannot drift. Zero means no cutout: `a < 0` is false for every texel, including the pass's
    /// opaque white default.
    var alphaCutoff: float = 0.5f

    /// What `tint` of 0 and 1 mean, as a multiplier on the albedo.
    var tintRange: float2

    /// Where the fade band starts and ends, in metres.
    var fadeRange: float2

    stream var uv: float2
    stream var normalWS: float3
    stream var tint: float
    stream var fade: float

    /// The shared vertex arithmetic: place the blade, sway it, fill the streams.
    ///
    /// A function rather than the entry point, for `TerrainBase.PatchVertex`'s reason — the preview
    /// and the lit pass must place identical blades, and identical is a property only shared code
    /// has. The blade's index is returned by way of the streams; a caller that needs the instance
    /// record again reads `blades` a second time, which is a buffer load the cache already holds.
    func BladeVertex(position: float3, normal: float3, texcoord: float2, instance: int): float4 {
        val blade = blades[instance]

        val scaled = position * blade.scale
        val rotated = Instancing.RotateByQuaternion(blade.rotation, scaled)
        val world = blade.position + rotated

        // The sway is weighted by height *above the blade's own pivot*, which is what the object-space
        // position is and why it is passed rather than the world one. Handing the world height in
        // instead would make a blade on a hilltop thrash and one in a valley stand still.
        val sway = Displacement.WindPhased(scaled, world, wind, time, blade.windPhase)

        uv = texcoord
        normalWS = Math.SafeNormalize(Instancing.RotateByQuaternion(blade.rotation, normal))
        tint = blade.tint
        fade = Fade(world)

        return viewProjection * float4(world + sway, 1f)
    }

    /// How present a blade is, 0…1, from how far away it is.
    ///
    /// One at the near edge of the band and zero at the far one, which is where the cull drops it —
    /// so a blade the cull removes was already invisible and nothing pops. The cull measures the same
    /// distance, and the two agreeing is why `fadeRange` is the type's own start and end rather than
    /// a number this shader chose.
    func Fade(world: float3): float {
        if (!CrossFade) {
            return 1f
        }

        val distance = length(world - viewPosition)
        val band = max(fadeRange.y - fadeRange.x, Const.Epsilon)

        return saturate((fadeRange.y - distance) / band)
    }

    /// The stipple threshold at a pixel, 0…1 — interleaved gradient noise.
    ///
    /// Screen space rather than object space, so two blades overlapping the same pixels dissolve
    /// against different thresholds instead of vanishing together. Three constants and a fract, which
    /// is what makes it affordable on a field of thousands.
    func Stipple(pixel: float2): float {
        return frac(52.9829189f * frac(dot(pixel, float2(0.06711056f, 0.00583715f))))
    }

    /// Whether this fragment is not there — cut out of the card, or stippled out by the fade.
    ///
    /// ⚠ **Every fragment stage in this file calls exactly this, and that is the point.** The colour
    /// pass and the velocity pass must reach the same answer for the same pixel; the file header
    /// says what a disagreement writes. The two reasons are one predicate because they are one
    /// question — whether the blade covers the pixel — and because a caller that took them
    /// separately could take one and forget the other.
    func Cutout(alpha: float, pixel: float2): bool {
        return alpha < alphaCutoff || (CrossFade && Stipple(pixel) >= fade)
    }
}

shader Grass : GrassBlade {
    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex(
        [Semantic("POSITION")] position: float3,
        [Semantic("NORMAL")] normal: float3,
        [Semantic("TEXCOORD0")] texcoord: float2,
        [Semantic("SV_InstanceID")] instance: int
    ): float4 {
        return BladeVertex(position, normal, texcoord, instance)
    }

    [FragmentShader]
    [Semantic("SV_Target")]
    func Fragment([Semantic("SV_Position")] fragment: float4): float4 {
        val sampled = albedoMap.Sample(albedoSampler, uv)

        // ⚠ Stippled, not blended. A field is thousands of overlapping blades, and translucency would
        // make every one of them sort against every other — which is both slower and wrong. The
        // pattern is the screen-space one `LodRenderFeature`'s cross-fade uses, so a blade fading out
        // and a LOD level fading in dissolve identically.
        if (Cutout(sampled.a, fragment.xy)) {
            discard
        }

        val shade = lerp(tintRange.x, tintRange.y, tint)
        val normal = Math.SafeNormalize(normalWS)
        val light = saturate(dot(normal, Math.SafeNormalize(float3(0.4f, 0.8f, 0.3f))))

        // One, not `sampled.a`: the target is opaque and a fragment that survived the cutout is
        // wholly there. Writing the card's alpha into it puts the cutout's own mask in a channel
        // whose readers — the terrain beside it writes one — take it for coverage.
        return float4(sampled.rgb * shade * (0.25f + 0.75f * light), 1f)
    }
}

shader GrassVelocity : GrassBlade {
    /// The camera's view-projection *last* frame — the blades are scattered in world space, so no
    /// placement rides either matrix. Unjittered, as `TerrainVelocity`'s note states for both.
    var previousViewProjection: mat4

    /// The clock the wind was sampled at *last* frame, in seconds.
    ///
    /// ⚠ **The wind is evaluated twice, and that is the whole point of a grass velocity shader.**
    /// A blade's screen motion is the camera's plus its own sway; reprojecting a swaying tip as if
    /// it were static leaves the sway's motion unaccounted, which is the tip ghosting against its
    /// own wake in every gust. The parameters are this frame's — a wind that changes strength
    /// between two frames moves the field far less than its phase does.
    var previousTime: float

    stream var currentClip: float4
    stream var previousClip: float4

    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex(
        [Semantic("POSITION")] position: float3,
        [Semantic("NORMAL")] normal: float3,
        [Semantic("TEXCOORD0")] texcoord: float2,
        [Semantic("SV_InstanceID")] instance: int
    ): float4 {
        val clip = BladeVertex(position, normal, texcoord, instance)

        // The same placement arithmetic the shared function ran, at last frame's clock — a second
        // read of a record the cache already holds, `GrassLit.Vertex`'s own trade. Only the sway
        // moves between frames: the root, the rotation and the scale are the scatter's, and the
        // scatter reruns per cell rather than per frame.
        val blade = blades[instance]
        val scaled = position * blade.scale
        val world = blade.position + Instancing.RotateByQuaternion(blade.rotation, scaled)
        val sway = Displacement.WindPhased(scaled, world, wind, previousTime, blade.windPhase)

        currentClip = clip
        previousClip = previousViewProjection * float4(world + sway, 1f)

        return clip
    }

    /// `MotionVectors.Fragment`'s convention, behind the same cutout the colour passes take.
    ///
    /// ⚠ The cutout must match exactly — same cutoff, same pattern, same `fade` — because the
    /// velocity pass depth-tests against the frame's finished depth: a fragment the colour pass
    /// discarded shows the terrain behind it, and a velocity fragment surviving there would
    /// overwrite the ground's answer with the blade's. `Cutout` is what makes "exactly" structural.
    ///
    /// ⚠ **This is why the velocity pass binds an albedo it draws nothing with.** The map is sampled
    /// for one channel and the colour is thrown away; the binding predates the read, and a velocity
    /// pass that skipped it would cut the card's margin out of the picture and leave the margin's
    /// motion in the buffer.
    [FragmentShader]
    [Semantic("SV_Target")]
    func Fragment([Semantic("SV_Position")] fragment: float4): float4 {
        if (Cutout(albedoMap.Sample(albedoSampler, uv).a, fragment.xy)) {
            discard
        }

        val here = currentClip.xy / max(currentClip.w, Const.Epsilon)
        val there = previousClip.xy / max(previousClip.w, Const.Epsilon)
        val motion = (there - here) * float2(0.5f, -0.5f)

        return float4(motion.x, motion.y, 0f, 1f)
    }
}

shader GrassLit : GrassBlade {
    /// Whether the frame splits its outputs — `TerrainLit.SplitOutputs`, for the blades.
    [Permutation] val SplitOutputs: bool = false

    /// The direction light travels — away from the sun. The scene pass's uniform, verbatim.
    var lightDirection: float3

    /// The frame's shadow bias, in metres — `ShadowMapRenderer.Publish`'s value.
    var shadowConstantBias: float

    /// The sun's radiance, premultiplied by intensity.
    var lightColor: float3

    var shadowSlopeBias: float

    var shadowFadeRange: float

    /// The sky's ambient scale — `EnvironmentLight.Intensity`, the scene pass's own number.
    var ambientIntensity: float

    /// World to view, for the cascade selection's view depth. The frame camera's matrix.
    var view: mat4

    /// The sun's cascades — `TerrainLit.cascades`' terms: always four, tail padded degenerate.
    var cascades: ShadowCascade[4]

    /// The sky's diffuse irradiance, projected into nine coefficients — the frame's own values.
    var environmentSh: ShCoefficients

    var shadowTexelSize: float2

    /// The cascade atlas the frame rendered.
    var shadowMap: Texture2D
    var shadowSampler: Sampler

    /// The blade's rotated up axis — the ground the blade stands for, not the card it is drawn as.
    ///
    /// ⚠ **The lit pass lights and reports grass as ground, deliberately.** A blade's mesh normal
    /// swings through ninety degrees as its card turns, which under a real sun draws a field as
    /// glitter; its rotated up axis is the surface normal wherever the scatter aligned it and world
    /// up where it did not, which is what a field of grass optically is — the ground, slightly
    /// furred. The same vector goes to `SceneNormals`, so screen-space AO and GI treat blades as the
    /// ground they cover rather than as thousands of tiny walls. The wind displaces positions and
    /// leaves this alone: a swaying tip does not change which way the meadow faces.
    stream var groundWS: float3

    /// The blade's root, for the shadow lookup — a blade shadows as one point of ground.
    ///
    /// ⚠ Per blade rather than per fragment, deliberately: a five-centimetre blade spans a small
    /// fraction of a cascade texel, so every fragment of it lands on the same shadow answer anyway
    /// — and sampling at the swaying tip instead is how a field shimmers at every shadow edge in
    /// the wind.
    stream var rootWS: float3

    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex(
        [Semantic("POSITION")] position: float3,
        [Semantic("NORMAL")] normal: float3,
        [Semantic("TEXCOORD0")] texcoord: float2,
        [Semantic("SV_InstanceID")] instance: int
    ): float4 {
        val clip = BladeVertex(position, normal, texcoord, instance)

        // A second read of the same record the shared arithmetic took — cached, and cheaper than
        // widening the shared function's signature for one variant.
        groundWS = Math.SafeNormalize(
            Instancing.RotateByQuaternion(blades[instance].rotation, float3(0f, 1f, 0f))
        )

        rootWS = blades[instance].position

        return clip
    }

    [FragmentShader]
    func Fragment([Semantic("SV_Position")] fragment: float4): TerrainTargets {
        val sampled = albedoMap.Sample(albedoSampler, uv)

        // The same cutout the preview takes — neither the card's holes nor the fade may change with
        // the lighting, or a field looks like a different field in the editor.
        if (Cutout(sampled.a, fragment.xy)) {
            discard
        }

        val shade = lerp(tintRange.x, tintRange.y, tint)
        val albedo = sampled.rgb * shade
        val n = Math.SafeNormalize(groundWS)

        val world = rootWS
        val viewDepth = FrameClusters.DepthOf(Math.TransformPoint(view, world))

        val sun = Lighting.Directional(lightDirection, lightColor)
        val NdotL = saturate(dot(n, sun.l))

        var visibility = 1f

        if (NdotL > 0f) {
            visibility = FrameShadow.Term(
                shadowMap,
                shadowSampler,
                cascades,
                world,
                n,
                NdotL,
                viewDepth,
                shadowTexelSize,
                shadowConstantBias,
                shadowSlopeBias,
                shadowFadeRange
            )
        }

        // The sun and the sky, and no clustered lamps: a blade is centimetres across and fades out
        // within a hundred metres, so the lamps' contribution is the terrain's under it — which the
        // eye reads as correct because the ground shows through the field everywhere.
        var colour = albedo * Const.InvPi * sun.radiance * NdotL * visibility

        var targets: TerrainTargets

        // One rather than `sampled.a` in both branches — `Grass.Fragment`'s note: the cutout has
        // already decided coverage, and the terrain writing beside this writes one.
        if (SplitOutputs) {
            targets.color = float4(colour, 1f)
            targets.albedo = float4(albedo, 1f)

            // Raw and signed, and the *ground's* — the stream's own note says why.
            targets.normal = float4(n, 1f)

            // Dielectric — `TerrainTargets.specular`'s note; a blade of grass is not a mirror.
            targets.specular = float4(0.04f, 0.04f, 0.04f, 0f)
        } else {
            val irradiance = Ibl.IrradianceSh9(n, environmentSh)

            colour += Ibl.Diffuse(irradiance, albedo, 1f) * ambientIntensity

            targets.color = float4(colour, 1f)
        }

        return targets
    }
}
