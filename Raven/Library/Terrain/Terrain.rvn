package Vixen.Shaders.Terrain

import Vixen.Shaders.Core
import Vixen.Shaders.Geometry

// The terrain surface: one instanced grid patch, morphed into its parent, sampling a heightfield.
//
// `docs/plan/31 § D3`. Every patch a frame draws is the *same* grid — 33² vertices for a 32-quad
// patch — scaled and placed by a per-node record, so a terrain is one draw call however many patches
// it takes. What distinguishes the patches is `TerrainNode`, addressed by `SV_InstanceID`.
//
// The morph is the whole reason there are no skirts. A patch degenerates onto its parent's grid as
// the camera pulls back, and is *fully* degenerate by the distance at which the parent takes over —
// so a boundary between two levels has no gap to hide. The arithmetic is `TerrainLodTree.MorphIndex`
// in `Vixen.Terrain`, and `TerrainShaderParityTests` holds this against it, because a shader cannot
// be asked whether two patches agree and a function can.

/// One patch of terrain a frame draws.
///
/// The per-instance record `TerrainRenderFeature` uploads, one per node the quadtree selected.
struct TerrainNode {
    /// Where the patch's low corner is, in sample coordinates.
    var origin: float2

    /// How many samples one step of the grid patch spans. `quads / gridQuads`.
    var step: float

    /// How far the patch has morphed towards its parent's grid, 0…1.
    var morph: float

    /// Which mip level of the atlas this patch reads.
    ///
    /// ⚠ **The host's, not `log2(step)` recomputed here.** The chain is as long as a *tile's* rather
    /// than as long as the atlas's, so the clamp is a fact about the layout and the host is what
    /// knows it — a shader that clamped to its own guess would read a level that does not exist on
    /// the day somebody changed the tile size.
    var level: float

    /// Declared rather than left to the compiler, so the record is twenty-four bytes on both sides.
    ///
    /// ⚠ **Five floats is twenty bytes in C# and twenty-four here**, because a struct aligns to its
    /// widest member — the `float2`'s eight — and its size rounds up to a multiple of that. A host
    /// writing a twenty-byte stride into this array does not fail; it draws patch one out of the
    /// middle of patch zero.
    var padding0: float
}

shader Terrain {
    /// How many quads the shared grid patch spans. A compile-time constant so the morph can fold.
    [Permutation] val GridQuads: int = 32

    /// Whether to blend the layers by height rather than only by weight.
    [Permutation] val HeightBlend: bool = false

    /// How many layer slots the material was generated for. See `TerrainWeights.MaterialLayerSlots`.
    [Permutation] val LayerSlots: int = 4

    var viewProjection: mat4

    /// The patches this draw covers.
    var nodes: Buffer<TerrainNode>

    /// The composited heights, one texel per sample, normalised to 0…1.
    var heightMap: Texture2D
    var heightSampler: Sampler

    /// How many texels the atlas is, so a sample coordinate becomes a texture coordinate.
    var heightMapSize: float2

    /// How many samples one tile's block is, on a side. A power of two.
    var tileSamples: float

    /// How many quads that is — one fewer, because the packed grid shares its boundary samples.
    var tileQuads: float

    /// How many tiles the atlas holds, along each axis.
    var atlasTiles: float2

    /// What a stored height of 0 and 1 mean, in metres.
    var heightRange: float2

    /// How far apart two samples are, in metres.
    var metresPerQuad: float

    /// The layer weights, four to a texture.
    var weightMaps: Texture2D[]
    var weightSampler: Sampler

    /// Each layer's albedo, indexed the same way the weights are.
    var layerMaps: Texture2D[]
    var layerSampler: Sampler

    /// Where the terrain has no surface at all, one texel per sample. Non-zero is a hole.
    ///
    /// ⚠ **Sampled at level 0 and never filtered towards a neighbour, which is why the test is
    /// `> 0.5`.** A hole's edge is a decision, not a gradient: a bilinear tap halfway between a hole
    /// and its neighbour is 0.5 either way, and a threshold anywhere else makes the cave mouth one
    /// texel wider on one side of the terrain than the other.
    var holeMap: Texture2D
    var holeSampler: Sampler

    /// Each layer's packed occlusion / roughness / metalness, with the blend height in `a`.
    ///
    /// Indexed the same way `layerMaps` is. A layer that declares no surface texture is bound the
    /// default, whose alpha is 0.5 — a flat height, which makes a height blend degrade to a weight
    /// blend rather than to a hard edge.
    var surfaceMaps: Texture2D[]

    /// How many metres of world one tile of each layer's texture covers.
    var layerScales: Buffer<float>

    /// Per layer: how it blends (0 weight, 1 height, 2 alpha) and how sharply, packed as a float2.
    ///
    /// A buffer rather than a permutation because it is per *layer* and the permutation is per
    /// *material*: eight layers with three different modes between them is one shader, not eight.
    /// `HeightBlend` above says whether any layer wants the height path at all, so a terrain that
    /// uses none of it pays for none of it.
    var layerBlends: Buffer<float2>

    stream var positionWS: float3
    stream var normalWS: float3
    stream var sampleCoord: float2

    /// The vertex stage.
    ///
    /// `SV_VertexID` rather than a vertex buffer: the grid patch is a regular lattice, so its
    /// positions are two divisions of the index and uploading 33² of them per frame would be sending
    /// the shader something it can count. What *is* uploaded is one `TerrainNode` per patch.
    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex(
        [Semantic("SV_VertexID")] vertex: int,
        [Semantic("SV_InstanceID")] instance: int
    ): float4 {
        val node = nodes[instance]
        val side = GridQuads + 1

        val gridX = vertex % side
        val gridZ = vertex / side

        // The morph. An odd index slides back onto its even neighbour, so at morph 1 the patch has
        // exactly half its resolution — which is its parent's, which is why the boundary between the
        // two has nothing to leak through. `MorphIndex` in `TerrainLodTree` is the same expression.
        val morphed = float2(
            float(gridX) - float(gridX % 2) * node.morph,
            float(gridZ) - float(gridZ % 2) * node.morph
        )

        val sample = node.origin + morphed * node.step
        sampleCoord = sample

        val height = Height(sample, node.level)
        positionWS = float3(sample.x * metresPerQuad, height, sample.y * metresPerQuad)

        // Central differences over the heightfield, at the patch's own step rather than at one
        // sample. A normal taken at full resolution on a coarse patch is the normal of geometry that
        // patch does not have, which reads as a coarse terrain lit like a fine one — and the seam
        // between two levels becomes visible in the lighting even though the positions agree.
        normalWS = Normal(sample, node.step, node.level)

        return Transform.ObjectToClip(viewProjection, positionWS)
    }

    /// Where a sample coordinate lands in the atlas. `TerrainAtlas.UvOf`, transliterated.
    ///
    /// ⚠ **The blocks duplicate their boundary samples rather than sharing them**, which is what
    /// makes this a linear map inside every block and therefore continuous across the seam: the last
    /// texel of tile *k* and the first of tile *k+1* hold the same number, so a tap that crosses
    /// blends a value with itself.
    ///
    /// ⚠ **A sample exactly on a boundary belongs to the *upper* tile**, which is
    /// `TerrainDescription.TileOf`'s choice and not a second one: `x / tileQuads` sends sample 127 of
    /// a 128-sample tiling to tile 1. Two answers to "which tile is sample 127 in" is a terrain that
    /// reads one block and was written into another. The lower tile still holds that sample in its
    /// last column, which is the duplication that keeps the seam continuous.
    func AtlasUv(sample: float2): float2 {
        val tile = clamp(floor(sample / tileQuads), float2(0f, 0f), atlasTiles - float2(1f, 1f))
        val local = sample - tile * tileQuads

        return (tile * tileSamples + local + float2(0.5f, 0.5f)) / heightMapSize
    }

    /// The height at a sample coordinate, in metres, read at a patch's own level.
    ///
    /// `SampleLevel` rather than `Sample`, and it has to be: a vertex stage has no derivatives, so
    /// `Sample` outside a fragment stage never meant what it looked like — SPIR-V was quietly
    /// substituting level zero. See `docs/plan/07`, where this was the reason `SampleLevel` landed.
    ///
    /// ⚠ **The level is the patch's and not zero, which is what stops a coarse patch shimmering.**
    /// A patch at level three samples every eighth texel; reading level 0 gives it a height nothing
    /// between its own vertices ever had, so the surface swims as the camera moves. The chain is
    /// reduced by the *maximum* — see `TerrainMips` — so a distant ridge stays a ridge.
    func Height(sample: float2, level: float): float {
        val stored = heightMap.SampleLevel(heightSampler, AtlasUv(sample), level).r

        return lerp(heightRange.x, heightRange.y, stored)
    }

    /// The surface normal at a sample coordinate, differenced at a patch's own step.
    func Normal(sample: float2, step: float, level: float): float3 {
        val span = max(step, 1f)

        val left = Height(sample - float2(span, 0f), level)
        val right = Height(sample + float2(span, 0f), level)
        val down = Height(sample - float2(0f, span), level)
        val up = Height(sample + float2(0f, span), level)

        // The cross product of the two tangents, written out. The 2·span·metresPerQuad terms are the
        // world-space run either side, and leaving them out is what makes a normal that changes with
        // the resolution rather than with the ground.
        val run = 2f * span * metresPerQuad

        return Math.SafeNormalize(float3(left - right, run, down - up))
    }

    /// The blended albedo at a fragment.
    ///
    /// A bounded loop over the layer slots, sampling each layer's albedo at its own world scale and
    /// weighting it by the channel painted for it. Most samples touch two or three layers because
    /// the rest weigh nothing — which is the arithmetic `docs/plan/31 § D7` uses to defer the virtual
    /// texture: this is a normal material, not a pathology.
    ///
    /// Two passes when `HeightBlend` is on, and it has to be two: a height blend needs to know the
    /// *highest* contender at this fragment before it can say how much any of them contributes, and
    /// that is not known until every layer has been looked at. The first pass costs the height
    /// samples and nothing else, and a terrain whose layers all blend by weight compiles it out.
    func Albedo(): float3 {
        var peak = 0f

        if (HeightBlend) {
            for (layer in 0 .. LayerSlots - 1) {
                if (Weight(layer) > 0f) {
                    peak = max(peak, LayerHeight(layer) + Weight(layer))
                }
            }
        }

        var colour = float3(0f, 0f, 0f)
        var total = 0f

        for (layer in 0 .. LayerSlots - 1) {
            val weight = Weight(layer)

            if (weight > 0f) {
                val contribution = Contribution(layer, weight, peak)

                if (contribution > 0f) {
                    colour = colour + LayerAlbedo(layer).rgb * contribution
                    total = total + contribution
                }
            }
        }

        // Normalised rather than assumed to sum to one. The weights do sum to one at a *sample*, and
        // a fragment is a bilinear blend of four of them, which also sums to one — but a
        // non-weight-blended layer is excluded from that sum by design, and a height blend narrows
        // the set further, so the total is the honest divisor. Dividing by a constant would darken
        // wherever snow lies and wherever two grounds meet.
        return colour / max(total, 0.001f)
    }

    /// One layer's albedo at this fragment, at its own world scale.
    func LayerAlbedo(layer: int): float4 {
        return layerMaps[layer].Sample(layerSampler, LayerUv(layer))
    }

    /// The blend height a height-blended layer reads, from its surface texture's alpha.
    func LayerHeight(layer: int): float {
        return surfaceMaps[layer].Sample(layerSampler, LayerUv(layer)).a
    }

    /// Where in a layer's own texture this fragment lands.
    ///
    /// World XZ over the layer's tiling in metres. Metres of world rather than repeats per terrain,
    /// because repeats-per-terrain is the spelling that makes a layer stop being reusable — and it
    /// is the mistake in Unreal's own quick-start troubleshooting section.
    func LayerUv(layer: int): float2 {
        val scale = max(layerScales[layer], 0.001f)

        return float2(positionWS.x, positionWS.z) / scale
    }

    /// How much of a layer reaches the fragment, after its own blend mode has had its say.
    ///
    /// `docs/plan/31 § D6`'s three modes. Weight is the painted weight and nothing else. Height adds
    /// the layer's own relief to the comparison, so gravel shows through mud in its cracks rather
    /// than cross-fading with it — the contrast is how wide the transition is, and a narrow one is a
    /// hard edge that follows the texture. Alpha gates the layer by its albedo's alpha, which is what
    /// lets a layer have holes in it.
    func Contribution(layer: int, weight: float, peak: float): float {
        val mode = layerBlends[layer].x
        val contrast = max(layerBlends[layer].y, 0.001f)

        if (mode > 1.5f) {
            return weight * LayerAlbedo(layer).a
        }

        if (mode > 0.5f) {
            // How far below the highest contender this layer sits, in the same units the heights are
            // in. Zero at the winner and one contrast-width below it at the point it stops
            // contributing at all — a smoothstep rather than a step, so the boundary has a pixel or
            // two to resolve in and does not alias.
            val above = LayerHeight(layer) + weight - peak + contrast

            return weight * saturate(above / contrast)
        }

        return weight
    }

    /// Whether the terrain has no surface at a sample coordinate.
    ///
    /// ⚠ **`> 0.5` rather than `> 0`, because a hole's edge is a decision and not a gradient.** A
    /// bilinear tap halfway between a hole and its neighbour is 0.5 either way; a threshold anywhere
    /// else makes the cave mouth one texel wider on one side of the terrain than the other, which
    /// reads as the hole being in slightly the wrong place rather than as a filtering choice.
    func Hole(sample: float2): bool {
        return holeMap.SampleLevel(holeSampler, AtlasUv(sample), 0f).r > 0.5f
    }

    /// One layer's weight at a fragment, out of the weightmap that holds it.
    ///
    /// ⚠ **`SampleGrad` with derivatives taken from the *packed* coordinate, not `Sample`.** An
    /// atlas coordinate jumps by a whole block at every tile boundary, so the hardware's own
    /// derivative there is enormous and it picks the coarsest level it has — which draws as a dark
    /// line one pixel wide along every tile edge, on every terrain, and reads as a crack in the mesh.
    /// The packed coordinate is continuous, and inside a block the atlas map is that coordinate
    /// translated, so its derivative is the right one everywhere including across the seam.
    func Weight(layer: int): float {
        val duv = float2(1f, 1f) / heightMapSize
        val texel = weightMaps[layer / 4].SampleGrad(
            weightSampler,
            AtlasUv(sampleCoord),
            ddx(sampleCoord) * duv,
            ddy(sampleCoord) * duv
        )
        val channel = layer % 4

        if (channel == 0) {
            return texel.r
        }

        if (channel == 1) {
            return texel.g
        }

        if (channel == 2) {
            return texel.b
        }

        return texel.a
    }

    [FragmentShader]
    [Semantic("SV_Target")]
    func Fragment(): float4 {
        // ⚠ Discarded here rather than dropped from the index buffer, and the two are not the same
        // fix. Dropping the quad is what the *collider* does, because a shape is built once per tile
        // and can afford to be rebuilt; the draw is one instanced call over a shared lattice, so
        // punching a hole in it would mean a per-tile index buffer and the end of `docs/plan/31 § D3`'s
        // one draw call. A discard costs the fragment and keeps the claim.
        //
        // ⚠ And the surface still has to *exist* underneath — `TerrainSurface` answers a miss over a
        // missing quad and so does `GrassScatter.rvn`, so a blade does not grow in the mouth of a
        // cave. This is the third of the three places that have to agree.
        if (Hole(sampleCoord)) {
            discard
        }

        val normal = Math.SafeNormalize(normalWS)
        val light = saturate(dot(normal, Math.SafeNormalize(float3(0.4f, 0.8f, 0.3f))))

        // A directional term and nothing else. The lit path is `ForwardPlus`'s and composing it here
        // would make this shader carry a material's whole feature chain; what this file is for is the
        // geometry — the morph, the heightfield read and the splat — and `docs/plan/31 § T2` puts the
        // generated material's shading above it.
        return float4(Albedo() * (0.25f + 0.75f * light), 1f)
    }
}
