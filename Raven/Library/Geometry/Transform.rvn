package Vixen.Shaders.Geometry

import Vixen.Shaders.Core

// Object → world → view → clip, and the inverses a screen-space pass needs.
//
// `Math` has the primitive matrix applications; this file is about the *spaces* and the order they
// compose in. Matrix-first throughout (docs/plan/07 § E), and every function names the space it
// produces, because a transform applied in the wrong space compiles and renders something plausible.

/// One object's object-to-world matrix, as a record of a buffer the whole frame shares.
///
/// The alternative to pushing the matrix per draw, and the reason it exists is not bandwidth: a push
/// constant is *per draw*, so a pass that pushes one cannot merge two draws into one command. Here the
/// matrix is at the object's own slot and the draw carries the slot in `firstInstance`, which the API
/// adds into `SV_InstanceID` before the vertex stage runs — the same mechanism instancing uses, with a
/// run of one.
///
/// A struct of one member rather than a bare `Buffer<mat4>` so the layout is stated where a host can
/// read it: sixty-four bytes, column-major, exactly the bytes `Matrix4x4` already holds.
struct ObjectTransform {
    var world: mat4
}

/// The per-object scalars a shading pass needs and cannot get from a per-draw block.
///
/// Sixteen bytes at the object's own slot, addressed the same way `ObjectTransform` is — by the
/// instance index the draw carries. It exists because the clustered path binds no per-draw set at
/// all, so anything genuinely per object has to arrive some other way.
struct ObjectRecord {
    /// Which of the bound probe cubes reaches this object, or zero for none.
    var probeIndex: int

    /// How much of that probe shows through, against the environment behind it.
    var probeWeight: float

    /// How many entries of the object's light list are filled. Unread when clustering is on.
    var lightCount: int

    /// Padding to sixteen, so the record's stride is the same in std430 and in the host's struct.
    var reserved: int
}

struct Transform {
    /// Object space to clip space, in one multiply per stage.
    static func ObjectToClip(worldViewProjection: mat4, position: float3): float4 {
        return worldViewProjection * float4(position, 1f)
    }

    /// Object space to world space.
    static func ObjectToWorld(world: mat4, position: float3): float3 => Math.TransformPoint(world, position)

    /// World space to view space.
    static func WorldToView(view: mat4, position: float3): float3 => Math.TransformPoint(view, position)

    /// Clip space to normalised device coordinates, by perspective divide.
    static func ClipToNdc(clip: float4): float3 => Math.ClipToNdc(clip)

    /// Normalised device coordinates to a UV, with the origin top-left.
    ///
    /// ⚠ **The negation is the whole content of this function, and it used not to be there.** The
    /// comment that stood here argued that Vulkan's NDC has y down and a UV has y down, so the two
    /// agree and no flip is needed. The premise is false for this engine: a shader never sees
    /// Vulkan-native NDC. The projection is built y-up (`Matrix4x4.PerspectiveFieldOfView` puts a
    /// positive `height` at m22) and the backend submits a **negative-height viewport** to land it —
    /// see `VulkanCommandList.SetViewport`. So in clip space as a shader writes it, `y = +1` is the
    /// *top* of the screen, while a sampled texture's `v = 0` is its first row, which is also the top.
    /// `+1 → 0` is a negation.
    ///
    /// Without it every full-screen pass samples its source upside down, and the whole frame is
    /// mirrored vertically — the floor at the top of the window and the character hanging from it.
    /// That went unseen for a long time because nothing was running the post chain: `FullScreenRenderer`
    /// declined to draw when the compositor builder had no shader modules, and nothing gave it any.
    static func NdcToUv(ndc: float3): float2 => float2(ndc.x, -ndc.y) * 0.5f + 0.5f

    /// A UV back to normalised device coordinates, the inverse of `NdcToUv`.
    static func UvToNdc(uv: float2): float2 => float2(uv.x, 1f - uv.y) * 2f - 1f

    /// Reconstructs a view-space position from a depth buffer sample.
    ///
    /// The workhorse of every screen-space effect — SSAO, SSR, fog, decals all start here. Takes the
    /// inverse projection rather than deriving it: a shader cannot invert a matrix cheaply, and the
    /// host already has it.
    static func UvDepthToView(inverseProjection: mat4, uv: float2, deviceDepth: float): float3 {
        val ndc = UvToNdc(uv)
        val clip = inverseProjection * float4(ndc.x, ndc.y, deviceDepth, 1f)
        return clip.xyz / max(clip.w, Const.Epsilon)
    }

    /// Reconstructs a world-space position from a depth buffer sample.
    static func UvDepthToWorld(inverseViewProjection: mat4, uv: float2, deviceDepth: float): float3 {
        val ndc = UvToNdc(uv)
        val clip = inverseViewProjection * float4(ndc.x, ndc.y, deviceDepth, 1f)
        return clip.xyz / max(clip.w, Const.Epsilon)
    }

    /// Linear view-space depth from a device depth value, for a reverse-Z perspective projection.
    ///
    /// Reverse-Z is the engine's convention (§ E): near maps to 1 and far to 0, which is what gives a
    /// float depth buffer its precision where precision matters. That inverts the usual formula, so
    /// using the textbook one here produces depths that are wrong in a way that looks like a
    /// near-plane problem.
    static func LinearizeReverseZ(deviceDepth: float, near: float, far: float): float {
        return near * far / max(near + deviceDepth * (far - near), Const.Epsilon)
    }

    /// The view-space ray through a pixel, for a perspective camera.
    ///
    /// Unnormalised on purpose: scaled by the distance in front of the camera it gives the position
    /// directly, which is cheaper than the full inverse-projection multiply when a pass already has
    /// linear depth.
    ///
    /// **It points down −Z, because the engine's view space is right-handed.** `Matrix4x4.LookAt`
    /// says so in as many words — the camera looks down −Z and its +Z axis points back at the viewer
    /// — and `PerspectiveFieldOfView` agrees, taking `w` from `-z`. This returned `+1` and every
    /// consumer inherited it: a cluster's box came out mirrored in z from the light positions tested
    /// against it, so nearly nothing intersected and the clustered path lit a scene with the sun
    /// alone. A handedness mistake produces an empty result rather than a wrong-looking one, which is
    /// why it survived being written down twice.
    static func ViewRay(uv: float2, tanHalfFov: float2): float3 {
        val ndc = UvToNdc(uv)
        return float3(ndc.x * tanHalfFov.x, ndc.y * tanHalfFov.y, -1f)
    }

    /// The previous frame's UV for this pixel, for temporal reprojection.
    ///
    /// TAA, motion blur and temporal upscaling all need it. Takes a matrix that maps this frame's
    /// world space to the previous frame's clip space, which the host composes — doing it as two
    /// multiplies here would be the same arithmetic done per pixel instead of per frame.
    static func Reproject(previousViewProjection: mat4, worldPosition: float3): float2 {
        val clip = previousViewProjection * float4(worldPosition, 1f)
        return NdcToUv(clip.xyz / max(clip.w, Const.Epsilon))
    }
}
