package Vixen.Shaders.PostFx

import Vixen.Shaders.Core

// The dual-filter bloom chain: one shader, four modes, run once per mip in each direction.
//
// Bloom is a downsample chain followed by an upsample chain that adds each level back. Doing it with mips
// rather than one wide blur is what makes it cheap *and* wide: each level halves the resolution, so a
// bloom spanning a quarter of the screen costs about a third more than the first level alone.
//
// The two filters are Jimenez's, not box filters, and that matters. The 13-tap downsample and the 9-tap
// tent upsample are chosen so the chain does not alias as it shrinks — a box downsample makes bright
// pixels flicker as they move, which is the artefact that makes naive bloom unusable in motion.
//
// One shader with a `[Permutation]` mode rather than four shaders: the host runs the same pipeline with
// a different variant per pass, and the four share the prefilter constants.

shader Bloom {
    /// 0 prefilter (threshold the source), 1 first downsample, 2 downsample, 3 upsample-and-combine.
    ///
    /// The first downsample is a mode of its own because it is the only pass whose taps are
    /// Karis-averaged, and nothing else here would tell it from the rest of the chain. A fourth value
    /// rather than a second permutation: the chain asks for four variants either way, and a
    /// `FirstDownsample` flag that can only ever be true in one mode is a key every pass would carry
    /// in order to say nothing.
    ///
    /// Defaulting to the first downsample rather than the plain one because reflection describes a
    /// single variant, and this is the variant whose code is a superset of the other's.
    [Permutation] val Mode: int = 1

    /// Whether the first downsample Karis-averages its taps, which stops highlight flicker.
    ///
    /// The weight belongs to that pass and to no other. It makes the 13 taps a *weighted* average —
    /// `1 / (1 + luma)` per tap, before summing — so a highlight sitting in one texel is pulled
    /// towards its neighbours instead of dragging the whole kernel up with it, and stops flickering as
    /// it crosses a texel boundary. That is why it is not in `Prefilter()`, which takes one tap: on a
    /// single sample the weight is not an average at all, only a darkening. And it is not further down
    /// the chain because every level below the first has already been averaged, so applying it again
    /// buys no stability and costs brightness.
    [Permutation] val KarisAverage: bool = true

    var source: Texture2D
    var sourceSampler: Sampler

    /// The previous (larger) mip, for the upsample pass to add into.
    var previous: Texture2D

    var texelSize: float2 = float2(0.001f, 0.001f)

    /// Luminance above which a pixel contributes, with a soft knee below it.
    var threshold: float = 1f
    var knee: float = 0.5f

    /// Upsample radius in texels, which controls how wide the bloom spreads.
    var filterRadius: float = 1f

    /// How much of this level to add on the way up.
    var intensity: float = 1f

    stream var uv: float2

    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex([Semantic("SV_VertexID")] vertexIndex: int): float4 {
        uv = Fullscreen.Uv(vertexIndex)
        return Fullscreen.Position(vertexIndex)
    }

    [PixelShader]
    [Semantic("SV_Target")]
    func Pixel(): float4 {
        if (Mode == 0) {
            return float4(Prefilter(), 1f)
        }

        if (Mode == 3) {
            return float4(Upsample(), 1f)
        }

        // Modes 1 and 2 are the same filter. What differs is whether `Tap()` weights, which is the
        // whole reason the first downsample is a mode rather than a branch on something.
        return float4(Downsample(), 1f)
    }

    /// Keeps what is above the threshold, with a quadratic knee below it.
    ///
    /// A hard threshold makes bloom pop in and out as a highlight's luminance crosses it, which is
    /// obvious in motion. The knee is what turns that into a fade.
    func Prefilter(): float3 {
        val color = source.Sample(sourceSampler, uv).rgb
        val luma = Fullscreen.Luminance(color)

        val soft = clamp(luma - threshold + knee, 0f, 2f * knee)
        val contribution = max(soft * soft / max(4f * knee, Const.Epsilon), luma - threshold)
        return color * (contribution / max(luma, Const.Epsilon))
    }

    /// Jimenez's 13-tap downsample: a centre box plus four corner boxes, overlapping.
    ///
    /// The overlap is the point — it is a 4×4 filter built from 2×2 bilinear taps, so it costs 13
    /// samples instead of 16 and its kernel has no zeros to alias through.
    func Downsample(): float3 {
        val d = texelSize

        val a = Tap(-d.x * 2f, d.y * 2f)
        val b = Tap(0f, d.y * 2f)
        val c = Tap(d.x * 2f, d.y * 2f)
        val e = Tap(-d.x * 2f, 0f)
        val f = Tap(0f, 0f)
        val g = Tap(d.x * 2f, 0f)
        val h = Tap(-d.x * 2f, -d.y * 2f)
        val i = Tap(0f, -d.y * 2f)
        val j = Tap(d.x * 2f, -d.y * 2f)

        val k = Tap(-d.x, d.y)
        val l = Tap(d.x, d.y)
        val m = Tap(-d.x, -d.y)
        val n = Tap(d.x, -d.y)

        // The inner four boxes carry half the weight between them; the outer nine share the rest.
        var total = (k + l + m + n) * 0.125f
        total += f * 0.125f
        total += (a + c + h + j) * 0.03125f
        total += (b + e + g + i) * 0.0625f
        return total
    }

    /// A 9-tap tent filter, which is what makes the upsampled level smooth rather than blocky.
    func Upsample(): float3 {
        val d = texelSize * filterRadius

        var total = Tap(-d.x, d.y) * 1f + Tap(0f, d.y) * 2f + Tap(d.x, d.y) * 1f
        total += Tap(-d.x, 0f) * 2f + Tap(0f, 0f) * 4f + Tap(d.x, 0f) * 2f
        total += Tap(-d.x, -d.y) * 1f + Tap(0f, -d.y) * 2f + Tap(d.x, -d.y) * 1f
        total = total / 16f

        return previous.Sample(sourceSampler, uv).rgb + total * intensity
    }

    /// One source tap at a texel offset, Karis-weighted on the first downsample.
    func Tap(offsetX: float, offsetY: float): float3 {
        val color = source.Sample(sourceSampler, uv + float2(offsetX, offsetY)).rgb
        return KarisAverage && Mode == 1 ? color * Fullscreen.KarisWeight(color) : color
    }
}
