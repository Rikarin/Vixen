package Vixen.Shaders.PostFx

import Vixen.Shaders.Core
import Vixen.Shaders.Geometry

// Tonemapping and colour grading: the last pass before the swapchain.
//
// The pass that turns scene-referred HDR radiance into display-referred colour, and the order of
// operations in it is not arbitrary:
//
//   exposure → white balance → grade → tonemap → LUT → transfer function
//
// Exposure first because everything downstream is authored against a nominal mid-grey, so 0.18 means
// middle grey from here on and every constant below can say so.
//
// ⚠ **The grade is before the curve, and it used to be after.** Unreal grades in scene-referred linear
// and calls display-referred lookup tables legacy; HDRP bakes its whole grading chain into a
// log-encoded table, which is the same claim. Grading after the curve means the same grade produces a
// different picture in SDR and HDR output, because the curve that preceded it was a different curve.
// What survives from the old order is the argument for the *table*: a LUT is authored against
// display-referred values and stays where it was, as a final trim. See docs/plan/30.
//
// The transfer function is dead last, because every step before it is linear-light.

shader Tonemap {
    /// 0 Reinhard, 1 ACES, 2 AgX, 3 filmic (Hable), 4 none (clamp only).
    [Permutation] val Operator: int = 1

    /// Whether to apply a 3D grading LUT after the curve.
    [Permutation] val UseLut: bool = false

    /// Whether to encode sRGB in the shader. Off is correct when the swapchain is an _SRGB format.
    [Permutation] val EncodeSrgb: bool = false

    /// Whether the exposure comes from `AutoExposure`'s buffer rather than from `exposure`.
    ///
    /// A permutation rather than a uniform, for the reason `UseLut` is one: off, the binding and the
    /// load fold out of the variant entirely, so a frame with an authored exposure declares no buffer
    /// and binds none. It is also what makes this additive — every consumer that existed before this
    /// permutation compiles to the variant it already compiled to.
    [Permutation] val UseExposureBuffer: bool = false

    /// Whether the bloom pyramid is added to the scene before the curve.
    ///
    /// ⚠ Here rather than in a compositing pass of its own, and the reason is what bloom *is*: light
    /// that the lens spread across the image, which is scene-referred and belongs in the sum before
    /// exposure and before the curve. Added after the tonemap it would be a bright fringe painted on
    /// a graded image — it could not blow out, and a highlight already at white would gain a halo
    /// that is somehow brighter than the thing making it.
    ///
    /// It also removes the reason a frame needed an additive-resolve node it does not have. `Bloom`
    /// publishes the *pyramid* — the part of the image above its threshold, blurred — and nothing
    /// composites it; a document that tonemapped that pyramid instead of the scene got a black
    /// screen, which is a mistake this permutation makes unavailable.
    [Permutation] val UseBloom: bool = false

    var source: Texture2D
    var sourceSampler: Sampler
    var lut: Texture3D
    var lutSampler: Sampler

    /// The blurred highlights, in the source's own units. Read only when `UseBloom`.
    var bloom: Texture2D
    var bloomSampler: Sampler

    /// How much of the pyramid reaches the image. A fraction: bloom is spill, not a second exposure.
    var bloomIntensity: float = 0.2f

    /// What colour the spill is, which is the coating on the lens rather than the light.
    var bloomTint: float3 = float3(1f, 1f, 1f)

    /// Dust and smears on the front element, brightening the bloom where they are. Read with `UseBloom`.
    var bloomDirt: Texture2D
    var bloomDirtSampler: Sampler

    /// How much the dirt brightens the bloom. Zero is a clean lens, which is the default.
    ///
    /// ⚠ It multiplies the *bloom*, not the image. Dirt is only visible because bright light scatters
    /// off it, which is why a dirty lens shows nothing in an evenly lit room and streaks across the
    /// frame when you point it at the sun. Added to the image instead, it would be a decal.
    var bloomDirtIntensity: float = 0f

    /// Linear exposure multiplier, when it is authored rather than measured.
    var exposure: float = 1f

    /// What `AutoExposure` left for this frame. One element, read only when `UseExposureBuffer`.
    ///
    /// ⚠ Read here rather than copied in by the host, which is the whole reason the auto-exposure
    /// pass is compute: the value is produced on the device and consumed on the device. A host that
    /// read it back to put it in the block above would pay a stall and a frame of latency for a
    /// number it never looks at.
    var exposureBuffer: Buffer<float>

    var whitePoint: float = 4f
    var contrast: float = 1f
    var saturation: float = 1f

    /// The per-channel scale that makes the scene's illuminant render white.
    ///
    /// ⚠ Computed on the host by `Photometry.WhiteBalance`, which is the *inverse* of the black-body
    /// curve `Photometry.FromTemperature` gives a light — so a lamp declaring 3200 K and a grade
    /// balancing to 3200 K cancel exactly. A fit of the Planckian locus written again here would
    /// nearly cancel, and a scene that is nearly neutral is worse than one that is obviously wrong.
    var whiteBalance: float3 = float3(1f, 1f, 1f)

    /// Multiplied into the scene before anything else grades it, which is what a filter on a lens is.
    var colorFilter: float3 = float3(1f, 1f, 1f)

    /// Hue rotation in radians, applied as a matrix rather than through HSV.
    ///
    /// HSV is defined on values in 0..1 and this runs on scene-referred light, where a specular
    /// highlight is legitimately 40. A YIQ rotation is linear, so it is the same rotation at every
    /// magnitude — and it cannot produce the negative saturation an out-of-range HSV round trip does.
    var hueShift: float = 0f

    var shadowTint: float3 = float3(1f, 1f, 1f)
    var highlightTint: float3 = float3(1f, 1f, 1f)

    /// Where split toning crosses over, -1 towards shadows and 1 towards highlights.
    var splitBalance: float = 0f

    /// Whether the four-range CDL grade runs. Off, none of its constants are read.
    [Permutation] val UseColorGrading: bool = false

    /// Saturation, contrast, gamma, gain and offset — Unreal's decomposition, per tonal range.
    ///
    /// The American Society of Cinematographers' colour decision list, which is what a grading suite
    /// exports and therefore what a grade written anywhere else can be carried in as. Global applies
    /// everywhere and the three ranges apply over it, weighted by luminance.
    ///
    /// ⚠ Applied *before* the tonemap, on scene-referred light, so `gamma` is a power on unbounded
    /// values and 1 means "leave it alone" rather than "display gamma". Every one of these defaults to
    /// its identity, so the permutation being on with nothing authored is the same picture.
    var gradeGlobalSaturation: float = 1f
    var gradeGlobalContrast: float = 1f
    var gradeGlobalGamma: float3 = float3(1f, 1f, 1f)
    var gradeGlobalGain: float3 = float3(1f, 1f, 1f)
    var gradeGlobalOffset: float3 = float3(0f, 0f, 0f)

    var gradeShadowSaturation: float = 1f
    var gradeShadowContrast: float = 1f
    var gradeShadowGamma: float3 = float3(1f, 1f, 1f)
    var gradeShadowGain: float3 = float3(1f, 1f, 1f)
    var gradeShadowOffset: float3 = float3(0f, 0f, 0f)

    var gradeMidtoneSaturation: float = 1f
    var gradeMidtoneContrast: float = 1f
    var gradeMidtoneGamma: float3 = float3(1f, 1f, 1f)
    var gradeMidtoneGain: float3 = float3(1f, 1f, 1f)
    var gradeMidtoneOffset: float3 = float3(0f, 0f, 0f)

    var gradeHighlightSaturation: float = 1f
    var gradeHighlightContrast: float = 1f
    var gradeHighlightGamma: float3 = float3(1f, 1f, 1f)
    var gradeHighlightGain: float3 = float3(1f, 1f, 1f)
    var gradeHighlightOffset: float3 = float3(0f, 0f, 0f)

    /// Where the shadow range stops contributing, in exposure-normalised luminance.
    var gradeShadowsMax: float = 0.09f

    /// Where the highlight range starts contributing.
    var gradeHighlightsMin: float = 0.5f

    /// The six constants of Hable's filmic curve, read when `Operator` is 3.
    ///
    /// Defaulted to the values published with Uncharted 2, so the operator means what its name says
    /// before anybody touches it. Exposed because the whole reason to choose this curve over ACES is
    /// to shape the toe and the shoulder yourself.
    var filmicShoulderStrength: float = 0.15f
    var filmicLinearStrength: float = 0.50f
    var filmicLinearAngle: float = 0.10f
    var filmicToeStrength: float = 0.20f
    var filmicToeNumerator: float = 0.02f
    var filmicToeDenominator: float = 0.30f

    /// LUT edge size in texels, needed to compute the half-texel inset.
    var lutSize: float = 32f

    stream var uv: float2

    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex([Semantic("SV_VertexID")] vertexIndex: int): float4 {
        uv = Fullscreen.Uv(vertexIndex)
        return Fullscreen.Position(vertexIndex)
    }

    [FragmentShader]
    [Semantic("SV_Target")]
    func Fragment(): float4 {
        val scale = UseExposureBuffer ? exposureBuffer[0] : exposure
        var radiance = source.Sample(sourceSampler, uv).rgb

        // Before the exposure multiply, because the pyramid is in the scene's units — it was built
        // from this same texture. Exposing the two separately would make the glow's brightness depend
        // on the exposure twice.
        if (UseBloom) {
            var spill = bloom.Sample(bloomSampler, uv).rgb * bloomIntensity * bloomTint
            spill = spill * (1f + bloomDirt.Sample(bloomDirtSampler, uv).rgb * bloomDirtIntensity)
            radiance += spill
        }

        var color = radiance * scale * whiteBalance
        color = Grade(color)

        if (UseColorGrading) {
            color = ColorDecisionList(color)
        }

        color = Curve(color)

        if (UseLut) {
            color = ApplyLut(color)
        }

        if (EncodeSrgb) {
            color = ColorSpaces.LinearToSrgb(color)
        }

        return float4(color, 1f)
    }

    /// The tonemapping curve itself.
    func Curve(color: float3): float3 {
        if (Operator == 0) {
            return ColorSpaces.ReinhardExtended(color, whitePoint)
        }

        if (Operator == 1) {
            return ColorSpaces.AcesFilmic(color)
        }

        if (Operator == 2) {
            return ColorSpaces.AgX(color)
        }

        if (Operator == 3) {
            return Filmic(color)
        }

        return saturate(color)
    }

    /// Hable's filmic curve, normalised so `whitePoint` comes out at one.
    ///
    /// The rational function Uncharted 2 shipped: a toe, a linear section and a shoulder, each with
    /// its own constant, which is why it is the curve people reach for when ACES is close but not
    /// what they wanted. It is evaluated twice — once on the colour and once on the white point —
    /// because without the second evaluation the curve's own asymptote decides where white is, and
    /// that moves whenever any of the six constants does.
    func Filmic(color: float3): float3 {
        val white = FilmicCurve(float3(max(whitePoint, 0.001f)))
        return FilmicCurve(max(color, float3(0f))) / max(white, float3(0.0001f))
    }

    func FilmicCurve(x: float3): float3 {
        val a = filmicShoulderStrength
        val b = filmicLinearStrength
        val c = filmicLinearAngle
        val d = filmicToeStrength
        val e = filmicToeNumerator
        val f = max(filmicToeDenominator, 0.0001f)

        return ((x * (a * x + c * b) + d * e) / (x * (a * x + b) + d * f)) - e / f
    }

    /// Colour filter, hue, contrast, saturation and split toning, on scene-referred light.
    ///
    /// ⚠ Every constant here is in the domain the exposure left behind, where 0.18 is middle grey and
    /// 1 is nominal white — *not* the 0..1 of a display. That is why the contrast pivots around 0.18
    /// in log space rather than around 0.5 linearly: a linear pivot at 0.5 on unbounded light crushes
    /// everything below it to black and sends everything above it to tens of thousands.
    func Grade(color: float3): float3 {
        // A filter on a lens, which is a multiply and belongs before anything that reshapes tone.
        var result = max(color * colorFilter, float3(0f))

        if (hueShift != 0f) {
            result = RotateHue(result, hueShift)
        }

        // Contrast about middle grey, in log space. Exponent form rather than `pow`, because the
        // input is unbounded and `log2` of it is not.
        val grey = 0.18f
        val logGrey = log2(grey)
        result = exp2((log2(max(result, float3(0.0001f))) - logGrey) * contrast + logGrey)

        val luma = ColorSpaces.Luminance(result)
        result = max(lerp(float3(luma), result, max(saturation, 0f)), float3(0f))

        // Split toning: shadows and highlights tinted separately, blended by luminance. The
        // smoothstep rather than a linear blend keeps mid-tones neutral, which is the whole point,
        // and `splitBalance` moves where the crossover sits.
        //
        // Saturated, because the blend needs a 0..1 position and scene light has no upper bound —
        // everything above nominal white is a highlight and there is nothing more to say about it.
        val position = saturate(luma)
        val pivot = saturate(0.5f - splitBalance * 0.5f)
        val split = smoothstep(max(pivot - 0.3f, 0f), min(pivot + 0.3f, 1f), position)

        return result * lerp(shadowTint, highlightTint, split)
    }

    /// The four-range CDL grade, weighted by luminance.
    ///
    /// Global first and everywhere, then the three ranges blended over it. The weights are a partition
    /// — they sum to one at every luminance — so a grade that sets all three ranges to the same values
    /// is the same as setting global to them, which is the property that makes the decomposition
    /// usable rather than four things fighting.
    func ColorDecisionList(color: float3): float3 {
        var result = ApplyRange(
            color, gradeGlobalSaturation, gradeGlobalContrast, gradeGlobalGamma, gradeGlobalGain,
            gradeGlobalOffset
        )

        val luma = saturate(ColorSpaces.Luminance(result))

        val shadows = 1f - smoothstep(0f, max(gradeShadowsMax, Const.Epsilon), luma)
        val highlights = smoothstep(min(gradeHighlightsMin, 1f - Const.Epsilon), 1f, luma)
        val midtones = max(1f - shadows - highlights, 0f)

        var graded = ApplyRange(
            result, gradeShadowSaturation, gradeShadowContrast, gradeShadowGamma, gradeShadowGain,
            gradeShadowOffset
        ) * shadows

        graded += ApplyRange(
            result, gradeMidtoneSaturation, gradeMidtoneContrast, gradeMidtoneGamma, gradeMidtoneGain,
            gradeMidtoneOffset
        ) * midtones

        graded += ApplyRange(
            result, gradeHighlightSaturation, gradeHighlightContrast, gradeHighlightGamma,
            gradeHighlightGain, gradeHighlightOffset
        ) * highlights

        return graded
    }

    /// One range's five operations, in the order the decision list defines them.
    ///
    /// ⚠ Saturation, then contrast, then the slope-offset-power triple — and that order is the
    /// standard rather than a preference. Two suites applying the same numbers in different orders
    /// produce different pictures, which is the whole thing an interchange format exists to prevent.
    func ApplyRange(
        color: float3,
        saturationAmount: float,
        contrastAmount: float,
        gamma: float3,
        gain: float3,
        offset: float3
    ): float3 {
        val luma = ColorSpaces.Luminance(color)
        var result = max(lerp(float3(luma), color, max(saturationAmount, 0f)), float3(0f))

        val logGrey = log2(0.18f)
        result = exp2((log2(max(result, float3(0.0001f))) - logGrey) * contrastAmount + logGrey)

        result = pow(max(result * gain + offset, float3(0f)), max(gamma, float3(0.0001f)))
        return result
    }

    /// A hue rotation, as a matrix through YIQ.
    ///
    /// Luminance is preserved exactly because Y is untouched, which is the property that makes this
    /// safe to do before the tonemap: a hue shift that changed brightness would change the exposure.
    func RotateHue(color: float3, radians: float): float3 {
        val c = cos(radians)
        val s = sin(radians)

        val y = dot(color, float3(0.299f, 0.587f, 0.114f))
        val i = dot(color, float3(0.595716f, -0.274453f, -0.321263f))
        val q = dot(color, float3(0.211456f, -0.522591f, 0.311135f))

        val ri = i * c - q * s
        val rq = i * s + q * c

        return float3(
            y + 0.9563f * ri + 0.6210f * rq,
            y - 0.2721f * ri - 0.6474f * rq,
            y - 1.1070f * ri + 1.7046f * rq
        )
    }

    /// Samples a 3D grading LUT with the half-texel inset a linear-filtered LUT needs.
    ///
    /// Without the inset the first and last slices are sampled beyond their centres, so the darkest
    /// and brightest values are wrong — visible as a colour shift in exactly the regions people check.
    func ApplyLut(color: float3): float3 {
        val scale = (lutSize - 1f) / lutSize
        val offset = 0.5f / lutSize
        return lut.Sample(lutSampler, saturate(color) * scale + offset).rgb
    }
}
