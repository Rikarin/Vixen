package Vixen.Shaders.PostFx

import Vixen.Shaders.Core
import Vixen.Shaders.Geometry

// Linear, exponential and height fog, applied from depth.
//
// A fullscreen pass rather than per-material, which is the right place for it: fog depends only on depth
// and view direction, so computing it once per pixel beats computing it in every material shader — and it
// then applies to everything, including geometry whose shader never thought about fog.
//
// Exponential-squared is the default because it is what atmospheric scattering actually looks like: a
// linear ramp has a visible start plane, and plain exponential thins too slowly near the camera.

shader Fog {
    /// 0 linear, 1 exponential, 2 exponential-squared.
    [Permutation] val Mode: int = 2

    /// Whether density varies with height, for ground mist.
    [Permutation] val HeightFalloff: bool = true

    /// Whether to brighten fog toward the sun, which is what sells it as scattering.
    [Permutation] val SunScattering: bool = true

    /// Whether a froxel volume stands in for the analytic falloff, out to its own far plane.
    ///
    /// ⚠ **Not a replacement for the rest of this shader, and that is the point.** The volume covers
    /// sixty-four metres or so; the world does not stop there. Beyond its far plane the analytic
    /// falloff below still runs, over what the volume left — so a project that turns this on gets
    /// marched fog where the marching is worth doing and keeps a horizon that fades.
    [Permutation] val Volumetric: bool = false

    var source: Texture2D
    var depthBuffer: Texture2D
    var linearSampler: Sampler

    /// The integrated volume: accumulated in-scatter in `rgb`, surviving transmittance in `a`.
    ///
    /// `VolumetricFog`'s pass 2 wrote it. Read with a linear filter in all three axes, which is what
    /// makes a 64-slice grid look continuous rather than banded.
    var fogVolume: Texture3D

    var inverseViewProjection: mat4
    var cameraPosition: float3

    /// What the fog looks like away from the sun, **as a radiance in cd/m²**.
    ///
    /// ⚠ **A lerp target, therefore a radiance and not a tint.** `Fragment` ends in
    /// `lerp(color, tint, amount)` against a scene colour in cd/m², so whatever this is stands in for
    /// the surface once the fog is thick — and a unit-scale `(0.5, 0.6, 0.7)` in a frame lit at ninety
    /// thousand lux is not a pale grey veil, it is a lerp toward black. Distance did not haze, it
    /// faded out. The physical quantity is the medium's source function away from the forward peak,
    /// which for light arriving evenly from the whole sky is the sky's **mean radiance** — the
    /// environment's `L00 × Y₀ × Intensity`, and not `L00`, which is 4π·Y₀ = 3.54× too much sky.
    ///
    /// `FogRenderer.Colour` documents where a host gets one; the default here is a clear daylight sky
    /// and matches `VolumetricFog.ambientColour`, which is the same quantity for the marched half of
    /// the same medium.
    var fogColor: float3 = float3(1400f, 1680f, 2200f)

    var density: float = 0.02f

    /// Linear mode only.
    var fogStart: float = 10f
    var fogEnd: float = 200f

    /// Height at which density is at its authored value, and the rate it thins above that.
    ///
    /// The rate is `heightFalloffRate` rather than `heightFalloff` because the permutation above is
    /// already called that, and the two differ only in case — which Raven allows and a host language
    /// need not. The generated bindings turn both into one C# identifier, so the collision was a
    /// generated file that did not compile. Renaming it here says the difference out loud as well:
    /// the permutation is *whether* density thins with altitude, and this is *how fast*.
    var fogHeight: float = 0f
    var heightFalloffRate: float = 0.05f

    var sunDirection: float3 = float3(0f, -1f, 0f)

    /// What the fog looks like straight down-sun, **as a radiance in cd/m²** — and it is a *sum*.
    ///
    /// ⚠ **`fogColor` plus the sun's illuminance, not the sun's colour.** The blend below is
    /// `lerp(fogColor, sunColor, p)` where `p` is the phase function in sr⁻¹, so writing
    /// `sunColor = fogColor + E` makes the whole expression collapse to
    ///
    ///     tint = fogColor + p(θ)·E
    ///
    /// which is exactly the single-scattering source function of a medium lit by a sky of radiance
    /// `fogColor` and a directional light of illuminance `E` lux. That identity is the reason this is
    /// a sum and not a colour: `p` carries the per-steradian, `E` is what `RenderLight.Radiance`
    /// holds for a directional light, and the product is a radiance the frame can be composited with.
    /// A tint of `(1, 0.9, 0.7)` here was five decades under a sun of ninety thousand.
    ///
    /// The default is this file's `fogColor` plus `VolumetricFog.sunColour`'s clear-midday default,
    /// so the two fog nodes in one document describe one sun.
    var sunColor: float3 = float3(91400f, 82680f, 65200f)

    var sunAnisotropy: float = 0.7f

    /// The volume's own near and far, in view depth, and how many slices it cut between them.
    ///
    /// ⚠ The same three numbers `VolumetricFog` was dispatched with. A composite that reads the
    /// volume with a different `fogFar` samples the wrong slice for every pixel — a smooth, plausible
    /// fog that is wrong everywhere, which is this file's own recurring failure mode.
    var volumeNear: float = 0.5f
    var volumeFar: float = 64f
    var volumeSlices: float = 64f

    /// The camera's near and far, for turning a device depth into a view depth.
    var cameraNear: float = 0.1f
    var cameraFar: float = 1000f

    stream var uv: float2

    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex([Semantic("SV_VertexID")] vertexIndex: int): float4 {
        uv = Fullscreen.Uv(vertexIndex)
        return Fullscreen.Position(vertexIndex)
    }

    [FragmentShader]
    [Semantic("SV_Target")]
    func Fragment(): float4 {
        val color = source.Sample(linearSampler, uv).rgb
        val deviceDepth = depthBuffer.Sample(linearSampler, uv).r

        // The far plane is the sky, which the skybox already coloured — fogging it would double up.
        if (deviceDepth <= 0f) {
            return float4(color, 1f)
        }

        val world = Transform.UvDepthToWorld(inverseViewProjection, uv, deviceDepth)
        val toPixel = world - cameraPosition
        val distance = length(toPixel)

        if (Volumetric) {
            return float4(Composite(color, uv, deviceDepth, world, distance), 1f)
        }

        var amount = Amount(distance)

        if (HeightFalloff) {
            amount = amount * HeightDensity(world.y)
        }

        var tint = fogColor

        if (SunScattering) {
            // Henyey-Greenstein forward scattering: fog looks brighter looking toward the light. The
            // one term that distinguishes fog from a grey veil.
            //
            // ⚠ The weight is the phase function itself, in sr⁻¹, which is what makes the two colours
            // add rather than merely blend — see `sunColor`. `lerp(fogColor, fogColor + E, p)` is
            // `fogColor + p·E`, the source function, and that identity is the only reason a lerp is
            // the right operator here.
            val cosine = dot(Math.SafeNormalize(toPixel), Math.SafeNormalize(-sunDirection))
            tint = lerp(fogColor, sunColor, HenyeyGreenstein(cosine, sunAnisotropy))
        }

        return float4(lerp(color, tint, saturate(amount)), 1f)
    }

    /// The volume over the frame, with the analytic falloff carrying on past its far plane.
    ///
    /// Two composites in order, and the order is the physical one: the volume is what the first
    /// `volumeFar` metres did to the pixel, so it applies to the pixel; the analytic term is what the
    /// metres *beyond* that did, so it applies to the result. Running them the other way round would
    /// fog the volume's own in-scatter by distance it never travelled.
    ///
    /// ⚠ **The analytic term is measured from the volume's far plane, not from the camera.** Passing
    /// the whole distance would count the first sixty-four metres twice — once marched and once
    /// analytically — and the seam would be a bright ring at exactly the swap-over distance, which is
    /// the artefact this arrangement exists to avoid.
    func Composite(color: float3, uv: float2, deviceDepth: float, world: float3, distance: float): float3 {
        val toPixel = world - cameraPosition
        val viewDepth = Transform.LinearizeReverseZ(deviceDepth, cameraNear, cameraFar)

        // The grid's own Z distribution, inverted. Clamped to the last slice rather than left to run
        // off the end: a pixel beyond the volume reads the far face, which holds exactly what the
        // whole volume did to a ray that crossed all of it — which is the right answer to hand the
        // fallback below.
        val ratio = log(max(viewDepth, volumeNear) / volumeNear) / max(log(volumeFar / volumeNear), Const.Epsilon)
        val slice = clamp(ratio * volumeSlices, 0f, volumeSlices - 0.5f)

        // ⚠ `uv.y` is *not* flipped back. `Fullscreen.Uv` already put y down the screen, and
        // `FroxelGrid.Ray` was built from a grid uv with the same sense — so the two agree, and
        // negating here would light the top of the frame with the bottom's froxels.
        val volume = fogVolume.SampleLevel(linearSampler, float3(uv.x, uv.y, slice / volumeSlices), 0f)
        val marched = color * volume.a + volume.rgb

        // What is left of the ray once the volume has had it.
        val beyond = max(distance - volumeFar, 0f)

        if (beyond <= 0f) {
            return marched
        }

        var amount = Amount(beyond)

        if (HeightFalloff) {
            amount = amount * HeightDensity(world.y)
        }

        var tint = fogColor

        if (SunScattering) {
            val cosine = dot(Math.SafeNormalize(toPixel), Math.SafeNormalize(-sunDirection))
            tint = lerp(fogColor, sunColor, HenyeyGreenstein(cosine, sunAnisotropy))
        }

        return lerp(marched, tint, saturate(amount))
    }

    func Amount(distance: float): float {
        if (Mode == 0) {
            return saturate(Math.InverseLerp(fogStart, fogEnd, distance))
        }

        val d = distance * density

        if (Mode == 1) {
            return 1f - exp(-d)
        }

        return 1f - exp(-d * d)
    }

    /// Density relative to the fog plane, thinning exponentially with height.
    func HeightDensity(height: float): float {
        return exp(-max(height - fogHeight, 0f) * heightFalloffRate)
    }

    /// The Henyey-Greenstein phase function, in sr⁻¹, clamped at 1.
    ///
    /// ⚠ **The clamp is a highlight roll-off, not a normalisation.** The function's own peak at
    /// `g = 0.7` is 1.5 sr⁻¹, reached inside about eleven degrees of the sun; past 1 the blend stops
    /// tracking `fogColor + p·E` and holds at `fogColor + E`. That costs a third of the brightness in
    /// a narrow cone around the sun and buys a bound: `p(0)` runs to 62 sr⁻¹ at `g = 0.95`, and an
    /// unclamped multiply against an illuminance in the tens of thousands is a fireball wherever the
    /// sun happens to be behind the geometry.
    func HenyeyGreenstein(cosine: float, g: float): float {
        val g2 = g * g
        val denominator = 1f + g2 - 2f * g * cosine
        return saturate((1f - g2) / max(4f * Const.Pi * pow(max(denominator, Const.Epsilon), 1.5f), Const.Epsilon))
    }
}
