package Vixen.Shaders.PostFx

import Vixen.Shaders.Core

// SMAA 1x: subpixel morphological antialiasing, in three passes over one shader.
//
// FXAA guesses an edge's direction from one pixel's neighbourhood and blends along it, which is why it
// softens texture as readily as geometry. SMAA does the opposite: it finds the *whole* edge first, walks
// it to both ends, reads what crosses it there, and only then decides how much of the neighbour each
// pixel should take. A run of edge texels bounded by two crossings is a silhouette whose sub-pixel
// position is known exactly, and the coverage that follows from it is a table lookup rather than a guess.
//
// Three passes, because each needs the whole of the one before it:
//
//   Mode 0 — edge detection. Luminance discontinuities, as a two-channel mask: red is an edge on this
//            pixel's left boundary, green one on its top boundary.
//   Mode 1 — blending weights. For each edge, how far the run reaches either way, what crosses it at
//            the ends, and therefore how far across the boundary this pixel and its neighbour reach.
//   Mode 2 — neighbourhood blending. One bilinear tap placed by the weight, which is what makes the
//            blend cost a single sample rather than a filter.
//
// One shader with a `[Permutation]` mode rather than three, for `Bloom.rvn`'s reason: the host runs the
// same pipeline with a different variant per pass, and the three share the frame's texel size.
//
// ⚠ **The thresholds are relative, and that is not a refinement.** This frame is metered in cd/m² and a
// tonemapped one is not; an absolute contrast threshold means "every edge" in the first and "no edge" in
// the second, which is indistinguishable from a pass that never ran. Every luminance below is divided by
// the largest in the neighbourhood before anything is compared to a threshold, so scaling the whole frame
// changes nothing at all — which is what makes this node correct on either side of the tonemap.
//
// ⚠ **Diagonal pattern detection is not implemented.** The reference has a second, optional detector for
// silhouettes near 45°, with a coverage table of its own; without it those edges fall through to the
// orthogonal path, which handles them as the staircases they are — the reference's own
// `SMAA_DISABLE_DIAG_DETECTION` build. It is the one part of SMAA 1x this shader does not do.

shader Smaa {
    /// 0 edge detection, 1 blending weights, 2 neighbourhood blending.
    ///
    /// Zero rather than the widest variant, because unlike `Bloom.rvn` no mode here is a superset of
    /// another — and every binding is declared whatever the mode is, so reflection sees all of them
    /// from any of the three.
    [Permutation] val Mode: int = 0

    /// The frame being antialiased: mode 0 reads its luminance, mode 2 blends it.
    var source: Texture2D

    /// Mode 0's mask, read by mode 1.
    var edges: Texture2D

    /// Mode 1's weights, read by mode 2.
    var weights: Texture2D

    /// The coverage table, generated by `SmaaAreaTexture`.
    var area: Texture2D

    /// For the two blend taps and the table, both of which are read between texels on purpose.
    var linearSampler: Sampler

    /// For everything else. Every neighbourhood read below is at an exact texel, and a linear tap
    /// there averages two texels of an edge *mask* — which is a mask value that means nothing.
    var pointSampler: Sampler

    var texelSize: float2 = float2(0.001f, 0.001f)

    /// One texel of the coverage table.
    var areaTexelSize: float2 = float2(0.0125f, 0.0125f)

    /// How many of the table's texels one pattern block spans.
    var areaMaxDistance: float = 16f

    /// The relative local contrast a boundary needs before it is an edge, 0..1.
    ///
    /// A tenth is the reference's, and it means the same thing here because the luminances it is
    /// compared against have been divided by the neighbourhood's largest.
    var edgeThreshold: float = 0.1f

    /// How much steeper a neighbouring contrast may be before this edge is discarded as the flat side
    /// of something sharper.
    ///
    /// The local contrast adaptation, and it is what keeps SMAA off a gradient. A soft ramp has a
    /// small difference everywhere; a real silhouette has one that dominates its neighbours. An edge
    /// whose contrast is more than this factor below the steepest nearby is the ramp, not the
    /// silhouette.
    var contrastAdaptation: float = 2f

    /// The luminance below which the frame is treated as flat, in the frame's own units.
    ///
    /// The floor under the relative threshold above. Dividing by the neighbourhood's largest is
    /// scale-invariant, which is the point — and in a black neighbourhood it is also an amplifier
    /// with unbounded gain, so sensor noise a millionth of a nit becomes a full-contrast edge. This is
    /// what the divisor is clamped to.
    var lumaFloor: float = 0.0001f

    stream var uv: float2

    /// How far the weight pass walks along an edge before giving up.
    ///
    /// A silhouette longer than this is filtered as if it ended here, which is a slightly weaker blend
    /// on a very shallow edge and never a wrong one. The bound is what makes the walk a bounded loop:
    /// the reference walks two texels per step through a second lookup table that decodes a bilinear
    /// pair, which is the same answer at half the iterations and one more texture to generate.
    const val SearchSteps = 16

    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex([Semantic("SV_VertexID")] vertexIndex: int): float4 {
        uv = Fullscreen.Uv(vertexIndex)
        return Fullscreen.Position(vertexIndex)
    }

    [FragmentShader]
    [Semantic("SV_Target")]
    func Fragment(): float4 {
        if (Mode == 0) {
            val e = Detect()
            return float4(e.x, e.y, 0f, 1f)
        }

        if (Mode == 1) {
            return Weigh()
        }

        return Blend()
    }

    /// Mode 0: where the luminance steps, as a mask on the left and top boundaries.
    ///
    /// Two boundaries per pixel rather than four, because the other two are its neighbours' — a mask
    /// that recorded all four would say everything twice and the weight pass would have to pick.
    func Detect(): float2 {
        val centre = Luma(0, 0)
        val left = Luma(-1, 0)
        val top = Luma(0, -1)
        val right = Luma(1, 0)
        val bottom = Luma(0, 1)
        val leftLeft = Luma(-2, 0)
        val topTop = Luma(0, -2)

        // The divisor that makes every threshold below relative. See the shader's header.
        val scale = max(
            max(max(centre, left), max(top, right)),
            max(max(bottom, leftLeft), max(topTop, lumaFloor))
        )

        val inverse = 1f / scale

        val deltaLeft = abs(centre - left) * inverse
        val deltaTop = abs(centre - top) * inverse

        var e = float2(deltaLeft >= edgeThreshold ? 1f : 0f, deltaTop >= edgeThreshold ? 1f : 0f)

        if (e.x + e.y == 0f) {
            return float2(0f, 0f)
        }

        val deltaRight = abs(centre - right) * inverse
        val deltaBottom = abs(centre - bottom) * inverse
        val deltaLeftLeft = abs(left - leftLeft) * inverse
        val deltaTopTop = abs(top - topTop) * inverse

        val steepest = max(
            max(max(deltaLeft, deltaRight), max(deltaTop, deltaBottom)),
            max(deltaLeftLeft, deltaTopTop)
        )

        if (steepest > contrastAdaptation * deltaLeft) {
            e.x = 0f
        }

        if (steepest > contrastAdaptation * deltaTop) {
            e.y = 0f
        }

        return e
    }

    /// Mode 1: how far this pixel and each of its two neighbours reach across their shared boundary.
    ///
    /// Red is how far this pixel reaches up, green how far the pixel above it reaches down, blue how
    /// far this one reaches left and alpha how far the one to its left reaches right. Two numbers per
    /// boundary because a boundary belongs to two pixels, and each reads the one addressed to it.
    func Weigh(): float4 {
        val e = Edge(0, 0)
        var result = float4(0f, 0f, 0f, 0f)

        if (e.y > 0.5f) {
            // A horizontal edge along the top of this pixel. Walk it left and right.
            var left = 0

            // A vertical edge on this pixel's own left boundary crosses the run here, so the run
            // starts at this pixel and there is nothing to walk.
            if (e.x < 0.5f) {
                for (i in 1 .. SearchSteps) {
                    val step = Edge(-i, 0)

                    if (step.y < 0.5f) {
                        break
                    }

                    left = i

                    // A crossing on *this* texel's left boundary is at the outer end of it, so the
                    // texel belongs to the run and the run stops after it.
                    if (step.x > 0.5f) {
                        break
                    }
                }
            }

            var right = 0

            for (i in 1 .. SearchSteps) {
                val step = Edge(i, 0)

                // Walking the other way, a crossing on this texel's left boundary is *between* it and
                // the run, so the run stops before it. The asymmetry is the boundary's, not the walk's.
                if (step.y < 0.5f || step.x > 0.5f) {
                    break
                }

                right = i
            }

            val coverage = Coverage(
                left,
                right,
                Edge(-left, 0).x,
                Edge(-left, -1).x,
                Edge(right + 1, 0).x,
                Edge(right + 1, -1).x
            )

            result.x = coverage.x
            result.y = coverage.y
        }

        if (e.x > 0.5f) {
            // The same walk rotated a quarter turn: a vertical edge down this pixel's left boundary,
            // walked up and down, crossed by horizontal edges. "Below the line" is now the side this
            // pixel is on, which is to the right of the boundary.
            var up = 0

            if (e.y < 0.5f) {
                for (i in 1 .. SearchSteps) {
                    val step = Edge(0, -i)

                    if (step.x < 0.5f) {
                        break
                    }

                    up = i

                    if (step.y > 0.5f) {
                        break
                    }
                }
            }

            var down = 0

            for (i in 1 .. SearchSteps) {
                val step = Edge(0, i)

                if (step.x < 0.5f || step.y > 0.5f) {
                    break
                }

                down = i
            }

            val coverage = Coverage(
                up,
                down,
                Edge(0, -up).y,
                Edge(-1, -up).y,
                Edge(0, down + 1).y,
                Edge(-1, down + 1).y
            )

            result.z = coverage.x
            result.w = coverage.y
        }

        return result
    }

    /// Mode 2: one bilinear tap toward whichever neighbour the weights point at.
    ///
    /// The whole blend is two samples and a lerp, because a fractional texel offset *is* the lerp —
    /// which is the trick that makes the last pass nearly free.
    func Blend(): float4 {
        val here = Weight(0, 0)

        // Four weights meet at this pixel, and two of them were written by its neighbours: the pixel
        // below holds how far this one reaches down, and the pixel to the right how far it reaches
        // right.
        val toTop = here.x
        val toLeft = here.z
        val toBottom = Weight(0, 1).y
        val toRight = Weight(1, 0).w

        if (toTop + toLeft + toBottom + toRight <= 0.00001f) {
            return source.Sample(linearSampler, uv)
        }

        // One axis, not both: a pixel on a corner would otherwise be blended twice and land somewhere
        // neither edge put it.
        val horizontal = max(toRight, toLeft) > max(toBottom, toTop)

        var pair = float2(toBottom, toTop)
        var first = uv + float2(0f, toBottom * texelSize.y)
        var second = uv - float2(0f, toTop * texelSize.y)

        if (horizontal) {
            pair = float2(toRight, toLeft)
            first = uv + float2(toRight * texelSize.x, 0f)
            second = uv - float2(toLeft * texelSize.x, 0f)
        }

        pair = pair / max(pair.x + pair.y, Const.Epsilon)

        return pair.x * source.Sample(linearSampler, first) + pair.y * source.Sample(linearSampler, second)
    }

    /// The coverage table's answer for one run.
    ///
    /// The two crossings at each end pick the pattern's block — `3 · below + above`, which is the
    /// reference's arithmetic and the reason the table's grid is five wide with the middle slot never
    /// used — and the distances index into it. Both distances are square-rooted because the table's
    /// distance axis is compressed quadratically: resolution where the coverage changes, none where
    /// it does not.
    func Coverage(
        left: int,
        right: int,
        belowLeft: float,
        aboveLeft: float,
        belowRight: float,
        aboveRight: float
    ): float2 {
        val blockX = 3f * (belowLeft > 0.5f ? 1f : 0f) + (aboveLeft > 0.5f ? 1f : 0f)
        val blockY = 3f * (belowRight > 0.5f ? 1f : 0f) + (aboveRight > 0.5f ? 1f : 0f)

        val texel = float2(
            areaMaxDistance * blockX + sqrt(float(left)),
            areaMaxDistance * blockY + sqrt(float(right))
        )

        return area.Sample(linearSampler, (texel + float2(0.5f, 0.5f)) * areaTexelSize).rg
    }

    /// The edge mask at a texel offset from this one.
    func Edge(offsetX: int, offsetY: int): float2 {
        return edges.Sample(pointSampler, uv + float2(float(offsetX), float(offsetY)) * texelSize).rg
    }

    /// The blending weights at a texel offset from this one.
    func Weight(offsetX: int, offsetY: int): float4 {
        return weights.Sample(pointSampler, uv + float2(float(offsetX), float(offsetY)) * texelSize)
    }

    /// The source's luminance at a texel offset from this one.
    func Luma(offsetX: int, offsetY: int): float {
        val tap = source.Sample(pointSampler, uv + float2(float(offsetX), float(offsetY)) * texelSize).rgb
        return Fullscreen.Luminance(tap)
    }
}
