package Vixen.Shaders.ScreenProbes

import Vixen.Shaders.Core
import Vixen.Shaders.DistanceFields
import Vixen.Shaders.IrradianceFields
import Vixen.Shaders.SurfaceCache

// Filling screen probes by marching the distance field, on the GPU.
//
// `docs/plan/19` § L3's trace, first half only: one ray per octahedral texel, at the texel's centre,
// with the radiance written into the atlas and nothing resolved. The projection, the filters and the
// upsample are later passes, because a texel of raw radiance is the thing a reference can be compared
// against and a filtered one is not.
//
// `Vixen.Rendering.ScreenProbes.TracedScreenProbeGather` is the same arithmetic on the CPU and it
// exists first, because there it can be checked: a uniform sky comes back as itself in every texel.
// Where the two disagree, the C# is right and this is wrong.
//
// One workgroup per probe and one invocation per texel: sixty-four threads, sixty-four rays. The probe
// a group is filling comes out of a buffer indexed by the group — the same shape as `IrradianceFill`,
// so a frame refills N probes in one dispatch and N is the host's number.
//
// What a hit gives back is nothing, exactly as `IrradianceFill`: a surface's own radiance is Lumen's
// surface cache and that is § L4. Until it exists this bounces nothing, which is honest rather than
// convenient — and it is what the CPU reference's fixtures return too.

/// One probe to fill: where its map lives in the atlas, and where it stands in the world.
struct ScreenProbeTraceJob {
    /// Where the probe's map starts in the atlas, in texels.
    var atlasOrigin: int2

    /// One for a probe standing on a surface. Zero for a probe with nothing under it, whose patch is
    /// cleared to the invalid mark instead of traced — on an atlas the dispatch owns, a patch nothing
    /// writes holds whatever the allocator left there, and the resolve reads validity out of it.
    var valid: int

    /// Where its rays start — the probe's surface, already stepped off along its normal.
    ///
    /// Biased by the host rather than here, so the shader needs no normal at all: the bias is part of
    /// where a probe stands, not of how a ray marches, and the CPU reference applies it in exactly one
    /// place for the same reason.
    var origin: float3
}

shader ScreenProbeTrace {
    /// What the rays march through. `GlobalDistanceField` is the one that reads a clipmap.
    compose val distanceField: IDistanceFieldSource = NoDistanceField

    /// Where a ray that ran out of budget terminates — doc 19 § L3's "terminate long rays in L2's
    /// field, so distant lighting is amortised rather than re-traced per probe".
    ///
    /// The same slot name and type the shading passes compose, because it is the same field: a pass
    /// composition binds a slot once, wherever it is declared, and a project with a field gives it to
    /// every reader at once. `NoIrradiance` answers with zero coverage, and zero coverage blends the
    /// termination all the way back to the sky — so a project without a field traces exactly the rays
    /// it traced before.
    compose val irradiance: IIrradianceSource = NoIrradiance

    /// What a ray that hits a surface sees — doc 19 § L4's cache, closing the seam this kernel
    /// carried from the day it was written. `NoSurfaceCache` answers black, which is exactly what
    /// the hit branch stored before the slot existed; `SurfaceCacheSource` answers with the card
    /// atlas, and the probes inherit multi-bounce light without this file changing again.
    compose val surfaceCache: ISurfaceCacheSource = NoSurfaceCache

    var jobs: Buffer<ScreenProbeTraceJob>

    /// Every probe's map, side by side. Written, never read — the resolve is a later pass.
    [Format("rgba32f")] var radianceAtlas: RWTexture2D<float4>

    /// The frame's own depth, for the trace order's first stage. The descriptor is always written —
    /// a set with a hole in it binds nothing — and the texels are read only above zero `screenSteps`,
    /// so a host with no screen to trace hands over any texture in the sampled layout.
    var depthBuffer: Texture2D

    /// The camera that drew `depthBuffer` — the forward matrix, not the inverse placement uses.
    var viewProjection: mat4

    /// The viewport `depthBuffer` covers, in pixels.
    var screenViewport: float2 = float2(0f, 0f)

    /// How many equal steps a screen ray takes over `maxDistance`. Zero is no screen trace at all.
    var screenSteps: int = 0

    /// How deep behind a surface a sample still counts as inside it, in device depth.
    var screenThickness: float = 0.02f

    /// The depth's nearest-per-cell chain — `HiZPyramid` wearing `NearestReduce`, so mip N holds
    /// level N + 1 of the march, the depth itself being level zero. Always bound (a set with a hole
    /// in it binds nothing); read only above zero `pyramidLevels`, so a host without a chain hands
    /// any texture in the sampled layout.
    var depthPyramid: Texture2D

    /// How many levels the hierarchical march may use, counting the depth as level zero — the CPU
    /// pyramid's own count. Zero is the fixed-step walk.
    var pyramidLevels: int = 0

    /// How deep the shell is in view units, where a perspective ray can say. Zero keeps the
    /// device-depth shell everywhere — `ScreenSpaceTrace.LinearThickness`, choice for choice.
    var screenLinearThickness: float = 0f

    /// How far a ray looks before deciding it hit nothing.
    var maxDistance: float = 100f

    /// How many steps one march may take.
    var maxSteps: int = 64

    /// How near counts as arrived.
    var surfaceThreshold: float = 0.05f

    /// What fraction of the reported distance each step actually takes.
    var stepScale: float = 0.9f

    /// What a ray that hit nothing sees, straight ahead.
    var skyColor: float3 = float3(1f, 1f, 1f)

    /// How much the sky changes per unit of a direction's y, per channel.
    ///
    /// Zero is a uniform sky and the closed form. Nonzero is what lets a device comparison exercise
    /// the octahedral decode at all: under a uniform sky every texel is the same number whatever
    /// direction it stands for, so a transposed or mirrored decode is invisible — the same blindness
    /// the cube capture's tests escaped by lighting a single texel.
    var skyGradient: float3 = float3(0f, 0f, 0f)

    /// The linear shell's slope — device depth is affine in `1/w`, `z = a + b·(1/w)`, with the same
    /// constants at every point the camera sees, so one ray's two endpoints determine them. Zero
    /// where the conversion does not exist (a `w` that does not vary, a camera bent the wrong way)
    /// and the device-depth shell stands — `ScreenSpaceTrace.ShellOf`, choice for choice.
    func ShellSlope(fromClip: float4, toClip: float4): float {
        if (screenLinearThickness <= 0f || fromClip.w <= Const.Epsilon || toClip.w <= Const.Epsilon) {
            return 0f
        }

        val inverseFrom = 1f / fromClip.w
        val inverseTo = 1f / toClip.w

        if (abs(inverseFrom - inverseTo) <= 0.000001f) {
            return 0f
        }

        val slope = (fromClip.z * inverseFrom - toClip.z * inverseTo) / (inverseFrom - inverseTo)

        if (slope <= 0f) {
            return 0f
        }

        return slope
    }

    /// The hierarchical DDA over the nearest chain — `ScreenSpaceTrace.Hierarchical`, sample for
    /// sample: skip a cell whose whole crossing stays nearer than its nearest surface, descend where
    /// it does not, and hold the shell against the texel crossing continuously — in view units where
    /// `screenLinearThickness` bought the conversion, device units otherwise. Answers the pixel that
    /// stopped the ray, or (-1, -1); the caller decides what a pixel is worth.
    func PyramidMarch(fromClip: float4, toClip: float4): int2 {
        val inverseFrom = 1f / fromClip.w
        val inverseTo = 1f / toClip.w
        // ⚠ y is negated and x is not — `Transform.NdcToUv`'s convention, restated in pixels.
        // Clip y = +1 is the TOP of the screen and pixel row zero is the top row, so the fold is
        // `-y·0.5 + 0.5`. This march used `+y·0.5 + 0.5` while the ray's origin was reconstructed
        // through the negating helper: the ray started at the right world position and then walked
        // a vertically mirrored screen — mirrored depth, mirrored hits, and a mirrored copy of the
        // frame pasted wherever the hit reported valid.
        val fromX = (fromClip.x * inverseFrom * 0.5f + 0.5f) * screenViewport.x
        val fromY = (fromClip.y * inverseFrom * -0.5f + 0.5f) * screenViewport.y
        val fromZ = fromClip.z * inverseFrom
        val toX = (toClip.x * inverseTo * 0.5f + 0.5f) * screenViewport.x
        val toY = (toClip.y * inverseTo * -0.5f + 0.5f) * screenViewport.y
        val toZ = toClip.z * inverseTo
        val deltaX = toX - fromX
        val deltaY = toY - fromY
        val deltaZ = toZ - fromZ
        val slope = ShellSlope(fromClip, toClip)
        val shellA = fromZ - slope * inverseFrom

        var along = 0f
        var level = pyramidLevels - 1
        var size = 1

        for (i in 0 .. level - 1) {
            size = size * 2
        }

        // The coarsest level still worth asking, and what buys one back — `ScreenSpaceTrace`'s
        // `AscentCredit`, by value, because the two marches are held to the same cell sequence.
        var ceiling = pyramidLevels - 1
        var credit = 0

        val width = int(screenViewport.x)
        val height = int(screenViewport.y)

        // A DDA visits O(levels · perimeter) cells; anything past this is a defect, and a budget
        // that ends a march is a miss in the only sense that matters.
        val budget = 16 * (width + height + pyramidLevels) + 64

        for (i in 0 .. budget - 1) {
            if (along >= 1f) {
                return int2(-1, -1)
            }

            val atX = fromX + deltaX * along
            val atY = fromY + deltaY * along

            // ⚠ The cell the ray is ENTERING, not the one it is leaving. A DDA lands exactly on a
            // boundary every step, and a plain floor answers that landing with the cell on the lower
            // side — which, for a ray travelling the other way, is the one it has just finished. Its
            // exit is then the point the ray already stands on, the forward guard below nudges a
            // hundredth of a texel instead of a whole one, and the iteration buys nothing: on a ray
            // running down and left across the frame that is every second iteration at level zero,
            // and one descent above it. `ScreenSpaceTrace.Entering` is the same rule.
            var px = int(floor(atX))
            var py = int(floor(atY))

            if (deltaX < 0f) {
                px = int(ceil(atX)) - 1
            }

            if (deltaY < 0f) {
                py = int(ceil(atY)) - 1
            }

            // Off the viewport, the rest of the ray is not the screen's to answer.
            if (px < 0 || py < 0 || px >= width || py >= height) {
                return int2(-1, -1)
            }

            val cellX = (px / size) * size
            val cellY = (py / size) * size
            var exit = 1f

            if (deltaX > 0.000001f) {
                exit = min(exit, (float(cellX + size) - fromX) / deltaX)
            } else {
                if (deltaX < -0.000001f) {
                    exit = min(exit, (float(cellX) - fromX) / deltaX)
                }
            }

            if (deltaY > 0.000001f) {
                exit = min(exit, (float(cellY + size) - fromY) / deltaY)
            } else {
                if (deltaY < -0.000001f) {
                    exit = min(exit, (float(cellY) - fromY) / deltaY)
                }
            }

            exit = max(exit, along + 0.00001f)

            var nearest = 0f

            if (level == 0) {
                nearest = depthBuffer.Load(int3(px, py, 0)).r
            } else {
                // ⚠ Shifted rather than queried. `GetDimensions(level - 1)` is
                // `OpImageQuerySizeLod` with a *variable* lod, and llvmpipe does not answer it the
                // way MoltenVK does — see `Culling.rvn`, where the same call put four taps in the
                // wrong texels. The pyramid's level 0 is half the depth buffer and a mip chain
                // halves by flooring, which is a shift, so this is the same number without asking.
                val dimX = max(1, (width / 2) >> (level - 1))
                val dimY = max(1, (height / 2) >> (level - 1))
                val cx = min(px / size, dimX - 1)
                val cy = min(py / size, dimY - 1)

                nearest = depthPyramid.Load(int3(cx, cy, level - 1)).r
            }

            val zAt = fromZ + deltaZ * along
            val zExit = fromZ + deltaZ * exit
            val enter = min(zAt, zExit)
            val leave = max(zAt, zExit)

            if (enter > nearest) {
                // The whole crossing stays nearer than the cell's nearest surface — nothing here
                // can stop the ray. Skip it, and try a coarser cell once the backoff is paid off.
                along = exit
                credit = credit + 1

                if (credit >= 8) {
                    credit = 0

                    if (ceiling < pyramidLevels - 1) {
                        ceiling = ceiling + 1
                    }
                }

                if (level < ceiling) {
                    level = level + 1
                    size = size * 2
                }
            } else {
                if (level > 0) {
                    // ⚠ This level is too coarse *here*, and recording that is what stops a grazing
                    // ray costing thousands of iterations: without it the next skip climbs straight
                    // back into the cell that just refused, is refused again, and descends — two
                    // iterations a texel, bought for as long as the ray runs along a surface. The
                    // evidence decays, which is what the credit above spends.
                    ceiling = level - 1
                    credit = 0
                    level = level - 1
                    size = size / 2
                } else {
                    // Texel level: the shell, held against the segment. A sky texel occludes
                    // nothing.
                    if (nearest > 0f) {
                        if (slope > 0f) {
                            val surfaceInverseW = (nearest - shellA) / slope

                            if (surfaceInverseW > 0.000001f) {
                                val surfaceW = 1f / surfaceInverseW
                                val wAt = 1f / (inverseFrom + (inverseTo - inverseFrom) * along)
                                val wExit = 1f / (inverseFrom + (inverseTo - inverseFrom) * exit)

                                if (max(wAt, wExit) > surfaceW && min(wAt, wExit) < surfaceW + screenLinearThickness) {
                                    return int2(px, py)
                                }
                            }
                        } else {
                            if (enter < nearest && leave > max(nearest - screenThickness, 0f)) {
                                return int2(px, py)
                            }
                        }
                    }

                    along = exit
                }
            }
        }

        return int2(-1, -1)
    }

    /// Whether a ray from a point is stopped by something the screen can see — the naive march,
    /// sample by sample, in exactly `ScreenSpaceTrace.Hit`'s order, or the hierarchical march when
    /// the host handed over a chain and both endpoints project. Behind is a *smaller* device depth,
    /// because depth is reversed; a sky texel occludes nothing; off the viewport the ray is not the
    /// screen's to answer.
    func ScreenHit(origin: float3, direction: float3): bool {
        val fromClip = viewProjection * float4(origin, 1f)
        val toClip = viewProjection * float4(origin + direction * maxDistance, 1f)

        if (pyramidLevels > 0 && fromClip.w > Const.Epsilon && toClip.w > Const.Epsilon) {
            val landed = PyramidMarch(fromClip, toClip)

            return landed.x >= 0
        }

        val slope = ShellSlope(fromClip, toClip)
        val inverseFrom = 1f / max(fromClip.w, Const.Epsilon)
        val shellA = fromClip.z * inverseFrom - slope * inverseFrom
        val step = maxDistance / float(screenSteps)

        for (i in 0 .. screenSteps - 1) {
            val world = origin + direction * ((float(i) + 0.5f) * step)
            val clip = viewProjection * float4(world, 1f)

            // Behind the camera's plane there is no pixel to ask, and outside the depth range the
            // buffer never saw it.
            if (clip.w > Const.Epsilon) {
                val ndc = clip.xyz / clip.w

                if (ndc.z > 0f && ndc.z < 1f) {
                    val px = int(floor((ndc.x * 0.5f + 0.5f) * screenViewport.x))
                    val py = int(floor((ndc.y * -0.5f + 0.5f) * screenViewport.y))

                    if (px < 0 || py < 0 || px >= int(screenViewport.x) || py >= int(screenViewport.y)) {
                        return false
                    }

                    val surfaceDepth = depthBuffer.Load(int3(px, py, 0)).r

                    if (surfaceDepth > 0f) {
                        if (slope > 0f) {
                            val surfaceInverseW = (surfaceDepth - shellA) / slope

                            if (surfaceInverseW > 0.000001f) {
                                val surfaceW = 1f / surfaceInverseW

                                if (clip.w > surfaceW && clip.w < surfaceW + screenLinearThickness) {
                                    return true
                                }
                            }
                        } else {
                            if (ndc.z < surfaceDepth && ndc.z > surfaceDepth - screenThickness) {
                                return true
                            }
                        }
                    }
                }
            }
        }

        return false
    }

    // An eight-by-eight group, one invocation per texel of `ScreenProbeAtlas.MapResolution`. The two
    // are the same number by construction rather than by coincidence — see Main's first line.
    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_GroupID")] group: uint3, [Semantic("SV_GroupThreadID")] thread: uint3) {
        val job = jobs[int(group.z)]
        val texel = int2(int(thread.x), int(thread.y))
        val atlasTexel = int2(job.atlasOrigin.x + texel.x, job.atlasOrigin.y + texel.y)

        // A probe with no surface writes the invalid mark and is done — sixty-four stores, so the
        // patch is defined whatever the allocator left in it.
        if (job.valid == 0) {
            radianceAtlas.Store(atlasTexel, float4(0f, 0f, 0f, 0f))
            return
        }

        // A probe the field calls buried is invalid before any ray is cast — the reference's rule.
        // Zero alpha is the mark: a gathered texel carries one, so a readback can tell "nothing
        // gathered" from "gathered nothing but darkness".
        if (distanceField.SampleField(job.origin) < 0f) {
            radianceAtlas.Store(atlasTexel, float4(0f, 0f, 0f, 0f))
            return
        }

        val direction = ScreenProbeAtlas.Direction(texel, ScreenProbeAtlas.MapResolution)

        // The screen first — geometry the field may not hold — and a hit is an occlusion, for the
        // same § L4 reason a field hit gives back nothing. `ScreenSpaceTrace` is the C# side, and
        // where the two disagree, the C# is right.
        if (screenSteps > 0 && ScreenHit(job.origin, direction)) {
            radianceAtlas.Store(atlasTexel, float4(0f, 0f, 0f, 1f))
            return
        }

        val hit = distanceField.TraceField(job.origin, direction, maxDistance, maxSteps, surfaceThreshold, stepScale)
        var arriving = skyColor + skyGradient * direction.y

        if (hit.hit) {
            // What the surface radiates, from the cache — `SurfaceCacheStore.TryRadiance`'s walk,
            // behind the slot. The normal is the field's gradient, the same answer the CPU tracer
            // hands its radiance source.
            arriving = surfaceCache.SurfaceRadiance(hit.position, distanceField.GradientField(hit.position)).rgb
        } else {
            // A miss terminates in the field where the field has an answer, blended by its coverage —
            // the sky is the fallback, not an addend, for the double-counting reason `ForwardPlus`
            // records: the field's rays already saw the sky.
            val far = irradiance.Radiance(job.origin + direction * maxDistance, direction)
            arriving = lerp(arriving, far.rgb, clamp(far.a, 0f, 1f))
        }

        radianceAtlas.Store(atlasTexel, float4(arriving, 1f))
    }
}
