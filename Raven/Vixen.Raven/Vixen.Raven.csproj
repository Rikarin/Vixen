<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Vixen.Raven</RootNamespace>
        <!-- NU1903: transitive vuln advisory. CS3021: ANTLR-generated lexer/parser
             carry [CLSCompliant] attrs the assembly doesn't need (third-party noise). -->
        <NoWarn>NU1903;CS3021</NoWarn>

        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <!-- Shipped package: the compiler is useful on its own, without the engine. -->
    <PropertyGroup>
        <Description>
            Raven shader compiler: parses .rvn source into a Roslyn-shaped syntax tree, binds
            and lowers it to a target-independent IR, and emits GLSL and SPIR-V. Usable as a
            library; see Vixen.Raven.Cli for the command-line front end.
        </Description>
        <PackageTags>shader;compiler;glsl;spirv;vulkan;raven;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!--
            #821's ratchet, and the first project under `Raven/**` to take it. The TOOLING profile in
            `Directory.Build.props` sets this false for `Editor/**`, `Tools/**` and `Raven/**` alike,
            so no `<see cref>` in the compiler was ever checked. CS1591 and CS1573 stay suppressed —
            "this public member has no comment" is a question about a packaged API surface and is not
            what this is for; the rules that catch a *lie* are.

            ⚠ This is the project a shipped package is cut from, so the XML it now emits is the
            documentation a consumer of the NuGet package reads in their IDE. Before this, a
            `<see cref>` in it resolved for nobody and was checked by nothing.

            ⚠ One of the four it found was a doc block documenting a *different overload* than the
            one it is attached to: `Create(string, PermutationValues, IEnumerable{SyntaxTree})`
            carried a `<paramref name="composeBindings" />` for a parameter it does not have, and two
            overloads that DO have it inherited that block. `CheckDocComments` cannot see this
            variant — it counts `<summary>` blocks and reads `<param>`, not `<paramref>` — so this
            flag is the only thing in the tree that can.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Raven.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Syntax\Syntax.xml"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The shared green/red tree, SourceText and diagnostics model. -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Syntax\Vixen.Core.Syntax.csproj"/>

        <!-- Turns Syntax\Syntax.xml into the node classes. Analyzer-only, no reference. -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Syntax.Generator\Vixen.Core.Syntax.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
        />
    </ItemGroup>
</Project>
