<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Vixen.Raven</RootNamespace>
        <!-- NU1903: transitive vuln advisory. CS3021: ANTLR-generated lexer/parser
             carry [CLSCompliant] attrs the assembly doesn't need (third-party noise). -->
        <NoWarn>NU1903;CS3021</NoWarn>

        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <!-- Shipped package: the compiler is useful on its own, without the engine. -->
    <PropertyGroup>
        <Description>
            Raven shader compiler: parses .rvn source into a Roslyn-shaped syntax tree, binds
            and lowers it to a target-independent IR, and emits GLSL and SPIR-V. Usable as a
            library; see Vixen.Raven.Cli for the command-line front end.
        </Description>
        <PackageTags>shader;compiler;glsl;spirv;vulkan;raven;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!--
        ⚠ This is what turns VXS0001 back on. The diagnostic is opt-in since #1188 — it fires when
        a compilation has no Syntax.xml, which is every consumer of Vixen.Core.Syntax that is not
        building a language, and with TreatWarningsAsErrors that was a build break rather than a
        warning; it was the reason the package could not carry the generator. A project that says
        it is building a language is exactly the one the guard is for: forgetting the AdditionalFiles
        line below is then one diagnostic rather than a hundred CS0246s.

        CompilerVisibleProperty is what puts it in the analyzer config. In a package this line comes
        from Vixen.Core.Syntax's buildTransitive targets; in this tree the reference is a
        ProjectReference, which carries no build assets, so it is named here.
    -->
    <PropertyGroup>
        <VixenSyntaxXmlRequired>true</VixenSyntaxXmlRequired>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="VixenSyntaxXmlRequired" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Raven.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Syntax\Syntax.xml"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The shared green/red tree, SourceText and diagnostics model. -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Syntax\Vixen.Core.Syntax.csproj"/>

        <!-- Turns Syntax\Syntax.xml into the node classes. Analyzer-only, no reference. -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Syntax.Generator\Vixen.Core.Syntax.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
        />
    </ItemGroup>
</Project>
