<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Vixen.Raven</RootNamespace>
        <!-- NU1903: transitive vuln advisory. CS3021: ANTLR-generated lexer/parser
             carry [CLSCompliant] attrs the assembly doesn't need (third-party noise). -->
        <NoWarn>NU1903;CS3021</NoWarn>

        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <!-- Shipped package: the compiler is useful on its own, without the engine. -->
    <PropertyGroup>
        <Description>
            Raven shader compiler: parses .rvn source into a Roslyn-shaped syntax tree, binds
            and lowers it to a target-independent IR, and emits GLSL and SPIR-V. Usable as a
            library; see Vixen.Raven.Cli for the command-line front end.
        </Description>
        <PackageTags>shader;compiler;glsl;spirv;vulkan;raven;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Raven.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Antlr4.CodeGenerator">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Antlr4.Runtime"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          Pack="false": these are build inputs for ANTLR, not content for consumers.
          Content items are packed into contentFiles by default, which would copy the
          grammars into every project that references this package.
        -->
        <Content Include="Grammar\RavenLexer.g4" Pack="false" />
        <Content Include="Grammar\RavenParser.g4" Pack="false" />
        <Content Include="Grammar\UnicodeClasses.g4" Pack="false" />
        <AdditionalFiles Include="Syntax\Syntax.xml"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The shared green/red tree, SourceText and diagnostics model. -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Syntax\Vixen.Core.Syntax.csproj"/>

        <!-- Turns Syntax\Syntax.xml into the node classes. Analyzer-only, no reference. -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Syntax.Generator\Vixen.Core.Syntax.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
        />
    </ItemGroup>
</Project>
