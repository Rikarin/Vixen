package Vixen.Test

shader Precedence {
    func Ladder() {
        val arithmetic = 1 + 2 * 3 - 4 / 5
        val comparison = a + b < c == d
        val logic = a && b || c ?? d
        val call = 1 + f(x) * g(y)
        val indexed = 1 + xs[0]
        val unary = -a * b + c++
        val conditional = a || b ? c : d
        val chained = x = y = a + b
        val lambda = v => v * 2 + 1
        val range = a .. b + c
    }
}
