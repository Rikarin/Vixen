<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Gameplay\Vixen.Gameplay.csproj" />

        <!--
            ⚠ Referenced by the tests and deliberately not by the library. docs/plan/28 says a DefId
            is "the same construction doc 16 uses for prefab ids", and a sentence like that is either
            asserted or it is a comment that stops being true. `DefIdIsTheSameHashAsANetworkPrefabId`
            computes both and compares them; the kernel itself must not link the networking layer to
            get one.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Net\Vixen.Net.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The tests declare their own definition types, and a definition is named in a .vxdef by its
            [DataContract] alias — which is what this generator's descriptors make resolvable. Without
            it the test types have no alias and the composition refuses them for the right reason at
            the wrong time.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- Measured, the guarded allocation measurement. See Testing/Vixen.Testing.props. -->
    <Import Project="..\..\Testing\Vixen.Testing.props" />

</Project>
