<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Gameplay.Pvp</RootNamespace>
        <Description>
            Arenas, battlegrounds and duels over four composable objective types — capture point,
            payload, flag return and resource control — with scoring, win conditions and world-PvP
            flagging, so that a new battleground is a map plus a .vxdef.
        </Description>
        <PackageTags>gameplay;pvp;arena;battleground;objectives;mmo;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The kernel and nothing else. Doc 28's spine allows Pvp → Combat and it is not taken: an
            objective is a meter and a score, and what kills the person standing on it is combat's
            business rather than this library's. Flagging is a tag, which is the kernel's.
        -->
        <ProjectReference Include="..\Vixen.Gameplay\Vixen.Gameplay.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Serialization\Vixen.Core.Serialization.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection\Vixen.Core.Reflection.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <ProjectReference Include="..\..\Core\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Gameplay.Pvp.Tests" />
    </ItemGroup>

</Project>
