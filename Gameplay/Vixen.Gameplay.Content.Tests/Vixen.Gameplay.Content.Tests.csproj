<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Gameplay.Content\Vixen.Gameplay.Content.csproj" />
        <ProjectReference Include="..\Vixen.Gameplay.Items\Vixen.Gameplay.Items.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Core.IO\Vixen.Core.IO.csproj" />
    </ItemGroup>

    <!-- Measured, the guarded allocation measurement. See Testing/Vixen.Testing.props. -->
    <Import Project="..\..\Testing\Vixen.Testing.props" />
</Project>
