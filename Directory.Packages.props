<Project>

  <!--
    Vixen — Central Package Management.
    Spec: docs/plan/01-technology-decisions.md § "Platform baseline"

    Every package version in the repository is pinned here. csproj files carry
    <PackageReference Include="..." /> with no Version attribute; a stray inline
    version is an NU1008 build error, which is the point.

    Only packages actually in use are listed. The plan's full dependency register
    (Silk.NET, Jolt, ImageSharp, ExCSS, HarfBuzz, …) is in docs/plan/01 and lands
    here as each subsystem is built — not before, so that `dotnet list package`
    always reflects reality.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Fail the build if a csproj declares an inline version. Without this, CPM
      silently ignores the central value in some SDK versions.
    -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <!-- Transitive pinning stays off: it makes the graph rigid and interacts
         badly with analyzer/generator packages. Revisit if supply-chain policy
         demands it. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ===== Raven: parser front end ===== -->
  <ItemGroup Label="ANTLR">
    <PackageVersion Include="Antlr4.CodeGenerator" Version="4.6.6" />
    <PackageVersion Include="Antlr4.Runtime" Version="4.6.6" />
  </ItemGroup>

  <!-- ===== Logging (docs/plan/01 § Platform baseline, ADR-008) ===== -->
  <ItemGroup Label="Logging">
    <!--
      Abstractions only. The engine implements its own sink: the ring buffer the
      editor console and the crash reporter read is ours, and ILogger is the
      interface everything codes against so that [LoggerMessage] can generate
      allocation-free call sites.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <!-- ===== Telemetry (docs/plan/14 § Phase 9, docs/plan/17 § Server variant) ===== -->
  <ItemGroup Label="Telemetry">
    <!--
      The SDK and its exporters only, and only in Vixen.Net.Telemetry. The
      *instrumentation* is in Vixen.Net and depends on nothing: System.Diagnostics.Metrics
      is not a third option alongside OpenTelemetry and Prometheus, it is
      OpenTelemetry's metrics API in .NET, and a server that already has a pipeline
      reads Vixen.Net's meter by naming it. What is here is the export half, which a
      game that never runs a dedicated server must not carry.
    -->
    <PackageVersion Include="OpenTelemetry" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.17.0" />
    <!--
      Process CPU, GC, thread pool and exception counts. A game server's own numbers
      say nothing about why it went slow, and the answer is nearly always in these.
    -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <!-- ===== Content-addressed storage (docs/plan/03 § Serialization, docs/plan/08 § ObjectDatabase) ===== -->
  <ItemGroup Label="Serialization">
    <!--
      XxHash128 for content ids and XxHash64 for type ids. This is the package
      docs/plan/03 says ObjectId deliberately does not depend on: Vixen.Core is
      BCL-only, and the code that hashes has the content in front of it, which is
      here.
    -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.10" />
    <!-- Chunk compression: LZ4 for decode speed locally, Zstd for size over the
         wire. Both are pure managed, which is what makes them work under WASM. -->
    <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <!-- ===== YAML (docs/plan/01 § dependency register, docs/plan/08 § "The .meta file") ===== -->
  <ItemGroup Label="Yaml">
    <!--
      Vixen.Core.Yaml uses the *low-level* half of this only — Scanner, Parser and
      the ParsingEvent stream. The object model and the reflection-driven
      (De)Serializer are not referenced: type resolution goes through the generated
      TypeRegistry instead, which is what keeps .meta reading AOT-safe. The emitter
      is Vixen's own, because the dialect docs/plan/08 fixes is narrower than
      anything YamlDotNet's emitter can be configured into and byte fidelity is a
      requirement rather than a nicety.
    -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- ===== UI (docs/plan/01 § dependency register, ADR-009) ===== -->
  <ItemGroup Label="Ui">
    <!--
      The VCSS front end. Verified against this exact version before anything was built on it —
      docs/plan/spikes/vcss-excss/RESULT.md — because ADR-009 assumes the selector tree is reachable
      and typed, and a parser that handed back only selector strings would have inverted that
      decision without saying so. It does not parse @layer; Vixen reads that one itself.
    -->
    <PackageVersion Include="ExCSS" Version="4.3.2" />
    <!--
      Shaping. Doc 09 calls it non-negotiable and it is: nothing else gets Arabic, Indic, emoji
      clusters and variable fonts right. Verified against this exact version before anything was
      built on it — docs/plan/spikes/text-harfbuzz/RESULT.md — because it is the first native
      dependency in the UI stack and Phase 4 exits with a sample running in a browser.

      ⚠ The WebAssembly path is a version-coupled static link. The package ships static archives
      built by Emscripten 3.1.34 and 3.1.56, and .NET 10 pins Emscripten.3.1.56.Sdk; they match
      today. A bump of either one has to be checked against the other, and the spike's RESULT.md
      says so at more length.
    -->
    <PackageVersion Include="HarfBuzzSharp" Version="14.2.1.1" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.macOS" Version="14.2.1.1" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.1" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Win32" Version="14.2.1.1" />
  </ItemGroup>

  <!-- ===== Platform (docs/plan/01 § dependency register, docs/plan/10) ===== -->
  <ItemGroup Label="Platform">
    <!--
      Windowing, input, gamepads, clipboard, display enumeration and IME on the three
      desktops, plus the native handles a Vulkan surface is created from. Chosen over
      GLFW because SDL covers gamepads, haptics, IME and clipboard, and because it is
      the one that also runs on mobile.
    -->
    <PackageVersion Include="Silk.NET.SDL" Version="2.23.0" />
    <!--
      The Vulkan backend. Bindings only, like the SDL package: the loader and the
      ICD come from the platform's Vulkan SDK, which on macOS means MoltenVK plus
      the Loader plus the validation layers (docs/plan/10 § macOS, two flavours).
    -->
    <PackageVersion Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Core" Version="2.23.0" />
    <!--
      The native half of the WebGPU backend (docs/plan/05 § Vixen.Graphics.WebGPU).
      Bindings to webgpu.h — Dawn or wgpu-native supplies the library, the same
      arrangement as Vulkan's. It is deliberately NOT the browser half: this package
      binds a C entry point, and a browser reaches WebGPU through navigator.gpu and
      nothing else, which is why Vixen.Graphics.WebGPU.Browser exists.
    -->
    <PackageVersion Include="Silk.NET.WebGPU" Version="2.23.0" />
    <!--
      The OpenAL backend (docs/plan/02 § Platform, docs/plan/14 Phase 8). Bindings
      for AL and ALC, the ALC_ENUMERATION_EXT device list, and AL_EXT_FLOAT32 so a
      mixer that works in float does not have to quantise on the way out.

      Vixen mixes in software and OpenAL is used as a sink: one source, a queue of
      buffers, and none of its spatialisation, distance models or EFX. That is the
      decision Core/Vixen.Audio/Mixing/AudioMixer.cs sets out, and it is what keeps
      the same game sounding the same on OpenAL and in a browser.
    -->
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Extensions.Enumeration" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Extensions.EXT" Version="2.23.0" />
    <!--
      The implementation, not just the bindings. Unlike Vulkan — where the loader
      and the ICD come from the platform — there is no OpenAL on a stock Windows or
      Linux box, and macOS's is a deprecated 1.1 shim Apple stopped shipping headers
      for. OpenAL Soft is the de facto implementation on all three and this package
      carries it for win/linux/osx on x64 and arm64, so a published game needs
      nothing installed.

      Version 1.23.1 rather than 2.23.0: this is openal-soft's own version number
      and has nothing to do with Silk.NET's.
    -->
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />

    <!--
      The two codecs, both pure managed and both deliberately so. A native libvorbis
      and libopus would decode faster and would mean shipping a binary per RID plus a
      resolver like OpenALLoader's — and the browser target has no answer at all for
      that. Managed decoders publish under NativeAOT, run in WebAssembly, and cost a
      fraction of a per-cent of a core for a stereo stream, which for something the
      streaming pump does on its own thread is not a number anybody will notice.

      NVorbis is MIT; Concentus is BSD-3-Clause. Both are permissive and neither adds
      a notice obligation beyond attribution.

      They live in Core/Vixen.Audio.Codecs and not in Vixen.Audio, so a game with no
      compressed audio links neither — which is the same reason IAudioStreamDecoder
      is an interface in the first place.
    -->
    <PackageVersion Include="NVorbis" Version="0.10.5" />
    <PackageVersion Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <!-- ===== Physics (docs/plan/01 § dependency register, docs/plan/14 § Phase 8) ===== -->
  <ItemGroup Label="Physics">
    <!--
      Jolt, at the version doc 01 specifies. The managed binding is a thin one — a
      handle struct per native type and no object model of its own — which is what
      lets Vixen.Physics own the engine-facing API instead of re-exporting somebody
      else's. JoltPhysics.Native comes along transitively and carries the compiled
      library for win-x64/arm64, linux-x64/arm64, osx (universal) and the three
      Android ABIs.

      It does NOT carry an iOS slice, and iOS is NativeAOT-only where a dylib would
      not be loadable anyway. That gap is recorded in README.md § Platforms; the
      fix is a static libjoltc.a pinned the way MoltenVK already is, and it is not
      this project's to make.
    -->
    <PackageVersion Include="JoltPhysicsSharp" Version="2.22.0" />
  </ItemGroup>

  <!-- ===== Source generators / analyzers ===== -->
  <ItemGroup Label="Roslyn">
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <!-- ===== Benchmarks (docs/plan/12 § Nuke `Benchmark` target) ===== -->
  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- ===== Build automation (docs/plan/12 § Nuke) ===== -->
  <ItemGroup Label="Build">
    <PackageVersion Include="Nuke.Common" Version="10.1.0" />
  </ItemGroup>

  <!-- ===== CLI ===== -->
  <ItemGroup Label="CLI">
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

  <!-- ===== Import-time image codecs (docs/plan/01 § dependency register, ADR-015) ===== -->
  <ItemGroup Label="Imaging">
    <!--
      NOT ImageSharp. Doc 01 specified SixLabors.ImageSharp 4.0.0 and weighed its
      Six Labors Split License; what that analysis did not have is that 4.0.0
      *fails the build* without a purchased licence key — not a warning, an error
      out of SixLabors.ImageSharp.targets. An Apache-2.0 engine whose editor no
      contributor can compile without buying a key is not a trade worth making,
      and pinning to the 3.1.x line to dodge it means sitting on a version branch
      that will not get another security fix.

      Doc 01 already named the way out, and this takes it: StbImageSharp is public
      domain and covers PNG, JPEG, BMP, TGA, PSD, GIF and Radiance HDR. That is
      more of doc 08's importer table than ImageSharp reached, because it includes
      the HDR format environment maps actually arrive in.

      Still editor-and-tooling-only, for the reason ADR-015 gives about runtime
      size rather than about licences now: the runtime reads KTX2 with Vixen's own
      code and never decodes an authoring format.
    -->
    <PackageVersion Include="StbImageSharp" Version="2.30.15" />

    <!--
      Model import: FBX, glTF, OBJ, COLLADA and the rest of doc 08's ModelImporter
      row, through the Silk.NET binding doc 01 registers. Bindings plus natives:
      Ultz.Native.Assimp ships libassimp for win/linux/macOS on x64 and arm64, so
      the editor and the CLI need nothing installed.

      Editor-and-tooling-only, and more emphatically than the image codec. Assimp
      is a large C++ library that reads two dozen authoring formats; a runtime that
      linked it would carry an FBX parser into every shipped game for a job the
      runtime does not do — a player loads meshes the content build already
      produced.
    -->
    <PackageVersion Include="Silk.NET.Assimp" Version="2.23.0" />
  </ItemGroup>

  <!-- ===== Test stack (docs/plan/12 § "Testing strategy") ===== -->
  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!--
      Property-based testing (docs/plan/01 § Test, docs/plan/12 § "Property-based").
      Pinned at the version current when Vixen.Core.Mathematics was written, which
      is what "latest at bring-up" meant.
    -->
    <PackageVersion Include="CsCheck" Version="4.7.0" />
    <!--
      NSubstitute and Shouldly are the specified assertion/mocking stack
      (docs/plan/12). Added here when the first test needs them; listing unused
      versions would make this file lie about what the repo depends on.
    -->
  </ItemGroup>

</Project>
