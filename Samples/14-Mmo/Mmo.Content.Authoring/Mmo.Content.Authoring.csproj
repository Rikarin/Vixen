<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Samples.Mmo.Authoring</RootNamespace>
        <AssemblyName>Mmo.Content.Authoring</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <Description>
            Writes Samples/14-Mmo/Assets from tables. Run by hand when the shape of the content
            changes; its output is committed, because the content test and the realm both read files
            rather than a generator — and because a thousand hand-typed YAML files would be neither
            reviewable nor consistent. Tools/Vixen.UnicodeTableGen is the precedent.
        </Description>
    </PropertyGroup>

</Project>
