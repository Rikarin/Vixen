<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Samples.Mmo.Content.Tests</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Rendering.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!--
          The real importer, so a YAML mistake in the authored content fails a test rather than a
          launch. ThirdPersonShooter.Frame.Tests is the precedent and the reason is the same: the
          document under test is the game's own file, read through the code that will read it.
        -->
        <ProjectReference Include="..\..\..\Editor\Vixen.Editor.Assets\Vixen.Editor.Assets.csproj" />

        <!--
          ⚠ Mmo.Shared rather than twenty ProjectReferences, and that is the finding this project
          exists to record. The libraries arrive transitively; what matters is that MmoModules.Compose
          is a hard call at a call site, so the twenty assemblies are *loaded* and their module
          initializers have filled SerializerRegistry before a single file is read.
        -->
        <ProjectReference Include="..\Mmo.Shared\Mmo.Shared.csproj" />
    </ItemGroup>

    <!--
      ⚠ The authored tree itself, linked rather than copied. A second copy is the one that drifts,
      and a content test reading a stale copy passes for a build nobody is running.
    -->
    <ItemGroup>
        <None Include="..\Assets\**\*.vxdef;..\Assets\**\*.vxitem;..\Assets\**\*.vxquest;..\Assets\**\*.vxeffect;..\Assets\**\*.vxloot;..\Assets\**\*.vxrecipe;..\Assets\**\*.vxscene"
              Link="Assets\%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <!--
        #1119's ratchet. The TEST profile in `Directory.Build.props` turns documentation generation
        off for every `*.Tests` project, so no `<see cref>` in any test assembly was ever checked —
        and a test's remarks are read at the worst possible moment, when the test has just gone red.
        CS1591 and CS1573 stay suppressed: "this public member has no comment" is a question about a
        packaged API surface, and a test assembly is not one.

        This project reported nothing when the whole tree was measured with the flag forced on, so
        here it is a latch rather than a repair — which is the point. An overload landing beside a
        cref written earlier is not historical rot; #821's own measurement watched it happen inside
        one working session.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
