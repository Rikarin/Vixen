<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Samples.Mmo.Ui</RootNamespace>
        <AssemblyName>Mmo.Ui</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>

        <!--
            ⚠ **This one line is the whole of the UI plumbing, and it used to be forty.** Outside this
            repository it is not even a line: `Vixen.Ui` ships its build assets in `buildTransitive/`,
            so a `PackageReference` to `Vixen.Ui.Controls` brings the VXML compiler, the `.vxml` and
            `.vcss` item types and the utility stylesheet step by itself. In here there are no
            packages and analyzers do not travel through a `ProjectReference`, so
            `Directory.Build.targets` stands in for one — and it is imported after everything written
            below, which is where the globs have to run and used to be a rule the author had to know.
        -->
        <VixenUi>true</VixenUi>

        <!--
            The generated stylesheet keeps the name the hand-written bootstrap had, because it is the
            name the tests and the README already say. `Theme/hud.vcss` goes in as the base sheet and
            the utilities are appended, so `MmoStyles.Css` is exactly what `MmoStyles.Compile()`
            returned — the same two halves in the same order, assembled by the build instead of by a
            static constructor.
        -->
        <VixenUtilityStylesClass>MmoStyles</VixenUtilityStylesClass>
    </PropertyGroup>

    <ItemGroup>
        <!--
            ⚠ **The rules, and not the realm.** ADR-017 is mechanical: the client never references
            anything that speaks Orleans, and this assembly is the client's face. What it *does*
            reference is Mmo.Shared, because a bar that cannot evaluate a requirement cannot grey
            itself out and a vendor row that cannot read a price has to be told one — and being told
            one is how a client and a server come to disagree about what something costs.
        -->
        <ProjectReference Include="..\Mmo.Shared\Mmo.Shared.csproj" />

        <!--
            The interface framework. VXML for the tree and the Tailwind-shaped utilities for
            everything a class name can say both arrive with it: `Vixen.Ui.Controls` depends on
            `Vixen.Ui`, which depends on `Vixen.Ui.Styling.Utilities`, and a package brings its
            dependencies' build assets with it.
        -->
        <ProjectReference Include="..\..\..\Core\Vixen.Ui.Controls\Vixen.Ui.Controls.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            ⚠ **The rules a utility cannot say, handed to the step as its base sheet rather than
            concatenated afterwards.** `hud.vcss` opens with `@layer base, components, utilities;`
            and that statement is what fixes the ladder's order, so it has to be emitted *first*: the
            generated utilities name `utilities` too, and written first they would make it layer zero
            and let a `@layer components` rule declared later beat them. StyleGen puts every base
            sheet ahead of what it generates for exactly this reason, and expands the sheet's
            `@apply` on the way through.
        -->
        <VixenStyleBase Include="Theme/hud.vcss" />

        <!--
            ⚠ **Class names the scanner cannot see, because nothing writes them down whole.** The
            scanner is deliberately over-inclusive — every run of characters that *could* be a class
            name, with the generator discarding the rest — but it cannot see a name that is never
            written: `@Slot.RarityClass.Value` is a property access, and `text-storied` appears
            nowhere. The rule is Tailwind's own: a class name assembled at run time must be
            safelisted, or written out in full in a switch the scanner can read.

            The five rarities and the four resource bars are a closed set that four different panels
            colour by, which is why they are listed rather than spelled out at every use site.
        -->
        <VixenStyleSafelist Include="text-worn" />
        <VixenStyleSafelist Include="text-common" />
        <VixenStyleSafelist Include="text-fine" />
        <VixenStyleSafelist Include="text-rare" />
        <VixenStyleSafelist Include="text-storied" />
        <VixenStyleSafelist Include="border-worn" />
        <VixenStyleSafelist Include="border-common" />
        <VixenStyleSafelist Include="border-fine" />
        <VixenStyleSafelist Include="border-rare" />
        <VixenStyleSafelist Include="border-storied" />
        <VixenStyleSafelist Include="text-health" />
        <VixenStyleSafelist Include="text-mana" />
        <VixenStyleSafelist Include="text-rage" />
        <VixenStyleSafelist Include="text-focus" />
        <VixenStyleSafelist Include="text-cast" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Mmo.Ui.Tests" />
    </ItemGroup>

</Project>
