<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Samples.Mmo.Orchestration</RootNamespace>
        <AssemblyName>Mmo.Orchestrator</AssemblyName>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--
            The silo. Every grain doc 27 ships is already implemented in Vixen.Live.Orchestrator, so
            what a game adds here is its own — for this sample, one: IWorldEventGrain.

            ⚠ It references Mmo.Cluster and never Mmo.Shared. A grain that needed the gameplay
            libraries would be a grain doing simulation, which is the one thing the control plane is
            not for.
        -->
        <ProjectReference Include="..\..\..\Live\Vixen.Live.Orchestrator\Vixen.Live.Orchestrator.csproj" />
        <ProjectReference Include="..\Mmo.Cluster\Mmo.Cluster.csproj" />
    </ItemGroup>

</Project>
