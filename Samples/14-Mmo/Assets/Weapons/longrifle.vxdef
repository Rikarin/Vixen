# Hitscan, so the whole lag-compensation path is exercised: a client claims a hit,
# the realm rewinds and checks it against the rewind budget.
!WeaponDefinition
displayName: Marchwarden Longrifle
kind: Hitscan
range: 60
roundsPerSecond: 1.2
magazine: 6
reserve: 60
reloadTime: 2.4
reloadsPerRound: true
automatic: false
pellets: 1
tags: [ Weapon.Rifle ]
damage:
  amount: 48
  coefficient: 0
  school: Physical
falloff:
  start: 25
  end: 55
  minimum: 0.4
penetration:
  maximumTargets: 2
  damageFraction: 0.5
spread:
  base: 0.4
  perShot: 0.9
  maximum: 4
  recovery: 3
  movingMultiplier: 2.5
  aimingMultiplier: 0.25
recoil:
  recovery: 6
  recoveryDelay: 0.2
  pattern:
    - pitch: 1.4
      yaw: 0.1
    - pitch: 1.1
      yaw: -0.3
    - pitch: 0.9
      yaw: 0.4
