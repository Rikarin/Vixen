# The Emberwright's damage-over-time. Stacks to three and refreshes the lot.
!EffectDefinition
displayName: Kindling
duration: 6
period: 2
stacking: StackTo
maximumStacks: 3
tags: [ Effect.Damage.Fire ]
grantedTags: [ State.Burning ]
cancelOn: [ Event.Cleansed ]
modifiers:
  - attribute: FireTaken
    op: AddPercent
    value: 0.05
