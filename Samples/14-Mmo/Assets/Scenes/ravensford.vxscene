# Ravensford — a ten-a-side battleground. pvp/ravensford names it, and
# pvp/hollow-arena reuses it at three-a-side.
version: 1
name: Ravensford
roots:
  - name: Spawn.Team0
    position: 0 0 -120
  - name: Spawn.Team1
    position: 0 0 120

  # The three capture points, spread so that holding two means giving up the third.
  - name: Objective.Mill
    position: -70 0 -30
  - name: Objective.Ford
    position: 0 0 0
  - name: Objective.Rookery
    position: 70 0 30

  # The payload's route. vehicles/powder-waggon rides it, and the four seats are why
  # a payload is a vehicle rather than a moving trigger.
  - name: Payload.Start
    position: 0 0 96
  - name: Payload.End
    position: 0 0 -96

  # The arena variant fights over the middle only.
  - name: Objective.Hollow
    position: 0 0 0
