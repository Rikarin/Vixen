# The Barrowdeep — a five-player instance. instances/barrowdeep names it.
#
# Three rooms in a line, because the encounter order is the gate: the Choirmaster
# is `isGate: true`, so nobody reaches the King without him.
version: 1
name: Barrowdeep
roots:
  - name: Spawn.Entrance
    position: 0 0 0

  - name: Encounter.Gravewarden
    position: 0 0 -40
  - name: Encounter.Choirmaster
    position: 0 -6 -90
  - name: Encounter.BarrowKing
    position: 0 -12 -150

  # Where a wipe puts the group back. The Gravewarden is `isCheckpoint: true`.
  - name: Checkpoint.Gravewarden
    position: 0 0 -20
  - name: Checkpoint.BarrowKing
    position: 0 -12 -130
