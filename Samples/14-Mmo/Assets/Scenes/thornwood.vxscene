# Thornwood — the higher-level public map, and the transfer target.
#
# See Greenmarch for why this is roots and transforms only.
version: 1
name: Thornwood
roots:
  - name: Spawn.CovenantCamp
    position: 0 0 0
  - name: Poi.CovenantCamp
    position: 0 0 0
  - name: Poi.BarrowGate
    position: 62 -4 -38
  - name: Poi.HangmansOak
    position: -44 0 26
  - name: Poi.SunkenGrove
    position: 20 -8 70

  # travel/barrow-gate. Entering the instance is a placement, not a walk.
  - name: Portal.Barrowdeep
    position: 62 -4 -38

  # spawns/thornwood-dead, leashed tighter than the boars and set to Teleport.
  - name: Camp.Dead.Gate
    position: 54 -2 -30
  - name: Camp.Dead.Oak
    position: -40 0 20
  - name: Camp.Dead.Road
    position: 12 0 -60

  # events/rootbound-colossus. One arena, because a world boss that moves is a world
  # boss the interest grid cannot bound.
  - name: Event.ColossusGrove
    position: 20 -8 70

  - name: Node.Marchbloom.0
    position: -20 0 44
  - name: Node.Marchbloom.1
    position: 40 0 8

  - name: Border.South
    position: 0 0 96
