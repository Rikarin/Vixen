# ⚠ A charter is content and a guild is not. This is what a *new* guild starts
# as; the guild itself is durable state in IGuildGrain.
!GuildCharterDefinition
displayName: Freehold Charter
maximumMembers: 500
tag: Guild.Member
ranks:
  - displayName: Steward
    permissions: []
  - displayName: Marshal
    permissions:
      - Guild.Permission.Invite
      - Guild.Permission.Kick
      - Guild.Permission.Rank
      - Guild.Permission.Withdraw
      - Guild.Permission.Speak
  - displayName: Warden
    permissions:
      - Guild.Permission.Invite
      - Guild.Permission.Speak
  - displayName: Recruit
    permissions:
      - Guild.Permission.Speak
