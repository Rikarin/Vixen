# A counted criterion, which a tag query cannot express: "have all five keys" is
# a standing test and "kill thirty of them" is not.
!AchievementDefinition
displayName: Barrowbane
description: Put the Barrow King back where he came from, thirty times over.
points: 25
tag: Achieved.Barrowbane
unlocks: [ collectibles/title-barrowbane ]
criteria:
  - description: Barrow dead put down
    verb: Event.Kill
    count: 30
    all: [ Creature.Undead ]
    scene: maps/barrowdeep
