!QuestDefinition
displayName: What Walks the Barrows
summary: The dead in the Barrowdeep have stopped staying there.
repeat: Once
shareable: true
tag: Quest.Completed.WhatWalks
requirements:
  - kind: HasTag
    subject: Quest.Completed.ThornwoodRoad
stages:
  - id: scout
    displayName: Thin them out
    objectives:
      - type: Kill
        displayName: Barrow dead
        count: 12
        targetTags: [ Creature.Undead ]
        scene: maps/thornwood
      - type: Discover
        displayName: The barrow entrance
        count: 1
        optional: true
        target: maps/thornwood
rewards:
  experience: 1200
  items:
    - def: items/hearthstone
