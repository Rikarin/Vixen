# Ravensford's payload. Four seats, one of which steers and two of which shoot —
# and the passengers stay when the driver gets off, which is the policy the
# library refuses to decide for you.
!VehicleDefinition
displayName: Powder Waggon
kind: Ground
passengersMaySteer: true
tag: Vehicle.Waggon
physics:
  maximumSpeed: 6
  acceleration: 2
  turnRate: 45
seats:
  - id: driver
    controls: true
    role: Driver
    tag: State.Driving
  - id: left-gun
    role: Gunner
    tag: State.Gunning
  - id: right-gun
    role: Gunner
    tag: State.Gunning
  - id: bench
    role: Passenger
