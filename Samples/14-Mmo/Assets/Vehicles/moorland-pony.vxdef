# A mount is a single-seat vehicle whose model is a creature — doc 28's point,
# and it is why there is no separate mount type in this library.
!VehicleDefinition
displayName: Moorland Pony
kind: Mount
passengersMaySteer: false
tag: Vehicle.Mount.Pony
physics:
  maximumSpeed: 14
  acceleration: 8
  turnRate: 180
seats:
  - id: saddle
    controls: true
    role: Driver
    tag: State.Mounted
