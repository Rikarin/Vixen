# A station rather than a node: no yield, no respawn, and it never runs out.
!InteractableDefinition
displayName: The Greenmarch Forge
verb: Use
channelSeconds: 0
interrupts: Nothing
uses: 0
# ⚠ Explicitly zero. The default is a respawn timer, and a station that never
# runs out has nothing to respawn — the library says so rather than ignoring it.
respawnSeconds: 0
instancing: Shared
grantsTags: [ Station.Forge ]
tag: Station.Greenmarch.Forge
