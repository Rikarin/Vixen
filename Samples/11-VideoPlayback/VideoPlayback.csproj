<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Samples.VideoPlayback</RootNamespace>
        <AssemblyName>VideoPlayback</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Tools\Vixen.App\Vixen.App.csproj" />
        <ProjectReference Include="..\..\Platform\Vixen.Platform.Desktop\Vixen.Platform.Desktop.csproj" />
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Vulkan\Vixen.Graphics.Vulkan.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Graphics.RenderGraph\Vixen.Graphics.RenderGraph.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Video\Vixen.Video.csproj" />

        <!-- The pipeline, the descriptor set and the push block a video is drawn with, so this
             sample is the RHI plus two calls rather than a hand-rolled renderer. -->
        <ProjectReference Include="..\..\Core\Vixen.Video.Rendering\Vixen.Video.Rendering.csproj" />

        <!-- Opus, so the WebM's audio track plays and can be the clock. Referencing it is what pulls
             Concentus in; a game whose video is silent references neither. -->
        <ProjectReference Include="..\..\Core\Vixen.Video.Codecs\Vixen.Video.Codecs.csproj" />

        <!-- Speakers. A machine with none is an ordinary case the sample handles rather than a
             configuration it refuses. -->
        <ProjectReference Include="..\..\Platform\Vixen.Audio.Backend.OpenAL\Vixen.Audio.Backend.OpenAL.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            SPIR-V, committed. The RHI never parses shader source and Raven is not wired into the
            build yet (docs/plan/07), so the sample carries the compiled modules and the GLSL beside
            them. Regenerating is `glslc Shaders/video.frag -o Shaders/video.frag.spv`.
        -->
        <EmbeddedResource Include="Shaders\*.spv" />
    </ItemGroup>

</Project>
