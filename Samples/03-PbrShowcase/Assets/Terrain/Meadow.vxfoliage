# The showcase's one foliage type: the pines standing on the hills around the grid. The mesh
# reference names Tree.obj's PineTree mesh sub-asset; the instances live in Meadow.vxfol beside
# this file, generated by TerrainSeed and committed for the same reason the terrain is.
name: Pine
mesh: vx:035fb27fd0e2477784c28cfcf76b9a47#1323b116
storage: Stored
radius: 2.5
minScale: 0.8
maxScale: 1.3
startCullDistance: 90
endCullDistance: 110
castShadows: true
# FoliageEcology.None spelled out: a zeroed ecology fails its own validation (maxAge 0 is a species
# that never grows), which would refuse the whole volume at extraction.
ecology:
  shadeTolerance: 1
  maxAge: 1
