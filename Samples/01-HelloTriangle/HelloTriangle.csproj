<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Samples.HelloTriangle</RootNamespace>
        <AssemblyName>HelloTriangle</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Tools\Vixen.App\Vixen.App.csproj" />
        <ProjectReference Include="..\..\Platform\Vixen.Platform.Desktop\Vixen.Platform.Desktop.csproj" />
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Vulkan\Vixen.Graphics.Vulkan.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Graphics.RenderGraph\Vixen.Graphics.RenderGraph.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            SPIR-V, committed. The RHI never parses shader source and Raven is not wired into the
            build yet (docs/plan/07), so the sample carries the compiled modules and the GLSL beside
            them. Regenerating is `glslc Shaders/triangle.vert -o Shaders/triangle.vert.spv`. The pair is
            pinned by `CommittedGlslModuleTests`, whose `hand-compiled.sha256` records which source
            each module was built from — so the run-it-and-forget step is now a red test.
        -->
        <EmbeddedResource Include="Shaders\*.spv" />
    </ItemGroup>

</Project>
