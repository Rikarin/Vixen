<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Rendering.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Core\Vixen.Rendering\Vixen.Rendering.csproj" />

        <!--
          The effect set's node kinds, because the document names !Bloom and !ScreenProbeGather and
          the builder cannot know them itself — the same factory registration the game makes in
          OnConfigure, made here for the same reason.
        -->
        <ProjectReference Include="..\..\..\Core\Vixen.Rendering.PostFx\Vixen.Rendering.PostFx.csproj" />

        <!-- The !Terrain node the document splices after the Main pass, and the layer descriptions
             its .vxterrain carries. -->
        <ProjectReference Include="..\..\..\Core\Vixen.Rendering.Terrain\Vixen.Rendering.Terrain.csproj" />

        <!-- The lake's three node kinds — !WaterSurface, !Copy's consumer !Water — on exactly the
             terms above: the document names them and the builder cannot know them itself. -->
        <ProjectReference Include="..\..\..\Core\Vixen.Rendering.Water\Vixen.Rendering.Water.csproj" />

        <!--
          The buoyancy kernel, for RaftFloatsTests: the raft's waterline is asserted by asking the
          shipped spherical cap and the shipped rest displacement, because inverting the cap is a
          cubic and a second copy of it here would be a test that agrees with itself.

          ⚠ Named although it already arrives through Vixen.Rendering.Water. A reference a project
          depends on and does not name is one that disappears the day the transitive path changes,
          and the sample's own csproj says the same thing two lines apart for the same reason.
        -->
        <ProjectReference Include="..\..\..\Core\Vixen.Water\Vixen.Water.csproj" />

        <!--
          The Null backend, so a YAML or wiring mistake in the document fails a test on any machine
          rather than a launch on one with a GPU. Vixen.Rendering.Tests' CompositorAssetTests is the
          pattern this follows.
        -->
        <ProjectReference Include="..\..\..\Platform\Vixen.Graphics.Null\Vixen.Graphics.Null.csproj" />

        <!-- The YAML dialect, to read the actual authored document rather than a copy of it. -->
        <ProjectReference Include="..\..\..\Core\Vixen.Core.Yaml\Vixen.Core.Yaml.csproj" />

        <!-- IPlayerInputSource, ControlRotation and MoveIntent — what ScriptedWalk below implements
             and writes. -->
        <ProjectReference Include="..\..\..\Core\Vixen.Engine\Vixen.Engine.csproj" />
    </ItemGroup>

    <!--
      ⚠ The walk harness's own source, linked rather than referenced. Referencing the game project
      would drag its content build into every `dotnet test`, and this file is a parser and an
      accumulator with no game in it — the same "one copy, linked" argument the documents above are
      included under.
    -->
    <ItemGroup>
        <Compile Include="..\ScriptedWalk.cs" Link="ScriptedWalk.cs" />
    </ItemGroup>

    <!--
      The document under test is the game's own file, linked rather than copied into the source
      tree — a second copy is the one that drifts.
    -->
    <ItemGroup>
        <None Include="..\Assets\Frame.vxcompositor" Link="Assets\Frame.vxcompositor" CopyToOutputDirectory="PreserveNewest" />

        <!--
            The source documents, not the imported artefacts. What these tests assert about a
            material is what an author wrote — that the feature's map name and the textures: entry
            agree — and the import is what turns that into a binding, so reading the artefact would
            be testing the importer twice and the authoring not at all. Globbed rather than listed so
            a new .vxmat is covered by the theory the day it is added.
        -->
        <None Include="..\Assets\Materials\*.vxmat" Link="Assets\Materials\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\Assets\Terrain\Outskirts.vxterrain" Link="Assets\Terrain\Outskirts.vxterrain" CopyToOutputDirectory="PreserveNewest" />

        <!-- The scene and the lake's ring, so the gate arithmetic and the water's two halves are
             checked against the files an author edits rather than against numbers copied here. -->
        <None Include="..\Assets\Scenes\Arena.vxscene" Link="Assets\Scenes\Arena.vxscene" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\Assets\Water\Lake.vxspline" Link="Assets\Water\Lake.vxspline" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
