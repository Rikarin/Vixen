# Ramps: galvanised steel plate. Metal, so it is the surface the sky actually shows in.
#
# ⚠ At metalness 0.9 the tinted map is very nearly the *specular* colour, not a diffuse one —
# `Compute` splits the same value into `diffuseColor * (1 - metalness)` and `F0FromMetalness`. So the
# 6.9 / 6.5 / 5.9 below is not brightening a diffuse surface, it is putting the plate's reflectance
# back where 0.56 0.57 0.60 had it; metal-panel-albedo is a dark image (mean 0.081 0.088 0.101) and a
# metal whose F0 is that dark reflects the dusk sky as almost nothing.
shader: ForwardPlus
shading: StandardShading
features:
  - !TexturedMetalRoughness
    baseColor: 6.946 6.483 5.920
    metalness: 0.9
    roughness: 0.34
    baseColorMap: baseColorMap

  # ⚠ The one that shows most, because this is the level's only metal: a normal map bends the
  # specular lobe, and at roughness 0.34 the lobe is tight enough for the plate's ribs to break the
  # sky's reflection into bands rather than smearing it.
  - !TexturedNormalMap
    normalMap: normalMap
    strength: 1

textures:
  - parameter: baseColorMap
    texture: vx:327689d4b6864968ba80ee4fdade319b
  - parameter: normalMap
    texture: vx:b25f291775fd4b88a02bc3a3ef2c5b00
