# Cover pillars: darker stone, so they separate from the wall behind them.
#
# The same concrete map as the wall, and deliberately the same asset reference: one upload, one
# residency, two materials. The separation the pillars need is in the tint, which is what a tint over
# a shared map is for — 0.17 / 0.1725 is the ~0.99 below, against the wall's 1.74.
shader: ForwardPlus
shading: StandardShading
features:
  - !TexturedMetalRoughness
    baseColor: 0.986 0.986 1.048
    metalness: 0
    roughness: 0.70
    baseColorMap: baseColorMap

  - !TexturedNormalMap
    normalMap: normalMap
    strength: 1

textures:
  - parameter: baseColorMap
    texture: vx:bec393cb4c61452198c3af4408818204
  - parameter: normalMap
    texture: vx:9741806c7d834c58bdd5347a050e8758
