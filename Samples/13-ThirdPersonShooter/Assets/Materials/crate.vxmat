# Crates: timber. The one warm surface in the level, which is what makes them findable.
#
# ⚠ The tint is the largest in the arena and it is arithmetic rather than taste: crate-albedo's mean
# is 0.1351 0.0617 0.0190, so reproducing 0.34 0.21 0.10 needs 2.5 / 3.4 / 5.3. The blue multiplier
# is the one worth checking after any regeneration of the map — the map's blue peaks at 0.033, so
# 5.25 lands its brightest texel at 0.17 and there is room, but a warmer regeneration would push it
# past one, which is an albedo that returns more light than it received.
shader: ForwardPlus
shading: StandardShading
features:
  - !TexturedMetalRoughness
    baseColor: 2.516 3.402 5.251
    metalness: 0
    roughness: 0.82
    baseColorMap: baseColorMap

  # The plank seams, which is the whole of what a crate's normal map is for: the geometry is a box
  # and the map is the only thing that says it is made of boards.
  - !TexturedNormalMap
    normalMap: normalMap
    strength: 1

textures:
  - parameter: baseColorMap
    texture: vx:3a607ea677194091bb56deab8c7ace25
  - parameter: normalMap
    texture: vx:88e0e514dc944772bf20f75f28802c92
