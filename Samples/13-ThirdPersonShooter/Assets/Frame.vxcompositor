# The project's frame. AppGraphics loads this by address — GraphicsOptions.Compositor names it — and
# the moment it exists the host's built-in DefaultFrame is not used.
#
# Doc 22's virtualized geometry and doc 19's dynamic global illumination are both on here, which is
# the whole point of the sample: every node below is one a document can name, and none of it is
# assembled in C#.
version: 2

resources:
  # SceneColour is declared *and* imported: declared so this document is a whole thing the editor or
  # a test can build against a scratch texture, imported at run time so the pass writes the window.
  # An import wins over a declaration of the same name, which is what makes one document run in both.
  - name: SceneColour
    format: Bgra8UNormSrgb
    usage: ColourTarget, Sampled, Storage

  # ⚠ What the scene is actually drawn into, and it is not SceneColour. A shading pass writes
  # radiance — values well past one, which is the whole reason a tonemap exists — and SceneColour is
  # the swapchain's eight bits per channel. Drawing HDR straight into it clips every highlight before
  # the curve that was supposed to shape them ever runs, so the tonemap grades an image that has
  # already lost its range.
  - name: SceneHdr
    format: Rgba16Float
    usage: ColourTarget, Sampled, Storage

  - name: SceneDepth
    format: Depth32Float
    usage: DepthStencilTarget, Sampled

  # Four 2048² cascades side by side, so 8192 × 2048. The size is the node's own arithmetic —
  # ShadowCascades.AtlasSize — written out here because a graph resource has to declare its extent
  # and the node has no way to declare one for it. Getting it wrong is a scissor rectangle outside
  # the texture rather than a message.
  - name: ShadowAtlas
    format: Depth32Float
    usage: DepthStencilTarget, Sampled
    width: 8192
    height: 2048

  # The visibility buffer's identities and the normals doc 19's screen passes read. Both are this
  # document's own — nothing outside the frame has a use for either.
  - name: SceneNormals
    format: Rgba16Float
    usage: ColourTarget, Sampled

  - name: VisibilityBuffer
    format: R32UInt
    usage: ColourTarget, Sampled, Storage

stages:
  - name: Opaque

  # The second stage every object in the level is also extracted into — see
  # GraphicsOptions.CasterStages, which is what puts the bit in the mask, because a frame document
  # cannot decide what an object is extracted as.
  #
  # `shader: ShadowCaster` is the override: a shadow map records depth, so a caster has no business
  # evaluating a BRDF, and `composeFromMaterial` stays off because ShadowCaster declares no surface
  # slot — composing would split the variant cache once per material for shaders that compile to
  # identical bytes.
  #
  # ⚠ Front faces, not back. Rendering the far side of a caster into the atlas puts the recorded
  # depth behind the surface being tested, which is the cheapest way there is to stop a closed mesh
  # from shadow-acne'ing itself. The two biases are the leftover, and they are small because the
  # cull is doing most of the work.
  - name: Shadow
    shader: ShadowCaster
    cull: Front
    depthBias: 1.5
    depthBiasSlope: 2.5
    depthClamp: true


game: !Sequence
  name: Frame
  children:
    # ── doc 19 § L1: the clipmap every trace marches ────────────────────────────────────────────
    # The field itself is the host's — see ThirdPersonShooterGame.OnConfigure. With none supplied
    # this node does nothing rather than throwing, which is what lets this file open in an editor
    # that has not started the game.
    - !GlobalDistanceField
      name: Clipmap
      # ⚠ The *qualified* name, and it is not the same string the consumer below writes. A composed
      # slot's bindings are named for the slot — <pass>.<composed type> — so the clipmap writes
      # `DistanceFieldAo.GlobalDistanceField.distanceFieldVolumes[0]` and the pass reading it names
      # the bare type. Getting these the wrong way round refuses to compile, which is the good case;
      # getting one of them merely misspelt is a march that reads nothing and says nothing.
      shader: DistanceFieldAo.GlobalDistanceField

    # ── doc 19 § L2: the probes that carry bounced light ────────────────────────────────────────
    # ⚠ `passes` is not a quality setting. The default is IndirectDiffuse alone — the screen pass that
    # needs no material change — and adding ForwardPlus is what hands the field's five volumes and its
    # samplers to the shading pass's set 0. The material is compiled with UseIrradianceField on, so
    # ForwardPlus *declares* those bindings; EffectSetWriter fills a set whole or not at all, so this
    # line missing is not dimmer indirect light, it is every draw in the Main pass refused.
    - !IrradianceField
      name: Probes
      budget: 16
      dilationPasses: 1
      passes:
        - IndirectDiffuse
        - ForwardPlus

    # ── the sun's cascades ──────────────────────────────────────────────────────────────────────
    # Before anything that shades, because the Main pass reads the atlas this fills.
    #
    # `view: Camera` is not optional decoration: with it empty the node fits every cascade to its own
    # fallback camera, which looks down −Z from the origin — shadows correct for a view nobody is
    # looking through and absent from the one that exists. The sun comes from the builder rather than
    # from this file, because the light the frame shades with and the light it casts from have to be
    # one fact.
    - !ShadowMap
      name: Sun
      stage: Shadow
      atlas: ShadowAtlas
      view: Camera
      cascadeCount: 4
      resolution: 2048
      shadowDistance: 90.0
      splitLambda: 0.85

    # ── doc 22: the virtualized traversal and the visibility buffer ─────────────────────────────
    - !ClusterCulling
      name: Traversal

    - !VisibilityBuffer
      name: Visibility
      output: VisibilityBuffer
      depth: SceneDepth
      colour: SceneHdr

    # ── the classic pass, sharing one depth with the visibility buffer so the two occlude each
    #    other. A resolve with a depth of its own would be two frames composited.
    - !RenderPass
      name: Main
      colourTargets: [SceneHdr, SceneNormals]
      depthTarget: SceneDepth

      # The background, in the same radiance the environment cube's horizon carries — so the space
      # above the walls reads as sky rather than as a hole. It is a flat colour and not a skybox: a
      # gradient one needs a pass that samples the environment cube along the view ray, which needs a
      # node kind, because a document can only bind resources the frame graph owns and that cube is
      # the host's. Named here rather than left black because black is what a missing pass looks like.
      clearColour: 1.15 1.22 1.35

      # ⚠ The consuming pass publishes, not the producing one. A graph resource's barrier belongs to
      # whoever declared it read, so the shadow node can hand over its matrices and its sampler and
      # cannot hand over the texture — this line is the other half, and without it set 0's
      # `shadowMap` is still the one-texel stand-in while four cascades are drawn into an atlas
      # nothing samples.
      sceneTextures:
        - binding: shadowMap
          resource: ShadowAtlas

      children:
        - !SingleStage
          name: Opaque
          view: Camera
          stage: Opaque

    # ── doc 19's two screen passes ──────────────────────────────────────────────────────────────
    # `source` is the *type* bound to this pass's `distanceField` compose slot — see Clipmap above
    # for the other half of the pair.
    - !DistanceFieldAo
      name: Occlusion
      depth: SceneDepth
      normals: SceneNormals
      source: GlobalDistanceField
      output: AmbientOcclusion
      sunShadow: true

    - !IndirectDiffuse
      name: Indirect
      depth: SceneDepth
      normals: SceneNormals
      output: IndirectDiffuse
      intensity: 1.0

    # ── the frame ends here: radiance in, the swapchain's eight bits out ────────────────────────
    # ⚠ `source` is the HDR target and `output` is the imported swapchain image, and this document
    # used to read `Bloom` here. That was a black screen, and a subtle one: !Bloom publishes the
    # *pyramid* — the blurred part of the image above `threshold`, "for whatever composites it" — not
    # the scene with a glow added. Tonemapping it alone throws the scene away, and a level lit below
    # a threshold of one leaves a pyramid of zeroes. Every counter in the run said the frame drew.
    #
    # Bloom is gone rather than fixed because the node set cannot yet composite it: there is no
    # additive-resolve node, and a !FullScreen doing the job by hand would put a shader's binding
    # names in a document. That is engine work, and a sample is the wrong place to fake it.
    - !Tonemap
      name: Tonemap
      source: SceneHdr
      output: SceneColour
      operator: 1
      exposure: 1.0
      whitePoint: 4.0
      contrast: 1.02
      saturation: 1.05
