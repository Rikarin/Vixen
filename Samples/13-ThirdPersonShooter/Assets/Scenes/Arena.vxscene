      - !BoxCollision { halfExtents: 0.8 0.8 0.8, centre: 0 0.8 0, friction: 0.4 }

  # Low platforms, which is what makes the character controller's step-up visible.
  - name: Ramp0
    position: -18 0 0
    rotation: 0 0.000000 0 1.000000
    components:
      - !MeshRenderable { mesh: vx:435c0f1a64cb419293ccfb1aa3b704da#a18ec01a, material: vx:f99df634346544ab8ead4d935654f613, castsShadows: true }
      - !BoxCollision { halfExtents: 3 0.2 1.5, centre: 0 0.2 0, friction: 0.8 }
  - name: Ramp1
    position: 18 0 6
    rotation: 0 0.707107 0 0.707107
    components:
      - !MeshRenderable { mesh: vx:435c0f1a64cb419293ccfb1aa3b704da#a18ec01a, material: vx:f99df634346544ab8ead4d935654f613, castsShadows: true }
      - !BoxCollision { halfExtents: 3 0.2 1.5, centre: 0 0.2 0, friction: 0.8 }
  - name: Ramp2
    position: 4 0 -18
    rotation: 0 0.382683 0 0.923880
    components:
      - !MeshRenderable { mesh: vx:435c0f1a64cb419293ccfb1aa3b704da#a18ec01a, material: vx:f99df634346544ab8ead4d935654f613, castsShadows: true }
      - !BoxCollision { halfExtents: 3 0.2 1.5, centre: 0 0.2 0, friction: 0.8 }

  # Tall blockers, so the distance field has something to occlude with.
  - name: Pillar0
    position: -22 0 -22
    components:
      - !MeshRenderable { mesh: vx:454ef093f16c4faaaada6bd0f29c9d50#225b2af3, material: vx:6fadebfa06e24365b0f11f25b88de765, castsShadows: true }
      - !BoxCollision { halfExtents: 0.5 2.5 0.5, centre: 0 2.5 0, friction: 0.4 }
  - name: Pillar1
    position: 22 0 -22
    components:
      - !MeshRenderable { mesh: vx:454ef093f16c4faaaada6bd0f29c9d50#225b2af3, material: vx:6fadebfa06e24365b0f11f25b88de765, castsShadows: true }
      - !BoxCollision { halfExtents: 0.5 2.5 0.5, centre: 0 2.5 0, friction: 0.4 }
  - name: Pillar2
    position: -22 0 22
    components:
      - !MeshRenderable { mesh: vx:454ef093f16c4faaaada6bd0f29c9d50#225b2af3, material: vx:6fadebfa06e24365b0f11f25b88de765, castsShadows: true }
      - !BoxCollision { halfExtents: 0.5 2.5 0.5, centre: 0 2.5 0, friction: 0.4 }
  - name: Pillar3
    position: 22 0 22
    components:
      - !MeshRenderable { mesh: vx:454ef093f16c4faaaada6bd0f29c9d50#225b2af3, material: vx:6fadebfa06e24365b0f11f25b88de765, castsShadows: true }
      - !BoxCollision { halfExtents: 0.5 2.5 0.5, centre: 0 2.5 0, friction: 0.4 }

  # The key light. A directional light has no position; its rotation is the direction it faces.
  #
  # ⚠ Six degrees above the horizon, and that is a physical claim rather than a mood. At six degrees
  # the sun is nine air masses away instead of one, so it delivers about fourteen thousand lux instead
  # of a hundred thousand and arrives deep orange — Rayleigh scattering takes forty times more blue
  # than red out of it over that path. The rotation is a yaw of 145° and a pitch of −6°, so the light
  # travels almost horizontally across the arena and every pillar throws a shadow the length of the
  # floor.
  #
  # ⚠ Two degrees was tried, and the reason it is not here is worth having written down, because it
  # is the tension in every "moody lantern-lit sunset" ever asked for. Dropping the sun to two degrees
  # dims it to eleven hundred lux, which does make an ordinary fitting readable — and it dims it to
  # *below the sky*, which leaves the level lit almost entirely by a large soft source and therefore
  # with no shadows worth the name. Strong shadows want the disc above the diffuse sky, which happens
  # at five degrees and up; readable fittings want it below, which happens at one and down. They do
  # not overlap, and the way out is not to move the sun: it is that an arena's lamps are floodlights.
  # See below.
  #
  # What did have to change is PhysicalSky.DiffuseScale. Preetham's fit leaves the sky at about
  # 2350 cd/m² here where a clear sky measures 1400, so before that correction the ambient was nearly
  # twice the sun and the level was flat whatever the lamps did.
  #
  # The intensity and the colour below are what `PhysicalSky` computes for that elevation, and the
  # game recomputes them at load — see Arena.SunFromSky. They are written out so the level reads
  # sensibly in an editor that is not running the game, and they cannot drift, because the running
  # game overwrites them from the same atmosphere the sky cube is baked from.
  - name: Sun
    position: 0 0 0
    rotation: -0.015738 0.952410 0.049920 0.300294
    components:
      - !Light { kind: Directional, unit: Lux, colour: 1 0.62 0.18, intensity: 13782 }

  # Fifteen lanterns, and they are the point of the level rather than decoration on it: nothing here
  # is baked, so a lamp switched off at run time changes the bounce as well as the direct light —
  # which is what doc 19's probe field is for.
  #
  # ⚠ Lumens, not a multiplier, and this is where the tension above is resolved. These were 3000–7000
  # lm, which is a domestic bulb, and a domestic bulb under a fourteen-thousand-lux sun contributes
  # about a thousandth of the light on the ground — invisible, correctly. 110–260 klm at 1850–2200 K
  # is a high-pressure sodium floodlight: the 1000 and 2000 W fittings on the masts round a real
  # sports ground, which are exactly this orange and exactly this bright, and which are switched on
  # before sunset for exactly this reason. Under one of them the pool on the floor is a fifth of the
  # sky's contribution and most of it in a pillar's shadow, which is what "ambient lanterns" means
  # when the numbers are real.
  #
  # Nothing here is an artistic multiplier. The fitting got bigger, to a size that exists.
  #
  # The glass is warm because `temperature` says the arc is 1900 K and not because somebody typed an
  # orange into `colour`. `radius` is the emitter's own size, which widens the specular highlight
  # rather than the reach.
  - name: Lamp0
    position: -16 2.6 -16
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 150000, temperature: 1900, range: 26, radius: 0.14 }
      - !VfxEmitter { effect: vx:611abda7a814472b9618b8eda16e61b6, playing: true, reach: 4.0, rise: 1.6 }
  - name: Lamp1
    position: 16 2.6 -16
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 150000, temperature: 1900, range: 26, radius: 0.14 }
      - !VfxEmitter { effect: vx:611abda7a814472b9618b8eda16e61b6, playing: true, reach: 4.0, rise: 1.6 }
  - name: Lamp2
    position: -16 2.6 16
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 150000, temperature: 2000, range: 26, radius: 0.14 }
      - !VfxEmitter { effect: vx:611abda7a814472b9618b8eda16e61b6, playing: true, reach: 4.0, rise: 1.6 }
  - name: Lamp3
    position: 16 2.6 16
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 150000, temperature: 2000, range: 26, radius: 0.14 }
      - !VfxEmitter { effect: vx:611abda7a814472b9618b8eda16e61b6, playing: true, reach: 4.0, rise: 1.6 }
  - name: Lamp4
    position: 0 3.4 0
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 260000, temperature: 2100, range: 34, radius: 0.16 }
