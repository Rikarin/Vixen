  - name: HouseBLintel
    position: 13 2.2 -9.5
    scale: 1.1250 0.5000 0.1875
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 0.9 0.4 0.15, centre: 0 0.4 0, friction: 0.5 }
  - name: HouseBWallW
    position: 9.5 0 -13
    scale: 0.1875 1.8750 4.0000
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 0.15 1.5 3.2, centre: 0 1.5 0, friction: 0.5 }
