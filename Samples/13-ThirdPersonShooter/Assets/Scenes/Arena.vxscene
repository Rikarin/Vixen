# The arena.
#
# Hand-written and editor-readable: the editor's scene panel loads this, rewrites it on save,
# and the content build compiles it into the chunk the game loads by address. Every mesh
# reference is a guid minted by `vixen import` and recorded in the .obj's committed .meta —
# which is why those .meta files are content and not a cache.
version: 1
name: Arena
roots:
  # A 64 m box of ground, its top at y = 0.
  - name: Floor
    position: 0 0 0
    components:
      - !MeshRenderable { mesh: vx:833ecd4f4b9e4de68770140c94e40c33#21d4ea2f, material: vx:dfb64c6f6a7b4fe5a33d5626e0f73720, castsShadows: true }
      - !BoxCollision { halfExtents: 32 0.5 32, centre: 0 -0.5 0, friction: 0.8 }

  # Four walls, each turned to face in.
  - name: Wall0
    position: 0 0 -32
    rotation: 0 0.000000 0 1.000000
    components:
      - !MeshRenderable { mesh: vx:e4b609c49f644f1baa1dbb75b4f25c2c#f3d9d64d, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 32 3 0.5, centre: 0 3 0, friction: 0.4 }
  - name: Wall1
    position: 0 0 32
    rotation: 0 1.000000 0 0.000000
    components:
      - !MeshRenderable { mesh: vx:e4b609c49f644f1baa1dbb75b4f25c2c#f3d9d64d, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 32 3 0.5, centre: 0 3 0, friction: 0.4 }
  - name: Wall2
    position: -32 0 0
    rotation: 0 0.707107 0 0.707107
    components:
      - !MeshRenderable { mesh: vx:e4b609c49f644f1baa1dbb75b4f25c2c#f3d9d64d, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 32 3 0.5, centre: 0 3 0, friction: 0.4 }
  - name: Wall3
    position: 32 0 0
    rotation: 0 -0.707107 0 0.707107
    components:
      - !MeshRenderable { mesh: vx:e4b609c49f644f1baa1dbb75b4f25c2c#f3d9d64d, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 32 3 0.5, centre: 0 3 0, friction: 0.4 }

  # Cover to run behind and vault onto.
  - name: Crate0
    position: -8 0 -6
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:ce6f44a9d82149d3bf50c6d30381b440, castsShadows: true }
      - !BoxCollision { halfExtents: 0.8 0.8 0.8, centre: 0 0.8 0, friction: 0.4 }
  - name: Crate1
    position: -6 0 4
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:ce6f44a9d82149d3bf50c6d30381b440, castsShadows: true }
      - !BoxCollision { halfExtents: 0.8 0.8 0.8, centre: 0 0.8 0, friction: 0.4 }
  - name: Crate2
    position: 7 0 -9
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:ce6f44a9d82149d3bf50c6d30381b440, castsShadows: true }
      - !BoxCollision { halfExtents: 0.8 0.8 0.8, centre: 0 0.8 0, friction: 0.4 }
  - name: Crate3
    position: 10 0 5
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:ce6f44a9d82149d3bf50c6d30381b440, castsShadows: true }
      - !BoxCollision { halfExtents: 0.8 0.8 0.8, centre: 0 0.8 0, friction: 0.4 }
  - name: Crate4
    position: 0 0 12
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:ce6f44a9d82149d3bf50c6d30381b440, castsShadows: true }
      - !BoxCollision { halfExtents: 0.8 0.8 0.8, centre: 0 0.8 0, friction: 0.4 }
  - name: Crate5
    position: -14 0 10
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:ce6f44a9d82149d3bf50c6d30381b440, castsShadows: true }
      - !BoxCollision { halfExtents: 0.8 0.8 0.8, centre: 0 0.8 0, friction: 0.4 }
  - name: Crate6
    position: 13 0 -2
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:ce6f44a9d82149d3bf50c6d30381b440, castsShadows: true }
      - !BoxCollision { halfExtents: 0.8 0.8 0.8, centre: 0 0.8 0, friction: 0.4 }

  # Low platforms, which is what makes the character controller's step-up visible.
  - name: Ramp0
    position: -18 0 0
    rotation: 0 0.000000 0 1.000000
    components:
      - !MeshRenderable { mesh: vx:435c0f1a64cb419293ccfb1aa3b704da#a18ec01a, material: vx:f99df634346544ab8ead4d935654f613, castsShadows: true }
      - !BoxCollision { halfExtents: 3 0.2 1.5, centre: 0 0.2 0, friction: 0.8 }
  - name: Ramp1
    position: 18 0 6
    rotation: 0 0.707107 0 0.707107
    components:
      - !MeshRenderable { mesh: vx:435c0f1a64cb419293ccfb1aa3b704da#a18ec01a, material: vx:f99df634346544ab8ead4d935654f613, castsShadows: true }
      - !BoxCollision { halfExtents: 3 0.2 1.5, centre: 0 0.2 0, friction: 0.8 }
  - name: Ramp2
    position: 4 0 -18
    rotation: 0 0.382683 0 0.923880
    components:
      - !MeshRenderable { mesh: vx:435c0f1a64cb419293ccfb1aa3b704da#a18ec01a, material: vx:f99df634346544ab8ead4d935654f613, castsShadows: true }
      - !BoxCollision { halfExtents: 3 0.2 1.5, centre: 0 0.2 0, friction: 0.8 }

  # Tall blockers, so the distance field has something to occlude with.
  - name: Pillar0
    position: -22 0 -22
    components:
      - !MeshRenderable { mesh: vx:454ef093f16c4faaaada6bd0f29c9d50#225b2af3, material: vx:6fadebfa06e24365b0f11f25b88de765, castsShadows: true }
      - !BoxCollision { halfExtents: 0.5 2.5 0.5, centre: 0 2.5 0, friction: 0.4 }
  - name: Pillar1
    position: 22 0 -22
    components:
      - !MeshRenderable { mesh: vx:454ef093f16c4faaaada6bd0f29c9d50#225b2af3, material: vx:6fadebfa06e24365b0f11f25b88de765, castsShadows: true }
      - !BoxCollision { halfExtents: 0.5 2.5 0.5, centre: 0 2.5 0, friction: 0.4 }
  - name: Pillar2
    position: -22 0 22
    components:
      - !MeshRenderable { mesh: vx:454ef093f16c4faaaada6bd0f29c9d50#225b2af3, material: vx:6fadebfa06e24365b0f11f25b88de765, castsShadows: true }
      - !BoxCollision { halfExtents: 0.5 2.5 0.5, centre: 0 2.5 0, friction: 0.4 }
  - name: Pillar3
    position: 22 0 22
    components:
      - !MeshRenderable { mesh: vx:454ef093f16c4faaaada6bd0f29c9d50#225b2af3, material: vx:6fadebfa06e24365b0f11f25b88de765, castsShadows: true }
      - !BoxCollision { halfExtents: 0.5 2.5 0.5, centre: 0 2.5 0, friction: 0.4 }

  # The key light. A directional light has no position; its rotation is the direction it faces.
  #
  # ⚠ Six degrees above the horizon, and that is a physical claim rather than a mood. At six degrees
  # the sun is nine air masses away instead of one, so it delivers about fourteen thousand lux instead
  # of a hundred thousand and arrives deep orange — Rayleigh scattering takes forty times more blue
  # than red out of it over that path. The rotation is a yaw of 145° and a pitch of −6°, so the light
  # travels almost horizontally across the arena and every pillar throws a shadow the length of the
  # floor.
  #
  # ⚠ Two degrees was tried, and the reason it is not here is worth having written down, because it
  # is the tension in every "moody lantern-lit sunset" ever asked for. Dropping the sun to two degrees
  # dims it to eleven hundred lux, which does make an ordinary fitting readable — and it dims it to
  # *below the sky*, which leaves the level lit almost entirely by a large soft source and therefore
  # with no shadows worth the name. Strong shadows want the disc above the diffuse sky, which happens
  # at five degrees and up; readable fittings want it below, which happens at one and down. They do
  # not overlap, and the way out is not to move the sun: it is that an arena's lamps are floodlights.
  # See below.
  #
  # What did have to change is PhysicalSky.DiffuseScale. Preetham's fit leaves the sky at about
  # 2350 cd/m² here where a clear sky measures 1400, so before that correction the ambient was nearly
  # twice the sun and the level was flat whatever the lamps did.
  #
  # The intensity and the colour below are what `PhysicalSky` computes for that elevation, and the
  # game recomputes them at load — see Arena.SunFromSky. They are written out so the level reads
  # sensibly in an editor that is not running the game, and they cannot drift, because the running
  # game overwrites them from the same atmosphere the sky cube is baked from.
  - name: Sun
    position: 0 0 0
    rotation: -0.015738 0.952410 0.049920 0.300294
    components:
      - !Light { kind: Directional, unit: Lux, colour: 1 0.62 0.18, intensity: 13782 }

  # Fifteen lanterns, and they are the point of the level rather than decoration on it: nothing here
  # is baked, so a lamp switched off at run time changes the bounce as well as the direct light —
  # which is what doc 19's probe field is for.
  #
  # ⚠ Lumens, not a multiplier, and this is where the tension above is resolved. These were 3000–7000
  # lm, which is a domestic bulb, and a domestic bulb under a fourteen-thousand-lux sun contributes
  # about a thousandth of the light on the ground — invisible, correctly. 110–260 klm at 1850–2200 K
  # is a high-pressure sodium floodlight: the 1000 and 2000 W fittings on the masts round a real
  # sports ground, which are exactly this orange and exactly this bright, and which are switched on
  # before sunset for exactly this reason. Under one of them the pool on the floor is a fifth of the
  # sky's contribution and most of it in a pillar's shadow, which is what "ambient lanterns" means
  # when the numbers are real.
  #
  # Nothing here is an artistic multiplier. The fitting got bigger, to a size that exists.
  #
  # The glass is warm because `temperature` says the arc is 1900 K and not because somebody typed an
  # orange into `colour`. `radius` is the emitter's own size, which widens the specular highlight
  # rather than the reach.
  - name: Lamp0
    position: -16 2.6 -16
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 150000, temperature: 1900, range: 26, radius: 0.14 }
  - name: Lamp1
    position: 16 2.6 -16
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 150000, temperature: 1900, range: 26, radius: 0.14 }
  - name: Lamp2
    position: -16 2.6 16
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 150000, temperature: 2000, range: 26, radius: 0.14 }
  - name: Lamp3
    position: 16 2.6 16
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 150000, temperature: 2000, range: 26, radius: 0.14 }
  - name: Lamp4
    position: 0 3.4 0
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 260000, temperature: 2100, range: 34, radius: 0.16 }
  - name: Lamp5
    position: -8 2.2 14
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 130000, temperature: 1850, range: 24, radius: 0.14 }
  - name: Lamp6
    position: 9 2.2 -14
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 130000, temperature: 1850, range: 24, radius: 0.14 }
  - name: Lamp7
    position: -22 1.6 -8
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 130000, temperature: 1900, range: 24, radius: 0.14 }
  - name: Lamp8
    position: 22 1.6 8
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 130000, temperature: 1900, range: 24, radius: 0.14 }
  - name: Lamp9
    position: -4 1.4 -22
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 110000, temperature: 2000, range: 22, radius: 0.12 }
  - name: Lamp10
    position: 5 1.4 22
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 110000, temperature: 2000, range: 22, radius: 0.12 }
  - name: Lamp11
    position: -12 1.2 2
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 110000, temperature: 1850, range: 22, radius: 0.12 }
  - name: Lamp12
    position: 12 1.2 -3
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 110000, temperature: 1850, range: 22, radius: 0.12 }
  - name: Lamp13
    position: -20 2.8 20
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 140000, temperature: 2200, range: 26, radius: 0.14 }
  - name: Lamp14
    position: 20 2.8 -20
    components:
      - !MeshRenderable { mesh: vx:35affda647ed441593518eb867ab6cee#c1bfa30a, material: vx:a39d681a76b0447d8a267c219693c170, castsShadows: true }
      - !Light { kind: Point, unit: Lumen, intensity: 140000, temperature: 2200, range: 26, radius: 0.14 }

  # Where players come in. Found by component, because a compiled scene carries no name table
  # a running game can query — see SpawnPoint.
  - name: Spawn0
    position: -20 0.2 -20
    rotation: 0 0.382683 0 0.923880
    components:
      - !SpawnPoint { index: 0 }
  - name: Spawn1
    position: 20 0.2 -20
    rotation: 0 -0.382683 0 0.923880
    components:
      - !SpawnPoint { index: 1 }
  - name: Spawn2
    position: -20 0.2 20
    rotation: 0 0.923880 0 0.382683
    components:
      - !SpawnPoint { index: 2 }
  - name: Spawn3
    position: 20 0.2 20
    rotation: 0 -0.923880 0 0.382683
    components:
      - !SpawnPoint { index: 3 }


  # ── somewhere with an inside ────────────────────────────────────────────────────────────────
  # Three boxes with doorways, because every measurement this level makes is an outdoor one and
  # half the things the frame does only show indoors. A closed room is where ambient occlusion has
  # a corner to darken, where the exposure meter has something to adapt *to*, and where a
  # post-process volume has a threshold to cross.
  #
  # ⚠ **`scale` moves the mesh and does not move the collider.** `BoxCollision.halfExtents` is read
  # straight into a shape by `Arena.BuildCollision`, which never looks at the transform — so the two
  # numbers on each entity below describe the same box in two different units and have to be kept
  # in step by hand. The mesh is the 1.6 m crate cube with its origin at its base, so a scale is the
  # wanted size over 1.6 and the half-extents are the wanted size over two.
  #
  # ⚠ Each bulb is 1 400 lm at 2 700 K — a domestic fitting, and a thousandth of what the sodium
  # floodlights outside deliver. That is the correct number and it is *why* these rooms are worth
  # having: outdoors it would be invisible, and indoors it is the only light there is.

  # HouseA — a 8 m box with a 1.8 m doorway on its south side.
  - name: HouseAWallN
    position: -14 0 4
    scale: 5.0000 2.0000 0.1875
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 4 1.6 0.15, centre: 0 1.6 0, friction: 0.5 }
  - name: HouseAWallS0
    position: -16.45 0 12
    scale: 1.9375 2.0000 0.1875
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 1.55 1.6 0.15, centre: 0 1.6 0, friction: 0.5 }
  - name: HouseAWallS1
    position: -11.55 0 12
    scale: 1.9375 2.0000 0.1875
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 1.55 1.6 0.15, centre: 0 1.6 0, friction: 0.5 }
  - name: HouseALintel
    position: -14 2.2 12
    scale: 1.1250 0.6250 0.1875
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 0.9 0.5 0.15, centre: 0 0.5 0, friction: 0.5 }
  - name: HouseAWallW
    position: -18 0 8
    scale: 0.1875 2.0000 4.6250
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 0.15 1.6 3.7, centre: 0 1.6 0, friction: 0.5 }
  - name: HouseAWallE
    position: -10 0 8
    scale: 0.1875 2.0000 4.6250
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 0.15 1.6 3.7, centre: 0 1.6 0, friction: 0.5 }
  - name: HouseARoof
    position: -14 3.2 8
    scale: 5.3750 0.1875 5.3750
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:dfb64c6f6a7b4fe5a33d5626e0f73720, castsShadows: true }
      - !BoxCollision { halfExtents: 4.3 0.15 4.3, centre: 0 0.15 0, friction: 0.5 }
  - name: HouseABulb
    position: -14 2.75 8
    components:
      - !Light { kind: Point, unit: Lumen, intensity: 1400, temperature: 2700, range: 8, radius: 0.05 }

  # HouseB — a 7 m box with a 1.8 m doorway on its south side.
  - name: HouseBWallN
    position: 13 0 -16.5
    scale: 4.3750 1.8750 0.1875
    components:
