      - !BoxCollision { halfExtents: 0.15 1.5 3.65, centre: 0 1.5 0, friction: 0.5 }
  - name: HouseBWallE
    position: 16.5 0 -13
    scale: 0.1875 1.8750 4.5625
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 0.15 1.5 3.65, centre: 0 1.5 0, friction: 0.5 }
  - name: HouseBRoof
    position: 13 3 -13
    scale: 4.7500 0.1875 4.7500
    components:
      - !MeshRenderable { mesh: vx:37b8ae38d99d4be19b8b772f06d08e05#c9030bac, material: vx:dfb64c6f6a7b4fe5a33d5626e0f73720, castsShadows: true }
