# The arena.
#
# Hand-written and editor-readable: the editor's scene panel loads this, rewrites it on save,
# and the content build compiles it into the chunk the game loads by address. Every mesh
# reference is a guid minted by `vixen import` and recorded in the .obj's committed .meta —
# which is why those .meta files are content and not a cache.
version: 1
name: Arena
roots:
  # A 64 m box of ground, its top at y = 0.
  - name: Floor
    position: 0 0 0
    components:
      - !MeshRenderable { mesh: vx:833ecd4f4b9e4de68770140c94e40c33#21d4ea2f, material: vx:dfb64c6f6a7b4fe5a33d5626e0f73720, castsShadows: true }
      - !BoxCollision { halfExtents: 32 0.5 32, centre: 0 -0.5 0, friction: 0.8 }

  # Four walls, each turned to face in, and each with an eight-metre gate cut out of the middle of it.
  #
  # ⚠ **The gate is cut by splitting the entity, not by editing the mesh, and that is what keeps the
  # hole you can see and the hole you can walk through in step.** `arena-wall.obj` is 64 × 6 × 1 with
  # its base at y = 0, so one entity carries `scale` on x and the `!BoxCollision` beside it carries
  # half-extents in metres — two numbers from one arithmetic:
  #
  #     segment  = (64 − gate) / 2 = 28 m
  #     scale.x  = segment / 64    = 0.4375
  #     halfX    = segment / 2     = 14
  #     offset   = (gate + segment) / 2 = 18 m along the wall's own x
  #
  # That is `HouseAWallS0`/`S1`'s doorway trick a hundred lines down, on the perimeter instead of on a
  # shed, and it is stated here because the two halves are authored independently and nothing in the
  # build checks that they agree. `FrameDocumentTests.Every_gate_is_the_same_hole_in_the_mesh_and_in_the_collider`
  # is what checks it — a hole you can see and not walk through, or walk through and not see, is worse
  # than no hole at all.
  #
  # ⚠ **And this changes the light, deliberately.** A six-degree sun behind a six-metre wall throws a
  # fifty-seven-metre shadow, which is why nearly everything in here is in shade; four gates let four
  # bars of direct sun across the floor as the sun orbits, and the floor is no longer uniformly dark.
  # That is the level looking different, not the level looking wrong.
  # The north gate, which is the one the lake is through.
  - name: Wall0A
    position: -18 0 -32
    rotation: 0 0.000000 0 1.000000
    scale: 0.4375 1 1
    components:
      - !MeshRenderable { mesh: vx:e4b609c49f644f1baa1dbb75b4f25c2c#f3d9d64d, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 14 3 0.5, centre: 0 3 0, friction: 0.4 }
  - name: Wall0B
    position: 18 0 -32
    rotation: 0 0.000000 0 1.000000
    scale: 0.4375 1 1
    components:
      - !MeshRenderable { mesh: vx:e4b609c49f644f1baa1dbb75b4f25c2c#f3d9d64d, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 14 3 0.5, centre: 0 3 0, friction: 0.4 }
  - name: Wall1A
    position: -18 0 32
    rotation: 0 1.000000 0 0.000000
    scale: 0.4375 1 1
    components:
      - !MeshRenderable { mesh: vx:e4b609c49f644f1baa1dbb75b4f25c2c#f3d9d64d, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 14 3 0.5, centre: 0 3 0, friction: 0.4 }
  - name: Wall1B
    position: 18 0 32
    rotation: 0 1.000000 0 0.000000
    scale: 0.4375 1 1
    components:
      - !MeshRenderable { mesh: vx:e4b609c49f644f1baa1dbb75b4f25c2c#f3d9d64d, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 14 3 0.5, centre: 0 3 0, friction: 0.4 }
  - name: Wall2A
    position: -32 0 -18
    rotation: 0 0.707107 0 0.707107
    scale: 0.4375 1 1
    components:
      - !MeshRenderable { mesh: vx:e4b609c49f644f1baa1dbb75b4f25c2c#f3d9d64d, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 14 3 0.5, centre: 0 3 0, friction: 0.4 }
  - name: Wall2B
    position: -32 0 18
    rotation: 0 0.707107 0 0.707107
    scale: 0.4375 1 1
    components:
      - !MeshRenderable { mesh: vx:e4b609c49f644f1baa1dbb75b4f25c2c#f3d9d64d, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 14 3 0.5, centre: 0 3 0, friction: 0.4 }
  - name: Wall3A
    position: 32 0 -18
    rotation: 0 -0.707107 0 0.707107
    scale: 0.4375 1 1
    components:
      - !MeshRenderable { mesh: vx:e4b609c49f644f1baa1dbb75b4f25c2c#f3d9d64d, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 14 3 0.5, centre: 0 3 0, friction: 0.4 }
  - name: Wall3B
    position: 32 0 18
    rotation: 0 -0.707107 0 0.707107
    scale: 0.4375 1 1
    components:
      - !MeshRenderable { mesh: vx:e4b609c49f644f1baa1dbb75b4f25c2c#f3d9d64d, material: vx:60d8f50a41fb405eb427664245340ba0, castsShadows: true }
      - !BoxCollision { halfExtents: 14 3 0.5, centre: 0 3 0, friction: 0.4 }

