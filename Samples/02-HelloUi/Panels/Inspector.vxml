<!--
    SPDX-FileCopyrightText: Copyright (c) Rikarin
    SPDX-License-Identifier: Apache-2.0

    A property grid over an ordinary object.

    ⚠ **The grid draws itself from a *descriptor*, not from the markup.** That is the point of it: an
    application that had to write a row per property would not need a property grid. So this file is
    two tags and one line of wiring, and everything interesting is in `Material.cs` — which is the
    shape `Vixen.Core.Reflection.Generator` emits for a `[DataContract]` type, written out by hand so
    that a reader can see what the generator would have produced.
-->
@component Inspector
@namespace Vixen.Samples.HelloUi.Panels
@tag inspector-panel
@using Vixen.Core.Reflection
@using Vixen.Ui
@using Vixen.Ui.Controls
@using Vixen.Ui.Controls.Advanced
@using Vixen.Ui.Reactive

<!--
    ⚠ **The other end of the first in-app drag in the repository.** `AllowDrop` is what makes an
    element a candidate at all — the hit test walks up looking for one, so a grid without it is a
    hole the drag falls through to whatever is behind. The three feedback names (`dragenter`,
    `dragover`, `dragleave`) are optional; a target that says nothing accepts the effect the source
    preferred, which is why this needs `on:drop` and no negotiation.
-->
<PropertyGrid ref="@grid" AllowDrop="true" on:drop="@((DropEvent args) => Named(args))" />

@code {
    ShellModel? standalone;

    PropertyGrid grid = null!;

    /// <summary>What it is showing: the shell's model, or its own when nothing provides one.</summary>
    /// <remarks>
    ///     ⚠ <b>This is the panel that says the walk has to be connected during the build.</b>
    ///     <c>OnComposed</c> below reads <c>Model.Material</c> synchronously, before any flush — so
    ///     if a <c>DockPanel</c> were parked somewhere detached until the arrangement ran, this
    ///     would inject null and throw.
    ///     <c>AmbientAcrossDockingTests.A_child_added_inside_a_panel_sees_the_frame_before_any_flush</c>
    ///     is that question asked rather than assumed.
    /// </remarks>
    ShellModel Model => Inject<ShellModel>() ?? (standalone ??= new());

    partial void OnComposed() {
        // ⚠ **Registered here rather than in a static constructor, and registered at all because the
        // registry is process-wide.** `Vixen.Rendering` already claims the alias "Material" for
        // `MaterialDescriptor` — it refused this one at start-up and said so, which is the conflict
        // detection earning its keep: an alias is what saved data and tooling refer to a type by, so
        // two types answering to one name is a corruption waiting for somebody to load a file.
        TypeRegistry.Register(Material.Describe());

        grid.Inspect(Model.Material);

        // ⚠ **A scope and no handlers, which is the case worth having in a sample.** This panel
        // answers no verb of its own, so Edit ▸ Copy still resolves to the shell — and the shell's
        // message names this panel anyway, because `CommandRoute.ScopeOf` reads the scope at the
        // focus rather than at whoever handled the command. Declaring a scope and taking over a verb
        // are two separate things, and a sample where every scope came with a handler would suggest
        // they were one.
        Root.CommandScope = "inspector";
    }

    /// <summary>Names the material after whatever was dropped on the grid.</summary>
    /// <remarks>
    ///     <para>
    ///         ⚠ <b>One handler, two sources, and it cannot tell them apart — which is the point of
    ///         <c>DataObject</c>.</b> Rows dragged out of the Hierarchy arrive as text and so does a
    ///         line dragged out of a text editor on the desktop; the target asks for the flavour it
    ///         can read and never asks where the drag came from. <c>DropEvent.DragSource</c> is
    ///         there for the target that does care, and is <c>null</c> for an OS drop.
    ///     </para>
    ///     <para>
    ///         ⚠ <b>Re-inspected rather than mutated in place.</b> A <c>PropertyGrid</c> draws from a
    ///         descriptor over a plain object, and a plain object raises nothing when a property is
    ///         assigned — so a sample that set <c>Name</c> and stopped would leave the grid showing
    ///         the old one and look exactly like a drop that did nothing.
    ///     </para>
    /// </remarks>
    void Named(DropEvent args) {
        if (args.Data.Text is not { Length: > 0 } text) {
            return;
        }

        Model.Material.Name = text.Split('\n')[0].Trim();
        grid.Inspect(Model.Material);

        args.Handled = true;
        Model.Notify($"Named the material after {Model.Material.Name}", ControlVariant.Default);
    }
}
