<!--
    SPDX-FileCopyrightText: Copyright (c) Rikarin
    SPDX-License-Identifier: Apache-2.0

    A thousand nodes, about thirty of them realised.

    ⚠ **The tree is the one control in the sample whose contents are deliberately not markup.** A
    `@for` builds an element per item, which is the right answer for the five buttons in the gallery
    and the wrong one for a thousand rows: a virtualiser exists precisely so that the number of
    elements follows the size of the *viewport* rather than the size of the data. `TreeView` takes a
    model and realises what fits, so what this file hands it is the model.

    ⚠ **That is a different thing from `TreeView` not being writable in markup, and both are true.**
    `Root.Add(…)` is how a node is made — nothing overrides `ContentHost` — so even a ten-node tree
    would be wired here rather than nested.
-->
@component Hierarchy
@namespace Vixen.Samples.HelloUi.Panels
@tag hierarchy-panel
@using Vixen.Ui
@using Vixen.Ui.Controls
@using Vixen.Ui.Controls.Advanced
@using Vixen.Ui.Reactive

<!--
    ⚠ **`on:drop` is the first use of it anywhere outside a test.** `DropEvent` is produced by every
    backend, routed and bubbled, and the four target names — `dragenter`, `dragover`, `dragleave`,
    `drop` — have been in the binder's table with nothing in the repository writing one, so the
    markup half of drag and drop was a spelling nobody had ever asked to compile. Dropping files from
    Finder or Explorer onto this panel puts a row in for each of them.
-->
<TreeView ref="@tree"
          on:dragstart="@((DragEvent args) => Pick(args))"
          on:drop="@((DropEvent args) => Dropped(args))" />

@code {
    ShellModel? standalone;

    TreeView tree = null!;

    /// <summary>What it is showing: the shell's model, or its own when nothing provides one.</summary>
    /// <remarks>
    ///     ⚠ <b>Ambient rather than a parameter, and the shell is what changed.</b> This used to be
    ///     a signal-backed <c>Model</c> that <c>Shell.vxml</c> assigned on the tag, repeated on each
    ///     of the three panels; the shell writes one <c>&lt;provide type="ShellModel" …&gt;</c> now
    ///     and none of them is named. The fallback is what keeps a panel mountable on its own, which
    ///     is what the default <c>new()</c> in the signal used to buy — <c>Inject</c> answering null
    ///     is an ordinary case and what it should mean is the consumer's to say.
    /// </remarks>
    ShellModel Model => Inject<ShellModel>() ?? (standalone ??= new());

    partial void OnComposed() {
        var scene = tree.Root.Add("Scene");
        var lights = scene.Add("Lights");

        lights.Add("Key");
        lights.Add("Fill");
        lights.Add("Rim");

        var geometry = scene.Add("Geometry");

        // ⚠ Deliberately more rows than anybody will scroll through, because that is the claim being
        // demonstrated: the tree holds a thousand nodes and realises about thirty. A sample with ten
        // rows proves that a tree draws, which nobody doubted.
        for (var i = 0; i < 1_000; i++) {
            geometry.Add($"Rock_{i:D4}");
        }

        tree.Refresh();

        // ⚠ Through the view rather than by setting `IsExpanded`. Expanding is what makes a node's
        // children visible, and what is visible is what the virtualiser realises — so it is the
        // view's operation, and the model's flag is the view's to write.
        tree.Expand(scene);
        tree.Expand(lights);

        tree.Activated += (_, node) => Model.Notify($"Opened {node.Text}", ControlVariant.Default);

        // ⚠ **Declared once on the panel's root, and that is the whole of it.** Everything inside —
        // the tree, its thousand rows, a control a later edit adds — is in the `hierarchy` scope
        // because it is *inside*, so there is nowhere to forget to push it and nothing to pop when
        // the focus leaves. The editor's `EditorShell.Context` is the same idea written as a mutable
        // string assigned from ten pointer handlers, which is the shape this replaces.
        Root.CommandScope = "hierarchy";

        // ⚠ **The point of the panel: Copy here is not the shell's Copy.** Both are `edit.copy`, one
        // Edit ▸ Copy item is bound to that id, and which of the two runs is decided by where the
        // focus is — the route takes the nearest responder above it, so a selected row copies the
        // row and the same item copies the layout when the focus is anywhere else. Neither handler
        // knows the other exists.
        //
        // ⚠ `CanExecute` is asked rather than assumed: with no row selected this panel's Copy greys
        // out rather than falling through to the shell's. A refusal from the nearest responder is
        // final, which is what stops one menu item meaning two things depending on whether it
        // happens to be enabled.
        Root.AddCommandHandler(
            "edit.copy",
            CopySelection,
            () => !tree.SelectedNodes.IsDefaultOrEmpty && Root.Document.HasClipboard
        );
    }

    /// <summary>Picks the selected rows up as a drag the rest of the window can accept.</summary>
    /// <remarks>
    ///     <para>
    ///         ⚠ <b><c>UiDocument.BeginDrag</c> had no production caller anywhere in the
    ///         repository.</b> The whole in-app half of drag and drop — <c>DataObject</c>,
    ///         <c>AllowDrop</c>, the <c>DropEffect</c> a source offers and a target narrows, the
    ///         Escape that cancels and the Enter that drops — was built, routed and tested against
    ///         nothing that had ever started a session. This is the first, and the Inspector is what
    ///         it lands on.
    ///     </para>
    ///     <para>
    ///         ⚠ <b>From <c>dragstart</c> and not from a press.</b> The gesture recogniser is what
    ///         decides a press has wandered further than <c>GestureSettings.TouchSlop</c> and is
    ///         therefore a drag rather than a wobble; a source that began a session on
    ///         <c>pointerdown</c> would begin one for every click in the panel.
    ///     </para>
    ///     <para>
    ///         The payload is text because that is what any target can read — the same flavour an OS
    ///         drop and the clipboard both speak. A source with a richer representation offers both
    ///         and lets the target pick, which is what <c>DataObject</c>'s ordered formats are for.
    ///     </para>
    /// </remarks>
    void Pick(DragEvent args) {
        if (tree.SelectedNodes.IsDefaultOrEmpty) {
            return;
        }

        var data = new DataObject();
        data.SetText(string.Join(Environment.NewLine, tree.SelectedNodes.Select(node => node.Text)));

        Root.Document.BeginDrag(tree, data, DropEffect.Copy);
        Carry(tree.SelectedNodes.Length);
    }

    /// <summary>The picture under the pointer while the rows are being carried.</summary>
    /// <remarks>
    ///     ⚠ <b>An element at the <i>document root</i>, which is the overlay layer this framework was
    ///     said not to have.</b> The drag image was recorded as owed because "carrying a picture
    ///     would need an overlay layer, and <c>Core/Vixen.Ui</c> has none". The root is one: it is
    ///     the containing block for an absolutely-positioned child, it is above every panel because
    ///     it is above everything, and <c>ToastHost</c> — a sibling of the shell frame in
    ///     <c>Shell.vxml</c> — has been using it that way all along. What was actually missing is one
    ///     number, below.
    /// </remarks>
    UiElement? ghost;

    /// <summary>Puts a ghost up and lets it follow the drag until the drag is over.</summary>
    /// <param name="rows">How many rows are being carried, which is all the ghost says.</param>
    /// <remarks>
    ///     <para>
    ///         ⚠ <b>Positioned from <c>DragSession.X</c> and not from the pointer.</b> A source holds
    ///         the capture, so it could follow its own pointer moves — and that ghost would sit still
    ///         through a keyboard drag, which has no pointer at all and moves because the focus
    ///         moved. The session is where the two drivers meet, and until this it did not carry a
    ///         position: <c>CurrentDrag</c> said what was being dragged, what would happen to it and
    ///         where it would land, and not where it <i>was</i>.
    ///     </para>
    ///     <para>
    ///         ⚠ <b>Driven off the document's tick rather than off a drag event, for the same
    ///         reason.</b> A <c>dragover</c> arrives only while the drag is over a target that takes
    ///         drops, so a ghost moved by one would freeze over the gaps between the panels — which
    ///         is exactly where a user hesitates.
    ///     </para>
    ///     <para>
    ///         ⚠ <b>And the tick is what takes it down, rather than a <c>dragend</c>.</b> Escape
    ///         cancels the session while the button is still held, and the recogniser's
    ///         <c>dragend</c> does not arrive until the release — so a ghost removed there would
    ///         hang over the window after the drag it belongs to had been abandoned.
    ///     </para>
    /// </remarks>
    void Carry(int rows) {
        ghost ??= Root.Document.Root.Add("drag-ghost");
        ghost.Text = rows == 1 ? "1 node" : $"{rows} nodes";

        Root.Document.Ticked -= Follow;
        Root.Document.Ticked += Follow;
    }

    void Follow(UiDocument document, TimeSpan now) {
        if (document.CurrentDrag is not { } session) {
            document.Ticked -= Follow;
            ghost?.Remove();
            ghost = null;

            return;
        }

        // A little below and right of the point, so the ghost never covers the thing being pointed
        // at — which on a three-zone target is the whole of what the user is aiming with.
        ghost?.SetStyle("left", Px(session.X + 12f));
        ghost?.SetStyle("top", Px(session.Y + 12f));
    }

    static string Px(float value) =>
        string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{value:0.##}px");

    /// <summary>Takes files dragged in from the desktop and puts a row in for each.</summary>
    /// <remarks>
    ///     <para>
    ///         ⚠ <b>Nothing here knows where the drop landed, and that is the point of the routing.</b>
    ///         The event was hit-tested against the tree and bubbled up to this handler, so the panel
    ///         gets files that were let go over <i>it</i> rather than over the window — which is what
    ///         distinguishes a drop model from a window-level "somebody dropped something" callback.
    ///     </para>
    ///     <para>
    ///         <b>Handled, because a drop this panel took is not one the shell should also see.</b>
    ///         A parent that added its own import would otherwise import the same files twice.
    ///     </para>
    /// </remarks>
    void Dropped(DropEvent args) {
        if (args.Files.Count == 0) {
            return;
        }

        var imported = tree.Root.Add($"Imported ({args.Files.Count})");

        foreach (var path in args.Files) {
            imported.Add(Path.GetFileName(path));
        }

        tree.Refresh();
        tree.Expand(imported);

        args.Handled = true;
        Model.Notify($"Imported {args.Files.Count} file(s)", ControlVariant.Default);
    }

    /// <summary>Puts the selected rows on the pasteboard, one name per line.</summary>
    void CopySelection() {
        var names = string.Join(Environment.NewLine, tree.SelectedNodes.Select(node => node.Text));

        if (Root.Document.Clipboard?.SetText(names) == true) {
            Model.Notify($"Copied {tree.SelectedNodes.Length} row(s) from the hierarchy", ControlVariant.Default);
        }
    }

    /// <remarks>
    ///     ⚠ <b>There is deliberately no resize handling here, and there used to be.</b> The C#
    ///     version of this panel called <c>tree.Refresh()</c> from the shell's <c>Resize</c>, with a
    ///     comment saying that nothing tells an element its box changed and that a "layout finished"
    ///     callback on <c>UiDocument</c> would close the gap. That callback exists —
    ///     <c>UiDocument.LayoutFinished</c> — and <c>VirtualPanel</c> subscribes to it itself, so the
    ///     tree realises against the viewport it actually has on every pass that changed anything.
    ///     Refreshing from out here as well would be a second answer to a question already answered,
    ///     on the one path where re-entering a layout pass is easiest to get wrong.
    /// </remarks>
}
