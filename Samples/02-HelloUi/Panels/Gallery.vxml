<!--
    SPDX-FileCopyrightText: Copyright (c) Rikarin
    SPDX-License-Identifier: Apache-2.0

    The control set, as markup.

    ⚠ **This file is what "as comfortable as web development" is supposed to mean.** Every control
    below is a tag, every value is a signal read, every layout decision is a class name, and there is
    no C# in it beyond the state the controls are bound to. The C# version of this panel was a
    hundred and thirty lines of `var x = parent.Add<T>(); x.Property = …;`.

    ⚠ **`bind:Value` is two-way and `change:Value` is one-way out**, and the difference matters more
    than it looks. `bind:` writes the model when the control changes *and* writes the control when
    the model changes; `change:` only reports. A slider bound with `change:` alone does not follow a
    model changed from elsewhere — which is right for something the user is dragging and wrong for
    anything a menu command can also set.
-->
@component Gallery
@namespace Vixen.Samples.HelloUi.Panels
@tag gallery-panel
@using Vixen.Core.Mathematics
@using Vixen.Ui
@using Vixen.Ui.Controls
@using Vixen.Ui.Controls.Advanced
@using Vixen.Ui.Reactive

<!--
    ⚠ `flex-basis: 0` is the half of `grow` that a reader forgets. A flex item's basis is its content
    by default, so a tall column of cards inside a fixed-height panel would size the scroller to the
    content and there would be nothing to scroll. `basis-0` makes the scroller take the panel's
    height and the content overflow it, which is what a scroller is.
-->
<ScrollView class="gallery grow basis-0 p-3">
    <scroll-column class="flex flex-col gap-3 pr-3">

        <Card>
            <card-heading class="text-lg font-semibold">Buttons</card-heading>

            <!--
                ⚠ Keyed on the variant, which is a value rather than an object. A key that survives
                an update keeps its region and its body is *not* re-run, so keying immutable data on
                its value is right and keying it on an index is the bug `VXML2004` warns about. The
                opposite rule applies to an object that holds signals — key on the object then, or
                every row rebinds to a fresh copy.
            -->
            <button-row class="flex flex-row gap-2">
                @for (var variant in Variants) {
                    <Button key="@variant"
                            Label="@variant.ToString()"
                            Variant="@variant"
                            on:click="@(() => Pressed(variant))" />
                }
            </button-row>
        </Card>

        <Card>
            <card-heading class="text-lg font-semibold">State</card-heading>

            <CheckBox Label="Cast shadows" bind:IsChecked="@Model.CastsShadows.Value" />

            <!--
                ⚠ Indeterminate is a third state and not a second boolean, which is why it is set
                rather than bound: "some of the selection casts shadows" is a fact about a selection,
                and the control is what can express it. Clicking it resolves to checked.
            -->
            <CheckBox Label="Receive shadows" IsIndeterminate="true" />

            <Switch Label="Wireframe" bind:IsChecked="@Model.Wireframe.Value" />

            <!--
                ⚠ **The group's `Value` is written before its choices exist, and that is the ordinary
                case rather than an awkward one** — a group built from saved settings knows what was
                chosen before it knows what is on offer. `RadioGroup.OnChildAdded` restates on every
                arrival, so the right radio comes up checked and the roving tab index lands on it.
            -->
            <RadioGroup bind:Value="@Model.Quality.Value">
                <RadioButton Value="low" Label="Low" />
                <RadioButton Value="medium" Label="Medium" />
                <RadioButton Value="high" Label="High" />
            </RadioGroup>
        </Card>

        <Card>
            <card-heading class="text-lg font-semibold">Fields</card-heading>

            <TextBox Placeholder="Name" bind:Value="@Model.Name.Value" />
            <SearchBox Placeholder="Filter assets" bind:Value="@Model.Filter.Value" />
            <NumericInput Minimum="0" Maximum="64" bind:Number="@Model.Samples.Value" />

            <!--
                ⚠ **An `<Option>` nested here lands in the popover and not in the field**, because a
                dropdown inside the control that opens it is a dropdown clipped by every scrolling
                ancestor between the two — `SelectBase.ContentHost` is what routes it, and
                `Popover.ContentAdded` is what tells the field it arrived.
            -->
            <Select Placeholder="Blend mode" bind:Value="@Model.Blend.Value">
                <Option Value="opaque" Label="Opaque" />
                <Option Value="cutout" Label="Cutout" />
                <Option Value="blend" Label="Blend" />
            </Select>

            <!--
                ⚠ **A combo box is not a select with a text field on it — the value need not be one
                of the options**, which is why the two are separate types and why this one is here.
                An `<Option>` nested in it is a *suggestion*: picking one fills the field, and typing
                something nobody suggested is allowed and is the case a select cannot express.

                It routes its nested options into its popover the same way `Select` does — see
                `ComboBox.ContentHost` — so the nesting below reads as the tree it is and is not
                where the elements end up.
            -->
            <ComboBox>
                <Option Value="Standard" Label="Standard" />
                <Option Value="Unlit" Label="Unlit" />
                <Option Value="Subsurface" Label="Subsurface" />
            </ComboBox>

            <Slider bind:Value="@Model.Detail.Value" />
            <RangeSlider Low="0.2" High="0.8" />

            <field-readout class="text-xs text-slate-400">
                @Model.Name.Value · @Model.Blend.Value · detail @Detail
            </field-readout>
        </Card>

        <Card>
            <card-heading class="text-lg font-semibold">Feedback</card-heading>

            <!--
                Two things that move by themselves, so that a run of this sample is never a still
                picture — which is what makes a dropped frame or a stalled clock visible rather than
                something to take on trust.
            -->
            <ProgressBar class="text-brand" Value="@Model.Progress.Value" />
            <Spinner Phase="@Model.Phase.Value" />

            <Alert Variant="Danger"
                   Title="Shader failed to compile"
                   Message="Ui/Msdf.rvn(42): expected ';'" />
        </Card>

        <!--
            ⚠ **The four small display controls, and the reason they are worth a card is that until
            this one existed nothing outside their own unit tests constructed any of them.** A
            control with no consumer is a control whose markup surface has never been exercised — the
            tests reach for `Add<Avatar>()` in C# and would go on passing if the tag, the attribute
            names or the theme rule were wrong.
        -->
        <Card>
            <card-heading class="text-lg font-semibold">Identity</card-heading>

            <identity-row class="flex flex-row items-center gap-2">
                <!--
                    ⚠ `Name` and not `Initials`: setting the name *derives* the initials, and the
                    name is also what a screen reader is given. Two letters read out loud have told
                    nobody anything. `Avatar.Initials` is the override for when there is no name.
                -->
                <Avatar Name="Ada Lovelace" />

                <!--
                    ⚠ And the other way round, which is the case the derivation cannot serve: a
                    contributor known by two letters and not by a name. `Initials` is `Text` under
                    another name, so setting it writes the circle directly — and the accessible name
                    falls back to it, which is the "nobody said who it is" branch of
                    `Avatar.NativeAccessibleName` and the only honest answer available.
                -->
                <Avatar Initials="JS" />

                <identity-text class="flex flex-col">
                    <!--
                        ⚠ A `Href` that nothing here follows, deliberately: a link raises a click and
                        carries an address, and what that means — open a browser, reveal an asset,
                        switch document — is the application's. A control set that shelled out to a
                        system browser would be one that opens arbitrary URLs on behalf of content.
                    -->
                    <Link Label="vixenengine.org/docs/ui"
                          Href="https://vixenengine.org/docs/ui"
                          on:click="@Followed" />

                    <Badge Variant="Primary" Text="3 unread" />
                </identity-text>
            </identity-row>

            <!--
                What content that has not arrived looks like. Two bars rather than one, because a
                single grey rectangle reads as a divider and a stack of them reads as a paragraph.
            -->
            <skeleton-stack class="flex flex-col gap-2">
                <Skeleton class="w-full" />
                <Skeleton class="w-1/2" />
            </skeleton-stack>
        </Card>

        <Tabs>
            <TabItem Label="Surface">Metallic-roughness</TabItem>
            <TabItem Label="Shading">Standard</TabItem>
            <TabItem Label="Layers">None</TabItem>
        </Tabs>

        <!--
            ⚠ An `Accordion` keeps no list of its sections — `Sections` reads them off its children —
            so an `<Expander>` nested here *is* a section, and `AllowMultiple="false"` makes the three
            of them exclusive without anything registering anything.
        -->
        <Accordion AllowMultiple="false">
            <Expander Label="Advanced">
                <expander-note class="text-sm text-slate-400">Nothing here yet.</expander-note>
            </Expander>

            <Expander Label="Debug">
                <expander-note class="text-sm text-slate-400">Nothing here either.</expander-note>
            </Expander>
        </Accordion>

        <Breadcrumb>
            <BreadcrumbItem Label="Assets" />
            <BreadcrumbItem Label="Materials" />
            <BreadcrumbItem Label="Standard" />
        </Breadcrumb>

        <!--
            ⚠ Never a gap: a pagination's buttons are *generated* from `PageCount`, so its whole
            authoring surface has always been three numbers. A `<PageButton>` nested here would be a
            button the next rebuild throws away.
        -->
        <Pagination PageCount="12" />

        <!--
            ⚠ **The one advanced control in this panel, and it is here because
            `Vixen.Ui.Controls.Advanced/README.md` names it as one of the eleven that prove the
            framework — while nothing outside its own unit tests constructed one.** It needs no
            attributes and no children: the rails, the bar, the space select and the picker are all
            parts it makes, and an application that wants its own picker hides this one and listens
            to `SelectionChanged`.
        -->
        <Card>
            <card-heading class="text-lg font-semibold">Gradient</card-heading>
            <GradientEditor ref="@gradient" />
        </Card>

        <!--
            ⚠ **A drawer is opened, not assigned.** `IsOpen` is deliberately not a `[UiProperty]` —
            opening measures, places, moves the focus and may take a modal scope, so `Open` and
            `Close` are the whole interface and a settable property would be an invitation to do
            half of it. That is why this is a button and a `ref` rather than a `bind:`.
        -->
        <Button Label="Show filters" on:click="@ShowFilters" />
    </scroll-column>
</ScrollView>

<!--
    Outside the scroller, for `ToastHost`'s reason in `Shell.vxml`: a surface that covers the window
    must not be laid out by — or clipped to — the column it was opened from.

    ⚠ **Its content is filled in `OnComposed` rather than nested here, and that is a gap rather than
    a style.** `Drawer` (and `Dialog`) never override `UiElement.ContentHost`, so a tag written
    inside one lands on the drawer element beside its backdrop and its surface — which the theme
    lays out across the whole viewport — instead of in `Body`. See issue #676.
-->
<Drawer ref="@filters" Side="Right" />

@code {
    /// <summary>The five appearances a button has.</summary>
    /// <remarks>
    ///     A field rather than a literal in the loop, because a <c>@for</c>'s collection expression is
    ///     re-evaluated by the effect that drives it — a new array per evaluation would compare
    ///     unequal and rebuild every row on every flush.
    /// </remarks>
    static readonly ControlVariant[] Variants = [
        ControlVariant.Default,
        ControlVariant.Primary,
        ControlVariant.Success,
        ControlVariant.Danger,
        ControlVariant.Subtle
    ];

    readonly Signal<ShellModel> model = new(new());

    GradientEditor gradient = null!;
    Drawer filters = null!;

    /// <summary>What it is showing.</summary>
    /// <remarks>
    ///     ⚠ <b>Signal-backed, and it has to be.</b> <c>BuildContext.Child&lt;T&gt;</c> constructs a
    ///     component, mounts it — which runs <c>Build</c> — and assigns its parameters
    ///     <em>afterwards</em>. So every effect this component made has already read the property
    ///     once, with whatever the default was, and a plain property assigned later notifies nobody.
    /// </remarks>
    public ShellModel Model {
        get => model.Value;
        set => model.Value = value;
    }

    /// <summary>The slider's value, rounded, for the readout beside it.</summary>
    /// <remarks>
    ///     ⚠ A property rather than an expression in the markup, and not for tidiness: <c>@</c> in
    ///     content follows Razor's implicit-expression rule and stops at the first character that
    ///     cannot continue a member access — so <c>@Model.Detail.Value.ToString("0.00")</c> reads
    ///     fine and <c>@(a + b)</c> needs its parentheses. A named property never needs the reader to
    ///     know which.
    /// </remarks>
    string Detail => Model.Detail.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    partial void OnComposed() {
        Root.Document.Ticked += Advance;

        // Three stops and one alpha stop, so that the rails have something on them and a reader can
        // see what the two of them are for. A `GradientEditor` left at its default is a black-to-white
        // strip with one stop on each rail, which is the state that looks like it did not load.
        var ramp = new Gradient();
        ramp.AddColorStop(0f, new(0.05f, 0.10f, 0.35f, 1f));
        ramp.AddColorStop(0.5f, new(0.85f, 0.35f, 0.15f, 1f));
        ramp.AddColorStop(1f, new(1f, 0.95f, 0.70f, 1f));
        ramp.AddAlphaStop(0.25f, 0.4f);

        gradient.Gradient = ramp;
        gradient.GradientChanged += _ => Model.Notify("Gradient edited", ControlVariant.Default);

        // ⚠ The one piece of C# this panel would rather not have. See the `<Drawer>` above: nested
        // markup cannot reach `Drawer.Body` yet, so the content is added where the control says it
        // goes rather than where an author would write it.
        filters.Body.Add<TextBlock>().Text = "A secondary surface you can leave open.";
        filters.Body.Add<CheckBox>().Label = "Only modified";
    }

    /// <inheritdoc />
    protected override void OnUnmounted() {
        // ⚠ The one thing the region cannot take care of. Effects, bindings and elements are the
        // build region's and are disposed with it; a handler on the *document* outlives this panel,
        // and a forgotten one keeps a dead component's signals alive for the life of the process.
        Root.Document.Ticked -= Advance;

        base.OnUnmounted();
    }

    /// <summary>Moves the two things that move.</summary>
    void Advance(UiDocument document, TimeSpan now) {
        var seconds = (float) now.TotalSeconds;

        Model.Phase.Value = seconds % 1f;
        Model.Progress.Value = (MathF.Sin(seconds) * 0.5f) + 0.5f;
    }

    /// <summary>What an application does with a <see cref="Link" />'s address.</summary>
    /// <remarks>
    ///     Reported rather than opened, and that is the sample making the control's point: a link
    ///     carries a <c>Href</c> and raises a click, and deciding that the address is safe to hand to
    ///     a browser is a judgement no widget is in a position to make.
    /// </remarks>
    void Followed() => Model.Notify("Would open the guide", ControlVariant.Default);

    void ShowFilters() => filters.Open();

    void Pressed(ControlVariant variant) =>
        Model.Notify(
            $"{variant} pressed",
            variant == ControlVariant.Danger ? ControlVariant.Danger : ControlVariant.Default
        );
}
