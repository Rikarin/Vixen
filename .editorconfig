# Vixen — see docs/plan/00-vision-and-principles.md § "Coding standards"
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yaml,yml,csproj,props,targets,slnx,xml,g4}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Layout. These are not preferences so much as a description: every file in the repository is
# written this way, and until they were written down `dotnet format` defaulted to Allman and
# reported some forty thousand whitespace violations against code that was entirely consistent
# with itself. A config that disagrees with the whole codebase is the thing that is wrong.
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents_when_block = false
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_after_dot = false
csharp_space_before_dot = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_semicolon_in_for_statement = false
csharp_space_around_declaration_statements = false
csharp_space_before_open_square_brackets = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_square_brackets = false
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true

# Modern C# the plan leans on
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:silent
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_collection_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_readonly_struct = true:suggestion
csharp_style_prefer_readonly_struct_member = true:suggestion
csharp_prefer_static_local_function = true:suggestion
csharp_prefer_static_anonymous_function = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_namespace_match_folder = true:suggestion

# Accessibility modifiers are written only when they change something: `private` on
# a member and `internal` on a type are the defaults and are left off, which is what
# the whole tree does. `private protected` and friends still get spelled out.
dotnet_style_require_accessibility_modifiers = omit_if_default:suggestion

# ------------------------------------------------------------------------------
# Naming. Two styles, and the line between them is visibility, not storage:
# PascalCase for anything a caller can name, camelCase for mutable private state.
#
# No `_` prefix. This file used to mandate one and not a single file in the
# repository has ever had one — `Vixen.Core.Syntax` and Raven both write bare
# `readonly string text;`. A convention that every file violates is not a
# convention, so the config now records the style that is actually written.
#
# Order matters: the first matching rule wins, so the const and static-readonly
# rules have to precede the private-field rule they carve exceptions out of.
# ------------------------------------------------------------------------------
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.camel.capitalization = camel_case

# Constants name a value, so they read as names regardless of accessibility.
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

# So do the static readonly lookup tables the compiler and the engine are full of
# (`Intrinsics.FloatTypes`, `GlslTypes.Reserved`, `PooledDictionary.Pool`): they are
# fixed data, not state that changes as the program runs.
dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static,readonly

# Everything else that is private state: camelCase, no prefix.
dotnet_naming_rule.private_fields_camel.severity = warning
dotnet_naming_rule.private_fields_camel.symbols = private_fields
dotnet_naming_rule.private_fields_camel.style = camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected

# Members are PascalCase at every accessibility. Only fields distinguish, because
# only fields are state; a private helper like `SlidingTextWindow.GetText` reads the
# same as a public one and the tree has always written it that way.
dotnet_naming_rule.members_pascal.severity = warning
dotnet_naming_rule.members_pascal.symbols = members
dotnet_naming_rule.members_pascal.style = pascal
dotnet_naming_symbols.members.applicable_kinds = property,method,event
dotnet_naming_symbols.members.applicable_accessibilities = *

dotnet_naming_rule.public_fields_pascal.severity = warning
dotnet_naming_rule.public_fields_pascal.symbols = public_fields
dotnet_naming_rule.public_fields_pascal.style = pascal
dotnet_naming_symbols.public_fields.applicable_kinds = field
dotnet_naming_symbols.public_fields.applicable_accessibilities = public,protected,internal

# Performance analyzers the "zero allocation in the frame loop" rule depends on.
# Kept at `suggestion` repo-wide so the IDE surfaces them without breaking the
# build on existing code. Escalate to `warning` under Core/ and Platform/ (below)
# where the allocation budget is actually enforced.
dotnet_diagnostic.CA1852.severity = suggestion   # seal internal types
dotnet_diagnostic.CA1859.severity = suggestion   # concrete types for performance
dotnet_diagnostic.CA1860.severity = suggestion   # avoid Enumerable.Any()
dotnet_diagnostic.CA1861.severity = suggestion   # no constant arrays as arguments
dotnet_diagnostic.CA1863.severity = suggestion   # use CompositeFormat
dotnet_diagnostic.CA2016.severity = suggestion   # forward CancellationToken

# ADR-002: no runtime IL generation, no reflection-driven activation in runtime code.
# Escalated to error under Core/ and Platform/ below.
dotnet_diagnostic.IL2026.severity = warning
dotnet_diagnostic.IL3050.severity = warning

# Generated code is not ours to style
[**/{obj,bin}/**]
generated_code = true

[**/*.g.cs]
generated_code = true

# Runtime assemblies: trimming and AOT violations are errors, not suggestions
[{Core,Platform}/**/*.cs]
dotnet_diagnostic.CA1852.severity = warning
dotnet_diagnostic.CA1859.severity = warning
dotnet_diagnostic.CA1860.severity = warning
dotnet_diagnostic.CA1861.severity = warning
dotnet_diagnostic.CA1863.severity = warning
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.IL2026.severity = error
dotnet_diagnostic.IL2067.severity = error
dotnet_diagnostic.IL2075.severity = error
dotnet_diagnostic.IL3050.severity = error

# Tests may allocate, mock, and be verbose
[**/*.Tests/**/*.cs]
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA1859.severity = none

# ==============================================================================
# Rules disabled by name under AnalysisLevel=latest-all.
# Each needs a reason. Prefer fixing code over adding to this list.
# ==============================================================================

[*.cs]
# CA1720 — identifier contains a type name.
# Raven is a compiler for a shading language whose own type names are `int`,
# `uint`, `float`, `double`, `string`. `SpecialType.Float`, `IrType.Double` and
# friends are the domain vocabulary; renaming them to satisfy a .NET API-naming
# rule would make the compiler harder to read, not easier. 19 findings.
dotnet_diagnostic.CA1720.severity = none

# CA1000 — do not declare static members on generic types.
# The rule predates generic type inference and argues that `Handle<Buffer>.Null`
# is hard to read. The BCL disagrees with itself here — Span<T>.Empty,
# Vector128<T>.Zero, ImmutableArray<T>.Empty — and static abstract interface
# members make static members on generic types mandatory rather than merely
# idiomatic. A `Null`/`Empty`/`Zero` on the type it belongs to is the discoverable
# place for it; the alternative is a non-generic helper class nobody finds.
dotnet_diagnostic.CA1000.severity = none

# CA1062 — validate arguments of public methods.
# An engine cannot afford a null check on every public entry point: these sit in
# frame-loop hot paths, and the "zero allocation / no overhead in the frame loop"
# rule (docs/plan/00) outranks defensive validation. Nullable reference types are
# the mechanism we rely on instead, enforced at compile time rather than runtime.
dotnet_diagnostic.CA1062.severity = none

# ------------------------------------------------------------------------------
# The Raven compiler.
# ------------------------------------------------------------------------------
[Raven/Vixen.Raven/**.cs]
# CA1711 — identifiers should not have a reserved suffix.
# `stream` is one of Raven's own keywords: a value written by one pipeline stage
# and read by the next (docs/plan/07 § I). `IrStream` and `PlannedStream` are
# named after the declaration they model, and sit beside `IrBinding` and
# `IrStageIo` where nothing could read them as a System.IO.Stream. Same reasoning
# as CA1720 above — the shading language's vocabulary wins over a .NET API-naming
# convention — and scoped to the compiler so a genuinely misleading `FooStream`
# elsewhere is still reported. 2 findings.
dotnet_diagnostic.CA1711.severity = none

# ------------------------------------------------------------------------------
# The indexed priority queue.
# ------------------------------------------------------------------------------
[Core/Vixen.Core.Collections/IndexedPriorityQueue.cs]
# CA1711 — identifiers should not have a reserved suffix.
# The rule wants a `*Queue` to derive from System.Collections.Queue, a
# non-generic type from .NET 1.0 that nothing should derive from. This type is a
# priority queue in every sense that matters — Enqueue, Dequeue, Peek, Count —
# and "priority queue" is what somebody looking for it will search for. Calling
# it a heap to satisfy the rule would name the implementation instead of the
# abstraction. 1 finding.
dotnet_diagnostic.CA1711.severity = none

# ------------------------------------------------------------------------------
# Pooled collection rentals.
# ------------------------------------------------------------------------------
[Core/Vixen.Core/Pooling/PooledDictionary.cs]
# CA1711 — identifiers should not have a reserved suffix.
# The rule wants a type named `*Dictionary` to implement IDictionary<K,V>.
# PooledDictionary<K,V> deliberately does not: it is a mutable struct handle to a
# rented dictionary, and implementing the interface would box it at every call
# site — precisely the allocation the type exists to remove. The suffix is not
# misleading, it is accurate, and docs/plan/03 specifies the name. 1 finding.
dotnet_diagnostic.CA1711.severity = none

# ------------------------------------------------------------------------------
# Test projects.
# ------------------------------------------------------------------------------
[**/*.Tests/**.cs]
# CA1707 — identifiers should not contain underscores.
# docs/plan/12 mandates `MethodOrScenario_Condition_ExpectedResult` test naming.
# The rule and our own standard are in direct conflict, and the standard wins:
# it is the dominant xunit convention and it makes failure output readable.
# 250 findings — this single rule was 88% of everything latest-recommended found.
dotnet_diagnostic.CA1707.severity = none

# CA1861 — prefer static readonly fields over constant array arguments.
# The rule targets repeated calls in hot code. In a test the constant array *is*
# the expectation: `Assert.Equal(new[] { "pipeline", "swapchain", "device" }, log)`
# says what the test asserts on the line that asserts it, and hoisting each one to
# a named field would scatter every expectation away from its assertion for an
# allocation that happens once per test. Escalated to warning under Core/ and
# Platform/ above, where the allocation budget is real.
dotnet_diagnostic.CA1861.severity = none

# ─────────────────────────────────────────────────────────────────────────────
# Core/Vixen.Core.Serialization.Tests/Contracts.cs
#
# CA1051 (do not declare visible instance fields). These types exist to exercise
# every shape the [DataContract] generator has to handle, and a public mutable
# field is one of them — the attribute's own documentation names public fields as
# part of the serialised form. A contract that avoided them would test the
# generator against a shape no real contract uses.
# ─────────────────────────────────────────────────────────────────────────────
[Core/Vixen.Core.Serialization.Tests/Contracts.cs]
dotnet_diagnostic.CA1051.severity = none

# ─────────────────────────────────────────────────────────────────────────────
# Platform/Vixen.Platform/Input/Key.cs
#
# CS1591 (missing XML comment). `Key` names roughly 120 physical key positions,
# and the name of each one is already the whole of what can be said about it: a
# `<summary>The A key.</summary>` on `A` adds nothing and, repeated a hundred
# times, buries the members that genuinely need explaining — why `Q` is not the
# letter Q, what `NonUsBackslash` is, why `Back` sits outside the HID range. Those
# carry comments; the rest are their own documentation.
# ─────────────────────────────────────────────────────────────────────────────
[Platform/Vixen.Platform/Input/Key.cs]
dotnet_diagnostic.CS1591.severity = none

# ─────────────────────────────────────────────────────────────────────────────
# Core/Vixen.Input/Controls/InputKey.cs
#
# CS1591, for the same reason and about the same table. `InputKey` is the Core
# layer's copy of the USB HID key positions, value for value — Vixen.Input cannot
# reference Vixen.Platform (CheckArchitecture forbids Core → Platform) and
# Vixen.Ui, which consumes it, must stay usable with no platform backend at all.
# InputKeyTests asserts member by member that the two agree, which is what makes
# the duplication safe; documenting each of a hundred and twenty positions twice
# is what would make it unreadable.
# ─────────────────────────────────────────────────────────────────────────────
[Core/Vixen.Input/Controls/InputKey.cs]
dotnet_diagnostic.CS1591.severity = none

# ─────────────────────────────────────────────────────────────────────────────
# ECS component declarations
#
# CA1051 (do not declare visible instance fields). A component *is* a public
# mutable field or several. `world.Get<Position>(e).Y = 9` writes through a `ref`
# into a chunk, and a property returning a copy would silently drop the write —
# which is why docs/plan/04 § Storage specifies fields, and why the same choice
# is already made for the mathematics types (docs/plan/03 § Layout). The rule is
# aimed at API surface that could later want validation; a component cannot have
# validation, because nothing calls anything when a chunk byte changes.
#
# Scoped by file name rather than by directory, so the exemption is something a
# file opts into by being called what it is. A file that declares components is
# named `*Components.cs`; anything else in the same project still answers to the
# rule.
#
# Users' own component types live in their own assemblies and will meet this rule
# too. That is a documented consequence rather than an oversight, and the manual
# says so where it introduces components.
# ─────────────────────────────────────────────────────────────────────────────
[**/*Components.cs]
dotnet_diagnostic.CA1051.severity = none

# ─────────────────────────────────────────────────────────────────────────────
# Core/Vixen.Rendering/RenderObject.cs
#
# CA1051 (do not declare visible instance fields). The same reasoning as the ECS
# components above, arrived at from the other end: `system.Objects[id].Bounds =
# …` writes through a `ref` into a NativeArray, and a property returning a copy
# would silently drop the write. `RenderObject` is one element of the array the
# culling loop walks for every object in the scene, so it is a data layout rather
# than an API surface — and a layout cannot have validation, because nothing
# calls anything when a byte in native memory changes.
#
# Scoped to the one file that declares it. Everything else in the project, this
# type's own methods included, still answers to the rule.
# ─────────────────────────────────────────────────────────────────────────────
[Core/Vixen.Rendering/RenderObject.cs]
dotnet_diagnostic.CA1051.severity = none

# ─────────────────────────────────────────────────────────────────────────────
# Core/Vixen.Shaders/ParameterCollection.cs
#
# CA1711 (rename type so it does not end in 'Collection'). The rule reserves the
# suffix for types implementing ICollection. This one holds parameters and is not
# one: it is a packed byte buffer with an offset per key, and exposing it as a
# collection of anything would mean giving out the boxed values the packing exists
# to avoid.
#
# The name is also fixed by the specification rather than chosen here — docs/plan
# 06 and 07 both call it ParameterCollection, following Stride, and a host reading
# either would look for that name. Renaming it to satisfy a suffix convention
# would make the code and the two documents that specify it disagree.
# ─────────────────────────────────────────────────────────────────────────────
[Core/Vixen.Shaders/ParameterCollection.cs]
dotnet_diagnostic.CA1711.severity = none

# ─────────────────────────────────────────────────────────────────────────────
# Core/Vixen.Rendering/Mesh.cs
#
# CA1051 (do not declare visible instance fields). `MeshDraw` is an element of a
# RenderDataHolder array — native memory, read through a `ref` per object in the
# draw loop — so it is a data layout for the same reasons RenderObject.cs is
# exempted above, and a property returning a copy would silently drop a write.
#
# `Material` in the same file is an ordinary reference type with properties, and
# is unaffected: the exemption is about the struct that shares the file with it.
# ─────────────────────────────────────────────────────────────────────────────
[Core/Vixen.Rendering/Mesh.cs]
dotnet_diagnostic.CA1051.severity = none

# ─────────────────────────────────────────────────────────────────────────────
# Core/Vixen.Rendering/Lights.cs
#
# CA1051 (do not declare visible instance fields). Two structs, exempted for two
# different reasons that happen to point the same way.
#
# `PunctualLightData` is a memory layout the GPU reads: its field order and its
# sixty-four-byte size are fixed by the std140 rules and by the matching struct in
# Raven/Library/Shading/Lighting.rvn, and an upload is a blit of an array of them.
# Properties would add nothing a shader can see and would break the blit the
# moment one of them stopped being auto-implemented.
#
# `RenderLight` is the authoring side of the same record, mutated field by field
# by whatever extracts lights from a scene. It is a struct held in a list, so
# `lights[i].Intensity = …` through a property would write to a copy — the same
# trap RenderObject.cs is exempted for.
# ─────────────────────────────────────────────────────────────────────────────
[Core/Vixen.Rendering/Lights.cs]
dotnet_diagnostic.CA1051.severity = none


# ─────────────────────────────────────────────────────────────────────────────
# Core/Vixen.Ui.Markup/Binding/BoundNodes.cs
#
# CA1711 (identifiers should not have incorrect suffix). `BoundAttribute` is a
# bound markup attribute — `class="…"`, `on:click="@Go"` — and has nothing to do
# with `System.Attribute`. The rule exists so that a type named `…Attribute` can
# be assumed to be one, and here the word is the domain's, not the CLR's: the
# syntax node beside it is `AttributeSyntax` and the thing in the file is called
# an attribute by everyone who writes one. Renaming it would make the binder's
# vocabulary disagree with the language's.
# ─────────────────────────────────────────────────────────────────────────────
[Core/Vixen.Ui.Markup/Binding/BoundNodes.cs]
dotnet_diagnostic.CA1711.severity = none
