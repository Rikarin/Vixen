<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.AssetCompiler</RootNamespace>
        <AssemblyName>Vixen.AssetCompiler</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--
          The importers, the executor seam, and the pipeline types the protocol mirrors. A worker is
          the same importer set as its coordinator by construction — see BuiltInImporters.
        -->
        <ProjectReference Include="..\..\Editor\Vixen.Editor.Assets\Vixen.Editor.Assets.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
          The protocol types are [DataContract] records serialised with the engine's own binary
          serializer, as doc 08 specifies for this IPC. Analyzers do not flow through a
          ProjectReference, so the generator is named here or the messages have no serializers.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.AssetCompiler.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <!--
            #821's ratchet. The TOOLING profile in `Directory.Build.props` sets this false for all of
            `Editor/**`, `Tools/**` and `Raven/**`, so no `<see cref>` under any of them was ever
            checked — ask what that gate printed on the day it did not run: `0 Warning(s)`. CS1591
            and CS1573 stay suppressed: "this public member has no comment" is a question about a
            packaged API surface and is not what this is for; the rules that catch a *lie* are.
            Measured before flipping, and every diagnostic it reported is fixed in the same commit.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
