<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>

        <!--
            The same opt-out Vixen.DocGen makes, for the same shape of reason. This project needs
            Roslyn as a library (TemplateCompiler) *and* Vixen.Cli, whose Vixen.Live.Cluster
            reference brings Microsoft.Orleans.Sdk 10.2.2, which requires
            Microsoft.CodeAnalysis.Common >= 5.0.0 — while Directory.Packages.props pins
            Microsoft.CodeAnalysis.CSharp at 4.11.0 for the generators, which target the compiler
            and must not be dragged forward by a test host. CentralPackageVersionOverrideEnabled is
            false, so VersionOverride is not available: this project opts out of central versions
            entirely. Nothing references it and nothing ships it, so the opt-out costs four inline
            versions and the alternative costs the generators.
        -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- What compiles a scaffolded project without building one. See TemplateCompiler. 5.0.0
             rather than the central 4.11.0 because Orleans (above) needs >= 5.0.0 — and exactly
             5.0.0 rather than DocGen's 5.6.0 because Orleans also brings
             Microsoft.CodeAnalysis.Workspaces.Common 5.0.0, whose dependency on
             Microsoft.CodeAnalysis.Common is an exact pin (NU1608 as error otherwise). -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The reader, and with it the embedded copy of the template tree. Referencing the CLI
            rather than re-reading the files off disk is deliberate: what these tests are about is
            the thing a person actually gets, and what a person gets is what TemplateCatalog hands
            to ScaffoldRunner.
        -->
        <ProjectReference Include="..\Vixen.Cli\Vixen.Cli.csproj" />

        <!--
            ⚠ Everything a scaffolded project references, so that TemplateCompiler can compile the
            C# the templates write against the same assemblies their PackageReferences resolve to.
            Nothing here is called from a test; these are metadata references and nothing more, and
            a template that names a type these assemblies do not have fails here rather than on the
            machine of the first person to run `dotnet new vixen-app`.

            The alternative — restore and build a real scaffolded project — needs the engine on a
            NuGet feed, which is a thing CI can arrange and a developer's machine cannot.
        -->
        <ProjectReference Include="..\Vixen.App\Vixen.App.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Ui.Controls\Vixen.Ui.Controls.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Ui.Renderer\Vixen.Ui.Renderer.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Graphics.RenderGraph\Vixen.Graphics.RenderGraph.csproj" />
        <ProjectReference Include="..\..\Platform\Vixen.Platform.Desktop\Vixen.Platform.Desktop.csproj" />
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Vulkan\Vixen.Graphics.Vulkan.csproj" />

        <!--
            And what `vixen-mmo` names. Vixen.Live.Realm brings Vixen.Live.Abstractions, Vixen.Net
            and the UDP transport with it, which between them are every package the four scaffolded
            projects reference that the list above does not already cover.
        -->
        <ProjectReference Include="..\..\Live\Vixen.Live.Realm\Vixen.Live.Realm.csproj" />
    </ItemGroup>
</Project>
