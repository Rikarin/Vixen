<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.UnicodeTableGen</RootNamespace>
        <IsPackable>false</IsPackable>
        <Description>
            Turns the Unicode Character Database into two committed artefacts: the property tables
            Vixen.Ui.Text looks segmentation classes up in, and the UAX#29 conformance suites as
            xunit tests. Run by hand when the UCD is updated; its output is committed, because CI has
            no copy of the database to generate from.
        </Description>
    </PropertyGroup>

    <PropertyGroup>
        <!--
            #821's ratchet. The TOOLING profile in `Directory.Build.props` sets this false for all of
            `Editor/**`, `Tools/**` and `Raven/**`, so no `<see cref>` under any of them was ever
            checked — ask what that gate printed on the day it did not run: `0 Warning(s)`. CS1591
            and CS1573 stay suppressed: "this public member has no comment" is a question about a
            packaged API surface and is not what this is for; the rules that catch a *lie* are.
            Measured before flipping, and every diagnostic it reported is fixed in the same commit.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
