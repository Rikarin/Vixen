<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.UnicodeTableGen</RootNamespace>
        <IsPackable>false</IsPackable>
        <Description>
            Turns the Unicode Character Database into two committed artefacts: the property tables
            Vixen.Ui.Text looks segmentation classes up in, and the UAX#29 conformance suites as
            xunit tests. Run by hand when the UCD is updated; its output is committed, because CI has
            no copy of the database to generate from.
        </Description>
    </PropertyGroup>

</Project>
