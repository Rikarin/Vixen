<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.TaffyTestGen</RootNamespace>
        <IsPackable>false</IsPackable>
        <Description>
            Vets and consolidates Taffy's language-neutral XML conformance corpus into the committed
            fixture files Vixen.Ui.Layout.Tests reads. Run by hand when the reference clone is
            updated; its output is committed, because CI has no reference clone to generate from.
        </Description>
    </PropertyGroup>

</Project>
