<!--
    SPDX-FileCopyrightText: Copyright (c) Rikarin
    SPDX-License-Identifier: Apache-2.0

    Switches, and only switches.

    This file is imported *before* the consuming project's own body, so a property set here is one
    the project can still overwrite by assigning it — which is what makes each of these a default.
    What must NOT live here is anything derived from another property, because the value it would
    derive from has not been set yet. Those are in Vixen.Sdk.targets, and the reason is written
    there.
-->
<Project>

    <PropertyGroup>
        <VixenSdkDirectory>$(MSBuildThisFileDirectory)</VixenSdkDirectory>

        <VixenImportOnBuild Condition="'$(VixenImportOnBuild)' == ''">true</VixenImportOnBuild>
        <VixenContentBuildOnBuild Condition="'$(VixenContentBuildOnBuild)' == ''">true</VixenContentBuildOnBuild>
        <VixenCopyContentToOutput Condition="'$(VixenCopyContentToOutput)' == ''">true</VixenCopyContentToOutput>

        <!-- Where the content lands inside the application's own output, and inside a publish. -->
        <VixenContentFolderName Condition="'$(VixenContentFolderName)' == ''">Content</VixenContentFolderName>

        <!--
            Whether `**/Editor/**/*.cs` is kept out of the game's compilation. Doc 36 § P5 — those
            files are the editor's, compiled by it and never shipped. The switch exists for a project
            that keeps runtime code in a folder it happens to have called `Editor`, which is a name
            collision rather than an opinion, and which has to be able to say so.
        -->
        <VixenExcludeEditorScripts Condition="'$(VixenExcludeEditorScripts)' == ''">true</VixenExcludeEditorScripts>
    </PropertyGroup>

</Project>
