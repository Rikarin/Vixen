<!--
    SPDX-FileCopyrightText: Copyright (c) Rikarin
    SPDX-License-Identifier: Apache-2.0

    What makes `dotnet build` do a content build. Doc 08 § Vixen.Sdk.
-->
<Project>

    <!--
        ==========================================================================================
        Everything *derived from another property* lives here rather than in Vixen.Sdk.props, and
        this is the ordering rule that decides it: a .props is imported before the consuming
        project's body and a .targets after it.

        A plain default is safe in the .props — `<VixenTarget>Android</VixenTarget>` in a .csproj
        body is an unconditional assignment and overwrites whatever the .props defaulted to. What
        is not safe is a property computed *from* one, because that computation has already
        happened by the time the body runs and nothing recomputes it. VixenToolCommand is the one
        that proves it: derived from VixenToolPath, and a consumer setting VixenToolPath in its
        body against a .props-derived command gets `dotnet vixen` and a tool-not-found failure.

        Found by running a real build rather than by reading, and the first sabotage written for it
        was wrong — moving the VixenTarget block here changes nothing, for the reason above. Moving
        the VixenToolCommand block fails six of this package's seven tests.
        ==========================================================================================
    -->
    <PropertyGroup>
        <!-- Which directory holds Assets/. A game's project file usually sits in it. -->
        <VixenProjectDirectory Condition="'$(VixenProjectDirectory)' == ''">$(MSBuildProjectDirectory)</VixenProjectDirectory>
        <VixenAssetsDirectory Condition="'$(VixenAssetsDirectory)' == ''">$(VixenProjectDirectory)/Assets</VixenAssetsDirectory>
    </PropertyGroup>

    <!--
        The build target, which decides the texture format, the shader dialect and everything else
        that differs per platform. A RuntimeIdentifier is the strongest signal there is — somebody
        publishing for android-arm64 wants Android content — and the machine it is running on is the
        answer when there is no RID, because that is what `dotnet build` on a laptop means.
    -->
    <PropertyGroup Condition="'$(VixenTarget)' == '' AND '$(RuntimeIdentifier)' != ''">
        <VixenTarget Condition="$(RuntimeIdentifier.StartsWith('android'))">Android</VixenTarget>
        <VixenTarget Condition="$(RuntimeIdentifier.StartsWith('ios'))">iOS</VixenTarget>
        <VixenTarget Condition="$(RuntimeIdentifier.StartsWith('browser'))">Web</VixenTarget>
        <VixenTarget Condition="$(RuntimeIdentifier.StartsWith('win'))">Windows</VixenTarget>
        <VixenTarget Condition="$(RuntimeIdentifier.StartsWith('osx'))">MacOS</VixenTarget>
        <VixenTarget Condition="$(RuntimeIdentifier.StartsWith('linux'))">Linux</VixenTarget>
    </PropertyGroup>

    <PropertyGroup Condition="'$(VixenTarget)' == ''">
        <VixenTarget Condition="$([MSBuild]::IsOSPlatform('Windows'))">Windows</VixenTarget>
        <VixenTarget Condition="$([MSBuild]::IsOSPlatform('OSX'))">MacOS</VixenTarget>
        <VixenTarget Condition="'$(VixenTarget)' == ''">Linux</VixenTarget>
    </PropertyGroup>

    <!--
        The build variant, carried into the binary that has to know it.

        Doc 17's five variants are orthogonal to Debug/Release — a Development build is optimised and
        keeps its profiler, and a Server build differs from a Release one only in having no window —
        so the variant cannot be recovered from the compiler configuration at run time. There is no
        other way to get it there either: `#if` cannot express five states across packages that ship
        once, and an environment variable can be wrong.

        `BuildVariantAttribute`'s own documentation says the SDK applies it "rather than by hand",
        and until now nothing did: the CLI's build verb passed VixenVariant into the publish as a
        property and no part of the build or the runtime read it, so a server publish started up,
        detected Release from the configuration, and asked for a window.

        Executables only. BuildVariants.Detect reads the *entry* assembly, so the attribute on a
        library is dead weight — and emitting it there would fail the build of any library that uses
        this SDK without referencing Vixen.App, which is where the type lives.
    -->
    <ItemGroup Condition="'$(VixenVariant)' != '' AND '$(OutputType)' == 'Exe' AND '$(VixenEmitBuildVariant)' != 'false'">
        <AssemblyAttribute Include="Vixen.App.BuildVariantAttribute">
            <_Parameter1>Vixen.App.BuildVariant.$(VixenVariant)</_Parameter1>
            <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
        </AssemblyAttribute>
    </ItemGroup>

    <!--
        ==========================================================================================
        Editor-only code, excluded from the game.

        Doc 36 § P5: a project's `Editor/` folders are compiled *by the running editor*, into an
        assembly that is never written into a build. Unity's second mechanism is exactly this — a
        convention with a compilation consequence — and without the consequence the convention is
        decoration.

        ⚠ Leaving them in is not a warning, it is a broken build. An editor script references
        `Vixen.Editor.Plugin` for `[EditorMenu]`, which a game does not have and must not have; the
        failure is a wall of CS0246 in files the author never asked to compile, in a project that
        was fine until they wrote their first tool.

        ⚠ In the .targets rather than the .props, and it works because item *removal* is order-
        independent in a way a property is not: the SDK's default Compile glob has already run by
        the time this is imported, and removing from a populated item list is precisely what
        `Remove` is for. Adding them back as `None` is what keeps them visible in an IDE — a file
        the project cannot see is one nobody will find to edit.
        ==========================================================================================
    -->
    <ItemGroup Condition="'$(VixenExcludeEditorScripts)' != 'false'">
        <Compile Remove="**/Editor/**/*.cs" />
        <None Include="**/Editor/**/*.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    </ItemGroup>

    <PropertyGroup>
        <VixenContentOutputDirectory Condition="'$(VixenContentOutputDirectory)' == ''">$(VixenProjectDirectory)/Build/$(VixenTarget)</VixenContentOutputDirectory>

        <!--
            The content build imports first unless somebody has already done it in this build, and
            in a normal build VixenImport is exactly that somebody. It has to follow the same
            condition rather than being passed unconditionally: a project that turns the import
            step off and leaves the content build on would otherwise pack a project nothing had
            imported, and be told so by an error about every addressable asset it has.
        -->
        <VixenSkipImportFlag Condition="'$(VixenImportOnBuild)' == 'true'">--no-import</VixenSkipImportFlag>

        <!--
            The address constants. Into obj/ rather than into the project directory, because the file
            is a build output: it is regenerated from the content on every build, nothing should
            merge it, and a game that deletes obj/ should lose nothing it wrote.

            Off by default. Most projects are not gameplay projects and a game that never names an
            address in C# should not have a generated file appear in its compile items — and the
            DefId half is a second opt-in on top, because that file references Vixen.Gameplay and a
            game that declined doc 28's libraries could not compile it.
        -->
        <VixenAddressConstants Condition="'$(VixenAddressConstants)' == ''">false</VixenAddressConstants>
        <VixenAddressNamespace Condition="'$(VixenAddressNamespace)' == ''">$(RootNamespace)</VixenAddressNamespace>
        <VixenAddressIds Condition="'$(VixenAddressIds)' == ''">false</VixenAddressIds>
    </PropertyGroup>

    <!--
        How to run the tool. Three answers, most specific first:

        1. `VixenToolPath`, which a consumer sets when it has its own build of the CLI, and which is
           how this package's own tests drive it without installing anything.
        2. The copy inside this package, if one was shipped with it. Version-locked to the targets
           that call it, which is the whole argument for shipping it here: an SDK and a tool that can
           drift apart will, and the failure is a content build that half works.
        3. `dotnet vixen`, the tool restored into the repository or installed globally.
    -->
    <PropertyGroup Condition="'$(VixenToolPath)' == '' AND Exists('$(VixenSdkDirectory)../tools/vixen.dll')">
        <VixenToolPath>$(VixenSdkDirectory)../tools/vixen.dll</VixenToolPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(VixenToolCommand)' == ''">
        <VixenToolCommand Condition="'$(VixenToolPath)' != '' AND $(VixenToolPath.EndsWith('.dll'))">dotnet "$(VixenToolPath)"</VixenToolCommand>
        <VixenToolCommand Condition="'$(VixenToolCommand)' == '' AND '$(VixenToolPath)' != ''">"$(VixenToolPath)"</VixenToolCommand>
        <VixenToolCommand Condition="'$(VixenToolCommand)' == ''">dotnet vixen</VixenToolCommand>
    </PropertyGroup>

    <!--
        Import before the compiler runs, because generated C# has to exist before CoreCompile reads
        the compile items. That is not hypothetical any more: sixty lines below, this same target
        writes `Addresses.g.cs` and adds it to Compile from inside the target, which only works
        because of this ordering. VXML components and shader parameter keys are the other generated
        C# the ordering is there for.

        The msbuild diagnostic format is the point of the whole target. What an importer said about
        an asset arrives as an MSBuild diagnostic with a file and a code, so it lands in the IDE's
        error list and in a CI log's summary rather than scrolling past as prose from a subprocess.
    -->
    <Target Name="VixenImport"
            BeforeTargets="CoreCompile"
            Condition="'$(VixenImportOnBuild)' == 'true' AND Exists('$(VixenAssetsDirectory)')">

        <!--
            Computed here rather than in a property group above, and the reason is the same ordering
            rule this file opens with: TargetPath is defined by Microsoft.NET.Sdk's own .targets,
            which a project imports after this one, so a property group here would read it as empty.
            Inside a target the evaluation happens at execution time, by which point it is set.
        -->
        <PropertyGroup>
            <VixenGameAssembly Condition="'$(VixenGameAssembly)' == ''">$(TargetPath)</VixenGameAssembly>
            <VixenAssemblyFlags Condition="'$(VixenGameAssembly)' != ''">--assembly "$(VixenGameAssembly)"</VixenAssemblyFlags>

            <!--
                ⚠ On the first build of a project there is no game assembly yet, and a level carrying
                a component the game declares cannot be compiled here. Failing the build over it would
                make that project impossible to build at all: the assembly the import needs is the one
                the compiler this step runs before would have produced.

                So this pass is advisory. It exists to produce generated C# before CoreCompile reads
                the compile items, and it is not the authority on whether the content is good — the
                content build after Build is, it runs its own import with the assembly present, and it
                does fail the build. Anything genuinely wrong is reported there, as an error, once.

                ⚠ And the tool is *told*, rather than only having its exit code ignored. Left to
                itself it emitted `error VX1001` for every level naming the game's own components,
                which ContinueOnError then demoted into every clean build's warning summary: three
                warnings nobody could act on, and a real VX1001 indistinguishable among them. This
                class had already been misdiagnosed twice. The advisory flag below keeps the same
                text, the same code and the same absolute path, and stops the line being an MSBuild
                diagnostic at all — and stops the run ending before it writes the addresses, which
                is the file this whole target runs before CoreCompile to produce.

                ContinueOnError stays on the same condition anyway. It is now for the failure the
                flag cannot cover: a tool that crashed rather than a project that has not compiled.
            -->
            <VixenImportIsAdvisory>false</VixenImportIsAdvisory>
            <VixenImportIsAdvisory Condition="'$(VixenGameAssembly)' != '' AND !Exists('$(VixenGameAssembly)')">true</VixenImportIsAdvisory>
            <VixenImportAdvisoryFlag Condition="'$(VixenImportIsAdvisory)' == 'true'">--advisory</VixenImportAdvisoryFlag>

            <!--
                Absolute, and computed here for the same ordering reason as VixenGameAssembly above:
                IntermediateOutputPath is defined by Microsoft.NET.Sdk's targets, which are imported
                after this file, so a property group at the top would read it as empty. It also has
                to be absolute because the Exec below runs in the *project* directory, which is not
                necessarily the directory the csproj is in.
            -->
            <VixenAddressFile Condition="'$(VixenAddressFile)' == ''">$(IntermediateOutputPath)Vixen/Addresses.g.cs</VixenAddressFile>
            <VixenAddressFullPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(VixenAddressFile)'))</VixenAddressFullPath>

            <VixenAddressFlags Condition="'$(VixenAddressConstants)' == 'true'">--addresses "$(VixenAddressFullPath)" --addresses-namespace $(VixenAddressNamespace)</VixenAddressFlags>
            <VixenAddressFlags Condition="'$(VixenAddressConstants)' == 'true' AND '$(VixenAddressIds)' == 'true'">$(VixenAddressFlags) --address-ids</VixenAddressFlags>
        </PropertyGroup>

        <Message Importance="normal" Text="Vixen: importing $(VixenProjectDirectory) for $(VixenTarget)" />

        <Exec Command="$(VixenToolCommand) import --project &quot;$(VixenProjectDirectory)&quot; --target $(VixenTarget) --format msbuild $(VixenAssemblyFlags) $(VixenAddressFlags) $(VixenImportAdvisoryFlag)"
              WorkingDirectory="$(VixenProjectDirectory)"
              ContinueOnError="$(VixenImportIsAdvisory)"
              StandardOutputImportance="high" />

        <!--
            ⚠ Added here rather than in an ItemGroup above, and that is the whole reason this target
            runs BeforeTargets=CoreCompile. The SDK's default Compile glob was evaluated long before
            this ran, so a file that did not exist then is not in it — an item added inside the target
            is, because CoreCompile reads the items when it executes.
        -->
        <ItemGroup Condition="'$(VixenAddressConstants)' == 'true' AND Exists('$(VixenAddressFullPath)')">
            <Compile Include="$(VixenAddressFullPath)" Visible="false" />
            <FileWrites Include="$(VixenAddressFullPath)" />
        </ItemGroup>
    </Target>

    <!--
        And build the content after the assembly exists, so that a failure to compile is reported
        before a content build nobody can use yet, and so the content can be copied beside the
        binary it belongs to.
    -->
    <Target Name="VixenContentBuild"
            AfterTargets="Build"
            Condition="'$(VixenContentBuildOnBuild)' == 'true' AND Exists('$(VixenAssetsDirectory)')"
            DependsOnTargets="VixenImport">

        <!--
            ⚠ The content build does its own import pass whenever there is a game assembly to load,
            and that is what makes a level able to name a component the game declares. The pass above
            runs BeforeTargets=CoreCompile — before that C# has been compiled — so on a clean build it
            has nothing to load and a scene carrying the game's own !SpawnPoint fails with "nothing in
            this build claims the name". This one runs AfterTargets=Build, where the assembly always
            exists. Skipping it would mean nothing ever compiled such a scene.

            The cost is one extra incremental scan per build, which is the right way round: an import
            with nothing to do is fast, and a level that cannot name the game's own components is a
            limit nobody can work around.
        -->
        <PropertyGroup>
            <VixenGameAssembly Condition="'$(VixenGameAssembly)' == ''">$(TargetPath)</VixenGameAssembly>

            <VixenAssemblyFlags Condition="'$(VixenGameAssembly)' != ''">--assembly "$(VixenGameAssembly)"</VixenAssemblyFlags>
            <VixenSkipImportFlag Condition="'$(VixenAssemblyFlags)' != ''"></VixenSkipImportFlag>
        </PropertyGroup>

        <Message Importance="normal" Text="Vixen: building content into $(VixenContentOutputDirectory)" />

        <Exec Command="$(VixenToolCommand) content build --project &quot;$(VixenProjectDirectory)&quot; --target $(VixenTarget) --output &quot;$(VixenContentOutputDirectory)&quot; --format msbuild $(VixenSkipImportFlag) $(VixenAssemblyFlags)"
              WorkingDirectory="$(VixenProjectDirectory)"
              StandardOutputImportance="high" />

        <CallTarget Targets="VixenCopyContentToOutput" Condition="'$(VixenCopyContentToOutput)' == 'true'" />
    </Target>

    <!--
        Beside the binary, under Content/, which is where the app host looks. Copied rather than
        linked because a game's output directory is what gets zipped, and SkipUnchangedFiles so that
        rebuilding a project whose content did not change does not rewrite every bundle it has.
    -->
    <Target Name="VixenCopyContentToOutput">
        <ItemGroup>
            <VixenBuiltContent Include="$(VixenContentOutputDirectory)/*.bundle;
                                        $(VixenContentOutputDirectory)/catalog.bin;
                                        $(VixenContentOutputDirectory)/catalog.bin.hash" />
        </ItemGroup>

        <Copy SourceFiles="@(VixenBuiltContent)"
              DestinationFolder="$(OutDir)$(VixenContentFolderName)"
              SkipUnchangedFiles="true"
              Condition="'@(VixenBuiltContent)' != ''" />
    </Target>

    <!--
        Publishing needs the same files named again rather than the copy above: `dotnet publish`
        builds its own list from ResolvedFileToPublish, and anything that merely sits in the output
        directory is not in it.
    -->
    <Target Name="VixenAddContentToPublish"
            BeforeTargets="ComputeResolvedFilesToPublishList"
            Condition="'$(VixenCopyContentToOutput)' == 'true' AND Exists('$(VixenContentOutputDirectory)')">

        <ItemGroup>
            <VixenPublishContent Include="$(VixenContentOutputDirectory)/*.bundle;
                                          $(VixenContentOutputDirectory)/catalog.bin;
                                          $(VixenContentOutputDirectory)/catalog.bin.hash" />

            <ResolvedFileToPublish Include="@(VixenPublishContent)">
                <RelativePath>$(VixenContentFolderName)/%(Filename)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

    <!--
        Clean takes back what this put in the output directory, and nothing else. The project's own
        Build/<target> is not cleaned: it is where a person keeps the script that publishes it, and
        deleting somebody's directory because they typed `dotnet clean` is not a trade this makes.
        `vixen content build` already removes the bundles it is replacing.
    -->
    <Target Name="VixenCleanContent" AfterTargets="Clean">
        <ItemGroup>
            <VixenCopiedContent Include="$(OutDir)$(VixenContentFolderName)/*.bundle;
                                         $(OutDir)$(VixenContentFolderName)/catalog.bin;
                                         $(OutDir)$(VixenContentFolderName)/catalog.bin.hash" />
        </ItemGroup>

        <Delete Files="@(VixenCopiedContent)" />
    </Target>

</Project>
