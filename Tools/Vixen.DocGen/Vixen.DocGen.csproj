<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Vixen.DocGen</RootNamespace>
        <AssemblyName>vixen-doc-gen</AssemblyName>

        <!-- Not shipped, for the same reason Vixen.ApiCheck is not: it is the subject of a build
             target and of no use to anybody consuming the engine. -->
        <IsPackable>false</IsPackable>

        <!--
            docs/plan/25 § 3.1. MSBuildWorkspace opens a .slnx only from Roslyn 5.x
            (dotnet/roslyn#77326), and Directory.Packages.props pins Microsoft.CodeAnalysis.CSharp at
            4.11.0 for the generators, which target the compiler and must not be dragged forward by a
            documentation tool. CentralPackageVersionOverrideEnabled is false, so VersionOverride is
            not available: this project opts out of central versions entirely. Nothing references it
            and nothing ships it, so the opt-out costs nothing and the alternative costs the
            generators.
        -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />

        <!--
            Required, and its absence is silent: without the C# language service in the workspace's
            MEF composition every Project.SupportsCompilation is false, GetCompilationAsync returns
            null, and the tool emits an empty graph from a green build.
            docs/plan/spikes/docs-graph/RESULT.md § F2.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />

        <!--
            MSBL001. The locator loads MSBuild out of the SDK it finds; a copy of these beside us is
            how an assembly-load failure at the first OpenSolutionAsync happens. RESULT.md § F3.
        -->
        <PackageReference Include="Microsoft.Build" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.DocGen.Tests" />
    </ItemGroup>

</Project>
