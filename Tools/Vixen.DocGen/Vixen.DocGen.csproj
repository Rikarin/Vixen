<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Vixen.DocGen</RootNamespace>
        <AssemblyName>vixen-doc-gen</AssemblyName>

        <!-- Not shipped, for the same reason Vixen.ApiCheck is not: it is the subject of a build
             target and of no use to anybody consuming the engine. -->
        <IsPackable>false</IsPackable>

        <!-- docs/plan/25 § 3.1. MSBuildWorkspace opens a .slnx only from Roslyn 5.x (dotnet/roslyn#77326),
             which is the central pin now, so this project no longer opts out of central versions. -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Locator" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />

        <!--
            Required, and its absence is silent: without the C# language service in the workspace's
            MEF composition every Project.SupportsCompilation is false, GetCompilationAsync returns
            null, and the tool emits an empty graph from a green build.
            docs/plan/spikes/docs-graph/RESULT.md § F2.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />

        <!--
            MSBL001. The locator loads MSBuild out of the SDK it finds; a copy of these beside us is
            how an assembly-load failure at the first OpenSolutionAsync happens. RESULT.md § F3.
        -->
        <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
        <!-- MSBuild 18 brings it, and the locator refuses it with runtime assets for the same reason. -->
        <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.DocGen.Tests" />
    </ItemGroup>

    <!--
        What git calls the tree, for LogEventRegister's sweep of every [LoggerMessage] (#1424).
        ⚠ Vixen.DocGen.Tests does NOT import this props as well: the type is internal and the tests
        already see this copy through InternalsVisibleTo, so a second copy would be CS0436.
    -->
    <Import Project="..\..\Testing\Vixen.Testing.RepositoryFiles.props" />
</Project>
