<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>

        <!--
            The second test project in the tree to generate one, after `Vixen.Editor.App.Tests`, and
            #1119 is the ratchet: the TEST profile in `Directory.Build.props` sets this false for
            every `*.Tests` project including `Core/**`'s, so no `<see cref>` in any test assembly
            here had ever been checked. CS1591 and CS1573 stay suppressed — a test assembly is not a
            packaged API, so "this member has no comment" is not a question worth asking of it, while
            the rules that catch a *lie* are.

            ⚠ **This project earns it twice over, because eight of the files it compiles are not
            its own.** The `<Compile Include="..\..\build\...">` items below are the build's own
            source, linked in so the subject of these tests is the code the gate runs rather than a
            copy of it — and `build/_build.csproj` sets `GenerateDocumentationFile=false` with
            `TreatWarningsAsErrors=false`, so a cref in any of them had two ways of never being
            read. Here they arrive as errors.

            ⚠ And that cuts the other way too, which is worth knowing before linking the ninth file:
            a cref at `Build` resolves in `build/` and cannot resolve here, because `Build` is not in
            this assembly. `PublicApiTypeNames.cs` carried one; it is `<c>` now, with the reason
            beside it. Attribute a diagnostic to the project that reported it, never to the path.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- The tests compile their own subjects, which is what makes them readable: the fixture is
             the C# whose surface is being asserted, not a binary checked in beside them. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.ApiCheck\Vixen.ApiCheck.csproj" />
    </ItemGroup>

    <!--
        ⚠ The build's own AOT-probe reader, compiled in rather than referenced. `build/_build.csproj`
        is not in Vixen.slnx and nothing in the tree tests it, so its two probe checks — which are
        the *only* enforcement CheckAotIos has — had no fixture at all until this. The file is
        dependency-free on purpose so that linking it here costs nothing and cannot drift: this is
        the same source the gate runs, not a copy of it.
    -->
    <ItemGroup>
        <Compile Include="..\..\build\AotProbeProjectFile.cs" Link="AotProbeProjectFile.cs" />

        <!--
            ⚠ And the rule that compares the probe against the TREE rather than against itself
            (#506). `AssertProbeRootsEveryAssemblyItReferences` asks whether every reference has a
            root, which a probe referencing three assemblies and rooting the same three passes — so
            nothing could see that the gate roots 29 of 95 runtime assemblies while its README said
            it rooted them all. Linked here for the reason the probe reader above is: the gate this
            belongs to is an ILC publish measured in minutes, so a rule that only answers inside it
            is a rule nobody has watched produce an answer.
        -->
        <Compile Include="..\..\build\AotRootingRule.cs" Link="AotRootingRule.cs" />

        <!--
            ⚠ And the build's baseline reader, for the same reason and after the same kind of
            failure: it dropped every `X -> sealed class` line as "a member, not a type", which is
            how this repository spells a type declaration, so CheckDocsCoverage read 2 398 of 4 711
            types and printed a plausible number. Nothing could have caught that without a fixture.
        -->
        <Compile Include="..\..\build\PublicApiTypeNames.cs" Link="PublicApiTypeNames.cs" />

        <!-- Same arrangement, same reason: the comparator that decides whether build/test-cost.txt
             still describes the run that just happened. Its three predecessors were all about a
             project name, so a line whose number was 2x wrong failed nothing (#863). -->
        <Compile Include="..\..\build\TestCostDrift.cs" Link="TestCostDrift.cs" />

        <!-- And the four conditions PruneWorktrees deletes a checkout on. Its removable verdict is
             unreachable on a real machine — a removable worktree is one nobody has — so without a
             linked fixture the only way anyone has ever seen that branch is by sabotage (#561). -->
        <Compile Include="..\..\build\WorktreeSafety.cs" Link="WorktreeSafety.cs" />

        <!--
            ⚠ And the rule that refuses a `[DataContract]` in a project naming neither registration
            generator (#1005). The defect it catches is invisible everywhere else — the attribute
            compiles, the assembly runs, and the type is simply absent from both registries — so a
            rule that has never produced an answer is exactly the wrong thing to ship it as.
            `DataContractGeneratorRuleTests` runs this same source over the repository and over
            synthetic fixtures both ways. `PluginReferenceRule` comes with it because that is where
            the subject set lives, and #872 is the issue about copying one.
        -->
        <Compile Include="..\..\build\DataContractGeneratorRule.cs" Link="DataContractGeneratorRule.cs" />
        <Compile Include="..\..\build\PluginReferenceRule.cs" Link="PluginReferenceRule.cs" />

        <!--
            ⚠ And the strictly narrower one beside it (#1139): a project that names the two
            Vixen.Core generators and not `Vixen.Engine.Generators` reads CLEAN under the rule above
            and is still missing `SceneComponentRegistry.Declare<T>()`. `Vixen.Ai.Nodes` and
            `Vixen.Ai.Perception` were both in that state and both read clean, which is the third
            time the shape was found by hand (#989 → #1005 → #1056). Same arrangement for the same
            reason: the gate is one caller of this source and `ComponentGeneratorRuleTests` is the
            other, because a rule whose only answer comes from a Release solution build is a rule
            nobody has watched produce one.
        -->
        <Compile Include="..\..\build\ComponentGeneratorRule.cs" Link="ComponentGeneratorRule.cs" />

        <!--
            ⚠ And the one a level up (#1165): the two above ask whether a project in this tree names
            a generator, and this one asks whether the PACKAGE carries it. An analyzer does not flow
            through a `ProjectReference`, so a library that never packs its sibling generator ships
            the attributes and none of the code they generate — and every in-tree consumer names the
            generator itself, so no build in this repository can go red over it. Two libraries were
            found in that state by hand, `Vixen.Editor.Inspector` and then `Vixen.Editor.NodeGraph`,
            which is what a rule is for. Same arrangement for the same reason: the gate is one caller
            of this source and `GeneratorPackagingRuleTests` is the other.
        -->
        <Compile Include="..\..\build\GeneratorPackagingRule.cs" Link="GeneratorPackagingRule.cs" />

        <!--
            ⚠ And the case rule (#329), where the argument for a linked fixture is at its strongest:
            its true answer on this tree is "no violations", so the gate alone can never distinguish
            a clean repository from a scan that stopped matching. `PathCaseRuleTests` is the only
            place anything watches it say yes, and it runs the whole sweep over this checkout in
            about a second — no workspace, no Release build, no CI leg.
        -->
        <Compile Include="..\..\build\PathCaseRule.cs" Link="PathCaseRule.cs" />

        <!--
            ⚠ And `CheckStrings`' pattern set (#1203), where the argument is the case rule's exactly
            once removed: its true answer on this tree is "no object-initialiser id", so the gate
            alone cannot distinguish a clean repository from a pattern that stopped matching — and
            the shape it was blind to was blind for as long as the id existed. `StringIdCensusTests`
            runs it over the pre-migration `FoliageMode` text and over the forty-nine object
            initialisers in this tree that build something else.
        -->
        <Compile Include="..\..\build\StringIdCensus.cs" Link="StringIdCensus.cs" />
    </ItemGroup>

    <!--
        ⚠ The Coverage target's cobertura reader, for the same reason and with the same shape. Its
        first version counted every line twice at a rate that was right to three decimal places, and
        the only thing that found that was somebody linking this source into a throwaway harness by
        hand — a proof that left nothing behind. This is that harness, committed: the reader is
        dependency-free on purpose, so linking it here costs nothing and cannot drift from the source
        the target runs.
    -->
    <ItemGroup>
        <Compile Include="..\..\build\CoverageReport.cs" Link="CoverageReport.cs" />
    </ItemGroup>

    <!--
        ⚠ And the membership half of the `Benchmark` gate, which decides which drift is fatal. The
        target it belongs to has never been run by anybody — there is no committed baseline, so it
        fails outright — and that is precisely why the one call site in build/ that broke Nuke's
        argument-quoting rule was in it. A judgement nobody has watched fail is indistinguishable
        from one that cannot.
    -->
    <ItemGroup>
        <Compile Include="..\..\build\BenchmarkInventory.cs" Link="BenchmarkInventory.cs" />
    </ItemGroup>
</Project>
