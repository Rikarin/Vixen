<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- The tests compile their own subjects, which is what makes them readable: the fixture is
             the C# whose surface is being asserted, not a binary checked in beside them. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.ApiCheck\Vixen.ApiCheck.csproj" />
    </ItemGroup>

    <!--
        ⚠ The build's own AOT-probe reader, compiled in rather than referenced. `build/_build.csproj`
        is not in Vixen.slnx and nothing in the tree tests it, so its two probe checks — which are
        the *only* enforcement CheckAotIos has — had no fixture at all until this. The file is
        dependency-free on purpose so that linking it here costs nothing and cannot drift: this is
        the same source the gate runs, not a copy of it.
    -->
    <ItemGroup>
        <Compile Include="..\..\build\AotProbeProjectFile.cs" Link="AotProbeProjectFile.cs" />

        <!--
            ⚠ And the build's baseline reader, for the same reason and after the same kind of
            failure: it dropped every `X -> sealed class` line as "a member, not a type", which is
            how this repository spells a type declaration, so CheckDocsCoverage read 2 398 of 4 711
            types and printed a plausible number. Nothing could have caught that without a fixture.
        -->
        <Compile Include="..\..\build\PublicApiTypeNames.cs" Link="PublicApiTypeNames.cs" />

        <!-- Same arrangement, same reason: the comparator that decides whether build/test-cost.txt
             still describes the run that just happened. Its three predecessors were all about a
             project name, so a line whose number was 2x wrong failed nothing (#863). -->
        <Compile Include="..\..\build\TestCostDrift.cs" Link="TestCostDrift.cs" />

        <!-- And the four conditions PruneWorktrees deletes a checkout on. Its removable verdict is
             unreachable on a real machine — a removable worktree is one nobody has — so without a
             linked fixture the only way anyone has ever seen that branch is by sabotage (#561). -->
        <Compile Include="..\..\build\WorktreeSafety.cs" Link="WorktreeSafety.cs" />
    </ItemGroup>

    <!--
        ⚠ The Coverage target's cobertura reader, for the same reason and with the same shape. Its
        first version counted every line twice at a rate that was right to three decimal places, and
        the only thing that found that was somebody linking this source into a throwaway harness by
        hand — a proof that left nothing behind. This is that harness, committed: the reader is
        dependency-free on purpose, so linking it here costs nothing and cannot drift from the source
        the target runs.
    -->
    <ItemGroup>
        <Compile Include="..\..\build\CoverageReport.cs" Link="CoverageReport.cs" />
    </ItemGroup>

    <!--
        ⚠ And the membership half of the `Benchmark` gate, which decides which drift is fatal. The
        target it belongs to has never been run by anybody — there is no committed baseline, so it
        fails outright — and that is precisely why the one call site in build/ that broke Nuke's
        argument-quoting rule was in it. A judgement nobody has watched fail is indistinguishable
        from one that cannot.
    -->
    <ItemGroup>
        <Compile Include="..\..\build\BenchmarkInventory.cs" Link="BenchmarkInventory.cs" />
    </ItemGroup>
</Project>
