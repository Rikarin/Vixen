<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>

        <!--
            The same opt-out Vixen.Templates.Tests makes, for the same reason and against the same
            two packages. This project needs Roslyn as a library — ProjectPluginTests compiles the
            plugin it discovers — *and* Vixen.Cli, whose Vixen.Live.Cluster reference brings
            Microsoft.Orleans.Sdk 10.2.2, which requires Microsoft.CodeAnalysis.Common >= 5.0.0,
            while Directory.Packages.props pins Microsoft.CodeAnalysis.CSharp at 4.11.0 for the
            generators, which target the compiler and must not be dragged forward by a test host.
            CentralPackageVersionOverrideEnabled is false, so VersionOverride is not available and
            the choice is between four inline versions here and NU1107.
        -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!--
          ⚠ A plugin's importer is only testable against a real assembly on disk that this process
          did not reference: the claim is that the *CLI discovers and loads* it out of the project's
          own Plugins/ folder, and a type this test project already referenced would be in the
          default load context whatever the CLI did. So the test compiles one, the way
          Vixen.AssetCompiler.Tests and Vixen.Editor.Plugin.Tests both do.

          5.0.0 rather than the central 4.11.0 because Orleans needs >= 5.0.0, and exactly 5.0.0
          rather than anything later because Orleans also brings
          Microsoft.CodeAnalysis.Workspaces.Common 5.0.0, whose dependency on
          Microsoft.CodeAnalysis.Common is an exact pin. Vixen.Templates.Tests reached the same two
          numbers from the same two constraints.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Cli\Vixen.Cli.csproj" />

        <!--
            ⚠ `doctor systems` reads declarations a generator emitted, so the fixture systems it is
            tested against have to be declared the same way a project's are. Analyzers do not flow
            through a ProjectReference, so naming GameSystemGenerator here is what makes this test
            assembly a real declared frame rather than a hand-built imitation of one — which is the
            difference between proving the command and proving GameSystemRegistry.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Engine.Generators\Vixen.Engine.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
