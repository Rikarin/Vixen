<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!--
            The shard. `Vixen.Live.Realm` brings the host, `Vixen.Net` and the application host with
            it; a placement backend launches this executable with one argument.

            ⚠ Build this as a server variant — no window, no GPU, a content profile with no textures,
            audio or shader permutations. That is what makes a shard start fast enough to be scaled
            elastically, and it is one property rather than a different program:

                dotnet publish -c Release -p:BuildVariant=Server
        -->
        <PackageReference Include="Vixen.Live.Realm" Version="VIXEN_PACKAGE_VERSION" />

        <ProjectReference Include="..\VixenMmo1.Contracts\VixenMmo1.Contracts.csproj" />
        <ProjectReference Include="..\VixenMmo1.Shared\VixenMmo1.Shared.csproj" />
    </ItemGroup>

</Project>
