<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>

        <!--
            The content's addresses, as C# constants, so `Addresses.Maps.Greenmarch.Address` is a
            compile error when it is wrong and a magic string never is. Written into obj/ by the
            import step before the compiler runs, and regenerated whenever the content changes.

            Here rather than in the realm or the client because both of them reference this project
            and neither should hold its own copy — which is the same argument the block below makes
            about the rules.

            VixenAddressIds adds a DefId beside each address. It needs Vixen.Gameplay, so it is a
            second opt-in: a game that declined doc 28's libraries still gets its addresses.
        -->
        <VixenAddressConstants>true</VixenAddressConstants>
        <VixenAddressNamespace>VixenMmo1</VixenAddressNamespace>
        <VixenAddressIds>false</VixenAddressIds>
        <VixenProjectDirectory>$(MSBuildThisFileDirectory)../VixenMmo1.Content</VixenProjectDirectory>
    </PropertyGroup>

    <ItemGroup>
        <!--
            ⚠ This project exists to stop one specific bug, and it is the classic one: the client's
            prediction and the server's simulation drifting into two implementations of one rule.
            docs/plan/27 § The three assemblies a game writes — the rules both ends run live here,
            once, and `MispredictionCount` in Vixen.Net.Prediction is the number that catches it when
            they do not.

            Referenced by the client and the realm. Not by the gate, and not by the orchestrator:
            neither of them simulates anything.
        -->
        <ProjectReference Include="..\VixenMmo1.Contracts\VixenMmo1.Contracts.csproj" />
    </ItemGroup>

</Project>
