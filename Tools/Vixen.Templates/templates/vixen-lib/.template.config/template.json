        "language": "C#",
        "type": "project"
    },
    "sourceName": "VixenLibrary1",
    "defaultName": "VixenLibrary1",
    "preferNameDirectory": true,
    "sources": [
        {
            "modifiers": [
                {
                    "exclude": [ "**/[Bb]in/**", "**/[Oo]bj/**" ]
                }
            ]
        }
    ]
