<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.App\Vixen.App.csproj" />

        <!-- The content tests write a real bundle and a real catalog, so they need the serializer
             generated for their own [DataContract] asset. Analyzers do not flow through a
             ProjectReference. -->
        <!--
            `HostedFrame` below is a [GameSystem], and what `HostedDeclaredSystemTests` is about is
            whether a *compiled* declaration reaches the host — so it has to be collected by the
            generator here rather than declared by hand.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Engine.Generators\Vixen.Engine.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <ProjectReference Include="..\..\Core\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- docs/plan/12's in-process application host. Linked rather than referenced; the props file
         says why, and this is the project it was written against. -->
    <Import Project="..\..\Testing\Vixen.Testing.TestApp.props" />
</Project>
