<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Vixen.TailwindParity</RootNamespace>
        <AssemblyName>Vixen.TailwindParity</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!--
            Not shipped and not referenced by anything that ships. This reads two files in `docs/`
            and prints what disagrees; the thing that makes it a gate rather than a script somebody
            remembers to run is `Vixen.TailwindParity.Tests`, which calls `ParityAudit` against the
            committed snapshot on every test run.
        -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--
            ⚠ The one half of this tool that is not a comparison of two files. A utility root is a
            name and can be checked against the ledger's own text; a *variant* is a prefix, so "does
            Vixen support `before:`?" can only be asked by handing a class to the thing that resolves
            one. Referenced rather than re-implemented, for the reason doc 43's Part 5 gives about a
            parity test that checked a C# re-implementation rather than the shader.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Styling.Utilities\Vixen.Ui.Styling.Utilities.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.TailwindParity.Tests" />
    </ItemGroup>

    <!--
        ⚠ The snapshot generator's `node_modules` sits beside this csproj and MSBuild would otherwise
        glob the `.cs` files inside a published npm package into the compilation. `tailwindcss` ships
        none today; the next dependency added to it might.
    -->
    <ItemGroup>
        <Compile Remove="node_modules/**" />
        <None Remove="node_modules/**" />
    </ItemGroup>
</Project>
