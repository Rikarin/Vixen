<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Sdk.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!--
            Referenced rather than spawned, as `Vixen.StyleGen.Tests` is: what is worth testing here
            is what the generator writes for a given database, and a test that has to parse a
            subprocess's stdout to find that out is one whose failures are a paragraph rather than a
            line number. `Main` is the entry point under test because the artefact names are
            dispatched there — a table written by the wrong arm is one of the failures this catches.
        -->
        <ProjectReference Include="..\Vixen.UnicodeTableGen\Vixen.UnicodeTableGen.csproj" />
    </ItemGroup>
</Project>
