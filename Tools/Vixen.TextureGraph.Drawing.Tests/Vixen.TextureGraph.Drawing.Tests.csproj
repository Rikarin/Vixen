<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <RootNamespace>Vixen.TextureGraph.Drawing.Tests</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Vixen.TextureGraph.Tests\TextureKernelHarness.cs" Link="TextureKernelHarness.cs" />
        <ProjectReference Include="..\Vixen.TextureGraph.Drawing\Vixen.TextureGraph.Drawing.csproj" />
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Vulkan\Vixen.Graphics.Vulkan.csproj" />
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Null\Vixen.Graphics.Null.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The editor's own UI face, linked so no second copy of the face can drift. -->
        <EmbeddedResource Include="..\..\Editor\Vixen.Editor.App\Fonts\OpenSans-Regular.ttf"
                          Link="Fonts\OpenSans-Regular.ttf"
                          LogicalName="Fonts.OpenSans-Regular.ttf" />
    </ItemGroup>
</Project>
