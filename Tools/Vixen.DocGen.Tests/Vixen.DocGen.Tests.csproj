<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.ApiCheck.Tests. -->
        <OutputType>Exe</OutputType>

        <!--
            Follows Vixen.DocGen out of central package management, and has to: its subject carries
            Roslyn 5.6.0 transitively, and a test project pinned to the repository's 4.11.0 would be
            a downgrade the restore refuses.
        -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- The tests compile their own subjects: a fixture is the C# whose classification is being
             asserted, not a binary checked in beside them. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.DocGen\Vixen.DocGen.csproj" />
    </ItemGroup>

</Project>
