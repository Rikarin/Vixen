<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Vixen.ApiCheck</RootNamespace>
        <AssemblyName>vixen-api-check</AssemblyName>

        <!--
            Not shipped. This is the subject of `nuke CheckApi` and nothing else: a package that
            diffs the public surface of other packages is of no use to anybody consuming the engine,
            and shipping it would put Roslyn in a restore graph that has no other reason to carry it.
        -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--
            Roslyn reads the metadata and formats the signatures. The alternative — System.Reflection
            over a MetadataLoadContext — would mean writing a C# signature formatter by hand.

            ⚠ The baseline format is *derived from* Microsoft.CodeAnalysis.PublicApiAnalyzers' and is
            not the same: this tool's own output is the definition (#1340). The analyzer writes `!` on
            every non-nullable reference and this tool never does; it adds lines the analyzer has no
            notion of (a base type, a `Requires*` contract); and the analyzer is referenced nowhere in
            this repository, so nothing reads these files but CheckApi. This comment used to say the
            two formats were one, and a baseline line written in the analyzer's dialect was the result.
            ApiDialect reports that line by name, and ApiDialectTests checks every committed baseline
            for it without a Release build.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.ApiCheck.Tests" />
    </ItemGroup>
</Project>
