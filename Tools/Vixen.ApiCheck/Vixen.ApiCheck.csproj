<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Vixen.ApiCheck</RootNamespace>
        <AssemblyName>vixen-api-check</AssemblyName>

        <!--
            Not shipped. This is the subject of `nuke CheckApi` and nothing else: a package that
            diffs the public surface of other packages is of no use to anybody consuming the engine,
            and shipping it would put Roslyn in a restore graph that has no other reason to carry it.
        -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--
            Roslyn reads the metadata and formats the signatures. The alternative — System.Reflection
            over a MetadataLoadContext — would mean writing a C# signature formatter by hand, and the
            output has to agree with what Microsoft.CodeAnalysis.PublicApiAnalyzers writes, because
            the baseline files this tool maintains are that analyzer's file format. Using the same
            library that produces those files is the cheapest way to keep the two in agreement.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.ApiCheck.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <!--
            #821's ratchet. The TOOLING profile in `Directory.Build.props` sets this false for all of
            `Editor/**`, `Tools/**` and `Raven/**`, so no `<see cref>` under any of them was ever
            checked — ask what that gate printed on the day it did not run: `0 Warning(s)`. CS1591
            and CS1573 stay suppressed: "this public member has no comment" is a question about a
            packaged API surface and is not what this is for; the rules that catch a *lie* are.
            Measured before flipping, and every diagnostic it reported is fixed in the same commit.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
