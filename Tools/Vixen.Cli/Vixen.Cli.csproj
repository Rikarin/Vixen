<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Vixen.Cli</RootNamespace>
        <AssemblyName>vixen</AssemblyName>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>vixen</ToolCommandName>

        <!--
            Explicit, because the package id otherwise defaults to AssemblyName and this would ship
            as `vixen`. The `Vixen.` prefix is the reserved one on nuget.org, so an unprefixed id is
            not covered by the reservation — and it squats a very generic name besides. The command
            a person types stays `vixen`; only the thing they install is dotted.
            Vixen.Raven.Cli reaches the same conclusion for the same reason.
        -->
        <PackageId>Vixen.Cli</PackageId>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>
            The Vixen command line: import a project's assets, build its content, check its health,
            and serve a build to a device.
        </Description>
        <PackageTags>cli;tooling;addressables;content;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The `dotnet new` templates, embedded so that `vixen new` writes the same files
            `dotnet new vixen-game` does. There is no ProjectReference to go with this: Vixen.Templates
            is a content-only package with no assembly, so there is nothing to reference — what is
            shared is the tree of files, and TemplateCatalog is what reads it back out.

            ⚠ LogicalName is spelled out, with the separators normalised. The default naming folds
            directory separators into dots, which makes `Shaders/ui.vert.spv` and
            `Shaders.ui.vert.spv` the same resource name; and %(RecursiveDir) uses the host's
            separator, which would otherwise put a different set of resource names in a Windows build
            than in a Linux one — in an assembly the repository requires to be deterministic.
        -->
        <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\Vixen.Templates\templates\**\*"
                          LogicalName="Vixen.Templates/$([MSBuild]::ValueOrDefault('%(RecursiveDir)', '').Replace('\', '/'))%(Filename)%(Extension)"
                          Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Editor\Vixen.Editor.Assets\Vixen.Editor.Assets.csproj" />
        <ProjectReference Include="..\..\Editor\Vixen.Editor.Core\Vixen.Editor.Core.csproj" />

        <!-- `content serve` is the same server the standalone tool is, so that a project has one
             entry point rather than two things to install. -->
        <ProjectReference Include="..\Vixen.ContentServer\Vixen.ContentServer.csproj" />

        <!-- The out-of-process import mode runs importers in worker processes. This reference is
             what puts the worker assembly beside this one, which is where CompilerPool looks. -->
        <ProjectReference Include="..\Vixen.AssetCompiler\Vixen.AssetCompiler.csproj" />

        <!-- The shader bundle a shipping build loads instead of compiling. This is a build-time
             library and it brings Raven with it, which is exactly right here and exactly wrong in
             anything that ships — see Tools/Vixen.ShaderCompiler's README. -->
        <ProjectReference Include="..\Vixen.ShaderCompiler\Vixen.ShaderCompiler.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Cli.Tests" />
    </ItemGroup>

</Project>
