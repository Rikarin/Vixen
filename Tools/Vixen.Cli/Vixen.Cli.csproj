<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Vixen.Cli</RootNamespace>
        <AssemblyName>vixen</AssemblyName>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>vixen</ToolCommandName>

        <!--
            Explicit, because the package id otherwise defaults to AssemblyName and this would ship
            as `vixen`. The `Vixen.` prefix is the reserved one on nuget.org, so an unprefixed id is
            not covered by the reservation — and it squats a very generic name besides. The command
            a person types stays `vixen`; only the thing they install is dotted.
            Vixen.Raven.Cli reaches the same conclusion for the same reason.
        -->
        <PackageId>Vixen.Cli</PackageId>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>
            The Vixen command line: import a project's assets, build its content, check its health,
            and serve a build to a device.
        </Description>
        <PackageTags>cli;tooling;addressables;content;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />

        <!--
            The engine's shader library, beside the CLI, on exactly Vixen.Editor.Host's terms and for
            a reason that had gone unnoticed: `vixen build` compiled a project's own *.rvn and nothing
            else, so any project shader importing `Vixen.Shaders.Core` — which is every shader that
            uses the engine's material model, and every shader a graph emits — could not be baked at
            all. The editor compiled it and the build could not, which is the shape of gap that is
            only found when somebody ships.

            ⚠ Files rather than resources, because the source hash the artefacts carry is taken over
            the texts: a resource written to a temp directory first would make the hash depend on
            where that directory was.
        -->
        <None Include="..\..\Raven\Library\**\*.rvn"
              Link="Shaders\Library\%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              Visible="false" />
    </ItemGroup>

<!--
    The `dotnet new` templates used to be embedded here. They moved to Vixen.Editor.Core with
    TemplateCatalog, because the editor's New Project needs the same scaffold — an editor whose new
    projects have no .csproj is one whose Build and Run is greyed for every project it makes.
    `vixen new` reads them through the same type it always did.
-->

    <ItemGroup>
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Editor\Vixen.Editor.Assets\Vixen.Editor.Assets.csproj" />
        <ProjectReference Include="..\..\Editor\Vixen.Editor.Core\Vixen.Editor.Core.csproj" />

        <!--
            The graph half of `texture bake` evaluates a `.vxtexgraph` (issue 1020). This is the
            compiler, the kernels, the plan and the evaluator, and deliberately *not*
            `Vixen.Editor.Texturing`: the plugin is the panel and the document, and it brings
            `Vixen.Editor.Ui` and `Vixen.Editor.AssetEditors` with it, which is an editor shell
            inside a command-line tool. Everything a bake needs was made public for a host to reach
            — `TextureGraphCompiler` (738), `TextureCompoundLibrary.Publish` (799),
            `TextureGraphExternals.Upload` — so this route calls the same code the panel does rather
            than a copy of it.
        -->
        <ProjectReference Include="..\..\Editor\Vixen.Editor.TextureGraph\Vixen.Editor.TextureGraph.csproj" />

        <!--
            ⚠ **And a GPU, which this tool had none of and whose absence was the whole of issue
            1020.** Named alone, rather than taken through `Tools/Vixen.App`'s `GraphicsHost`: that
            one walks a preference list ending in `Vixen.Graphics.Null`, and a headless bake that
            fell through to the device that draws nothing would write black PNGs and a valid
            `.vxmat` over an artist's material, exit 0, and print healthy counters. Referencing one
            backend is what makes "there is no fallback" a fact about this assembly rather than a
            branch — `TextureCommandTests` reads the shipped assemblies and refuses the Null backend
            among them. It also keeps the window system, the platform layer and two more backends
            out of a `dotnet tool`.
        -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Vulkan\Vixen.Graphics.Vulkan.csproj" />

        <!-- `content serve` is the same server the standalone tool is, so that a project has one
             entry point rather than two things to install. -->
        <ProjectReference Include="..\Vixen.ContentServer\Vixen.ContentServer.csproj" />

        <!--
          ⚠ Tools/ -> Live/ is deliberately unconstrained (doc 27 § Repository layout): `vixen live`
          is § Diagnostics' own requirement, and a CLI that operates the fleet has to link it.
          Pretending otherwise would have made this the exception instead of the rule.
        -->
        <ProjectReference Include="..\..\Live\Vixen.Live.Cluster\Vixen.Live.Cluster.csproj" />

        <!-- The out-of-process import mode runs importers in worker processes. This reference is
             what puts the worker assembly beside this one, which is where CompilerPool looks. -->
        <ProjectReference Include="..\Vixen.AssetCompiler\Vixen.AssetCompiler.csproj" />

        <!-- `frame explode` runs the !StandardFrame expansion, and the effect set is the assembly
             that owns it — the same PostEffectFactory a host registers is the transformer here. -->
        <ProjectReference Include="..\..\Core\Vixen.Rendering.PostFx\Vixen.Rendering.PostFx.csproj" />

        <!-- `doctor systems` reads GameSystemRegistry, which the loaded assembly's generated module
             initializer fills, and orders it with SystemGraph.Plan — the runner's own sort. Both
             already arrived transitively; naming them says that the CLI depends on the frame's
             vocabulary directly, so a reshuffle of Editor/ cannot quietly take them away. -->
        <ProjectReference Include="..\..\Core\Vixen.Engine\Vixen.Engine.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Ecs\Vixen.Ecs.csproj" />

        <!-- The shader bundle a shipping build loads instead of compiling. This is a build-time
             library and it brings Raven with it, which is exactly right here and exactly wrong in
             anything that ships — see Tools/Vixen.ShaderCompiler's README. -->
        <ProjectReference Include="..\Vixen.ShaderCompiler\Vixen.ShaderCompiler.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Cli.Tests" />
    </ItemGroup>

</Project>
