edges:
  - { fromNode: 2, fromPort: Out, toNode: 10, toPort: Input }
  - { fromNode: 10, fromPort: Out, toNode: 3, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 8, toPort: Background }
  - { fromNode: 5, fromPort: Out, toNode: 8, toPort: Foreground }
  - { fromNode: 8, fromPort: Out, toNode: 6, toPort: First }
  - { fromNode: 5, fromPort: Out, toNode: 6, toPort: Second }
  - { fromNode: 6, fromPort: Out, toNode: 9, toPort: Pattern }
  - { fromNode: 1, fromPort: Columns, toNode: 9, toPort: Grid X }
  - { fromNode: 1, fromPort: Rows, toNode: 9, toPort: Grid Y }
  - { fromNode: 9, fromPort: Out, toNode: 7, toPort: Input }
  - { fromNode: 7, fromPort: Out, toNode: 4, toPort: Out }
groups: []
comments: []
interface:
  - name: Columns
    direction: Input
    kind: Int
    default: [6]
    summary: How many arcs across the image.
  - name: Rows
    direction: Input
    kind: Int
    default: [8]
    summary: How many rows of arcs down the image. An even number keeps the bond across the seam.
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: 'Rows of shallow arcs of setts, each row half an arc along and laid over the one above, with dark joints between the courses.'
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1', summary: 'Rows of shallow overlapping arcs of setts, like a segmental arc pavement.' }
parameters:
  - name: bevel
    label: Bevel
    default: '0.02'
    summary: 'How soft an arc''s outer edge is.'
    kind: Float
    minimum: 0
    maximum: 0.5
    group: Arc Pavement
