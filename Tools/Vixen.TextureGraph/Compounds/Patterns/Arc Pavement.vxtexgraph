  - id: 10
    type: Colour/Grayscale
    x: -1120
    y: 0
    values:
      Weight R: [1]
      Weight G: [0]
      Weight B: [0]
    texts: {}
  - id: 3
    type: Colour/Gradient Map
    x: -960
    y: 0
    values: {}
    texts:
      Ramp: 'ramp:0 ffffffff,0.52 ffffffff,0.55 404040ff,0.58 ffffffff,0.68 ffffffff,0.71 404040ff,0.74 ffffffff,0.84 ffffffff,0.87 404040ff,0.9 ffffffff,1 ffffffff'
  - id: 5
    type: Source/Shape
    x: -960
    y: 240
    values: {}
