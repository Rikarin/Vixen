version: 1
name: Fan Pavement
nodes:
  - id: 1
    type: Sub-graph/Input
    x: -1280
    y: 0
    values: {}
    texts: {}
  - id: 2
    type: Source/Gradient
    x: -1280
    y: 240
    values:
      Scale: [1]
    texts:
      Kind: Radial
  - id: 3
    type: Colour/Grayscale
    x: -960
    y: 240
    values:
      Weight R: [1]
      Weight G: [0]
      Weight B: [0]
    texts: {}
  - id: 4
    type: Colour/Invert
    x: -640
    y: 240
    values: {}
    texts: {}
  - id: 5
    type: Colour/Quantise
    x: -320
    y: 240
    values: {}
    texts: {}
  - id: 6
    type: Source/Shape
    x: -320
    y: 480
    values: {}
    texts:
      Kind: Disc
      '=Falloff': bevel
  - id: 7
    type: Colour/Levels
    x: 0
    y: 240
    values:
      Output Black: [0.35]
    texts: {}
  - id: 8
    type: Colour/Blend
    x: 320
    y: 240
    values: {}
    texts:
      Mode: Multiply
  - id: 11
    type: Colour/Channel Shuffle
    x: 480
    y: 240
    values: {}
    texts:
      Alpha From: SecondRed
  - id: 9
    type: Placement/Tile Sampler
    x: 640
    y: 0
    values:
      Row Offset: [0.5]
      Scale: [1.5]
      Alpha Coverage: [1]
    texts:
      Accumulation: Blend
  - id: 12
    type: Colour/Grayscale
    x: 800
    y: 0
    values:
      Weight R: [1]
      Weight G: [0]
      Weight B: [0]
    texts: {}
  - id: 10
    type: Sub-graph/Output
    x: 960
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 2, fromPort: Out, toNode: 3, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Input }
  - { fromNode: 4, fromPort: Out, toNode: 5, toPort: Input }
  - { fromNode: 1, fromPort: Arcs, toNode: 5, toPort: Levels }
  - { fromNode: 5, fromPort: Out, toNode: 7, toPort: Input }
  - { fromNode: 7, fromPort: Out, toNode: 8, toPort: Background }
  - { fromNode: 6, fromPort: Out, toNode: 8, toPort: Foreground }
  - { fromNode: 8, fromPort: Out, toNode: 11, toPort: First }
  - { fromNode: 6, fromPort: Out, toNode: 11, toPort: Second }
  - { fromNode: 11, fromPort: Out, toNode: 9, toPort: Pattern }
  - { fromNode: 1, fromPort: Columns, toNode: 9, toPort: Grid X }
  - { fromNode: 1, fromPort: Rows, toNode: 9, toPort: Grid Y }
  - { fromNode: 9, fromPort: Out, toNode: 12, toPort: Input }
  - { fromNode: 12, fromPort: Out, toNode: 10, toPort: Out }
groups: []
comments: []
interface:
  - name: Columns
    direction: Input
    kind: Int
    default: [6]
    summary: How many fans across the image.
  - name: Rows
    direction: Input
    kind: Int
    default: [6]
    summary: How many rows of fans down the image. An even number keeps the bond across the seam.
  - name: Arcs
    direction: Input
    kind: Int
    default: [4]
    summary: How many rings of setts in each fan.
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: 'Overlapping fans of stone setts laid in rings, each row half a fan along, every later row over the one before.'
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1', summary: 'Overlapping fans of setts in rings, like a cobbled fan pavement.' }
parameters:
  - name: bevel
    label: Bevel
    default: '0.04'
    summary: 'How soft each fan''s outer edge is.'
    kind: Float
    minimum: 0
    maximum: 0.5
    group: Fan Pavement
