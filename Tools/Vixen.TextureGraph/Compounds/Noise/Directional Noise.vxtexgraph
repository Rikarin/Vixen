version: 1
name: Directional Noise
nodes:
  - id: 1
    type: Sub-graph/Input
    x: -1280
    y: 0
    values: {}
    texts: {}
  - id: 2
    type: Source/Noise
    x: -960
    y: 0
    values:
      Octaves: [3]
    texts:
      Basis: Gradient
  - id: 3
    type: Filters/Directional Blur
    x: -640
    y: 0
    values: {}
    texts:
      '=Length': length
  - id: 4
    type: Colour/Auto Levels
    x: -320
    y: 0
    values: {}
    texts: {}
  - id: 5
    type: Sub-graph/Output
    x: 0
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 1, fromPort: Scale, toNode: 2, toPort: Scale }
  - { fromNode: 1, fromPort: Angle, toNode: 3, toPort: Angle }
  - { fromNode: 2, fromPort: Out, toNode: 3, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Input }
  - { fromNode: 4, fromPort: Out, toNode: 5, toPort: Out }
groups: []
comments: []
interface:
  - name: Scale
    direction: Input
    kind: Float
    default: [48]
    summary: 'How fine the grain is, in cells of the noise across the image.'
  - name: Angle
    direction: Input
    kind: Float
    default: [0]
    summary: 'Which way the grain runs, in radians from the right towards the bottom.'
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: 'A noise smeared along one direction, so it reads as a grain at any angle. A smear wraps, so it tiles at every angle.'
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1', summary: 'A noise drawn out along one direction, like a brushed or wind-blown grain.' }
parameters:
  - name: length
    label: Length
    default: '48'
    summary: 'How far each grain is drawn out, in texels at the graph''s base resolution.'
    kind: Float
    minimum: 0
    maximum: 256
    group: Directional Noise
