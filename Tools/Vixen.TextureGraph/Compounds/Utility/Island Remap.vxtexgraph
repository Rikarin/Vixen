  - id: 2
    type: Analysis/Flood Fill
    x: -960
    y: 0
    values: {}
    texts:
      Kind: LocalUv
  - id: 3
    type: Space/UV Remap
    x: -640
    y: 0
    values: {}
    texts: {}
  - id: 4
    type: Colour/Blend
    x: -320
    y: 0
    values: {}
    texts:
      Mode: Multiply
  - id: 5
    type: Sub-graph/Output
    x: 0
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 1, fromPort: Mask, toNode: 2, toPort: Mask }
  - { fromNode: 2, fromPort: Out, toNode: 3, toPort: UV }
  - { fromNode: 1, fromPort: Pattern, toNode: 3, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Background }
  - { fromNode: 1, fromPort: Mask, toNode: 4, toPort: Foreground }
  - { fromNode: 4, fromPort: Out, toNode: 5, toPort: Out }
groups: []
comments: []
interface:
  - name: Mask
    direction: Input
    kind: Image
    default: []
    summary: 'The islands. A single channel: above a half is inside.'
  - name: Pattern
    direction: Input
    kind: Image
    default: []
    summary: 'The picture laid into every island, stretched to its box.'
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: 'The pattern laid once into each island''s own box, so every plank, tile or stone gets the whole picture; nought between.'
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1', summary: 'Lays a picture into every island of a mask, stretched to the island''s box.' }
parameters: []
