version: 1
name: Hammered
nodes:
  - id: 1
    type: Sub-graph/Input
    x: -960
    y: 0
    values: {}
    texts: {}
  - id: 2
    type: Source/Noise
    x: -960
    y: 320
    values:
      Octaves: [1]
    texts:
      Basis: Worley
      '=Scale': count
  - id: 3
    type: Colour/Auto Levels
    x: -640
    y: 320
    values: {}
    texts: {}
  - id: 4
    type: Filters/Pixel Processor
    x: 0
    y: 0
    values: {}
    texts:
      Expression: float4(lerp(a.xyz, saturate(float3(x, x, x) + (saturate(b.xxx) - 0.5f) * y), z), 1f)
      '=X': roughness
      '=Y': variation
      '=Z': amount
  - id: 5
    type: Filters/Pixel Processor
    x: 0
    y: 160
    values: {}
    texts:
      Expression: float4(a.xyz + (saturate(b.xxx) * saturate(b.xxx) - 0.35f) * x * 0.5f * y, 1f)
      '=X': depth
      '=Y': amount
  - id: 6
    type: Sub-graph/Output
    x: 320
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 2, fromPort: Out, toNode: 3, toPort: Input }
  - { fromNode: 1, fromPort: roughness, toNode: 4, toPort: A }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: B }
  - { fromNode: 1, fromPort: height, toNode: 5, toPort: A }
  - { fromNode: 3, fromPort: Out, toNode: 5, toPort: B }
  - { fromNode: 4, fromPort: Out, toNode: 6, toPort: roughness }
  - { fromNode: 5, fromPort: Out, toNode: 6, toPort: height }
groups: []
comments: []
interface:
  - name: roughness
    direction: Input
    kind: Image
    default: []
    summary: The roughness beneath, which the finish replaces by Amount.
  - name: height
    direction: Input
    kind: Image
    default: []
    summary: The height beneath, which the hammer dents.
  - name: roughness
    direction: Output
    kind: Image
    default: []
    summary: A roughness polished at the bottom of each dent and duller at its rim.
  - name: height
    direction: Output
    kind: Image
    default: []
    summary: The height beneath with a shallow round dent at every blow.
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1', summary: 'Metal beaten by a round hammer: overlapping shallow dents, polished where each blow landed.' }
parameters:
  - name: count
    label: Blows
    default: '12'
    summary: How many dents lie across the map.
    kind: Float
    minimum: 2
    maximum: 64
    group: Pattern
  - name: roughness
    label: Roughness
    default: '0.3'
    summary: The roughness of the beaten surface, on average.
    kind: Float
    minimum: 0
    maximum: 1
    group: Surface
  - name: variation
    label: Variation
    default: '0.2'
    summary: How much duller a dent's rim is than its polished bottom.
    kind: Float
    minimum: 0
    maximum: 1
    group: Surface
  - name: depth
    label: Depth
    default: '0.3'
    summary: How deep the dents are. One is half of the height's range.
    kind: Float
    minimum: 0
    maximum: 1
    group: Surface
  - name: amount
    label: Amount
    default: '1'
    summary: How much of the finish shows over what is beneath.
    kind: Float
    minimum: 0
    maximum: 1
    group: Surface
