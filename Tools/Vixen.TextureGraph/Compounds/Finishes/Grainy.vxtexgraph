version: 1
name: Grainy
nodes:
  - id: 1
    type: Sub-graph/Input
    x: -960
    y: 0
    values: {}
    texts: {}
  - id: 2
    type: Source/Noise
    x: -960
    y: 320
    values:
      Octaves: [1]
    texts:
      Basis: White
      '=Scale': grain
  - id: 3
    type: Filters/Blur HQ
    x: -640
    y: 320
    values: {}
    texts:
      '=Sigma': softness * 300f / grain
  - id: 4
    type: Colour/Auto Levels
    x: -320
    y: 320
    values: {}
    texts: {}
  - id: 5
    type: Filters/Pixel Processor
    x: 0
    y: 0
    values: {}
    texts:
      Expression: float4(lerp(a.xyz, saturate(float3(x, x, x) + (b.xxx - 0.5f) * y), z), 1f)
      '=X': roughness
      '=Y': variation
      '=Z': amount
  - id: 6
    type: Filters/Pixel Processor
    x: 0
    y: 160
    values: {}
    texts:
      Expression: float4(a.xyz + (b.xxx - 0.5f) * x * 0.1f * y, 1f)
      '=X': depth
      '=Y': amount
  - id: 7
    type: Sub-graph/Output
    x: 320
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 2, fromPort: Out, toNode: 3, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Input }
  - { fromNode: 1, fromPort: roughness, toNode: 5, toPort: A }
  - { fromNode: 4, fromPort: Out, toNode: 5, toPort: B }
  - { fromNode: 1, fromPort: height, toNode: 6, toPort: A }
  - { fromNode: 4, fromPort: Out, toNode: 6, toPort: B }
  - { fromNode: 5, fromPort: Out, toNode: 7, toPort: roughness }
  - { fromNode: 6, fromPort: Out, toNode: 7, toPort: height }
groups: []
comments: []
interface:
  - name: roughness
    direction: Input
    kind: Image
    default: []
    summary: The roughness beneath, which the finish replaces by Amount.
  - name: height
    direction: Input
    kind: Image
    default: []
    summary: The height beneath, which the grain pits.
  - name: roughness
    direction: Output
    kind: Image
    default: []
    summary: A matt roughness that flickers from grain to grain.
  - name: height
    direction: Output
    kind: Image
    default: []
    summary: The height beneath with a fine, even tooth.
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1', summary: 'A blasted surface: an even, fine grain over everything, with no direction and no larger ripple.', doesNotTile: 'It draws its own pattern where it lies, so the pattern stays put when the picture beneath moves. The pattern itself tiles.' }
parameters:
  - name: grain
    label: Grain
    default: '256'
    summary: How many grains lie across the map. More is finer.
    kind: Float
    minimum: 16
    maximum: 1024
    group: Pattern
  - name: softness
    label: Softness
    default: '0.3'
    summary: How rounded each grain is. Nought is sharp-edged, one blurs a grain into its neighbours.
    kind: Float
    minimum: 0
    maximum: 1
    group: Pattern
  - name: roughness
    label: Roughness
    default: '0.6'
    summary: The roughness of the blasted surface, on average.
    kind: Float
    minimum: 0
    maximum: 1
    group: Surface
  - name: variation
    label: Variation
    default: '0.2'
    summary: How much the roughness differs from one grain to the next.
    kind: Float
    minimum: 0
    maximum: 1
    group: Surface
  - name: depth
    label: Depth
    default: '0.2'
    summary: How deep the grain bites. One is a tenth of the height's range.
    kind: Float
    minimum: 0
    maximum: 1
    group: Surface
  - name: amount
    label: Amount
    default: '1'
    summary: How much of the finish shows over what is beneath.
    kind: Float
    minimum: 0
    maximum: 1
    group: Surface
