version: 1
name: Pixelate
nodes:
  - id: 1
    type: Sub-graph/Input
    x: -640
    y: 0
    values: {}
    texts: {}
  - id: 2
    type: Filters/Pixel Processor
    x: -640
    y: 240
    values: {}
    texts:
      Expression: float4((floor(uv.x * max(1f, round(x))) + 0.5f) / max(1f, round(x)), (floor(uv.y * max(1f, round(y))) + 0.5f) / max(1f, round(y)), 0f, 1f)
      '=X': across
      '=Y': down
  - id: 3
    type: Space/UV Remap
    x: -320
    y: 0
    values: {}
    texts: {}
  - id: 4
    type: Sub-graph/Output
    x: 0
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 1, fromPort: Input, toNode: 3, toPort: Input }
  - { fromNode: 2, fromPort: Out, toNode: 3, toPort: UV }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Out }
groups: []
comments: []
interface:
  - name: Input
    direction: Input
    kind: Image
    default: []
    summary: The picture to cut into blocks.
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: The picture as a grid of flat blocks, each the colour at its middle.
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1', summary: 'Cuts a picture into a grid of flat blocks, each the colour the picture has at its middle. Any number of blocks, not only powers of two.' }
parameters:
  - name: across
    label: Across
    default: '32'
    summary: How many blocks across the map, rounded to a whole number.
    kind: Float
    minimum: 1
    maximum: 1024
    group: Pixelate
  - name: down
    label: Down
    default: '32'
    summary: How many blocks down the map, rounded to a whole number.
    kind: Float
    minimum: 1
    maximum: 1024
    group: Pixelate
