version: 1
name: Mask Editor
nodes:
  - id: 1
    type: Source/Mesh Map
    x: -960
    y: -220
    values: {}
    texts: { Map: curvature }
  - id: 11
    type: Filters/Blur HQ
    x: -960
    y: -380
    values: {}
    texts:
      '=Sigma': smoothing
  - id: 12
    type: Colour/Histogram Equalise
    x: -640
    y: -380
    values: {}
    texts: {}
  - id: 2
    type: Colour/Levels
    x: -640
    y: -220
    values: {}
    texts:
      '=Input Black': 1f - edges * 0.4f - 0.03f
      '=Input White': 1f - edges * 0.4f + 0.03f
  - id: 13
    type: Colour/Levels
    x: -640
    y: -80
    values:
      Input Black: [0.502]
      Input White: [0.506]
    texts: {}
  - id: 14
    type: Colour/Blend
    x: -480
    y: -220
    values: {}
    texts: { Mode: Multiply }
  - id: 3
    type: Source/Mesh Map
    x: -960
    y: 40
    values: {}
    texts: { Map: ao }
  - id: 4
    type: Colour/Levels
    x: -640
    y: 40
    values:
      Input White: [0.25]
    texts:
      '=Input Black': 0.95f - cavities * 0.5f
  - id: 5
    type: Source/Noise
    x: -960
    y: 300
    values:
      Octaves: [4]
    texts:
      Basis: Gradient
      '=Scale': scale
      '=Seed': seed
  - id: 6
    type: Colour/Levels
    x: -640
    y: 300
    values:
      Input White: [1]
    texts:
      '=Input Black': 0.5f - grunge * 0.5f
  - id: 7
    type: Colour/Blend
    x: -320
    y: -100
    values: {}
    texts: { Mode: Lighten }
  - id: 8
    type: Colour/Blend
    x: 0
    y: 0
    values: {}
    texts: { Mode: Multiply }
  - id: 9
    type: Colour/Levels
    x: 320
    y: 0
    values: {}
    texts:
      '=Input Black': contrast * 0.4f
      '=Input White': 1f - contrast * 0.4f
  - id: 10
    type: Sub-graph/Output
    x: 640
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 1, fromPort: Out, toNode: 11, toPort: Input }
  - { fromNode: 11, fromPort: Out, toNode: 12, toPort: Input }
  - { fromNode: 12, fromPort: Out, toNode: 2, toPort: Input }
  - { fromNode: 11, fromPort: Out, toNode: 13, toPort: Input }
  - { fromNode: 2, fromPort: Out, toNode: 14, toPort: Background }
  - { fromNode: 13, fromPort: Out, toNode: 14, toPort: Foreground }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Input }
  - { fromNode: 5, fromPort: Out, toNode: 6, toPort: Input }
  - { fromNode: 14, fromPort: Out, toNode: 7, toPort: Background }
  - { fromNode: 4, fromPort: Out, toNode: 7, toPort: Foreground }
  - { fromNode: 7, fromPort: Out, toNode: 8, toPort: Background }
  - { fromNode: 6, fromPort: Out, toNode: 8, toPort: Foreground }
  - { fromNode: 8, fromPort: Out, toNode: 9, toPort: Input }
  - { fromNode: 9, fromPort: Out, toNode: 10, toPort: Out }
groups: []
comments: []
interface:
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: The mask.
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1', doesNotTile: 'Reads a mesh map, and an atlas has islands at its edges rather than a far side.' }
parameters:
  - name: edges
    label: Edges
    default: '0.35'
    summary: How much of the model's convex edges the mask takes, sharpest first. It ranks the curvature, so it reads the same on any mesh.
    kind: Float
    minimum: 0
    maximum: 1
    group: Edges
  - name: cavities
    label: Cavities
    default: '0.5'
    summary: How far out of the cavities the dirt creeps.
    kind: Float
    minimum: 0
    maximum: 1
    group: Cavities
  - name: grunge
    label: Grunge
    default: '0.3'
    summary: How much of the mask the noise breaks away.
    kind: Float
    minimum: 0
    maximum: 1
    group: Grunge
  - name: scale
    label: Grunge Scale
    default: '12'
    summary: How many patches of grunge run across the map.
    kind: Float
    minimum: 1
    maximum: 64
    group: Grunge
  - name: seed
    label: Seed
    default: '0'
    summary: Another draw of the grunge. Every whole number is a different pattern.
    kind: Int
    minimum: 0
    maximum: 100
    group: Grunge
  - name: smoothing
    label: Smoothing
    default: '1.5'
    summary: How far the curvature is blurred first, in texels. More keeps only broad edges.
    kind: Float
    minimum: 0
    maximum: 16
    group: Edges
  - name: contrast
    label: Contrast
    default: '0'
    summary: How hard the mask's own edge is, applied after everything else.
    kind: Float
    minimum: 0
    maximum: 1
    group: Global
