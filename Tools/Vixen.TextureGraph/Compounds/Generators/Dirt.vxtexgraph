version: 1
name: Dirt
nodes:
  - id: 1
    type: Source/Mesh Map
    x: -1280
    y: -220
    values: {}
    texts: { Map: curvature }
  - id: 7
    type: Filters/Blur HQ
    x: -960
    y: -220
    values: {}
    texts:
      '=Sigma': smoothing
  - id: 8
    type: Colour/Histogram Equalise
    x: -640
    y: -220
    values: {}
    texts: {}
  - id: 2
    type: Colour/Levels
    x: -320
    y: -220
    values: {}
    texts:
      '=Input Black': amount * 0.4f + 0.03f
      '=Input White': amount * 0.4f - 0.03f
      '=Output White': cavities
  - id: 9
    type: Colour/Levels
    x: -320
    y: -60
    values:
      Input Black: [0.498]
      Input White: [0.494]
    texts: {}
  - id: 10
    type: Colour/Blend
    x: 0
    y: -220
    values: {}
    texts: { Mode: Multiply }
  - id: 3
    type: Source/Mesh Map
    x: -960
    y: 120
    values: {}
    texts: { Map: ao }
  - id: 4
    type: Colour/Levels
    x: -640
    y: 120
    values:
      Input Black: [0.95]
    texts:
      '=Input White': 0.85f - amount * 0.5f
      '=Output White': occlusion
  - id: 5
    type: Colour/Blend
    x: 320
    y: 0
    values: {}
    texts: { Mode: Lighten }
  - id: 11
    type: Source/Noise
    x: -960
    y: 340
    values:
      Octaves: [4]
    texts:
      Basis: Gradient
      '=Scale': scale
      '=Seed': seed
  - id: 12
    type: Colour/Levels
    x: -640
    y: 340
    values: {}
    texts:
      '=Input Black': 0.7f - breakup * 0.5f
      '=Input White': 0.85f - breakup * 0.5f
  - id: 13
    type: Source/Uniform
    x: -640
    y: 500
    values:
      Colour: [0, 0, 0, 1]
    texts: {}
  - id: 14
    type: Colour/Mix
    x: 640
    y: 0
    values: {}
    texts: { Mode: Copy, Coverage: Over }
  - id: 6
    type: Sub-graph/Output
    x: 960
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 1, fromPort: Out, toNode: 7, toPort: Input }
  - { fromNode: 7, fromPort: Out, toNode: 8, toPort: Input }
  - { fromNode: 8, fromPort: Out, toNode: 2, toPort: Input }
  - { fromNode: 7, fromPort: Out, toNode: 9, toPort: Input }
  - { fromNode: 2, fromPort: Out, toNode: 10, toPort: Background }
  - { fromNode: 9, fromPort: Out, toNode: 10, toPort: Foreground }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Input }
  - { fromNode: 10, fromPort: Out, toNode: 5, toPort: Background }
  - { fromNode: 4, fromPort: Out, toNode: 5, toPort: Foreground }
  - { fromNode: 11, fromPort: Out, toNode: 12, toPort: Input }
  - { fromNode: 5, fromPort: Out, toNode: 14, toPort: Background }
  - { fromNode: 13, fromPort: Out, toNode: 14, toPort: Foreground }
  - { fromNode: 12, fromPort: Out, toNode: 14, toPort: Mask }
  - { fromNode: 14, fromPort: Out, toNode: 6, toPort: Out }
groups: []
comments: []
interface:
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: The dirt mask. White where grime has gathered, in creases and in the places light does not reach.
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1', doesNotTile: 'Reads a mesh map, and an atlas has islands at its edges rather than a far side.' }
parameters:
  - name: amount
    label: Amount
    default: '0.4'
    summary: How far the dirt creeps out of the creases and the shadowed places.
    kind: Float
    minimum: 0
    maximum: 1
    group: Dirt
  - name: cavities
    label: Creases
    default: '1'
    summary: How strongly a concave crease gathers dirt. It ranks the curvature, so it reads the same on any mesh.
    kind: Float
    minimum: 0
    maximum: 1
    group: Dirt
  - name: occlusion
    label: Occlusion
    default: '0.8'
    summary: How strongly a place the light does not reach gathers dirt.
    kind: Float
    minimum: 0
    maximum: 1
    group: Dirt
  - name: smoothing
    label: Smoothing
    default: '1.5'
    summary: How far the curvature is blurred first, in texels. More keeps only broad creases.
    kind: Float
    minimum: 0
    maximum: 16
    group: Dirt
  - name: breakup
    label: Breakup
    default: '0.3'
    summary: How patchy the dirt is.
    kind: Float
    minimum: 0
    maximum: 1
    group: Breakup
  - name: scale
    label: Breakup Scale
    default: '10'
    summary: How many patches of breakup run across the map.
    kind: Float
    minimum: 1
    maximum: 64
    group: Breakup
  - name: seed
    label: Seed
    default: '0'
    summary: Another draw of the breakup. Every whole number is a different pattern.
    kind: Int
    minimum: 0
    maximum: 100
    group: Breakup
