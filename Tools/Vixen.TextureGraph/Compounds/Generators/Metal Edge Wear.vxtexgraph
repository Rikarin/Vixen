version: 1
name: Metal Edge Wear
nodes:
  - id: 1
    type: Source/Mesh Map
    x: -1600
    y: -220
    values: {}
    texts: { Map: curvature }
  - id: 11
    type: Filters/Blur HQ
    x: -1280
    y: -220
    values: {}
    texts:
      '=Sigma': smoothing
  - id: 12
    type: Colour/Histogram Equalise
    x: -960
    y: -220
    values: {}
    texts: {}
  - id: 2
    type: Colour/Levels
    x: -640
    y: -220
    values: {}
    texts:
      '=Input Black': 1f - amount * 0.4f - 0.03f
      '=Input White': 1f - amount * 0.4f + 0.03f
  - id: 13
    type: Colour/Levels
    x: -640
    y: -60
    values:
      Input Black: [0.502]
      Input White: [0.506]
    texts: {}
  - id: 14
    type: Colour/Blend
    x: -320
    y: -220
    values: {}
    texts: { Mode: Multiply }
  - id: 3
    type: Source/Noise
    x: -1280
    y: 100
    values:
      Octaves: [3]
    texts:
      Basis: Gradient
      '=Scale': scale
      '=Seed': seed
  - id: 4
    type: Colour/Levels
    x: -960
    y: 100
    values: {}
    texts:
      '=Input Black': 0.7f - breakup * 0.5f
      '=Input White': 0.82f - breakup * 0.5f
  - id: 5
    type: Source/Uniform
    x: -960
    y: 300
    values:
      Colour: [0, 0, 0, 1]
    texts: {}
  - id: 6
    type: Colour/Mix
    x: 0
    y: 0
    values: {}
    texts: { Mode: Copy, Coverage: Over }
  - id: 7
    type: Source/Mesh Map
    x: -1280
    y: 480
    values: {}
    texts: { Map: ao }
  - id: 8
    type: Colour/Levels
    x: -960
    y: 480
    values:
      Input Black: [0]
    texts:
      '=Input White': 0.15f + shelter * 0.85f
  - id: 9
    type: Colour/Blend
    x: 320
    y: 0
    values: {}
    texts: { Mode: Multiply }
  - id: 10
    type: Sub-graph/Output
    x: 640
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 1, fromPort: Out, toNode: 11, toPort: Input }
  - { fromNode: 11, fromPort: Out, toNode: 12, toPort: Input }
  - { fromNode: 12, fromPort: Out, toNode: 2, toPort: Input }
  - { fromNode: 11, fromPort: Out, toNode: 13, toPort: Input }
  - { fromNode: 2, fromPort: Out, toNode: 14, toPort: Background }
  - { fromNode: 13, fromPort: Out, toNode: 14, toPort: Foreground }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Input }
  - { fromNode: 14, fromPort: Out, toNode: 6, toPort: Background }
  - { fromNode: 5, fromPort: Out, toNode: 6, toPort: Foreground }
  - { fromNode: 4, fromPort: Out, toNode: 6, toPort: Mask }
  - { fromNode: 7, fromPort: Out, toNode: 8, toPort: Input }
  - { fromNode: 6, fromPort: Out, toNode: 9, toPort: Background }
  - { fromNode: 8, fromPort: Out, toNode: 9, toPort: Foreground }
  - { fromNode: 9, fromPort: Out, toNode: 10, toPort: Out }
groups: []
comments: []
interface:
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: Where the paint has been rubbed off a convex edge and the metal shows through.
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1', doesNotTile: 'Reads a mesh map, and an atlas has islands at its edges rather than a far side.' }
parameters:
  - name: amount
    label: Amount
    default: '0.35'
    summary: How much of the model's convex edges wear through, sharpest first. It ranks the curvature, so it reads the same on any mesh.
    kind: Float
    minimum: 0
    maximum: 1
    group: Wear
  - name: smoothing
    label: Smoothing
    default: '1.5'
    summary: How far the curvature is blurred first, in texels. More keeps only broad edges and drops fine detail.
    kind: Float
    minimum: 0
    maximum: 16
    group: Wear
  - name: breakup
    label: Breakup
    default: '0.45'
    summary: How much of the edge the wear skips, so it does not read as a drawn outline.
    kind: Float
    minimum: 0
    maximum: 1
    group: Breakup
  - name: scale
    label: Breakup Scale
    default: '22'
    summary: How many patches of breakup run across the map.
    kind: Float
    minimum: 1
    maximum: 64
    group: Breakup
  - name: seed
    label: Seed
    default: '0'
    summary: Another draw of the breakup. Every whole number is a different pattern.
    kind: Int
    minimum: 0
    maximum: 100
    group: Breakup
  - name: shelter
    label: Shelter
    default: '0.35'
    summary: How much a sheltered edge is spared — nothing rubs the inside of a crease.
    kind: Float
    minimum: 0
    maximum: 1
    group: Wear
