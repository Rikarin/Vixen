package Vixen.TextureGraph.Shaders

import Vixen.Shaders.Core

// The structure tensor of a picture — the first step of Patina #119's anisotropic painterly smooth.
//
// A Sobel gradient per colour channel, and the three products that say how the colour changes about
// a texel: `E = Σ gx²`, `F = Σ gx·gy`, `G = Σ gy²`, summed over red, green and blue, in red, green and
// blue. The node blurs it before anything reads it, and the blurred tensor's eigenvectors are the
// direction along which the picture changes least — the way a brush would run — and across it.
//
// ⚠ **Stored at half float, never at eight bits.** A gradient's square is small inside a soft region,
// and at eight bits most of the picture would read as a tensor of nought, which is no direction at
// all. The node asks for an `Rgba16Float` scratch whatever the graph's depth.
//
// No length: the Sobel is one texel either way at every bake, and the direction and the anisotropy
// read from it are ratios, so a 4× bake reads the same strokes. The read wraps or clamps as the plan
// says.

shader StructureTensor {
    var source: Texture2D

    var wrapX: int = 0

    var wrapY: int = 0

    [Format("rgba16f")] var target: RWTexture2D<float4>

    func Tap(x: int, y: int): float3 {
        val size = source.GetDimensions(0)
        val texel = source.Load(int3(Math.Address(x, size.x, wrapX), Math.Address(y, size.y, wrapY), 0))

        return float3(texel.x, texel.y, texel.z)
    }

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        val x = coord.x
        val y = coord.y
        val a = Tap(x - 1, y - 1)
        val b = Tap(x, y - 1)
        val c = Tap(x + 1, y - 1)
        val d = Tap(x - 1, y)
        val f = Tap(x + 1, y)
        val g = Tap(x - 1, y + 1)
        val h = Tap(x, y + 1)
        val i = Tap(x + 1, y + 1)

        val gx = (c + f * 2f + i - a - d * 2f - g) * 0.25f
        val gy = (g + h * 2f + i - a - b * 2f - c) * 0.25f

        target.Store(coord, float4(dot(gx, gx), dot(gx, gy), dot(gy, gy), 1f))
    }
}
