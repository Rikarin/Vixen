package Vixen.TextureGraph.Shaders

// One sweep of the propagation doc 48 § 4.5's `Flood Fill` is, and § 4.5 is right that it is the
// highest-risk kernel in the catalogue.
//
// ## What a texel carries, and why the label *is* the bounding box
//
// `(minX, minY, maxX, maxY)` of the island as this texel has seen it so far, in texels. A background
// texel carries `-1` in every channel and is skipped by every merge.
//
// The obvious arrangement is a label chain that settles first and a bounds chain that follows it.
// This is one chain, because **the union of two adjacent in-texels' bounds is the merge either
// chain would have done**: adjacency *is* connectivity, so a merge needs no label to compare. The
// bounds are monotone, so the iteration has a fixed point and reaching it early is stable, and the
// settled minimum corner is a canonical name for the island that every one of its texels agrees on.
//
// ⚠ **So the island's identity is its bounding box, and two islands with the same bounding box are
// one island to every consumer of this node.** That is a real collision and it is not hypothetical —
// an L-shape and a small square tucked into its corner can share a box. It is the price of settling
// bounds and labels in one chain rather than two, it is what `TextureFloodOutput` documents, and the
// alternative costs twice the dispatches for a case a splatter never produces.
//
// ## ⚠ A sweep crosses a whole run, and why that is not a jump flood
//
// This kernel used to move bounds one texel per dispatch, so an island wider than the budget never
// settled, and it looked plausible doing it: Rikarin/Patina#98. A jump flood is the obvious cure and
// **it is wrong here**: a jump crosses background, and a texel that reads a neighbour across a gap
// merges two islands that do not touch.
//
// What can go far without crossing anything is a walk along one line of the image, stopping at the
// first background texel. So one invocation owns one row (or column, or diagonal), reads along it,
// and gives every texel of each run the union of that run. A run is connected by construction, so
// nothing is merged that does not touch, and an island of any width takes the same one dispatch.
// Sweeping rows and columns in turn, an island settles in about as many dispatches as a walk across
// it has corners: a rectangle in two, whatever its size, which is what stops the budget depending on
// the resolution.
//
// `diagonal` is therefore not a flag on the merge any more: an eight-connected flood is one whose
// chain also sweeps the two diagonals, which is `axis` 2 and 3. A four-connected one never asks for
// them, and that is the whole of the difference.
//
// **Each line is written by the one invocation that owns it**, so no two invocations touch a texel,
// and only the invocations on the edge the lines start from do any work. That is why the group size
// stays the evaluator's: every invocation still runs, and all but one per line return at once.
//
// ## ⚠ The number of sweeps is a property of the *shape*, and it is reported rather than guessed
//
// A while on the device is not an option — the fixed point is a property of the whole image and a
// workgroup can only wait for itself — so `TextureAnalysis.FloodFill` emits a **fixed budget** and
// the node appends `FloodResidual` and a `MinMaxReduce` chain after it. A host reads one texel and
// learns whether the budget was enough. **That is the difference between a truncated flood fill and a
// wrong picture nobody can account for**, and it is the whole reason this node is four kernels.
//
// ## 32 bits, always
//
// ⚠ A coordinate is stored, not an offset, so the record has to be exact on the integers across the
// image. A half stops at 2048 and quantises past it, which merges islands two texels apart, so the
// node keeps this record in `rgba32f` at every size and every bit depth, whatever the picture is in.

shader FloodBounds {
    /// The mask on the first dispatch, the previous sweep's bounds on every one after it.
    var source: Texture2D

    /// Non-zero when `source` is the mask rather than a record.
    var first: int = 1

    /// What counts as inside the mask, read off the red channel.
    var threshold: float = 0.5f

    /// Which lines this sweep walks: 0 rows · 1 columns · 2 and 3 the two diagonals.
    var axis: int = 0

    [Format("rgba16f")] var target: RWTexture2D<float4>

    /// A texel that is in no island.
    const val Background: float = -1f

    /// One texel's record, or its seeding. ⚠ The caller stays inside the image: a clamped tap would
    /// join two islands that are separated by exactly the image edge.
    func Record(x: int, y: int): float4 {
        val texel = source.Load(int3(x, y, 0))

        if (first == 0) {
            return texel
        }

        if (texel.x >= threshold) {
            return float4(float(x), float(y), float(x), float(y))
        }

        return float4(Background, Background, Background, Background)
    }

    /// Whether a line of this sweep begins at a texel.
    func Begins(x: int, y: int, width: int): bool {
        if (axis == 0) {
            return x == 0
        }

        if (axis == 1) {
            return y == 0
        }

        if (axis == 2) {
            return x == 0 || y == 0
        }

        return x == width - 1 || y == 0
    }

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val size = target.GetDimensions()
        val width = int(size.x)
        val height = int(size.y)
        val startX = int(id.x)
        val startY = int(id.y)

        if (startX >= width || startY >= height || !Begins(startX, startY, width)) {
            return
        }

        var stepX = 1
        var stepY = 1

        if (axis == 0) {
            stepY = 0
        }

        if (axis == 1) {
            stepX = 0
        }

        if (axis == 3) {
            stepX = -1
        }

        var x = startX
        var y = startY

        while (x >= 0 && y >= 0 && x < width && y < height) {
            val here = Record(x, y)
            var nextX = x + stepX
            var nextY = y + stepY

            if (here.x < 0f) {
                target.Store(int2(x, y), float4(Background, Background, Background, Background))
            }

            if (here.x >= 0f) {
                var low = float2(here.x, here.y)
                var high = float2(here.z, here.w)
                var length = 1

                while (nextX >= 0 && nextY >= 0 && nextX < width && nextY < height) {
                    val tap = Record(nextX, nextY)

                    if (tap.x < 0f) {
                        break
                    }

                    low = min(low, float2(tap.x, tap.y))
                    high = max(high, float2(tap.z, tap.w))
                    length = length + 1
                    nextX = nextX + stepX
                    nextY = nextY + stepY
                }

                for (at in 0 .. length - 1) {
                    target.Store(int2(x + at * stepX, y + at * stepY), float4(low.x, low.y, high.x, high.y))
                }
            }

            x = nextX
            y = nextY
        }
    }
}
