package Vixen.TextureGraph.Shaders

// Patina #172's histogram equalisation: every texel replaced by the share of the image at or below it,
// so the answer's values are spread evenly over 0..1 whatever the source's were.
//
// **The distribution function is `HistogramTable`'s, linear inside a bin**: the share below the bin the
// value falls in, plus that bin's share times how far into it the value is. So an image whose values
// are already spread evenly inside every bin comes back as itself, and that is what
// `TextureHistogramDeviceTests` holds first. ⚠ A bin whose texels are bunched at one end of it is the one
// place this differs from a true rank: the line through the bin is a straight line, and the error is at
// most that bin's share.
//
// Red is read, for `MinMaxReduce`'s reason, and the answer is grey. Pointwise in the source once the
// table exists, so an equalised image tiles exactly when its source does.

shader HistogramEqualise {
    var source: Texture2D

    var table: Texture2D

    [Format("rgba16f")] var target: RWTexture2D<float4>

    const val Bins: int = 256

    const val Slots: int = 64

    /// One lane of a texel, by number.
    func Lane(texel: float4, lane: int): float {
        if (lane == 1) {
            return texel.y
        }

        if (lane == 2) {
            return texel.z
        }

        if (lane == 3) {
            return texel.w
        }

        return texel.x
    }

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        val extent = source.GetDimensions(0)
        val value = source.Load(int3(clamp(coord.x, 0, extent.x - 1), clamp(coord.y, 0, extent.y - 1), 0)).x
        val at = saturate(value) * float(Bins)
        val bin = clamp(int(floor(at)), 0, Bins - 1)
        val share = Lane(table.Load(int3(0, bin / 4, 0)), bin % 4)
        val top = Lane(table.Load(int3(0, Slots + bin / 4, 0)), bin % 4)
        val equalised = saturate(top - share + share * saturate(at - float(bin)))

        target.Store(coord, float4(equalised, equalised, equalised, 1f))
    }
}
