package Vixen.TextureGraph.Shaders

// Doc 48 § 4.1's eight shapes: disc · square · triangle · paraboloid · gaussian · cone · half-bell ·
// gradation, under a scale, a rotation and a falloff. The splatter's usual pattern input.
//
// Patina #168 added seven more: a regular polygon with `sides`, a star with `sides` points whose
// valleys sit at `inner` of the radius, a ring whose hole is `inner` of the radius, a capsule whose
// half thickness is `inner`, a crescent cut by a second disc shifted `2 · inner` radii to the right,
// a square pyramid and a hemisphere. The first five are boundaries softened over `falloff`; the last
// two are profiles and carry their softness in their formula, as the gaussian does.
//
// ⚠ **Every boundary kind measures how deep a point is inside it, in units of the radius**, and
// `falloff` is a fraction of that depth — so a ring and a capsule soften over the same width a disc
// does. The star is the exception that has to be: a star's inside is not a distance from anything
// simple, so it is measured along the ray from the centre — `|p|` over the boundary's radius in that
// direction — which is still one on the boundary and nought at the centre.
//
// **Analytic rather than rasterised**, which is what § 4.1's table asks for and what makes this the
// cheapest kernel in the catalogue to prove scale-invariant: the value of a texel is a closed-form
// function of its *normalised* position, so the same authored shape is the same picture at 1K and at
// 4K without the evaluator scaling anything. Nothing here is in texels, so nothing here is a
// `TexelsAtBase` parameter.
//
// ⚠ **A hard-edged analytic shape still cannot pass doc 48's exit criterion 3 as written.** Bake a
// falloff-zero disc at 1K and at 4K, downsample the second, and the two disagree by up to a full step
// all the way round the boundary — the 4K one is anti-aliased by the downsample and the 1K one is
// not. That is not a resolution bug in the kernel; it is what "exact at every resolution" means for a
// function with a discontinuity in it. The comparison is meaningful for a shape whose falloff spans
// more than a texel at the *lower* resolution, and `TextureSourceDeviceTests` asserts it there.
//
// **The coordinate frame.** `uv` is the texel centre in 0..1, y increasing *downwards*, which is the
// engine's UV convention. The triangle and the gradation are the two kinds that can tell, and both
// flip y into a y-up frame first so that a triangle at rotation zero points up on screen.

shader Shape {
    /// 0 disc · 1 square · 2 triangle · 3 paraboloid · 4 gaussian · 5 cone · 6 half-bell · 7 gradation ·
    /// 8 polygon · 9 star · 10 ring · 11 capsule · 12 crescent · 13 pyramid · 14 hemisphere.
    ///
    /// ⚠ **A uniform and not a `[Permutation]`, for the reason `Shaders/README.md` gives about the
    /// blend mode** — and with more force here, because a permutation cannot be selected at all
    /// through the evaluator M1 built: `TexturePlanEvaluator.VariantFor` caches on
    /// `(kernel, output format)` and compiles `EffectKey.Of(kernel)` with no defines, so every
    /// permutation in a texture-graph kernel would silently take its `.rvn` default.
    var kind: int = 0

    /// The shape's diameter as a fraction of the image. 1 inscribes it; 0.5 quarters its area.
    var scale: float = 1f

    /// Clockwise on screen, in radians.
    var rotation: float = 0f

    /// The width of the soft edge, in units of the shape's radius.
    ///
    /// ⚠ **It applies to the three *boundary* kinds — disc, square, triangle — and to nothing else.**
    /// The other five are profiles that are continuous everywhere and carry their own falloff in
    /// their formula; there is no meaning of "edge width" for a gaussian that is not just a second
    /// spelling of `scale`. A test asserts the paraboloid ignores it, so the exception is written
    /// down rather than discovered.
    var falloff: float = 0.01f

    /// How many sides a polygon has, or how many points a star. Three to sixty-four.
    var sides: int = 6

    /// A star's valleys, a ring's hole, a capsule's half thickness or a crescent's cut, as a fraction of
    /// the radius.
    var inner: float = 0.5f

    var centreX: float = 0.5f

    var centreY: float = 0.5f

    /// Non-zero when a shape past the left or right edge comes back on the other side. The plan's, as
    /// `seed` is: see `Math.Address`.
    var wrapX: int = 0

    /// The same for the top and bottom edges.
    var wrapY: int = 0

    /// Non-zero to draw in a square of the shorter side and repeat it along the longer one, so a disc on
    /// a 2:1 image is round (Patina #96). Nought stretches the unit square over the image, which is the
    /// default because a non-square texture is usually mapped onto a face of the same shape.
    ///
    /// ⚠ **The square is repeated a whole number of times**, the nearest to the ratio of the sides, so the
    /// image still tiles: at 2:1 or 4:1 it is exactly square, and at a ratio between whole numbers the
    /// cell is as near square as a whole count allows.
    var keepAspect: int = 0

    [Format("rgba16f")] var target: RWTexture2D<float4>

    /// Half the width of an equilateral triangle's incircle when its circumradius is one.
    ///
    /// The three edge planes of that triangle satisfy `dot(p, n) = 0.5` on the boundary, so twice the
    /// largest of the three dots is a normalised distance that is 1 on every edge *and* at every
    /// vertex.
    const val TriangleEdge: float = 0.5f

    /// cos 30°, which is where the two lower edge normals point.
    const val Cos30: float = 0.8660254f

    /// −ln(1/1000). The gaussian is worth exactly one part in a thousand at the boundary, which is
    /// what pins its width to `scale` rather than leaving it a taste.
    const val GaussianDecay: float = 6.907755f

    const val Pi: float = 3.14159265f

    const val TwoPi: float = 6.2831853f

    /// The fewest sides a polygon or star may have, and the most.
    const val FewestSides: int = 3

    const val MostSides: int = 64

    /// The offset from the centre to the nearest copy of it along an axis that wraps.
    func Nearest(offset: float, wrap: int): float {
        if (wrap == 0) {
            return offset
        }

        return offset - round(offset)
    }

    /// How far out the shape's own boundary the point is: 0 at the centre, 1 on the boundary.
    func Reach(p: float2, shape: int): float {
        if (shape == 1 || shape == 13) {
            return max(abs(p.x), abs(p.y))
        }

        if (shape == 2) {
            val q = float2(p.x, -p.y)
            val bottom = -q.y
            val right = q.x * Cos30 + q.y * TriangleEdge
            val left = -q.x * Cos30 + q.y * TriangleEdge

            return max(bottom, max(right, left)) / TriangleEdge
        }

        return length(p)
    }

    /// How many sides, inside the kernel's range.
    func Sides(): int => clamp(sides, FewestSides, MostSides)

    /// A regular polygon's reach: the largest projection on an edge normal over the apothem, so one on
    /// every edge. One vertex points up at rotation zero, as the triangle's does, so three sides is the
    /// triangle.
    ///
    /// The nearest edge normal is the one nearest in angle, so it is found in one step rather than by
    /// a loop over every edge.
    func PolygonReach(p: float2): float {
        val q = float2(p.x, -p.y)
        val count = float(Sides())
        val step = TwoPi / count
        val first = Pi * 0.5f + Pi / count
        val turn = round((atan2(q.y, q.x) - first) / step)
        val angle = first + turn * step

        return (q.x * cos(angle) + q.y * sin(angle)) / cos(Pi / count)
    }

    /// A star's reach along the ray through `p`: `|p|` over the radius of the edge that ray meets. One
    /// tip points up at rotation zero.
    ///
    /// The ray's angle is folded into the half sector between a tip and the valley beside it, where the
    /// edge runs from the tip `(1, 0)` to the valley at `inner` and half a sector round; the radius it
    /// meets is where the ray crosses that line.
    func StarReach(p: float2): float {
        val q = float2(p.x, -p.y)
        val radius = length(q)
        val half = Pi / float(Sides())
        val fromTip = atan2(q.y, q.x) - Pi * 0.5f
        val folded = abs(fromTip - 2f * half * round(fromTip / (2f * half)))
        val tip = float2(1f, 0f)
        val valley = float2(cos(half), sin(half)) * clamp(inner, 0.0001f, 1f)
        val edge = valley - tip
        val ray = float2(cos(folded), sin(folded))
        val boundary = (edge.x * tip.y - edge.y * tip.x) / (edge.x * ray.y - edge.y * ray.x)

        return radius / max(boundary, 0.00001f)
    }

    /// How deep `p` is inside one of the five boundary kinds Patina #168 added, in radii: positive
    /// inside, nought on the boundary.
    func Depth(p: float2, shape: int): float {
        if (shape == 8) {
            return 1f - PolygonReach(p)
        }

        if (shape == 9) {
            return 1f - StarReach(p)
        }

        val q = float2(p.x, -p.y)
        val hole = clamp(inner, 0f, 1f)

        if (shape == 10) {
            // Half the band's width less the distance from its middle circle.
            return (1f - hole) * 0.5f - abs(length(q) - (1f + hole) * 0.5f)
        }

        if (shape == 11) {
            // A segment along x whose ends are the capsule's tips less its half thickness.
            val reach = max(1f - hole, 0f)
            val nearest = float2(clamp(q.x, -reach, reach), 0f)

            return hole - length(q - nearest)
        }

        // The crescent: inside the disc and outside the one shifted right by `2 · inner`.
        val cut = float2(2f * hole, 0f)

        return min(1f - length(q), length(q - cut) - 1f)
    }

    /// The reach turned into a value.
    func Profile(reach: float, axis: float, shape: int): float {
        if (shape == 3) {
            return saturate(1f - reach * reach)
        }

        if (shape == 4) {
            return exp(-reach * reach * GaussianDecay)
        }

        if (shape == 5) {
            return saturate(1f - reach)
        }

        if (shape == 6) {
            val t = saturate(reach)

            return 1f - t * t * (3f - 2f * t)
        }

        if (shape == 7) {
            return saturate(axis * 0.5f + 0.5f)
        }

        if (shape == 13) {
            return saturate(1f - reach)
        }

        if (shape == 14) {
            return sqrt(saturate(1f - reach * reach))
        }

        // Disc, square and triangle: a hard boundary softened over `falloff` of the radius. The max
        // is what keeps a falloff of zero a step rather than a division by zero written into a file.
        return saturate((1f - reach) / max(falloff, 0.00001f))
    }

    /// The position in the cell the shape is drawn in: the whole image, or with `keepAspect` one of the
    /// near-square cells the longer side is cut into.
    func Cell(uv: float2, width: float, height: float): float2 {
        if (keepAspect == 0 || width == height) {
            return uv
        }

        if (width > height) {
            return float2(frac(uv.x * max(round(width / height), 1f)), uv.y)
        }

        return float2(uv.x, frac(uv.y * max(round(height / width), 1f)))
    }

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        val uv = Cell(
            float2((float(coord.x) + 0.5f) / float(size.x), (float(coord.y) + 0.5f) / float(size.y)),
            float(size.x),
            float(size.y)
        )
        val centred = float2(Nearest(uv.x - centreX, wrapX), Nearest(uv.y - centreY, wrapY))
        val c = cos(rotation)
        val s = sin(rotation)
        val turned = float2(centred.x * c + centred.y * s, -centred.x * s + centred.y * c)
        val p = turned * (2f / max(scale, 0.00001f))
        var value = Profile(Reach(p, kind), p.x, kind)

        if (kind >= 8 && kind <= 12) {
            value = saturate(Depth(p, kind) / max(falloff, 0.00001f))
        }

        target.Store(coord, float4(value, value, value, 1f))
    }
}
