package Vixen.TextureGraph.Shaders

import Vixen.Shaders.Core

// The ground below a panorama's horizon replaced by a colour — Patina #180's horizon tools.
//
// Each row of an equirectangular picture is one elevation, from straight up at the top to straight down at the
// bottom. Below `height` radians of elevation the source gives way to the ground colour, over a band `width`
// radians wide centred on the horizon, smoothly; exactly at the horizon it is half and half. `amount` scales the
// whole replacement, so nought leaves the source untouched.

shader PanoramaHorizon {
    var source: Texture2D

    /// The horizon's elevation, in radians: below nought lowers it.
    var height: float = 0f

    /// How wide the band the ground fades in over is, in radians.
    var width: float = 0.05f

    /// How much of the ground replaces the source.
    var amount: float = 1f

    var red: float = 0.1f

    var green: float = 0.09f

    var blue: float = 0.08f

    [Format("rgba16f")] var target: RWTexture2D<float4>

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        val extent = source.GetDimensions(0)
        val here = source.Load(int3(min(coord.x, extent.x - 1), min(coord.y, extent.y - 1), 0))
        val rise = Const.Pi * 0.5f - (float(coord.y) + 0.5f) / float(size.y) * Const.Pi
        val half = max(width, 0.000001f) * 0.5f
        val below = 1f - smoothstep(height - half, height + half, rise)
        val share = below * clamp(amount, 0f, 1f)
        val colour = lerp(float3(here.x, here.y, here.z), float3(red, green, blue), float3(share, share, share))

        target.Store(coord, float4(colour.x, colour.y, colour.z, here.w))
    }
}
