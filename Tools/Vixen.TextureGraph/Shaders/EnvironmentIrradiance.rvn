package Vixen.TextureGraph.Shaders

import Vixen.Shaders.Core

// The diffuse light an environment casts, in every direction — the middle of Patina #119's lighting
// baked from an environment.
//
// `environment` is an equirectangular picture of the surroundings, already shrunk by a box
// `Resample` to a few dozen texels a side; `target` is equirectangular too, and each of its texels is
// the cosine-weighted light arriving at a surface that faces its direction: the sum over every
// environment texel of its colour, the cosine to it, and its solid angle, over π. A uniform white
// environment comes out white everywhere, which is the normalisation a renderer's irradiance has.
//
// ⚠ **A whole sum, not a sample.** Irradiance is so smooth that a 32×32 map of it holds everything it
// has, and a sum over a shrunk environment costs a thousand taps per texel of a map that small; a
// point read of a full-sized picture per texel of the bake would alias a bright sun into speckle.
//
// u runs once round the horizon and v from straight up to straight down, as
// `Math.DirectionToEquirectangular` reads them, so a direction and a texel agree with the read
// `EnvironmentLight` makes.

shader EnvironmentIrradiance {
    /// The environment, equirectangular and small.
    var environment: Texture2D

    [Format("rgba16f")] var target: RWTexture2D<float4>

    /// The most environment texels summed along each axis; a larger environment is read in strides.
    const val MaxSide: int = 64

    /// The unit direction an equirectangular position looks along.
    func Direction(u: float, v: float): float3 {
        val phi = (u - 0.5f) * Const.TwoPi
        val theta = v * Const.Pi
        val ring = sin(theta)

        return float3(ring * cos(phi), cos(theta), ring * sin(phi))
    }

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        val facing = Direction((float(coord.x) + 0.5f) / float(size.x), (float(coord.y) + 0.5f) / float(size.y))
        val extent = environment.GetDimensions(0)
        val columns = min(extent.x, MaxSide)
        val rows = min(extent.y, MaxSide)
        var sum = float3(0f, 0f, 0f)

        for (j in 0 .. MaxSide - 1) {
            if (j >= rows) {
                break
            }

            val v = (float(j) + 0.5f) / float(rows)
            val y = min(int(v * float(extent.y)), extent.y - 1)
            val ring = sin(v * Const.Pi)

            for (i in 0 .. MaxSide - 1) {
                if (i >= columns) {
                    break
                }

                val u = (float(i) + 0.5f) / float(columns)
                val x = min(int(u * float(extent.x)), extent.x - 1)
                val cosine = max(dot(facing, Direction(u, v)), 0f)
                val light = environment.Load(int3(x, y, 0))

                sum = sum + float3(light.x, light.y, light.z) * (cosine * ring)
            }
        }

        // dω = (2π / columns)(π / rows) sin θ, and the irradiance is divided by π.
        val scale = Const.TwoPi / float(columns * rows)

        target.Store(coord, float4(sum.x * scale, sum.y * scale, sum.z * scale, 1f))
    }
}
