package Vixen.TextureGraph.Shaders

// Each colour channel held inside a range — Patina #171.
//
// Alpha is left alone, as every other colour node leaves it: a clamp that made a transparent image
// opaque would be a blend's bug two ops later. A range given upside down is taken as written, so
// `high` wins where the two cross: the floor is applied first and the ceiling over it.

shader Clamp {
    var source: Texture2D

    /// The lowest a channel may be.
    var low: float = 0f

    /// The highest a channel may be.
    var high: float = 1f

    [Format("rgba16f")] var target: RWTexture2D<float4>

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        val extent = source.GetDimensions(0)
        val texel = source.Load(int3(clamp(coord.x, 0, extent.x - 1), clamp(coord.y, 0, extent.y - 1), 0))
        val held = min(max(texel.xyz, float3(low, low, low)), float3(high, high, high))

        target.Store(coord, float4(held.x, held.y, held.z, texel.w))
    }
}
