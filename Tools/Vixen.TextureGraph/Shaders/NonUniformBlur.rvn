package Vixen.TextureGraph.Shaders

import Vixen.Shaders.Core

// Doc 48 § 4.4's `Non-Uniform Blur`: a box whose **radius is read from a map**, per texel.
//
// ## ⚠ Not separable, and that is why it is a kernel rather than a parameter on `Blur`
//
// A separable blur is two passes over one radius. Here the radius belongs to the *output* texel, so
// an x pass would have to choose a radius before the y pass knew which texel it was serving — the
// two passes would blur different neighbourhoods and the answer would be neither. **If a future
// reader finds themselves splitting this into two dispatches, they have changed what the node
// means**, and the picture that follows is a plausible one: a blur that is slightly wrong in the
// direction the radius varies, which reads as an artefact of the radius map.
//
// The test that says so is the impulse: with a constant radius of one texel, a lit texel spreads
// over the full 3×3 including the four **diagonal** neighbours, each worth 1/9. A single separable
// pass leaves the diagonals black.
//
// ## The cost, and a budget in taps rather than a ceiling on the radius
//
// `Blur` reaches far because 129 taps per axis is cheap. This one is `(2n+1)²` taps for n per side,
// so n is held to `MaxTaps` — 12, which is 625 taps. ⚠ **It used to hold the *radius* to 12 instead**,
// which `TextureFilters.Verify` reported at bake time: a radius of 12 authored at 1K was 48 at a 4×
// bake and refused, so the widest blur a map could ask for was a dozen texels at the bake resolution
// (Patina #173). Past the budget the same width is now covered by the same number of taps spaced
// further apart — `Blur`'s rule since #678 — so the box thins rather than narrowing, the width is
// always the width the plan resolved, and nothing is refused.
//
// ## What the map is read as
//
// ⚠ **The red channel, and never a luminance.** A mask in this graph is an `R8` image and `Load`
// hands back `(r, 0, 0, 1)` for one — so a luminance would be a third of the mask everywhere, which
// is a blur a third as wide and a picture nobody would call broken. Every map-reading kernel in
// § 4.4 reads red for that reason.
//
// ⚠ **`maxRadius` arrives in the texels of the image being written** — doc 48 § D8's scaling is
// `TexturePlan.Resolve`'s and has already happened.

shader NonUniformBlur {
    var source: Texture2D

    /// The radius map. Its **red** channel, 0..1, scales `maxRadius`.
    var radiusMap: Texture2D

    /// What a fully lit texel of the map is worth, in texels of the image being written.
    var maxRadius: float = 4f

    /// Non-zero when a read past the left or right edge comes back on the other side. The plan's, as
    /// `seed` is: see `Math.Address`.
    var wrapX: int = 0

    /// The same for the top and bottom edges.
    var wrapY: int = 0

    [Format("rgba16f")] var target: RWTexture2D<float4>

    /// The most taps this kernel takes on each side of a texel, whatever the radius says. See the
    /// header: the cost is the square of it, and past it the taps spread out.
    const val MaxTaps: int = 12

    func Tap(x: int, y: int): float4 {
        val size = source.GetDimensions(0)

        return source.Load(int3(Math.Address(x, size.x, wrapX), Math.Address(y, size.y, wrapY), 0))
    }

    func Radius(coord: int2): float {
        val size = target.GetDimensions()
        val extent = radiusMap.GetDimensions(0)
        val x = int(floor((float(coord.x) + 0.5f) * float(extent.x) / float(size.x)))
        val y = int(floor((float(coord.y) + 0.5f) * float(extent.y) / float(size.y)))

        return radiusMap.Load(int3(Math.Address(x, extent.x, wrapX), Math.Address(y, extent.y, wrapY), 0)).x
    }

    /// A tap's weight by its index from the centre: one inside, the fraction at the rim, nought past it.
    func Weight(index: int, whole: int, partial: float): float {
        val d = abs(index)

        if (d <= whole) {
            return 1f
        }

        if (d == whole + 1) {
            return partial
        }

        return 0f
    }

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        val wide = saturate(Radius(coord)) * max(maxRadius, 0f)

        if (wide < 0.05f) {
            target.Store(coord, Tap(coord.x, coord.y))

            return
        }

        // Under the budget the spacing is exactly one and this is the box it always was, texel for
        // texel; past it the taps are `spacing` apart and the outermost pair still lands on the radius.
        val spacing = max(1f, wide / float(MaxTaps))
        val reach = wide / spacing
        val whole = min(int(floor(reach)), MaxTaps)
        val partial = reach - float(whole)
        val extent = whole + 1

        var sum = float4(0f, 0f, 0f, 0f)
        var weight = 0f

        for (jy in 0 .. 2 * MaxTaps + 2) {
            val iy = jy - MaxTaps - 1

            if (iy < -extent || iy > extent) {
                continue
            }

            val wy = Weight(iy, whole, partial)

            if (wy <= 0f) {
                continue
            }

            for (jx in 0 .. 2 * MaxTaps + 2) {
                val ix = jx - MaxTaps - 1

                if (ix < -extent || ix > extent) {
                    continue
                }

                val w = wy * Weight(ix, whole, partial)

                if (w <= 0f) {
                    continue
                }

                val ox = int(round(float(ix) * spacing))
                val oy = int(round(float(iy) * spacing))

                sum = sum + w * Tap(coord.x + ox, coord.y + oy)
                weight = weight + w
            }
        }

        target.Store(coord, sum / max(weight, 0.0001f))
    }
}
