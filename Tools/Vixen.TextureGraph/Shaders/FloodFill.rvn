package Vixen.TextureGraph.Shaders

import Vixen.Shaders.Core

// The reading half of doc 48 § 4.5's `Flood Fill`: the settled `FloodBounds` record turned into one
// of the five pictures the node offers.
//
// § 4.5 lists them as one node's outputs — id · random value · UV within the island · bounding box ·
// size — and notes that "everything Substance calls *flood fill to X* is this node plus a
// `Channel Shuffle`". So they are one kernel under a `kind`, and a plan that wants two of them lists
// two ops over the same settled record. That costs one dispatch each and no second flood.
//
// ⚠ **`Size` is the bounding box's, not the island's area, and the difference is not pedantic.** A
// pixel count is a *sum* over the island and nothing in this chain sums anything — bounds merge by
// min and max, which is what lets one monotone iteration settle them. An area would need a second
// quantity with no idempotent merge, and the reference tool's own "flood fill to size" is the box
// too.
//
// ⚠ **`Random` is seeded from the box, so an island keeps its colour when a *different* island
// changes** — which is the property that makes the node usable in a splatter at all. Seeding from a
// running index would renumber every island whenever one appeared, and the material would shimmer
// under an edit that touched none of it.
//
// ⚠ **`BoundingBox` can pass one.** On a graph that tiles, an island over the seam has a box that starts
// at its near end and runs past the image, so that the far corner minus the near one is still its size
// and the two can still be told apart. Round the whole axis, a box is `0` to the last texel.
//
// **`Colour` and `Gradient` are the two pictures an artist asks for by name** — Patina #174's
// "random island colour" and "flood fill to gradient". `Colour` is three names of the same island
// under three salts, so it is `Random` with two more lanes and changes exactly when `Random` does.
// `Gradient` is a ramp across the island's box along `angle`, turned per island by up to
// `angleVariation` either way, and runs from 0 at the corner the direction leaves to 1 at the corner it
// reaches, measured in texels so a long box is not a steeper ramp than a square one.
//
// **Background is black in every mode, with an opaque alpha.** Zero is a legitimate value for a
// random and for a UV, so a consumer that has to tell background from a dark island reads the alpha
// of `BoundingBox`, whose channels are all zero only for a box at the origin of zero size.

shader FloodFill {
    /// The settled record from the last `FloodBounds` dispatch.
    var bounds: Texture2D

    /// 0 id · 1 random · 2 UV within the island · 3 bounding box · 4 size · 5 colour · 6 gradient.
    var kind: int = 1

    /// `Gradient`'s direction in radians: 0 rises along +x, π/2 along +y (down the image).
    var angle: float = 0f

    /// How far each island's direction may turn from `angle`, in radians, half either way.
    var angleVariation: float = 0f

    /// The op's own seed, already mixed. See `TexturePlan.SeedFor`.
    var seed: float = 0f

    [Format("rgba16f")] var target: RWTexture2D<float4>

    /// The **whole** record hashed to one value in 0..1: the island's complete name.
    ///
    /// ⚠ **All four channels and not the corner**, which is the distinction
    /// [#691](https://github.com/Rikarin/Vixen/issues/691) turned out to be about. Two settled boxes
    /// are never equal for two different islands — a shared box would need each island to cross the
    /// box both ways, and the 4/8 duality of digital topology forbids the pair — so a name derived
    /// from all four numbers separates every island from every other. A name derived from `min`
    /// alone does not: a bar and a hook that starts under its left end share a minimum corner
    /// routinely, and `TextureAnalysisKernelTests` counts 1 273 such masks in the 65 536 there are at
    /// four by four.
    func Name(record: float4, salt: uint): float {
        val corner = Random.Combine(uint(int(record.x)), uint(int(record.y)))
        val far = Random.Combine(uint(int(record.z)), uint(int(record.w)))

        return Random.ToFloat01(Random.Combine(Random.Combine(corner, far), salt))
    }

    /// How far a texel is past the start of its island's box along one axis.
    func Past(texel: int, low: float, extent: int): float {
        if (float(texel) < low) {
            return float(texel + extent) - low
        }

        return float(texel) - low
    }

    [ComputeShader(8, 8, 1)]
    func Main([Semantic("SV_DispatchThreadID")] id: uint3) {
        val coord = int2(int(id.x), int(id.y))
        val size = target.GetDimensions()

        if (coord.x >= size.x || coord.y >= size.y) {
            return
        }

        val extent = bounds.GetDimensions(0)
        val record = bounds.Load(int3(clamp(coord.x, 0, extent.x - 1), clamp(coord.y, 0, extent.y - 1), 0))

        if (record.x < 0f) {
            target.Store(coord, float4(0f, 0f, 0f, 1f))

            return
        }

        val span = float2(record.z - record.x + 1f, record.w - record.y + 1f)
        val width = float(max(extent.x, 1))
        val height = float(max(extent.y, 1))

        if (kind == 0) {
            // The island's name. Red and green are the minimum corner of its box, normalised —
            // addressable, and stable under an edit elsewhere in the image.
            //
            // ⚠ **Blue is the rest of the record, and without it the id is not a name.** The corner
            // alone is shared by islands that are genuinely distinct — one bar and one hook starting
            // under its left end is enough — so "flood fill to index" quietly gave two islands the
            // same index. [#691](https://github.com/Rikarin/Vixen/issues/691) filed that as the
            // *box* colliding; the box does not, and this half does.
            target.Store(coord, float4(record.x / width, record.y / height, Name(record, 0u), 1f))

            return
        }

        if (kind == 2) {
            // ⚠ A box over the seam starts on one side of it and goes past the image, so a texel left
            // of its start is on the next lap: `FloodBounds.rvn`.
            val local = float2(Past(coord.x, record.x, extent.x) / span.x, Past(coord.y, record.y, extent.y) / span.y)

            target.Store(coord, float4(local.x, local.y, 0f, 1f))

            return
        }

        if (kind == 3) {
            target.Store(
                coord,
                float4(record.x / width, record.y / height, record.z / width, record.w / height)
            )

            return
        }

        if (kind == 4) {
            target.Store(coord, float4(span.x / width, span.y / height, max(span.x / width, span.y / height), 1f))

            return
        }

        val salt = uint(int(max(seed, 0f)))

        if (kind == 5) {
            target.Store(
                coord,
                float4(Name(record, salt), Name(record, Random.Combine(salt, 1u)), Name(record, Random.Combine(salt, 2u)), 1f)
            )

            return
        }

        if (kind == 6) {
            val turned = angle + (Name(record, Random.Combine(salt, 3u)) - 0.5f) * max(angleVariation, 0f)
            val toward = float2(cos(turned), sin(turned))

            // The texel's centre in the box, in texels, and the projections of the box's corners: the
            // lowest is where the ramp is 0 and the highest where it is 1.
            val at = float2(Past(coord.x, record.x, extent.x) + 0.5f, Past(coord.y, record.y, extent.y) + 0.5f)
            val low = min(0f, span.x * toward.x) + min(0f, span.y * toward.y)
            val high = max(0f, span.x * toward.x) + max(0f, span.y * toward.y)
            val ramp = saturate((dot(at, toward) - low) / max(high - low, 0.000001f))

            target.Store(coord, float4(ramp, ramp, ramp, 1f))

            return
        }

        val value = Name(record, salt)

        target.Store(coord, float4(value, value, value, 1f))
    }
}
