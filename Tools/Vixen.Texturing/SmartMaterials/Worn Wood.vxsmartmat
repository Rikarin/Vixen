version: 1
name: Worn Wood
baseWidth: 1024
baseHeight: 1024
sets:
  - name: Material
    channels:
      - usage: baseColor
        default: [0.5, 0.5, 0.5, 1]
      - usage: roughness
        default: [0.5, 0.5, 0.5, 1]
      - usage: metalness
        default: [0, 0, 0, 1]
    layers:
      - id: timber
        name: Timber
        kind: Fill
        values:
          baseColor: [0.29, 0.17, 0.09, 1]
          roughness: [0.68, 0.68, 0.68, 1]
          metalness: [0, 0, 0, 1]
      - id: grain
        name: Grain
        kind: Fill
        blend: Copy
        opacity: 0.75
        values:
          baseColor: [0.45, 0.29, 0.16, 1]
          roughness: [0.6, 0.6, 0.6, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Grunges/Grunge Fibres
      - id: polish
        name: Handled Edges
        kind: Fill
        blend: Copy
        opacity: 0.8
        values:
          baseColor: [0.53, 0.38, 0.23, 1]
          roughness: [0.31, 0.31, 0.31, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Curvature Edge Wear
      - id: grime
        name: Ingrained Dirt
        kind: Fill
        blend: Multiply
        opacity: 0.6
        values:
          baseColor: [0.38, 0.33, 0.28, 1]
          roughness: [1.2, 1.2, 1.2, 1]
          metalness: [1, 1, 1, 1]
        mask:
          source: Generator
          generator: Generators/Dirt
