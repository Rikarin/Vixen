<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.ShaderCompiler\Vixen.ShaderCompiler.csproj" />

        <!--
          A device, for the exit-criterion test: resolving a variant ends in EffectLoader, which
          creates descriptor set layouts. The Null backend creates nothing and records what it was
          asked for, which is all a "did anything have to compile" assertion needs.
        -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Null\Vixen.Graphics.Null.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />

        <!--
          The shaders fixture, borrowed rather than copied. Its .rvn and its .reflect.json are a
          matched pair — the reflection is Raven's own output, regenerated by a command in that
          project's README — and the translation under test here is exactly "does this produce what
          that reflection describes". A second copy would drift from the oracle the day somebody
          regenerated one of them.
        -->
        <None Include="..\..\Core\Vixen.Shaders.Tests\Fixtures\Lighting.rvn"
              Link="Fixtures\Lighting.rvn"
              CopyToOutputDirectory="PreserveNewest" />

        <None Include="..\..\Core\Vixen.Shaders.Tests\Fixtures\Lighting.reflect.json"
              Link="Fixtures\Lighting.reflect.json"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <!--
        #1119's ratchet. The TEST profile in `Directory.Build.props` turns documentation generation
        off for every `*.Tests` project, so no `<see cref>` in any test assembly was ever checked —
        and a test's remarks are read at the worst possible moment, when the test has just gone red.
        CS1591 and CS1573 stay suppressed: "this public member has no comment" is a question about a
        packaged API surface, and a test assembly is not one.

        This project reported nothing when the whole tree was measured with the flag forced on, so
        here it is a latch rather than a repair — which is the point. An overload landing beside a
        cref written earlier is not historical rot; #821's own measurement watched it happen inside
        one working session.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
