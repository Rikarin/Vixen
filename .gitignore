# Build output
[Bb]in/
[Oo]bj/
artifacts/
*.user
*.suo

# Vixen project-local caches (never committed — reproducible from source + .meta).
# The negation is load-bearing: Raven/Library/ is the shipped .rvn standard library
# (docs/plan/02 § Raven), not a cache, and a bare `Library/` swallowed it. Example1.rvn
# and Example2.rvn were tracked only because they predate this rule — anything added
# beside them was invisible to git.
Library/
!Raven/Library/
Build/

# ANTLR: the IDE plugin's scratch dir, and the .tokens/.interp vocabularies.
# The build regenerates these into obj/ from the .g4 files; a committed copy only
# ever goes stale against the grammar.
.antlr/
*.tokens
*.interp

# IDE
.vs/
.vscode/
.idea/
*.DotSettings.user

# OS
.DS_Store
Thumbs.db

# Test / coverage
TestResults/
*.trx
# Written beside a golden file when it does not match, for eyeballing the diff.
*.actual
coverage*.json
coverage*.xml
BenchmarkDotNet.Artifacts/

# Native deps restored by `nuke RestoreNativeDeps`
/native/

# Reference clones (see docs/plan/02 § references/) — submodules or local clones
/references/
