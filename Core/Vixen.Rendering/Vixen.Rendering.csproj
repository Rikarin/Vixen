<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Rendering</RootNamespace>
        <Description>
            The render system: scene data extracted once per frame into flat arrays, culled per
            view, sorted per stage, and recorded in parallel. Stride's RenderObject/RenderNode
            model with per-feature data held in structure-of-arrays native memory.
        </Description>
        <PackageTags>rendering;render-graph;culling;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Core.Collections\Vixen.Core.Collections.csproj" />
        <ProjectReference Include="..\Vixen.Core.Mathematics\Vixen.Core.Mathematics.csproj" />
        <ProjectReference Include="..\Vixen.Core.Memory\Vixen.Core.Memory.csproj" />
        <ProjectReference Include="..\Vixen.Core.Reflection\Vixen.Core.Reflection.csproj" />
        <ProjectReference Include="..\Vixen.Core.Serialization\Vixen.Core.Serialization.csproj" />
        <ProjectReference Include="..\Vixen.Core.Threading\Vixen.Core.Threading.csproj" />
        <ProjectReference Include="..\Vixen.Graphics\Vixen.Graphics.csproj" />

        <!--
          The compositor declares render-graph passes rather than opening render passes itself, so
          barriers, transient memory and pass culling are the graph's rather than every node's. See
          Compositor/RenderPassRenderer.
        -->
        <ProjectReference Include="..\Vixen.Graphics.RenderGraph\Vixen.Graphics.RenderGraph.csproj" />
        <ProjectReference Include="..\Vixen.Shaders\Vixen.Shaders.csproj" />

        <!--
            The distance-field bake and clipmap (docs/plan/19 § L1). One-way and it stays that way:
            that project references no device at all, which is what lets the whole of it be checked
            against closed forms. This is the side that owns the GPU mirror of it.
        -->
        <ProjectReference Include="..\Vixen.Rendering.DistanceFields\Vixen.Rendering.DistanceFields.csproj" />
        <ProjectReference Include="..\Vixen.Rendering.IrradianceFields\Vixen.Rendering.IrradianceFields.csproj" />

        <!--
            Rendering depends on Vfx and not the other way round, which is the direction doc 06
            names: ParticleRenderFeature sits beside MeshRenderFeature here, and Vixen.Vfx
            simulates without referencing a single graphics type.
        -->
        <ProjectReference Include="..\Vixen.Vfx\Vixen.Vfx.csproj" />

        <!--
            Ecs and Engine, so this assembly can declare the components a scene places a light and a
            mesh with — the arrangement Vixen.Physics, Vixen.Audio and Vixen.Animation already use,
            each owning its own components and the system that bridges them.

            ⚠ The arrow points *this* way and only this way. Vixen.Engine references no graphics API,
            which is what lets Vixen.Physics and Vixen.Audio produce debug geometry without linking
            one, and is why Vixen.Engine.Renderer exists for the debug-draw join in particular — that
            join needs both directions and this one does not. Vixen.Animation already references both
            of these and Vixen.Rendering, so nothing here is new ground.
        -->
        <ProjectReference Include="..\Vixen.Ecs\Vixen.Ecs.csproj" />
        <ProjectReference Include="..\Vixen.Engine\Vixen.Engine.csproj" />

        <!--
          The compositor asset's model types are [DataContract]s of this assembly's own, so it runs
          the descriptor generator over itself — the same arrangement Vixen.Core.Yaml uses for the
          .meta model, and for the same reason: analyzers do not flow through a ProjectReference.

          Note what is *not* here: Vixen.Core.Yaml, and therefore YamlDotNet. The model is a plain
          serialisable record graph; which file format it is read from belongs to whoever reads it,
          so a shipping runtime that loads a baked compositor never links a YAML parser.
        -->
        <ProjectReference Include="..\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
          And the binary serializer over the same types, which is what makes a compositor *content*:
          the editor writes YAML, the content build bakes a chunk, and the runtime reads the chunk
          through AssetManager with no parser linked in at all.
        -->
        <ProjectReference Include="..\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
          And the shader binding generator, over the reflection checked in beside the library
          shaders. What it buys is that a compositor node names BloomKeys.SourceBinding rather than
          writing down a number it cannot see: a binding index is assigned by Raven from declaration
          order within a set, so adding a texture above another in the .rvn renumbers it — and a host
          holding the old number gets a validation error at best and the wrong texture at worst.

          The reflection is checked in rather than compiled here. The alternative is this project
          depending on the compiler being built first, in a repository where the compiler is the
          larger of the two; Vixen.Raven.Tests regenerates and compares them instead, so they cannot
          drift from the shaders without a test saying so.
        -->
        <ProjectReference Include="..\Vixen.Shaders.Generators\Vixen.Shaders.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!-- Declares this assembly's [Component] [DataContract] types to SceneComponentRegistry. -->
        <ProjectReference Include="..\Vixen.Engine.Generators\Vixen.Engine.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!--
      Named rather than globbed, and that is not tidiness: the generator emits a `…Keys` type per
      file, so two projects globbing the same directory emit the same type twice and the second one
      to be referenced wins with a warning. Each project takes the reflection for the shaders its own
      nodes bind — these, and Vixen.Rendering.PostFx takes the effect set.
    -->
    <ItemGroup>
        <AdditionalFiles Include="..\..\Raven\Library\Pipeline\*.reflect.json" />
        <AdditionalFiles Include="..\..\Raven\Library\PostFx\Bloom.reflect.json" />
        <AdditionalFiles Include="..\..\Raven\Library\PostFx\Tonemap.reflect.json" />
        <AdditionalFiles Include="..\..\Raven\Library\IrradianceFields\IrradianceFill.reflect.json" />
        <AdditionalFiles Include="..\..\Raven\Library\IrradianceFields\IrradianceRepair.reflect.json" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Rendering.Tests" />
    </ItemGroup>

</Project>
