<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="CsCheck" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Layout\Vixen.Ui.Layout.csproj" />
    </ItemGroup>

    <!--
        Taffy's conformance corpus, committed rather than translated into C#. It is data the tests
        read at runtime, so it has to reach the output directory; see Taffy/README.md for why it is
        XML and not 375 000 lines of generated C#.
    -->
    <ItemGroup>
        <Content Include="Taffy\Corpus\*.xml" CopyToOutputDirectory="PreserveNewest" LinkBase="Taffy\Corpus" />
        <Content Include="Taffy\KnownGaps.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Taffy" />
        <Content Include="Taffy\BlockKnownGaps.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Taffy" />
        <Content Include="Taffy\GridKnownGaps.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Taffy" />
    </ItemGroup>

    <!-- Measured, the guarded allocation measurement. See Testing/Vixen.Testing.props. -->
    <Import Project="..\..\Testing\Vixen.Testing.props" />

</Project>
