<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Animation</RootNamespace>
        <Description>
            Skeletal animation: clip sampling, blend trees, layers and masks, a state machine, IK,
            root motion and animation events — evaluated into a pose, and turned into the bone
            palette GPU skinning reads.
        </Description>
        <PackageTags>animation;skeletal;skinning;blend-tree;state-machine;ik;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Core.Mathematics\Vixen.Core.Mathematics.csproj" />
        <ProjectReference Include="..\Vixen.Core.Threading\Vixen.Core.Threading.csproj" />
        <ProjectReference Include="..\Vixen.Ecs\Vixen.Ecs.csproj" />

        <!--
          For LocalTransform: root motion is a delta this assembly computes and the entity's own
          transform is where it has to land. Nothing else of the engine layer is used.
        -->
        <ProjectReference Include="..\Vixen.Engine\Vixen.Engine.csproj" />

        <!--
          For SkeletonData / AnimationClipData — the import-domain records a content build writes,
          which a runtime skeleton and clip are baked from — and for SkinningRenderFeature, which is
          where a finished pose goes. Doc 06 put the palette there deliberately: the renderer owns
          the buffer and the push constant, and animation owns what goes in it.
        -->
        <ProjectReference Include="..\Vixen.Rendering\Vixen.Rendering.csproj" />

        <!--
          AnimationClipContent is an artefact: the asset pipeline writes it and a player reads it
          back, so both halves need the generated serializer for it. Same arrangement Vixen.Rendering
          uses for MaterialContent, and for the same reason — the type is a runtime assembly's,
          because a build deserialises it with no importer and no parser linked in at all.
        -->
        <ProjectReference Include="..\Vixen.Core.Serialization\Vixen.Core.Serialization.csproj" />

        <ProjectReference Include="..\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
          And the descriptor over the same types. The serializer writes the bytes; this is what makes
          the *alias* resolvable, which is what an artefact's type string is looked up through at
          load. Without it the string resolves to nothing and the pipeline falls back to an editor
          type — a build that succeeds and a game that throws about content it just made.
        -->
        <ProjectReference Include="..\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Animation.Tests" />
    </ItemGroup>

</Project>
