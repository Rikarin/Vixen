<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Core</RootNamespace>
        <Description>
            The engine's root assembly: serialisation and editor annotations, the service
            registry, identity types, frame time, pooling and disposal. Depends on nothing
            but the BCL — every other Vixen assembly depends on this one.
        </Description>
        <PackageTags>engine;game-engine;annotations;pooling;service-registry;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!--
          [HotPath] is public and lives here, so a consumer with a PackageReference can mark their
          own hot methods — and until this line existed they got the attribute and none of the rule
          that gives it meaning, which is the defect 78a3f9f87 set out to remove, left half-done at
          the package boundary. Safe to ship by GeneratorPackagingExempt.txt's own test: VXHP0001
          reports nothing in a compilation that marks nothing, so it neither duplicates a type nor
          warns a consumer who never asked for it.
        -->
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);PackHotPathAnalyzer
        </TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <!--
      GetTargetPath, not Build — a no-build `dotnet pack` sets NoBuild=true as a global property,
      and a project handed NoBuild=true and then asked for Build is NETSDK1085. Vixen.Core.Reflection
      carries the same target for the same reason.
    -->
    <Target Name="PackHotPathAnalyzer">
        <MSBuild Projects="..\Vixen.Core.Analyzers\Vixen.Core.Analyzers.csproj"
                 Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="TargetFramework">
            <Output TaskParameter="TargetOutputs" ItemName="HotPathAnalyzerAssembly" />
        </MSBuild>

        <ItemGroup>
            <TfmSpecificPackageFile Include="@(HotPathAnalyzerAssembly)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Core.Tests" />
    </ItemGroup>

</Project>
