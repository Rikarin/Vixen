<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Core.Mathematics</RootNamespace>
        <Description>
            The engine's own vector, matrix, quaternion, colour and bounding-volume types.
            Right-handed, Y-up, row-vector with row-major storage, reverse-Z — the
            conventions are stated once in Conventions.md and pinned by tests.
        </Description>
        <PackageTags>mathematics;vector;matrix;quaternion;simd;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Core.Mathematics.Tests" />
    </ItemGroup>

</Project>
