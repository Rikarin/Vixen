<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Explicit, not transitive: analyzer and generator assets do not flow through a project
          reference, and these tests exist partly to prove that [LoggerMessage]-generated call sites
          reach our sink correctly.
        -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core.Diagnostics\Vixen.Core.Diagnostics.csproj" />
    </ItemGroup>

    <!--
      Measured, the guarded allocation measurement. See Testing/Vixen.Testing.props. This project is
      where Measured's own failure message is tested: it already owns "what a thing costs the
      allocator" as a subject (AllocationTests), and Testing/ has no test project of its own.
    -->
    <Import Project="..\..\Testing\Vixen.Testing.props" />

</Project>
