<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Explicit, not transitive: analyzer and generator assets do not flow through a project
          reference, and these tests exist partly to prove that [LoggerMessage]-generated call sites
          reach our sink correctly.
        -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core.Diagnostics\Vixen.Core.Diagnostics.csproj" />
    </ItemGroup>

    <!--
      Measured, the guarded allocation measurement. See Testing/Vixen.Testing.props. This project is
      where Measured's own failure message is tested: it already owns "what a thing costs the
      allocator" as a subject (AllocationTests), and Testing/ has no test project of its own.
    -->
    <Import Project="..\..\Testing\Vixen.Testing.props" />

    <!--
        #1119's ratchet. The TEST profile in `Directory.Build.props` turns documentation generation
        off for every `*.Tests` project, so no `<see cref>` in any test assembly was ever checked —
        and a test's remarks are read at the worst possible moment, when the test has just gone red.
        CS1591 and CS1573 stay suppressed: "this public member has no comment" is a question about a
        packaged API surface, and a test assembly is not one.

        Measured before flipping, as that issue asks — this project's only doc diagnostics came from
        `Testing/Measured.cs`, which is linked in rather than owned, and both were fixed with it.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
