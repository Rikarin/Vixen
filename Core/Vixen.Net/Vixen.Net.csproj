<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Net</RootNamespace>
        <Description>
            Networking for Vixen: the transport contract every transport implements, the channel
            vocabulary the layers above speak, and the simulation decorator that makes a perfect
            in-process wire behave like a bad one. Optional — a single-player game that never
            references it pays nothing.
        </Description>
        <PackageTags>networking;multiplayer;transport;replication;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!--
            Replication is the reason: it queries the world's per-chunk change versions directly,
            which is the structural payoff doc 16 names for having built an ECS with them. Nothing
            below Vixen.Engine may reference this package in return — the layer rules in doc 00 run
            one way.
        -->
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Ecs\Vixen.Ecs.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Net.Tests" />
    </ItemGroup>

</Project>
