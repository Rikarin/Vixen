<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Ui.Controls</RootNamespace>
        <Description>
            The standard control set — buttons, fields, lists, overlays and the rest — built on the
            element tree, the property system and the event router, and styled by a user-agent
            stylesheet a game is expected to override rather than fork.
        </Description>
        <PackageTags>ui;controls;widgets;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui\Vixen.Ui.csproj" />

        <!--
            Analyzers are not transitive through a ProjectReference, so every assembly that declares
            [UiProperty] names the generator itself. This one declares a great many.
        -->
        <ProjectReference Include="..\Vixen.Ui.Generators\Vixen.Ui.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Ui.Controls.Tests" />
    </ItemGroup>

    <!--
        ⚠ **Imported for the `**/*.vcss` glob, which is what makes `ControlTheme.vcss` an
        EmbeddedResource.** `ControlTheme.Css` reads it back by its logical name, so without this line
        the property throws at the first `Install` rather than failing to compile — the error message
        it throws names this import for that reason.

        At the bottom of the file, because the glob has to run after DefaultItemExcludes is final.
        There is no `.vxml` in this project, so the other half of the .targets is inert here.
    -->
    <Import Project="..\Vixen.Ui\build\Vixen.Ui.targets" />

</Project>
