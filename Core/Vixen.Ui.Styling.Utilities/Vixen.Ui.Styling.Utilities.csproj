<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Ui.Styling.Utilities</RootNamespace>
        <Description>
            The utility stylesheet generator: design tokens from a config asset, a scanner that finds
            which utilities a project actually uses, and a VCSS stylesheet emitted into
            @layer utilities containing only those.
        </Description>
        <PackageTags>css;utility;tailwind;design-tokens;ui;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />

        <!--
            The build step's MSBuild half, which is what makes a PackageReference to this assembly
            enough on its own: no scanner call, no manifest walk, no bootstrap of any kind in the
            consuming project. `build/<PackageId>.targets` is the name NuGet imports automatically.
        -->
        <None Include="build/Vixen.Ui.Styling.Utilities.targets" Pack="true" PackagePath="build/" />

        <!--
            ⚠ **The tool is packed by path rather than by ProjectReference, and it has to be.**
            `Tools/Vixen.StyleGen` is where the step lives, and doc 00's layer rules forbid a Core
            assembly from referencing anything in Tools — a rule `CheckArchitecture` enforces by
            reading this file. Referencing it for packing alone would be a layer violation for a
            dependency that does not exist at run time or at compile time, so the file is named
            instead and the condition keeps a pack that happens before the tool was built from
            failing rather than from shipping something wrong.

            ⚠ The consequence, stated plainly because it is a real gap: `dotnet pack` on this project
            alone produces a package whose `tools/` is empty and whose `.targets` then falls through
            to its third answer and finds nothing. Packing has to follow a solution build. That is
            the same bargain `Vixen.Sdk` makes with the CLI it ships.
        -->
        <None Include="$(MSBuildThisFileDirectory)../../Tools/Vixen.StyleGen/bin/$(Configuration)/net10.0/Vixen.StyleGen.dll"
              Condition="Exists('$(MSBuildThisFileDirectory)../../Tools/Vixen.StyleGen/bin/$(Configuration)/net10.0/Vixen.StyleGen.dll')"
              Pack="true"
              PackagePath="tools/"
              Visible="false" />

        <None Include="$(MSBuildThisFileDirectory)../../Tools/Vixen.StyleGen/bin/$(Configuration)/net10.0/Vixen.StyleGen.runtimeconfig.json"
              Condition="Exists('$(MSBuildThisFileDirectory)../../Tools/Vixen.StyleGen/bin/$(Configuration)/net10.0/Vixen.StyleGen.runtimeconfig.json')"
              Pack="true"
              PackagePath="tools/"
              Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!--
            ⚠ **The engine's default design tokens, embedded rather than globbed.** Every other
            project in the tree gets its .vcss files embedded by the glob in
            `Core/Vixen.Ui/build/Vixen.Ui.targets`, and this one cannot import that file: it sits
            *below* Vixen.Ui and referencing its build assets would invert the dependency for the
            sake of one line. Named here instead, with the same logical name the glob would have
            given it — RootNamespace plus the folder — which is what `ThemeTokens.DefaultSheet`
            asks for.
        -->
        <EmbeddedResource Include="Theme/vixen.default.vcss" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Ui.Styling\Vixen.Ui.Styling.csproj" />

        <!--
            ⚠ **Vixen.Core.Yaml is gone, and the consequence is bigger than a reference.** It was here
            for `ThemeTokens.Parse`, which read a `vixen.ui.yaml`; under `@theme` a token is a custom
            property in a stylesheet and the reader is a text scan over this assembly's own code. The
            YamlDotNet dependency it dragged in is the *entire* stated reason `Tools/Vixen.StyleGen`
            is an out-of-process step rather than an `IIncrementalGenerator` — an analyzer's
            dependencies do not travel with it — so that argument has quietly expired. Turning the
            step into a generator is a separate change and a real one; this file is the note that it
            is now possible.
        -->
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Ui.Styling.Utilities.Tests" />
    </ItemGroup>

</Project>
