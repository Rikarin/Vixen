<!--
    SPDX-FileCopyrightText: Copyright (c) Rikarin
    SPDX-License-Identifier: Apache-2.0

    The build step. A project with a `vixen.ui.vcss` in it gets its utility stylesheet compiled at
    build time, with no code of its own — no scanner call, no manifest walk, no reflection.

    ⚠ **It used to be `vixen.ui.yaml`, and that file is deleted rather than renamed.** Under
    Tailwind v4 a design token *is* a custom property in an `@theme { … }` block, so the token file
    is a stylesheet like every other one and the YAML in front of it was a second format to learn
    for no expressive gain. The editor's copy proved the point: it declared no colours of its own,
    every entry being a reference to a custom property `EditorTheme` already had, so it was `@theme`
    with a translation step. See docs/plan/43 § D1.

    ⚠ **A project with no theme file still has tokens.** `ThemeTokens.CreateDefault()` is v4's own
    palette and scales in oklch, so `bg-blue-500` works in a project that wrote nothing, and a
    project that wants none of it clears the colour namespace in an `@theme` of its own.

    Imported automatically by a PackageReference to Vixen.Ui.Styling.Utilities; inside this
    repository a project has to Import it by hand and name Tools/Vixen.StyleGen as a build-order
    ProjectReference, for the same reason it already has to name the VXML generator: MSBuild assets
    and analyzers do not travel through a ProjectReference.
-->
<Project>

    <!--
        ==========================================================================================
        A .targets and not a .props, and the reason is the glob two blocks down: it is imported
        after the consuming project's body, which is when DefaultItemExcludes finally holds the
        project's own additions to it and when @(Compile) holds the project's own sources. Globbed
        in a .props, a .vxml copied into bin/ by a previous build would be scanned a second time —
        harmless here, unlike for the markup compiler, but the same rule keeps the two files
        answering to one convention.
        ==========================================================================================
    -->
    <PropertyGroup>
        <!--
            ⚠ **The flag the repository's `Directory.Build.targets` reads**, for the reason
            `Vixen.Ui.targets` states beside its own: in-repo that file stands in for the
            `PackageReference` and is imported last, so a project that already names this one — or
            reaches it through `Vixen.Editor.Ui.Styling.targets` — says so here and is left alone.
            Importing the same file twice would redefine both targets and re-declare `VixenUiTokens`.
        -->
        <VixenUtilityStylesImported>true</VixenUtilityStylesImported>

        <VixenUtilityStyles Condition="'$(VixenUtilityStyles)' == ''">true</VixenUtilityStyles>
        <VixenUtilityStylesNamespace Condition="'$(VixenUtilityStylesNamespace)' == ''">$(RootNamespace)</VixenUtilityStylesNamespace>
        <VixenUtilityStylesClass Condition="'$(VixenUtilityStylesClass)' == ''">VixenUtilityStyles</VixenUtilityStylesClass>

        <!--
            Internal by default. A generated type that is public is public API — a baseline entry, a
            documentation page and a compatibility promise — for a class whose entire content is a
            string constant. A project that wants to expose it says so, and the usual shape is a
            hand-written public accessor that returns the constant, which is what `Vixen.Editor.Ui`
            does.
        -->
        <VixenUtilityStylesPublic Condition="'$(VixenUtilityStylesPublic)' == ''">false</VixenUtilityStylesPublic>
    </PropertyGroup>

    <ItemGroup Condition="'$(VixenUtilityStyles)' != 'false'">
        <!--
            Zero configuration: the theme file is found rather than declared. One per project — two
            would be two palettes, which is the thing the token model exists to prevent, so the
            target below refuses rather than picking.
        -->
        <VixenUiTokens Condition="'@(VixenUiTokens)' == ''"
                       Include="**/vixen.ui.vcss"
                       Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />

        <!--
            ⚠ **`VixenStyleTokens` is the unit correction: one project is one palette was the right
            invariant with the wrong unit, and the unit is the theme.** The glob above can only ever
            find a file *inside* the project, so an assembly that shares a design with eleven others
            had no way to say so — its classes resolved against nothing and the step did not even
            run. This item is a path to somebody else's `@theme` sheet, so the editor's dozen
            assemblies can name one token source and still each scan only their own sources.

            It is deliberately not a second copy of the glob. A theme *found* in the project is that
            project's own; a theme *named* here belongs to another one, and keeping the two items
            apart is what lets the error below go on meaning "this project declared two palettes"
            rather than becoming a rule about how many files are on a command line.

            Emitted before `@(VixenUiTokens)`, because `@theme` layers: v4's model is that a later
            block overrides an earlier one, so shared first and local second is what makes "the
            editor's tokens, plus the two this panel adds" expressible at all. Reversed, the shared
            source would silently win over the project that asked to extend it.
        -->

        <!--
            ⚠ **C# is scanned as well as markup, and leaving it out was never an option.** A panel
            built in code with `AddClass("flex")` is exactly as much a user of the utility as one
            written in VXML, and a build step that only read .vxml would emit nothing for it and be
            wrong in a way nobody could see. `CandidateScanner` does not parse anything — it takes
            every run of characters that could be a class name and lets the generator throw away the
            rest — so pointing it at arbitrary source text is what it is for.

            The generated accessor is excluded, and it is not a detail: the sheet contains every
            class name it emitted, so scanning it would feed the previous build's output back in as
            this build's input and no rule would ever be dropped again.
        -->
        <VixenStyleScan Include="@(Compile)" Exclude="$(IntermediateOutputPath)Vixen/**/*.cs" />
        <VixenStyleScan Include="**/*.vxml;**/*.vcss"
                        Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />

        <!--
            ⚠ **The build logic is an input, and leaving it out cost an afternoon before it was put
            in.** `Inputs` below lists the files the step *reads*, which is the obvious set and the
            incomplete one: a safelist entry, a namespace, a token source are all arguments rather
            than files, and MSBuild compares timestamps, so changing any of them left a perfectly
            stale sheet looking up to date. The files that *declare* those arguments are this one,
            whatever imported it, and the project — so those are the timestamps to watch.

            A file imported between the two adds itself here, which is what
            `Vixen.Editor.Ui.Styling.targets` does; the item is the extension point for exactly that.
        -->
        <VixenStyleBuildLogic Include="$(MSBuildThisFileFullPath);$(MSBuildProjectFullPath)" />
    </ItemGroup>

    <!--
        How to run the step. Three answers, most specific first, and the same ladder
        `Vixen.Sdk.targets` uses for the CLI — for the same reason: a build step and the assets that
        call it can drift apart, and the failure is a stylesheet generated by one release against
        tokens read by another.

        1. `VixenStyleGenPath`, which a consumer sets when it has its own build of the tool.
        2. The copy inside this package.
        3. The repository's own build of it, which is what every project in this tree uses.
    -->
    <PropertyGroup Condition="'$(VixenStyleGenPath)' == '' AND Exists('$(MSBuildThisFileDirectory)../tools/Vixen.StyleGen.dll')">
        <VixenStyleGenPath>$(MSBuildThisFileDirectory)../tools/Vixen.StyleGen.dll</VixenStyleGenPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(VixenStyleGenPath)' == ''">
        <VixenStyleGenPath>$(MSBuildThisFileDirectory)../../../Tools/Vixen.StyleGen/bin/$(Configuration)/net10.0/Vixen.StyleGen.dll</VixenStyleGenPath>
    </PropertyGroup>

    <Target Name="VixenGenerateUtilityStyles"
            BeforeTargets="CoreCompile"
            Condition="'$(VixenUtilityStyles)' != 'false' AND ('@(VixenUiTokens)' != '' OR '@(VixenStyleTokens)' != '' OR '@(VixenStyleBase)' != '')"
            Inputs="@(VixenStyleScan);@(VixenUiTokens);@(VixenStyleTokens);@(VixenStyleBase);@(VixenStyleBuildLogic);$(VixenStyleGenPath)"
            Outputs="$(IntermediateOutputPath)Vixen/$(VixenUtilityStylesClass).stamp">

        <!--
            ⚠ Computed inside the target rather than in a property group above, because
            IntermediateOutputPath is defined by Microsoft.NET.Sdk's own .targets — imported after
            this file — so a property group here would read it as empty. The same ordering rule
            `Vixen.Sdk.targets` opens with.
        -->
        <PropertyGroup>
            <_VixenStyleDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)Vixen'))</_VixenStyleDirectory>
            <_VixenStyleAccessor>$(_VixenStyleDirectory)/$(VixenUtilityStylesClass).g.cs</_VixenStyleAccessor>
            <_VixenStyleSheet>$(_VixenStyleDirectory)/$(AssemblyName).g.vcss</_VixenStyleSheet>
            <_VixenStyleReport>$(_VixenStyleDirectory)/$(AssemblyName).unrecognised.txt</_VixenStyleReport>
            <_VixenStyleResponse>$(_VixenStyleDirectory)/stylegen.rsp</_VixenStyleResponse>

            <!--
                ⚠ **A stamp, because the step deliberately does not touch its own output.** It rewrites
                the accessor only when the bytes differ — otherwise every build would give the
                compiler a newer file and a hot-reload watcher a new event. But MSBuild's
                Inputs/Outputs is a timestamp comparison, so an output that never moves is an output
                that is always out of date, and the step would then launch a process on every build
                including the ones with nothing to do. The stamp is the thing that always moves;
                the artefacts are the things that only move when they changed.
            -->
            <_VixenStyleStamp>$(_VixenStyleDirectory)/$(VixenUtilityStylesClass).stamp</_VixenStyleStamp>
            <_VixenStylePublicFlag Condition="'$(VixenUtilityStylesPublic)' == 'true'">--public</_VixenStylePublicFlag>
        </PropertyGroup>

        <Error Condition="'@(VixenUiTokens->Count())' &gt; '1'"
               Text="Vixen: this project has more than one vixen.ui.vcss (@(VixenUiTokens)). One project is one palette." />

        <!--
            ⚠ **A named token source that is not on disk is an error and not a skip, and this is the
            whole reason the item exists.** The failure this task set out to remove was silence: an
            assembly meant to share the editor's tokens, not sharing them, and rendering plausibly
            anyway because somebody had hand-written the missing class into a component sheet. A
            relative path is exactly the thing that rots when a project moves, so the one way to name
            a shared theme has to fail loudly when the name stops resolving. StyleGen reports a
            missing theme option too, but only once it has been launched, and a typo'd path would
            otherwise just fall out of the response file.
        -->
        <Error Condition="'@(VixenStyleTokens)' != '' AND !Exists('%(VixenStyleTokens.FullPath)')"
               Text="Vixen: the shared token source %(VixenStyleTokens.Identity) is not at %(VixenStyleTokens.FullPath). VixenStyleTokens names another project's @theme sheet; a project's own palette is a vixen.ui.vcss beside its sources." />

        <Error Condition="!Exists('$(VixenStyleGenPath)')"
               Text="Vixen: the utility build step is not at $(VixenStyleGenPath). Inside this repository, a project using utilities needs a ProjectReference to Tools/Vixen.StyleGen with ReferenceOutputAssembly=false, which is what builds it first." />

        <MakeDir Directories="$(_VixenStyleDirectory)" />

        <!--
            ⚠ A response file rather than a command line, and it is not tidiness. A project with four
            hundred sources gives four hundred `scan` paths; that is past Windows' command-line
            limit and near everyone else's, and the failure mode is a build that works on the
            machine it was written on. One argument per line also means a path with a space in it
            needs no quoting, which is the other half of the same problem.
        -->
        <ItemGroup>
            <_VixenStyleArgument Include="--namespace" />
            <_VixenStyleArgument Include="$(VixenUtilityStylesNamespace)" />
            <_VixenStyleArgument Include="--class" />
            <_VixenStyleArgument Include="$(VixenUtilityStylesClass)" />
            <_VixenStyleArgument Include="--accessor" />
            <_VixenStyleArgument Include="$(_VixenStyleAccessor)" />
            <_VixenStyleArgument Include="--output" />
            <_VixenStyleArgument Include="$(_VixenStyleSheet)" />
            <_VixenStyleArgument Include="--report" />
            <_VixenStyleArgument Include="$(_VixenStyleReport)" />
            <!-- Shared first, then the project's own: see the item's remark on why @theme layers. -->
            <_VixenStyleArgument Include="--theme;%(VixenStyleTokens.FullPath)" Condition="'@(VixenStyleTokens)' != ''" />
            <_VixenStyleArgument Include="--theme;%(VixenUiTokens.FullPath)" Condition="'@(VixenUiTokens)' != ''" />

            <!-- Ordered, because the base sheets are emitted in the order they are given. -->
            <_VixenStyleArgument Include="--base;%(VixenStyleBase.FullPath)" Condition="'@(VixenStyleBase)' != ''" />
            <_VixenStyleArgument Include="--safelist;%(VixenStyleSafelist.Identity)" Condition="'@(VixenStyleSafelist)' != ''" />
            <_VixenStyleArgument Include="--scan;%(VixenStyleScan.FullPath)" Condition="'@(VixenStyleScan)' != ''" />
        </ItemGroup>

        <WriteLinesToFile File="$(_VixenStyleResponse)"
                          Lines="@(_VixenStyleArgument)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />

        <Exec Command="dotnet &quot;$(VixenStyleGenPath)&quot; &quot;@$(_VixenStyleResponse)&quot;"
              WorkingDirectory="$(MSBuildProjectDirectory)"
              StandardOutputImportance="normal" />

        <Touch Files="$(_VixenStyleStamp)" AlwaysCreate="true" />

        <ItemGroup>
            <FileWrites Include="$(_VixenStyleAccessor);$(_VixenStyleSheet);$(_VixenStyleReport);$(_VixenStyleResponse);$(_VixenStyleStamp)" />
        </ItemGroup>
    </Target>

    <!--
        ⚠ **The compile item is added here rather than above, and getting that wrong is the classic
        build-step bug.** The target above is incremental: on a build where nothing changed it does
        not run, so anything it added to @(Compile) is not added — the generated file exists, is up
        to date, and is silently not compiled, and the error is a missing type in a project that
        built five seconds ago. Adding it from a target that always runs is what makes the two cases
        the same.

        It is still added from inside a target rather than from an ItemGroup at the top of this file:
        the SDK's default Compile glob was evaluated long before this was imported, so a file that
        did not exist then is not in it. An item added inside a target is, because CoreCompile reads
        the items when it executes.
    -->
    <Target Name="VixenIncludeUtilityStyles"
            BeforeTargets="CoreCompile"
            DependsOnTargets="VixenGenerateUtilityStyles"
            Condition="'$(VixenUtilityStyles)' != 'false'">

        <PropertyGroup>
            <_VixenStyleAccessor>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)Vixen/$(VixenUtilityStylesClass).g.cs'))</_VixenStyleAccessor>
        </PropertyGroup>

        <ItemGroup Condition="Exists('$(_VixenStyleAccessor)')">
            <Compile Include="$(_VixenStyleAccessor)" Visible="false" />
        </ItemGroup>
    </Target>

</Project>
