<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Net.Transport.WebSocket</RootNamespace>
        <Description>
            The WebSocket transport: for browsers, and for anything behind a proxy that only speaks
            HTTP. Held to the same conformance suite as the in-process and UDP transports.
        </Description>
        <PackageTags>networking;multiplayer;transport;websocket;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Net\Vixen.Net.csproj" />
    </ItemGroup>

</Project>
