<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Engine</RootNamespace>
        <Description>
            The layer a game is written against: the frame loop with its fixed-step accumulator, the
            transform hierarchy, scenes and prefabs, and the Behavior API — a MonoBehaviour-shaped
            surface that is an archetype ECS underneath.
        </Description>
        <PackageTags>game-engine;ecs;scene;behaviour;transform;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Core.Collections\Vixen.Core.Collections.csproj" />
        <ProjectReference Include="..\Vixen.Core.Diagnostics\Vixen.Core.Diagnostics.csproj" />
        <ProjectReference Include="..\Vixen.Core.Mathematics\Vixen.Core.Mathematics.csproj" />
        <ProjectReference Include="..\Vixen.Core.Threading\Vixen.Core.Threading.csproj" />
        <ProjectReference Include="..\Vixen.Ecs\Vixen.Ecs.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Engine.Tests" />
    </ItemGroup>

</Project>
