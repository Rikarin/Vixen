<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Engine</RootNamespace>
        <Description>
            The layer a game is written against: the frame loop with its fixed-step accumulator, the
            transform hierarchy, scenes and prefabs, and the Behavior API — a MonoBehaviour-shaped
            surface that is an archetype ECS underneath.
        </Description>
        <PackageTags>game-engine;ecs;scene;behaviour;transform;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Core.Collections\Vixen.Core.Collections.csproj" />
        <ProjectReference Include="..\Vixen.Core.Diagnostics\Vixen.Core.Diagnostics.csproj" />
        <ProjectReference Include="..\Vixen.Core.Mathematics\Vixen.Core.Mathematics.csproj" />
        <ProjectReference Include="..\Vixen.Core.Threading\Vixen.Core.Threading.csproj" />
        <ProjectReference Include="..\Vixen.Ecs\Vixen.Ecs.csproj" />

        <!--
            A compiled scene is written by a content build and read by a player, so SceneAsset and
            everything under it carries [DataContract] and this is the half that turns bytes back
            into a world. The importer that writes one and the runtime that loads it have to be
            talking about the same type — the argument Vixen.Navigation's NavMeshAsset already made.
        -->
        <ProjectReference Include="..\Vixen.Core.Serialization\Vixen.Core.Serialization.csproj" />

        <!--
            And the type registry, because a component named in an authored .vxscene is bound to its
            CLR type through a TypeDescriptor. Without this a game could compile scenes carrying its
            own components and none of the engine's, which would make the mechanism look like a
            limitation of the format rather than of one assembly's references.
        -->
        <ProjectReference Include="..\Vixen.Core.Reflection\Vixen.Core.Reflection.csproj" />

        <!--
            The action system, so that the SystemPhase.Input pass has something to run. The reference
            points this way rather than the other because Vixen.Ui also consumes Vixen.Input and must
            not acquire an ECS world by doing so (docs/plan/02 § "Why Vixen.Ui does not depend on
            Vixen.Engine") — which is why InputUpdateSystem lives here and not there.
        -->
        <ProjectReference Include="..\Vixen.Input\Vixen.Input.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            Analyzers do not flow transitively through a ProjectReference, so an assembly declaring
            [DataContract] types of its own has to name all three generators: the descriptors a
            YAML-bound component is found through come from the reflection generator, the binary
            serializers a compiled scene is made of come from the serialization one, and the engine
            one declares every [Component] [DataContract] type to SceneComponentRegistry so that a
            scene may name it without anybody writing a registration call.
        -->
        <ProjectReference Include="..\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Vixen.Engine.Generators\Vixen.Engine.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Engine.Tests" />
    </ItemGroup>

</Project>
