<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />

        <!-- The PNG codec's round-trip is a property over every size and every byte, not an example. -->
        <PackageReference Include="CsCheck" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!--
            One of the Consortium's test fonts, linked rather than copied — the same one
            Vixen.Ui.Tests uses, for the same reason. Text that reaches a draw list has to be shaped
            by a real font, and the software rasteriser's glyph path cannot be judged against a stub
            with invented metrics.
        -->
        <EmbeddedResource Include="..\Vixen.Ui.Text.Tests\Fonts\TestShapeLana.ttf"
                          LogicalName="Vixen.Ui.Testing.Tests.Fonts.TestShapeLana.ttf" />

        <!--
            And a Latin text face, because TestShapeLana cannot witness a clipped descender. Lana is
            a Tai Tham face: its line box is sized for stacked marks, so its baseline sits high and
            its Latin descenders stop four to six pixels above the bottom of the block. A box a pixel
            shorter than its text therefore loses a blank row, and `TextChildDescenderTests` passes
            against the very bug it exists to catch — measured, with the fix reverted, at every one
            of thirty-five widths.

            Open Sans is the face the editor actually ships and the one the panel port that found
            this was rendered in, and its descenders reach the last row of a tight line box. It is
            already in this repository with its OFL beside it, so this is a link and not a second
            copy — the same arrangement Vixen.Ui.Styling.Utilities.Tests uses, and a build-time file
            include rather than a project reference: nothing in this assembly's code knows the editor
            exists.
        -->
        <EmbeddedResource Include="..\..\Editor\Vixen.Editor.App\Fonts\OpenSans-Regular.ttf"
                          LogicalName="Vixen.Ui.Testing.Tests.Fonts.OpenSans-Regular.ttf" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The reference pictures, beside the binary. They are read from the output directory and
            written back to the source tree when VIXEN_UPDATE_SCREENSHOTS accepts a change, which is
            what stops an accepted picture evaporating on the next clean build.
        -->
        <None Include="__screenshots__\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Testing\Vixen.Ui.Testing.csproj" />
    </ItemGroup>
    <!--
        #1119's ratchet. The TEST profile in `Directory.Build.props` turns documentation generation
        off for every `*.Tests` project, so no `<see cref>` in any test assembly was ever checked —
        and a test's remarks are read at the worst possible moment, when the test has just gone red.
        CS1591 and CS1573 stay suppressed: "this public member has no comment" is a question about a
        packaged API surface, and a test assembly is not one.

        This project reported nothing when the whole tree was measured with the flag forced on, so
        here it is a latch rather than a repair — which is the point. An overload landing beside a
        cref written earlier is not historical rot; #821's own measurement watched it happen inside
        one working session.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
