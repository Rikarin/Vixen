<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Ui.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!--
            A control that draws a label has to be measured by a real font, or every test about
            where a label went is a test about zero. Linked rather than copied, for the reason
            Vixen.Ui.Tests gives: Vixen.Ui.Text.Tests already commits the file and there is no
            reason for a third copy of it.
        -->
        <EmbeddedResource Include="..\Vixen.Ui.Text.Tests\Fonts\TestShapeLana.ttf"
                          LogicalName="Vixen.Ui.Controls.Tests.Fonts.TestShapeLana.ttf" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The reference pictures, beside the binary. Read from the output directory and written
            back to the source tree when VIXEN_UPDATE_SCREENSHOTS accepts a change, which is what
            stops an accepted picture evaporating on the next clean build.
        -->
        <None Include="__screenshots__\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Controls\Vixen.Ui.Controls.csproj" />

        <!--
            The harness. `ControlFixture` predates it and still drives the tests written against it;
            what this adds is the waiting, the selectors and the pictures — and, for a control that
            draws itself rather than being made of elements, a picture is the only thing that can
            check the drawing at all. A slider's thumb is not an element, so no assertion about the
            element tree can say where it went.
        -->
        <ProjectReference Include="..\Vixen.Ui.Testing\Vixen.Ui.Testing.csproj" />
    </ItemGroup>

</Project>
