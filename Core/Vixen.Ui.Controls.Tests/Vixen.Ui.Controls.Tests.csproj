<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Ui.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!--
            A control that draws a label has to be measured by a real font, or every test about
            where a label went is a test about zero. Linked rather than copied, for the reason
            Vixen.Ui.Tests gives: Vixen.Ui.Text.Tests already commits the file and there is no
            reason for a third copy of it.
        -->
        <EmbeddedResource Include="..\Vixen.Ui.Text.Tests\Fonts\TestShapeLana.ttf"
                          LogicalName="Vixen.Ui.Controls.Tests.Fonts.TestShapeLana.ttf" />

        <!--
            ⚠ A second face, and the only reason it is here is that `font-style` cannot be measured
            with one. The slant decides *which face of a family draws*, so a fixture registering one
            face at both slants renders the same pixels either way and would pass with the property
            unread. No italic font is committed anywhere in this repository and Vixen does not
            synthesise a slant — see `FontRegistry.Slanted` — so the second face is a different font
            rather than a leaning one, which is exactly as much as the question needs. Linked, like
            the one above.
        -->
        <EmbeddedResource Include="..\Vixen.Ui.Text.Tests\Fonts\NotoSerifKannada-Regular.ttf"
                          LogicalName="Vixen.Ui.Controls.Tests.Fonts.NotoSerifKannada-Regular.ttf" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The reference pictures, beside the binary. Read from the output directory and written
            back to the source tree when VIXEN_UPDATE_SCREENSHOTS accepts a change, which is what
            stops an accepted picture evaporating on the next clean build.
        -->
        <None Include="__screenshots__\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Controls\Vixen.Ui.Controls.csproj" />

        <!--
            The harness. `ControlFixture` predates it and still drives the tests written against it;
            what this adds is the waiting, the selectors and the pictures — and, for a control that
            draws itself rather than being made of elements, a picture is the only thing that can
            check the drawing at all. A slider's thumb is not an element, so no assertion about the
            element tree can say where it went.
        -->
        <ProjectReference Include="..\Vixen.Ui.Testing\Vixen.Ui.Testing.csproj" />

        <!--
            ⚠ The markup compiler, so that at least one test in this assembly is a real `.vxml`
            rather than the `BuildContext` calls one compiles to. `MarkupTests` writes those calls by
            hand and says so, which checks what the control library contributes to the language and
            not that the language reaches the control library — and the two came apart once already:
            a control is only usable from markup if `ctx.Child<T>` binds to it and `Inner(T)` finds
            its content host, neither of which a hand-written `Build` body exercises. Analyzers do
            not travel through a ProjectReference, hence the OutputItemType.
        -->
        <ProjectReference Include="..\Vixen.Ui.Markup.Generators\Vixen.Ui.Markup.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- The **/*.vxml glob and the two properties the generator asks MSBuild for. -->
    <Import Project="..\Vixen.Ui\build\Vixen.Ui.targets" />

</Project>
