<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="CsCheck" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!--
            The emitter's gate is not "does the text look right" but "does Roslyn compile it, and
            does an error land on the .vxml line". That needs a real C# compiler, so the test
            project has one. Nothing shipped references it.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Markup\Vixen.Ui.Markup.csproj" />

        <!--
            The runtime the emitter's output calls. Vixen.Ui.Markup does not reference it and must
            not — a markup compiler that needed the framework it compiles for could not run inside
            the compiler. The test does, because the only worthwhile question about generated code
            is whether it compiles and runs against the real thing.
        -->
        <ProjectReference Include="..\Vixen.Ui\Vixen.Ui.csproj" />
    </ItemGroup>
</Project>
