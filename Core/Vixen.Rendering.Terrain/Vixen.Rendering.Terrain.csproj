<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Rendering.Terrain</RootNamespace>
        <Description>
            The device side of the terrain: the shared grid patch every CDLOD node is drawn from, the
            per-node instance records the vertex stage reads, and the render feature that binds them.
            The arithmetic is in Vixen.Terrain and is device-free on purpose — docs/plan/31 § D1 — so
            what is here is the part that needs a graphics device and nothing that does not.
        </Description>
        <PackageTags>terrain;cdlod;heightfield;landscape;rendering;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Core.Mathematics\Vixen.Core.Mathematics.csproj" />
        <ProjectReference Include="..\Vixen.Graphics\Vixen.Graphics.csproj" />
        <ProjectReference Include="..\Vixen.Rendering\Vixen.Rendering.csproj" />
        <ProjectReference Include="..\Vixen.Shaders\Vixen.Shaders.csproj" />
        <ProjectReference Include="..\Vixen.Terrain\Vixen.Terrain.csproj" />

        <!--
            The ECS and the transforms, for TerrainExtractionSystem — the bridge that walks
            TerrainComponent entities into the compositor node's frame list. Both already arrive
            transitively through Vixen.Rendering, whose own extraction systems live in the same
            arrangement; named here because this project now compiles against them directly.
        -->
        <ProjectReference Include="..\Vixen.Ecs\Vixen.Ecs.csproj" />
        <ProjectReference Include="..\Vixen.Engine\Vixen.Engine.csproj" />

        <!--
            The foliage kernel, for docs/plan/31 § T5's render path. Foliage is not a terrain feature
            — § D1 keeps the two kernels apart so a rooftop of moss does not depend on a heightfield —
            but the *device* side of both lives here, because there is one assembly that knows what a
            device is and this is it.
        -->
        <ProjectReference Include="..\Vixen.Foliage\Vixen.Foliage.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The generated binding keys. A binding index comes from declaration order within a set, so
            a texture added above another renumbers it — and a literal in C# holding the old number
            gets the wrong texture rather than an error. Vixen.Rendering's own remarks say the rest.
        -->
        <ProjectReference Include="..\Vixen.Shaders.Generators\Vixen.Shaders.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!-- Declares this assembly's [Component] [DataContract] types to SceneComponentRegistry. -->
        <ProjectReference Include="..\Vixen.Engine.Generators\Vixen.Engine.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
            The descriptor generator, for the compositor node kind. A document names !Terrain, and
            the YAML binder resolves the tag through the registration this generator emits — the
            same arrangement Vixen.Rendering.PostFx uses for !Bloom, and for the same reason:
            analyzers do not flow through a ProjectReference, so a contract name generated over
            there is not generated here.
        -->
        <ProjectReference Include="..\Vixen.Core.Reflection\Vixen.Core.Reflection.csproj" />
        <ProjectReference Include="..\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
            ⚠ And the serialiser for them, which is a *different* generator and was missing.

            Declaring a component to the registry and being able to write one into a scene are two
            jobs: `Vixen.Engine.Generators` does the first and `Vixen.Core.Serialization.Generator`
            does the second. With only the first, `TerrainComponent` was a component the editor could
            attach and the scene compiler could not save — "has no serializer, so a compiled scene
            could not carry one", thrown on save rather than on attach, which puts the error a long
            way from the cause. Analyzers do not flow through a ProjectReference, so it has to be
            named here.
        -->
        <ProjectReference Include="..\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- Named, not globbed: the generator emits a `…Keys` type per file, and two projects
             globbing one directory emit the same type twice. -->
        <AdditionalFiles Include="..\..\Raven\Library\Terrain\Terrain.reflect.json" />
        <AdditionalFiles Include="..\..\Raven\Library\Terrain\GrassScatter.reflect.json" />
        <AdditionalFiles Include="..\..\Raven\Library\Terrain\Grass.reflect.json" />
        <AdditionalFiles Include="..\..\Raven\Library\Terrain\Impostor.reflect.json" />
        <AdditionalFiles Include="..\..\Raven\Library\Terrain\FoliageCull.reflect.json" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Rendering.Terrain.Tests" />
    </ItemGroup>

</Project>
