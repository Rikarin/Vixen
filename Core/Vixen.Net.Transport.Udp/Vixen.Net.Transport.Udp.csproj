<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Net.Transport.Udp</RootNamespace>
        <Description>
            The UDP transport: four channels, retransmission, reassembly and timeouts, built out of a
            medium that promises none of it. Held to the same conformance suite as the in-process one.
        </Description>
        <PackageTags>networking;multiplayer;transport;udp;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Net\Vixen.Net.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Net.Transport.Udp.Tests" />

        <!--
          The fuzz harness seeds its corpus with well-formed datagrams of every kind, which needs the
          writers. Exposing UdpProtocol publicly instead would make a wire format an API surface for
          the sake of a test — and a corpus written by hand against a copy of the layout is one that
          goes stale silently, which for a fuzzer means a seed that guides nothing.
        -->
        <InternalsVisibleTo Include="Vixen.Net.Fuzz" />
    </ItemGroup>

</Project>
