<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Shaders</RootNamespace>
        <Description>
            The engine's side of the shader contract: interned, typed parameter and permutation
            keys, and the std140/std430 constant-buffer writers that Vixen.Shaders.Generators
            emits calls to. Every offset is baked at compile time from Raven's reflection, so
            filling a uniform block costs no reflection and no name lookup at run time.
        </Description>
        <PackageTags>shaders;parameters;constant-buffer;std140;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Core.Mathematics\Vixen.Core.Mathematics.csproj" />
        <ProjectReference Include="..\Vixen.Graphics\Vixen.Graphics.csproj" />

        <!--
          A baked variant is content: EffectData rides the engine's own serializer into a chunk, so a
          shipping build reads its shaders through the same bundle machinery as its meshes rather
          than through a second format that would have to be versioned separately.
        -->
        <ProjectReference Include="..\Vixen.Core.Reflection\Vixen.Core.Reflection.csproj" />
        <ProjectReference Include="..\Vixen.Core.Serialization\Vixen.Core.Serialization.csproj" />

        <ProjectReference Include="..\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <ProjectReference Include="..\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Shaders.Tests" />
    </ItemGroup>

</Project>
