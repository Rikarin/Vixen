<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Shaders</RootNamespace>
        <Description>
            The engine's side of the shader contract: interned, typed parameter and permutation
            keys, and the std140/std430 constant-buffer writers that Vixen.Shaders.Generators
            emits calls to. Every offset is baked at compile time from Raven's reflection, so
            filling a uniform block costs no reflection and no name lookup at run time.
        </Description>
        <PackageTags>shaders;parameters;constant-buffer;std140;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <!--
        ⚠ The binding generator travels inside this package, so a consumer that references
        Vixen.Shaders — or Vixen.Rendering, which brings it — gets a `…Keys` type for its own
        .reflect.json without knowing a generator exists. It did not, and that was the whole of the
        "shader parameter keys" gap: doc 08 § Vixen.Sdk step 3 and ADR-002 both put the keys in a
        source generator rather than in a tool writing .cs to disk, the generator was written, and
        every consumer of it in this repository is a ProjectReference — through which analyzers do
        not flow. So it worked here and shipped to nobody, which is the shape a `dotnet pack` will
        never complain about.

        Here rather than on Vixen.Rendering because what the generated code names — ParameterKeys,
        the std140 writers — is this assembly's, so the generator and the types its output calls
        travel together and a consumer cannot get one without the other.
    -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);PackShaderGenerator
        </TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <!-- GetTargetPath, not Build — as in Vixen.Ui and Vixen.Input: asking for Build fails a
         no-build `dotnet pack` with NETSDK1085, because NoBuild is a global property handed to the
         invoked project. -->
    <Target Name="PackShaderGenerator">
        <MSBuild Projects="..\Vixen.Shaders.Generators\Vixen.Shaders.Generators.csproj"
                 Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="TargetFramework">
            <Output TaskParameter="TargetOutputs" ItemName="ShaderGeneratorAssembly" />
        </MSBuild>

        <ItemGroup>
            <TfmSpecificPackageFile Include="@(ShaderGeneratorAssembly)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Core.Mathematics\Vixen.Core.Mathematics.csproj" />
        <ProjectReference Include="..\Vixen.Graphics\Vixen.Graphics.csproj" />

        <!--
          A baked variant is content: EffectData rides the engine's own serializer into a chunk, so a
          shipping build reads its shaders through the same bundle machinery as its meshes rather
          than through a second format that would have to be versioned separately.
        -->
        <ProjectReference Include="..\Vixen.Core.Reflection\Vixen.Core.Reflection.csproj" />
        <ProjectReference Include="..\Vixen.Core.Serialization\Vixen.Core.Serialization.csproj" />

        <ProjectReference Include="..\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <ProjectReference Include="..\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Shaders.Tests" />
    </ItemGroup>

</Project>
