<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <!--
            A plain reference rather than an Analyzer one: these tests drive the generator through
            CSharpGeneratorDriver themselves, which needs to construct it.

            ⚠ And deliberately *not* alongside Vixen.Ui.Markup. The generator assembly contains its
            own compilation of that front end, so referencing both would make every type in it
            ambiguous — which is the linked-source arrangement showing through, and the one place it
            is visible from outside.
        -->
        <ProjectReference Include="..\Vixen.Ui.Markup.Generators\Vixen.Ui.Markup.Generators.csproj" />

        <!-- The runtime the generated code calls, so the end-to-end test can run what it built. -->
        <ProjectReference Include="..\Vixen.Ui\Vixen.Ui.csproj" />
    </ItemGroup>

    <!--
        What BuildIntegrationTests builds a project against, handed over as metadata rather than
        found at run time by walking up from the test assembly looking for a repository — a test
        that has to locate its own subject breaks when somebody moves a directory. Same arrangement
        as Vixen.Sdk.Tests, for the same reason.
    -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>VixenUiProject</_Parameter1>
            <_Parameter2>$(MSBuildThisFileDirectory)../Vixen.Ui/Vixen.Ui.csproj</_Parameter2>
        </AssemblyAttribute>

        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>VixenMarkupGeneratorProject</_Parameter1>
            <_Parameter2>$(MSBuildThisFileDirectory)../Vixen.Ui.Markup.Generators/Vixen.Ui.Markup.Generators.csproj</_Parameter2>
        </AssemblyAttribute>

        <!--
            ⚠ The *other* generator, which this fixture had no reason to name until VX4003 existed.
            A project that compiles markup and does not load it gets no [UiProperty] registrations
            and no VXS0320 — silently, in both directions — which is why the check that reports it
            needs a fixture that can be in exactly that state and one that cannot.
        -->
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>VixenPropertyGeneratorProject</_Parameter1>
            <_Parameter2>$(MSBuildThisFileDirectory)../Vixen.Ui.Generators/Vixen.Ui.Generators.csproj</_Parameter2>
        </AssemblyAttribute>

        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>VixenUiBuildTargets</_Parameter1>
            <_Parameter2>$(MSBuildThisFileDirectory)../Vixen.Ui/build/Vixen.Ui.targets</_Parameter2>
        </AssemblyAttribute>

        <!--
            ⚠ The repository's own stand-in for a PackageReference, which is where VX4001 lives and
            has to live: the failure it reports is that Vixen.Ui.targets was never imported, so a
            check inside that file could not see it. The fixture project hands this path to
            DirectoryBuildTargetsPath — MSBuild's own auto-import reads that property — so the file
            is evaluated at the position it holds for every project in this tree.
        -->
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>VixenRepositoryTargets</_Parameter1>
            <_Parameter2>$(MSBuildThisFileDirectory)../../Directory.Build.targets</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
