<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Audio</RootNamespace>
        <Description>
            The audio subsystem: the decoded clip the content pipeline produces, a software mixer
            with buses and effects, 3D spatialisation, streaming, and the device contract a backend
            implements.
        </Description>
        <PackageTags>audio;mixer;spatial;streaming;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- For [DataContract]. A clip is a chunk in the object database like everything else, so it
             is described by the same attribute and serialised by the same generated code. -->
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Core.Serialization\Vixen.Core.Serialization.csproj" />

        <!-- Positions, velocities and the listener basis. The spatialiser is arithmetic over Vector3
             and has to agree with Conventions.md about which way is forward. -->
        <ProjectReference Include="..\Vixen.Core.Mathematics\Vixen.Core.Mathematics.csproj" />

        <!--
          The ECS integration: components an emitter carries and the system that drives the engine
          from a world. It is in this assembly rather than in Vixen.Engine because docs/plan/14 puts
          "ECS integration" under Vixen.Audio, and because the dependency has to point this way —
          Vixen.Engine owns WorldTransform, and an audio emitter is a thing at a transform.
        -->
        <ProjectReference Include="..\Vixen.Ecs\Vixen.Ecs.csproj" />
        <ProjectReference Include="..\Vixen.Engine\Vixen.Engine.csproj" />
        <ProjectReference Include="..\Vixen.Core.Threading\Vixen.Core.Threading.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- [LoggerMessage] over the ids in docs/manual/log-events.md. Nothing is logged from the
             audio thread; see Diagnostics/AudioLog.cs. -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Named here because analyzers do not flow through a ProjectReference. The serializer has to
          be generated in the assembly that *declares* AudioClip: a consumer that references the
          generator sees no AudioClip in its own compilation and emits nothing, and the failure is a
          run-time "no serializer is registered" rather than a build error.
        -->
        <ProjectReference Include="..\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
          And the reflection generator, for the same reason and about the other half. The mixer,
          event and music assets are [DataContract] record graphs whose whole point is that "a sound
          designer who has to open a C# file to move a fader does not move the fader" — and the file
          they open is YAML, which `Vixen.Core.Yaml` binds through a *descriptor*. Without this the
          types are describable in principle and unreadable in practice: the editor's mixer document
          would throw on the first save with "MixerAsset has no descriptor".
        -->
        <ProjectReference Include="..\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
          Declares this assembly's [Component] [DataContract] types to SceneComponentRegistry, which
          is what puts an emitter in the Add Component menu and lets a .vxscene name one. Vixen.
          Rendering's LightComponents already describes this as "the arrangement Vixen.Physics and
          Vixen.Audio already use" — it was the one of the three that never ran the generator, so a
          scene could be given a sound only in code.
        -->
        <ProjectReference Include="..\Vixen.Engine.Generators\Vixen.Engine.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Audio.Tests" />
    </ItemGroup>

</Project>
