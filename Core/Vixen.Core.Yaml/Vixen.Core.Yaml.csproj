<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Core.Yaml</RootNamespace>
        <Description>
            The YAML dialect Vixen's .meta and .vxasset files are written in: a node model that
            remembers how it was written, a reader over YamlDotNet's event stream, and an emitter
            that reproduces what it read byte for byte.
        </Description>
        <PackageTags>yaml;serialization;asset-pipeline;aot;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="YamlDotNet" />
        <PackageReference Include="System.IO.Hashing" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Core.Reflection\Vixen.Core.Reflection.csproj" />

        <!--
          The .meta model types are [DataContract]s of this assembly's own, so it runs the descriptor
          generator over itself. Analyzers do not flow transitively through a ProjectReference.
        -->
        <ProjectReference Include="..\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Core.Yaml.Tests" />
    </ItemGroup>

</Project>
