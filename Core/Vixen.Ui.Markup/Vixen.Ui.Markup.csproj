<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Ui.Markup</RootNamespace>
        <Description>
            VXML: the markup language behind Vixen's UI framework. A hand-written lexer and
            recursive-descent parser over the shared green/red tree, a binder that resolves the
            markup into a component model, and an emitter that turns that model into a C# partial
            class with #line directives pointing back at the .vxml.
        </Description>
        <PackageTags>markup;parser;syntax-tree;ui;source-generator;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <!--
        ⚠ This is what turns VXS0001 back on. The diagnostic is opt-in since #1188 — it fires when
        a compilation has no Syntax.xml, which is every consumer of Vixen.Core.Syntax that is not
        building a language, and with TreatWarningsAsErrors that was a build break rather than a
        warning; it was the reason the package could not carry the generator. A project that says
        it is building a language is exactly the one the guard is for: forgetting the AdditionalFiles
        line below is then one diagnostic rather than a hundred CS0246s.

        CompilerVisibleProperty is what puts it in the analyzer config. In a package this line comes
        from Vixen.Core.Syntax's buildTransitive targets; in this tree the reference is a
        ProjectReference, which carries no build assets, so it is named here.
    -->
    <PropertyGroup>
        <VixenSyntaxXmlRequired>true</VixenSyntaxXmlRequired>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="VixenSyntaxXmlRequired" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Syntax\Syntax.xml" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The shared green/red tree, SourceText and the diagnostics model. This is the whole
            reason the language is cheap: VXML brings a grammar, not a tree.
        -->
        <ProjectReference Include="..\Vixen.Core.Syntax\Vixen.Core.Syntax.csproj" />

        <!-- Turns Syntax\Syntax.xml into the node classes. Analyzer-only, no reference. -->
        <ProjectReference Include="..\Vixen.Core.Syntax.Generator\Vixen.Core.Syntax.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Ui.Markup.Tests" />
    </ItemGroup>

</Project>
