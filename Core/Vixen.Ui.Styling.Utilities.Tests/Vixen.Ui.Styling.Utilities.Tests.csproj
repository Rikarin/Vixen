<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="CsCheck" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Styling.Utilities\Vixen.Ui.Styling.Utilities.csproj" />

        <!--
            ⚠ The consumption gate is why this test assembly sees Vixen.Ui at all, and the reference is
            the whole argument of docs/plan/43: a utility family is judged against the engine that has
            to read what it emits, not against the stylesheet it produces. Nothing else here needs a
            document, a layout or a draw list — UtilityConsumptionGateTests needs all three, because
            "something acts on this property" is a question only a frame can answer.
        -->
        <ProjectReference Include="..\Vixen.Ui\Vixen.Ui.csproj" />

        <!--
            ⚠ And Vixen.Ui.Controls, for exactly the same argument one level further out: `fill` and
            `stroke` are read by `Icon`, which lives here rather than in Vixen.Ui, so a gate that
            could not build an icon measured both properties inert whatever the engine did about
            them. That is the `grid-cols-3` blind spot again — "no scene contained a grid" — and the
            fix is the same one: give the probe the thing the property is about. One `Icon` in the
            shared tree is enough, because the verdict is a union over the scenes.
        -->
        <ProjectReference Include="..\Vixen.Ui.Controls\Vixen.Ui.Controls.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            ⚠ A real font, because without one the gate is blind to half the typography properties and
            says so by failing them. A document with nothing registered draws no glyphs at all, so
            `font-size`, `line-height`, `letter-spacing`, `text-align` and `white-space` each move
            nothing and read as inert — a false gap, and the expensive kind, because the honest response
            to a false gap is to go and implement something that is already there. Two faces under one
            family so that `font-weight` has a second face to select; the same file linked twice, which
            is enough because what is being measured is whether the weight reaches the registry at all.
            Linked rather than copied, as Vixen.Ui.Tests links it: Fonts/README.md over there says whose
            it is.
        -->
        <EmbeddedResource Include="..\Vixen.Ui.Text.Tests\Fonts\TestShapeLana.ttf"
                          LogicalName="Vixen.Ui.Styling.Utilities.Tests.Fonts.TestShapeLana.ttf" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The expiring allow-list, and the plan document its task numbers have to appear in. Both are
            read at run time rather than compiled in, so that adding a line is a diff a reviewer sees in
            a file whose whole purpose is to be looked at.
        -->
        <Content Include="InertProperties.txt" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\..\docs\plan\43-web-styling-parity.md" Link="43-web-styling-parity.md" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
