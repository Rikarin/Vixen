<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Ui</RootNamespace>
        <Description>
            The UI framework proper: the element tree, the property system, event routing and the
            draw list — and, first, the step between the cascade and layout that resolves a computed
            style into the lengths a flexbox engine can use.
        </Description>
        <PackageTags>ui;css;flexbox;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
        <None Include="build\Vixen.Ui.targets" Pack="true" PackagePath="build\" />
    </ItemGroup>

    <!--
        Both generators travel inside the package, so a consumer that references Vixen.Ui gets
        [UiProperty] accessors for its own elements and a compiled class for its own .vxml files
        without knowing either generator exists. Inside this repository each has to be named
        explicitly by the project that needs it, because analyzers are not transitive through a
        ProjectReference — which is why the reference below exists as well.
    -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);PackUiGenerators
        </TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <!--
        GetTargetPath, not Build — as in Vixen.Core.Serialization. Asking for Build here fails a
        no-build `dotnet pack` with NETSDK1085, because NoBuild is a global property and the MSBuild
        task hands global properties to the project it invokes.
    -->
    <Target Name="PackUiGenerators">
        <MSBuild Projects="..\Vixen.Ui.Generators\Vixen.Ui.Generators.csproj;..\Vixen.Ui.Markup.Generators\Vixen.Ui.Markup.Generators.csproj"
                 Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="TargetFramework">
            <Output TaskParameter="TargetOutputs" ItemName="UiGeneratorAssembly" />
        </MSBuild>

        <ItemGroup>
            <TfmSpecificPackageFile Include="@(UiGeneratorAssembly)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <!--
            The two subsystems this assembly exists to join, plus text because `em` is a font-relative
            unit and the font size is where it comes from. Neither Styling nor Layout references the
            other, and that is deliberate: the dependency is a V rather than a chain, so a flexbox
            engine stays usable without a stylesheet and a cascade stays testable without a layout.
        -->
        <ProjectReference Include="..\Vixen.Ui.Styling\Vixen.Ui.Styling.csproj" />
        <ProjectReference Include="..\Vixen.Ui.Layout\Vixen.Ui.Layout.csproj" />
        <ProjectReference Include="..\Vixen.Ui.Text\Vixen.Ui.Text.csproj" />

        <!--
            The signal graph. Vixen.Ui.Composition is where markup meets state: one effect per
            dynamic expression is the whole of ADR-010, and an effect is what Reactive is.
        -->
        <ProjectReference Include="..\Vixen.Ui.Reactive\Vixen.Ui.Reactive.csproj" />

        <!--
            For `InputKey` and nothing else. The enum is the USB HID usage table, and a UI framework
            that declared its own copy would be the third in the repository — Vixen.Platform has one
            because it talks to the backends and Vixen.Input has one because Core cannot reference
            Platform. InputKey's own remarks name this assembly as its consumer, so this is the
            reference that documentation was written for.
        -->
        <ProjectReference Include="..\Vixen.Input\Vixen.Input.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The [UiProperty] generator. Analyzers do not flow transitively through a ProjectReference,
            so anything that declares UI properties references it directly the way this does.
        -->
        <ProjectReference Include="..\Vixen.Ui.Generators\Vixen.Ui.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
            The VXML compiler. This assembly has no .vxml of its own and the glob that would find
            one is not imported here, so it generates nothing — the reference is what makes the
            generator part of this package: `Vixen.Ui` is what a project with an interface
            references, so it is what has to bring the thing that compiles the markup. It also
            builds the assembly PackUiGenerators then asks only for the path of.
        -->
        <ProjectReference Include="..\Vixen.Ui.Markup.Generators\Vixen.Ui.Markup.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Ui.Tests" />

        <!--
            ⚠ A friend assembly that ships, which the one above is not. Vixen.Ui.Testing drives the
            cascade's own SelectorMatcher over this tree, and matching needs the StyleNodeId an
            element holds — internal, because an id addressing a slot is not something application
            code should be able to get wrong. The alternative was to widen the public surface for a
            consumer that is not the application, or to re-implement selector matching against Tag
            and HasClass and quietly disagree with the stylesheets about what `:nth-child` means.
        -->
        <InternalsVisibleTo Include="Vixen.Ui.Testing" />
    </ItemGroup>

</Project>
