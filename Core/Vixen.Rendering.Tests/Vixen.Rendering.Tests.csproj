<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="CsCheck" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Rendering\Vixen.Rendering.csproj" />

        <!--
          The Null backend, for the recording tests. It is what the repository built for exactly
          this: a real ICommandList implementation that remembers what it was told, so a test can
          assert on the draw calls a feature produced rather than on a stub of its own.
          Vixen.Graphics.RenderGraph.Tests does the same.
        -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Null\Vixen.Graphics.Null.csproj" />

        <!--
          The YAML dialect, so the compositor-asset test reads an actual authored document rather
          than a record graph built in C#. Vixen.Rendering itself does not reference this: which file
          format a compositor is read from belongs to whoever reads it, so a shipping runtime that
          loads a baked one never links a YAML parser.
        -->
        <ProjectReference Include="..\Vixen.Core.Yaml\Vixen.Core.Yaml.csproj" />
    </ItemGroup>

    <!-- Measured, the guarded allocation measurement. See Testing/Vixen.Testing.props. -->
    <Import Project="..\..\Testing\Vixen.Testing.props" />

    <!--
      Every shipped shader, so ComposeSlotInventoryTests can check the engine binds every slot they
      declare. A glob rather than a list: the failure this guards against arrives as a NEW file, and a
      glob is what sees one.
    -->
    <ItemGroup>
        <None Include="..\..\Raven\Library\**\*.rvn" LinkBase="Shaders" CopyToOutputDirectory="PreserveNewest" />

        <!--
          And the reflection beside the sources, so a test can hold a C# mirror of a shader struct
          against the offsets Raven actually assigned rather than against the ones somebody wrote in
          a comment while looking at them.
        -->
        <None Include="..\..\Raven\Library\**\*.reflect.json" LinkBase="Shaders" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
