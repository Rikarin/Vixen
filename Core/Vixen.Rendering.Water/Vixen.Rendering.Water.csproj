<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Rendering.Water</RootNamespace>
        <Description>
            Water's device half: the pass that integrates absorption and scattering over the depth of
            water between the surface and whatever is behind it, and composites it once. The only
            assembly in the water stack that knows what a device is.
        </Description>
        <PackageTags>water;ocean;rendering;compositor;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core.Mathematics\Vixen.Core.Mathematics.csproj" />
        <ProjectReference Include="..\Vixen.Graphics\Vixen.Graphics.csproj" />
        <ProjectReference Include="..\Vixen.Graphics.RenderGraph\Vixen.Graphics.RenderGraph.csproj" />
        <ProjectReference Include="..\Vixen.Shaders\Vixen.Shaders.csproj" />
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Core.Reflection\Vixen.Core.Reflection.csproj" />
        <ProjectReference Include="..\Vixen.Core.Serialization\Vixen.Core.Serialization.csproj" />

        <!--
          The compositor, for the node the pass is made of. A water pass is one draw of three vertices
          into the scene colour reading five other planes, which FullScreenRenderer already is.
        -->
        <ProjectReference Include="..\Vixen.Rendering\Vixen.Rendering.csproj" />

        <!--
          The ECS, for the two scene components. They are here rather than in the kernel for
          Vixen.Rendering.Terrain's reason: Vixen.Terrain declares no components either, because a
          kernel that referenced the ECS would be a kernel a dedicated server could not link without
          also linking a world.
        -->
        <ProjectReference Include="..\Vixen.Ecs\Vixen.Ecs.csproj" />

        <!--
          The kernel, for the sea state the pass uploads. Doc 35 § D2: the surface is defined once, and
          what the vertex stage displaces by is generated by the same code a buoyancy solver queries —
          so this reads Vixen.Water rather than holding a second copy of a spectrum.
        -->
        <ProjectReference Include="..\Vixen.Water\Vixen.Water.csproj" />

        <!--
          The node kind is a [DataContract] record of this assembly's own — a document names !Water —
          so it runs the descriptor generators over itself. Analyzers do not flow through a
          ProjectReference, so a contract name generated in Vixen.Rendering is not generated here.
        -->
        <ProjectReference Include="..\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <ProjectReference Include="..\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
          The shader binding generator, over the reflection checked in beside the library shader. A
          binding index is assigned by Raven from declaration order within a set, so adding a texture
          above another in Water.rvn renumbers it — and a pass holding the old number gets a validation
          error at best and the wrong texture at worst.
        -->
        <ProjectReference Include="..\Vixen.Shaders.Generators\Vixen.Shaders.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="..\..\Raven\Library\Water\Water.reflect.json" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Rendering.Water.Tests" />
    </ItemGroup>

</Project>
