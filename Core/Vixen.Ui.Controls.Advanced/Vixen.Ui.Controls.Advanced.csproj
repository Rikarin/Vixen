<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Ui.Controls.Advanced</RootNamespace>
        <Description>
            The controls that prove the framework rather than furnish it: a docking host with
            splitters, tab groups and a serialisable layout; a virtualised tree and a data grid
            virtualised in both directions; a property grid generated from type descriptors; a node
            canvas, a code editor, a curve editor, a timeline, a colour picker, a gradient editor
            and a viewport.
        </Description>
        <PackageTags>ui;controls;docking;treeview;datagrid;property-grid;node-graph;code-editor;timeline;color-picker;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Controls\Vixen.Ui.Controls.csproj" />

        <!--
            NodeGraph's rules — the cycle refusal, the cascade a deletion causes, one wire per input
            — are GraphInvariants', because Vixen.Editor.NodeGraph's document model enforces the same
            three and two copies would eventually be two rules. Arrives transitively through the
            reference above; named here because a file in this assembly depends on it directly.
        -->
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />

        <!--
            The property grid's whole reason for existing. `TypeDescriptor` is generated, so an
            inspector reads and writes arbitrary members after trimming and on iOS — which is what
            an inspector built on System.Reflection cannot do.
        -->
        <ProjectReference Include="..\Vixen.Core.Reflection\Vixen.Core.Reflection.csproj" />

        <!--
            A docking layout is a document. It is written and read as YAML rather than through the
            binary serializer because it is something a person edits, diffs and checks in — the same
            argument doc 11 makes for project settings.
        -->
        <ProjectReference Include="..\Vixen.Core.Yaml\Vixen.Core.Yaml.csproj" />

        <ProjectReference Include="..\Vixen.Ui.Generators\Vixen.Ui.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!--
            The VXML compiler, for `KeyBindingsView.vxml` (#650) — the first `.vxml` a shipped `Core/`
            library compiles. Analyzers do not flow through a ProjectReference, so the assembly that
            owns a `.vxml` names the generator itself; without this line the file is an
            `AdditionalFiles` item nothing reads and VX4001 says so.
        -->
        <ProjectReference Include="..\Vixen.Ui.Markup.Generators\Vixen.Ui.Markup.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Ui.Controls.Advanced.Tests" />
    </ItemGroup>

    <!--
        ⚠ **Imported for the `**/*.vcss` glob, which is what makes `AdvancedTheme.vcss` an
        EmbeddedResource.** `AdvancedTheme.Css` reads it back by its logical name, so without this
        line the property throws at the first `Install` rather than failing to compile — the error
        message it throws names this import for that reason.

        At the bottom of the file, because the glob has to run after DefaultItemExcludes is final.
        The other half of the .targets — the `**/*.vxml` glob — has one file to find since #650.
    -->
    <Import Project="..\Vixen.Ui\build\Vixen.Ui.targets" />

</Project>
