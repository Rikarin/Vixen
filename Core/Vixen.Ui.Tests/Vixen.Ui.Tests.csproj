<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="CsCheck" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!--
            One of the Consortium's test fonts, linked rather than copied. Text that reaches a draw
            list has to be shaped by a real font — a stub with invented metrics would agree with
            whatever this assembly did to it — and there is no reason for a second copy of a file
            Vixen.Ui.Text.Tests already commits. Fonts/README.md over there says whose it is.
        -->
        <EmbeddedResource Include="..\Vixen.Ui.Text.Tests\Fonts\TestShapeLana.ttf"
                          LogicalName="Vixen.Ui.Tests.Fonts.TestShapeLana.ttf" />

        <!--
            And a Kannada face, for the one thing Latin cannot show: a cluster holding more than one
            glyph. `letter-spacing` is applied per cluster, and against Latin the per-glyph version
            of that code gives an identical answer — so a test that only had TestShapeLana would pass
            with the distinction removed.
        -->
        <EmbeddedResource Include="..\Vixen.Ui.Text.Tests\Fonts\NotoSerifKannada-Regular.ttf"
                          LogicalName="Vixen.Ui.Tests.Fonts.NotoSerifKannada-Regular.ttf" />

        <!--
            And a face with an *astral* character in it, which neither of the others has. Per-glyph
            fallback reads a string a code point at a time, and a surrogate pair read as two `char`s
            asks the font about two halves of an emoji that no font has — so every astral character
            would fall past the whole chain. Nothing without a font that draws one can tell the two
            readings apart: it cost a sabotage that failed to fail to notice.
        -->
        <EmbeddedResource Include="..\Vixen.Ui.Text.Tests\Fonts\Zycon.ttf"
                          LogicalName="Vixen.Ui.Tests.Fonts.Zycon.ttf" />

        <!--
            And the face whose `calt` turns the first `a` of "a a" into an alternate — the only
            feature in this repository whose presence or absence is visible in a glyph id. It is what
            lets `font-feature-settings` be asserted end to end rather than only as far as the
            computed style: every numeric feature `font-variant-numeric` names is absent from all
            twenty-two Consortium faces, so a test written against one of those would pass against a
            shaper that was still being handed an empty array.
        -->
        <EmbeddedResource Include="..\Vixen.Ui.Text.Tests\Fonts\TestGSUBOne.otf"
                          LogicalName="Vixen.Ui.Tests.Fonts.TestGSUBOne.otf" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui\Vixen.Ui.csproj" />

        <!--
            For `RingBufferSink`, and the choice is the point of `StyleDiagnosticDrainTests`: the
            claim being tested is not "a delegate was called" but "a refused stylesheet rule lands in
            the ring the editor's Console panel reads". A hand-rolled capturing logger would prove the
            first and say nothing about the second.
        -->
        <ProjectReference Include="..\Vixen.Core.Diagnostics\Vixen.Core.Diagnostics.csproj" />

        <!-- Analyzers do not flow transitively, so the sample elements below need it named here. -->
        <ProjectReference Include="..\Vixen.Ui.Generators\Vixen.Ui.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
