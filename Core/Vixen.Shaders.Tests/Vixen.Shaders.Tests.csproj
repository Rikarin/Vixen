<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Shaders\Vixen.Shaders.csproj" />

        <!--
          Referenced as an ordinary assembly, not as an analyzer: these tests call the emitter
          directly and assert on the text it returns. The analyzer wrapper is one `AddSource` call
          over the same function, and running the whole Roslyn generator host to assert on a string
          would test Roslyn.

          The end-to-end claim — that the emitted text compiles and writes the right bytes — is made
          by GeneratedBindingsTests, which checks in the generated file and compiles it as part of
          this project.
        -->
        <ProjectReference Include="..\Vixen.Shaders.Generators\Vixen.Shaders.Generators.csproj" />

        <!--
          A device, for the one part of the effect chain that needs one: EffectLoader turns a baked
          record into descriptor set layouts and a pipeline layout. The Null backend records what it
          was asked for and creates nothing, which is exactly the question here — how many distinct
          layouts a set of effects asks for is a property of the loader, not of a driver.
        -->
        <ProjectReference Include="..\..\Platform\Vixen.Graphics.Null\Vixen.Graphics.Null.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Raven's own reflection for the fixture shader, regenerated by Fixtures/README.md's command. -->
        <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
