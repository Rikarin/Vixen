<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Shaders\Vixen.Shaders.csproj" />

        <!--
          Referenced as an ordinary assembly, not as an analyzer: these tests call the emitter
          directly and assert on the text it returns. The analyzer wrapper is one `AddSource` call
          over the same function, and running the whole Roslyn generator host to assert on a string
          would test Roslyn.

          The end-to-end claim — that the emitted text compiles and writes the right bytes — is made
          by GeneratedBindingsTests, which checks in the generated file and compiles it as part of
          this project.
        -->
        <ProjectReference Include="..\Vixen.Shaders.Generators\Vixen.Shaders.Generators.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Raven's own reflection for the fixture shader, regenerated by Fixtures/README.md's command. -->
        <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
