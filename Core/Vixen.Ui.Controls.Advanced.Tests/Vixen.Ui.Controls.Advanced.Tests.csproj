<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Ui.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!--
            The syntax tree `CodeAccessibleNameTests` resolves a receiver from. A literal assigned to
            `Label` is a spoken name only when the receiver is a control that speaks it, and the
            receiver's type is a local's initializer, a member's declaration or a `new` three lines
            away — which a line-based pattern cannot follow and a parser can. Syntax only: no
            compilation is built, so no reference set has to be kept in step with the tree.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\Vixen.Ui.Text.Tests\Fonts\TestShapeLana.ttf"
                          LogicalName="Vixen.Ui.Controls.Advanced.Tests.Fonts.TestShapeLana.ttf" />

        <!--
            The fixed-pitch face `font-family: monospace` resolves to in this suite. Synthetic and
            Vixen's own, built by Fonts/TestMono.py; the README beside it says why a proportional
            face here made every CodeEditor geometry assertion true of itself.
        -->
        <EmbeddedResource Include="Fonts\TestMono.ttf"
                          LogicalName="Vixen.Ui.Controls.Advanced.Tests.Fonts.TestMono.ttf" />
    </ItemGroup>

    <ItemGroup>
        <!--
            What a `.vxml` line is allowed to say, compiled into this assembly rather than referenced
            from `Vixen.Ui.Styling.Tests`, which is why its namespace matches neither. Two sweeps in
            two assemblies read the same files for different names — which tags the repository writes,
            and which words a control is handed to say — and the batch that taught the first to skip
            XML comments and `@code` bodies shipped the second with no filter at all. The tests are linked
            beside it so each assembly proves its own copy; `Vixen.Geometry.Uv.Tests`' `RunawayGuard`
            is shared the same way.
        -->
        <Compile Include="..\Vixen.Ui.Styling.Tests\Shared\VxmlLines.cs" Link="Shared\VxmlLines.cs" />
        <Compile Include="..\Vixen.Ui.Styling.Tests\Shared\VxmlLinesTests.cs" Link="Shared\VxmlLinesTests.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Controls.Advanced\Vixen.Ui.Controls.Advanced.csproj" />

        <!--
            The accessibility snapshot and its two audits. In `Vixen.Ui.Testing` rather than in a
            test project because there are two control assemblies and they cannot see each other —
            a renderer copied into both would be two renderers producing two formats the day one of
            them was improved.
        -->
        <ProjectReference Include="..\Vixen.Ui.Testing\Vixen.Ui.Testing.csproj" />
    </ItemGroup>
</Project>
