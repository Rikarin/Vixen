<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Core.Reflection</RootNamespace>
        <Description>
            The AOT-safe replacement for Type-driven discovery: every annotated type in an assembly,
            its members, its attribute values and its factory, emitted at compile time and registered
            before any of the assembly's code runs.
        </Description>
        <PackageTags>reflection;type-registry;aot;source-generator;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Core.Serialization\Vixen.Core.Serialization.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- Same packaging as Vixen.Core.Serialization: the generator travels inside the package. -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);PackReflectionGenerator
        </TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <!--
      GetTargetPath, not Build. The generator is already built by the time this runs — the
      ProjectReference above builds it as part of *this* project's build — so all that is wanted
      here is where its assembly landed, and GetTargetPath answers that without compiling.
      Asking for Build works locally and fails the packaging leg: a no-build `dotnet pack` sets
      NoBuild=true as a global property, the MSBuild task passes global properties down, and a
      project that is handed NoBuild=true and then asked for Build is exactly NETSDK1085.
    -->
    <Target Name="PackReflectionGenerator">
        <MSBuild Projects="..\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                 Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="TargetFramework">
            <Output TaskParameter="TargetOutputs" ItemName="ReflectionGeneratorAssembly" />
        </MSBuild>

        <ItemGroup>
            <TfmSpecificPackageFile Include="@(ReflectionGeneratorAssembly)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Core.Reflection.Tests" />
    </ItemGroup>

</Project>
