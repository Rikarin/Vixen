<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!--
            net10.0, and the project under test is net10.0-browser. `dotnet test` has no host that
            runs in a browser, so a browser test assembly could not be executed at all — which is
            why the three browser projects under Platform/ are covered by a published head under
            `nuke BrowserSmoke` instead.

            ⚠ This one does not need that, and the reason is the whole design of the thing it tests.
            BrowserWebSocketFactory contains no [JSImport] and no conditional compilation: it is
            ClientWebSocket and queues, and ClientWebSocket is the same API on both targets — only
            the implementation the runtime binds differs (BrowserWebSocket in a page, the socket
            stack here). So linking the source and running it against a real server over loopback
            exercises every line the browser will run, on a machine with no browser.

            What that leaves uncovered is BrowserWebSocket itself, which is Microsoft's code.
            NoConditionalCompilationTests is what keeps the claim honest as the file changes.

            Source-linked rather than referenced, the same trick and the same justification as
            Platform/Vixen.Platform.Web.Tests: a ProjectReference would make this suite depend on
            the browser project having been built.
        -->
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Vixen.Net.Transport.WebSocket.Browser.Tests</RootNamespace>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Vixen.Net.Transport.WebSocket.Browser\BrowserWebSocketFactory.cs"
                 Link="Linked\BrowserWebSocketFactory.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- The seam, the transport above it, and SystemWebSocketFactory to be the server. -->
        <ProjectReference Include="..\Vixen.Net.Transport.WebSocket\Vixen.Net.Transport.WebSocket.csproj" />

        <!--
            For the event recorder, which belongs to the contract rather than to any one transport.
            Every transport's test project takes this reference.
        -->
        <ProjectReference Include="..\Vixen.Net.Tests\Vixen.Net.Tests.csproj" />
    </ItemGroup>
</Project>
