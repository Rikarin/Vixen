<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <!--
            A reference and deliberately NOT an analyzer. Every generator here is constructed
            directly and driven over a string of C# through CSharpGeneratorDriver, which is the only
            way to read a diagnostic back rather than have it fail the build — and warnings are
            errors repo-wide (Directory.Build.props), so a fixture that tripped one of these rules
            inside this assembly could not be observed at all. That is the whole reason
            Vixen.Engine.Tests cannot host these tests and this project exists.
        -->
        <ProjectReference Include="..\Vixen.Engine.Generators\Vixen.Engine.Generators.csproj" />

        <!--
            ⚠ The real assemblies, not a preamble of stubs. Vixen.Ui.Generators.Tests declares its
            own `Vixen.Ui.StringId` because one record shape is the whole contract there; here the
            contract is a dozen ECS methods whose names and owners the inference generator switches
            on, and a hand-written double of `World`, `Chunk`, `CommandBuffer` and
            `WorldQueryExtensions` would be a double more permissive than the runtime — the trap
            this repository keeps recording. Binding against the shipped surface is what makes a
            renamed method fail here rather than silently stop being inferred.
        -->
        <ProjectReference Include="..\Vixen.Ecs\Vixen.Ecs.csproj" />
        <ProjectReference Include="..\Vixen.Engine\Vixen.Engine.csproj" />
    </ItemGroup>
    <!--
        #1119's ratchet. The TEST profile in `Directory.Build.props` turns documentation generation
        off for every `*.Tests` project, so no `<see cref>` in any test assembly was ever checked —
        and a test's remarks are read at the worst possible moment, when the test has just gone red.
        CS1591 and CS1573 stay suppressed: "this public member has no comment" is a question about a
        packaged API surface, and a test assembly is not one.

        This project reported nothing when the whole tree was measured with the flag forced on, so
        here it is a latch rather than a repair — which is the point. An overload landing beside a
        cref written earlier is not historical rot; #821's own measurement watched it happen inside
        one working session.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
