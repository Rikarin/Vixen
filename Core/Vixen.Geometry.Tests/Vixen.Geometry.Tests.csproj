<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Ui.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />

        <!--
            Property tests, as docs/plan/24 § Part 4 asks for and as Vixen.Core.Mathematics already
            does: "extrude by d then by −d returns the original mesh" is a statement about every d,
            and a handful of hand-picked ones is a statement about those.
        -->
        <PackageReference Include="CsCheck" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Geometry\Vixen.Geometry.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="MikkTSpaceKnownValues.txt" LogicalName="MikkTSpaceKnownValues.txt" />
    </ItemGroup>
</Project>
