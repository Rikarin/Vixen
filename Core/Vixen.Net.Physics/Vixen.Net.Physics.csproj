<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Net.Physics</RootNamespace>
        <Description>
            Lag compensation: the server-side rewind that decides whether a shot fired 80 ms ago hit
            what the player was actually looking at. A ring of collider history keyed by tick, and a
            rewound query against the world as that client plausibly saw it.
        </Description>
        <PackageTags>lag-compensation;rollback;netcode;multiplayer;physics;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <!--
        The only package that references both, and a package of its own for the same reason
        Vixen.Net.Engine is one: a game with networking and no physics must not link Jolt to send a
        packet, and a game with physics and no networking must not carry a tick history it never
        captures. Neither Vixen.Net nor Vixen.Physics may reference the other, so the type that has
        to see a Tick and a BodyHandle lives above both.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Vixen.Net\Vixen.Net.csproj" />
        <ProjectReference Include="..\Vixen.Net.Engine\Vixen.Net.Engine.csproj" />
        <ProjectReference Include="..\Vixen.Physics\Vixen.Physics.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Named here because analyzers do not flow through a ProjectReference, and the serializer for
          a component has to be generated in the assembly that declares it. Same reasoning as
          Vixen.Physics, at more length there.
        -->
        <ProjectReference Include="..\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
