<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="CsCheck" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Reactive\Vixen.Ui.Reactive.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            What a `.vxml` line is allowed to say, its XML comments being prose rather than markup,
            compiled in beside its tests rather than referenced, as `Vixen.Ui.Controls.Advanced.Tests`
            does. `SchedulerReachTests` reads `.vxml` files, and the shared parts' header comments
            demonstrate their own element, so prose read as markup is a call nothing makes (#1341).
        -->
        <Compile Include="..\Vixen.Ui.Styling.Tests\Shared\VxmlLines.cs" Link="Shared\VxmlLines.cs" />
        <Compile Include="..\Vixen.Ui.Styling.Tests\Shared\VxmlLinesTests.cs" Link="Shared\VxmlLinesTests.cs" />
    </ItemGroup>

    <!-- Measured, the guarded allocation measurement. See Testing/Vixen.Testing.props. -->
    <Import Project="..\..\Testing\Vixen.Testing.props" />
</Project>
