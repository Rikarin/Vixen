<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Rendering.ScreenProbes</RootNamespace>
        <Description>
            The screen probe gather of docs/plan/19 § L3: an octahedral radiance map per probe on a
            coarse screen grid, an atlas that holds them, and the per-pixel resolve back to
            irradiance. This is the geometry and arithmetic of the gather — written first and
            device-free, so the mapping, the solid angles and the projection are checked against
            closed forms rather than against a picture, the same way the irradiance field's storage
            was before its shaders existed.
        </Description>
        <PackageTags>global-illumination;screen-probes;octahedral;radiance;lumen;game-engine;vixen</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Core\Vixen.Core.csproj" />
        <ProjectReference Include="..\Vixen.Core.Imaging\Vixen.Core.Imaging.csproj" />
        <ProjectReference Include="..\Vixen.Core.Mathematics\Vixen.Core.Mathematics.csproj" />

        <!--
            For the traced reference gather, which marches a scene's distance field the way the
            irradiance field's reference filler does — and for IRadianceSource, which is the same
            question asked by a different probe. Doc 19 § L3's trace order ends by terminating long
            rays in § L2's field, so the arrow between the two subsystems exists by design; it runs
            one way, and the storage half compiles without it.
        -->
        <ProjectReference Include="..\Vixen.Rendering.DistanceFields\Vixen.Rendering.DistanceFields.csproj" />
        <ProjectReference Include="..\Vixen.Rendering.IrradianceFields\Vixen.Rendering.IrradianceFields.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Vixen.Rendering.ScreenProbes.Tests" />
    </ItemGroup>

</Project>
