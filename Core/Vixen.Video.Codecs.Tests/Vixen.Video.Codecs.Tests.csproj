<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Video.Codecs\Vixen.Video.Codecs.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The muxer these tests read back, linked rather than duplicated. It belongs to
            Vixen.Video.Tests — it is that suite's independent second implementation of the format —
            and a copy here would be a third that could drift from both. The repository links source
            across project boundaries where an assembly boundary would be the wrong shape; see
            Testing/Vixen.Testing.props for the same call.
        -->
        <Compile Include="..\Vixen.Video.Tests\WebMBuilder.cs" Link="Shared\WebMBuilder.cs" />
        <Compile Include="..\Vixen.Video.Tests\VideoTestContent.cs" Link="Shared\VideoTestContent.cs" />
    </ItemGroup>

</Project>
