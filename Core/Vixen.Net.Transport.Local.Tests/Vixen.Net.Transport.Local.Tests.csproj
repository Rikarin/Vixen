<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Net.Transport.Local\Vixen.Net.Transport.Local.csproj" />

        <!--
            For the conformance suite and the event recorder, which belong to the contract rather
            than to any one transport and therefore live with the contract's own tests. Every
            transport's test project takes this reference for the same reason.
        -->
        <ProjectReference Include="..\Vixen.Net.Tests\Vixen.Net.Tests.csproj" />
    </ItemGroup>
</Project>
