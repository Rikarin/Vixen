<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="CsCheck" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Text\Vixen.Ui.Text.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            19 338 conformance cases as data rather than as generated methods, and the reason is only
            size: a C# file with that many [Fact]s is tens of megabytes and minutes of discovery.
            They are still the Consortium's cases and still one test each — they arrive by [Theory]
            from here instead of by codegen.
        -->
        <EmbeddedResource Include="Generated/LineBreakConformance.data" />
    </ItemGroup>

</Project>
