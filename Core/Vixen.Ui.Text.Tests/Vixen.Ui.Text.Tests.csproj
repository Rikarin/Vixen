<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="CsCheck" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Text\Vixen.Ui.Text.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            19 338 conformance cases as data rather than as generated methods, and the reason is only
            size: a C# file with that many [Fact]s is tens of megabytes and minutes of discovery.
            They are still the Consortium's cases and still one test each — they arrive by [Theory]
            from here instead of by codegen.
        -->
        <EmbeddedResource Include="Generated/LineBreakConformance.data" />
        <EmbeddedResource Include="Generated/BidiCharacterConformance.data" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The Consortium's text-rendering-tests, and the fonts they are written against. A shaping
            expectation is only meaningful against the exact font it was written for, so the fonts
            are committed with the data rather than looked for on the machine. Fonts/README.md says
            whose they are.
        -->
        <EmbeddedResource Include="Generated/ShapingConformance.data" />
        <EmbeddedResource Include="Fonts/*.ttf" />
        <EmbeddedResource Include="Fonts/*.otf" />
    </ItemGroup>

    <ItemGroup>
        <!--
            ⚠ Sequencing rule 4, for the fourth time: the suite lands before the implementation that
            has to pass it, and this line is what the next commit deletes. Writing the gate first is
            what stops it from being shaped around whatever the code turned out to do — and it
            matters more here than anywhere, because Vixen delegates shaping to HarfBuzz and could
            otherwise "verify" it by asking HarfBuzz what HarfBuzz does.
        -->
        <Compile Remove="ShapingConformanceTests.cs" />
        <None Include="ShapingConformanceTests.cs" />
    </ItemGroup>

</Project>
