<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="CsCheck" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Text\Vixen.Ui.Text.csproj" />
    </ItemGroup>

    <!--
        The conformance suite is committed *before* the segmentation code exists, following the
        sequencing rule doc 14 states and the precedent Vixen.Ui.Layout set with Yoga: two thousand
        seven hundred red tests driving an implementation is a completely different experience from
        writing the implementation and then finding out. This exclusion is removed in the commit that
        makes them pass, and its removal is the diff that proves the order.
    -->
    <ItemGroup>
        <Compile Remove="Generated/**/*.cs" />
    </ItemGroup>
</Project>
