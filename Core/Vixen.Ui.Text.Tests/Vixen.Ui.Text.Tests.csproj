<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="CsCheck" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Ui.Text\Vixen.Ui.Text.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            19 338 conformance cases as data rather than as generated methods, and the reason is only
            size: a C# file with that many [Fact]s is tens of megabytes and minutes of discovery.
            They are still the Consortium's cases and still one test each — they arrive by [Theory]
            from here instead of by codegen.
        -->
        <EmbeddedResource Include="Generated/LineBreakConformance.data" />
        <EmbeddedResource Include="Generated/BidiCharacterConformance.data" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The Consortium's text-rendering-tests, and the fonts they are written against. A shaping
            expectation is only meaningful against the exact font it was written for, so the fonts
            are committed with the data rather than looked for on the machine. Fonts/README.md says
            whose they are.
        -->
        <EmbeddedResource Include="Generated/ShapingConformance.data" />
        <EmbeddedResource Include="Generated/VariationConformance.data" />
        <EmbeddedResource Include="Fonts/*.ttf" />
        <EmbeddedResource Include="Fonts/*.otf" />
    </ItemGroup>


    <!--
        #1119's ratchet: the TEST profile in `Directory.Build.props` turns documentation generation
        off for every `*.Tests` project, so no `<see cref>` in any test assembly was ever checked —
        and a test's remarks are read at the worst possible moment, when the test has just gone red.
        CS1591 and CS1573 stay suppressed: "this public member has no comment" is a question about a
        packaged API surface, and a test assembly is not one. Measured before flipping, and the
        diagnostics it reported are fixed in the same commit.
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
