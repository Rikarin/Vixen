<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- xunit v3 test assemblies host the runner themselves. See Vixen.Raven.Tests. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vixen.Rendering.IrradianceFields\Vixen.Rendering.IrradianceFields.csproj" />
        <ProjectReference Include="..\Vixen.Rendering.DistanceFields\Vixen.Rendering.DistanceFields.csproj" />
    </ItemGroup>

    <!--
      The shader half of the lookup, linked in so SamplingConventionTests can check that it addresses
      the pool the way this side does. Raven has no interpreter, so the shared convention is guarded
      by reading the line rather than running it.
    -->
    <ItemGroup>
        <None Include="..\..\Raven\Library\IrradianceFields\IrradianceField.rvn"
              Link="Shaders\IrradianceField.rvn"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <Import Project="..\..\Testing\Vixen.Testing.props" />

</Project>
