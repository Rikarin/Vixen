<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Vixen.Fuzz</RootNamespace>

        <!--
            Test infrastructure, not a shipped library. It exists to be run against Vixen.Net's
            decoders and it references nothing a game would want at runtime, so it stays out of the
            packages even though it lives in Core alongside what it tests.
        -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--
            Vixen.Net for the decoders themselves, and Vixen.Net.Engine for SyncList — which reads
            an index off the wire and is therefore part of the same untrusted surface even though it
            lives a layer up.
        -->
        <ProjectReference Include="..\Vixen.Net\Vixen.Net.csproj" />
        <ProjectReference Include="..\Vixen.Net.Engine\Vixen.Net.Engine.csproj" />

        <!--
          The transports, because they are the code an attacker reaches first: everything else here
          is parsed only after a connection exists, and a datagram is parsed by a server listening on
          a public port.
        -->
        <ProjectReference Include="..\Vixen.Net.Transport.Udp\Vixen.Net.Transport.Udp.csproj" />
        <ProjectReference Include="..\Vixen.Net.Transport.WebSocket\Vixen.Net.Transport.WebSocket.csproj" />

        <!--
            The content formats, which are the same problem arriving by a different route. A bundle
            and a chunk are read from a file that shipped in the package *and* from one a content
            update pulled over the network, and a heightmap PNG is a file somebody was handed and
            dropped on an importer. None of them is a packet and all of them are bytes we did not
            write, which is the only property this harness has ever cared about.
        -->
        <ProjectReference Include="..\Vixen.Core.Serialization\Vixen.Core.Serialization.csproj" />
        <ProjectReference Include="..\Vixen.Terrain\Vixen.Terrain.csproj" />

        <!--
            The text grammars, which arrive by a third route again: not a socket and not the content
            build, but a file somebody typed and committed. A .meta is merged and conflict-resolved
            by hand, and a stylesheet is authored or generated or shipped by a mod — so all three are
            bytes we did not write, which is the only property this harness has ever cared about.
        -->
        <ProjectReference Include="..\Vixen.Core.Yaml\Vixen.Core.Yaml.csproj" />
        <ProjectReference Include="..\Vixen.Ui.Styling\Vixen.Ui.Styling.csproj" />

        <!--
            And the grammars, which are the reason IFuzzDomain exists. A front end is total — every
            file produces a tree — so it has no throwing paths to find and byte havoc would report it
            clean for ever. What is worth reaching is behind the lexer, and what is worth checking is
            that the tree is the file.
        -->
        <ProjectReference Include="..\Vixen.Ui.Markup\Vixen.Ui.Markup.csproj" />
        <ProjectReference Include="..\..\Raven\Vixen.Raven\Vixen.Raven.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The shader seeds, embedded rather than typed out, so that a change to a shipped example
            changes the corpus with it — the same rule the packet targets follow by writing their
            seeds through the real encoders. Example1 is the one asserted to compile the whole way
            through both backends, which is what puts codegen within one edit of a seed.
        -->
        <EmbeddedResource Include="..\..\Raven\Library\Example1.rvn" LogicalName="Example1.rvn" />
        <EmbeddedResource Include="..\..\Raven\Library\Example2.rvn" LogicalName="Example2.rvn" />

        <!--
            The nightly's per-target budgets, next to the registry they are a budget for.
            .github/workflows/nightly.yml reads this file from the checkout to build its matrix, and it
            is copied to the output so FuzzGateTests can read the same bytes and assert that the two
            lists are one list. Without the copy the test would have to walk out of bin/ to find it,
            which is the kind of path that goes stale in a rename and takes the assertion with it.
        -->
        <None Include="nightly-budgets.json" CopyToOutputDirectory="PreserveNewest" />

        <!--
            Analyzers do not flow transitively through a ProjectReference, so every project in this
            repository that declares [DataContract] types names the generators itself. This one
            declares exactly one — the importer settings the .meta seeds carry a tag for, which has
            to be in a build for TypeRegistry to resolve it.
        -->
        <ProjectReference Include="..\Vixen.Core.Reflection.Generator\Vixen.Core.Reflection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Vixen.Core.Serialization.Generator\Vixen.Core.Serialization.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
