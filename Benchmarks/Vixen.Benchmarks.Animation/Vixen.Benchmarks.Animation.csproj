<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Vixen.Benchmarks.Animation</RootNamespace>
        <AssemblyName>Vixen.Benchmarks.Animation</AssemblyName>
        <IsPackable>false</IsPackable>

        <!--
          BenchmarkDotNet needs an optimised build to measure anything meaningful, and it says so
          loudly if you forget. Debug builds of this project exist only so the IDE can load it.
        -->
        <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>

        <!-- A benchmark's fields are assigned by [GlobalSetup], which the analyzers cannot see. -->
        <NoWarn>$(NoWarn);CA1822;CA1051</NoWarn>

        <!-- CA1001: the scheduler is disposed by [GlobalCleanup]. See Vixen.Benchmarks.Jobs. -->
        <NoWarn>$(NoWarn);CA1001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Vixen.Animation\Vixen.Animation.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Ecs\Vixen.Ecs.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Engine\Vixen.Engine.csproj" />
    </ItemGroup>

</Project>
