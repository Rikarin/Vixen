<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Vixen.Benchmarks.Ui</RootNamespace>
        <AssemblyName>Vixen.Benchmarks.Ui</AssemblyName>
        <IsPackable>false</IsPackable>

        <!--
          BenchmarkDotNet needs an optimised build to measure anything meaningful, and it says so
          loudly if you forget. Debug builds of this project exist only so the IDE can load it.
        -->
        <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>

        <!-- A benchmark's fields are assigned by [GlobalSetup], which the analyzers cannot see. -->
        <NoWarn>$(NoWarn);CA1822;CA1051</NoWarn>

        <!-- The tree field is disposed by [GlobalCleanup]. Same reasoning as Vixen.Benchmarks.Ecs. -->
        <NoWarn>$(NoWarn);CA1001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Vixen.Ui.Layout\Vixen.Ui.Layout.csproj" />
        <ProjectReference Include="..\..\Core\Vixen.Ui.Reactive\Vixen.Ui.Reactive.csproj" />

        <!--
            The controls, for DocumentBenchmarks. Phase 4's exit criterion is a *frame* of a themed
            interface rather than a layout pass, and three of that frame's four passes live above
            Vixen.Ui.Layout — so measuring the number the roadmap names takes the assembly the
            number is about.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Controls\Vixen.Ui.Controls.csproj" />

        <!--
            And the advanced set, for EditorShellBenchmarks. Doc 09's Perf row names a docking host,
            a viewport, a node canvas and a data grid by name; every one of them lives here.
        -->
        <ProjectReference Include="..\..\Core\Vixen.Ui.Controls.Advanced\Vixen.Ui.Controls.Advanced.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            ⚠ The scene is the gate's own source file, linked rather than copied. A benchmark and a
            gate that build "the same" editor shell from two files stop describing the same shell
            within a month, and nothing goes red when they do — both keep passing and only one of
            them is measuring what the row says.
        -->
        <Compile Include="..\..\Core\Vixen.Ui.Controls.Advanced.Tests\EditorShellScene.cs"
                 Link="EditorShellScene.cs" />
    </ItemGroup>

</Project>
