<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Vixen.Benchmarks.Jobs</RootNamespace>
        <AssemblyName>Vixen.Benchmarks.Jobs</AssemblyName>
        <IsPackable>false</IsPackable>

        <!--
          BenchmarkDotNet needs an optimised build to measure anything meaningful, and it says so
          loudly if you forget. Debug builds of this project exist only so the IDE can load it.
        -->
        <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>

        <!-- A benchmark's fields are assigned by [GlobalSetup], which the analyzers cannot see. -->
        <NoWarn>$(NoWarn);CA1822;CA1051</NoWarn>

        <!--
          CA1001: the scheduler field is disposed by [GlobalCleanup], which the analyzer cannot see
          either. The obvious fix — implement IDisposable — is not available here: BenchmarkDotNet
          refuses to run a benchmark declared in a sealed class, and an unsealed IDisposable owes
          the full protected-virtual pattern for a type whose whole life is one benchmark run.
        -->
        <NoWarn>$(NoWarn);CA1001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Vixen.Core.Threading\Vixen.Core.Threading.csproj" />
    </ItemGroup>

</Project>
