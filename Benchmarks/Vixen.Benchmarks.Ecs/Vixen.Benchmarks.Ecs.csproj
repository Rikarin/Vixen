<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Vixen.Benchmarks.Ecs</RootNamespace>
        <AssemblyName>Vixen.Benchmarks.Ecs</AssemblyName>
        <IsPackable>false</IsPackable>

        <!--
          BenchmarkDotNet needs an optimised build to measure anything meaningful, and it says so
          loudly if you forget. Debug builds of this project exist only so the IDE can load it.
        -->
        <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>

        <!-- A benchmark's fields are assigned by [GlobalSetup], which the analyzers cannot see. -->
        <NoWarn>$(NoWarn);CA1822;CA1051</NoWarn>

        <!-- The world field is disposed by [GlobalCleanup]. Same reasoning as Vixen.Benchmarks.Jobs. -->
        <NoWarn>$(NoWarn);CA1001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Vixen.Ecs\Vixen.Ecs.csproj" />
    </ItemGroup>

</Project>
