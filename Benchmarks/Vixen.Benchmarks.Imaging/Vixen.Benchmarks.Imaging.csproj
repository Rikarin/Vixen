<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Vixen.Benchmarks.Imaging</RootNamespace>
        <AssemblyName>Vixen.Benchmarks.Imaging</AssemblyName>
        <IsPackable>false</IsPackable>
        <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Vixen.Core.Imaging\Vixen.Core.Imaging.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The report and the targets the tests hold have to be about the same pixels. -->
        <Compile Include="..\..\Core\Vixen.Core.Imaging.Tests\ReferenceImages.cs" Link="ReferenceImages.cs" />
    </ItemGroup>

</Project>
