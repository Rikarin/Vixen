<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Vixen.Benchmarks.Vfx</RootNamespace>
        <AssemblyName>Vixen.Benchmarks.Vfx</AssemblyName>
        <IsPackable>false</IsPackable>

        <!--
          BenchmarkDotNet needs an optimised build to measure anything meaningful, and it says so
          loudly if you forget. Debug builds of this project exist only so the IDE can load it.
        -->
        <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>

        <!--
          A benchmark's fields are assigned by [GlobalSetup], which the analyzers cannot see, and
          freed by [GlobalCleanup], which is BenchmarkDotNet's disposal and not IDisposable's — so
          CA1001 would have the class implement a pattern the harness never calls.
        -->
        <NoWarn>$(NoWarn);CA1822;CA1051;CA1001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Vixen.Vfx\Vixen.Vfx.csproj" />
    </ItemGroup>

</Project>
