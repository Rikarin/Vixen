        {
          "ruleId": "SK1084",
          "level": "note",
          "message": {
            "text": "The loop's whole body is a filter: `in geometry.Layers.Where(layer => layer.MaskCount >…`"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Core/Vixen.Ui.Renderer/UiRenderer.cs"
                },
                "region": {
                  "startLine": 1897,
                  "startColumn": 17,
                  "endLine": 1897,
                  "endColumn": 94,
                  "charOffset": 112325,
                  "charLength": 77
                }
              }
            }
          ],
          "partialFingerprints": {
            "skala/v1": "ecb2755e83c8365305be7f4c92873157",
            "skala/v3": "49adcdc2cba3a75f49f0e5e81b53d10b"
          },
          "fixes": [
            {
              "description": {
                "text": "The loop's whole body is a filter: `in geometry.Layers.Where(layer => layer.MaskCount >…`"
              },
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "Core/Vixen.Ui.Renderer/UiRenderer.cs"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "charOffset": 111911
                      },
                      "insertedContent": {
                        "text": ".Where(layer => layer.MaskCount > 0 && layer.MaskFirst + layer.MaskCount <= MaskCapacity)"
                      }
                    },
                    {
                      "deletedRegion": {
                        "charOffset": 111913,
                        "charLength": 3193
                      },
                      "insertedContent": {
                        "text": "{\n                    layerMasks[layer.Image] = (layer.MaskFirst, layer.MaskCount);\n\n                    // ⚠ <b>The shadow is masked too, and it is masked in its own frame rather than\n                    // where it lands — which is a stated divergence and not an oversight.</b> CSS\n                    // applies `filter` first and `mask` to the result, so a browser cuts the shadow\n                    // by the mask at the shadow's real position. Both executors recover a mask's\n                    // point as `uv × size`, and the shadow quad's UV is deliberately the\n                    // <i>un-displaced</i> one — that is how the offset is expressed at all — so what\n                    // this gives is the mask travelling with the silhouette. Exact when the offset is\n                    // zero, and when it is not, a `mask-b-from-*` fades the shadow out at the bottom\n                    // of the shadow instead of at the bottom of the box.\n                    //\n                    // ⚠ The alternative was leaving the shadow unmasked, which is worse and not\n                    // merely differently wrong: a faded element casting a hard-edged shadow is ink\n                    // escaping a mask, which is the one thing a mask is for. Closing it properly\n                    // needs the displacement in a push constant so the fragment can evaluate the fold\n                    // at `uv × size + offset`, which is a shader change for a combination — a mask\n                    // and a drop shadow on one element — that nothing in the engine writes yet.\n                    if (layer.Shadow is not null && layerSurfaces.ContainsKey(layer.ShadowImage)) {\n                        layerMasks[layer.ShadowImage] = (layer.MaskFirst, layer.MaskCount);\n                    }\n\n                    // ⚠ <b>And the backdrop, which unlike the shadow is cut in exactly the right\n                    // place.</b> Both executors recover a mask's point as `uv × size`, and a backdrop\n                    // quad's UV is the plain viewport-relative one — there is no displacement here for\n                    // the fold to be evaluated in the wrong frame of. So `mask-b-from-*` over a glass\n                    // panel fades the blurred backdrop out at the bottom of the box, which is what CSS\n                    // gives. Leaving it unmasked would be a hard-edged rectangle of blurred scene\n                    // sticking out of a faded panel.\n                    if (layer.Backdrop is not null && layerSurfaces.ContainsKey(layer.BackdropImage)) {\n                        layerMasks[layer.BackdropImage] = (layer.MaskFirst, layer.MaskCount);\n                    }\n                }"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "properties": {
            "skalaSeverity": "hint",
            "tfms": ["net11.0"],
            "enclosingSymbol": "Vixen.Ui.Renderer.UiRenderer.Compose(Vixen.Graphics.ICommandList, in Vixen.Ui.Rendering.UiGeometry, Vixen.Core.Mathematics.Int2, float, Vixen.Ui.Renderer.UiBackdropSource)",
            "fixIsSafe": false
          }
        },
