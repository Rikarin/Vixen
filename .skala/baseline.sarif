        {
          "ruleId": "SK6034",
          "level": "note",
          "message": {
            "text": "`Name` is visible outside this assembly and `const`, so its value is copied into every caller at compile time; shipping a new value leaves every caller that is not rebuilt on the old one, with no error anywhere"
          },
          "locations": [
            {
